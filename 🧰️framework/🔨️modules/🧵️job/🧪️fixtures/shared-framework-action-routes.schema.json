{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://framework/plugin/shared-framework-action-routes/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "routes", "descriptorLaws", "hostileLaws"],
  "properties": {
    "schema": { "const": "semio.framework.plugin.shared-framework-action-routes.v1" },
    "routes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "factory", "schemaId", "descriptorDisposition", "routeIndex", "maximumRawBytes", "maximumItems", "workUnits", "maximumOutputBytes"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "factory": { "type": "string", "pattern": "^Framework[A-Za-z0-9]+JobFactory$" },
          "schemaId": { "type": "string", "pattern": "^framework\\.reserved\\.[A-Za-z]+\\.v1$" },
          "descriptorDisposition": { "const": "migrated" },
          "routeIndex": { "type": "integer", "minimum": 7, "maximum": 19 },
          "maximumRawBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "maximumItems": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "workUnits": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "maximumOutputBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
        }
      }
    },
    "descriptorLaws": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownerKind", "ownerId", "actionIds", "initial", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "ownerKind": { "enum": ["windowAction", "appCommand", "modeCommand"] },
          "ownerId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "actionIds": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 64 }, "uniqueItems": true },
          "initial": { "enum": ["missing", "migrated"] },
          "expected": { "enum": ["missing", "migrated"] }
        }
      }
    },
    "hostileLaws": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": { "enum": ["rawAdmission", "cancellation", "freshness", "identity", "progress", "close"] },
          "value": { "type": "integer", "minimum": 0, "maximum": 4194305 },
          "maximum": { "type": "integer", "minimum": 0, "maximum": 4194304 },
          "operation": { "type": "integer", "minimum": 0 },
          "generation": { "type": "integer", "minimum": 0 },
          "liveGeneration": { "type": "integer", "minimum": 0 },
          "maximumItems": { "type": "integer", "minimum": 0, "maximum": 1 },
          "maximumBytes": { "type": "integer", "minimum": 0, "maximum": 4096 },
          "expected": { "enum": ["accepted", "rejected", "cancelled", "checkpoint", "retained", "terminal"] }
        }
      }
    }
  }
}
