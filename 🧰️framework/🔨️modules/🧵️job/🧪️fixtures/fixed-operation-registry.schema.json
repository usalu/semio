{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://framework/job/fixed-operation-registry-law/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "semio.framework.job.fixed-operation-registry-law.v1" },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capacity", "maximumBytes", "steps", "expected"],
        "properties": {
          "id": {
            "enum": ["empty", "single", "maximum-plus-one", "collision", "byte-maximum-plus-one", "cancel-stale", "aba", "interrupted-repeated-close"]
          },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 64 },
          "maximumBytes": { "type": "integer", "minimum": 0, "maximum": 65536 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "owner", "operation", "generation", "bytes"],
                  "properties": {
                    "action": { "const": "admit" },
                    "owner": { "type": "string", "minLength": 1, "maxLength": 64 },
                    "operation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "bytes": { "type": "integer", "minimum": 0, "maximum": 65536 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "operation", "generation"],
                  "properties": {
                    "action": { "enum": ["take", "cancel"] },
                    "operation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "operation", "liveGeneration"],
                  "properties": {
                    "action": { "const": "cancelStaleStep" },
                    "operation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "liveGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "maximumItems", "maximumBytes"],
                  "properties": {
                    "action": { "const": "close" },
                    "maximumItems": { "type": "integer", "minimum": 0, "maximum": 1 },
                    "maximumBytes": { "type": "integer", "minimum": 0, "maximum": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action"],
                  "properties": { "action": { "const": "inspect" } }
                }
              ]
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    }
  }
}
