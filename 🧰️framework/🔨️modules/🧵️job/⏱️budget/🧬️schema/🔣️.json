{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.job.microsecond-step-budget.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "unit", "cases"],
  "properties": {
    "$schema": { "const": "./🧬️schema/🔣️.json" },
    "unit": { "const": "microseconds" },
    "cases": {
      "type": "array", "minItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "start", "grant", "fuel", "deadline", "samples", "expired", "yielded"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start": { "$ref": "#/definitions/u64" },
          "grant": { "type": "integer", "minimum": 0, "maximum": 7500 },
          "fuel": { "type": "integer", "minimum": 0, "maximum": 1 },
          "deadline": { "anyOf": [{ "$ref": "#/definitions/u64" }, { "type": "null" }] },
          "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/u64" } },
          "expired": { "type": "array", "minItems": 1, "items": { "type": "boolean" } },
          "yielded": { "type": "array", "minItems": 1, "items": { "type": "boolean" } }
        }
      }
    }
  },
  "definitions": { "u64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" } }
}
