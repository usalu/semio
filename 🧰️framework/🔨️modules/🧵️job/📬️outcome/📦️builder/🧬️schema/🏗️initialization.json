{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maximumPages",
    "livePages",
    "headerTurns",
    "turns",
    "maximumTurns",
    "storage",
    "headerFields",
    "policy"
  ],
  "properties": {
    "maximumPages": {
      "const": 256
    },
    "livePages": {
      "const": 0
    },
    "headerTurns": {
      "const": 1
    },
    "turns": {
      "const": 1
    },
    "maximumTurns": {
      "const": 257
    },
    "storage": {
      "const": "dense-live-prefix"
    },
    "headerFields": {
      "const": [
        "stream",
        "pageCount",
        "length",
        "ledger",
        "ready",
        "sealed"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ],
      "properties": {
        "items": {
          "const": 1
        },
        "copy": {
          "const": 4096
        },
        "capacity": {
          "const": 0
        },
        "release": {
          "const": 0
        },
        "depth": {
          "const": 64
        }
      }
    }
  }
}
