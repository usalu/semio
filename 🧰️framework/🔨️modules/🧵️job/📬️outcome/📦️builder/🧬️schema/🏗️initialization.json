{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bindingCount",
    "bindingsPerTurn",
    "bindingTurns",
    "headerTurns",
    "turns",
    "slotFields",
    "headerFields",
    "policy"
  ],
  "properties": {
    "bindingCount": {
      "const": 256
    },
    "bindingsPerTurn": {
      "const": 1
    },
    "bindingTurns": {
      "const": 256
    },
    "headerTurns": {
      "const": 1
    },
    "turns": {
      "const": 257
    },
    "slotFields": {
      "const": [
        "binding",
        "initialized"
      ]
    },
    "headerFields": {
      "const": [
        "stream",
        "pageCount",
        "length",
        "ledger",
        "ready",
        "sealed"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ],
      "properties": {
        "items": {
          "const": 1
        },
        "copy": {
          "const": 4096
        },
        "capacity": {
          "const": 0
        },
        "release": {
          "const": 0
        },
        "depth": {
          "const": 64
        }
      }
    }
  }
}
