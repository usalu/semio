    "quantumFuel": {
      "const": 1
    },
    "deniedWork": {
      "const": 0
    },
    "cachedWork": {
      "const": 0
    },
    "copyBytes": {
      "const": 0
    },
    "source": {
      "const": {
        "items": 4096,
        "copyBytes": 1048576,
        "capacityBytes": 1048576,
        "releaseBytes": 1048576,
        "depth": 64,
        "fuel": 16384,
        "deadlineUs": 1000000
