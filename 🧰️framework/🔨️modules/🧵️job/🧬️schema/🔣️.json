{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/job/schema.json",
  "title": "Job Schema Module",
  "$defs": {
    "SharedFrameworkActionRoutesFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "routes",
        "descriptorLaws",
        "hostileLaws"
      ],
      "properties": {
        "schema": {
          "const": "semio.framework.plugin.shared-framework-action-routes.v1"
        },
        "routes": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "factory",
              "schemaId",
              "descriptorDisposition",
              "routeIndex",
              "maximumRawBytes",
              "maximumItems",
              "workUnits",
              "maximumOutputBytes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "factory": {
                "type": "string",
                "pattern": "^Framework[A-Za-z0-9]+JobFactory$"
              },
              "schemaId": {
                "type": "string",
                "pattern": "^framework\\.reserved\\.[A-Za-z]+\\.v1$"
              },
              "descriptorDisposition": {
                "const": "migrated"
              },
              "routeIndex": {
                "type": "integer",
                "minimum": 7,
                "maximum": 19
              },
              "maximumRawBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "maximumItems": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "workUnits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "maximumOutputBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              }
            }
          }
        },
        "descriptorLaws": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "ownerKind",
              "ownerId",
              "actionIds",
              "initial",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "ownerKind": {
                "enum": [
                  "windowAction",
                  "appCommand",
                  "modeCommand"
                ]
              },
              "ownerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "actionIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "uniqueItems": true
              },
              "initial": {
                "enum": [
                  "missing",
                  "migrated"
                ]
              },
              "expected": {
                "enum": [
                  "missing",
                  "migrated"
                ]
              }
            }
          }
        },
        "hostileLaws": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "kind": {
                "enum": [
                  "rawAdmission",
                  "cancellation",
                  "freshness",
                  "identity",
                  "progress",
                  "close"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194305
              },
              "maximum": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              },
              "operation": {
                "type": "integer",
                "minimum": 0
              },
              "generation": {
                "type": "integer",
                "minimum": 0
              },
              "liveGeneration": {
                "type": "integer",
                "minimum": 0
              },
              "maximumItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "maximumBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "expected": {
                "enum": [
                  "accepted",
                  "rejected",
                  "cancelled",
                  "checkpoint",
                  "retained",
                  "terminal"
                ]
              }
            }
          }
        }
      }
    },
    "FixedOperationRegistryFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cases"
      ],
      "properties": {
        "schema": {
          "const": "semio.framework.job.fixed-operation-registry-law.v1"
        },
        "cases": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "capacity",
              "maximumBytes",
              "steps",
              "expected"
            ],
            "properties": {
              "id": {
                "enum": [
                  "empty",
                  "single",
                  "maximum-plus-one",
                  "collision",
                  "byte-maximum-plus-one",
                  "cancel-stale",
                  "aba",
                  "interrupted-repeated-close"
                ]
              },
              "capacity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "maximumBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65536
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action",
                        "owner",
                        "operation",
                        "generation",
                        "bytes"
                      ],
                      "properties": {
                        "action": {
                          "const": "admit"
                        },
                        "owner": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "operation": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "generation": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "bytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action",
                        "operation",
                        "generation"
                      ],
                      "properties": {
                        "action": {
                          "enum": [
                            "take",
                            "cancel"
                          ]
                        },
                        "operation": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "generation": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action",
                        "operation",
                        "liveGeneration"
                      ],
                      "properties": {
                        "action": {
                          "const": "cancelStaleStep"
                        },
                        "operation": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "liveGeneration": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action",
                        "maximumItems",
                        "maximumBytes"
                      ],
                      "properties": {
                        "action": {
                          "const": "close"
                        },
                        "maximumItems": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "maximumBytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action"
                      ],
                      "properties": {
                        "action": {
                          "const": "inspect"
                        }
                      }
                    }
                  ]
                }
              },
              "expected": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        }
      }
    }
  }
}
