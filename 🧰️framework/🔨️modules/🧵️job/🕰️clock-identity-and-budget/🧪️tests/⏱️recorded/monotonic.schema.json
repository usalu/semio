{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["origin", "now", "elapsedMicros"],
    "properties": {
      "origin": {"type": "integer", "minimum": 0},
      "now": {"type": "integer", "minimum": 0},
      "elapsedMicros": {"type": ["integer", "null"], "minimum": 0}
    }
  }
}
