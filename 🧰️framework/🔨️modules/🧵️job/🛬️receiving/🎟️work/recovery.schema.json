{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "placementItems",
    "placementWork",
    "cases",
    "causes"
  ],
  "properties": {
    "placementItems": {
      "const": 2
    },
    "placementWork": {
      "const": 2
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occupied",
          "items",
          "work",
          "entered"
        ],
        "properties": {
          "occupied": {
            "type": "boolean"
          },
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "work": {
            "type": "integer",
            "minimum": 0
          },
          "entered": {
            "type": "boolean"
          }
        }
      }
    },
    "causes": {
      "const": [
        "operation",
        "context",
        "receipt_refusal",
        "source_refusal"
      ]
    }
  }
}
