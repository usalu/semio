{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "expected"
        ],
        "properties": {
          "phase": {
            "enum": [
              "contextAfter",
              "contextReady",
              "published",
              "closed"
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contextFrees",
              "errorFrees",
              "committedAfter"
            ],
            "properties": {
              "contextFrees": {
                "const": 1
              },
              "errorFrees": {
                "enum": [
                  0,
                  1
                ]
              },
              "committedAfter": {
                "enum": [
                  16,
                  48,
                  112
                ]
              }
            }
          }
        }
      }
    }
  }
}
