{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "maximumBytes",
          "ownedBefore",
          "contextBytes",
          "errorBytes",
          "actions",
          "expected"
        ],
        "properties": {
          "id": {
            "enum": [
              "concurrent-rollback-preserves-published-charge",
              "context-capacity-is-admitted-before-provider",
              "one-admitted-one-refused-unused-cell-rolls-back"
            ]
          },
          "maximumBytes": {
            "type": "integer",
            "minimum": 0
          },
          "ownedBefore": {
            "type": "integer",
            "minimum": 0
          },
          "contextBytes": {
            "type": "integer",
            "minimum": 1
          },
          "errorBytes": {
            "type": "integer",
            "minimum": 1
          },
          "actions": {
            "type": "array",
            "minItems": 3,
            "items": {
              "enum": [
                "reserveA",
                "reserveB",
                "releaseA",
                "publishB",
                "dropCaller",
                "dropB"
              ]
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "committed",
              "refusals",
              "contextFrees",
              "errorFrees",
              "closedCharge"
            ],
            "properties": {
              "committed": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "refusals": {
                "type": "array",
                "items": {
                  "enum": [
                    null,
                    "ownershipLimit"
                  ]
                }
              },
              "contextFrees": {
                "const": 1
              },
              "errorFrees": {
                "type": "integer",
                "minimum": 0
              },
              "closedCharge": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
