{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maximumDepth",
    "outputChunkBytes",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maximumDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "outputChunkBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "expected"
        ],
        "properties": {
          "input": {},
          "expected": {
            "type": "string"
          }
        }
      }
    }
  }
}
