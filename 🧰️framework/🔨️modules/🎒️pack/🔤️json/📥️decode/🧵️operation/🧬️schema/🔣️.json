{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.pack.json.read-operation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "members", "limits", "normalAuthority", "retirementAuthority", "turn", "closeTurn", "maximumCloseTurns", "axes"],
  "properties": {
    "version": {"const": 1},
    "source": {"type": "string"},
    "members": {"enum": ["reject", "replace"]},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximumBytes", "maximumAllocationBytes", "maximumDepth", "maximumItems"],
      "properties": {"maximumBytes": {"$ref": "#/$defs/quantity"}, "maximumAllocationBytes": {"$ref": "#/$defs/quantity"}, "maximumDepth": {"$ref": "#/$defs/quantity"}, "maximumItems": {"$ref": "#/$defs/quantity"}}
    },
    "normalAuthority": {"$ref": "#/$defs/grant"},
    "retirementAuthority": {"$ref": "#/$defs/grant"},
    "turn": {"$ref": "#/$defs/grant"},
    "closeTurn": {"$ref": "#/$defs/grant"},
    "maximumCloseTurns": {"type": "integer", "minimum": 1, "maximum": 100000},
    "axes": {"type": "array", "minItems": 5, "maxItems": 5, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "total", "used", "incoming", "remaining"],
      "properties": {"name": {"enum": ["items", "copy", "capacity", "release", "depth"]}, "total": {"$ref": "#/$defs/quantity"}, "used": {"$ref": "#/$defs/quantity"}, "incoming": {"$ref": "#/$defs/quantity"}, "remaining": {"$ref": "#/$defs/quantity"}}
    }}
  },
  "$defs": {
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["maximumItems", "maximumCopyBytes", "maximumCapacityBytes", "maximumReleaseBytes", "maximumDepth"],
      "properties": {"maximumItems": {"$ref": "#/$defs/quantity"}, "maximumCopyBytes": {"$ref": "#/$defs/quantity"}, "maximumCapacityBytes": {"$ref": "#/$defs/quantity"}, "maximumReleaseBytes": {"$ref": "#/$defs/quantity"}, "maximumDepth": {"$ref": "#/$defs/quantity"}}
    }
  }
}
