{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "expected",
    "maximumSlices"
  ],
  "properties": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "text"
      ],
      "properties": {
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "expected": {
      "type": "string"
    },
    "maximumSlices": {
      "type": "integer",
      "minimum": 1
    }
  }
}
