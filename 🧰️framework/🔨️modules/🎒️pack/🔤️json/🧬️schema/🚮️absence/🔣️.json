{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.semio.tech/json/ownership-absence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "neutralRoots",
    "absentRoots",
    "reference",
    "testDependencies"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "neutralRoots": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "absentRoots": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "command",
        "budgetMs"
      ],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "const": "test-reference"
        },
        "budgetMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "testDependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
