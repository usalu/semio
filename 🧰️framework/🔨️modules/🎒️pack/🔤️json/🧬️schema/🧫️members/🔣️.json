{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.semio.tech/json/member-cases/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "comparison",
    "ownership"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "duplicate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "duplicate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "offset"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyUnit",
        "repetitions",
        "chunkBytes",
        "maximumOwnedBytes"
      ],
      "properties": {
        "keyUnit": {
          "type": "string",
          "minLength": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "chunkBytes": {
          "const": 65536
        },
        "maximumOwnedBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "keys"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
