{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "leafWord", "cases"],
  "properties": {
    "contract": { "const": "intrinsic-media-depth-v1" },
    "leafWord": { "const": "fff800000000002a" },
    "cases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edges", "maxDepth", "accepted"],
        "properties": {
          "edges": { "type": "integer", "minimum": 0, "maximum": 256 },
          "maxDepth": { "type": "integer", "minimum": 0, "maximum": 256 },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
