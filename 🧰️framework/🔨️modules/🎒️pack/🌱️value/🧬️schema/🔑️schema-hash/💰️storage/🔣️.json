{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nativeLaw",
    "directions",
    "cases",
    "semantic",
    "requests",
    "allowance",
    "zero",
    "cumulative",
    "cancellation",
    "released",
    "abiEstimate",
    "inlineHasherHeapCharge",
    "failureChannel"
  ],
  "properties": {
    "schema": {
      "const": "pack.schema.controlled-storage/v1"
    },
    "nativeLaw": {
      "const": "schema_hash_controlled_full_allocator_requests_and_same_caller_are_admitted"
    },
    "directions": {
      "const": [
        "encode",
        "decode"
      ]
    },
    "cases": {
      "const": [
        "flat",
        "nested",
        "nested-inner-field-changed",
        "recursive",
        "every-shape",
        "empty",
        "mutualRecursive",
        "broadRepeatedEdges"
      ]
    },
    "semantic": {
      "const": "independentCanonicalBlake3"
    },
    "requests": {
      "const": "fullSystemAllocatorRequests"
    },
    "allowance": {
      "const": "observedExactAndOneByteShort"
    },
    "zero": {
      "const": "ownershipLimitBeforeScratchRequest"
    },
    "cumulative": {
      "const": "sameCallerNoRefund"
    },
    "cancellation": {
      "const": "canceledBeforePublication"
    },
    "released": {
      "const": "completeTemporaryBacking"
    },
    "abiEstimate": {
      "const": false
    },
    "inlineHasherHeapCharge": {
      "const": false
    },
    "failureChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scratch","diagnostic","requests","release","admission","vectors"],
      "properties": {
        "scratch": {"const":"callerDataAllowanceMonotonic"},
        "diagnostic": {"const":"actualReturnedMessageCapacity"},
        "requests": {"const":"completeSystemRequestsIncludingDiagnostic"},
        "release": {"const":"dropReturnedDiagnosticInsideObservation"},
        "admission": {"const":"mayPrecedeCanceledMaterialization"},
        "vectors": {
          "type":"array","minItems":7,"maxItems":7,
          "items": {
            "type":"object","additionalProperties":false,
            "required":["scope","message","requested","admitted","diagnostic","released"],
            "properties": {
              "scope":{"enum":["zero","short","cumulative","start","admittedInterior","materializedInterior","unicodeDiagnostic"]},
              "message":{"type":"string"},
              "requested":{"type":"integer","minimum":0},
              "admitted":{"type":"integer","minimum":0},
              "diagnostic":{"type":"integer","minimum":0},
              "released":{"type":"integer","minimum":0}
            }
          }
        }
      }
    }
  }
}
