{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copyBytes",
    "grants",
    "cancelStops",
    "cases",
    "expectedHex"
  ],
  "properties": {
    "copyBytes": {
      "const": 64
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "cancelStops": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "expectedHex": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([0-9a-f]{2})*$"
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "record"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "node"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "node": {
                    "$ref": "#/$defs/node"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "enum": [
                "list",
                "tuple"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            },
            "repeat": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "int",
                "uint"
              ]
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bits"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "columns",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "table"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "shape"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "shape": {
                    "enum": [
                      "bool",
                      "text",
                      "float",
                      "tuple"
                    ]
                  }
                }
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "block"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  }
}
