{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "field",
    "cases",
    "refusals",
    "controls",
    "document",
    "integerCarrier"
  ],
  "properties": {
    "schema": {
      "const": "semio.pack.intrinsic-boundary"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "shape",
        "layout"
      ],
      "properties": {
        "id": {
          "const": 1
        },
        "key": {
          "const": "value"
        },
        "shape": {
          "const": "Value"
        },
        "layout": {
          "const": "Lines"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "bodyHex"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
        "value": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/intrinsic/schema.json"
          },
          "bodyHex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "bodyHex",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bodyHex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "kind": {
            "const": "InvalidValue"
          }
        }
      }
    },
    "controls": {
      "const": [
        "cancellation-before-ownership",
        "exact-observed-allowance",
        "one-byte-short",
        "cumulative-control",
        "no-value-payload-clone"
      ]
    },
    "document": {
      "const": [
        "same-synthetic-schema",
        "exact-single-value-field",
        "reject-schema-drift",
        "move-decoded-value"
      ]
    },
    "integerCarrier": {
      "const": "🧰️framework/🔨️modules/🛂️manifest/🪟️view-context/🧫️fixtures/🔢️integer-carriers/🔣️.json"
    }
  }
}
