{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/replication/replay-report.json",
  "title": "Mutation Replay Report",
  "definitions": {
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ]
    },
    "MutationReplayOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mutationId": {
          "type": "string"
        },
        "editId": {
          "type": "string"
        },
        "opIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "worst": {
          "anyOf": [
            {
              "enum": [
                "info",
                "warning",
                "error",
                "fatal"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MutationMessage"
          }
        },
        "superseded": {
          "type": "boolean"
        },
        "withdrawn": {
          "type": "boolean"
        }
      },
      "required": [
        "mutationId",
        "editId",
        "opIndex",
        "worst",
        "messages",
        "superseded",
        "withdrawn"
      ]
    },
    "MutationMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "info",
            "warning",
            "error",
            "fatal"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "level",
        "code",
        "message"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fromPosition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MutationReplayOutcome"
      }
    },
    "worst": {
      "anyOf": [
        {
          "enum": [
            "info",
            "warning",
            "error",
            "fatal"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "fromPosition",
    "outcomes",
    "worst"
  ]
}
