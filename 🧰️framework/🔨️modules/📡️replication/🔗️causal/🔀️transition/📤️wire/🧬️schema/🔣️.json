{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Supersession Draft Wire",
  "type": "object",
  "required": [
    "bodyBytes",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "bodyBytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "inputs",
          "wireBytes",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "wireBytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "target"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string"
                },
                "withdrawn": {
                  "const": true
                },
                "schema": {
                  "type": "string"
                },
                "payloadLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 262144
                },
                "payloadSeed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "oneOf": [
                {
                  "required": [
                    "withdrawn"
                  ],
                  "properties": {
                    "withdrawn": {}
                  }
                },
                {
                  "required": [
                    "schema",
                    "payloadLength",
                    "payloadSeed"
                  ],
                  "properties": {
                    "schema": {},
                    "payloadLength": {},
                    "payloadSeed": {}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
