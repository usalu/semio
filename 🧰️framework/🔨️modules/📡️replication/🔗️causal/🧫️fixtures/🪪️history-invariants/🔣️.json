{
  "schema": "semio.history.invariants.v1",
  "cases": [
    { "id": "repeated-operation-in-one-edit", "edits": [{ "id": "a", "actor": "alice", "logicalMs": 1, "mutationIds": ["shared", "shared"] }], "transitions": [], "expected": { "outcome": "malformed", "detail": "history repeats operation shared" } },
    { "id": "repeated-operation-by-one-author", "edits": [{ "id": "a", "actor": "alice", "logicalMs": 1, "mutationIds": ["shared"] }, { "id": "b", "actor": "alice", "logicalMs": 2, "mutationIds": ["shared"] }], "transitions": [], "expected": { "outcome": "malformed", "detail": "history repeats operation shared" } },
    { "id": "foreign-author-cannot-claim-an-operation", "edits": [{ "id": "a", "actor": "alice", "logicalMs": 1, "mutationIds": ["shared"] }, { "id": "b", "actor": "bob", "logicalMs": 2, "mutationIds": ["shared"] }], "transitions": [{ "id": "undo", "actor": "bob", "logicalMs": 3, "mutationIds": ["shared"], "kind": "revert" }], "expected": { "outcome": "malformed", "detail": "history repeats operation shared" } },
    { "id": "distinct-operations-can-share-an-edit", "edits": [{ "id": "a", "actor": "alice", "logicalMs": 1, "mutationIds": ["op-a1", "op-a2"] }, { "id": "b", "actor": "bob", "logicalMs": 2, "mutationIds": ["op-b"] }], "transitions": [{ "id": "undo", "actor": "alice", "logicalMs": 3, "mutationIds": ["op-a2", "op-a1"], "kind": "revert" }], "expected": { "outcome": "accepted", "applied": ["b"], "redo": ["a"], "refused": [] } },
    { "id": "tied-edits-use-utf8-order", "edits": [{ "id": "😀", "actor": "alice", "logicalMs": 1, "mutationIds": ["emoji"] }, { "id": "ä", "actor": "alice", "logicalMs": 1, "mutationIds": ["umlaut"] }, { "id": "a", "actor": "alice", "logicalMs": 1, "mutationIds": ["lower"] }, { "id": "", "actor": "alice", "logicalMs": 1, "mutationIds": ["private"] }, { "id": "z", "actor": "alice", "logicalMs": 1, "mutationIds": ["last"] }, { "id": "A", "actor": "alice", "logicalMs": 1, "mutationIds": ["upper"] }], "transitions": [], "expected": { "outcome": "accepted", "applied": ["A", "a", "z", "ä", "", "😀"], "redo": [], "refused": [] } },
    { "id": "tied-revert-reinstate-use-utf8-order", "edits": [{ "id": "edit", "actor": "alice", "logicalMs": 1, "mutationIds": ["op"] }], "transitions": [{ "id": "ä", "actor": "alice", "logicalMs": 2, "mutationIds": ["op"], "kind": "reinstate" }, { "id": "z", "actor": "alice", "logicalMs": 2, "mutationIds": ["op"], "kind": "revert" }], "expected": { "outcome": "accepted", "applied": ["edit"], "redo": [], "refused": [] } },
    { "id": "foreign-reverts-are-refused-in-utf8-order", "edits": [{ "id": "edit", "actor": "alice", "logicalMs": 1, "mutationIds": ["op"] }], "transitions": [{ "id": "ä", "actor": "bob", "logicalMs": 2, "mutationIds": ["op"], "kind": "revert" }, { "id": "z", "actor": "bob", "logicalMs": 2, "mutationIds": ["op"], "kind": "revert" }], "expected": { "outcome": "accepted", "applied": ["edit"], "redo": [], "refused": ["z", "ä"] } }
  ]
}
