{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/replication/history-transition.json",
  "title": "Semio History Transition Payload Cases",
  "definitions": {
    "Id": { "type": "string", "minLength": 1 },
    "OptionalString": { "type": ["string", "null"] },
    "MutationIds": { "type": "array", "items": { "$ref": "#/definitions/Id" } },
    "Author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "avatar"],
      "properties": { "id": { "$ref": "#/definitions/Id" }, "name": { "type": "string" }, "avatar": { "$ref": "#/definitions/OptionalString" } }
    },
    "Hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
    "Replacement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "schema", "payloadHex"],
          "properties": { "kind": { "const": "input" }, "schema": { "type": "string" }, "payloadHex": { "$ref": "#/definitions/Hex" } }
        },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "withdrawn" } } }
      ]
    },
    "SupersededInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "replacement"],
      "properties": { "target": { "$ref": "#/definitions/Id" }, "replacement": { "$ref": "#/definitions/Replacement" } }
    },
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childUri", "checkpointId"],
      "properties": { "childUri": { "$ref": "#/definitions/Id" }, "checkpointId": { "$ref": "#/definitions/Id" } }
    },
    "Transition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mutationIds"],
          "properties": { "kind": { "enum": ["revert", "reinstate"] }, "mutationIds": { "$ref": "#/definitions/MutationIds" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "checkpointId", "parentId", "changeId", "mutationIds", "description", "savedAt", "authors", "message", "timestamp"],
          "properties": {
            "kind": { "const": "commit" },
            "checkpointId": { "$ref": "#/definitions/Id" },
            "parentId": { "$ref": "#/definitions/OptionalString" },
            "changeId": { "$ref": "#/definitions/Id" },
            "mutationIds": { "$ref": "#/definitions/MutationIds" },
            "description": { "$ref": "#/definitions/OptionalString" },
            "savedAt": { "type": "string" },
            "authors": { "type": "array", "items": { "$ref": "#/definitions/Author" } },
            "message": { "$ref": "#/definitions/OptionalString" },
            "timestamp": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "alternativeId", "name", "checkpointId"],
          "properties": { "kind": { "const": "branch" }, "alternativeId": { "$ref": "#/definitions/Id" }, "name": { "type": "string" }, "checkpointId": { "$ref": "#/definitions/Id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "checkpointId", "alternativeId"],
          "properties": { "kind": { "const": "checkout" }, "checkpointId": { "$ref": "#/definitions/Id" }, "alternativeId": { "$ref": "#/definitions/OptionalString" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "checkpointId", "pinnedCheckpointId", "pins"],
          "properties": { "kind": { "const": "repin" }, "checkpointId": { "$ref": "#/definitions/Id" }, "pinnedCheckpointId": { "$ref": "#/definitions/Id" }, "pins": { "type": "array", "items": { "$ref": "#/definitions/Pin" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "scope", "inputs"],
          "properties": {
            "kind": { "const": "supersede" },
            "scope": { "$ref": "#/definitions/OptionalString" },
            "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/SupersededInput" } }
          }
        }
      ]
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "payloadHex", "expect"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "payloadHex": { "$ref": "#/definitions/Hex" },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "transition", "transitionId"],
              "properties": {
                "outcome": { "const": "accepted" },
                "transition": { "$ref": "#/definitions/Transition" },
                "transitionId": { "type": "string", "pattern": "^transition-[0-9a-f]{16}$", "description": "Content address of this payload authored at the corpus idClock: transition-{hex16(blake3(hlc.actor varint | hlc.physical_ms varint | hlc.logical varint | payload bytes))}; the free-form actor string never enters it." }
              }
            },
            { "type": "object", "additionalProperties": false, "required": ["outcome", "detail"], "properties": { "outcome": { "const": "malformed" }, "detail": { "type": "string", "minLength": 1 } } }
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "diffSchema", "idClock", "cases"],
  "properties": {
    "schema": { "const": "semio.history.transition.v1" },
    "diffSchema": { "const": "semio.history.transition" },
    "idClock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "physicalMs", "logical"],
      "properties": { "actor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "physicalMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "logical": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Case" } }
  }
}
