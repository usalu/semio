{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "profile", "limits", "headerHex", "commits", "fuelGrants", "negative", "compressed", "resume"],
  "properties": {
    "schema": { "const": "semio.spr.retained-verification/v1" },
    "profile": { "const": { "major": 1, "minor": 0, "requiredFlags": 1, "canonicalVarints": true, "signed": false, "encrypted": false } },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["fileBytes", "frameBodyBytes", "records"],
      "properties": { "fileBytes": { "const": 67108864 }, "frameBodyBytes": { "const": 1048576 }, "records": { "const": 8192 } }
    },
    "headerHex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commits": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/commit" } },
    "fuelGrants": { "const": [1, 7, 4096] },
    "negative": { "type": "array", "minItems": 26, "maxItems": 26, "items": { "$ref": "#/$defs/negative" } },
    "compressed": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/compressed" } },
    "resume": {
      "type": "object", "additionalProperties": false,
      "required": ["cuts", "record", "addedBytes", "wrongSinkOffsets", "exhaustedSequence"],
      "properties": {
        "cuts": { "const": [32, 165, 166, 180, 254, 255] },
        "record": { "const": { "kind": 64, "flags": 2, "payloadHex": "020304" } },
        "addedBytes": { "const": 89 }, "wrongSinkOffsets": { "const": [-1, 1] }, "exhaustedSequence": { "const": "18446744073709551615" }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[a-f0-9]{2})+$", "maxLength": 8192 },
    "compressed": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "flags", "rawLengthHex", "storedHex", "error"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z-]+$", "maxLength": 40 },
        "kind": { "enum": [12, 64] }, "flags": { "enum": [3, 6, 7, 135] },
        "rawLengthHex": { "type": "string", "pattern": "^(?:[a-f0-9]{2})*$", "maxLength": 20 },
        "storedHex": { "type": "string", "pattern": "^(?:[a-f0-9]{2})*$", "maxLength": 8192 },
        "rawHex": { "$ref": "#/$defs/hex" }, "error": { "enum": [null, "frame", "commit"] }
      },
      "allOf": [{ "if": { "properties": { "error": { "type": "null" } } }, "then": { "required": ["rawHex"], "properties": { "rawHex": true } }, "else": { "properties": { "rawHex": false } } }]
    },
    "record": {
      "type": "object", "additionalProperties": false, "required": ["kind", "flags", "payloadHex"],
      "properties": { "kind": { "type": "integer", "minimum": 0, "maximum": 255, "not": { "const": 12 } }, "flags": { "const": 2 }, "payloadHex": { "$ref": "#/$defs/hex" } }
    },
    "commit": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "previousOffset", "offset", "end", "records", "coveredBytes", "recoveredFrames"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2 },
        "previousOffset": { "type": "integer", "minimum": 0, "maximum": 255 },
        "offset": { "type": "integer", "minimum": 32, "maximum": 255 },
        "end": { "type": "integer", "minimum": 107, "maximum": 255 },
        "records": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/record" } },
        "coveredBytes": { "type": "integer", "minimum": 1, "maximum": 255 },
        "recoveredFrames": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "negative": {
      "type": "object", "additionalProperties": false, "required": ["id", "operation", "error"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z-]+$", "maxLength": 40 },
        "operation": { "enum": ["header-xor", "frame-xor", "commit-xor", "second-commit-xor", "replace-first-length", "record-limit", "file-limit"] },
        "offset": { "type": "integer", "minimum": 0, "maximum": 255 },
        "value": { "type": "integer", "minimum": 1, "maximum": 255 },
        "repairCrc": { "type": "boolean" },
        "hex": { "$ref": "#/$defs/hex" },
        "error": { "enum": ["header", "frame", "commit", "capacity"] }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "enum": ["header-xor", "frame-xor", "commit-xor", "second-commit-xor"] } } }, "then": { "required": ["offset", "value", "repairCrc"], "properties": { "offset": true, "value": true, "repairCrc": true, "hex": false } } },
        { "if": { "properties": { "operation": { "const": "replace-first-length" } } }, "then": { "required": ["hex"], "properties": { "hex": true, "offset": false, "value": false, "repairCrc": false } } },
        { "if": { "properties": { "operation": { "enum": ["record-limit", "file-limit"] } } }, "then": { "required": ["value"], "properties": { "value": true, "offset": false, "hex": false, "repairCrc": false } } }
      ]
    }
  }
}
