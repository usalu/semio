{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "payload",
    "failedWrites",
    "originalToken"
  ],
  "properties": {
    "schema": {
      "const": "semio.spr.writer-refusal/v1"
    },
    "payload": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "failedWrites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 11
      }
    },
    "originalToken": {
      "type": "integer",
      "minimum": 1
    }
  }
}
