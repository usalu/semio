{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "facade",
    "peers",
    "budget",
    "excluded",
    "unmounted",
    "crates"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "facade": {
      "type": "object",
      "required": [
        "package",
        "manifest",
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "required": [
        "maximumActiveLines",
        "maximumFiles",
        "maximumBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "maximumActiveLines": {
          "type": "integer",
          "minimum": 1
        },
        "maximumFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unmounted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "crates": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "package",
          "manifest",
          "entry",
          "level",
          "dependencies",
          "devDependencies",
          "peerDependencies"
        ],
        "additionalProperties": false,
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "devDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "peerDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
