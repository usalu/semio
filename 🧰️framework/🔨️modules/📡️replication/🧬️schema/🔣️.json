{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/replication/schema.json",
  "title": "Replication Schema Module",
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evenHex": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[0-9a-f]{2})+$"
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainHash"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "headEditOrdinal": {
          "type": "integer",
          "minimum": 0
        },
        "headEditId": {
          "type": "string"
        },
        "lastCommitSeq": {
          "type": "integer",
          "minimum": 0
        },
        "chainHash": {
          "$ref": "#/definitions/hash"
        }
      }
    },
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumEntryBytes",
        "maximumTextBytes",
        "maximumPresencePackBytes",
        "maximumViews",
        "maximumInteractionDomains",
        "maximumDomainIds",
        "maximumConnectedAtMs"
      ],
      "properties": {
        "maximumEntryBytes": {
          "const": 4096
        },
        "maximumTextBytes": {
          "const": 1024
        },
        "maximumPresencePackBytes": {
          "const": 2048
        },
        "maximumViews": {
          "const": 16
        },
        "maximumInteractionDomains": {
          "const": 16
        },
        "maximumDomainIds": {
          "const": 64
        },
        "maximumConnectedAtMs": {
          "const": 9007199254740991
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prefixHex",
        "repeatHex",
        "repeatCount",
        "suffixHex",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prefixHex": {
          "$ref": "#/definitions/hex"
        },
        "repeatHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$"
        },
        "repeatCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4097
        },
        "suffixHex": {
          "$ref": "#/definitions/hex"
        },
        "accepted": {
          "type": "boolean"
        },
        "canonicalHex": {
          "$ref": "#/definitions/hex"
        },
        "expected": {
          "$ref": "#/definitions/peer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accepted": {
                "const": true
              }
            },
            "required": [
              "accepted"
            ]
          },
          "then": {
            "properties": {
              "canonicalHex": true,
              "expected": true
            },
            "required": [
              "canonicalHex",
              "expected"
            ]
          }
        }
      ]
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "connectedAtMs",
        "views"
      ],
      "properties": {
        "actor": {
          "type": "string"
        },
        "connectedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "label": {
          "type": "string"
        },
        "presencePack": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "userId": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "dragGhostJson": {
          "type": "string"
        },
        "interaction": {
          "$ref": "#/definitions/interaction"
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "surface": {
          "type": "string"
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/view"
          }
        },
        "ui": {
          "$ref": "#/definitions/ui"
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "domains"
      ],
      "properties": {
        "appId": {
          "type": "string"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/domain"
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "granularity",
        "selected",
        "hovered"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "granularity": {
          "type": "string"
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hovered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowId",
        "space",
        "kind",
        "size"
      ],
      "properties": {
        "windowId": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/viewKind"
        },
        "size": {
          "$ref": "#/definitions/pair"
        },
        "pointer": {
          "$ref": "#/definitions/triple"
        }
      }
    },
    "viewKind": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y",
            "zoom"
          ],
          "properties": {
            "kind": {
              "const": "canvas"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "position",
            "target",
            "up",
            "fov"
          ],
          "properties": {
            "kind": {
              "const": "orbit"
            },
            "position": {
              "$ref": "#/definitions/triple"
            },
            "target": {
              "$ref": "#/definitions/triple"
            },
            "up": {
              "$ref": "#/definitions/triple"
            },
            "fov": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lng",
            "lat",
            "zoom",
            "bearing",
            "pitch"
          ],
          "properties": {
            "kind": {
              "const": "geo"
            },
            "lng": {
              "type": "number"
            },
            "lat": {
              "type": "number"
            },
            "zoom": {
              "type": "number"
            },
            "bearing": {
              "type": "number"
            },
            "pitch": {
              "type": "number"
            }
          }
        }
      ]
    },
    "pair": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2
    },
    "triple": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 3,
      "maxItems": 3
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hoveredPath": {
          "type": "string"
        },
        "focusedPath": {
          "type": "string"
        },
        "pressedPath": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "ArtifactBootstrapFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "formatVersion",
        "artifact",
        "payload",
        "chunkByteLengths",
        "wire"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "formatVersion": {
          "const": 1
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "descriptorHash",
            "schema",
            "kind",
            "packSchemaHash",
            "baselineFrontier",
            "requiredTailFrontier"
          ],
          "properties": {
            "descriptorHash": {
              "$ref": "#/definitions/hash"
            },
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "packSchemaHash": {
              "$ref": "#/definitions/hash"
            },
            "baselineFrontier": {
              "$ref": "#/definitions/frontier"
            },
            "requiredTailFrontier": {
              "$ref": "#/definitions/frontier"
            }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packHex",
            "sprHex",
            "packLength",
            "sprLength",
            "packHash",
            "sprHash",
            "aggregateHash"
          ],
          "properties": {
            "packHex": {
              "$ref": "#/definitions/evenHex"
            },
            "sprHex": {
              "$ref": "#/definitions/evenHex"
            },
            "packLength": {
              "type": "integer",
              "minimum": 1
            },
            "sprLength": {
              "type": "integer",
              "minimum": 1
            },
            "packHash": {
              "$ref": "#/definitions/hash"
            },
            "sprHash": {
              "$ref": "#/definitions/hash"
            },
            "aggregateHash": {
              "$ref": "#/definitions/hash"
            }
          }
        },
        "chunkByteLengths": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "wire": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inlineWelcomeHex",
            "chunkedWelcomeHex",
            "chunkHex",
            "doneHex"
          ],
          "properties": {
            "inlineWelcomeHex": {
              "$ref": "#/definitions/evenHex"
            },
            "chunkedWelcomeHex": {
              "$ref": "#/definitions/evenHex"
            },
            "chunkHex": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/definitions/evenHex"
              }
            },
            "doneHex": {
              "$ref": "#/definitions/evenHex"
            }
          }
        }
      }
    },
    "PresencePeerCodecFixture": {
      "title": "Presence Peer Codec V1 Neutral Corpus",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "limits",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "limits": {
          "$ref": "#/definitions/limits"
        },
        "cases": {
          "type": "array",
          "minItems": 16,
          "items": {
            "$ref": "#/definitions/case"
          }
        }
      }
    }
  }
}
