{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canonical", "workspaceTokenMismatchBytes", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "canonical": { "$ref": "#/$defs/canonical" },
    "workspaceTokenMismatchBytes": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 31 }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1 },
    "token": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceToken", "mutationRoot", "taxonomyPath", "sourceFilename", "descriptorFilename", "owner"],
      "properties": {
        "workspaceToken": { "$ref": "#/$defs/token" },
        "mutationRoot": { "$ref": "#/$defs/path" },
        "taxonomyPath": { "$ref": "#/$defs/path" },
        "sourceFilename": { "$ref": "#/$defs/path" },
        "descriptorFilename": { "$ref": "#/$defs/path" },
        "owner": { "$ref": "#/$defs/path" }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceToken": { "$ref": "#/$defs/token" },
        "mutationRoot": { "$ref": "#/$defs/path" },
        "taxonomyPath": { "$ref": "#/$defs/path" },
        "sourceFilename": { "$ref": "#/$defs/path" },
        "descriptorFilename": { "$ref": "#/$defs/path" },
        "owner": { "$ref": "#/$defs/path" },
        "schemaVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "field": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "valid": { "const": false } } }, "then": { "properties": { "field": { "type": "string", "minLength": 1 } }, "required": ["field"] } }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expected"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/overrides" },
        "descriptor": { "$ref": "#/$defs/overrides" },
        "provenance": { "$ref": "#/$defs/overrides" },
        "expected": { "$ref": "#/$defs/expectation" }
      }
    }
  }
}
