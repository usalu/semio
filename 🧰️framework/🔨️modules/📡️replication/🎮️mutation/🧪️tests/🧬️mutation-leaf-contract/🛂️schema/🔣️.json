{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "providesDescriptor", "providesProvenance", "borrowedGeneric", "expectedCompile"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "providesDescriptor": { "type": "boolean" },
          "providesProvenance": { "type": "boolean" },
          "borrowedGeneric": { "type": "boolean" },
          "expectedCompile": { "type": "boolean" },
          "errorCode": { "const": "E0046" },
          "stdout": { "type": "string" }
        },
        "allOf": [
          { "if": { "properties": { "expectedCompile": { "const": true } } }, "then": { "properties": { "stdout": { "type": "string" } }, "required": ["stdout"] } },
          { "if": { "properties": { "expectedCompile": { "const": false } } }, "then": { "properties": { "errorCode": { "const": "E0046" } }, "required": ["errorCode"] } }
        ]
      }
    }
  }
}
