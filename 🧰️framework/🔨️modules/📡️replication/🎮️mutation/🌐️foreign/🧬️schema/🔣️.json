{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/replication/mutation/foreign/schema.json",
  "title": "ForeignStep",
  "type": "object",
  "required": [
    "target",
    "mutationId",
    "payload",
    "label"
  ],
  "properties": {
    "target": {
      "$ref": "#/$defs/ForeignTarget"
    },
    "mutationId": {
      "type": "string"
    },
    "payload": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "label": {
      "type": "string"
    }
  },
  "$defs": {
    "ForeignTarget": {
      "title": "ForeignTarget",
      "type": "object",
      "required": [
        "artifactId",
        "artifactKind"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "artifactKind": {
          "type": "string"
        },
        "dialect": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ForeignSteps": {
      "title": "ForeignSteps",
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/mutation/foreign/schema.json"
      }
    }
  }
}
