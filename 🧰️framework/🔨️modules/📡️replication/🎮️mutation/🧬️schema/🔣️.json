{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/replication/mutation/schema.json",
  "title": "Replication Mutation Schema Module",
  "definitions": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceToken",
        "mutationRoot",
        "taxonomyPath",
        "sourceFilename",
        "descriptorFilename",
        "owner"
      ],
      "properties": {
        "workspaceToken": {
          "$ref": "#/definitions/token"
        },
        "mutationRoot": {
          "$ref": "#/definitions/path"
        },
        "taxonomyPath": {
          "$ref": "#/definitions/path"
        },
        "sourceFilename": {
          "$ref": "#/definitions/path"
        },
        "descriptorFilename": {
          "$ref": "#/definitions/path"
        },
        "owner": {
          "$ref": "#/definitions/path"
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceToken": {
          "$ref": "#/definitions/token"
        },
        "mutationRoot": {
          "$ref": "#/definitions/path"
        },
        "taxonomyPath": {
          "$ref": "#/definitions/path"
        },
        "sourceFilename": {
          "$ref": "#/definitions/path"
        },
        "descriptorFilename": {
          "$ref": "#/definitions/path"
        },
        "owner": {
          "$ref": "#/definitions/path"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "field"
            ]
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/definitions/overrides"
        },
        "descriptor": {
          "$ref": "#/definitions/overrides"
        },
        "provenance": {
          "$ref": "#/definitions/overrides"
        },
        "expected": {
          "$ref": "#/definitions/expectation"
        }
      }
    }
  },
  "$defs": {
    "MutationLeafContractFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "providesDescriptor",
              "providesProvenance",
              "borrowedGeneric",
              "expectedCompile"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "providesDescriptor": {
                "type": "boolean"
              },
              "providesProvenance": {
                "type": "boolean"
              },
              "borrowedGeneric": {
                "type": "boolean"
              },
              "expectedCompile": {
                "type": "boolean"
              },
              "errorCode": {
                "const": "E0046"
              },
              "stdout": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "expectedCompile": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "stdout": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "stdout"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "expectedCompile": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "errorCode": {
                      "const": "E0046"
                    }
                  },
                  "required": [
                    "errorCode"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "MutationLeafSourceContractFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "canonical",
        "workspaceTokenMismatchBytes",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "canonical": {
          "$ref": "#/definitions/canonical"
        },
        "workspaceTokenMismatchBytes": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          }
        },
        "cases": {
          "type": "array",
          "minItems": 12,
          "items": {
            "$ref": "#/definitions/case"
          }
        }
      }
    }
  }
}
