{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/replication/mutation/schema.json",
  "title": "Replication Mutation Contracts",
  "$defs": {
    "Edit": {
      "type": "object",
      "required": [
        "id",
        "line",
        "forwards",
        "inverse",
        "sequenceNumber",
        "startedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        },
        "forwards": {
          "type": "array"
        },
        "inverse": {
          "type": "array"
        },
        "sequenceNumber": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "startedAt": {
          "type": "string"
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "verb": {
          "type": [
            "string",
            "null"
          ]
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "mutationMeta": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
