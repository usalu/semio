{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/replication/outcome-code.json",
  "title": "Semio Mutation Outcome Code Vocabulary",
  "description": "The frozen, closed vocabulary of `MutationMessage` codes a mutation outcome may carry, each with the one severity it fixes, plus the `mutation.apply.<detail>` family every apply-time rejection uses. Persistence refuses any other code or level; the outcome-law gate, the Rust protocol table and the TypeScript twin read this one document.",
  "definitions": {
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ]
    },
    "Code": {
      "type": "string",
      "pattern": "^mutation\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "level",
        "meaning"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/Code"
        },
        "level": {
          "$ref": "#/definitions/Severity"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "codes",
    "apply",
    "rejected"
  ],
  "properties": {
    "schema": {
      "const": "semio.replication.outcome-code"
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/Entry"
      }
    },
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "pattern",
        "level",
        "accepted"
      ],
      "properties": {
        "prefix": {
          "const": "mutation.apply."
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "const": "fatal"
        },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^mutation\\.apply\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
