{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/replication/outcome-code.json",
  "definitions": {
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ]
    },
    "Code": {
      "type": "string",
      "pattern": "^mutation\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "level",
        "meaning"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/Code"
        },
        "level": {
          "$ref": "#/definitions/Severity"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "title": "Mutation Outcome Vocabulary Entry",
  "$ref": "#/definitions/Entry"
}
