{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retained Key Lookup Laws",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunkBytes",
    "cases",
    "$schema"
  ],
  "properties": {
    "chunkBytes": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "keys",
          "needle",
          "expectedIndices"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needle": {
            "type": "string"
          },
          "expectedIndices": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  }
}
