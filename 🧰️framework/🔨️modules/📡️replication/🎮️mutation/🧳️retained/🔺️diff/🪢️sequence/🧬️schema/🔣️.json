{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ordered Retained Diff Sequence",
  "type": "object",
  "required": [
    "schema",
    "base",
    "cases",
    "cancelCuts",
    "bodyBytes",
    "deniedCurrencies",
    "wideText",
    "outputHandoff",
    "postCustody",
    "workCases",
    "diagnosticText",
    "diagnosticSlots"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "semio.retained-diff-sequence/v1"
    },
    "base": {
      "type": "object",
      "required": [
        "a",
        "b",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "edits",
          "accepted",
          "messageCount"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "setA": {
                  "type": "integer"
                },
                "setB": {
                  "type": "integer"
                },
                "requireA": {
                  "type": "integer"
                },
                "warning": {
                  "type": "boolean"
                }
              }
            }
          },
          "accepted": {
            "type": "boolean"
          },
          "expected": {
            "type": "object"
          },
          "messageCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "cancelCuts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "bodyBytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "deniedCurrencies": {
      "const": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ]
    },
    "wideText": {
      "type": "object",
      "required": [
        "text",
        "repeat"
      ],
      "properties": {
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "outputHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "cancelCuts",
        "maximumTurns"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "sets",
              "expected"
            ],
            "properties": {
              "before": {
                "type": "integer"
              },
              "sets": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "integer"
                }
              },
              "expected": {
                "type": "integer"
              }
            }
          }
        },
        "cancelCuts": {
          "const": [
            0,
            3,
            16,
            64,
            2048
          ]
        },
        "maximumTurns": {
          "const": 2048
        }
      }
    },
    "postCustody": {
      "const": [
        "original-read",
        "mutable-handback",
        "original-intermediate"
      ]
    },
    "diagnosticSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "turns", "workPerTurn"],
      "properties": {"targets": {"const": 8}, "turns": {"const": 24}, "workPerTurn": {"const": 1}}
    },
    "diagnosticText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "repetitions", "bytes", "chunkBytes"],
      "properties": {
        "pattern": {"const": "a🧱"},
        "repetitions": {"const": 819},
        "bytes": {"const": 4095},
        "chunkBytes": {"const": 2048}
      }
    },
    "workCases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "budget",
          "child",
          "parent",
          "actual",
          "admitted"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "budget": {
            "type": "integer",
            "minimum": 0
          },
          "child": {
            "type": "integer",
            "minimum": 0
          },
          "parent": {
            "type": "integer",
            "minimum": 0
          },
          "actual": {
            "type": "integer",
            "minimum": 0
          },
          "admitted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
