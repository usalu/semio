{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "cancelCuts",
    "maximumTurns"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "sets",
          "expected"
        ],
        "properties": {
          "before": {
            "type": "integer"
          },
          "sets": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          },
          "expected": {
            "type": "integer"
          }
        }
      }
    },
    "cancelCuts": {
      "const": [
        0,
        3,
        16,
        64,
        2048
      ]
    },
    "maximumTurns": {
      "const": 2048
    }
  }
}
