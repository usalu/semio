{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["bodyBytes", "workUnits", "checkPartialDenialWork", "cancelCuts", "cases"],
  "additionalProperties": false,
  "properties": {
    "bodyBytes": { "type": "integer", "minimum": 1 },
    "workUnits": { "type": "integer", "minimum": 1 },
    "checkPartialDenialWork": { "const": true },
    "cancelCuts": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "cases": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "original", "authored", "patch"], "additionalProperties": false,
        "properties": { "id": { "type": "string", "minLength": 1 }, "original": { "$ref": "#/$defs/row" }, "authored": { "$ref": "#/$defs/row" }, "patch": { "$ref": "#/$defs/patch" } } }
    }
  },
  "$defs": {
    "row": { "allOf": [{ "$ref": "#/$defs/patch" }, { "type": "object", "required": ["title", "count", "body"] }] },
    "patch": { "type": "object", "additionalProperties": false, "properties": { "title": { "type": ["string", "null"] }, "count": { "type": "integer" }, "body": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } } } }
  }
}
