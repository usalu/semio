{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "type",
      "cursorWork",
      "baseWork"
    ],
    "properties": {
      "type": {
        "enum": [
          "optionalText",
          "integer",
          "bytes"
        ]
      },
      "cursorWork": {
        "type": "integer",
        "minimum": 1
      },
      "baseWork": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
