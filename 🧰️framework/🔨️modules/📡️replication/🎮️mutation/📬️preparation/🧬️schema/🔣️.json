{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object",
  "additionalProperties":false,
  "required":["base","grant","cases"],
  "properties":{
    "base":{
      "type":"object", "additionalProperties":false,
      "required":["scalar","rowCount","rowBytes","storage"],
      "properties":{"scalar":{"type":"integer"},"rowCount":{"type":"integer","minimum":1},"rowBytes":{"type":"integer","minimum":1},"storage":{"const":"paged"}}
    },
    "grant":{
      "type":"object", "additionalProperties":false,
      "required":["maximumItems","maximumCopyBytes","maximumCapacityBytes","maximumReleaseBytes","maximumDepth"],
      "properties":{"maximumItems":{"type":"integer","minimum":1},"maximumCopyBytes":{"type":"integer","minimum":1},"maximumCapacityBytes":{"type":"integer","minimum":1},"maximumReleaseBytes":{"type":"integer","minimum":1},"maximumDepth":{"type":"integer","minimum":1}}
    },
    "cases":{
      "type":"array", "minItems":1,
      "items":{
        "type":"object", "additionalProperties":false,
        "required":["name","delta","level","targetRow","lateRefusal","cancelStage","expected"],
        "properties":{
          "name":{"type":"string","minLength":1},"delta":{"type":"integer","not":{"const":0}},
          "level":{"enum":["info","warning","error","fatal"]},"targetRow":{"type":"integer","minimum":0},
          "lateRefusal":{"type":"boolean"},"cancelStage":{"enum":[null,"decision","inverse","apply","publication"]},
          "expected":{
            "type":"object", "additionalProperties":false,
            "required":["publishedScalar","published","diffDecisions","inverseCalls","applyCalls","wholeSnapshotClones","terminalEmpty"],
            "properties":{"publishedScalar":{"type":"integer"},"published":{"type":"boolean"},"diffDecisions":{"type":"integer","minimum":0,"maximum":1},"inverseCalls":{"type":"integer","minimum":0,"maximum":1},"applyCalls":{"type":"integer","minimum":0,"maximum":1},"wholeSnapshotClones":{"const":0},"terminalEmpty":{"const":true}}
          }
        }
      }
    }
  }
}
