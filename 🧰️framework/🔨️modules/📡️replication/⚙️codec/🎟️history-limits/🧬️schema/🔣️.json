{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.protocol.original-history-read-limits.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fileBytes",
    "frameBodyBytes",
    "records",
    "maximumFields",
    "maximumTextBytes",
    "maximumBinaryBytes",
    "maximumJsonBytes",
    "maximumJsonAllocationBytes",
    "maximumJsonItems",
    "maximumJsonDepth"
  ],
  "properties": {
    "fileBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "frameBodyBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "maximumFields": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "maximumTextBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "maximumBinaryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "maximumJsonBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "maximumJsonAllocationBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "maximumJsonItems": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "maximumJsonDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
