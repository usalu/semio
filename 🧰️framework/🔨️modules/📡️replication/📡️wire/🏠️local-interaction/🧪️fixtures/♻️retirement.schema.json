{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "grants",
    "cases",
    "zeroItemMutates",
    "terminalOwners"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "grants": {
      "const": [
        1,
        64,
        4096
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceCase",
          "sourceField",
          "expectedReleasedBytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceCase": {
            "type": "string",
            "minLength": 1
          },
          "sourceField": {
            "enum": [
              "before",
              "expected"
            ]
          },
          "expectedReleasedBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "zeroItemMutates": {
      "const": false
    },
    "terminalOwners": {
      "const": 0
    }
  }
}
