{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "grants",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "grants": {
      "const": [
        1,
        64,
        4096
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "before",
          "current",
          "restore"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "$ref": "semio:local-interaction#/$defs/state"
          },
          "current": {
            "$ref": "semio:local-interaction#/$defs/identity"
          },
          "restore": {
            "$ref": "semio:local-interaction#/$defs/restore"
          },
          "expected": {
            "$ref": "semio:local-interaction#/$defs/state"
          },
          "error": {
            "const": "stale-authority"
          }
        },
        "oneOf": [
          {
            "properties": { "expected": { "$ref": "semio:local-interaction#/$defs/state" } },
            "required": [
              "expected"
            ]
          },
          {
            "properties": { "error": { "const": "stale-authority" } },
            "required": [
              "error"
            ]
          }
        ]
      }
    }
  }
}
