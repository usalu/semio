{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:local-interaction",
  "oneOf": [
    {
      "$ref": "#/$defs/capture"
    },
    {
      "$ref": "#/$defs/restore"
    },
    {
      "$ref": "#/$defs/page"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$",
      "maxLength": 20
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "single",
        "multiple"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appInstanceId",
        "generation",
        "revision",
        "documentRevision",
        "topologyRevision"
      ],
      "properties": {
        "appInstanceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "documentRevision": {
          "$ref": "#/$defs/revision"
        },
        "topologyRevision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granularity",
        "ids"
      ],
      "properties": {
        "granularity": {
          "$ref": "#/$defs/id"
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "anchorId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "activeMode",
        "activeGranularity"
      ],
      "properties": {
        "selection": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/selection"
          }
        },
        "activeMode": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mode"
          }
        },
        "activeGranularity": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "domainPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "activeMode",
        "activeGranularity"
      ],
      "properties": {
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/selection"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/mode"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeGranularity": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "state"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "restore": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base",
            "state"
          ],
          "properties": {
            "kind": {
              "const": "full"
            },
            "base": {
              "$ref": "#/$defs/identity"
            },
            "state": {
              "$ref": "#/$defs/state"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base",
            "domains"
          ],
          "properties": {
            "kind": {
              "const": "domains"
            },
            "base": {
              "$ref": "#/$defs/identity"
            },
            "domains": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "$ref": "#/$defs/domainPatch"
              }
            }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "queryGeneration",
        "identity",
        "ordinal",
        "terminal",
        "bytes"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/generation"
        },
        "queryGeneration": { "$ref": "#/$defs/generation" },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "ordinal": {
          "$ref": "#/$defs/generation"
        },
        "terminal": {
          "type": "boolean"
        },
        "bytes": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
