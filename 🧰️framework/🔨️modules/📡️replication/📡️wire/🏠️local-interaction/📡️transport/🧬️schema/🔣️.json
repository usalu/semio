{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/replication/wire/local-interaction/transport/schema.json",
  "title": "Replication Wire Local-interaction Transport Schema Module",
  "definitions": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "queryGeneration",
        "identity",
        "ordinal"
      ],
      "properties": {
        "requestId": {
          "$ref": "https://semio.tech/schema/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
        },
        "queryGeneration": {
          "$ref": "https://semio.tech/schema/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
        },
        "identity": {
          "$ref": "https://semio.tech/schema/framework/replication/wire/local-interaction/schema.json#/$defs/Identity"
        },
        "ordinal": {
          "$ref": "https://semio.tech/schema/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requestId"
          ],
          "properties": {
            "kind": {
              "const": "read"
            },
            "requestId": {
              "$ref": "https://semio.tech/schema/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "token"
          ],
          "properties": {
            "kind": {
              "enum": [
                "acknowledge",
                "cancel"
              ]
            },
            "token": {
              "$ref": "#/definitions/token"
            }
          }
        }
      ]
    },
    "reply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "token"
          ],
          "properties": {
            "kind": {
              "const": "started"
            },
            "token": {
              "$ref": "#/definitions/token"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "$ref": "https://semio.tech/schema/framework/replication/wire/local-interaction/schema.json#/$defs/Page"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "token",
            "cancelled"
          ],
          "properties": {
            "kind": {
              "const": "closed"
            },
            "token": {
              "$ref": "#/definitions/token"
            },
            "cancelled": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requestId",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "rejected"
            },
            "requestId": {
              "$ref": "https://semio.tech/schema/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
            },
            "code": {
              "enum": [
                "busy",
                "closed",
                "generation-exhausted",
                "source-failed"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "Transport": {
      "oneOf": [
        {
          "$ref": "#/definitions/command"
        },
        {
          "$ref": "#/definitions/reply"
        }
      ]
    },
    "TransportFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "appCommandTag",
        "appFrameTag",
        "unsigned",
        "malformedUnsigned",
        "commandKinds",
        "replyKinds",
        "maximumPageBytes",
        "requestReuseNeedsNewGeneration",
        "lateAcknowledgementAfterCloseAccepted"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "appCommandTag": {
          "const": 29
        },
        "appFrameTag": {
          "const": 23
        },
        "unsigned": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decimal",
              "hex"
            ],
            "properties": {
              "decimal": {
                "$ref": "https://semio.tech/schema/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
              },
              "hex": {
                "type": "string",
                "pattern": "^([0-9a-f]{2}){1,10}$"
              }
            }
          }
        },
        "malformedUnsigned": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "pattern": "^([0-9a-f]{2}){1,10}$"
          }
        },
        "commandKinds": {
          "const": [
            "read",
            "acknowledge",
            "cancel"
          ]
        },
        "replyKinds": {
          "const": [
            "started",
            "page",
            "closed",
            "rejected"
          ]
        },
        "maximumPageBytes": {
          "const": 4096
        },
        "requestReuseNeedsNewGeneration": {
          "const": true
        },
        "lateAcknowledgementAfterCloseAccepted": {
          "const": false
        }
      }
    }
  }
}
