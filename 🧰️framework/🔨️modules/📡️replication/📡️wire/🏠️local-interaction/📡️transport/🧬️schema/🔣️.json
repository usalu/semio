{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/transport/schema.json",
  "title": "Replication Wire Local-interaction Transport Schema Module",
  "definitions": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "queryGeneration",
        "identity",
        "ordinal"
      ],
      "properties": {
        "requestId": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
        },
        "queryGeneration": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
        },
        "identity": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/Identity"
        },
        "ordinal": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requestId"
          ],
          "properties": {
            "kind": {
              "const": "read"
            },
            "requestId": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "token"
          ],
          "properties": {
            "kind": {
              "enum": [
                "acknowledge",
                "cancel"
              ]
            },
            "token": {
              "$ref": "#/definitions/token"
            }
          }
        }
      ]
    },
    "reply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "token"
          ],
          "properties": {
            "kind": {
              "const": "started"
            },
            "token": {
              "$ref": "#/definitions/token"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/Page"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "token",
            "cancelled"
          ],
          "properties": {
            "kind": {
              "const": "closed"
            },
            "token": {
              "$ref": "#/definitions/token"
            },
            "cancelled": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requestId",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "rejected"
            },
            "requestId": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/Generation"
            },
            "code": {
              "enum": [
                "busy",
                "closed",
                "generation-exhausted",
                "source-failed"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "Transport": {
      "oneOf": [
        {
          "$ref": "#/definitions/command"
        },
        {
          "$ref": "#/definitions/reply"
        }
      ]
    }
  }
}
