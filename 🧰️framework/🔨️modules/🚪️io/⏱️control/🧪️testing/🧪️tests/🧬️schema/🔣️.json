{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "grant",
    "cases",
    "panicCases",
    "cleanup"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "copy": {
          "type": "integer",
          "minimum": 1
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        },
        "release": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit",
          "repeat",
          "maximum",
          "cancelAt",
          "expected",
          "returnSlot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "maximum": {
            "type": "integer",
            "minimum": 0
          },
          "cancelAt": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "expected": {
            "enum": [
              "ok",
              "limit",
              "cancel"
            ]
          },
          "returnSlot": {
            "type": "boolean"
          }
        }
      }
    },
    "panicCases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "text",
          "events",
          "frontier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "semantic",
              "observer"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "enum": [
              [
                "retained",
                "closed",
                "resumed"
              ],
              [
                "reserved",
                "resumed"
              ]
            ]
          },
          "frontier": {
            "enum": [
              "retained",
              "reserved"
            ]
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "text",
        "cases"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1024
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "shortBy",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "shortBy": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "expected": {
                "enum": [
                  "ok",
                  "limit"
                ]
              }
            }
          }
        }
      }
    }
  }
}
