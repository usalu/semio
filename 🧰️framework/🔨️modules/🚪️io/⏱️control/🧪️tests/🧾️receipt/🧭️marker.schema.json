{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status",
      "mayReset"
    ],
    "properties": {
      "status": {
        "enum": [
          "absent",
          "pending",
          "accepted",
          "refused"
        ]
      },
      "mayReset": {
        "type": "boolean"
      }
    }
  }
}
