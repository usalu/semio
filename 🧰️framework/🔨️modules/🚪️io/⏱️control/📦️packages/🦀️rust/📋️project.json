{
  "name": "@semio-tech/framework-io-control-rs",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/⏱️trace/🧮️memory/🧪️testing/📥️requests/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/⚠️diagnostic/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test-source": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "metadata": {"semio":{"execution":{"version":1,"kind":"source"}}},
      "options": {
        "command": "bun ./📜️script.ts test-source",
        "cwd": "🧰️framework/🔨️modules/🚪️io/⏱️control/📦️packages/🦀️rust"
      },
      "cache": true,
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      },
      "defaultConfiguration": "prototype"
    },
    "test-native": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "metadata": {"semio":{"execution":{"version":1,"kind":"native","scope":"test"}}},
      "options": {
        "command": "bun ./📜️script.ts test-native",
        "cwd": "🧰️framework/🔨️modules/🚪️io/⏱️control/📦️packages/🦀️rust"
      },
      "cache": true,
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      },
      "defaultConfiguration": "prototype"
    },
    "test-snapshot-receiving-native": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "metadata": {"semio":{"execution":{"version":1,"kind":"native","scope":"test"}}},
      "options": {
        "command": "bun ./📜️script.ts test-snapshot-receiving-native",
        "cwd": "🧰️framework/🔨️modules/🚪️io/⏱️control/📦️packages/🦀️rust"
      },
      "cache": true,
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      },
      "defaultConfiguration": "prototype"
    }
  },
  "tags": [
    "scope:framework",
    "language:rust"
  ]
}
