{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cases",
    "wideRepeat",
    "widths"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "standard",
          "subset",
          "uri"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "standard": {
            "type": "string"
          },
          "subset": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          }
        }
      }
    },
    "wideRepeat": {
      "type": "integer",
      "minimum": 4097
    },
    "widths": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
