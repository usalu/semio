{
  "name": "@semio-tech/io-binary-source",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test-typescript": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🚪️io/🔢️binary/📥️source",
        "command": "bun ./📜️script.ts test typescript",
        "forwardAllArgs": true
      },
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🔤️base64/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🔤️fonts/😀️noto-emoji/🪉️supplement/⚖️medium/🔤️outline.ttf",
        "{workspaceRoot}/🧰️framework/🔨️modules/📚️compiler/🌍️world/🔤️fonts/⌨️LibertinusMono-Regular.otf"
      ]
    },
    "test-rust": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🚪️io/🔢️binary/📥️source",
        "command": "bun ./📜️script.ts test rust",
        "forwardAllArgs": true
      },
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🔤️base64/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🔤️fonts/😀️noto-emoji/🪉️supplement/⚖️medium/🔤️outline.ttf",
        "{workspaceRoot}/🧰️framework/🔨️modules/📚️compiler/🌍️world/🔤️fonts/⌨️LibertinusMono-Regular.otf"
      ]
    }
  },
  "metadata": {
    "nativeRoot": "🧰️framework/🔨️modules/🚪️io/🔢️binary/📥️source/📦️packages/🦀️rust"
  }
}
