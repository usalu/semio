{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Child Vector Preparation Laws",
  "type": "object",
  "required": [
    "schema",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "semio.child-vector-preparation.tests/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "drawingCase"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "drawingCase": {
            "type": "integer",
            "minimum": 0
          },
          "valid": {
            "type": "boolean"
          },
          "substitute": {
            "enum": [
              "source",
              "projection",
              "value",
              "admitter",
              "vector"
            ]
          },
          "cuts": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
