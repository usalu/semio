{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Borrowed Vector Scene Lowering Protocol",
  "type": "object",
  "required": [
    "grant",
    "event"
  ],
  "properties": {
    "grant": {
      "type": "object",
      "required": [
        "maximumSourceItems",
        "maximumDepth",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumCopyBytes"
      ],
      "properties": {
        "maximumSourceItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "canvas"
            },
            "schema": {
              "type": "string"
            },
            "canvas": {
              "$ref": "#/$defs/Canvas"
            }
          },
          "required": [
            "kind",
            "schema",
            "canvas"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "style"
            },
            "name": {
              "type": "string"
            },
            "fill": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Rgba"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stroke": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Rgba"
                },
                {
                  "type": "null"
                }
              ]
            },
            "strokeWidth": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "opacity": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "name",
            "fill",
            "stroke",
            "strokeWidth",
            "opacity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "beginLayer"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "name",
            "visible"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "beginGroup"
            },
            "transform": {
              "$ref": "#/$defs/Transform"
            }
          },
          "required": [
            "kind",
            "transform"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "beginPath"
            },
            "style": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "style"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "segment"
            },
            "segment": {
              "$ref": "#/$defs/Segment"
            }
          },
          "required": [
            "kind",
            "segment"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/Point2"
            },
            "style": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "value",
            "at",
            "style"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "image"
            },
            "at": {
              "$ref": "#/$defs/Point2"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "mime": {
              "type": "string"
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "kind",
            "at",
            "width",
            "height",
            "mime",
            "bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "endGroup"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "endPath"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "endLayer"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "done"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Point2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "Point3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "Quaternion": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "additionalProperties": false
    },
    "Rgba": {
      "type": "object",
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      },
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "additionalProperties": false
    },
    "Transform": {
      "type": "object",
      "properties": {
        "translation": {
          "$ref": "#/$defs/Point3"
        },
        "rotation": {
          "$ref": "#/$defs/Quaternion"
        },
        "scale": {
          "$ref": "#/$defs/Point3"
        }
      },
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "additionalProperties": false
    },
    "Canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgba"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "width",
        "height",
        "background"
      ],
      "additionalProperties": false
    },
    "Segment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "moveTo"
            },
            "to": {
              "$ref": "#/$defs/Point2"
            }
          },
          "required": [
            "kind",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "lineTo"
            },
            "to": {
              "$ref": "#/$defs/Point2"
            }
          },
          "required": [
            "kind",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "quadTo"
            },
            "c": {
              "$ref": "#/$defs/Point2"
            },
            "to": {
              "$ref": "#/$defs/Point2"
            }
          },
          "required": [
            "kind",
            "c",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cubicTo"
            },
            "c1": {
              "$ref": "#/$defs/Point2"
            },
            "c2": {
              "$ref": "#/$defs/Point2"
            },
            "to": {
              "$ref": "#/$defs/Point2"
            }
          },
          "required": [
            "kind",
            "c1",
            "c2",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "arcTo"
            },
            "rx": {
              "type": "number"
            },
            "ry": {
              "type": "number"
            },
            "xRotation": {
              "type": "number"
            },
            "largeArc": {
              "type": "boolean"
            },
            "sweep": {
              "type": "boolean"
            },
            "to": {
              "$ref": "#/$defs/Point2"
            }
          },
          "required": [
            "kind",
            "rx",
            "ry",
            "xRotation",
            "largeArc",
            "sweep",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "close"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
