{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "unit",
    "repeat",
    "utf8Bytes",
    "checkpointSources"
  ],
  "properties": {
    "authority": {
      "const": "hostContinuations"
    },
    "unit": {
      "const": "文🌠"
    },
    "repeat": {
      "const": 10000
    },
    "utf8Bytes": {
      "const": 70000
    },
    "checkpointSources": {
      "type": "array",
      "items": {
        "enum": [
          "schema",
          "native",
          "artifact"
        ]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    }
  }
}
