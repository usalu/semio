{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "framework/io/sqlite-snapshot/refusal.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authority",
          "operation",
          "expectedKind"
        ],
        "properties": {
          "id": {
            "enum": [
              "invalid-encoding",
              "invalid-schema",
              "invalid-nan",
              "canceled-pages",
              "canceled-projection",
              "value-limit",
              "schema-limit",
              "file-limit",
              "allocation-limit",
              "row-limit",
              "column-limit",
              "table-limit",
              "page-limit"
            ]
          },
          "authority": {
            "enum": [
              "syntax",
              "callback",
              "ownership",
              "work"
            ]
          },
          "operation": {
            "enum": [
              "encoding",
              "schema",
              "nan",
              "pages",
              "projection",
              "value",
              "schemaBytes",
              "file",
              "allocation",
              "rows",
              "columns",
              "tables",
              "pageCount"
            ]
          },
          "expectedKind": {
            "enum": [
              "invalidValue",
              "canceled",
              "ownershipLimit",
              "workLimit"
            ]
          }
        }
      }
    }
  }
}

