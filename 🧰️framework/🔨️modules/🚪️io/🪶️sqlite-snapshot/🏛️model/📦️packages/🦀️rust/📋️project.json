{
  "name": "@semio-tech/framework-io-sqlite-model-rs",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "scope:framework",
    "language:rust"
  ],
  "targets": {
    "test-source": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "metadata": {"semio":{"execution":{"version":1,"kind":"source"}}},
      "options": {
        "command": "repo ./📜️script.ts test-source",
        "cwd": "🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/🏛️model/📦️packages/🦀️rust"
      },
      "cache": true,
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  }
}
