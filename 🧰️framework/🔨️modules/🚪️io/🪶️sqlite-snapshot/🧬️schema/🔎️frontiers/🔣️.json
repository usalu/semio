    "nameFrontier": {
      "const": 16384
    },
    "nameSuffixes": {
      "const": [
        "ΣZ",
        "σZ"
      ]
    },
    "tableCount": {
      "const": 257
    },
    "tableFrontier": {
      "const": 256
    },
    "indexPhase": {
