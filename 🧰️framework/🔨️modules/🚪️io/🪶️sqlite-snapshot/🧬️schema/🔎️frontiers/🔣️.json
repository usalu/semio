{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Classification And Canonical Table Index Frontiers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "referenceEntries",
    "referenceFrontier",
    "referenceTypes",
    "referenceParities",
    "nameUnit",
    "nameLength",
    "nameFrontier",
    "nameSuffixes",
    "tableCount",
    "tableFrontier",
    "indexPhase",
    "refusal"
  ],
  "properties": {
    "referenceEntries": {
      "const": 768
    },
    "referenceFrontier": {
      "const": 256
    },
    "referenceTypes": {
