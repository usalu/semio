{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "definitions",
    "productionDependencies",
    "originalNativeLaws",
    "sourceBoundary",
    "budgets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "const": "semio-framework-io-codec"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "productionDependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "originalNativeLaws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSourceBytes",
        "maxSourceFiles",
        "maxActiveLines"
      ],
      "properties": {
        "maxSourceBytes": {
          "const": 262144
        },
        "maxSourceFiles": {
          "const": 32
        },
        "maxActiveLines": {
          "const": 4000
        }
      }
    },
    "budgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limit",
          "used",
          "increment",
          "admitted",
          "result"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "used": {
            "type": "integer",
            "minimum": 0
          },
          "increment": {
            "type": "integer",
            "minimum": 0
          },
          "result": {
            "type": "integer",
            "minimum": 0
          },
          "admitted": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
