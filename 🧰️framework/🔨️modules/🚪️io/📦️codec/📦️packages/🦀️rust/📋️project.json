{
  "name": "@semio-tech/framework-io-codec-rs",
  "tags": [
    "scope:framework",
    "language:rust"
  ],
  "targets": {
    "test-contract": {
      "executor": "repo:script",
      "cache": false,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "source"
          }
        }
      },
      "options": {
        "command": "bun ./📜️script.ts test-contract",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "test-native": {
      "executor": "repo:script",
      "cache": false,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "native",
            "scope": "test"
          }
        }
      },
      "options": {
        "command": "bun ./📜️script.ts test-native",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  }
}
