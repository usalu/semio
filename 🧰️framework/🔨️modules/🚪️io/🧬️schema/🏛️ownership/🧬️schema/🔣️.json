{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/io/vocabulary/ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packageName",
    "normalDependencies",
    "exports",
    "references"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "packageName": {
      "const": "semio-framework-io-schema"
    },
    "normalDependencies": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "semio-framework-value",
          "semio-framework-value-derive",
          "semio-framework-diagnostic",
          "semio-framework-schema-registry",
          "semio-framework-artifact-reference",
          "semio-framework-dsl-record"
        ]
      }
    },
    "exports": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "IoPayload",
          "CARRIER_BINARY",
          "CARRIER_TEXT",
          "SQLITE_SNAPSHOT",
          "Confidence",
          "IoFidelity",
          "IoError",
          "IoOutcome",
          "IoResult",
          "IoEntryDescriptor",
          "IoRoute",
          "register_io_schema_exports"
        ]
      }
    },
    "references": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/framework/schema/artifact-reference.json#/$defs/ArtifactRef"
      }
    }
  }
}
