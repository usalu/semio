{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/io/schema.json",
  "title": "Artifact IO Contracts",
  "$defs": {
    "IoFidelity": {
      "type": "string",
      "enum": [
        "Exact",
        "Canonical",
        "Semantic",
        "Lossy"
      ]
    },
    "IoEntryDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "into",
        "fidelity",
        "sniffs"
      ],
      "properties": {
        "from": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/schema/artifact-reference.json#/$defs/ArtifactDialect"
        },
        "into": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/schema/artifact-reference.json#/$defs/ArtifactDialect"
        },
        "fidelity": {
          "$ref": "#/$defs/IoFidelity"
        },
        "sniffs": {
          "type": "boolean"
        }
      }
    },
    "IoRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hops",
        "fidelity"
      ],
      "properties": {
        "hops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IoEntryDescriptor"
          }
        },
        "fidelity": {
          "$ref": "#/$defs/IoFidelity"
        }
      }
    },
    "IoError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause",
        "diagnostics"
      ],
      "properties": {
        "cause": {
          "$ref": "#/$defs/NativeSnapshotFailure"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/diagnostic/controlled#/$defs/Diagnostic"
          }
        }
      }
    },
    "NativeSnapshotFailure": {
      "title": "Native Snapshot Failure",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause",
        "receiptRefusal",
        "contextRefusal",
        "progress",
        "settlementRefusal"
      ],
      "properties": {
        "cause": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "const": "value"
                    },
                    "value": {
                      "type": "object",
                      "required": [
                        "kind",
                        "message"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "primary",
                    "quoteRefusal",
                    "allocationRefusal",
                    "progress"
                  ],
                  "properties": {
                    "type": {
                      "const": "receiving"
                    },
                    "primary": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "message"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    },
                    "quoteRefusal": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "message"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    },
                    "allocationRefusal": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "message"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    },
                    "progress": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "copiedItems",
                        "copiedBytes",
                        "retainedCapacityBytes",
                        "releasedBytes"
                      ],
                      "properties": {
                        "copiedItems": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "copiedBytes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "retainedCapacityBytes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "releasedBytes": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "receiptRefusal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "message"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "copiedItems",
            "copiedBytes",
            "retainedCapacityBytes",
            "releasedBytes"
          ],
          "properties": {
            "copiedItems": {
              "type": "integer",
              "minimum": 0
            },
            "copiedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "retainedCapacityBytes": {
              "type": "integer",
              "minimum": 0
            },
            "releasedBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "contextRefusal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "message"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "settlementRefusal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "message"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  }
}
