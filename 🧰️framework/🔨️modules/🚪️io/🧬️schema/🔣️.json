{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/io/schema.json",
  "title": "Artifact IO Contracts",
  "$defs": {
    "IoFidelity": {
      "type": "string",
      "enum": [
        "Exact",
        "Canonical",
        "Semantic",
        "Lossy"
      ]
    },
    "IoEntryDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "into",
        "fidelity",
        "sniffs"
      ],
      "properties": {
        "from": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/schema/artifact-reference.json#/$defs/ArtifactDialect"
        },
        "into": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/schema/artifact-reference.json#/$defs/ArtifactDialect"
        },
        "fidelity": {
          "$ref": "#/$defs/IoFidelity"
        },
        "sniffs": {
          "type": "boolean"
        }
      }
    },
    "IoRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hops",
        "fidelity"
      ],
      "properties": {
        "hops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IoEntryDescriptor"
          }
        },
        "fidelity": {
          "$ref": "#/$defs/IoFidelity"
        }
      }
    },
    "IoError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause",
        "diagnostics"
      ],
      "properties": {
        "cause": {
          "$ref": "https://semio.tech/schema/value/refusal/codec#/$defs/wire"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/diagnostic/controlled#/$defs/Diagnostic"
          }
        }
      }
    }
  }
}
