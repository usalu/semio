{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "cases"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "artifactKind": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "subset": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "enum": [
              "initial-cancel",
              "metadata-admission",
              "wrong-field-shape"
            ]
          },
          "kind": {
            "enum": [
              "canceled",
              "ownershipLimit",
              "invalidValue"
            ]
          }
        }
      }
    }
  }
}
