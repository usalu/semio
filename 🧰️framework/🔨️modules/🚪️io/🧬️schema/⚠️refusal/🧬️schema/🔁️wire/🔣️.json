{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 7,
  "maxItems": 7,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "members",
      "operation",
      "accept",
      "maximumBytes",
      "expectedKind"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "members": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "operation": {
        "enum": [
          "encode",
          "decode"
        ]
      },
      "accept": {
        "type": "boolean"
      },
      "maximumBytes": {
        "type": "integer",
        "minimum": 0
      },
      "expectedKind": {
        "$ref": "https://semio.tech/schema/value/refusal#/$defs/kind"
      }
    }
  }
}