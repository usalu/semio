{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 18,
  "maxItems": 18,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "operation",
      "kind",
      "message",
      "span",
      "expected"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "operation": {
        "enum": [
          "value",
          "text",
          "textCanceled",
          "textOwnership"
        ]
      },
      "kind": {
        "$ref": "https://semio.tech/schema/value/refusal#/$defs/kind"
      },
      "message": {
        "type": "string"
      },
      "span": {
        "$ref": "https://semio.tech/schema/diagnostic/controlled#/$defs/TextSpan"
      },
      "expected": {
        "type": "string"
      },
      "expectedWire": {
        "$ref": "https://semio.tech/schema/io/refusal"
      },
      "expectedKind": {
        "$ref": "https://semio.tech/schema/value/refusal#/$defs/kind"
      }
    }
  }
}