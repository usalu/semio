{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "titles",
    "history",
    "inferenceExports"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "title"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "key",
          "parent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "label": {
            "type": "string",
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "entry",
              "mutation"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        }
      }
    },
    "inferenceExports": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  }
}
