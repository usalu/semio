{
  "name": "@semio-tech/framework-surface-rs",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🗺️surface/🧩️component/**/*"
    ]
  },
  "targets": {
    "test-scene-wire-native": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-scene-wire-native"
      }
    },
    "test-scene-wire-source": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-scene-wire-source"
      }
    },
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts wasm"
      },
      "outputs": [
        "{projectRoot}/🕸️bindings"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/🧰️framework/🔨️modules/🗺️surface/🎨️paint/🧪️tests/🧫️fixtures/✏️editing/🔣️.json"
      ]
    },
    "test-source": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-source"
      }
    }
  }
}
