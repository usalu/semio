{
  "name": "@semio-tech/framework-surface-rs",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🗺️surface/🧩️component/**/*"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🗺️surface/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test-scene-wire-native": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-scene-wire-native"
      }
    },
    "test-scene-wire-source": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-scene-wire-source"
      }
    },
    "wasm": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts wasm"
      },
      "outputs": ["{projectRoot}/.🧾️store/wasm.json"],
      "cache": true,
      "metadata": {
        "semio": {
          "wasmPackageSourceV1": {
            "version": 1,
            "sourceOwner": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust"
          }
        }
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      },
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain",
        "production",
        "^production",
        "{workspaceRoot}/🧰️framework/🔨️modules/🗺️surface/🎨️paint/🧪️tests/🧫️fixtures/✏️editing/🔣️.json"
      ]
    },
    "test-source": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-source"
      }
    }
  }
}
