{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/surface/paint/editing.json",
  "title": "Shared Paint Editing Semantic Corpus",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coordinates"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "maskCases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/maskCoordinates"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "selectionTransport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunkPixels": {
          "type": "integer",
          "minimum": 1
        },
        "maxEncodedCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transportCase"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": {
              "type": "integer",
              "minimum": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "length",
            "start",
            "count",
            "value"
          ]
        },
        "cancellationAfter": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "chunkPixels",
        "maxEncodedCharacters",
        "cases",
        "boundary",
        "cancellationAfter"
      ]
    },
    "selectionEditing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/editingCase"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "progress": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "cases",
        "length",
        "progress"
      ]
    }
  },
  "required": [
    "cases",
    "maskCases",
    "selectionTransport",
    "selectionEditing"
  ],
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "matrix": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "c": {
          "type": "number"
        },
        "d": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "a",
        "b",
        "c",
        "d"
      ]
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "zoom"
      ]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/size"
      }
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "linked": {
          "type": "boolean"
        },
        "invert": {
          "type": "boolean"
        },
        "imageKey": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "transform": {
          "$ref": "#/$defs/transform"
        }
      },
      "required": [
        "enabled",
        "linked",
        "invert",
        "imageKey",
        "width",
        "height",
        "transform"
      ]
    },
    "layer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pixel"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "imageKey": {
              "type": "string",
              "minLength": 1
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "mask": {
              "$ref": "#/$defs/mask"
            }
          },
          "required": [
            "kind",
            "id",
            "width",
            "height",
            "transform"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "group"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "visible": {
              "type": "boolean"
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layer"
              }
            }
          },
          "required": [
            "kind",
            "id",
            "visible",
            "transform",
            "children"
          ]
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "raster.document"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      },
      "required": [
        "layers"
      ]
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "viewport": {
          "$ref": "#/$defs/size"
        },
        "assets": {
          "$ref": "#/$defs/assets"
        },
        "worldPoint": {
          "$ref": "#/$defs/point"
        },
        "pixelPoint": {
          "$ref": "#/$defs/point"
        },
        "imageTransform": {
          "$ref": "#/$defs/matrix"
        }
      },
      "required": [
        "name",
        "document",
        "camera",
        "viewport",
        "assets",
        "worldPoint",
        "pixelPoint",
        "imageTransform"
      ]
    },
    "maskCoordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "assets": {
          "$ref": "#/$defs/assets"
        },
        "worldPoint": {
          "$ref": "#/$defs/point"
        },
        "pixelPoint": {
          "$ref": "#/$defs/point"
        },
        "svgTransform": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "document",
        "assets",
        "worldPoint",
        "pixelPoint",
        "svgTransform"
      ]
    },
    "transportCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "mask": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "spans": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "bounds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bounds"
            }
          ]
        }
      },
      "required": [
        "name",
        "width",
        "mask",
        "spans",
        "bounds"
      ]
    },
    "editingCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "all",
            "invert"
          ]
        },
        "mask": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          ]
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "name",
        "mode",
        "mask",
        "expected"
      ]
    }
  }
}
