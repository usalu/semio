{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["directoryName", "module", "types", "wasm", "wasmTypes", "contracts"],
  "properties": {
    "directoryName": { "const": "🕸️bindings" },
    "module": { "const": "framework_surface.js" },
    "types": { "const": "framework_surface.d.ts" },
    "wasm": { "const": "framework_surface_bg.wasm" },
    "wasmTypes": { "const": "framework_surface_bg.wasm.d.ts" },
    "contracts": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
