{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terrain Move Position Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    }
  }
}
