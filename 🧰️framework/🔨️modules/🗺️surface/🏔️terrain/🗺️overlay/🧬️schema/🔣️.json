{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/surface/terrain/overlays.json",
  "title": "Terrain Overlays",
  "type": "object",
  "required": ["positions", "routes", "regions"],
  "properties": {
    "positions": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/feature" },
          {
            "type": "object",
            "required": ["coordinates"],
            "properties": {
              "coordinates": { "$ref": "#/$defs/coordinate" },
              "elevation": { "type": "number", "description": "Absolute elevation in meters. Markers are raised to the terrain when it is higher." }
            }
          }
        ]
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/feature" },
          {
            "type": "object",
            "required": ["coordinates"],
            "properties": {
              "coordinates": { "$ref": "#/$defs/path" }
            }
          }
        ]
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/feature" },
          {
            "type": "object",
            "required": ["rings"],
            "properties": {
              "rings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [{ "$ref": "#/$defs/path" }, { "type": "array", "minItems": 3 }]
                },
                "description": "Exterior ring followed by any holes. An open ring is closed during rendering."
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "coordinate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/longitude" },
        { "$ref": "#/$defs/latitude" }
      ]
    },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "latitude": { "type": "number", "minimum": -85.05112878, "maximum": 85.05112878 },
    "path": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/coordinate" }
    }
  }
}
