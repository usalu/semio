{
  "name": "semio-framework-3d",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧊️3d/**/*.rs",
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧊️3d/**/🧪️tests/**/🧫️fixtures/**/*",
      "sharedGlobals"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧊️3d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "bench": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧊️3d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts bench"
      },
      "cache": false,
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "diagnostic", "reason": "measures-environment" }
        }
      }
    },
    "lint": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧊️3d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts lint"
      }
    },
    "canonical-architecture": {
      "executor": "repo:script",
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧊️3d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts canonical-architecture",
        "forwardAllArgs": true
      },
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ]
    }
  }
}
