    "bench": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧊️3d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts bench"
      },
      "cache": false
    },
    "lint": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧊️3d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts lint"
