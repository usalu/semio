{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected Solid Operation Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "box", "volume", "refusals", "successes"],
  "properties": {
    "schema": {"const": "brep.selected-solid-scope.v1"},
    "box": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
    "volume": {"type": "number", "exclusiveMinimum": 0},
    "successes": {
      "type": "array", "minItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation", "selection", "index", "size", "volume"],
        "properties": {
          "operation": {"enum": ["filletEdges", "chamferEdges", "shell"]},
          "selection": {"enum": ["singleEdge", "singleFace", "closed"]},
          "index": {"type": "integer", "minimum": 0, "maximum": 5},
          "size": {"type": "number", "exclusiveMinimum": 0},
          "volume": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "refusals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation", "selection", "parameter", "error"],
        "properties": {
          "operation": {"enum": ["filletEdges", "chamferEdges", "shell"]},
          "selection": {"type": "array", "items": {"enum": ["current", "allCurrent", "foreign", "wrongDomain", "unknown"]}},
          "parameter": {"enum": ["positive", "zero", "negative", "nan", "infinity"]},
          "error": {"enum": ["invalidInput", "missingHandle"]}
        }
      }
    }
  }
}
