{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nativeFamily",
    "system",
    "grants",
    "cold",
    "cancel",
    "box",
    "liveRows",
    "validationScratch"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "nativeFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoffCapacityBytes",
        "handoffReleaseBytes",
        "convertToNurbs",
        "wire",
        "compoundVolume"
      ],
      "properties": {
        "handoffCapacityBytes": {
          "type": "integer",
          "const": 0
        },
        "handoffReleaseBytes": {
          "type": "integer",
          "const": 0
        },
        "convertToNurbs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              false,
              true
            ]
          }
        },
        "wire": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "length"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "const": 2
            },
            "height": {
              "type": "integer",
              "const": 3
            },
            "length": {
              "type": "integer",
              "const": 10
            }
          }
        },
        "compoundVolume": {
          "type": "integer",
          "const": 2
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constructorCapacityBytes",
        "cancelCapacityBytes",
        "cancelReleaseBytes",
        "handoffCapacityBytes",
        "handoffReleaseBytes",
        "turnCapacityBytes"
      ],
      "properties": {
        "constructorCapacityBytes": {
          "type": "integer",
          "const": 0
        },
        "cancelCapacityBytes": {
          "type": "integer",
          "const": 0
        },
        "cancelReleaseBytes": {
          "type": "integer",
          "const": 0
        },
        "handoffCapacityBytes": {
          "type": "integer",
          "const": 0
        },
        "handoffReleaseBytes": {
          "type": "integer",
          "const": 0
        },
        "turnCapacityBytes": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "bytes"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "const": 1
        },
        "bytes": {
          "type": "integer",
          "const": 8
        }
      }
    },
    "cold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialEdges",
        "initialFaces",
        "initialUnits",
        "callerProbeTurns"
      ],
      "properties": {
        "initialEdges": {
          "type": "integer",
          "const": 0
        },
        "initialFaces": {
          "type": "integer",
          "const": 0
        },
        "initialUnits": {
          "type": "integer",
          "const": 0
        },
        "callerProbeTurns": {
          "type": "integer",
          "const": 8
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releasesAtSignal",
        "releasesBeforeCredit",
        "sampleReleases",
        "meshReleases"
      ],
      "properties": {
        "releasesAtSignal": {
          "type": "integer",
          "const": 0
        },
        "releasesBeforeCredit": {
          "type": "integer",
          "const": 0
        },
        "sampleReleases": {
          "type": "integer",
          "const": 1
        },
        "meshReleases": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faces",
        "edges",
        "triangles",
        "area",
        "volume"
      ],
      "properties": {
        "faces": {
          "type": "integer",
          "const": 6
        },
        "edges": {
          "type": "integer",
          "const": 12
        },
        "triangles": {
          "type": "integer",
          "const": 12
        },
        "area": {
          "type": "integer",
          "const": 6
        },
        "volume": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "liveRows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "removedKeys",
        "payloadBytes",
        "maximumPredicatesPerTurn",
        "extractionCapacityBytes",
        "extractionReleaseBytes"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "enum": [
              "a",
              "b",
              "c",
              "d"
            ]
          }
        },
        "removedKeys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "a",
              "c"
            ]
          }
        },
        "payloadBytes": {
          "type": "integer",
          "const": 17
        },
        "maximumPredicatesPerTurn": {
          "type": "integer",
          "const": 1
        },
        "extractionCapacityBytes": {
          "type": "integer",
          "const": 0
        },
        "extractionReleaseBytes": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "validationScratch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmTurns",
        "constructorCapacityBytes",
        "constructorReleaseBytes",
        "handoffCapacityBytes",
        "handoffReleaseBytes",
        "minimumRetainedBytes"
      ],
      "properties": {
        "warmTurns": {
          "type": "integer",
          "const": 100
        },
        "constructorCapacityBytes": {
          "type": "integer",
          "const": 0
        },
        "constructorReleaseBytes": {
          "type": "integer",
          "const": 0
        },
        "handoffCapacityBytes": {
          "type": "integer",
          "const": 0
        },
        "handoffReleaseBytes": {
          "type": "integer",
          "const": 0
        },
        "minimumRetainedBytes": {
          "type": "integer",
          "const": 1
        }
      }
    }
  }
}
