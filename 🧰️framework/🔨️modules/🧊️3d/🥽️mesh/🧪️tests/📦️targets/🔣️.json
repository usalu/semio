{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bytes",
    "files",
    "lines",
    "accepted"
  ],
  "properties": {
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "integer",
      "minimum": 0
    },
    "accepted": {
      "type": "boolean"
    }
  }
}
