{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mesh Boundary Extrusion",
  "description": "Extrudes one open chain of selected boundary halfedges by an explicit displacement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edges",
    "offset"
  ],
  "properties": {
    "edges": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "offset": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  }
}
