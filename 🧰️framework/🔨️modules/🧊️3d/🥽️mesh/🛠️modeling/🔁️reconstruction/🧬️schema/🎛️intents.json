          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "vertices",
        "mode",
        "threshold"
      ],
      "properties": {
        "kind": {
