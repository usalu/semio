      "ecosystem": "javascript",
      "package": "gltf-validator",
      "version": "2.0.0-dev.3.10",
      "source": {
        "repository": "https://github.com/KhronosGroup/glTF-Validator",
        "license": "Apache-2.0"
      },
      "engine": {
        "family": "khronos-gltf-validator",
