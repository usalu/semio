{
  "name": "@semio-tech/framework-test",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test-adapter-ownership": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "{projectRoot}/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/**/*"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧪️test",
        "command": "repo ./📜️script.ts test adapter-ownership"
      }
    }
  },
  "tags": [
    "scope:framework"
  ]
}
