{
  "name": "@semio-tech/framework-test-mutation-inventory",
  "namedInputs": {
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "conformance": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "cargoToolchain",
        "{projectRoot}/**/*"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧪️test/🎮️mutation/🏭️inventory/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts conformance"
      }
    },
    "test-native": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain",
        "{projectRoot}/**/*"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧪️test/🎮️mutation/🏭️inventory/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "conformance-process": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "cargoToolchain",
        "{projectRoot}/**/*"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧪️test/🎮️mutation/🏭️inventory/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts conformance-process"
      }
    },
    "conformance-command": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "cargoToolchain",
        "{projectRoot}/**/*"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧪️test/🎮️mutation/🏭️inventory/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts conformance-command"
      }
    }
  },
  "tags": [
    "scope:framework"
  ]
}
