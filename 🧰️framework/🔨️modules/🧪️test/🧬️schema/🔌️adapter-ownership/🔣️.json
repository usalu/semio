{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases",
    "removedFiles",
    "removedExports"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "directory",
          "scenarios"
        ],
        "properties": {
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "oracle": {
            "enum": [
              "semver",
              "clsx",
              "class-variance-authority"
            ]
          }
        }
      }
    },
    "removedFiles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "removedExports": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "names"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "names": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
