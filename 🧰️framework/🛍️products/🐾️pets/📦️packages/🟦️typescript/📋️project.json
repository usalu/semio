{
  "name": "@semio-tech/pets",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧬️schema/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🔨️modules/**/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧪️tests/**/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧫️fixtures/**/*"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts typecheck",
        "forwardAllArgs": true
      }
    }
  }
}
