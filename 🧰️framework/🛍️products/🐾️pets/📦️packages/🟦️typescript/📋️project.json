{
  "name": "@semio-tech/pets",
  "$schema": "../../../🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧬️schema/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🔨️modules/**/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧪️tests/**/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧪️tests/🧫️fixtures/**/*",
      "sharedGlobals"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts typecheck",
        "forwardAllArgs": true
      }
    }
  }
}
