{
  "name": "@semio-tech/pets-rs",
  "$schema": "../../../🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "root": "🧰️framework/🛍️products/🐾️pets/📦️packages/🦀️rust",
  "sourceRoot": "🧰️framework/🛍️products/🐾️pets/📦️packages/🦀️rust",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "role:product",
    "family:pets"
  ],
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/**/*.rs",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧬️schema/🔣️.json",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧪️tests/🧫️fixtures/**/*",
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "inputs": [
        "production",
        "^production",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ]
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
