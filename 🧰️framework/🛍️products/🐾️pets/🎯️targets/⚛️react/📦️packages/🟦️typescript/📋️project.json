{
  "name": "@semio-tech/pets-react",
  "$schema": "../../../../../🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/🟦️.tsx",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/🎨️.css",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/🔨️modules/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/📖️stories/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/🏗️builder/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/🧪️tests/🎚️config/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧬️schema/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🔨️modules/**/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/📦️packages/🟦️typescript/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧪️tests/*/🟦️.tsx",
      "{workspaceRoot}/🧰️framework/🛍️products/🐾️pets/🧪️tests/🧫️fixtures/*/🔣️.json"
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts typecheck",
        "forwardAllArgs": true
      }
    },
    "dev": {
      "metadata": {
        "semio": {
          "dashboard": {
            "ready": {
              "portEnv": "PETS_STORIES_PORT"
            },
            "parameters": [
              {
                "id": "stories-port",
                "kind": "text",
                "default": "6069",
                "valueEnv": "PETS_STORIES_PORT"
              },
              {
                "id": "menagerie",
                "kind": "text",
                "valueEnv": "PETS_MENAGERIE"
              }
            ]
          }
        }
      },
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts dev",
        "env": {
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      },
      "cache": false,
      "continuous": true
    }
  }
}
