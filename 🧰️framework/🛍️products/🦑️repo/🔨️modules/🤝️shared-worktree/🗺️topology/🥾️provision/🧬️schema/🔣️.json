{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/framework/repo/shared-worktree/provision/v1",
 "title": "Shared worktree provisioning kit: the receipt `published` of the kit in the group store",
 "definitions": {
  "Sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "Count": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "KitPublished": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "code",
    "files",
    "moduleRoot",
    "publishedAt",
    "sums",
    "version"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "publishedAt": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "code": {
     "$ref": "#/definitions/Sha256"
    },
    "moduleRoot": {
     "type": "string",
     "minLength": 1,
     "maxLength": 240
    },
    "files": {
     "$ref": "#/definitions/Count"
    },
    "sums": {
     "$ref": "#/definitions/Sha256"
    }
   }
  }
 }
}
