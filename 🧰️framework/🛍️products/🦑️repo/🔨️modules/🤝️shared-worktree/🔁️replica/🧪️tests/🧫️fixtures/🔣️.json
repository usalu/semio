    {
     "machine": "a",
     "op": "write",
     "path": "src/main.txt",
     "text": "one"
    },
    {
     "machine": "a",
     "op": "publish"
    },
    {
     "machine": "b",
     "op": "follow"
    }
   ],
   "expect": {
    "tree": {
     "src/main.txt": "one"
    },
    "converged": [
     "a",
     "b"
    ]
   }
