{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:shared-worktree-replica:v1",
  "title": "Shared Worktree Replica Local State",
  "description": "🔁️ The closed documents of the replica daemon: the machine identity (the binary local state of the shared tree is described by `💾️state/🧬️schema/🔣️.json`), the read positions, the clock, the daemon lock, the NDJSON progress events, the status report and the verify report. Every document lives under `.cache/f/` of the worktree except the progress events, which only travel on stdout, and the home marker, which the origin writes into its home store.",
  "oneOf": [
    { "$ref": "#/definitions/Machine" },
    { "$ref": "#/definitions/Cursor" },
    { "$ref": "#/definitions/Clock" },
    { "$ref": "#/definitions/Lock" },
    { "$ref": "#/definitions/Home" },
    { "$ref": "#/definitions/ProgressEvent" },
    { "$ref": "#/definitions/Status" },
    { "$ref": "#/definitions/VerifyReport" }
  ],
  "definitions": {
    "Queue": {
      "description": "Bounds retries of already blocked ordinary paths in one follow turn.",
      "const": {"maximumWorktreeRetriesPerTurn": 64}
    },
    "LargePublish": {
      "description": "Bounds temporary retry delays after large outbound preparations lose their verified source or blob.",
      "const": {"retryMilliseconds": 5000, "retainedRetries": 64}
    },
    "OriginId": {
      "description": "Unique per machine; the only writer below origins/<id>/ in its home store.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "GroupId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "Hlc": {
      "type": "string",
      "pattern": "^[0-9]{13}-[0-9]{6}-[a-z0-9][a-z0-9-]{0,39}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Count": {
      "type": "integer",
      "minimum": 0
    },
    "Machine": {
      "description": "machine.json: who this machine is and where its group store is mounted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "originId", "groupId", "storeRoot"],
      "properties": {
        "version": { "const": 1 },
        "originId": { "$ref": "#/definitions/OriginId" },
        "groupId": { "$ref": "#/definitions/GroupId" },
        "storeRoot": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "pattern": "^[0-9a-f]{32}$", "description": "The random identity of this machine for its origin id; the first publish records it in the origin's home.json, and a machine with another key is refused for that origin." }
      }
    },
    "Operation": {
      "enum": ["put", "delete", "link"]
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment", "bytes"],
      "properties": {
        "segment": { "$ref": "#/definitions/Count" },
        "bytes": { "$ref": "#/definitions/Count" }
      }
    },
    "Cursor": {
      "description": "cursor.json: the next unread position per origin; since the binary state the current value lives in the memo `cursors` of `state.ckp` and `state.wal`, the file is written only by daemons of the earlier format.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cursors"],
      "properties": {
        "version": { "const": 1 },
        "cursors": { "type": "object", "additionalProperties": { "$ref": "#/definitions/Position" } }
      }
    },
    "Clock": {
      "description": "clock.json: the last issued or observed hybrid logical clock value; since the binary state the current value lives in the memo `clock` of `state.ckp` and `state.wal`, the file is written only by daemons of the earlier format.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ms", "counter"],
      "properties": {
        "version": { "const": 1 },
        "ms": { "$ref": "#/definitions/Count" },
        "counter": { "$ref": "#/definitions/Count" }
      }
    },
    "Lock": {
      "description": "daemon.lock: created exclusively by the one daemon of a worktree; a lock whose holder (pid with creation time) is gone is stale.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "pid", "startMs", "originId"],
      "properties": {
        "version": { "const": 1 },
        "pid": { "type": "integer", "minimum": 1 },
        "startMs": { "type": "integer", "minimum": 1, "description": "Creation time of the holder process in ms since the epoch (the process identity of pid and startMs): a pid that now belongs to a process created at another time is another process and the lock is stale." },
        "originId": { "$ref": "#/definitions/OriginId" },
        "bootMs": { "$ref": "#/definitions/Count", "description": "Estimated boot time of the host (wall clock minus uptime) when the lock was taken: a lock from another boot is stale." },
        "hb": { "const": true, "description": "The holder refreshes the modification time of the lock every 5 s; a lock with this marker that has not been refreshed for 60 s is stale although its pid answers." }
      }
    },
    "SyncSwitch": {
      "description": "Machine-local switch at .cache/f/sync.json. Missing file means synchronization is on.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "enabled"],
      "properties": {
        "version": { "const": 1 },
        "enabled": { "type": "boolean" }
      }
    },
    "Home": {
      "description": "origins/<originId>/home.json: written by the origin itself on its first publish; a relay pulls the origin only from the store of this group.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "group"],
      "properties": {
        "version": { "const": 1 },
        "group": { "$ref": "#/definitions/GroupId" },
        "key": { "type": "string", "pattern": "^[0-9a-f]{32}$", "description": "The key of the machine that owns this origin id (see Machine)." }
      }
    },
    "EventName": {
      "enum": ["started", "stopped", "scan", "progress", "published", "applied", "overwritten", "merged", "kept", "linearised", "repaired", "state-rebuilt", "state-missing", "refused", "skipped", "blocked", "unstable", "store-unreachable", "store-reachable", "ignore-reloaded", "clock-refused", "clock-skew", "blob-missing", "rejoin-required", "relayed", "snapshot", "compacted", "sync", "restarting", "restart-refused", "store-stuck", "code-reverted", "journal-repaired", "retired", "superseded", "stale-republish", "stale-base", "drift", "blob-repaired", "error"]
    },
    "ProgressEvent": {
      "description": "One NDJSON line on stdout.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "event"],
      "properties": {
        "version": { "const": 1 },
        "event": { "$ref": "#/definitions/EventName" },
        "stage": { "type": "string" },
        "path": { "type": "string" },
        "origin": { "type": "string" },
        "originId": { "type": "string" },
        "groupId": { "type": "string" },
        "hlc": { "type": "string" },
        "reason": { "type": "string" },
        "message": { "type": "string" },
        "lost": { "type": "string" },
        "winner": { "type": "string" },
        "loser": { "type": "string" },
        "result": { "type": "string" },
        "count": { "$ref": "#/definitions/Count" },
        "done": { "$ref": "#/definitions/Count" },
        "total": { "$ref": "#/definitions/Count" },
        "bytes": { "$ref": "#/definitions/Count" },
        "seconds": { "$ref": "#/definitions/Count" }
      }
    },
    "OriginLag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "behindEvents", "behindBytes", "lastHlc", "ageSeconds", "rejoinRequired", "retired"],
      "properties": {
        "origin": { "$ref": "#/definitions/OriginId" },
        "behindEvents": { "$ref": "#/definitions/Count" },
        "behindBytes": { "$ref": "#/definitions/Count" },
        "lastHlc": { "oneOf": [{ "$ref": "#/definitions/Hlc" }, { "type": "null" }] },
        "ageSeconds": { "oneOf": [{ "$ref": "#/definitions/Count" }, { "type": "null" }] },
        "rejoinRequired": { "type": "boolean" },
        "retired": { "type": "boolean", "description": "True while the newest retirement record of the origin says retired; its lag is then not measured." }
      }
    },
    "Quantiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95"],
      "properties": {
        "p50": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Count" }] },
        "p95": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Count" }] }
      }
    },
    "TierReport": {
      "description": "What the last pass of one background tier cost: passes run, cost of the last pass in milliseconds (CPU time; wall time for the view) and the duty cycle in percent of one core it was scheduled for.",
      "type": "object",
      "additionalProperties": false,
      "required": ["passes", "lastMs", "dutyPercent"],
      "properties": {
        "passes": { "$ref": "#/definitions/Count" },
        "lastMs": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Count" }] },
        "dutyPercent": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 100 }] }
      }
    },
    "Latency": {
      "description": "The passive latency over the newest 100 samples of steady-state publishes (hint, hot, directory sweep, watcher; not the start-up walk or the file sweep) and of events published after the daemon started, plus the timings of the background tiers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["publishMs", "applyMs", "samples", "tiers"],
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hot", "sweep", "file", "walk", "view"],
          "properties": { "hot": { "$ref": "#/definitions/TierReport" }, "sweep": { "$ref": "#/definitions/TierReport" }, "file": { "$ref": "#/definitions/TierReport" }, "walk": { "$ref": "#/definitions/TierReport" }, "view": { "$ref": "#/definitions/TierReport" } }
        },
        "publishMs": { "$ref": "#/definitions/Quantiles" },
        "applyMs": { "$ref": "#/definitions/Quantiles" },
        "samples": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publish", "apply"],
          "properties": { "publish": { "$ref": "#/definitions/Count" }, "apply": { "$ref": "#/definitions/Count" } }
        }
      }
    },
    "AccessRecord": {
      "description": "The record origins/<origin>/access.json: the replica of an origin cannot read its worktree.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "originId", "state", "wallMs", "worktree", "platform", "error"],
      "properties": {
        "version": { "const": 1 },
        "originId": { "$ref": "#/definitions/OriginId" },
        "state": { "enum": ["denied", "waiting-for-consent"] },
        "wallMs": { "$ref": "#/definitions/Count" },
        "worktree": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "error": { "type": "string" }
      }
    },
    "Status": {
      "description": "The report of `status`: lag per origin, queue sizes and the number of preserved overwritten files.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "originId", "groupId", "storeRoot", "reachable", "daemon", "sync", "files", "queue", "lost", "refused", "refusedPaths", "git", "origins", "retired", "latency", "health", "store"],
      "properties": {
        "version": { "const": 1 },
        "access": { "$ref": "#/definitions/AccessRecord" },
        "originId": { "$ref": "#/definitions/OriginId" },
        "groupId": { "$ref": "#/definitions/GroupId" },
        "storeRoot": { "type": "string", "minLength": 1 },
        "reachable": { "type": "boolean" },
        "daemon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["running", "pid"],
          "properties": {
            "running": { "type": "boolean" },
            "pid": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
            "busySeconds": { "type": "integer", "minimum": 5, "description": "Present while the event loop of the running daemon has not answered for at least five seconds; the watchdog thread of the daemon proves that it is alive." }
          }
        },
        "code": {
          "description": "Present while a daemon runs: where its code comes from (the worktree, a sealed snapshot of this machine or a snapshot of the store) and its phase.",
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "phase"],
          "properties": {
            "source": { "enum": ["worktree", "snapshot", "store"] },
            "phase": { "enum": ["boot", "open", "run"] }
          }
        },
        "sync": {
          "type": "boolean",
          "description": "False while this machine's .cache/f/sync.json turns synchronization off. Absent file means on."
        },
        "files": { "$ref": "#/definitions/Count" },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["incoming", "outgoing"],
          "properties": {
            "incoming": { "$ref": "#/definitions/Count" },
            "outgoing": { "oneOf": [{ "$ref": "#/definitions/Count" }, { "type": "null" }] }
          }
        },
        "lost": { "$ref": "#/definitions/Count" },
        "refused": {
          "oneOf": [{ "$ref": "#/definitions/Count" }, { "type": "null" }],
          "description": "Paths the path policy refuses to share (too long, not NFC, illegal characters, case collisions, unsafe links); counted by `status --deep`, which scans the tree, otherwise null."
        },
        "refusedPaths": {
          "description": "The record of refused paths the daemon keeps in `.cache/f/refused-paths.json`: the 200 newest distinct paths with reason and time, newest last, and the count of first refusals; empty while there is no record. Unlike `refused` it needs no scan.",
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "total", "recent"],
          "properties": {
            "version": { "const": 1 },
            "total": { "$ref": "#/definitions/Count" },
            "recent": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "reason", "wallMs"],
                "properties": {
                  "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "wallMs": { "$ref": "#/definitions/Count" }
                }
              }
            }
          }
        },
        "origins": { "type": "array", "items": { "$ref": "#/definitions/OriginLag" } },
        "latency": {
          "description": "The latency this machine's daemon attested last; null while the store is unreachable or the daemon has not attested yet.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Latency" }]
        },
        "retired": {
          "description": "Null, or who retired this machine's own origin, why and when: the daemon of a retired origin publishes and applies nothing until `retire --undo`.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["by", "reason", "wallMs"],
              "properties": {"by": { "$ref": "#/definitions/OriginId" }, "reason": { "type": "string", "maxLength": 500 }, "wallMs": { "$ref": "#/definitions/Count" }}
            }
          ]
        },
        "bootstrap": {
          "description": "Present on the group server that builds the bootstrap archive: the archive the manifest names and its bytes, the superseded archive bytes still held for readers inside the grace, the bytes retired by the latest build, and the last refusal for lack of space (null after a build succeeded). See `BootstrapRecord` of the bootstrap schema.",
          "type": "object",
          "additionalProperties": false,
          "required": ["wallMs", "archive", "bytes", "held", "retiredBytes", "refusal"],
          "properties": {
            "wallMs": { "$ref": "#/definitions/Count" },
            "archive": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "bytes": { "$ref": "#/definitions/Count" },
            "held": { "type": "object", "additionalProperties": false, "required": ["files", "bytes"], "properties": { "files": { "$ref": "#/definitions/Count" }, "bytes": { "$ref": "#/definitions/Count" } } },
            "retiredBytes": { "$ref": "#/definitions/Count" },
            "refusal": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["need", "free", "reserve", "wallMs"], "properties": { "need": { "type": "string" }, "free": { "type": "string" }, "reserve": { "type": "string" }, "wallMs": { "$ref": "#/definitions/Count" } } }] }
          }
        },
        "store": {
          "description": "Null while the store is unreachable, else the size report of the store (see `Store` of the compaction schema, which validates it): journal size, newest snapshot, what a compaction would reclaim now.",
          "oneOf": [{ "type": "null" }, { "type": "object" }]
        },
        "health": {
          "description": "Null, or what the running daemon wrote to .cache/f/health.json: the state of its store (`ok`, `stalled` when a store call did not return within its deadline, `unreachable`), the refused new code and the recurring failure kinds with their lifetime count and last time.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["wallMs", "store", "storeSinceMs", "code", "pending", "failures", "trust"],
              "properties": {
                "wallMs": { "$ref": "#/definitions/Count" },
                "store": { "enum": ["ok", "stalled", "unreachable"] },
                "storeSinceMs": { "$ref": "#/definitions/Count" },
                "code": { "$ref": "#/definitions/Sha256" },
                "pending": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "object", "additionalProperties": false, "required": ["code", "ok", "reason"], "properties": { "code": { "$ref": "#/definitions/Sha256" }, "ok": { "const": false }, "reason": { "type": "string", "maxLength": 512 } } }
                  ]
                },
                "failures": {
                  "type": "array",
                  "maxItems": 8,
                  "items": { "type": "object", "additionalProperties": false, "required": ["kind", "count", "lastMs"], "properties": { "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" }, "count": { "$ref": "#/definitions/Count" }, "lastMs": { "$ref": "#/definitions/Count" } } }
                },
                "trust": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["scope", "verifiedMs", "lostMs", "lostKind"],
                  "description": "Whether the manifest currently reflects the tree for the scope `shared-source` (see the trust schema): the start of the oldest sweep that found it equal to the tree, and when the last event happened that can make it wrong. The lifetime `failures` do not decide the tier of a reader.",
                  "properties": {
                    "scope": { "enum": ["shared-source"] },
                    "verifiedMs": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Count" }] },
                    "lostMs": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Count" }] },
                    "lostKind": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" }] }
                  }
                },
                "sidecars": {
                  "type": "array",
                  "maxItems": 8,
                  "description": "The children the daemon supervises beside itself (the build agent and, on the group server, the scheduler): state, process id, restarts and the last exit.",
                  "items": { "type": "object", "additionalProperties": false, "required": ["name", "state", "pid", "restarts", "sinceMs", "lastExit", "nextStartMs"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" }, "state": { "enum": ["off", "waiting", "running", "backoff", "stopped"] }, "pid": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Count" }] }, "restarts": { "$ref": "#/definitions/Count" }, "sinceMs": { "$ref": "#/definitions/Count" }, "lastExit": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 512 }] }, "nextStartMs": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Count" }] } } }
                }
              }
            }
          ]
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shared", "reason", "indexTree"],
          "description": "Whether stage and commit state is shared on this machine: `shared` once the base register is applied; otherwise the reason (no git executable, no root .git, base not yet received, or why stage sharing waits or is degraded: an object has not arrived, unmerged entries, a failing git step, a held index.lock, a stage that could not be kept).",
          "properties": {
            "shared": { "type": "boolean" },
            "reason": { "enum": ["shared", "no-git", "no-repository", "waiting-for-base", "objects-missing", "unmerged", "write-tree-failed", "git-failed", "index-busy", "index-lock-stale", "backup-failed"] },
            "indexTree": {
              "oneOf": [
                { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "Drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "enum": ["missing-local", "extra-local", "content", "target", "state"] },
        "expected": { "type": "string" },
        "actual": { "type": "string" }
      }
    },
    "VerifyReport": {
      "description": "The report of `verify`: ok means local tree, state and folded store agree on every shared path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ok", "checked", "total", "truncated", "drift", "refusedTotal", "refused"],
      "properties": {
        "version": { "const": 1 },
        "ok": { "type": "boolean" },
        "checked": { "$ref": "#/definitions/Count" },
        "total": { "$ref": "#/definitions/Count" },
        "truncated": { "type": "boolean" },
        "drift": { "type": "array", "items": { "$ref": "#/definitions/Drift" } },
        "refusedTotal": { "$ref": "#/definitions/Count" },
        "refused": {
          "type": "array",
          "description": "Paths the path policy refuses to share; they are not drift.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
