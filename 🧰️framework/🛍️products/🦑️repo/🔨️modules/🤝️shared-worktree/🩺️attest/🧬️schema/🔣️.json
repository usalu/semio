{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/framework/repo/shared-worktree/attest/v1",
 "title": "Shared worktree attestation: what one worker holds, the fleet verdict over all workers and the language-agnostic fixture",
 "definitions": {
  "Hlc": {"type": "string", "pattern": "^[0-9]{13}-[0-9]{6}-[a-z0-9][a-z0-9-]{0,39}$"},
  "OriginId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
  "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "ShortSha": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
  "Oid": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
  "Platform": {"type": "string", "pattern": "^[a-z0-9]{3,16}$"},
  "Count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
  "Position": {
   "type": "object",
   "additionalProperties": false,
   "required": ["bytes", "segment"],
   "properties": {"segment": {"$ref": "#/definitions/Count"}, "bytes": {"$ref": "#/definitions/Count"}}
  },
  "Buckets": {"type": "string", "pattern": "^[0-9a-f]{1024}$"},
  "Mask": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "Cut": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Position"}},
  "ManifestCheckpoint": {
   "type": "object",
   "additionalProperties": false,
   "required": ["buckets", "cursors", "files", "manifest", "wallMs"],
   "properties": {
    "cursors": {"$ref": "#/definitions/Cut"},
    "wallMs": {"$ref": "#/definitions/Count"},
    "files": {"$ref": "#/definitions/Count"},
    "manifest": {"$ref": "#/definitions/Sha256"},
    "buckets": {"$ref": "#/definitions/Buckets"}
   }
  },
  "GitCheckpoint": {
   "type": "object",
   "additionalProperties": false,
   "required": ["cursors", "head", "indexTree", "wallMs"],
   "properties": {
    "cursors": {"$ref": "#/definitions/Cut"},
    "until": {"$ref": "#/definitions/Cut"},
    "wallMs": {"$ref": "#/definitions/Count"},
    "head": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Oid"}]},
    "indexTree": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Oid"}]}
   }
  },
  "ViewCheckpoint": {
   "type": "object",
   "additionalProperties": false,
   "required": ["buckets", "cursors", "digest", "pending", "wallMs"],
   "properties": {
    "cursors": {"$ref": "#/definitions/Cut"},
    "until": {"$ref": "#/definitions/Cut"},
    "wallMs": {"$ref": "#/definitions/Count"},
    "digest": {"$ref": "#/definitions/Sha256"},
    "buckets": {"$ref": "#/definitions/Buckets"},
    "pending": {"$ref": "#/definitions/Mask"}
   }
  },
  "Checkpoints": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "manifest": {"$ref": "#/definitions/ManifestCheckpoint"},
    "git": {"$ref": "#/definitions/GitCheckpoint"},
    "view": {"$ref": "#/definitions/ViewCheckpoint"}
   }
  },
  "View": {
   "type": "object",
   "additionalProperties": false,
   "required": ["deleted", "digest", "modified", "staged", "untracked"],
   "properties": {
    "staged": {"$ref": "#/definitions/Count"},
    "modified": {"$ref": "#/definitions/Count"},
    "deleted": {"$ref": "#/definitions/Count"},
    "untracked": {"$ref": "#/definitions/Count"},
    "digest": {"$ref": "#/definitions/Sha256"},
    "stale": {"type": "boolean"}
   }
  },
  "Percentile": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Count"}]},
  "Quantiles": {
   "type": "object",
   "additionalProperties": false,
   "required": ["p50", "p95"],
   "properties": {"p50": {"$ref": "#/definitions/Percentile"}, "p95": {"$ref": "#/definitions/Percentile"}}
  },
  "TierName": {"enum": ["file", "hot", "sweep", "view", "walk"]},
  "TierReport": {
   "type": "object",
   "additionalProperties": false,
   "required": ["dutyPercent", "lastMs", "passes"],
   "properties": {
    "passes": {"$ref": "#/definitions/Count"},
    "lastMs": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Count"}]},
    "dutyPercent": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 100}]}
   }
  },
  "Latency": {
   "type": "object",
   "additionalProperties": false,
   "required": ["applyMs", "publishMs", "samples", "tiers"],
   "properties": {
    "tiers": {"type": "object", "additionalProperties": false, "required": ["file", "hot", "sweep", "view", "walk"], "properties": {"hot": {"$ref": "#/definitions/TierReport"}, "sweep": {"$ref": "#/definitions/TierReport"}, "file": {"$ref": "#/definitions/TierReport"}, "walk": {"$ref": "#/definitions/TierReport"}, "view": {"$ref": "#/definitions/TierReport"}}},
    "publishMs": {"$ref": "#/definitions/Quantiles"},
    "applyMs": {"$ref": "#/definitions/Quantiles"},
    "samples": {"type": "object", "additionalProperties": false, "required": ["apply", "publish"], "properties": {"publish": {"$ref": "#/definitions/Count"}, "apply": {"$ref": "#/definitions/Count"}}}
   }
  },
  "Volume": {
   "type": "object",
   "additionalProperties": false,
   "required": ["caseInsensitive", "longPaths", "normalisationInsensitive", "symlinks"],
   "properties": {
    "caseInsensitive": {"type": "boolean"},
    "normalisationInsensitive": {"type": "boolean"},
    "symlinks": {"type": "boolean"},
    "longPaths": {"anyOf": [{"type": "null"}, {"type": "boolean"}]}
   }
  },
  "Guards": {
   "type": "object",
   "additionalProperties": false,
   "required": ["caseIgnore", "caseMismatch", "infoExclude", "links", "modeMismatch", "overBudget", "pins", "trackedIgnored", "trackedRefused", "version", "volume"],
   "properties": {
    "version": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$"}]},
    "pins": {"$ref": "#/definitions/ShortSha"},
    "volume": {"$ref": "#/definitions/Volume"},
    "infoExclude": {"$ref": "#/definitions/Count"},
    "caseIgnore": {"$ref": "#/definitions/Count"},
    "caseMismatch": {"$ref": "#/definitions/Count"},
    "trackedIgnored": {"$ref": "#/definitions/Count"},
    "trackedRefused": {"$ref": "#/definitions/Count"},
    "links": {"$ref": "#/definitions/Count"},
    "overBudget": {"$ref": "#/definitions/Count"},
    "modeMismatch": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Count"}]}
   }
  },
  "GitHead": {
   "type": "object",
   "additionalProperties": false,
   "required": ["commit", "ref"],
   "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 1024}, "commit": {"$ref": "#/definitions/Oid"}}
  },
  "Attestation": {
   "type": "object",
   "additionalProperties": false,
   "required": ["code", "cursors", "files", "groupId", "guards", "head", "hlc", "indexTree", "latency", "manifest", "originId", "platform", "queue", "sync", "version", "view", "wallMs"],
   "properties": {
    "version": {"const": 1},
    "originId": {"$ref": "#/definitions/OriginId"},
    "groupId": {"$ref": "#/definitions/OriginId"},
    "platform": {"$ref": "#/definitions/Platform"},
    "wallMs": {"$ref": "#/definitions/Count"},
    "hlc": {"$ref": "#/definitions/Hlc"},
    "sync": {"type": "boolean"},
    "code": {"$ref": "#/definitions/Sha256"},
    "cursors": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Position"}},
    "files": {"$ref": "#/definitions/Count"},
    "manifest": {"$ref": "#/definitions/Sha256"},
    "head": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/GitHead"}]},
    "indexTree": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Oid"}]},
    "view": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/View"}]},
    "guards": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Guards"}]},
    "latency": {"$ref": "#/definitions/Latency"},
    "queue": {
     "type": "object",
     "additionalProperties": false,
     "required": ["incoming"],
     "properties": {"incoming": {"$ref": "#/definitions/Count"}}
    },
    "checkpoints": {"$ref": "#/definitions/Checkpoints"},
    "pending": {
     "type": "object",
     "additionalProperties": false,
     "required": ["code", "ok", "reason"],
     "properties": {"code": {"$ref": "#/definitions/Sha256"}, "ok": {"const": false}, "reason": {"type": "string", "maxLength": 512}}
    },
    "failures": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "kind", "lastMs"],
      "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"}, "count": {"$ref": "#/definitions/Count"}, "lastMs": {"$ref": "#/definitions/Count"}}
     }
    },
    "fallback": {
     "type": "object",
     "additionalProperties": false,
     "required": ["guard", "reason", "source"],
     "properties": {"guard": {"const": "code-fallback"}, "source": {"enum": ["snapshot", "store"]}, "reason": {"type": "string", "maxLength": 512}}
    }
   }
  },
  "Retirement": {
   "type": "object",
   "additionalProperties": false,
   "required": ["by", "hlc", "originId", "reason", "retired", "version", "wallMs"],
   "properties": {
    "version": {"const": 1},
    "originId": {"$ref": "#/definitions/OriginId"},
    "by": {"$ref": "#/definitions/OriginId"},
    "hlc": {"$ref": "#/definitions/Hlc"},
    "wallMs": {"$ref": "#/definitions/Count"},
    "reason": {"type": "string", "maxLength": 500},
    "retired": {"type": "boolean"}
   }
  },
  "Field": {"enum": ["code", "manifest", "head.commit", "indexTree", "view.digest", "guards.pins", "guards.infoExclude", "guards.caseIgnore", "guards.caseMismatch", "guards.trackedIgnored", "guards.trackedRefused", "guards.modeMismatch"]},
  "Warning": {
   "type": "object",
   "additionalProperties": false,
   "required": ["detail", "kind", "originId"],
   "properties": {
    "originId": {"$ref": "#/definitions/OriginId"},
    "kind": {"enum": ["git-version", "volume", "over-budget", "symlinks", "code-fallback", "guards-unknown", "blobs", "no-checkpoints", "git-broken", "stage", "never-attested"]},
    "detail": {"type": "string", "minLength": 1}
   }
  },

  "Verdict": {"enum": ["ok", "off", "retired", "missing", "stale", "lagging", "diverged"]},
  "Row": {
   "type": "object",
   "additionalProperties": false,
   "required": ["ageSeconds", "behindOrigins", "code", "differs", "fresh", "incoming", "latency", "originId", "platform", "settled", "sync", "verdict", "view"],
   "properties": {
    "originId": {"$ref": "#/definitions/OriginId"},
    "platform": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Platform"}]},
    "sync": {"anyOf": [{"type": "null"}, {"type": "boolean"}]},
    "ageSeconds": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Count"}]},
    "behindOrigins": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Count"}]},
    "incoming": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Count"}]},
    "code": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/ShortSha"}]},
    "fresh": {"type": "boolean"},
    "settled": {"type": "boolean"},
    "view": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/View"}]},
    "latency": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Latency"}]},
    "verdict": {"$ref": "#/definitions/Verdict"},
    "differs": {"type": "array", "items": {"$ref": "#/definitions/Field"}},
    "basis": {"const": "checkpoint"},
    "checkpointSeconds": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/Count"}]}
   }
  },
  "Difference": {
   "type": "object",
   "additionalProperties": false,
   "required": ["expected", "field", "originId", "value"],
   "properties": {
    "originId": {"$ref": "#/definitions/OriginId"},
    "field": {"$ref": "#/definitions/Field"},
    "value": {"anyOf": [{"type": "null"}, {"type": "string"}]},
    "expected": {"anyOf": [{"type": "null"}, {"type": "string"}]}
   }
  },
  "Report": {
   "type": "object",
   "additionalProperties": false,
   "required": ["differing", "freshSeconds", "ok", "rows", "version", "warnings"],
   "properties": {
    "version": {"const": 1},
    "ok": {"type": "boolean"},
    "freshSeconds": {"$ref": "#/definitions/Count"},
    "rows": {"type": "array", "items": {"$ref": "#/definitions/Row"}},
    "differing": {"type": "array", "items": {"$ref": "#/definitions/Difference"}},
    "warnings": {"type": "array", "items": {"$ref": "#/definitions/Warning"}}
   }
  },
  "Head": {
   "type": "object",
   "additionalProperties": false,
   "required": ["bytes", "segment"],
   "properties": {"segment": {"$ref": "#/definitions/Count"}, "bytes": {"$ref": "#/definitions/Count"}}
  },
  "GapEvent": {
   "type": "object",
   "additionalProperties": false,
   "required": ["end", "ms", "path"],
   "properties": {"end": {"$ref": "#/definitions/Position"}, "path": {"type": "string", "minLength": 1}, "ms": {"$ref": "#/definitions/Count"}}
  },
  "GapWindow": {
   "type": "object",
   "additionalProperties": false,
   "required": ["events", "from", "to"],
   "properties": {
    "from": {"$ref": "#/definitions/Position"},
    "to": {"$ref": "#/definitions/Position"},
    "events": {"type": "array", "items": {"$ref": "#/definitions/GapEvent"}}
   }
  },
  "AgreementCase": {
   "type": "object",
   "additionalProperties": false,
   "required": ["attestations", "expected", "heads", "name", "now", "retirements", "windows"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "now": {"$ref": "#/definitions/Count"},
    "heads": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Head"}},
    "attestations": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Attestation"}},
    "retirements": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Retirement"}},
    "windows": {"type": "object", "additionalProperties": {"$ref": "#/definitions/GapWindow"}},
    "expected": {"$ref": "#/definitions/Report"}
   }
  },
  "BucketPath": {
   "type": "object",
   "additionalProperties": false,
   "required": ["bucket", "path"],
   "properties": {"path": {"type": "string", "minLength": 1}, "bucket": {"type": "integer", "minimum": 0, "maximum": 255}}
  },
  "GitPath": {
   "type": "object",
   "additionalProperties": false,
   "required": ["git", "path"],
   "properties": {"path": {"type": "string", "minLength": 1}, "git": {"type": "boolean"}}
  },
  "BucketManifest": {
   "type": "object",
   "additionalProperties": false,
   "required": ["buckets", "entries", "name"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "items": {"$ref": "#/definitions/Term"}},
    "buckets": {"$ref": "#/definitions/Buckets"}
   }
  },
  "BucketView": {
   "type": "object",
   "additionalProperties": false,
   "required": ["buckets", "lines", "mask", "name", "pending"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "lines": {"type": "array", "items": {"type": "string"}},
    "buckets": {"$ref": "#/definitions/Buckets"},
    "pending": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "mask": {"$ref": "#/definitions/Mask"}
   }
  },
  "Bucketing": {
   "type": "object",
   "additionalProperties": false,
   "required": ["gitPaths", "manifests", "paths", "views"],
   "properties": {
    "paths": {"type": "array", "items": {"$ref": "#/definitions/BucketPath"}},
    "gitPaths": {"type": "array", "items": {"$ref": "#/definitions/GitPath"}},
    "manifests": {"type": "array", "items": {"$ref": "#/definitions/BucketManifest"}},
    "views": {"type": "array", "items": {"$ref": "#/definitions/BucketView"}}
   }
  },
  "VerdictCase": {
   "type": "object",
   "additionalProperties": false,
   "required": ["attestations", "expected", "heads", "name", "now", "retirements"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "now": {"$ref": "#/definitions/Count"},
    "heads": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Head"}},
    "attestations": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Attestation"}},
    "retirements": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Retirement"}},
    "registered": {"description": "Origins that have a registration (fleet-auth.json) in the store; one of them with neither a head nor an attestation nor a retirement has never attested and is named by a `never-attested` warning, which does not change the verdict.", "type": "array", "items": {"$ref": "#/definitions/OriginId"}},
    "expected": {"$ref": "#/definitions/Report"}
   }
  },
  "Term": {
   "type": "object",
   "additionalProperties": false,
   "required": ["operation", "path", "value"],
   "properties": {
    "path": {"type": "string", "minLength": 1},
    "operation": {"enum": ["put", "link", "delete"]},
    "value": {"type": "string"}
   }
  },
  "DigestCase": {
   "type": "object",
   "additionalProperties": false,
   "required": ["entries", "manifest", "name"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "items": {"$ref": "#/definitions/Term"}},
    "manifest": {"$ref": "#/definitions/Sha256"}
   }
  },
  "ViewCase": {
   "type": "object",
   "additionalProperties": false,
   "required": ["deleted", "digest", "lines", "modified", "name", "porcelain", "staged", "untracked"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "porcelain": {"type": "string"},
    "staged": {"$ref": "#/definitions/Count"},
    "modified": {"$ref": "#/definitions/Count"},
    "deleted": {"$ref": "#/definitions/Count"},
    "untracked": {"$ref": "#/definitions/Count"},
    "lines": {"type": "array", "items": {"type": "string"}},
    "digest": {"$ref": "#/definitions/Sha256"}
   }
  },
  "SourceFile": {
   "type": "object",
   "additionalProperties": false,
   "required": ["path", "text"],
   "properties": {"path": {"type": "string", "minLength": 1}, "text": {"type": "string"}}
  },
  "CodeCase": {
   "type": "object",
   "additionalProperties": false,
   "required": ["code", "files", "name"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "files": {"type": "array", "items": {"$ref": "#/definitions/SourceFile"}},
    "code": {"$ref": "#/definitions/Sha256"}
   }
  },
  "Fixture": {
   "type": "object",
   "additionalProperties": false,
   "required": ["agreements", "bucketing", "code", "digests", "verdicts", "version", "views"],
   "properties": {
    "version": {"const": 1},
    "bucketing": {"$ref": "#/definitions/Bucketing"},
    "agreements": {"type": "array", "items": {"$ref": "#/definitions/AgreementCase"}},
    "digests": {"type": "array", "items": {"$ref": "#/definitions/DigestCase"}},
    "code": {"type": "array", "items": {"$ref": "#/definitions/CodeCase"}},
    "views": {"type": "array", "items": {"$ref": "#/definitions/ViewCase"}},
    "verdicts": {"type": "array", "items": {"$ref": "#/definitions/VerdictCase"}}
  }
  }
 }
}
