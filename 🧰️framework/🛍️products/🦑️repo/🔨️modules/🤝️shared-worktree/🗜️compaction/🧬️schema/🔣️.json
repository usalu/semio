{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/framework/repo/shared-worktree/compaction/v1",
 "title": "Shared worktree compaction: the settings, the record of the last run and the size report of the store",
 "definitions": {
  "Count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
  "Hlc": {"type": "string", "pattern": "^[0-9]{13}-[0-9]{6}-[a-z0-9][a-z0-9-]{0,39}$"},
  "OriginId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
  "Settings": {
   "description": "The topology setting `replica.compaction`. Off by default: `automatic` switches on the periodic snapshot, the retirement of journal segments and the reclaim of blobs on the group server, and the jump of a far-behind replica to the newest snapshot. `snapshotEvents` is the number of journal events since the newest snapshot that makes the group server write a new one, `safetyHours` the age a segment or blob needs before it may be removed, `staleHours` the silence after which an origin no longer holds back the retirement of segments (it resumes from the snapshot when it returns), `catchUpEvents` the number of events a replica must be behind, and a snapshot save, before it jumps.",
   "type": "object",
   "additionalProperties": false,
   "required": ["automatic", "snapshotEvents", "safetyHours", "staleHours", "catchUpEvents"],
   "properties": {
    "automatic": {"type": "boolean"},
    "snapshotEvents": {"type": "integer", "minimum": 1000, "maximum": 100000000},
    "safetyHours": {"type": "integer", "minimum": 1, "maximum": 8760},
    "staleHours": {"type": "integer", "minimum": 1, "maximum": 8760},
    "catchUpEvents": {"type": "integer", "minimum": 1000, "maximum": 100000000}
   }
  },
  "Record": {
   "description": "`compaction.json` in the store: what the last applied compaction did and what it left because it was too young.",
   "type": "object",
   "additionalProperties": false,
   "required": ["version", "wallMs", "originId", "snapshot", "segments", "blobs", "snapshots"],
   "properties": {
    "version": {"const": 1},
    "wallMs": {"$ref": "#/definitions/Count"},
    "originId": {"$ref": "#/definitions/OriginId"},
    "snapshot": {
     "type": "object",
     "additionalProperties": false,
     "required": ["hlc", "origin", "entries"],
     "properties": {"hlc": {"$ref": "#/definitions/Hlc"}, "origin": {"$ref": "#/definitions/OriginId"}, "entries": {"$ref": "#/definitions/Count"}}
    },
    "segments": {
     "type": "object",
     "additionalProperties": false,
     "required": ["removed", "bytes"],
     "properties": {"removed": {"$ref": "#/definitions/Count"}, "bytes": {"$ref": "#/definitions/Count"}}
    },
    "blobs": {
     "type": "object",
     "additionalProperties": false,
     "required": ["removed", "bytes", "pending", "pendingBytes"],
     "properties": {"removed": {"$ref": "#/definitions/Count"}, "bytes": {"$ref": "#/definitions/Count"}, "pending": {"$ref": "#/definitions/Count"}, "pendingBytes": {"$ref": "#/definitions/Count"}}
    },
    "snapshots": {"$ref": "#/definitions/Count"}
   }
  },
  "Store": {
   "description": "What `status` shows of the size of the store: the journal, the newest snapshot and what a compaction would reclaim now (segments by the current rule; blobs as measured by the last applied compaction).",
   "type": "object",
   "additionalProperties": false,
   "required": ["journal", "snapshot", "reclaimable", "last"],
   "properties": {
    "journal": {
     "type": "object",
     "additionalProperties": false,
     "required": ["origins", "segments", "bytes"],
     "properties": {"origins": {"$ref": "#/definitions/Count"}, "segments": {"$ref": "#/definitions/Count"}, "bytes": {"$ref": "#/definitions/Count"}}
    },
    "snapshot": {
     "oneOf": [
      {"type": "null"},
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["origin", "hlc", "ageSeconds", "bytes"],
       "properties": {"origin": {"$ref": "#/definitions/OriginId"}, "hlc": {"$ref": "#/definitions/Hlc"}, "ageSeconds": {"$ref": "#/definitions/Count"}, "bytes": {"$ref": "#/definitions/Count"}}
      }
     ]
    },
    "reclaimable": {
     "type": "object",
     "additionalProperties": false,
     "required": ["segments", "bytes", "blobs"],
     "properties": {
      "segments": {"$ref": "#/definitions/Count"},
      "bytes": {"$ref": "#/definitions/Count"},
      "blobs": {
       "description": "Null unless `status --deep` measured the blobs that no entry of the snapshot and no later event names and that are old enough.",
       "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["count", "bytes", "pending", "pendingBytes"], "properties": {"count": {"$ref": "#/definitions/Count"}, "bytes": {"$ref": "#/definitions/Count"}, "pending": {"$ref": "#/definitions/Count"}, "pendingBytes": {"$ref": "#/definitions/Count"}}}
       ]
      }
     }
    },
    "last": {
     "oneOf": [
      {"type": "null"},
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["wallMs", "blobs", "blobBytes", "pending", "pendingBytes"],
       "properties": {"wallMs": {"$ref": "#/definitions/Count"}, "blobs": {"$ref": "#/definitions/Count"}, "blobBytes": {"$ref": "#/definitions/Count"}, "pending": {"$ref": "#/definitions/Count"}, "pendingBytes": {"$ref": "#/definitions/Count"}}
      }
     ]
    }
   }
  }
 }
}
