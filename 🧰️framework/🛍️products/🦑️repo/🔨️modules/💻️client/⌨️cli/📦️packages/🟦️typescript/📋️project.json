{
  "name": "@semio-tech/repo-client",
  "$schema": "../../../../../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts dev",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "build",
        "generate-entity-kinds"
      ],
      "cache": false,
      "continuous": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/../../../client",
        "{projectRoot}/../../../client.exe"
      ],
      "dependsOn": [
        "generate-entity-kinds"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "generate-entity-kinds"
      ]
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "generate-entity-kinds"
      ]
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "generate-entity-kinds"
      ]
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "generate-entity-kinds"
      ]
    },
    "generate-entity-kinds": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts generate-entity-kinds"
      },
      "cache": true,
      "outputs": [
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/🏷️entity-kinds/🐹️.go"
      ]
    },
    "preview-generated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts preview-generated"
      },
      "cache": false,
      "outputs": []
    },
    "check-entity-kinds": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts check-entity-kinds"
      },
      "cache": false,
      "outputs": []
    },
    "test-entity-kinds": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test-entity-kinds"
      },
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "generate-entity-kinds"
      ]
    }
  },
  "implicitDependencies": [
    "@semio-tech/framework-schema"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/⌨️cli/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/🏷️entity-kinds/📥️source/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/🏷️entity-kinds/🔣️.json",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/📦️artifacts/🗂️files/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/🧭️routing/🟦️.ts"
    ]
  }
}
