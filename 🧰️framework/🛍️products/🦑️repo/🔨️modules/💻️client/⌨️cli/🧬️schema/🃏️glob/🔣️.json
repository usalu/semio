{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "$schema",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pattern",
          "path",
          "match"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "match": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
