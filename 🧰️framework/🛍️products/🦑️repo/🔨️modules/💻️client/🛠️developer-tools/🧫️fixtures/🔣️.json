  "gitCases": [
    {
      "request": {
        "command": "git-status"
      },
      "tail": [
        "status",
        "--short",
        "--branch",
        "--untracked-files=normal",
        "--",
        ":(literal)."
      ]
    },
    {
      "request": {
        "command": "git-status",
        "path": "space 🧪 file.ts",
        "untracked": "no"
      },
      "tail": [
        "status",
        "--short",
        "--branch",
        "--untracked-files=no",
        "--",
        ":(literal)space 🧪 file.ts"
      ]
    },
    {
      "request": {
        "command": "git-diff",
        "path": "app/file.ts",
        "revision": "HEAD~2",
        "area": "staged"
      },
      "tail": [
        "diff",
        "--no-ext-diff",
        "--no-textconv",
        "--color=never",
        "--cached",
        "HEAD~2",
        "--",
        ":(literal)app/file.ts"
      ]
    },
    {
      "request": {
        "command": "git-history",
        "revision": "main..feature/path",
        "count": 8
      },
      "tail": [
        "log",
        "--no-ext-diff",
        "--no-textconv",
        "--date=iso-strict",
        "--format=%h %ad %an %s",
        "--max-count=8",
        "main..feature/path",
        "--",
        ":(literal)."
      ]
    },
    {
      "request": {
        "command": "git-diff",
        "revision": "HEAD~2..HEAD"
      },
      "tail": [
        "diff",
        "--no-ext-diff",
        "--no-textconv",
        "--color=never",
        "HEAD~2..HEAD",
        "--",
        ":(literal)."
      ]
    },
    {
      "request": {
        "command": "git-show",
        "revision": "HEAD~1",
        "path": "app/space 🧪 file.ts",
        "view": "patch"
      },
      "tail": [
        "show",
        "--no-ext-diff",
        "--no-textconv",
        "--format=fuller",
        "--stat",
        "--patch",
        "--color=never",
        "HEAD~1",
        "--",
        ":(literal)app/space 🧪 file.ts"
      ]
    },
    {
      "request": {
        "command": "git-show"
      },
      "tail": [
        "show",
        "--no-ext-diff",
        "--no-textconv",
        "--format=fuller",
        "--stat",
        "--color=never",
        "HEAD",
        "--",
        ":(literal)."
      ]
    },
    {
      "request": {
        "command": "git-blame",
        "file": "app/space 🧪 file.ts",
        "revision": "HEAD~1",
        "line": 8,
        "count": 3
      },
      "tail": [
        "blame",
        "--no-textconv",
        "--date=short",
        "-L",
        "8,+3",
        "HEAD~1",
        "--",
        "app/space 🧪 file.ts"
      ]
    },
    {
      "request": {
        "command": "git-blame",
        "file": "deleted/file.ts"
