{
  "name": "@semio-tech/repo-vscode",
  "$schema": "../../../../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/🧪️tests/🎚️config/🟨️.mjs",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/🧹️lint/📐️source-policy/🟨️.mjs"
    ]
  },
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts dev",
        "forwardAllArgs": true
      },
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        }
      ],
      "cache": false,
      "continuous": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}/extension"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts lint",
        "forwardAllArgs": true
      }
    },
    "build-vsix": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build-vsix",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}/vsix/🧩️repo.vsix"
      ]
    },
    "compile-extension": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}/extension-debug"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        }
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts compile-extension",
        "forwardAllArgs": true,
        "args": [
          "./dist/prototype/extension-debug"
        ]
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          },
          "args": [
            "./dist/prototype/extension-debug"
          ]
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          },
          "args": [
            "./dist/release/extension-debug"
          ]
        }
      }
    },
    "watch-extension": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "outputs": [
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}/extension-debug-watch"
      ],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        }
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts watch-extension",
        "args": [
          "./🟦️.ts",
          "./dist/prototype/extension-debug-watch"
        ],
        "forwardAllArgs": true
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "args": [
            "./🟦️.ts",
            "./dist/prototype/extension-debug-watch"
          ],
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "args": [
            "./🟦️.ts",
            "./dist/release/extension-debug-watch"
          ],
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  },
  "implicitDependencies": [
    "@semio-tech/framework-schema"
  ]
}
