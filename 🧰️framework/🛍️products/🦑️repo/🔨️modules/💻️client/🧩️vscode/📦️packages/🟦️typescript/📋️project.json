{
  "name": "@semio-tech/repo-vscode",
  "$schema": "../../../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/🧪️tests/🎚️config/🟨️.mjs",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/🧹️lint/📐️source-policy/🟨️.mjs"
    ]
  },
  "targets": {
    "dev": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts dev",
        "forwardAllArgs": true
      },
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        },
        "generate-graphql-types"
      ],
      "cache": false,
      "continuous": true
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "generate-graphql-types"
      ]
    },
    "build": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/📤️dist/{options.env.SEMIO_BUILD_MODE}"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        },
        "generate-graphql-types"
      ]
    },
    "lint": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts lint",
        "forwardAllArgs": true
      }
    },
    "build-vsix": {
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build-vsix",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/📤️dist/{options.env.SEMIO_BUILD_MODE}/🧩️repo.vsix"
      ]
    },
    "compile-extension": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [
        "{projectRoot}/📤️dist/{options.env.SEMIO_BUILD_MODE}"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        },
        "generate-graphql-types"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts compile-extension",
        "forwardAllArgs": true
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "watch-extension": {
      "executor": "repo:script",
      "continuous": true,
      "cache": false,
      "outputs": [
        "{projectRoot}/📤️dist/{options.env.SEMIO_BUILD_MODE}"
      ],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        },
        "generate-graphql-types"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts watch-extension",
        "forwardAllArgs": true
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "generate-graphql-types": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts generate-graphql-types"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/🔗️graphql/🧪️tests/🧫️fixtures/📜️served-schema/🔗️.graphql",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/📦️artifacts/🗂️files/🟦️.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/📦️packages/🟦️typescript/🧭️routing/🟦️.ts"
      ],
      "outputs": [
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/🤖️generated/🔗️graphql-types/🟦️.ts"
      ]
    },
    "preview-generated": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts preview-generated"
      },
      "cache": false,
      "outputs": []
    },
    "check-graphql-types": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts check-graphql-types"
      },
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "generate-graphql-types"
      ]
    },
    "test-graphql-types": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test-graphql-types"
      },
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "generate-graphql-types"
      ]
    },
    "test-custody": {
      "executor": "repo:script",
      "cache": false,
      "dependsOn": [],
      "inputs": [
        "default"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🧩️vscode/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test-custody"
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  },
  "implicitDependencies": [
    "@semio-tech/framework-schema"
  ]
}
