{
  "$schema": "https://json.schemastore.org/package.json",
  "projectType": "application",
  "name": "repo-vscode",
  "displayName": "repo",
  "description": "Read-only monorepo source navigation and language editing for VS Code",
  "version": "0.0.1",
  "exports": {
    ".": "./dist/extension.js",
    "./package.json": "./package.json",
    "./builder": "./🏗️builder/🟦️.ts",
    "./testing/package": "./🧪️testing/📦️package/🟦️.ts",
    "./testing/host-build": "./🧪️testing/🧩️host-build/🟦️.ts"
  },
  "publisher": "usalu",
  "engines": {
    "vscode": "^1.104.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "repo/client/vscode"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:compose.monorepo",
    "onView:compose.filter",
    "onView:compose.sections"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repo",
          "title": "repo",
          "icon": "./🔣️compose_codeicon.svg"
        }
      ]
    },
    "views": {
      "repo": [
        {
          "id": "compose.monorepo",
          "name": "Monorepo"
        },
        {
          "id": "compose.filter",
          "name": "Filter"
        }
      ],
      "explorer": [
        {
          "id": "compose.sections",
          "name": "Sections"
        }
      ]
    },
    "commands": [
      {
        "command": "compose.ticketOpen",
        "title": "repo: Create Ticket"
      },
      {
        "command": "compose.open",
        "title": "repo: Open Entity"
