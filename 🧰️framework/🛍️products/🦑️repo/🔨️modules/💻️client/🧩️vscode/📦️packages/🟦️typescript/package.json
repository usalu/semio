    "keybindings": [],
    "menus": {
      "view/title": [
        {
          "command": "compose.refreshMonorepo",
          "when": "view == compose.monorepo",
          "group": "navigation@1"
        },
        {
          "command": "compose.refreshCodebase",
          "when": "view == compose.filter",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "compose.refreshItem",
          "when": "view == compose.monorepo && viewItem =~ /^(root_codebase|root_goals|root_tickets|root_policies|root_contributors|root_commits|technology|bundle|folder|file|section)$/",
          "group": "inline@98"
        },
        {
          "command": "compose.copyId",
          "when": "view == compose.monorepo && viewItem =~ /^(technology|bundle|folder|file|section|definition|goal|ticket|policy|breach|contributor|commit|ticket_year|ticket_month|ticket_day|contributor_email|contributor_link)$/",
          "group": "inline@99"
        },
        {
          "command": "compose.filter.toggle.technology.user",
          "toggled": "compose.filter.technology.user",
          "when": "view == compose.filter && viewItem == filter_technology",
          "group": "inline@1"
        },
        {
          "command": "compose.filter.toggle.technology.infrastructure",
          "toggled": "compose.filter.technology.infrastructure",
          "when": "view == compose.filter && viewItem == filter_technology",
          "group": "inline@2"
        },
        {
          "command": "compose.filter.toggle.technology.research",
          "toggled": "compose.filter.technology.research",
          "when": "view == compose.filter && viewItem == filter_technology",
          "group": "inline@3"
        },
        {
          "command": "compose.filter.toggle.bundle.library",
          "toggled": "compose.filter.bundle.library",
          "when": "view == compose.filter && viewItem == filter_bundle",
          "group": "inline@1"
        },
        {
          "command": "compose.filter.toggle.bundle.binary",
          "toggled": "compose.filter.bundle.binary",
          "when": "view == compose.filter && viewItem == filter_bundle",
          "group": "inline@2"
        },
        {
          "command": "compose.filter.toggle.bundle.ui",
          "toggled": "compose.filter.bundle.ui",
          "when": "view == compose.filter && viewItem == filter_bundle",
          "group": "inline@3"
        },
        {
          "command": "compose.filter.toggle.bundle.site",
          "toggled": "compose.filter.bundle.site",
          "when": "view == compose.filter && viewItem == filter_bundle",
          "group": "inline@4"
        },
        {
          "command": "compose.filter.toggle.bundle.assets",
          "toggled": "compose.filter.bundle.assets",
          "when": "view == compose.filter && viewItem == filter_bundle",
          "group": "inline@5"
        },
        {
          "command": "compose.filter.toggle.bundle.schema",
          "toggled": "compose.filter.bundle.schema",
          "when": "view == compose.filter && viewItem == filter_bundle",
          "group": "inline@6"
        },
        {
          "command": "compose.filter.toggle.bundle.default",
          "toggled": "compose.filter.bundle.default",
          "when": "view == compose.filter && viewItem == filter_bundle",
          "group": "inline@7"
        },
        {
          "command": "compose.filter.toggle.folder.organization",
          "toggled": "compose.filter.folder.organization",
          "when": "view == compose.filter && viewItem == filter_folder",
          "group": "inline@1"
        },
        {
          "command": "compose.filter.toggle.folder.required",
          "toggled": "compose.filter.folder.required",
          "when": "view == compose.filter && viewItem == filter_folder",
          "group": "inline@2"
        },
        {
          "command": "compose.filter.toggle.file.code",
          "toggled": "compose.filter.file.code",
          "when": "view == compose.filter && viewItem == filter_file",
          "group": "inline@1"
        },
        {
          "command": "compose.filter.toggle.file.script",
          "toggled": "compose.filter.file.script",
          "when": "view == compose.filter && viewItem == filter_file",
          "group": "inline@2"
        },
        {
          "command": "compose.filter.toggle.file.config",
          "toggled": "compose.filter.file.config",
          "when": "view == compose.filter && viewItem == filter_file",
          "group": "inline@3"
        },
        {
          "command": "compose.filter.toggle.file.lab",
          "toggled": "compose.filter.file.lab",
          "when": "view == compose.filter && viewItem == filter_file",
          "group": "inline@4"
        },
        {
          "command": "compose.filter.toggle.file.docs",
          "toggled": "compose.filter.file.docs",
          "when": "view == compose.filter && viewItem == filter_file",
          "group": "inline@5"
        },
        {
          "command": "compose.filter.toggle.file.resource",
          "toggled": "compose.filter.file.resource",
          "when": "view == compose.filter && viewItem == filter_file",
          "group": "inline@6"
        },
        {
          "command": "compose.filter.toggle.file.license",
          "toggled": "compose.filter.file.license",
          "when": "view == compose.filter && viewItem == filter_file",
          "group": "inline@7"
        },
        {
          "command": "compose.filter.toggle.definition.implementation",
          "toggled": "compose.filter.definition.implementation",
          "when": "view == compose.filter && viewItem == filter_definition",
          "group": "inline@1"
        },
        {
          "command": "compose.filter.toggle.definition.interface",
          "toggled": "compose.filter.definition.interface",
          "when": "view == compose.filter && viewItem == filter_definition",
          "group": "inline@2"
        },
        {
          "command": "compose.filter.toggle.definition.constant",
          "toggled": "compose.filter.definition.constant",
          "when": "view == compose.filter && viewItem == filter_definition",
          "group": "inline@3"
        },
        {
          "command": "compose.filter.toggle.goal.open",
          "toggled": "compose.filter.goal.open",
          "when": "view == compose.filter && viewItem == filter_goal",
          "group": "inline@1"
        },
        {
          "command": "compose.filter.toggle.goal.closed",
          "toggled": "compose.filter.goal.closed",
          "when": "view == compose.filter && viewItem == filter_goal",
          "group": "inline@2"
        },
        {
          "command": "compose.filter.toggle.ticket.open",
          "toggled": "compose.filter.ticket.open",
          "when": "view == compose.filter && viewItem == filter_ticket",
          "group": "inline@1"
        },
        {
          "command": "compose.filter.toggle.ticket.closed",
          "toggled": "compose.filter.ticket.closed",
          "when": "view == compose.filter && viewItem == filter_ticket",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "repo",
      "properties": {
        "compose.repo.showIgnored": {
          "type": "boolean",
          "default": false,
          "description": "Show ignored folders and files in the codebase view"
        },
        "compose.repo.showGenerated": {
          "type": "boolean",
          "default": false,
          "description": "Show generated folders and files in the codebase view"
        },
        "compose.repo.excludeKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "code",
              "script",
              "config",
              "test",
              "docs",
              "resource",
              "license"
            ]
          },
          "default": [],
          "description": "Exclude specific kinds of files from the codebase view"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.5.0",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "@semio-tech/process": "workspace:*"
  },
  "dependencies": {
    "@semio-tech/schema-ts": "workspace:*"
  },
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
