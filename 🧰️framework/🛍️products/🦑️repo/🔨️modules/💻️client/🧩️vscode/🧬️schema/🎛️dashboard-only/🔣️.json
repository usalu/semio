{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "forbiddenCommands",
    "forbiddenSymbols",
    "retainedCommands",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "forbiddenCommands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^compose\\."
      }
    },
    "forbiddenSymbols": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "retainedCommands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "forbiddenCommands",
          "forbiddenSymbols"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "forbiddenCommands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbiddenSymbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
