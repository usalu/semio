{
  "name": "@semio-tech/repo-mcp-go",
  "projectType": "application",
  "targets": {
    "build": {
      "cache": true,
      "outputs": [
        "{projectRoot}/../../../mcp",
        "{projectRoot}/../../../mcp.exe"
      ],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        }
      ],
      "options": {
        "command": "bun ./📜️script.ts build"
      }
    },
    "dev": {
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "bun ./📜️script.ts dev",
        "forwardAllArgs": true
      }
    },
    "test": {
      "outputs": [],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        }
      ],
      "options": {
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  },
  "implicitDependencies": [
    "@semio-tech/framework-schema"
  ]
}
