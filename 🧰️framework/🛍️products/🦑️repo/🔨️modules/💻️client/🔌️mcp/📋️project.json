{
  "name": "repo-mcp",
  "$schema": "../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "repo:script",
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        }
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🔌️mcp",
        "command": "bun ./📜️script.ts build"
      },
      "outputs": [
        "{workspaceRoot}/.🧬semio/🦑️repo/⚡️cache/🗃️bin/{options.env.SEMIO_BUILD_MODE}/repo"
      ]
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "command": "bun ./📜️script.ts test"
      }
    }
  }
}
