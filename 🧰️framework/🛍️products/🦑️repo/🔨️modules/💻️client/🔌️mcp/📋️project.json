{
  "name": "repo-mcp",
  "$schema": "../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "application",
  "namedInputs": {
    "goToolchain": [
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "goToolchain"
      ],
      "dependsOn": [
        {
          "target": "generate",
          "projects": [
            "@semio-tech/framework-schema"
          ]
        }
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🔌️mcp",
        "command": "bun ./📜️script.ts build"
      },
      "outputs": [
        "{workspaceRoot}/.🧬semio/🦑️repo/⚡️cache/🗃️bin/{options.env.SEMIO_BUILD_MODE}/repo"
      ]
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "goToolchain"
      ],
      "outputs": [],
      "options": {
        "command": "bun ./📜️script.ts test"
      }
    }
  }
}
