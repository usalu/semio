# PostgreSQL
POSTGRES_DB=compose_repo
POSTGRES_USER=compose
POSTGRES_PASSWORD=changeme

# Server
DATABASE_URL=postgresql://compose:changeme@localhost:5432/compose_repo
APP_BASE_URL=https://repo.compose.dev

# Discord (optional)
DISCORD_WEBHOOK_URL=

# GitHub webhook secret (optional)
