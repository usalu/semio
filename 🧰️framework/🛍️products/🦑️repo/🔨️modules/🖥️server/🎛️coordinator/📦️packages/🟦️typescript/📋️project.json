{
  "name": "@semio-tech/repo-coordinator",
  "$schema": "../../../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/🧪️tests/🎚️config/🟦️.ts",
      "sharedGlobals"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/**/*"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "dev": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts dev",
        "forwardAllArgs": true,
        "env": {
          "SEMIO_BUILD_MODE": "prototype"
        }
      },
      "cache": false,
      "continuous": true,
      "outputs": [],
      "dependsOn": [
        "build"
      ]
    },
    "build": {
      "executor": "repo:script",
      "inputs": [
        "production",
        "^production"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🟦️typescript",
        "command": "repo ../../🏗️builder/🏃️execution/📜️script.ts build",
        "forwardAllArgs": false
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "start": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts start",
        "forwardAllArgs": true
      },
      "cache": false,
      "continuous": true,
      "outputs": [],
      "dependsOn": [
        "build"
      ],
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-next-rebuild": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "cache": true,
      "dependsOn": [],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts test next-rebuild"
      }
    }
  }
}
