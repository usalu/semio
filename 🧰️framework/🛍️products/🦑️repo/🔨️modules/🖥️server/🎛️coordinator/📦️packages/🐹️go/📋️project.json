{
  "name": "@semio-tech/repo-coordinator-go",
  "projectType": "application",
  "targets": {
    "build": {
      "cache": true,
      "outputs": [
        "{workspaceRoot}/.🧬semio/🦑️repo/⚡️cache/🗃️bin/{options.env.SEMIO_BUILD_MODE}/coordinator"
      ],
      "options": {
        "command": "bun ./📜️script.ts build"
      }
    },
    "dev": {
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "bun ./📜️script.ts dev",
        "forwardAllArgs": true
      }
    },
    "test": {
      "outputs": [],
      "options": {
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
