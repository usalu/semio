{
  "name": "@semio-tech/repo-coordinator-go",
  "projectType": "application",
  "namedInputs": {
    "goToolchain": [
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [
        "{workspaceRoot}/.🧬semio/🦑️repo/⚡️cache/🗃️bin/{options.env.SEMIO_BUILD_MODE}/coordinator"
      ],
      "options": {
        "command": "repo ./📜️script.ts build"
      },
      "inputs": [
        "production",
        "^production",
        "goToolchain"
      ]
    },
    "dev": {
      "executor": "repo:script",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "repo ./📜️script.ts dev",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "outputs": [],
      "options": {
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "goToolchain"
      ]
    }
  }
}
