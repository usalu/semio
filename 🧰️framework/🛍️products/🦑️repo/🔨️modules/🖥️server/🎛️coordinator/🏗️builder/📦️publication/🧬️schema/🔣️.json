{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Next Compiler File Trace",
  "type": "object",
  "required": [
    "version",
    "files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
