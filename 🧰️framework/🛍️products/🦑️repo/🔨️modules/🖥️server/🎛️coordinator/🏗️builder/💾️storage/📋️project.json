{
  "name": "repo-next-storage",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/**/*"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "scope:repo",
    "language:typescript"
  ],
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "options": {
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "test-nx-cache": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        { "env": "SEMIO_TEST_LEVEL" },
        { "env": "SEMIO_TEST_BUDGET_MS" },
        { "env": "SEMIO_BUILD_BUDGET_MS" }
      ],
      "outputs": [],
      "options": {
        "command": "repo ./📜️script.ts test nx-cache",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "test-execution": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "options": {
        "command": "repo ./📜️script.ts test execution",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  }
}
