      "cache": false
    },
    "mcp": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts mcp",
        "forwardAllArgs": true
      },
      "cache": false
    }
  }
}
