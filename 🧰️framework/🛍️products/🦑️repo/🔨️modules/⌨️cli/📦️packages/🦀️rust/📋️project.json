{
  "name": "@semio-tech/repo-cli-rs",
  "$schema": "../../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "targets": {
    "build": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build"
      },
      "metadata": {
        "semio": {
          "rustBuildIntent": {
            "version": 1,
            "manifest": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust/Cargo.toml",
            "package": "semio-framework-repo-cli",
            "scope": "package",
            "fallback": {
              "kind": "bounded-cargo",
              "adapters": [
                "foreign-source",
                "binary",
                "proc-macro",
                "build-script",
                "build-script-run"
              ]
            }
          }
        }
      },
      "cache": false
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "repo": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts repo",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "mcp": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts mcp",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "build-cli": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build-cli"
      },
      "metadata": {
        "semio": {
          "rustBuildIntent": {
            "version": 1,
            "manifest": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust/Cargo.toml",
            "package": "semio-framework-repo-cli",
            "scope": "binary",
            "fallback": {
              "kind": "bounded-cargo",
              "adapters": [
                "foreign-source",
                "binary",
                "proc-macro",
                "build-script",
                "build-script-run"
              ]
            },
            "binary": "semio-repo"
          }
        }
      }
    }
  }
}
