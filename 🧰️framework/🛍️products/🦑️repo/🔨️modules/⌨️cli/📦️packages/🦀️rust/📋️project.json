{
  "name": "@semio-tech/repo-cli-rs",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build"
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick"
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long"
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts run",
        "forwardAllArgs": true
      },
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "daemon": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts daemon",
        "forwardAllArgs": true
      },
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "workflow": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts workflow",
        "forwardAllArgs": true
      },
      "cache": false,
      "dependsOn": [
        "build"
      ]
    }
  }
}
