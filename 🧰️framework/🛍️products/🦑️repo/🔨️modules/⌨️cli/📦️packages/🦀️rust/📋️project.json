{
  "name": "@semio-tech/repo-cli-rs",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "$schema": "../../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "targets": {
    "build": {
      "executor": "repo:script",
      "inputs": [
        "production",
        "^production",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build"
      },
      "metadata": {
        "semio": {
          "rustBuildIntent": {
            "version": 1,
            "manifest": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust/Cargo.toml",
            "package": "semio-framework-repo-cli",
            "scope": "package",
            "fallback": {
              "kind": "bounded-cargo",
              "adapters": [
                "foreign-source",
                "binary",
                "proc-macro",
                "build-script",
                "build-script-run"
              ]
            }
          }
        }
      },
      "cache": true
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "repo": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts repo",
        "forwardAllArgs": true
      },
      "cache": false,
      "continuous": true,
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "continuous", "reason": "serves-until-stopped" }
        }
      }
    },
    "mcp": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts mcp",
        "forwardAllArgs": true
      },
      "cache": false,
      "continuous": true,
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "continuous", "reason": "serves-until-stopped" }
        }
      }
    },
    "build-cli": {
      "executor": "repo:script",
      "inputs": [
        "production",
        "^production",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build-cli"
      },
      "metadata": {
        "semio": {
          "rustBuildIntent": {
            "version": 1,
            "manifest": "🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/📦️packages/🦀️rust/Cargo.toml",
            "package": "semio-framework-repo-cli",
            "scope": "binary",
            "fallback": {
              "kind": "bounded-cargo",
              "adapters": [
                "foreign-source",
                "binary",
                "proc-macro",
                "build-script",
                "build-script-run"
              ]
            },
            "binary": "repo"
          }
        }
      }
    }
  }
}
