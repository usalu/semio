        "event": "agent.tool.terminal.starting",
        "client": "claude-code",
        "second": "2026-09-06T08:00:00Z",
        "json": false,
        "input": { "tool_name": "Bash", "tool_input": { "command": "git commit -m x" } }
      }
    },
    {
      "id": "a-blocked-terminal-command-in-json-mode-still-exits-zero",
