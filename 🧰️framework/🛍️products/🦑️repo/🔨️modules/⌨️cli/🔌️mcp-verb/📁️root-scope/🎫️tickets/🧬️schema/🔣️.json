{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "ticket"
  ],
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{2}/[A-Z0-9-]+(?:/[A-Z0-9-]+)*$"
    },
    "ticket": {
      "type": "object",
      "required": [
        "title",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "closed"
          ]
        }
      }
    }
  },
  "$defs": {
    "LocalManagementOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no_issue": {
          "type": "boolean"
        },
        "no_management": {
          "type": "boolean"
        }
      }
    }
  }
}
