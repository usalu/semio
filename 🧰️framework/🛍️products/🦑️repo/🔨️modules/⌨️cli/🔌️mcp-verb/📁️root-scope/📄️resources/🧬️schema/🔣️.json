{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio-tech.com/schema/repo/mcp/repository-resources",
  "oneOf": [
    {
      "$ref": "#/$defs/FilesResource"
    },
    {
      "$ref": "#/$defs/FoldersResource"
    }
  ],
  "$defs": {
    "File": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "name",
        "kind",
        "extension"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "extension": {
          "type": "string"
        }
      }
    },
    "Folder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "FilesResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo"
      ],
      "properties": {
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/File"
              }
            }
          }
        }
      }
    },
    "FoldersResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo"
      ],
      "properties": {
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "folders"
          ],
          "properties": {
            "folders": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Folder"
              }
            }
          }
        }
      }
    },
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mimeType",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mimeType": {
          "const": "application/json"
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "uri",
              "document"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "enum": [
                  "repo://files",
                  "repo://folders"
                ]
              },
              "document": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/FilesResource"
                  },
                  {
                    "$ref": "#/$defs/FoldersResource"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "uri": {
                      "const": "repo://files"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "document": {
                      "$ref": "#/$defs/FilesResource"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "uri": {
                      "const": "repo://folders"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "document": {
                      "$ref": "#/$defs/FoldersResource"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
