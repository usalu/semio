{
  "name": "@semio-tech/repo-test-runner-go",
  "$schema": "../../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "namedInputs": {
    "goToolchain": [
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "goToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🏃️test-runner/📦️packages/🐹️go",
        "command": "repo ./📜️script.ts build"
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "deterministic", "reason": "check-without-outputs" }
        }
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "goToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🏃️test-runner/📦️packages/🐹️go",
        "command": "repo ./📜️script.ts test"
      }
    }
  }
}
