{
  "$comment": "🧫️ Ordinary unmarked fixture directories inherit the actual nearest checkout, or remain the starting directory when none exists. No repository markers are fabricated.",
  "schema": "semio.repo.workspace.root-discovery-trees/1",
  "trees": [
    {
      "name": "nested",
      "directories": [
        "first/a/b"
      ],
      "files": {},
      "startAt": "first/a/b",
      "expectedRoot": "nearest-checkout-or-start"
    },
    {
      "name": "source",
      "directories": [
        "src/child"
      ],
      "files": {
        "src/file.rs": "pub fn item() {}\n"
      },
      "startAt": "src/child",
      "expectedRoot": "nearest-checkout-or-start"
    },
    {
      "name": "empty",
      "directories": [
        "empty"
      ],
      "files": {},
      "startAt": "empty",
      "expectedRoot": "nearest-checkout-or-start"
    }
  ],
  "layout": {
    "semioDirName": ".🧬semio",
    "repoDirName": "🦑️repo",
    "ticketsDirName": "🎫️tickets",
    "goalsDirName": "🎯️goals",
    "devsDirName": "🧑️‍💻️devs",
    "filesIndexName": "📁️files.json",
    "configFileName": "📋️config.toml"
  },
  "configDocuments": [
    {
      "name": "missing",
      "document": null,
      "expected": "session=false operations=true plan=true detail=standard"
    },
    {
      "name": "empty",
      "document": "",
      "expected": "session=false operations=true plan=true detail=standard"
    },
    {
      "name": "logging-section",
      "document": "# a comment\n[logging]\nsession = \"on\"\noperations = no\nplan = 1\ndetail = 'full'\n",
      "expected": "session=true operations=false plan=true detail=full"
    },
    {
      "name": "other-sections-are-ignored",
      "document": "[other]\nsession = true\n",
      "expected": "session=false operations=true plan=true detail=standard"
    },
    {
      "name": "empty-detail-keeps-the-default",
      "document": "[logging]\ndetail = \"\"\n",
      "expected": "session=false operations=true plan=true detail=standard"
    }
  ]
}
