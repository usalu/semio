{
  "$comment": "🧫️ Immutable glob vectors for the owned matcher. Every pattern/path pair in `vectors` is one micromatch agrees with, so the oracle and both subjects must return the same verdict. `divergentVectors` records the one deliberate difference: the owned matcher accepts the POSIX `[!…]` negation spelling, which picomatch (and therefore micromatch) reads as a literal class. The `g1-*` pair is the one the retired `1️⃣g1-contract.json` fixture carried. `braceVectors` pins brace alternation: a group expands to its alternatives, nesting binds a comma to its innermost group, an empty alternative stands for the empty string, and an unpaired brace or a comma-free group stays literal.",
  "schema": "semio.repo.workspace.glob-vectors/1",
  "vectors": [
    { "name": "g1-recursive-go-root", "pattern": "**/*.go", "path": "root.go", "expected": true },
    { "name": "g1-recursive-go-one-level", "pattern": "**/*.go", "path": "a/one.go", "expected": true },
    { "name": "g1-recursive-go-two-levels", "pattern": "**/*.go", "path": "a/b/two.go", "expected": true },
    { "name": "single-star-stops-at-separator", "pattern": "*.go", "path": "a/one.go", "expected": false },
    { "name": "single-star-matches-in-segment", "pattern": "a/*.go", "path": "a/one.go", "expected": true },
    { "name": "star-segment-is-exactly-one", "pattern": "a/*/two.go", "path": "a/b/two.go", "expected": true },
    { "name": "star-segment-is-not-two", "pattern": "a/*/two.go", "path": "a/b/c/two.go", "expected": false },
    { "name": "trailing-globstar-spans-depth", "pattern": "a/**", "path": "a/b/c", "expected": true },
    { "name": "inner-globstar-is-optional", "pattern": "a/**/*.go", "path": "a/c.go", "expected": true },
    { "name": "inner-globstar-spans-depth", "pattern": "a/**/*.go", "path": "a/b/c.go", "expected": true },
    { "name": "question-is-one-character", "pattern": "?.go", "path": "a.go", "expected": true },
    { "name": "question-is-not-two-characters", "pattern": "?.go", "path": "ab.go", "expected": false },
    { "name": "class-set-member", "pattern": "[abc].go", "path": "b.go", "expected": true },
    { "name": "class-set-non-member", "pattern": "[abc].go", "path": "d.go", "expected": false },
    { "name": "class-range-member", "pattern": "[a-c].go", "path": "c.go", "expected": true },
    { "name": "class-range-non-member", "pattern": "[a-c].go", "path": "d.go", "expected": false },
    { "name": "caret-negated-class-admits-others", "pattern": "[^a].go", "path": "b.go", "expected": true },
    { "name": "caret-negated-class-rejects-member", "pattern": "[^a].go", "path": "a.go", "expected": false },
    { "name": "literal-dot-is-literal", "pattern": "a.go", "path": "axgo", "expected": false },
    { "name": "whole-path-must-match", "pattern": "a/one.go", "path": "b/a/one.go", "expected": false },
    { "name": "emoji-segments-match-literally", "pattern": "**/📜️script.ts", "path": "🧰️framework/📜️script.ts", "expected": true },
    { "name": "emoji-segments-reject-others", "pattern": "**/📜️script.ts", "path": "🧰️framework/📋️project.json", "expected": false }
  ],
  "braceVectors": [
    { "name": "brace-extension-set-first", "pattern": "**/*.{ts,tsx}", "path": "a/b/c.ts", "expected": true },
    { "name": "brace-extension-set-second", "pattern": "**/*.{ts,tsx}", "path": "a/b/c.tsx", "expected": true },
    { "name": "brace-extension-set-rejects-other", "pattern": "**/*.{ts,tsx}", "path": "a/b/c.js", "expected": false },
    { "name": "brace-statute-scope-spans-languages", "pattern": "**/*.{ts,tsx,py,cs,go,rs}", "path": "a/b/m.rs", "expected": true },
    { "name": "brace-statute-scope-reaches-the-root", "pattern": "**/*.{ts,tsx,py,cs,go,rs}", "path": "script.ts", "expected": true },
    { "name": "brace-nested-outer-alternative", "pattern": "{a,{b,c}}/x.go", "path": "a/x.go", "expected": true },
    { "name": "brace-nested-inner-first", "pattern": "{a,{b,c}}/x.go", "path": "b/x.go", "expected": true },
    { "name": "brace-nested-inner-second", "pattern": "{a,{b,c}}/x.go", "path": "c/x.go", "expected": true },
    { "name": "brace-nested-rejects-non-member", "pattern": "{a,{b,c}}/x.go", "path": "d/x.go", "expected": false },
    { "name": "brace-unmatched-open-is-literal", "pattern": "a{b.go", "path": "a{b.go", "expected": true },
    { "name": "brace-unmatched-close-is-literal", "pattern": "a}b.go", "path": "a}b.go", "expected": true },
    { "name": "brace-unmatched-open-never-expands", "pattern": "{a.go", "path": "a.go", "expected": false },
    { "name": "brace-empty-alternative-matches-nothing", "pattern": "a{,-b}.go", "path": "a.go", "expected": true },
    { "name": "brace-empty-alternative-keeps-its-sibling", "pattern": "a{,-b}.go", "path": "a-b.go", "expected": true },
    { "name": "brace-group-without-comma-is-literal", "pattern": "{a}.go", "path": "a.go", "expected": false },
    { "name": "brace-group-without-comma-keeps-its-braces", "pattern": "{a}.go", "path": "{a}.go", "expected": true },
    { "name": "brace-two-groups-cross-first-last", "pattern": "a{b,c}d{e,f}.go", "path": "abdf.go", "expected": true },
    { "name": "brace-two-groups-cross-last-first", "pattern": "a{b,c}d{e,f}.go", "path": "acde.go", "expected": true },
    { "name": "brace-two-groups-reject-outsider", "pattern": "a{b,c}d{e,f}.go", "path": "abdg.go", "expected": false },
    { "name": "brace-whole-pattern-alternation-first", "pattern": "{a,b}", "path": "a", "expected": true },
    { "name": "brace-whole-pattern-alternation-second", "pattern": "{a,b}", "path": "b", "expected": true }
  ],
  "divergentVectors": [
    { "name": "bang-negated-class-admits-others", "pattern": "[!a].go", "path": "b.go", "owned": true, "glob": false },
    { "name": "bang-negated-class-rejects-member", "pattern": "[!a].go", "path": "a.go", "owned": false, "glob": true }
  ]
}
