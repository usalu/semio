  "create-issue-resolves-the-milestone-title-first": {
    "exchanges": [
      {
        "argv": ["gh", "api", "repos/{owner}/{repo}/milestones/17", "--jq", ".title"],
        "stdout": "26/09\n",
        "stderr": "",
        "status": 0
      },
      {
        "argv": ["gh", "issue", "create", "--title", "Split the godfile", "--body", "One package per domain.", "--label", "ticket", "--milestone", "26/09"],
        "stdout": "",
        "stderr": "Creating issue in usalu/semio\nhttps://github.com/usalu/semio/issues/412\n",
        "status": 0
      },
      {
        "argv": ["gh", "project", "item-add", "2", "--owner", "usalu", "--url", "https://github.com/usalu/semio/issues/412"],
        "stdout": "",
        "stderr": "",
        "status": 0
      },
      {
        "argv": ["gh", "api", "user", "--jq", ".login"],
        "stdout": "usalu\n",
        "stderr": "",
        "status": 0
      },
      {
        "argv": ["gh", "issue", "edit", "https://github.com/usalu/semio/issues/412", "--add-assignee", "usalu"],
        "stdout": "",
        "stderr": "",
        "status": 0
      }
    ]
  },
  "a-failing-call-carries-the-trimmed-stderr": {
    "exchanges": [
      {
        "argv": ["gh", "issue", "view", "https://github.com/usalu/semio/issues/999", "--json", "url,state,milestone,labels,title,body"],
