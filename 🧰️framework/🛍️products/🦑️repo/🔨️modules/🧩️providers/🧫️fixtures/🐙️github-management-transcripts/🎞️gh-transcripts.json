  "milestone-list-is-scanned-for-a-title": {
    "exchanges": [
      {
        "argv": ["gh", "api", "repos/:owner/:repo/milestones", "-X", "GET", "-F", "state=all", "-F", "per_page=100", "--paginate", "--jq", ".[]"],
        "stdout": "{\"number\":16,\"title\":\"26/08\",\"description\":\"August\",\"url\":\"https://api.github.com/repos/usalu/semio/milestones/16\",\"due_on\":\"2026-08-31T00:00:00Z\",\"state\":\"closed\"}\n{\"number\":17,\"title\":\"26/09\",\"description\":\"September\",\"url\":\"https://api.github.com/repos/usalu/semio/milestones/17\",\"due_on\":\"2026-09-30T00:00:00Z\",\"state\":\"open\"}\n",
        "stderr": "",
        "status": 0
      }
    ]
  },
