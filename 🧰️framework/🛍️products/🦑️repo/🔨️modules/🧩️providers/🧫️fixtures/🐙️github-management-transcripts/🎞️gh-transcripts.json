    "exchanges": [
      {
        "argv": ["gh", "label", "list", "--json", "name", "--limit", "1000"],
        "stdout": "[{\"name\":\"ticket\"},{\"name\":\"@repo\"},{\"name\":\"@stale\"}]\n",
        "stderr": "",
        "status": 0
      }
    ]
