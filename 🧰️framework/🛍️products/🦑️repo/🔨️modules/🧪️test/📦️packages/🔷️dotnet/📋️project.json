{
  "name": "@semio-tech/repo-test-dotnet",
  "projectType": "library",
  "tags": [
    "language:dotnet"
  ],
  "targets": {
    "deps": {
      "cache": false,
      "outputs": [],
      "options": {
        "command": "bun ./📜️script.ts deps"
      }
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "deps"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "options": {
        "command": "bun ./📜️script.ts build"
      }
    }
  }
}
