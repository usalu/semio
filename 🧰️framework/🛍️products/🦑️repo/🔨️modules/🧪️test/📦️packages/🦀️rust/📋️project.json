{
  "name": "semio-repo-test-host",
  "projectType": "library",
  "sourceRoot": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🧪️test/📦️packages/🦀️rust",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/🧪️test/**/*.rs",
      "sharedGlobals"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "check": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🧪️test/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check"
      }
    },
    "test": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🧪️test/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    }
  }
}
