{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifestPath",
    "fixtureKind",
    "descendantContract",
    "pairs",
    "nodes",
    "nxConsumers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "manifestPath": {
      "type": "string",
      "minLength": 1
    },
    "fixtureKind": {
      "const": "stdio-html-mutation-fixture"
    },
    "descendantContract": {
      "const": "stdio-html-source-pair-v1"
    },
    "pairs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "directoryName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]+$"
          },
          "directoryName": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "type",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "enum": [
              "directory",
              "file"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nxConsumers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectPath",
          "inputSet",
          "targets",
          "sourceInputs"
        ],
        "properties": {
          "projectPath": {
            "type": "string",
            "minLength": 1
          },
          "inputSet": {
            "const": "htmlSourcePairs"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceInputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
