        "Angle": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "x-semio-ui": {
            "widget": "dial",
            "step": 15,
            "unit": "deg",
            "label": {
              "en": "Angle",
              "de": "Winkel"
            }
          }
        },
        "Caption": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Caption",
              "de": "Beschriftung"
            }
          }
        },
        "Word": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bits"
          ],
          "properties": {
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        }
      }
    }
  ],
