        {
          "path": "🧩️domain/🔬️local-import/🟨️.js",
          "source": "import { test } from \"./utilities\";\ntest(1);"
        },
        {
          "path": "🧩️domain/🔬️global-register/🟨️.js",
          "source": "test(\"real\", () => {});"
        },
        {
          "path": "🧩️domain/🔬️modified-register/🟨️.js",
          "source": "import { test } from \"vitest\";\ntest.skip(\"real\", () => {});"
