        },
        {
          "path": "🧩️domain/🔬️loop-shadow/🟨️.js",
          "source": "for (const test of values) test(1);\ntest(\"real\", () => {});"
        },
        {
          "path": "🧩️domain/🔬️catch-shadow/🟨️.js",
          "source": "try {} catch (test) { test(1); }"
        },
        {
          "path": "🧩️domain/🔬️hoisted-variable/🟨️.js",
          "source": "function check() { test(1); if (true) { var test = value => value; } }"
        },
        {
          "path": "🧩️domain/🔬️named-function/🟨️.js",
          "source": "const check = function test(value) { return test(value); };"
