  "exportPresenceCases": [
    {
      "id": "rust-definition-struct",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub struct Approval {\n    pub artifact_id: String,\n}\n",
      "present": true
    },
    {
      "id": "rust-definition-enum",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub enum Approval {\n    Granted,\n}\n",
      "present": true
    },
    {
      "id": "rust-definition-alias",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub type Approval = super::Approval;\n",
      "present": true
    },
    {
      "id": "rust-re-export-per-name",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "mod inner;\npub use inner::Approval;\n",
      "present": true
    },
    {
      "id": "rust-re-export-per-name-qualified",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub use crate::inference::approval::Approval;\n",
      "present": true
    },
    {
      "id": "rust-re-export-renamed-to-the-export",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub use crate::inference::ApprovalV1 as Approval;\n",
      "present": true
    },
    {
      "id": "rust-re-export-grouped-declares-nothing",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub use crate::inference::{Approval, Receipt};\n",
      "present": false
    },
    {
      "id": "rust-re-export-glob-declares-nothing",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub use crate::inference::*;\n",
      "present": false
    },
    {
      "id": "rust-re-export-private-declares-nothing",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "use crate::inference::Approval;\n",
      "present": false
    },
    {
      "id": "rust-re-export-crate-visible-declares-nothing",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub(crate) use crate::inference::Approval;\n",
      "present": false
    },
    {
      "id": "rust-re-export-of-another-name-declares-nothing",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub use crate::inference::Receipt;\n",
      "present": false
    },
    {
      "id": "rust-absent",
      "format": "🦀️rust",
      "export": "Approval",
      "source": "pub struct Receipt {\n    pub artifact_id: String,\n}\n",
      "present": false
    },
    {
      "id": "graphql-input-keyword",
      "format": "🔗️graphql",
      "export": "Approval",
      "source": "input Approval {\n  artifactId: String!\n}\n",
      "present": true
    },
    {
      "id": "graphql-unknown-keyword",
      "format": "🔗️graphql",
      "export": "Approval",
      "source": "directive Approval on FIELD\n",
      "present": false
    },
    {
      "id": "protobuf-message",
      "format": "🛰️protobuf",
      "export": "Approval",
      "source": "message Approval {\n  string artifact_id = 1;\n}\n",
      "present": true
    },
    {
      "id": "typescript-type-without-parser",
      "format": "🟦️typescript",
      "export": "Approval",
      "source": "export type Approval = { artifactId: string };\n",
      "present": true,
      "parser": false
    },
    {
      "id": "typescript-type-with-parser",
      "format": "🟦️typescript",
      "export": "Approval",
      "source": "export type Approval = { artifactId: string };\nexport function parseApproval(value: unknown): Approval {\n  return value as Approval;\n}\n",
      "present": true,
      "parser": true
    }
  ],
  "treeCases": [
    {
      "id": "seed-hub-inference-approval-fixture-wrapper",
      "title": "The hub inference-approval fixture wrapper defines the contract it is an example of",
      "invariant": "fixture-isolation",
      "files": [
        {
          "path": "🌎️hub/🧪️fixtures/✅️inference-approval-v1/🧬️.schema.json",
          "json": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "semio.hub.inference-approval-fixture/v1",
            "type": "object",
            "properties": {
              "maximumBytes": {
                "type": "integer"
              },
              "hostile": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "$defs": {
              "request": {
                "type": "object",
                "required": [
                  "artifactId"
                ],
                "properties": {
                  "artifactId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ],
      "expect": [
        {
          "code": "schema-placement-forbidden-filename",
          "path": "🌎️hub/🧪️fixtures/✅️inference-approval-v1/🧬️.schema.json"
        },
        {
          "code": "schema-fixture-defines-schema",
          "path": "🌎️hub/🧪️fixtures/✅️inference-approval-v1/🧬️.schema.json"
        }
      ]
    },
