    {"id": "object-accepts-a-complete-instance", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "additionalProperties": false, "required": ["title", "words"], "properties": {"title": {"type": "string", "minLength": 1}, "words": {"type": "array", "items": {"type": "string"}}}}, "instance": {"title": "a", "words": ["x", "y"]}, "valid": true},
