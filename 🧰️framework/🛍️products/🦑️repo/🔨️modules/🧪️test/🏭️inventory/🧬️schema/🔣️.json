{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact",
    "standard",
    "subset",
    "bridgeVersion",
    "mutations"
  ],
  "properties": {
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "standard": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "subset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "surface": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "producedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "schema": {
      "const": "semio.repository-test.runtime-inventory/v2"
    },
    "bridgeVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "mutations": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "variant",
          "outcomes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "variant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "verb": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "entity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "record": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "applied",
                "no-op",
                "empty",
                "disjoint",
                "rejected"
              ]
            }
          }
        }
      }
    }
  }
}
