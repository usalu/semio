{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:repository:mutation-inventory-provider:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "script",
    "roots"
  ],
  "definitions": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$",
      "not": {
        "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
      }
    }
  },
  "properties": {
    "script": {
      "$ref": "#/definitions/path"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "const": "."
          },
          {
            "$ref": "#/definitions/path"
          }
        ]
      }
    }
  }
}
