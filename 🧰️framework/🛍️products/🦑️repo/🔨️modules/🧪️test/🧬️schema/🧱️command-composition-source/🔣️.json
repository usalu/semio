{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://semio/repo-test-command-composition-source/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owners", "contexts", "consumers", "nativePythonImport", "route"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owners": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "declarations"],
        "properties": {
          "path": { "type": "string", "pattern": "/🟦️\\.ts$" },
          "declarations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directoryName", "parentKindId", "kindId"],
        "properties": {
          "directoryName": { "type": "string", "minLength": 1 },
          "parentKindId": { "type": "string", "minLength": 1 },
          "kindId": { "type": "string", "pattern": "^repo-test-" }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owners"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "nativePythonImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "module", "marker", "argument"],
      "properties": {
        "sourcePath": { "const": "🧫️fixtures/🧱️command-composition-source/🐍️.py" },
        "module": { "const": "🐍️" },
        "marker": { "const": "declared-local-source" },
        "argument": { "const": "--local-source" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "command", "namedInput", "launchName", "launchCommand"],
      "properties": {
        "target": { "const": "test-command-composition-source" },
        "command": { "const": "bun ./📜️script.ts test command-composition-source" },
        "namedInput": { "const": "commandCompositionSources" },
        "launchName": { "const": "🧪️test🧭️command-composition-source" },
        "launchCommand": { "const": "bun nx run @semio-tech/repo-test-domain:test-command-composition-source" }
      }
    }
  }
}
