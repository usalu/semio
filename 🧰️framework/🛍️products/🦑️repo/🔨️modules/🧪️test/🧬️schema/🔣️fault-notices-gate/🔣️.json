{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.repo.fault-notice/v1",
  "$ref": "#/definitions/finding",
  "definitions": {
    "finding": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "enum": [
            "faultNoticeMissing",
            "faultNoticeSyntax",
            "faultNoticeFramework",
            "faultAnonymous",
            "faultNoticeInvalid",
            "faultNoticeUnresolved",
            "faultNoticeStale",
            "faultNoticeDescriptor"
          ]
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
