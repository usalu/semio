    { "name": "a line comment is not code", "path": "✏️s/🔌️plugins/x/🦀️.rs", "text": "// unimplemented!(\"later\")\nfn a() {}\n", "expected": [{ "line": 1, "macro": "unimplemented", "testOnly": false, "commented": true }] },
    { "name": "a block comment across lines is not code", "path": "🧰️framework/x/🦀️.rs", "text": "/* start\n  todo!()\n end */ fn a() {}\n", "expected": [{ "line": 2, "macro": "todo", "testOnly": false, "commented": true }] },
    { "name": "a double slash inside a string keeps the macro after it as code", "path": "🌎️hub/x/🦀️.rs", "text": "let url = \"http://x\"; unimplemented!();\n", "expected": [{ "line": 1, "macro": "unimplemented", "testOnly": false, "commented": false }] },
    { "name": "a test path is test-only", "path": "🧰️framework/🔨️modules/🔄️machine/🧪️tests/🔬️host-unit/🦀️.rs", "text": "unimplemented!(\"host tests never step a machine\")\n", "expected": [{ "line": 1, "macro": "unimplemented", "testOnly": true, "commented": false }] },
