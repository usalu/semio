    { "name": "qualified classification across lines", "path": "✏️s/🔌️plugins/🗒️note/x/🦀️.rs", "text": "b\n  .action_interactive_job(\n    \"addBlock\",\n    semio_framework_plugin::InteractiveJobClassification::Migrated)\n", "expected": [{ "command": "addBlock", "classification": "Migrated", "line": 2 }], "calls": 1, "codeCalls": 1 },
