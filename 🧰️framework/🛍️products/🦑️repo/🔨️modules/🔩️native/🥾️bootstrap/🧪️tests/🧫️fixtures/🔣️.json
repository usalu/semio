        "📋️project.json": "{}",
        "package.json": "{\"text\":\"\\\"workspaces\\\":[]\"}"
      },
      "start": "domain/package",
      "expected": null
    },
    {
      "id": "trailing-document",
      "files": {
        "📋️project.json": "{}",
        "package.json": "{\"workspaces\":[]}false"
      },
      "start": "domain/package",
      "expected": null
