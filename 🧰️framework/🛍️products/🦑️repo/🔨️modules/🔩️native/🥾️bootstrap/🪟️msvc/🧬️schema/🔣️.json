{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native Windows MSVC Data Extraction",
  "definitions": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "inputsRoot", "stageRoot", "catalogSha256", "recipeSha256", "manifestSha256"],
      "properties": {
        "version": { "const": 1 },
        "inputsRoot": { "type": "string", "minLength": 1 },
        "stageRoot": { "type": "string", "minLength": 1 },
        "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "recipeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "Progress": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["phase", "done", "total"], "properties": { "phase": { "enum": ["metadata", "compiler", "sdk"] }, "done": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["phase", "bytes", "allocationUnit"], "properties": { "phase": { "const": "preflight" }, "bytes": { "type": "integer", "minimum": 1 }, "allocationUnit": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "Limits": {
      "const": { "maximumPathUtf16": 256, "maximumDirectoryDepth": 64, "maximumFileBytes": 100000000, "maximumFiles": 5000, "maximumCabinets": 64 }
    }
  }
}
