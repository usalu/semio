{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/native/observe/schema.json",
  "description": "🔩️ The native process-ownership contract of 🔩️native/👁️observe: what a process observation is on each host, which decision an observer owes for a re-observation, and which conformance evidence a language-agnostic vector must carry.",
  "$ref": "#/$defs/TransactionProcessObservation",
  "$defs": {
    "TransactionProcessBirth": {
      "description": "🐣️ The host-native birth identity that distinguishes a live process from a reused pid.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "seconds",
            "microseconds"
          ],
          "properties": {
            "platform": {
              "const": "darwin"
            },
            "seconds": {
              "$ref": "#/definitions/decimal"
            },
            "microseconds": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,5})$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "bootId",
            "startTicks"
          ],
          "properties": {
            "platform": {
              "const": "linux"
            },
            "bootId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "startTicks": {
              "$ref": "#/definitions/decimal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "filetime"
          ],
          "properties": {
            "platform": {
              "const": "win32"
            },
            "filetime": {
              "$ref": "#/definitions/decimal"
            }
          }
        }
      ]
    },
    "TransactionProcessObservation": {
      "description": "👁️ One reading of a process: identity, lineage and birth, with no signal ever sent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "parentPid",
        "groupId",
        "sessionId",
        "state",
        "birth"
      ],
      "properties": {
        "pid": {
          "$ref": "#/definitions/pid"
        },
        "parentPid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "groupId": {
          "anyOf": [
            {
              "$ref": "#/definitions/pid"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "#/definitions/pid"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "live",
            "zombie"
          ]
        },
        "birth": {
          "$ref": "#/$defs/TransactionProcessBirth"
        }
      }
    },
    "TransactionProcessLayout": {
      "description": "🧮️ The native record layout an observer decodes, certified from two independent producers before any record is read.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "architecture",
            "size",
            "alignment",
            "offsets"
          ],
          "properties": {
            "platform": {
              "const": "darwin"
            },
            "architecture": {
              "enum": [
                "arm64",
                "x64"
              ]
            },
            "size": {
              "const": 136
            },
            "alignment": {
              "const": 8
            },
            "offsets": {
              "const": {
                "status": 4,
                "pid": 12,
                "parentPid": 16,
                "groupId": 100,
                "seconds": 120,
                "microseconds": 128
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "architecture",
            "size",
            "alignment",
            "offsets"
          ],
          "properties": {
            "platform": {
              "const": "win32"
            },
            "architecture": {
              "enum": [
                "arm64",
                "x64"
              ]
            },
            "size": {
              "const": 568
            },
            "alignment": {
              "const": 8
            },
            "offsets": {
              "const": {
                "size": 0,
                "pid": 8,
                "parentPid": 32
              }
            }
          }
        }
      ]
    },
    "TransactionProcessDecisionKind": {
      "description": "⚖️ The verdict an observer owes for a re-observation of a process it spawned.",
      "enum": [
        "owned-leader",
        "owned-process",
        "owned-handle",
        "terminal",
        "reject"
      ]
    },
    "TransactionProcessRole": {
      "description": "🎭️ The role an observed child is admitted under; an unlisted role is rejected at admission.",
      "enum": [
        "phase-child",
        "mixed-generator-child",
        "failure-child",
        "lease-contender",
        "shard",
        "probe-subject",
        "probe-decoy"
      ]
    },
    "TransactionProcessFiletime": {
      "description": "🪟️ A Windows FILETIME split into its two 32-bit halves and the decimal it decodes to.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high",
        "value"
      ],
      "properties": {
        "low": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "high": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "value": {
          "$ref": "#/definitions/decimal"
        }
      }
    },
    "TransactionProcessProbeBudget": {
      "description": "⏱️ The budget and variants of the native probe; signals and retries are forbidden, not merely unused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packetBudgetMs",
        "caseBudgetMs",
        "childDeadlineMs",
        "variants",
        "signals",
        "retry",
        "requiresIndependentLayout"
      ],
      "properties": {
        "packetBudgetMs": {
          "const": 120000
        },
        "caseBudgetMs": {
          "const": 6000
        },
        "childDeadlineMs": {
          "const": 2000
        },
        "variants": {
          "const": [
            "leader",
            "nonleader",
            "decoy"
          ]
        },
        "signals": {
          "const": false
        },
        "retry": {
          "const": false
        },
        "requiresIndependentLayout": {
          "const": true
        }
      }
    }
  },
  "definitions": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
