      "toolName": "run_in_terminal",
      "toolArgs": "",
      "parentInfo": "",
      "input": { "session_id": "s-1", "tool_name": "run_in_terminal", "tool_input": { "command": "ls -la" } },
      "expectedAllowed": true,
      "expectedExit": 0,
      "expectedWrapped": true
    },
    {
