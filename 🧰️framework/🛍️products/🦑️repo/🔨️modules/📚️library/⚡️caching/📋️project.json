{
  "name": "repo",
  "projectType": "application",
  "targets": {
    "ci-baseline": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "bun ./🚦️ci/📜️script.ts baseline"
      }
    },
    "test": {
      "cache": true,
      "dependsOn": [
        "workspace:deps-wasm-opt"
      ],
      "options": {
        "command": "bun ./📜️script.ts test"
      },
      "outputs": []
    },
    "policy-check": {
      "cache": true,
      "options": {
        "command": "bun ./📜️script.ts policy-check"
      },
      "outputs": []
    },
    "graph-check": {
      "cache": true,
      "options": {
        "command": "bun ./📜️script.ts graph-check"
      },
      "outputs": []
    },
    "artifact-check": {
      "cache": true,
      "options": {
        "command": "bun ./📜️script.ts artifact-check"
      },
      "outputs": []
    },
    "artifact-package-contract": {
      "cache": true,
      "options": {
        "command": "bun ./📜️script.ts artifact-package-contract"
      },
      "outputs": []
    },
    "audit": {
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts audit"
      }
    },
    "doctor": {
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts doctor"
      }
    },
    "disk-report": {
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts disk-report"
      }
    },
    "cache-report": {
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts cache-report"
      }
    },
    "cache-prune": {
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts cache-prune"
      }
    },
    "cache-verify": {
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts cache-verify"
      }
    },
    "generator-inputs": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/.🧬semio/🦑️repo/⚡️cache/🔏️generator-inputs/📇️registry/🔣️.json"
      ],
      "options": {
        "command": "bun \"./🔏️inputs/📜️script.ts\" registry-catalog"
      }
    },
    "toolchain": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [],
      "options": {
        "command": "bun ./🚀️bootstrap/🛠️tools/🕸️wasm/📜️script.ts fingerprint"
      }
    }
  }
}
