{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.bootstrap/FleetFetchV1",
  "title": "Fleet fetch layer: every pinned external artifact is looked up by its sha256 in the fleet before the internet, uploaded after a verified download, and installed dependency trees are published once per lock state",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "storeDirectory": ["v1", "fleet", "fetch"],
        "installDirectory": ["v1", "fleet", "install"],
        "storeTimeoutMilliseconds": 8000,
        "httpTimeoutMilliseconds": 15000,
        "httpMaximumBytes": 268435456,
        "ledgerEnvironment": "SEMIO_FLEET_FETCH_LEDGER",
        "storeEnvironment": "SEMIO_FLEET_STORE_ROOT",
        "offEnvironment": "SEMIO_FLEET_FETCH",
        "verifiedDirectory": ["fleet-fetch", "verified"],
        "installClaimTtlMilliseconds": 60000,
        "installClaimRenewMilliseconds": 20000,
        "installAwaitMilliseconds": 25000,
        "installWaitMaximumMilliseconds": 1800000,
        "installBlobDirectory": ["blobs"],
        "uvDirectory": ["v1", "fleet", "uv"],
        "uvManifestPrefix": "uv-",
        "installPackConcurrency": 6,
        "installUnitCacheEntries": 20000,
        "installManifestSuffix": ".json",
        "installKeyPrefix": "inst-",
        "installMaximumBytes": 34359738368,
        "installKeepStates": 36,
        "installClaimMaximumBeats": 90
      }
    },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Source": { "enum": ["local", "store", "http", "upstream"] },
    "LedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "atMs", "sha256", "source", "bytes", "milliseconds"],
      "properties": {
        "version": { "const": 1 },
        "atMs": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/Sha256" },
        "source": { "$ref": "#/definitions/Source" },
        "bytes": { "type": "integer", "minimum": 0 },
        "milliseconds": { "type": "integer", "minimum": 0 },
        "direction": { "enum": ["get", "put"] },
        "url": { "type": "string", "maxLength": 512 }
      }
    },
    "InstallRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bun", "platform", "arch", "recipeSha256"],
      "properties": {
        "bun": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "enum": ["darwin", "linux", "win32", "posix", "any"] },
        "arch": { "type": "string", "minLength": 1, "maxLength": 16 },
        "recipeSha256": { "$ref": "#/definitions/Sha256" }
      }
    },
    "InstallShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "directories", "files", "links", "sha256"],
      "properties": {
        "entries": { "type": "integer", "minimum": 0 },
        "directories": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "links": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/Sha256" }
      }
    },
    "InstallManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "key", "projectionSha256", "runtime", "installed", "shape", "storeRoot", "fingerprint", "roots", "index", "lock", "publisher", "createdAtMs"],
      "properties": {
        "version": { "const": 1 },
        "key": { "type": "string", "pattern": "^inst-[a-f0-9]{64}$" },
        "projectionSha256": { "$ref": "#/definitions/Sha256" },
        "runtime": { "$ref": "#/definitions/InstallRuntime" },
        "installed": { "$ref": "#/definitions/Sha256" },
        "shape": { "$ref": "#/definitions/InstallShape" },
        "storeRoot": { "type": "string", "minLength": 1, "maxLength": 512 },
        "fingerprint": { "$ref": "#/definitions/Sha256" },
        "roots": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "index": {
          "description": "The content-addressed index of the pack: the SHA-256 and size of the gzip JSON blob (InstallIndex) that lists every unit blob, link and directory, and what it adds up to. Unit blobs are named by their own SHA-256, so identical packages of different generations are stored once.",
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "bytes", "units", "links", "packedBytes"],
          "properties": {
            "sha256": { "$ref": "#/definitions/Sha256" },
            "bytes": { "type": "integer", "minimum": 1 },
            "units": { "type": "integer", "minimum": 0 },
            "links": { "type": "integer", "minimum": 0 },
            "packedBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "lock": {
          "description": "The packages the tree was installed from: how many entries of the lockfile carry a tarball integrity, and the SHA-256 of the sorted lines `name@version integrity`. A restorer recomputes it from its own lockfile: same packages, same integrities.",
          "type": "object",
          "additionalProperties": false,
          "required": ["packages", "sha256"],
          "properties": { "packages": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/definitions/Sha256" } }
        },
        "publisher": {
          "description": "The fleet origin that built and published the pack and its Ed25519 signature (cache-write key) over key, index digest, per-file fingerprint, shape, lock digest and projection. A restorer checks it against the origin key the group store registers.",
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "signature"],
          "properties": { "origin": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" } }
        },
        "createdAtMs": { "type": "integer", "minimum": 0 }
      }
    },
    "InstallIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "directories", "links", "units"],
      "properties": {
        "version": { "const": 1 },
        "directories": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "links": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "target"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "target": { "type": "string", "maxLength": 4096 } } } },
        "units": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "sha256": { "$ref": "#/definitions/Sha256" }, "bytes": { "type": "integer", "minimum": 1 } } } }
      }
    },
    "UvIndex": {
      "description": "What a warm uv cache contributes for one uv.lock: the unpacked archive of every locked wheel as content-addressed unit blobs, and the two cache pointer files of each wheel (uv's own `.http` and `.msgpack` entries, which name the archive and the wheel's SHA-256).",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "directories", "links", "units", "files"],
      "properties": {
        "version": { "const": 1 },
        "directories": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "links": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "target"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "target": { "type": "string", "maxLength": 4096 } } } },
        "units": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "sha256": { "$ref": "#/definitions/Sha256" }, "bytes": { "type": "integer", "minimum": 1 } } } },
        "files": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "wheelSha256", "archive", "base64"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "wheelSha256": { "$ref": "#/definitions/Sha256" }, "archive": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" }, "base64": { "type": "string", "maxLength": 262144 } } } }
      }
    },
    "UvManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "lockSha256", "wheels", "index", "packedBytes", "publisher", "createdAtMs"],
      "properties": {
        "version": { "const": 1 },
        "lockSha256": { "$ref": "#/definitions/Sha256" },
        "wheels": { "type": "integer", "minimum": 0 },
        "index": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": { "sha256": { "$ref": "#/definitions/Sha256" }, "bytes": { "type": "integer", "minimum": 1 } } },
        "packedBytes": { "type": "integer", "minimum": 0 },
        "publisher": { "type": "object", "additionalProperties": false, "required": ["origin", "signature"], "properties": { "origin": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" } } },
        "createdAtMs": { "type": "integer", "minimum": 0 }
      }
    },
    "CrateIndexRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/Sha256" }
      }
    }
  }
}
