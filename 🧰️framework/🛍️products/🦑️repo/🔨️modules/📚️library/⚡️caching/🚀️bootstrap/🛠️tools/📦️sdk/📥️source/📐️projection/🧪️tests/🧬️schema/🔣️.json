{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:nx-dependency-projection-corpus:v1",
  "title": "Dependency Projection Corpus",
  "description": "Language-agnostic cases for the external dependency pins and the two captured installation inputs. A lock string value `@16MiB` stands for a 16 MiB string.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pins", "projections"],
  "properties": {
    "version": { "const": 1 },
    "pins": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "dependencies", "expected"], "properties": { "name": { "type": "string", "minLength": 1 }, "dependencies": { "type": "object", "additionalProperties": { "type": "string" } }, "expected": { "type": "object", "additionalProperties": { "type": "string" } } } } },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "recipe", "lock", "error", "package", "lockText"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "recipe": { "type": "object" },
          "lock": {},
          "error": { "type": "string" },
          "package": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "\\n$" }] },
          "lockText": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "\\n$" }] }
        }
      }
    }
  }
}
