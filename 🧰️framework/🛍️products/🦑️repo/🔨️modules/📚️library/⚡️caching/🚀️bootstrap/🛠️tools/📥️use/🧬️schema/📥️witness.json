{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "identity",
    "toolkitRoot",
    "processId",
    "nonce",
    "startedAt",
    "original",
    "endpoint"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "toolkitRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "processId": {
      "type": "integer",
      "minimum": 1
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "startedAt": {
      "type": "integer",
      "minimum": 1
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "policy",
        "deadlineEpochMilliseconds",
        "capabilities"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "owner",
            "maximumElapsedMilliseconds"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "maximumElapsedMilliseconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "deadlineEpochMilliseconds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "capabilities": {
          "type": "object"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "const": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
