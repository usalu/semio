{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:nx-worker-mapping-corpus:v1",
  "title": "Nx Worker Mapping Corpus",
  "description": "Language-agnostic cases for the Nx rendering of a resolved worker plan (literal plans) and for detecting batch-capable executors in an executors file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plans", "executors"],
  "properties": {
    "version": { "const": 1 },
    "plans": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "plan"], "properties": { "name": { "type": "string", "minLength": 1 }, "plan": { "type": "object" } } } },
    "executors": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "value", "expected"], "properties": { "name": { "type": "string", "minLength": 1 }, "value": {}, "expected": { "type": "boolean" } } } }
  }
}
