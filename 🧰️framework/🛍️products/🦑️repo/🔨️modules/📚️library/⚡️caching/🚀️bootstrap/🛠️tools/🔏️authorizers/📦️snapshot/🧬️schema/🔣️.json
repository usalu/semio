{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Captured Authorizer Source Bytes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifest",
    "digest",
    "files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "manifest": {
      "type": "object"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "base64"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "base64": {
            "type": "string",
            "maxLength": 5592408,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      }
    }
  },
  "$defs": {
    "EntryRole": {
      "enum": [
        "module",
        "program"
      ]
    },
    "EntryRoleCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "entryMain",
        "importedMain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "$ref": "#/$defs/EntryRole"
        },
        "entryMain": {
          "type": "boolean"
        },
        "importedMain": {
          "const": false
        }
      }
    }
  }
}
