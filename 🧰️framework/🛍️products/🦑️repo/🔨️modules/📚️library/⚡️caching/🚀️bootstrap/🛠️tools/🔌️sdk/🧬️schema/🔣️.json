{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nx SDK Port",
  "description": "Closed catalogue of the Nx SDK modules that repository code may load, and the only workspace roots that may name them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "modules", "adapterRoots", "scanned"],
  "properties": {
    "version": { "const": 1 },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(nx|@nx/devkit)(/[A-Za-z0-9._/-]+)?$" }
    },
    "adapterRoots": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scanned": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
