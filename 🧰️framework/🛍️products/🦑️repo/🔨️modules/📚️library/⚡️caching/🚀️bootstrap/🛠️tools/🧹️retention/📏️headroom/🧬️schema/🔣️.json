{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "availableBytes",
        "requiredBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "availableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    },
    "Recovery": {
      "const": {
        "maximumAttempts": 2,
        "maximumMaintenance": 1
      }
    }
  }
}
