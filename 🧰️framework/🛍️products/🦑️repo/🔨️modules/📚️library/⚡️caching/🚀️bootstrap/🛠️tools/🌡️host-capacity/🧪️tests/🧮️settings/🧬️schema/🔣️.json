{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:nx-host-resources-corpus:v1",
  "title": "Nx Host Resources Corpus",
  "description": "Language-agnostic cases for the Nx rendering of a host capacity grant: a plan in, the NX_PARALLEL value out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plans"],
  "properties": {
    "version": { "const": 1 },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "plan", "parallel"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "plan": { "type": "object", "additionalProperties": false, "required": ["version", "id", "jobs", "cpu", "memoryMegabytes", "fixedMegabytes", "floorMegabytes"], "properties": { "version": { "const": 1 }, "id": { "type": "string" }, "jobs": { "type": "integer", "minimum": 1, "maximum": 1024 }, "cpu": { "type": "integer", "minimum": 1 }, "memoryMegabytes": { "type": "integer", "minimum": 0 }, "fixedMegabytes": { "type": "integer", "minimum": 0 }, "floorMegabytes": { "type": "integer", "minimum": 0 } } },
          "parallel": { "type": "string", "pattern": "^[1-9][0-9]*$" }
        }
      }
    }
  }
}
