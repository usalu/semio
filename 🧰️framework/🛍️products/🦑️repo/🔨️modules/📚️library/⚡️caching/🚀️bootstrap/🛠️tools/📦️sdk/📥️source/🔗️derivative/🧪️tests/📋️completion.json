{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 12,
  "maxItems": 12,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "body",
      "cleanup",
      "expected"
    ],
    "properties": {
      "body": {
        "enum": [
          "value",
          "error",
          "undefined-error"
        ]
      },
      "cleanup": {
        "enum": [
          "none",
          "store",
          "index",
          "cancelled"
        ]
      },
      "expected": {
        "enum": [
          "value",
          "error",
          "undefined-error",
          "store",
          "index",
          "cancelled"
        ]
      }
    }
  }
}
