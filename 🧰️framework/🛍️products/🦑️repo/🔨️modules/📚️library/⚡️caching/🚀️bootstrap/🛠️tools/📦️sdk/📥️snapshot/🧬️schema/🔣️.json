{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.nx/SdkSnapshotCloneV1",
  "title": "SDK Snapshot Clone V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "files",
    "directories",
    "links",
    "bytes",
    "binaries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "integer",
      "minimum": 0
    },
    "directories": {
      "type": "integer",
      "minimum": 1
    },
    "links": {
      "type": "integer",
      "minimum": 0
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "binaries": {
      "type": "object",
      "required": [
        "version",
        "digest",
        "objects"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objects": {
          "type": "array",
          "maxItems": 256
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "Policy": {
      "const": {
        "concurrency": 64,
        "maximumEntries": 200000,
        "maximumPath": 256,
        "copyOnWrite": true,
        "sharedBinaryExtensions": [
          ".wasm",
          ".node"
        ]
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest",
        "patches",
        "binaries"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "patches": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "files"
            ],
            "properties": {
              "version": {
                "const": 1
              },
              "files": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "binaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "entry",
            "digest"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "entry": {
              "const": ".semio-nx-sdk-binaries.json"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "PatchPositionFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "before",
        "after",
        "patch",
        "accept"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "accept": {
          "type": "boolean"
        }
      }
    }
  }
}
