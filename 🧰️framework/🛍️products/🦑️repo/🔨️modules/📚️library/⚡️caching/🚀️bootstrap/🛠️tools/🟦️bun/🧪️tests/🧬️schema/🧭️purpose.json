{
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "purpose",
      "runtime",
      "version",
      "pin",
      "path"
    ],
    "properties": {
      "purpose": {
        "enum": [
          "runtime",
          "published"
        ]
      },
      "runtime": {
        "enum": [
          "bun",
          "node"
        ]
      },
      "version": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "pin": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "path": {
        "enum": [
          "runtime",
          "publication"
        ]
      }
    }
  }
}
