    "RuntimeDataDiscoveryPolicy": {
      "const": {
        "maximumDepth": 32,
        "maximumDirectories": 1024,
        "maximumEntries": 1024,
        "maximumResults": 1024,
        "maximumDeclaredBytes": 16777216
      }
    },
    "MemoPolicy": {
      "const": {
        "maximumFileBytes": 4194304,
        "concurrency": 24
      }
    },
    "RuntimeDataDiscoveryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "accepted",
        "maximumEnumerations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "enum": [
            "ordinary",
            "absent",
            "symlink",
            "overflow",
            "entries",
            "depth",
            "race",
            "kind",
            "literal-symlink",
            "bytes",
            "close-primary",
            "cancel",
            "close-mutation"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "maximumEnumerations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        }
      }
