{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.nx/AuthorizerSourcesV1",
  "title": "Nx Authorizer Sources V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "entry",
    "sources",
    "resolutions"
  ],
  "$defs": {
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "sourceSha256",
        "entry",
        "outputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "const": "release"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entry": {
          "const": "semio-authorizers.mjs"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "const": "semio-authorizers.mjs"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "CompilerPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "bun",
        "resolutions",
        "sources"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "const": "release"
        },
        "bun": {
          "type": "string",
          "pattern": "^bun@\\d+\\.\\d+\\.\\d+$"
        },
        "resolutions": {
          "$ref": "#/properties/resolutions"
        },
        "sources": {
          "$ref": "#/properties/sources"
        }
      }
    },
    "ReceiptFailureDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "directory",
        "reason",
        "authority",
        "publicationRetirementDispatches",
        "validation"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "unqualified-authorizer-receipt-data"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "enum": [
            "receipt-schema",
            "source-read",
            "source-json",
            "source-digest",
            "source-manifest",
            "manifest-entry",
            "manifest-order",
            "output-read",
            "output-digest"
          ]
        },
        "authority": {
          "const": false
        },
        "publicationRetirementDispatches": {
          "const": 0
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "sample"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "sample": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "ReceiptFailureCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fault",
        "accepted",
        "reason",
        "reads"
      ],
      "properties": {
        "fault": {
          "enum": [
            "none",
            "receipt-schema",
            "source-read",
            "source-json",
            "source-digest",
            "source-manifest",
            "manifest-entry",
            "manifest-order",
            "manifest-duplicate",
            "output-read",
            "output-digest"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "receipt-schema",
                "source-read",
                "source-json",
                "source-digest",
                "source-manifest",
                "manifest-entry",
                "manifest-order",
                "output-read",
                "output-digest"
              ]
            }
          ]
        },
        "reads": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "enum": [
              ".semio-authorizer-source.json",
              "semio-authorizers.mjs"
            ]
          }
        }
      }
    },
    "RetirementIntegrityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fault",
        "accepted"
      ],
      "properties": {
        "fault": {
          "enum": [
            "complete",
            "opaque-missing-resolution",
            "opaque-invalid-json",
            "opaque-foreign-path",
            "source-drift",
            "output-drift",
            "receipt-extra",
            "receipt-output-name",
            "receipt-version"
          ]
        },
        "accepted": {
          "type": "boolean"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "const": "release"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 256
    },
    "resolutions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "specifier",
          "path"
        ],
        "properties": {
          "specifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    }
  }
}
