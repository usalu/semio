    "RuntimeCompanionCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "excluded": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "owner",
        "path",
        "excluded"
      ]
    },
    "CommonJsCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "entry": {
          "type": "string"
        },
        "expectedFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "files",
        "entry",
        "expectedFiles"
      ]
    },
    "LoaderManifestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fault",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fault": {
          "enum": [
            "current-empty",
            "resolved",
            "shared-target",
            "source-limit",
            "resolution-limit",
            "legacy",
            "manifest-extra",
            "source-extra",
            "source-overlimit",
            "source-unsorted",
            "source-unsafe",
            "entry-missing",
            "resolution-missing",
            "resolution-not-array",
            "resolution-extra",
            "resolution-nonstring",
            "resolution-oversize",
            "resolution-unknownpath",
            "resolution-duplicate",
            "resolution-unsorted",
            "resolution-unsafe",
            "resolution-overlimit"
          ]
        },
        "accepted": {
          "type": "boolean"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "const": "release"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 1024
    },
    "resolutions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "specifier",
          "path"
        ],
        "properties": {
          "specifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    }
  }
}
