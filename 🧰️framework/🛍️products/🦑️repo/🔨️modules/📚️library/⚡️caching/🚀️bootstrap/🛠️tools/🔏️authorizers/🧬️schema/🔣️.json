          "paths": [
            "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📋️project.json"
          ]
        }
      ],
      "description": "Data files the capture cannot derive from literal relative paths or sibling schema folders: owner-relative reads assembled at run time. The closure law fails on a row the capture would derive anyway."
    },
    "OriginCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fault",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fault": {
          "enum": [
            "none",
            "schema-before",
            "schema-after",
            "undeclared",
            "global-spoof",
            "local-collision",
            "reader-before",
            "reader-after",
            "reader-after-cached",
            "reader-policy-before",
            "reader-policy-after"
          ]
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "RuntimeCompanionCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "excluded": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "owner",
        "path",
        "excluded"
      ]
    },
    "CommonJsCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "entry": {
          "type": "string"
        },
        "expectedFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "files",
        "entry",
        "expectedFiles"
      ]
    },
    "LoaderManifestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fault",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fault": {
          "enum": [
            "current-empty",
            "resolved",
            "shared-target",
            "source-limit",
            "resolution-limit",
            "legacy",
            "manifest-extra",
            "source-extra",
            "source-overlimit",
