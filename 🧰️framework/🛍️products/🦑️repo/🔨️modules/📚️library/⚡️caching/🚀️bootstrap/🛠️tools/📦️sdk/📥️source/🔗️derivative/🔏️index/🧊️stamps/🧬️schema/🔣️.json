{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The stamp memo of one sealed Nx SDK base: files whose bytes already hashed to their sealed digest, keyed by dev:ino:size:mtimeNs:mode. / Das Stempel-Memo einer versiegelten Nx-SDK-Basis: Dateien, deren Bytes bereits dem versiegelten Digest entsprachen. Ctime and link count are not part of the stamp, a new derivative generation hardlinks the files and changes both.",
  "definitions": {
    "Policy": {
      "const": {
        "directory": "sdk-verified",
        "environment": "SEMIO_NX_SDK_STAMPS_DIR",
        "disabled": "off",
        "disabledMarker": "off",
        "maximumAgeMilliseconds": 86400000,
        "maximumRows": 100000,
        "maximumBytes": 16777216
      }
    },
    "Memo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceIndex", "verifiedAt", "stamps"],
      "properties": {
        "version": { "const": 1 },
        "sourceIndex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verifiedAt": { "type": "integer", "minimum": 0 },
        "stamps": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9]+(:[0-9]+){4}$" }
        }
      }
    }
  }
}
