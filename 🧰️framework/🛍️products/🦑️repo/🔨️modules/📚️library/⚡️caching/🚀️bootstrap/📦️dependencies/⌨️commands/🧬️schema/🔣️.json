{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "Commands": {
      "const": [
        {
          "route": "sync",
          "export": "SyncScript",
          "mode": "sync"
        },
        {
          "route": "lock",
          "export": "RefreshLockScript",
          "mode": "lock"
        }
      ]
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "export",
        "mode",
        "production"
      ],
      "properties": {
        "route": {
          "type": "string",
          "minLength": 1
        },
        "export": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "production": {
          "type": "boolean"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/definitions/Case"
      }
    }
  }
}
