{
 "version": 1,
 "purpose": "dependency-generation-receipt-fixtures",
 "rules": {
  "opaque": [
   "🗑️generated",
   "🤖️generated",
   "node_modules",
   "target",
   "dist",
   "📤️dist",
   "build",
   "storybook-static",
   "temp",
   "coverage",
   "__pycache__",
   "🔌️plugin-modules",
   "compose"
  ],
  "opaquePatterns": [
   "^target(?:-[a-z0-9]+)*$"
  ],
  "walkRoots": [
   "pkgs"
  ]
 },
 "workspace": {
  "files": {
   "package.json": "{\"name\": \"fixture-root\", \"version\": \"0.0.0\", \"semio\": {\"workspace\": {\"schemaVersion\": 1, \"members\": [\"pkgs/*\"], \"owners\": []}}, \"workspaces\": [\"pkgs/a\", \"pkgs/b\", \"pkgs/🧩️widget\"]}",
   "bun.lock": "{\"lockfileVersion\":1,\"workspaces\":{},\"packages\":{}}",
   "pkgs/a/package.json": "{\"name\":\"a\",\"version\":\"1.0.0\",\"dependencies\":{\"dep\":\"^1.0.0\"}}",
   "pkgs/a/src/index.ts": "export const a=1;\n",
   "pkgs/b/package.json": "{\"name\":\"b\",\"version\":\"1.0.0\"}",
   "pkgs/🧩️widget/package.json": "{\"name\":\"widget\",\"version\":\"1.0.0\"}",
   "pkgs/🧩️widget/src/widget.ts": "export {};\n",
   "store/j/g1/bindings.json": "{\"ready\":true}\n",
   "store/j/g1/node_modules/dep/package.json": "{\"name\":\"dep\",\"version\":\"1.2.3\"}",
   "store/j/g1/node_modules/dep/index.js": "module.exports=1;\n",
   "store/j/g2/node_modules/other/package.json": "{\"name\":\"other\",\"version\":\"1.0.0\"}",
   "impl/entry.ts": "import {createRequire} from \"node:module\";\nimport {fence} from \"./deep/fence.ts\";\nimport rules from \"./rules.json\" with {type:\"json\"};\nexport const limit=createRequire(import.meta.url)(\"./limit.cjs\");\nexport const run=()=>fence(rules);\n",
   "impl/deep/fence.ts": "export const fence=(rules:unknown)=>rules;\nexport const later=()=>import(\"./later.ts\");\n",
   "impl/deep/later.ts": "export const later=1;\n",
   "impl/limit.cjs": "module.exports=Object.freeze({maximum:4});\n",
   "impl/rules.json": "{\"limit\":4}\n",
   "impl/🧬️schema/🔣️.json": "{\"type\":\"object\"}\n",
   "impl/unrelated.ts": "export const unrelated=true;\n"
  },
  "links": {
   "pkgs/a/node_modules": "@STORE@/j/g1/node_modules",
   "pkgs/b/node_modules": "@STORE@/j/g2/node_modules",
   "store/j/g1/node_modules/dep-link": "../../g2/node_modules/other"
  },
  "missing": [
   "node_modules",
   "bunfig.toml"
  ],
  "observed": {
   "full": [
    "store/j/g1/node_modules/dep/package.json"
   ],
   "anchors": [
    "store/j/g1/node_modules/dep",
    "store/j/g1/node_modules",
    "store/j/g2/node_modules/other",
    "store/j/g1"
   ],
   "links": [
    "store/j/g1/node_modules/dep-link"
   ],
   "missing": [
    "node_modules",
    "pkgs/node_modules"
   ]
  },
  "required": [
   "."
  ]
 },
 "progress": {
  "directories": 4200
 },
