{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Inert retained generation metadata for conservative maintenance planning. No current readiness, install reuse or retirement authority is conferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "purpose",
    "authority",
    "currentReady",
    "generation",
    "prefix",
    "scope",
    "recipeSha256",
    "receiptSha256",
    "members",
    "sourceBindings",
    "ownerReferences"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "purpose": {
      "const": "retained-dependency-generation-data"
    },
    "authority": {
      "const": false
    },
    "currentReady": {
      "const": false
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prefix": {
      "type": "string",
      "pattern": "^[a-f0-9]{20}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recipeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "members": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "sourceBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceDirectory",
          "targetDirectory"
        ],
        "properties": {
          "sourceDirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "targetDirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "ownerReferences": {
      "type": "array",
      "maxItems": 63,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "generation"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "generation": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
