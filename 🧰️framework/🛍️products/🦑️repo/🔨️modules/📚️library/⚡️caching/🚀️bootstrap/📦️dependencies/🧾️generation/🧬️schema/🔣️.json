{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "semio:dependencies/generation-receipt/v1",
 "title": "Dependency generation receipt",
 "description": "Schema-first contract of the content-addressed receipt that lets ordinary commands prove an unchanged dependency generation by stat and bounded reads, falling back to the complete ownership and provider walk on any mismatch.",
 "$defs": {
  "Protocol": {
   "const": {
    "version": 1,
    "purpose": "dependency-generation-receipt",
    "directory": "generation",
    "receiptSuffix": ".receipt.json",
    "frontierSuffix": ".frontier.ndjson",
    "executionSuffix": ".execution.ndjson",
    "maximumReceiptBytes": 4194304,
    "maximumEvidenceBytes": 134217728,
    "maximumRows": 524288,
    "maximumSourceFileBytes": 8388608,
    "maximumRelist": 4096,
    "settleMilliseconds": 5000,
    "checkWork": 256,
    "progressWork": 4096,
    "stampFields": [
     "dev",
     "ino",
     "mode",
     "nlink",
     "size",
     "mtimeNs",
     "ctimeNs"
    ],
    "anchorFields": [
     "dev",
     "ino",
     "mode"
    ],
    "projectionDigestUnits": 32,
    "implementation": {
     "entries": [
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🚀️bootstrap/📦️dependencies/💾️storage/🟦️.ts",
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🚀️bootstrap/📦️dependencies/🧾️generation/💾️storage/🟦️.ts",
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🚀️bootstrap/📦️dependencies/🧾️generation/🟦️.ts",
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🚀️bootstrap/🟦️.ts",
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🗂️workspaces/🟦️bun/🟦️.ts",
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🗂️workspaces/🟦️bun/🟨️.cjs"
     ],
     "extraFiles": [],
     "closureSuffix": ".closure.ndjson",
     "maximumFiles": 2048,
     "reader": "captureBuildSourceClosureV1"
    },
    "producer": {
     "scopeFiles": [
      ".npmrc"
     ],
     "ambientHomeFiles": [
      ".npmrc",
      ".bunfig.toml"
     ],
     "ambientConfigFiles": [
      ".bunfig.toml"
     ],
     "ambientConfigFallback": ".config",
     "storeRoleFiles": {
      "bun-home": [
       ".npmrc",
       ".bunfig.toml"
      ],
      "bun-config": [
       ".bunfig.toml"
      ]
     },
     "maximumFileBytes": 1048576,
     "environmentPrefixes": [
      "BUN_",
      "NPM_CONFIG_"
     ],
     "environmentNames": [
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "ALL_PROXY",
      "NO_PROXY",
      "NODE_EXTRA_CA_CERTS",
      "NODE_TLS_REJECT_UNAUTHORIZED",
      "SSL_CERT_FILE",
      "SSL_CERT_DIR"
     ],
     "environmentIgnored": [
      "NPM_CONFIG_USER_AGENT",
      "BUN_INSPECT",
      "BUN_INSPECT_CONNECT_TO",
      "BUN_INSPECT_NOTIFY"
     ]
    },
    "mismatchClasses": [
     "receipt-invalid",
     "evidence-invalid",
     "implementation-changed",
     "runtime-changed",
     "configuration-changed",
     "conditions-open",
     "binding-changed",
     "ready-changed",
     "input-changed",
     "manifest-changed",
     "membership-changed",
     "membership-churn",
     "provider-changed",
     "unreadable",
     "sha-changed"
    ],
    "tiers": [
     {
      "name": "implementation",
      "cost": "O(closure files)",
      "covers": "every file of the runtime import closure of the walk and fence entries, their module-owned schemas and literal assets, by content digest"
     },
     {
      "name": "runtime",
      "cost": "O(1)",
      "covers": "bun version and revision, node version, platform, architecture, installer recipe"
     },
     {
      "name": "producer",
      "cost": "O(config files)",
      "covers": "npmrc and bunfig files every installer level could read, and the environment variables that select registries, caches or transport"
     },
     {
      "name": "bindings",
      "cost": "O(bindings)",
      "covers": "Source endpoint links, physical generation ancestry, ready receipts"
     },
     {
      "name": "inputs",
      "cost": "O(manifests)",
      "covers": "manifests, locks, configuration, patches and their ancestry"
     },
     {
      "name": "membership",
      "cost": "O(directories)",
      "covers": "workspace topology by directory stamps with projection-digest relisting"
     },
     {
      "name": "execution",
      "cost": "O(observations)",
      "covers": "provider resolution by replaying every recorded physical observation"
     }
    ]
   }
  },
  "Sha256": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "Location": {
   "type": "string",
   "pattern": "^[wsa]:.+$",
   "maxLength": 2048
  },
  "Scope": {
   "type": "string",
   "minLength": 1,
   "maxLength": 256
  },
  "MismatchClass": {
   "enum": [
    "receipt-invalid",
    "evidence-invalid",
    "implementation-changed",
    "runtime-changed",
    "configuration-changed",
    "conditions-open",
    "binding-changed",
    "ready-changed",
    "input-changed",
    "manifest-changed",
    "membership-changed",
    "membership-churn",
    "provider-changed",
    "unreadable",
    "sha-changed"
   ]
  },
  "Evidence": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "sha256",
    "bytes",
    "rows"
   ],
   "properties": {
    "name": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}\\.(frontier|execution|closure)\\.ndjson$"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
     "type": "integer",
     "minimum": 0
    },
    "rows": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "Runtime": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "bun",
    "revision",
    "node",
    "platform",
    "arch",
    "sha256"
   ],
   "properties": {
    "bun": {
     "type": "string"
    },
    "revision": {
     "type": "string"
    },
    "node": {
     "type": "string"
    },
    "platform": {
     "type": "string"
    },
    "arch": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  },
  "Source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "kind",
    "dev",
    "ino",
    "mode",
    "sha256"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/Location"
    },
    "kind": {
     "enum": [
      "file",
      "directory",
      "missing"
     ]
    },
    "dev": {
     "type": "string"
    },
    "ino": {
     "type": "string"
    },
    "mode": {
     "type": "integer",
     "minimum": 0
    },
    "sha256": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "Implementation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "entries",
    "evidence"
   ],
   "properties": {
    "entries": {
     "type": "array",
     "minItems": 1,
     "maxItems": 64,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
     }
    },
    "evidence": {
     "$ref": "#/$defs/Evidence"
    }
   }
  },
  "ProducerFile": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "kind",
    "bytes",
    "sha256"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/Location"
    },
    "kind": {
     "enum": [
      "missing",
      "file",
      "other"
     ]
    },
    "bytes": {
     "type": "integer",
     "minimum": 0
    },
    "sha256": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "ProducerVariable": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "sha256"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  },
  "Producer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "files",
    "environment"
   ],
   "properties": {
    "files": {
     "type": "array",
     "maxItems": 4096,
     "items": {
      "$ref": "#/$defs/ProducerFile"
     }
    },
    "environment": {
     "type": "array",
     "maxItems": 512,
     "items": {
      "$ref": "#/$defs/ProducerVariable"
     }
    }
   }
  },
  "Input": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scope",
    "sources"
   ],
   "properties": {
    "scope": {
     "$ref": "#/$defs/Scope"
    },
    "sources": {
     "type": "array",
     "maxItems": 65536,
     "items": {
      "$ref": "#/$defs/Source"
     }
    }
   }
  },
  "Text": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string",
     "minLength": 1,
     "maxLength": 2048
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  },
  "Binding": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scope",
    "pairs",
    "observationSha256"
   ],
   "properties": {
    "scope": {
     "$ref": "#/$defs/Scope"
    },
    "pairs": {
     "type": "array",
     "maxItems": 4096,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "source",
       "target"
      ],
      "properties": {
       "source": {
        "$ref": "#/$defs/Location"
       },
       "target": {
        "$ref": "#/$defs/Location"
       }
      }
     }
    },
    "observationSha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  },
  "Ready": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scope",
    "generation",
    "location",
    "fingerprint"
   ],
   "properties": {
    "scope": {
     "$ref": "#/$defs/Scope"
    },
    "generation": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "location": {
     "$ref": "#/$defs/Location"
    },
    "fingerprint": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    }
   }
  },
  "Receipt": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "purpose",
    "scope",
    "implementation",
    "runtime",
    "producer",
    "recipeSha256",
    "ownershipSha256",
    "required",
    "inputs",
    "membership",
    "bindings",
    "ready",
    "execution",
    "scopeReadSha256",
    "sha256"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "purpose": {
     "const": "dependency-generation-receipt"
    },
    "scope": {
     "$ref": "#/$defs/Scope"
    },
    "implementation": {
     "$ref": "#/$defs/Implementation"
    },
    "runtime": {
     "$ref": "#/$defs/Runtime"
    },
    "producer": {
     "$ref": "#/$defs/Producer"
    },
    "recipeSha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "ownershipSha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "required": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4096,
     "items": {
      "$ref": "#/$defs/Scope"
     }
    },
    "inputs": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4096,
     "items": {
      "$ref": "#/$defs/Input"
     }
    },
    "membership": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "frontier",
      "texts"
     ],
     "properties": {
      "frontier": {
       "$ref": "#/$defs/Evidence"
      },
      "texts": {
       "type": "array",
       "maxItems": 65536,
       "items": {
        "$ref": "#/$defs/Text"
       }
      }
     }
    },
    "bindings": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4096,
     "items": {
      "$ref": "#/$defs/Binding"
     }
    },
    "ready": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4096,
     "items": {
      "$ref": "#/$defs/Ready"
     }
    },
    "execution": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "evidence",
      "scopes",
      "runtimeSha256"
     ],
     "properties": {
      "evidence": {
       "$ref": "#/$defs/Evidence"
      },
      "scopes": {
       "type": "array",
       "maxItems": 4096,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "scope",
         "sha256"
        ],
        "properties": {
         "scope": {
          "$ref": "#/$defs/Scope"
         },
         "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
         }
        }
       }
      },
      "runtimeSha256": {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      }
     }
    },
    "scopeReadSha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  },
  "FrontierRows": {
   "description": "Newline-delimited JSON arrays. Directory row: [\"d\",path,dev,ino,mode,mtimeNs,ctimeNs,settled,projectionDigest]. State row: [\"s\",path,kind,dev,ino,mode] or [\"s\",path,\"missing\"]. Paths are posix relative to the workspace.",
   "type": "array"
  },
  "ClosureRows": {
   "description": "Newline-delimited JSON arrays, one per file of the runtime import closure sorted by UTF-8 path bytes: [\"f\",path,sha256,bytes]. Paths are posix relative to the repository root.",
   "type": "array"
  },
  "ExecutionRows": {
   "description": "Newline-delimited JSON arrays: [\"o\",location,kind,anchor,stamp,target,full] with kind one of l,d,f,x,m and anchor/stamp as colon-joined decimal fields or null.",
   "type": "array"
  }
 }
}
