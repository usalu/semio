{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifest", "frozen"],
      "properties": {
        "kind": {"enum": ["invalid-lockfile", "workspace-missing", "workspace-stale", "identity-mismatch", "missing-in-lock", "stale-in-lock", "version-mismatch"]},
        "manifest": {"type": "string", "minLength": 1},
        "section": {"type": "string"},
        "dependency": {"type": "string"},
        "manifestVersion": {"type": "string"},
        "lockVersion": {"type": "string"},
        "frozen": {"type": "boolean"}
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lock", "manifests", "expected", "bun"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "lock": {"type": "string"},
        "manifests": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "string", "minLength": 1}, {"type": "object"}]}},
        "expected": {"type": "array", "items": {"$ref": "#/$defs/Drift"}},
        "bun": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["refused", "network"], "properties": {"refused": {"type": "boolean"}, "network": {"type": "boolean"}}}
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bun", "cases"],
  "properties": {
    "version": {"const": 1},
    "bun": {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Case"}}
  }
}
