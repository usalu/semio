{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "effect",
      "target",
      "endpoint",
      "full"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "effect": {
        "enum": [
          "none",
          "retarget",
          "remove",
          "replace-with-directory",
          "touch-link",
          "rename-link",
          "replace-directory",
          "add-sibling",
          "swap-for-link",
          "touch-directory"
        ]
      },
      "target": {
        "enum": [
          "none",
          "e0",
          "e1",
          "e2",
          "p0",
          "p1",
          "g",
          "root"
        ]
      },
      "endpoint": {
        "type": "boolean"
      },
      "full": {
        "type": "boolean"
      }
    }
  },
  "cases": [
    {
      "id": "untouched",
      "effect": "none",
      "target": "none",
      "endpoint": true,
      "full": true
    },
    {
      "id": "fenced-endpoint-retargeted",
      "effect": "retarget",
      "target": "e0",
      "endpoint": false,
      "full": false
    },
    {
      "id": "fenced-endpoint-removed",
      "effect": "remove",
      "target": "e0",
      "endpoint": false,
      "full": false
    },
    {
      "id": "fenced-endpoint-becomes-directory",
      "effect": "replace-with-directory",
      "target": "e0",
      "endpoint": false,
      "full": false
    },
    {
      "id": "fenced-endpoint-renamed",
      "effect": "rename-link",
      "target": "e0",
      "endpoint": true,
      "full": true
    },
    {
      "id": "fenced-endpoint-touched",
      "effect": "touch-link",
      "target": "e0",
      "endpoint": false,
      "full": false
    },
    {
      "id": "fenced-parent-replaced",
      "effect": "replace-directory",
      "target": "p0",
      "endpoint": false,
      "full": false
    },
    {
      "id": "fenced-parent-gains-sibling",
      "effect": "add-sibling",
      "target": "p0",
      "endpoint": true,
      "full": true
    },
    {
      "id": "ancestor-swapped-for-link",
      "effect": "swap-for-link",
      "target": "g",
      "endpoint": false,
      "full": false
    },
    {
      "id": "root-touched",
      "effect": "touch-directory",
      "target": "root",
      "endpoint": true,
      "full": true
    },
    {
      "id": "other-endpoint-retargeted",
      "effect": "retarget",
      "target": "e1",
      "endpoint": true,
      "full": false
    },
    {
      "id": "other-endpoint-removed",
      "effect": "remove",
      "target": "e2",
      "endpoint": true,
      "full": false
    },
    {
      "id": "other-endpoint-touched",
      "effect": "touch-link",
      "target": "e2",
      "endpoint": true,
      "full": false
    },
    {
      "id": "other-parent-replaced",
      "effect": "replace-directory",
      "target": "p1",
      "endpoint": true,
      "full": false
    }
  ],
  "compareSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
