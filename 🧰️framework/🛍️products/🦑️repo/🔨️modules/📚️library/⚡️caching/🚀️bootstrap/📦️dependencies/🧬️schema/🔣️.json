{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.repo.bootstrap.javascript-dependencies/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operations",
    "platforms",
    "rejections"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "operations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "arguments"
        ],
        "properties": {
          "mode": {
            "enum": [
              "sync",
              "lock"
            ]
          },
          "arguments": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "sync"
                }
              }
            },
            "then": {
              "properties": {
                "arguments": {
                  "const": [
                    "install",
                    "--frozen-lockfile"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "arguments": {
                  "const": [
                    "install",
                    "--lockfile-only"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "platforms": {
      "const": [
        "linux",
        "darwin",
        "win32"
      ]
    },
    "rejections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  }
}
