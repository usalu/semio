{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "accepted",
    "bodies"
  ],
  "properties": {
    "mode": {
      "enum": [
        "valid",
        "empty",
        "absent-pin",
        "historical-alias",
        "unknown-alias",
        "unknown-graph",
        "referenced-obsolete",
        "unqualified",
        "alias-drift",
        "metadata-drift",
        "release-error",
        "frozen-primary",
        "present-prefix-target",
        "absent-reference-pin",
        "absent-target-drift"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "bodies": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  }
}
