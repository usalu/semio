{
  "version": 1,
  "operations": [
    {
      "mode": "sync",
      "arguments": [
        "install",
        "--frozen-lockfile"
      ]
    },
    {
      "mode": "lock",
      "arguments": [
        "install",
        "--lockfile-only"
      ]
    }
  ],
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "rejections": [
    [
      "--ignore-scripts"
    ],
    [
      "--production"
    ],
    [
      "--frozen-lockfile"
    ]
  ],
  "watcherSelections": [
    {
      "SEMIO_LOCKED_LOCALE": "en",
      "SEMIO_LOCKED_TERMINOLOGY": "native"
    },
    {
      "SEMIO_LOCKED_LOCALE": "en",
      "SEMIO_LOCKED_TERMINOLOGY": "reuse"
    },
    {
      "SEMIO_LOCKED_LOCALE": "de",
      "SEMIO_LOCKED_TERMINOLOGY": "native"
    },
    {
      "SEMIO_LOCKED_LOCALE": "de",
      "SEMIO_LOCKED_TERMINOLOGY": "reuse"
    }
  ]
}
