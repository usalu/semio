{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "members",
    "generation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\:*?\\u0000][^\\\\:*?\\u0000]*$"
    },
    "members": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\:*?\\u0000][^\\\\:*?\\u0000]*$",
        "not": {"const":"."}
      }
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
