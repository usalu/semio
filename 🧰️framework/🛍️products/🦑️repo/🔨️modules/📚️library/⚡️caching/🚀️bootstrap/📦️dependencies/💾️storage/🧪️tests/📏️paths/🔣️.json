{
 "schema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "event",
   "mutation",
   "accepted"
  ],
  "properties": {
   "id": {
    "type": "string",
    "minLength": 1
   },
   "event": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "path"
    ],
    "properties": {
     "kind": {
      "enum": [
       "none",
       "listed",
       "leaf-checked"
      ]
     },
     "path": {
      "type": "string"
     }
    }
   },
   "mutation": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "effect",
     "path"
    ],
    "properties": {
     "effect": {
      "enum": [
       "none",
       "add-file",
       "remove-entry",
       "replace-directory",
       "file-to-link",
       "touch",
       "chmod",
       "append"
      ]
     },
     "path": {
      "type": "string"
     }
    }
   },
   "accepted": {
    "type": "boolean"
   }
  }
 },
 "trees": {
  "nested": [
   {
    "path": "a",
    "kind": "directory"
   },
   {
    "path": "a/b",
    "kind": "directory"
   },
   {
    "path": "a/b/f",
    "kind": "file"
   },
   {
    "path": "a/b/g",
    "kind": "link",
    "target": "f"
   },
   {
    "path": "a/h",
    "kind": "file"
   },
   {
    "path": "c",
    "kind": "file"
   }
  ]
 },
 "cases": [
  {
   "id": "untouched",
   "event": {
    "kind": "none",
    "path": ""
   },
   "mutation": {
    "effect": "none",
    "path": ""
   },
   "accepted": true
  },
  {
   "id": "root-gains-file-while-below",
   "event": {
    "kind": "listed",
    "path": "a/b"
   },
   "mutation": {
    "effect": "add-file",
    "path": "."
   },
   "accepted": false
  },
  {
   "id": "directory-gains-file-after-listing",
   "event": {
    "kind": "listed",
    "path": "a"
   },
   "mutation": {
    "effect": "add-file",
    "path": "a"
   },
   "accepted": false
  },
  {
   "id": "ancestor-loses-entry-while-below",
   "event": {
    "kind": "listed",
    "path": "a/b"
   },
   "mutation": {
    "effect": "remove-entry",
    "path": "a/h"
   },
   "accepted": false
  },
  {
   "id": "directory-replaced-after-listing",
   "event": {
    "kind": "listed",
    "path": "a/b"
   },
   "mutation": {
    "effect": "replace-directory",
    "path": "a/b"
   },
   "accepted": false
  },
  {
   "id": "ancestor-replaced-while-below",
   "event": {
    "kind": "listed",
    "path": "a/b"
   },
   "mutation": {
    "effect": "replace-directory",
    "path": "a"
   },
   "accepted": false
  },
  {
   "id": "file-becomes-link-before-visit",
   "event": {
    "kind": "listed",
    "path": "a/b"
   },
   "mutation": {
    "effect": "file-to-link",
    "path": "a/h"
   },
   "accepted": false
  },
  {
   "id": "ancestor-touched-while-below",
   "event": {
    "kind": "listed",
    "path": "a/b"
   },
   "mutation": {
    "effect": "touch",
    "path": "a"
   },
   "accepted": false
  },
  {
   "id": "ancestor-mode-changed-while-below",
   "event": {
    "kind": "listed",
    "path": "a/b"
   },
   "mutation": {
    "effect": "chmod",
    "path": "a"
   },
   "accepted": false
  },
  {
   "id": "root-gains-file-before-close",
   "event": {
    "kind": "leaf-checked",
    "path": "c"
   },
   "mutation": {
    "effect": "add-file",
    "path": "."
   },
   "accepted": false
  },
  {
   "id": "directory-gains-file-before-close",
   "event": {
    "kind": "leaf-checked",
    "path": "a/h"
   },
   "mutation": {
    "effect": "add-file",
    "path": "a"
   },
   "accepted": false
  },
  {
   "id": "file-changes-during-self-check",
   "event": {
    "kind": "leaf-checked",
    "path": "a/h"
   },
   "mutation": {
    "effect": "append",
    "path": "a/h"
   },
   "accepted": false
  },
  {
   "id": "closed-directory-changes-below-parent",
   "event": {
    "kind": "leaf-checked",
    "path": "a/h"
   },
   "mutation": {
    "effect": "add-file",
    "path": "a/b"
   },
   "accepted": true
  }
 ]
}