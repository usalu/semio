{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generation", "bindings"],
  "properties": {
    "version": {"const": 1},
    "generation": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceDirectory", "targetDirectory"],
        "properties": {
          "sourceDirectory": {"type": "string", "minLength": 1, "maxLength": 256},
          "targetDirectory": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
}
