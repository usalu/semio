{
  "version": 1,
  "order": [
    "apt-get",
    "dnf",
    "pacman",
    "zypper"
  ],
  "packages": [
    {
      "manager": "dnf",
      "arguments": [
        "install",
        "-y"
      ],
      "packages": [
        "nss",
        "nspr",
        "atk",
        "at-spi2-atk",
        "cups-libs",
        "libdrm",
        "libxkbcommon",
        "libXcomposite",
        "libXdamage",
        "libXfixes",
        "libXrandr",
        "mesa-libgbm",
        "alsa-lib",
        "libX11",
        "libxcb",
        "libXext",
        "dbus-libs",
        "expat",
        "glib2",
        "xorg-x11-server-Xvfb"
      ]
    },
    {
      "manager": "pacman",
      "arguments": [
        "-Sy",
        "--needed",
        "--noconfirm"
      ],
      "packages": [
        "nss",
        "nspr",
        "at-spi2-core",
        "libcups",
        "libdrm",
        "libxkbcommon",
        "libxcomposite",
        "libxdamage",
        "libxfixes",
        "libxrandr",
        "mesa",
        "alsa-lib",
        "libx11",
        "libxcb",
        "libxext",
        "dbus",
        "expat",
        "glib2",
        "xorg-server-xvfb"
      ]
    },
    {
      "manager": "zypper",
      "arguments": [
        "--non-interactive",
        "install",
        "--no-recommends"
      ],
      "packages": [
        "mozilla-nss",
        "mozilla-nspr",
        "libatk-1_0-0",
        "libatk-bridge-2_0-0",
        "libcups2",
        "libdrm2",
        "libxkbcommon0",
        "libXcomposite1",
        "libXdamage1",
        "libXfixes3",
        "libXrandr2",
        "libgbm1",
        "libasound2",
        "libX11-6",
        "libxcb1",
        "libXext6",
        "libdbus-1-3",
        "libexpat1",
        "libglib-2_0-0",
        "xvfb-run",
        "xorg-x11-server-Xvfb"
      ]
    }
  ]
}
