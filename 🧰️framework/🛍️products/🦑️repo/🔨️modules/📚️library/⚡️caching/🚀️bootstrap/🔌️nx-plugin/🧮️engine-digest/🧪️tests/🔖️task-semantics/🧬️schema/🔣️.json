{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "semio:build:nx-engine-task-semantics-history:v1",
 "title": "Nx Engine Task Semantics History",
 "description": "One row per declared task semantics revision: the sha256 of the owner argument wire of the fixture cases at that revision. The law fails when the wire changes without a new row.",
 "type": "object",
 "additionalProperties": false,
 "required": ["version", "history"],
 "properties": {
  "version": {"const": 1},
  "history": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["revision", "outputs", "reason"],
    "properties": {
     "revision": {"type": "integer", "minimum": 1},
     "outputs": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
     "reason": {"type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": {"en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}}}
    }
   }
  }
 }
}
