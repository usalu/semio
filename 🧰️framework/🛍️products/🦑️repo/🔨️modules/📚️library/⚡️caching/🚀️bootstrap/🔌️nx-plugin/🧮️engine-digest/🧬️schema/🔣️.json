{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "semio:build:nx-engine-task-semantics:v2",
 "title": "Nx Engine Task Semantics",
 "description": "What the Nx engine digest that enters every Nx task hash covers: one declared task semantics revision, the exact surface files of the private executors (generic family) and the directory prefixes that build Cargo arguments (native family only). Nothing else is in a task hash: a file outside this surface never moves one. `spawnOnly` lists file references the engine closure does not follow.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "semantics",
  "spawnOnly"
 ],
 "properties": {
  "version": {
   "const": 2
  },
  "semantics": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "revision",
    "contract",
    "surface",
    "nativeSurface",
    "excludedSegments"
   ],
   "properties": {
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "contract": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "en",
      "de"
     ],
     "properties": {
      "en": {
       "type": "string",
       "minLength": 1,
       "maxLength": 1200
      },
      "de": {
       "type": "string",
       "minLength": 1,
       "maxLength": 1200
      }
     }
    },
    "surface": {
     "type": "array",
     "minItems": 1,
     "maxItems": 64,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^/\\\\.][^\\\\]*$"
     }
    },
    "nativeSurface": {
     "type": "array",
     "minItems": 1,
     "maxItems": 128,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300,
      "pattern": "/$"
     }
    },
    "excludedSegments": {
     "type": "array",
     "maxItems": 8,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     }
    }
   }
  },
  "spawnOnly": {
   "description": "File references a module only uses to START a program (a maintenance child), not to load its code: the engine closure does not follow them, so the program and everything only it reaches stay out of every Nx task key. Each names the referencing module and the reference exactly as written.",
   "type": "array",
   "maxItems": 32,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "owner",
     "reference",
     "contract"
    ],
    "properties": {
     "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "reference": {
      "type": "string",
      "pattern": "^\\.",
      "minLength": 2,
      "maxLength": 200
     },
     "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "en",
       "de"
      ],
      "properties": {
       "en": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
       },
       "de": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
       }
      }
     }
    }
   }
  }
 }
}
