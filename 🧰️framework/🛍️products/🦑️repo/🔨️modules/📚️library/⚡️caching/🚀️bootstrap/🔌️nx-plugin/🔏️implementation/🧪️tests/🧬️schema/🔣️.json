{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/nx/private-dependency-source-handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "changes",
          "environment",
          "readmitted",
          "identityCalls",
          "guardAccepted"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "environment": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "readmitted": {
            "type": "boolean"
          },
          "identityCalls": {
            "type": "integer",
            "minimum": 0
          },
          "guardAccepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
