{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nx Owner Argument Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "arguments",
    "carrierPresent"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "carrierPresent": {
      "type": "boolean"
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "prefix": "ownerArgumentReceipt="
      }
    }
  }
}
