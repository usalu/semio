{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "wire",
    "cases",
    "walk"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "policy",
        "deadlineEpochMilliseconds",
        "capabilities"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "owner",
            "maximumElapsedMilliseconds"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "maximumElapsedMilliseconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "deadlineEpochMilliseconds": {
          "type": "integer"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "original",
            "selection"
          ],
          "properties": {
            "original": {
              "type": "string",
              "minLength": 1
            },
            "selection": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "now",
          "policy",
          "capabilities",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "now": {
            "type": "integer"
          },
          "policy": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "owner",
                  "maximumElapsedMilliseconds"
                ],
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maximumElapsedMilliseconds": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "capabilities": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "original",
                  "selection"
                ],
                "properties": {
                  "original": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selection": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "expected": {
            "enum": [
              "accept",
              "policy",
              "capabilities",
              "deadline"
            ]
          }
        }
      }
    },
    "walk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "counts"
      ],
      "properties": {
        "concurrency": {
          "const": 3
        },
        "counts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
