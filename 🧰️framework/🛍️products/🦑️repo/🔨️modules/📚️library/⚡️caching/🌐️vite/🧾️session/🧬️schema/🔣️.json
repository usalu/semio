{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/library/caching/vite/session/schema.json",
  "$ref": "#/$defs/Session",
  "$defs": {
    "MutationLease": { "const": { "directory": ".leases", "resource": "sessions" } },
    "ReadinessRace": { "const": ["request", "replace-session", "respond", "reject-stale-session"] },
    "ReadinessBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "readyTimeoutMs", "progressIntervalMs", "evidence"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "readyTimeoutMs": { "type": "integer", "minimum": 60000, "maximum": 3600000 },
        "progressIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "coldBootMs", "warmBootMs", "marginFactor", "source"],
          "properties": {
            "kind": { "enum": ["estimate", "measurement"] },
            "coldBootMs": { "$ref": "#/$defs/BootRange" },
            "warmBootMs": { "$ref": "#/$defs/BootRange" },
            "marginFactor": { "type": "number", "minimum": 2, "maximum": 20 },
            "source": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "BootRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "owner",
        "pid"
      ],
      "properties": {
        "schema": {
          "const": "semio.nx.service/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "Ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "session",
        "url"
      ],
      "properties": {
        "schema": {
          "const": "semio.nx.service-ready/v1"
        },
        "session": {
          "$ref": "#/$defs/Session"
        },
        "url": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}/$"
        }
      }
    }
  }
}
