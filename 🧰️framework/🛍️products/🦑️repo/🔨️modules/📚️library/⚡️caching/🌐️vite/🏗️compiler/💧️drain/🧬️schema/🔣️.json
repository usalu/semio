{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "processing",
          "expected"
        ],
        "properties": {
          "operation": {
            "enum": [
              "value",
              "error",
              "undefined"
            ]
          },
          "processing": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "enum": [
                "value",
                "error",
                "undefined"
              ]
            }
          },
          "expected": {
            "enum": [
              "value",
              "error",
              "undefined"
            ]
          }
        }
      }
    }
  }
}
