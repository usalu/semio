{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/library/caching/vite/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server",
    "hmr",
    "storage"
  ],
  "properties": {
    "hmr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientPath",
        "protocol",
        "connected",
        "update",
        "changedFile",
        "contents"
      ],
      "properties": {
        "clientPath": {
          "const": "/@vite/client"
        },
        "protocol": {
          "const": "vite-hmr"
        },
        "connected": {
          "const": "connected"
        },
        "update": {
          "const": "full-reload"
        },
        "changedFile": {
          "const": "index.html"
        },
        "contents": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "path",
        "expected"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "modules",
        "config",
        "optimizer"
      ],
      "properties": {
        "package": {
          "const": {
            "private": true,
            "type": "module"
          }
        },
        "modules": {
          "const": "node_modules"
        },
        "config": {
          "const": "node_modules/.vite-temp"
        },
        "optimizer": {
          "const": "node_modules/.vite"
        }
      }
    }
  }
}
