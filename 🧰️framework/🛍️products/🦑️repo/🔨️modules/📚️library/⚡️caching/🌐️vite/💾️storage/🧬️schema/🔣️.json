{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "owner"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "root": "vite",
        "maximumOutputBytes": 1073741824,
        "maximumOutputFiles": 65536,
        "writerShards": 16,
        "maximumPendingTransforms": 32
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "owner",
        "files"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "files": {
          "type": "array",
          "maxItems": 65536,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
          }
        }
      }
    }
  }
}
