{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "endpoint",
      "secret"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9:-]*$"
      },
      "endpoint": {
        "type": "string",
        "maxLength": 256,
        "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/(?:[A-Za-z0-9_-]+)(?:/[A-Za-z0-9_-]+)*$"
      },
      "secret": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumBytes": 16384,
        "environment": "SEMIO_VITE_RUNTIME_CHANNELS_V1"
      }
    }
  }
}
