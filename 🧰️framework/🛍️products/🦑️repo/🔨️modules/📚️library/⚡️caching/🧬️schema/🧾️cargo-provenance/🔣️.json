{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/test/cargo-provenance",
  "title": "🧾️ Cargo build-dir provenance: dep-info decoding and foreign-source classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decode", "classify"],
  "definitions": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "path"],
      "properties": {
        "base": { "enum": ["package", "build"] },
        "path": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "decode": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hex"],
        "oneOf": [
          { "required": ["files"], "properties": { "files": { "type": "array", "items": { "$ref": "#/definitions/file" } } } },
          { "required": ["error"], "properties": { "error": { "enum": ["header", "truncated", "trailing", "kind"] } } }
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "hex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
          "files": { "type": "array", "items": { "$ref": "#/definitions/file" } },
          "error": { "enum": ["header", "truncated", "trailing", "kind"] }
        }
      }
    },
    "classify": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "platform", "roots", "paths", "foreign"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["darwin", "linux", "win32"] },
          "roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "foreign": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
