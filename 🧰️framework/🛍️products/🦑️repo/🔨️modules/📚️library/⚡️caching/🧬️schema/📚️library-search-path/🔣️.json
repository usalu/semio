{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "libraries",
    "libraryValue",
    "macroValue",
    "expected",
    "buildDirectory",
    "minimumUnfilteredCharacters",
    "metadataSetting"
  ],
  "properties": {
    "libraries": {
      "type": "integer",
      "minimum": 180,
      "maximum": 256
    },
    "libraryValue": {
      "type": "integer",
      "minimum": 1
    },
    "macroValue": {
      "type": "integer",
      "minimum": 1
    },
    "expected": {
      "type": "integer",
      "minimum": 1
    },
    "buildDirectory": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+)+$"
    },
    "minimumUnfilteredCharacters": {
      "const": 32767
    },
    "metadataSetting": {
      "const": "DoNotEmbed"
    }
  }
}
