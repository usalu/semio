{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "imports",
    "contexts",
    "repository",
    "graphAuthority",
    "lockScopes",
    "authorityInputs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "imports": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "source",
          "imports"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "imports": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "phases"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "phases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "projects",
                "packages",
                "locked",
                "targets"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "projects": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "packages": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "locked": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "targets": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "sources"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "minItems": 2
        }
      }
    },
    "graphAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "export"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "export": {
          "type": "string"
        }
      }
    },
    "lockScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "source",
          "before",
          "after",
          "beforeTarget",
          "afterTarget"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "beforeTarget": {
            "type": "string"
          },
          "afterTarget": {
            "type": "string"
          }
        }
      }
    },
    "authorityInputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "path",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        }
      }
    }
  }
}
