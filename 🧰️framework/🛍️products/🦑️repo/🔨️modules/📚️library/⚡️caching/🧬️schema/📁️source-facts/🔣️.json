{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "paths"],
  "properties": {
    "version": { "const": 1 },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prefix", "segment", "count", "suffix", "utf16", "admitted"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prefix": { "type": "string" },
          "segment": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0, "maximum": 256 },
          "suffix": { "type": "string" },
          "utf16": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "admitted": { "type": "boolean" }
        }
      }
    }
  }
}
