{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/library/caching/schema.json",
  "title": "NxCachePolicy",
  "$defs": {
    "NxCoordinatorFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "platform",
              "stdout",
              "environment",
              "expectedExit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "enum": [
                  "win32",
                  "linux",
                  "darwin"
                ]
              },
              "stdout": {
                "type": "string"
              },
              "environment": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "NX_WORKSPACE_DATA_DIRECTORY": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "expectedExit": {
                "type": "integer"
              },
              "throws": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "uncached",
    "uncachedExact",
    "cachedExact",
    "continuous",
    "generatedDirectories",
    "toolchains",
    "generatorInputs",
    "storage"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "uncached": {
      "description": "Target families that never replay: the name itself and every `<name>-…` variant.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "uncachedExact": {
      "description": "Target names that never replay while their `<name>-…` variants stay cacheable (e.g. `format` vs `format-check`, `os` vs `os-*`).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cachedExact": {
      "description": "Target names verified deterministic whose name merely collides with the mutating/live name heuristics (e.g. a domain term like `live-catalog`); they replay with their declared outputs.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "continuous": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "generatedDirectories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files",
          "environment",
          "commands"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "targetDefaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "generatorInputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "output"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^\\S+:\\S+$"
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:*?{}\\[\\]\\u0000]).+$"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guardAgeMs",
        "cargo",
        "vite",
        "agents",
        "tests"
      ],
      "properties": {
        "guardAgeMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "cargo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "budgetBytes",
            "unusedAgeMs",
            "incremental"
          ],
          "properties": {
            "budgetBytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "unusedAgeMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "incremental": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "budgetBytes",
                "unusedAgeMs",
                "guardAgeMs"
              ],
              "properties": {
                "budgetBytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "unusedAgeMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "guardAgeMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        "vite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unusedAgeMs"
          ],
          "properties": {
            "unusedAgeMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unusedAgeMs"
          ],
          "properties": {
            "unusedAgeMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unusedAgeMs"
          ],
          "properties": {
            "unusedAgeMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  }
}
