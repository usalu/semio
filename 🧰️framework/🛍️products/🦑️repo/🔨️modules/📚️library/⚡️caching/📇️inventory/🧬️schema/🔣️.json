{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["projects", "tags", "uncachedExecutors", "properties"],
  "additionalProperties": false,
  "properties": {
    "projects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "uncachedExecutors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "properties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["executor", "cache", "continuous", "inputs", "outputs", "dependsOn", "configurations"]}}
  }
}
