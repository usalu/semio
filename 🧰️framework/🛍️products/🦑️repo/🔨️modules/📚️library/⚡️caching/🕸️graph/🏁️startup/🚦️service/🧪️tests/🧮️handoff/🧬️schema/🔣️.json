{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:daemon-handoff-corpus:v1",
  "title": "Daemon Service Handoff Corpus",
  "description": "Language-agnostic wires for the daemon service handoff: text (or a generated filler of an exact byte size wrapped into a template) and the refusal each must meet, classified as byte bound, JSON syntax, closed record or birth descriptor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "envName", "maximumBytes", "wires"],
  "properties": {
    "version": { "const": 1 },
    "envName": { "type": "string", "pattern": "^SEMIO_[A-Z_]+$" },
    "maximumBytes": { "type": "integer", "minimum": 1 },
    "wires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "wire", "filler", "error", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "wire": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
          "filler": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["bytes", "wrapper"], "properties": { "bytes": { "type": "integer", "minimum": 1 }, "wrapper": { "type": "string", "pattern": "%s" }, "multibyte": { "type": "boolean" } } }] },
          "error": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["bound", "syntax", "closed", "birth"] }
        }
      }
    }
  }
}
