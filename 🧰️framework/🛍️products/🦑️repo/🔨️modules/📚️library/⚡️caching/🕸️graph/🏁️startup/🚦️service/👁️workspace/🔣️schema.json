{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {
        "maximumPathUnits": 256,
        "maximumPendingEvents": 200000,
        "maximumStartupMilliseconds": 60000,
        "sourcePolicy": "closed-root-and-name",
        "readiness": "journal-cursor",
        "failure": "terminal",
        "custody": "host-journal",
        "pollMilliseconds": 200,
        "blindRootedPaths": [
          "bazel-out",
          "bazel-bin",
          "bazel-testlogs",
          "bazel-semio"
        ]
      }
    }
  }
}
