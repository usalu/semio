{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "primary",
          "rollback",
          "body",
          "errors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "primary": {
            "enum": [
              "undefined",
              "frozen",
              "error"
            ]
          },
          "rollback": {
            "enum": [
              "same",
              "distinct"
            ]
          },
          "body": {
            "enum": [
              "failed",
              "success"
            ]
          },
          "errors": {
            "enum": [
              1,
              2
            ]
          }
        }
      }
    }
  }
}
