{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "imports",
          "productionImports"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "productionImports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
