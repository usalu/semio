{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:graph-seal-facts-fixture:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "files", "records", "receiptRows", "expectedDistinct", "scenarios", "refusals"],
  "definitions": {
    "row": { "type": "object", "additionalProperties": false, "required": ["kind", "file"], "properties": { "kind": { "enum": ["file", "exists"] }, "file": { "type": "string" }, "fact": { "type": "boolean" } } }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "files": { "type": "object", "additionalProperties": { "type": "string" } },
    "records": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "rows"], "properties": { "name": { "type": "string" }, "rows": { "type": "array", "items": { "$ref": "#/definitions/row" } } } } },
    "receiptRows": { "type": "array", "items": { "$ref": "#/definitions/row" } },
    "expectedDistinct": { "type": "integer", "minimum": 0 },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mutation", "holds"],
        "properties": {
          "id": { "type": "string" },
          "holds": { "type": "boolean" },
          "mutation": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["none", "write-file", "replace-record", "flip-facts", "remove-facts"] }, "file": { "type": "string" }, "content": { "type": "string" }, "record": { "type": "string" } } }
        }
      }
    },
    "refusals": { "type": "array", "items": { "type": "object", "required": ["id", "captured"], "properties": { "id": { "type": "string" }, "captured": { "const": false }, "digestOf": { "type": "string" }, "recordCorrupt": { "type": "string" }, "removeRecord": { "type": "string" } } } }
  }
}
