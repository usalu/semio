{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/caching/nx-graph-seal/v2",
  "title": "Nx graph seal",
  "description": "Exact tracked, fresh untracked and admitted structural manifest membership; actual source ancestry custody, graph-input stamps and unchanged full inference receipt observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "nx",
    "graph",
    "receipts",
    "directories",
    "inputs",
    "membership"
  ],
  "definitions": {
    "stamp": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "number"
      }
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/]+$"
      }
    }
  },
  "properties": {
    "format": {
      "const": 2
    },
    "nx": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project-graph.json",
        "file-map.json"
      ],
      "properties": {
        "project-graph.json": {
          "$ref": "#/definitions/stamp"
        },
        "file-map.json": {
          "$ref": "#/definitions/stamp"
        }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": [
          {
            "type": "string"
          },
          {
            "$ref": "#/definitions/stamp"
          },
          {
            "$ref": "#/definitions/names"
          },
          {
            "$ref": "#/definitions/names"
          },
          {
            "$ref": "#/definitions/names"
          }
        ]
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/definitions/stamp"
          }
        ]
      }
    },
    "membership": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
