{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Nx Cache Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "uncached",
    "continuous",
    "generatedDirectories",
    "toolchains"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "uncached": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "continuous": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "generatedDirectories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files",
          "environment",
          "commands"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "targetDefaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
