{
  "version": 1,
  "project": "probe",
  "maxCacheSize": "64MB",
  "namedInputs": {
    "production": [{ "file": "source.json" }, { "file": "toolchain.json" }, { "file": "📜️script.ts" }, { "env": "CACHE_PROBE_MODE" }],
    "test": [{ "named": "production" }, { "file": "spec.json" }]
  },
  "ignore": ["node_modules", "dist", "state", "*.log"],
  "targets": [
    { "name": "build", "cache": true, "inputs": [{ "named": "production" }], "outputs": ["dist"], "command": "repo ./📜️script.ts build" },
    { "name": "test", "cache": true, "inputs": [{ "named": "test" }], "outputs": [], "command": "repo ./📜️script.ts test" },
    { "name": "validate", "cache": false, "outputs": [], "command": "repo ./📜️script.ts validate" },
    { "name": "guarded", "cache": true, "dependsOn": ["validate"], "inputs": [{ "named": "production" }], "outputs": [], "command": "repo ./📜️script.ts guarded" }
  ]
}
