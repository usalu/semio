{
  "nextest": [
    {
      "name": "a scope keeps only its own quick overrides under the current root",
      "root": "[profile.quick]\nslow-timeout = { period = \"300s\", terminate-after = 1 }\n\n[[profile.default.overrides]]\nfilter = 'test(/^a::/)'\ntest-group = 'g'\n",
      "scope": "[profile.quick]\nslow-timeout = { period = \"100s\", terminate-after = 1 }\n\n[[profile.quick.overrides]]\nfilter = 'package(p1)'\nslow-timeout = { period = \"600s\", terminate-after = 1 }\n\n\n[[profile.quick.overrides]]\nfilter = 'package(p2)'\nslow-timeout = { period = \"900s\", terminate-after = 1 }\n",
      "overrides": 2
    },
    {
      "name": "a scope without overrides equals the root",
      "root": "[profile.quick]\nslow-timeout = { period = \"300s\", terminate-after = 1 }\n",
      "scope": "[profile.quick]\nslow-timeout = { period = \"1s\", terminate-after = 1 }\n",
      "overrides": 0
    }
  ],
  "dependabot": {
