    "valid": "version: 2\nupdates:\n  - package-ecosystem: \"gomod\"\n    directories:\n      - \"/mod/a\"\n      - \"/mod/b\"\n    schedule:\n      interval: \"weekly\"\n  - package-ecosystem: \"bun\"\n    directories:\n      - \"/pkg/*\"\n    schedule:\n      interval: \"weekly\"\n  - package-ecosystem: \"github-actions\"\n    directory: \"/\"\n    schedule:\n      interval: \"weekly\"\n",
    "invalid": "version: 2\nupdates:\n  - package-ecosystem: \"gomod\"\n    directories:\n      - \"/mod/a\"\n      - \"/mod/gone\"\n    schedule:\n      interval: \"weekly\"\n  - package-ecosystem: \"bun\"\n    directories:\n      - \"/mod/a\"\n    schedule:\n      interval: \"weekly\"\n",
