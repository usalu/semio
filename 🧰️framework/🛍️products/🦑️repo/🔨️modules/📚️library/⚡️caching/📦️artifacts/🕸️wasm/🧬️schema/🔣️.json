{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "sourceOwner"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "sourceOwner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*(?:[\\\\:\\u0000-\\u001f\\u007f]|//))[^/]+(?:/[^/]+)*$"
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "namespace": "wasm-packages",
        "hashUnits": 24
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceOwner"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sourceOwner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*(?:[\\\\:\\u0000-\\u001f\\u007f]|//))[^/]+(?:/[^/]+)*$"
        }
      }
    },
    "Package": {
      "type": "object",
      "required": [
        "name",
        "version",
        "type",
        "files",
        "semioWasmOwner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "const": "module"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16383,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*(?:[\\\\:\\u0000-\\u001f\\u007f]|//))[^/]+(?:/[^/]+)*$"
          }
        },
        "semioWasmOwner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "mode",
            "sourceOwner"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "mode": {
              "enum": [
                "prototype",
                "release"
              ]
            },
            "sourceOwner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*(?:[\\\\:\\u0000-\\u001f\\u007f]|//))[^/]+(?:/[^/]+)*$"
            }
          }
        }
      }
    }
  }
}
