{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/cache/artifact-package-inventory.json",
  "title": "Artifact Package Inventory",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ArtifactPackage"
      }
    }
  },
  "required": [
    "schemaVersion",
    "packages"
  ],
  "$defs": {
    "ArtifactPackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*/🦀️\\.rs$"
        },
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cargoName": {
              "type": "string",
              "pattern": "^semio-[a-z0-9-]*artifact-[a-z0-9-]+$"
            },
            "nxName": {
              "type": "string",
              "minLength": 1
            },
            "manifest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          },
          "required": [
            "cargoName",
            "nxName",
            "manifest"
          ]
        },
        "typescript": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "nxName": {
              "type": "string",
              "minLength": 1
            },
            "manifest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "entry": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "types": {
                  "const": "./dist/🟦️.d.ts"
                },
                "import": {
                  "const": "./dist/🟦️.js"
                }
              },
              "required": [
                "types",
                "import"
              ]
            }
          },
          "required": [
            "name",
            "nxName",
            "manifest",
            "entry"
          ]
        }
      },
      "required": [
        "root",
        "source",
        "rust"
      ]
    }
  }
}
