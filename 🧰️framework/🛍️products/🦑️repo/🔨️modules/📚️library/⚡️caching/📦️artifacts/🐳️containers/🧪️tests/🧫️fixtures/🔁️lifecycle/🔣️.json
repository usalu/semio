  "claudeAuth": [
    {
      "id": "home-file-moves-into-volume",
      "home": {
        ".claude.json": "home"
      },
      "volume": {},
      "expected": {
        ".claude.json": "home"
      }
    },
    {
      "id": "volume-wins-over-home-file",
      "home": {
        ".claude.json": "home"
      },
      "volume": {
        ".claude.json": "volume"
      },
      "expected": {
        ".claude.json": "volume"
      }
    },
    {
      "id": "volume-only-gets-linked",
      "home": {},
      "volume": {
        ".claude.json.backup": "backup"
      },
      "expected": {
        ".claude.json.backup": "backup"
      }
    },
    {
      "id": "nothing-to-do",
      "home": {},
      "volume": {},
      "expected": {}
    }
  ],
  "forbiddenCommands": [
    "git reset",
    "git clean",
    "git stash",
    "rm -rf /var/lib",
    "DETACH DELETE",
    "micro-commit install-hooks"
  ],
  "dashboardOnly": {
    "removedPaths": [
      ".vscode",
      ".vscode/launch.json",
      ".vscode/\ud83e\udde9\ufe0flaunch.seed.jsonc",
      ".vscode/tasks.json",
      ".vscode/settings.json",
      ".vscode/extensions.json",
      ".vscode/mcp.json",
      ".cursor/mcp.json",
      ".cursor/hooks.json",
      ".devcontainer/editor-overlay.json",
      "Monorepo.sln"
    ],
    "forbiddenPrograms": [
      "code",
      "code-insiders",
      "cursor",
      "windsurf",
      "antigravity",
      "gitkraken",
      "gk"
    ],
    "forbiddenArgs": [
      "--install-extension",
      "--list-extensions",
      "@semio-tech/repo-vscode:build-vsix",
      "install-hooks",
      "core.hooksPath"
    ],
    "nativeBootstrap": {
      "path": "\ud83e\uddf0\ufe0fframework/\ud83d\udecd\ufe0fproducts/\ud83e\udd91\ufe0frepo/\ud83d\udd28\ufe0fmodules/\ud83d\udd29\ufe0fnative/\ud83e\udd7e\ufe0fbootstrap/\ud83d\udd35\ufe0f.ps1",
      "forbiddenTokens": [
        "Install-EditorExtensions",
        "Microsoft.VisualStudioCode",
        "SEMIO_POST_ATTACH_SKIP_EXTENSION_INSTALL",
        ".codeium",
        "Join-HomePath @(\".config\", \"cursor\")",
        "Join-HomePath @(\".config\", \"antigravity\")",
        "code --wait",
        "GitKraken",
        "SEMIO_GITKRAKEN",
        "gk.exe"
      ]
    },
    "attachModes": [
      {
        "id": "ordinary-attach",
        "skipTools": false
      },
      {
        "id": "skip-optional-tools",
        "skipTools": true
      }
    ],
    "forbiddenState": [
      ".gitkraken",
      ".local/share/GitKrakenCLI",
      ".local/share/gk"
    ],
    "automaticHooks": {
      "version": 1,
      "automaticInstallation": false,
      "forbiddenArguments": [
        "install-hooks",
        "core.hooksPath"
      ],
      "cases": [
        {
          "id": "bootstrap-installer",
          "argv": [
            "bun",
            "./\ud83d\udcdc\ufe0fscript.ts",
            "micro-commit",
            "install-hooks"
          ],
          "allowed": false
        },
        {
          "id": "native-installer",
          "argv": [
            "repo",
            "micro-commit",
            "install-hooks"
          ],
          "allowed": false
        },
        {
          "id": "alternate-hooks-root",
          "argv": [
            "git",
            "config",
            "core.hooksPath",
            ".githooks"
          ],
          "allowed": false
        },
        {
          "id": "explicit-preparation",
          "argv": [
            "repo",
            "run",
            "workspace:setup-git"
          ],
          "allowed": true
        },
        {
          "id": "optional-viewer-probe",
          "argv": [
            "which",
            "f3d"
          ],
          "allowed": true
        },
        {
          "id": "empty-attach",
          "argv": [],
          "allowed": true
        }
      ]
    }
  },
  "headlessDisplay": {
    "display": ":99",
    "socket": "/tmp/.X11-unix/X99",
    "argv": [
      "Xvfb",
      ":99",
      "-screen",
      "0",
      "1920x1080x24",
      "-nolisten",
      "tcp"
    ]
  }
