    ],
    "missing": [
      "/workspaces/semio/♻️mit-bestand/🔎️recherche"
    ]
  },
  "claudeAuth": [
    {
      "id": "home-file-moves-into-volume",
      "home": {
        ".claude.json": "home"
      },
      "volume": {},
      "expected": {
        ".claude.json": "home"
      }
    },
    {
      "id": "volume-wins-over-home-file",
      "home": {
        ".claude.json": "home"
      },
      "volume": {
        ".claude.json": "volume"
      },
      "expected": {
        ".claude.json": "volume"
      }
    },
    {
      "id": "volume-only-gets-linked",
      "home": {},
      "volume": {
        ".claude.json.backup": "backup"
      },
      "expected": {
        ".claude.json.backup": "backup"
      }
    },
    {
      "id": "nothing-to-do",
      "home": {},
      "volume": {},
      "expected": {}
    }
  ],
  "forbiddenCommands": [
    "git reset",
    "git clean",
    "git stash",
    "rm -rf /var/lib",
    "DETACH DELETE"
  ],
  "dashboardOnly": {
    "removedPaths": [
      ".vscode",
      ".vscode/launch.json",
      ".vscode/🧩️launch.seed.jsonc",
      ".vscode/tasks.json",
      ".vscode/settings.json",
      ".vscode/extensions.json",
      ".vscode/mcp.json",
      ".cursor/mcp.json",
      ".cursor/hooks.json",
      ".devcontainer/editor-overlay.json",
      "Monorepo.sln"
    ],
    "forbiddenPrograms": [
      "code",
      "code-insiders",
      "cursor",
      "windsurf",
      "antigravity",
      "gitkraken",
      "gk"
    ],
    "forbiddenArgs": [
      "--install-extension",
      "--list-extensions",
      "@semio-tech/repo-vscode:build-vsix"
    ],
    "nativeBootstrap": {
      "path": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🔩️native/🥾️bootstrap/🔵️.ps1",
      "forbiddenTokens": [
        "Install-EditorExtensions",
        "Microsoft.VisualStudioCode",
        "SEMIO_POST_ATTACH_SKIP_EXTENSION_INSTALL",
        ".codeium",
        "Join-HomePath @(\".config\", \"cursor\")",
        "Join-HomePath @(\".config\", \"antigravity\")",
        "code --wait",
        "GitKraken",
        "SEMIO_GITKRAKEN",
        "gk.exe"
      ]
    },
    "attachModes": [
      {
        "id": "ordinary-attach",
        "skipTools": false
      },
      {
        "id": "skip-optional-tools",
        "skipTools": true
      }
    ],
    "forbiddenState": [
      ".gitkraken",
      ".local/share/GitKrakenCLI",
      ".local/share/gk"
    ]
  }
}
