{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:typescript-binding-corpus:v1",
  "title": "TypeScript Package Binding Corpus",
  "description": "Language-agnostic cases for the pure binding plan of a TypeScript package (owner, fixed links, output and receipt locations), the binding receipt and a path capacity sweep over package directory name lengths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "receipts", "capacity"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "workspace", "package", "packageName", "mode", "products", "error", "posixOnly"],
        "properties": { "name": { "type": "string", "minLength": 1 }, "workspace": { "type": "string" }, "package": { "type": "string" }, "packageName": { "type": "string" }, "mode": { "type": "string" }, "products": { "type": "string" }, "error": { "type": "string" }, "posixOnly": { "type": "boolean" } }
      }
    },
    "receipts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "value", "valid"], "properties": { "name": { "type": "string", "minLength": 1 }, "value": { "type": "object" }, "valid": { "type": "boolean" } } } },
    "capacity": { "type": "object", "additionalProperties": false, "required": ["workspace", "products", "from", "to"], "properties": { "workspace": { "type": "string" }, "products": { "type": "string" }, "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } } }
  }
}
