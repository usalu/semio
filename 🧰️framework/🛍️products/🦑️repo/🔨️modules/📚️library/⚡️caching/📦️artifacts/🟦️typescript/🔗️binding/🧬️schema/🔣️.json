{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "protocol",
    "package",
    "packageName",
    "activeMode",
    "modes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "protocol": {
      "const": "typescript-package-bindings"
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "activeMode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "prototype",
          "release"
        ]
      }
    }
  }
}
