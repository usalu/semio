{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "protocol",
    "package",
    "packageName",
    "activeMode",
    "modes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "protocol": {
      "const": "typescript-package-bindings"
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "activeMode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "prototype",
          "release"
        ]
      }
    }
  },
  "$defs": {
    "Producer": {
      "description": "An authored package task that publishes the exact public modules in Protocol from physical Source.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "typescript-artifact-package"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\\\u0000]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      }
    },
    "Protocol": {
      "const": {
        "publicDirectory": "dist",
        "modeDirectory": "📤️dist"
      }
    }
  }
}
