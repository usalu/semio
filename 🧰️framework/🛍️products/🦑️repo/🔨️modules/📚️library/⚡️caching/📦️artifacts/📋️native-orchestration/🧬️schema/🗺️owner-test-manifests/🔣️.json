{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Explicit Native Owner Test Manifest Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "manifest", "cwd", "testManifests", "command", "args"],
  "properties": {
    "version": {"const": 1},
    "manifest": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1},
    "testManifests": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "string", "minLength": 1},
    "args": {"type": "array", "items": {"type": "string"}}
  }
}
