{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "targets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route",
          "command",
          "args",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "route": {
            "enum": [
              "owner-command",
              "repository-test-body"
            ]
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string"
                  }
                }
              },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "semio"
                ],
                "properties": {
                  "semio": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "nativePreparation"
                    ],
                    "properties": {
                      "nativePreparation": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "expected": {
            "enum": [
              "owner-command",
              "repository-test-body",
              "refused"
            ]
          }
        }
      }
    }
  }
}
