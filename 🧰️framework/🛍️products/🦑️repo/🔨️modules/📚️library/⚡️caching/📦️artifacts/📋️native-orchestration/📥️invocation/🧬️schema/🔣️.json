{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/library/caching/artifacts/native-orchestration/invocation/component.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "buildMode",
    "repositoryRoot",
    "artifactDirectory",
    "command",
    "transport",
    "child",
    "network"
  ],
  "properties": {
    "cargoExecutionBackend": {
      "$ref": "https://json.schemas.assets.semio-tech.com/framework/process/testing/cargo/execution/component.json#/$defs/CargoExecutionBackendV1"
    },
    "version": {
      "const": 1
    },
    "repositoryRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "artifactDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "manifest",
        "workingDirectory",
        "program",
        "arguments"
      ],
      "properties": {
        "kind": {
          "const": "native-owner-command"
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 65536
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumBytes",
        "maximumLines"
      ],
      "properties": {
        "maximumBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumElapsedMilliseconds"
      ],
      "properties": {
        "maximumElapsedMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "idleMilliseconds": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 86400000,
          "description": "Idle window of the native child: it is stopped after this long without observable progress (child CPU time, child output, declared waits, finished observation steps), never later than maximumElapsedMilliseconds, which stays the nonrenewable ceiling. Absent: the declared class default of native-child."
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline"
      ],
      "properties": {
        "offline": {
          "type": "boolean"
        }
      }
    },
    "buildMode": {
      "type": "string",
      "enum": [
        "prototype",
        "release"
      ]
    }
  },
  "$defs": {
    "NativeOwnerExecutionPolicyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "version",
        "transport",
        "child"
      ],
      "properties": {
        "$schema": {
          "const": "./📥️invocation/🧬️schema/🔣️.json#/$defs/NativeOwnerExecutionPolicyV1"
        },
        "version": {
          "const": 1
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumBytes",
            "maximumLines"
          ],
          "properties": {
            "maximumBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumLines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "child": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumElapsedMilliseconds"
          ],
          "properties": {
            "maximumElapsedMilliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "idleMilliseconds": {
              "type": "integer",
              "minimum": 60000,
              "maximum": 86400000,
              "description": "Idle window of the native child: it is stopped after this long without observable progress (child CPU time, child output, declared waits, finished observation steps), never later than maximumElapsedMilliseconds, which stays the nonrenewable ceiling. Absent: the declared class default of native-child."
            }
          }
        }
      }
    },
    "NeutralCallerRoleCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "object"
        },
        "role": {
          "enum": [
            "native-owner-command",
            "build-orchestration"
          ]
        }
      }
    },
    "NativeCallerPhaseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "effect",
        "accepted",
        "maximumMilliseconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "ordinary",
            "copy",
            "foreign",
            "cancelled",
            "expired",
            "retired"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "maximumMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "NativeDependencyKind": {
      "enum": [
        "python",
        "cargo",
        "cargo-lock",
        "go",
        "dotnet",
        "cpp",
        "browsers",
        "wasm",
        "trunk",
        "tools"
      ]
    }
  }
}
