{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "body",
      "accepted",
      "recheck",
      "expected"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "body": {
        "enum": [
          "success",
          "failure",
          "undefined-failure"
        ]
      },
      "accepted": {
        "type": "array",
        "items": {
          "enum": [
            "success",
            "failure"
          ]
        }
      },
      "recheck": {
        "enum": [
          "success",
          "failure"
        ]
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rechecks",
          "failure",
          "members"
        ],
        "properties": {
          "rechecks": {
            "enum": [
              0,
              1
            ]
          },
          "failure": {
            "enum": [
              "none",
              "body",
              "undefined",
              "consumer",
              "validation",
              "aggregate"
            ]
          },
          "members": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        }
      }
    }
  }
}
