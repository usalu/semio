  "held": [
    "accepted-success",
    "accepted-failure",
    "undefined-failure",
    "cancel",
    "foreign",
    "copied",
    "wrong-control",
    "same-source-output",
    "released"
  ],
  "compilerOracles": [
    "bun",
    "esbuild"
  ]
}
