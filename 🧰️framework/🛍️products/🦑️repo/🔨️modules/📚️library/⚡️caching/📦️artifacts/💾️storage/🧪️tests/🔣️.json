    {
      "request": {
        "version": 1,
        "mode": "release",
        "owner": "modules/example/package"
      },
      "accepted": true
    },
    {
      "request": {
        "version": 1,
        "mode": "dev",
        "owner": "modules/example/package"
      },
      "accepted": false
    },
    {
      "request": {
        "version": 1,
        "mode": "prototype",
        "owner": "../outside"
      },
      "accepted": false
    },
    {
      "request": {
        "version": 1,
        "mode": "prototype",
