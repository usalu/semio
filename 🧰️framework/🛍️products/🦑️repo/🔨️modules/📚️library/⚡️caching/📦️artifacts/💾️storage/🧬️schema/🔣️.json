{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "owner"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "Protocol": {
      "const": {
        "version": 1,
        "namespace": "a/ts",
        "maximumFiles": 16384,
        "maximumOutputBytes": 536870912,
        "maximumPathUnits": 256,
        "maximumManifestBytes": 1048576,
        "maximumElapsedMilliseconds": 120000,
        "writerShards": 64,
        "files": [
          "🟦️.js",
          "🟦️.d.ts"
        ],
        "sources": "preserved",
        "existingForeignBinding": "refused",
        "retainedGenerationHistory": 0
      }
    }
  }
}
