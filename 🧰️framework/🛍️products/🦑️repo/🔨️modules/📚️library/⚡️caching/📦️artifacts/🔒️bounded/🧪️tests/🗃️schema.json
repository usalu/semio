{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "artifactDatabaseRole",
    "phases",
    "bytes",
    "terminal",
    "taskDetails",
    "publicationRefusal"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "artifactDatabaseRole": {
      "const": "artifact-cache"
    },
    "bytes": {
      "type": "string",
      "minLength": 1
    },
    "terminal": {
      "type": "string",
      "minLength": 1
    },
    "phases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "graph",
          "restore"
        ],
        "properties": {
          "name": {
            "enum": [
              "publish",
              "same-graph",
              "changed-graph",
              "deleted-restore"
            ]
          },
          "graph": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "restore": {
            "type": "boolean"
          }
        }
      }
    },
    "taskDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "target"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicationRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "entered",
        "hit",
        "taskDetailsRows"
      ],
      "properties": {
        "operation": {
          "const": "busy-physical-writer"
        },
        "entered": {
          "const": false
        },
        "hit": {
          "const": false
        },
        "taskDetailsRows": {
          "const": 0
        }
      }
    }
  }
}
