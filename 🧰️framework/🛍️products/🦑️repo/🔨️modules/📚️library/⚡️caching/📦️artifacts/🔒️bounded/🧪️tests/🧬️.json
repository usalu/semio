{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "authoredCacheDirectories",
    "rawCacheAdmission"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "paths",
          "accepted"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "authoredCacheDirectories": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "directory",
          "accepted"
        ],
        "properties": {
          "directory": {
            "type": [
              "string",
              "null"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "rawCacheAdmission": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environment",
          "refused"
        ],
        "properties": {
          "environment": {
            "enum": [
              "missing",
              "foreign"
            ]
          },
          "refused": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
