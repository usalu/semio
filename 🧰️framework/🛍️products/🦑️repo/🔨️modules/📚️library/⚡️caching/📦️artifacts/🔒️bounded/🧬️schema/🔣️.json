{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/repo/nx/bounded-artifact/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "owner",
    "maximumBytes",
    "paths"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "artifact-publication",
        "artifact-restore"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "maximumBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}

