{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "phase",
    "scanner",
    "status",
    "root",
    "elapsedMilliseconds",
    "discoveryMilliseconds",
    "measurementMilliseconds",
    "enumerationMilliseconds",
    "units",
    "operations",
    "maximumInFlight"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "phase": {
      "enum": [
        "initial",
        "recensus"
      ]
    },
    "scanner": {
      "enum": [
        "build",
        "incremental"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "failed"
      ]
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "elapsedMilliseconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "discoveryMilliseconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "measurementMilliseconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enumerationMilliseconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stat",
        "measurement",
        "entries",
        "continuation"
      ],
      "properties": {
        "stat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calls",
            "milliseconds"
          ],
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "milliseconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calls",
            "milliseconds"
          ],
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "milliseconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "entries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calls",
            "milliseconds"
          ],
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "milliseconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calls",
            "milliseconds"
          ],
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "milliseconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "maximumInFlight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "maximumSummaryBytes": 2048,
        "maximumOperationSummaries": 4,
        "switch": "SEMIO_CARGO_RETIREMENT_TIMING",
        "prefix": "[DEBUG] Cargo scanner timing "
      }
    }
  }
}
