{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "removed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "valid",
              "conflict",
              "malformed",
              "missing",
              "oversized",
              "blocked",
              "unbound",
              "limit"
            ]
          },
          "removed": {
            "enum": [
              0,
              1
            ]
          }
        }
      }
    }
  }
}
