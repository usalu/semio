{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.cargo/UnitCacheFleetV1",
  "title": "Fleet tier of the Cargo compile-unit cache: platform identity, portable unit manifest, upload spool, claims and counters",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "namespace": "semio.cargo.unit-cache.fleet/v1",
        "layout": { "state": "fl", "fallbacks": "fb", "spool": "up", "costs": "cost",
          "manifests": "manifests", "down": "down", "denied": "denied", "noClaims": "noclaims", "reachable": "reachable", "uploader": "uploader.lock", "spawned": "uploader.spawned", "uploaderIdentity": "uploader.identity", "spoolRegistry": "unit-spools" },
        "tokens": { "cwd": "@@semio-cwd@@", "workspace": "@@semio-ws@@", "cargoHome": "@@semio-cargo-home@@", "rustupHome": "@@semio-rustup-home@@", "sysroot": "@@semio-sysroot@@" },
        "slotType": "type.semio.tech/semio.cargo.unit-cache.slot.v1",
        "worker": "semio-unit-cache",
        "slotHeader": "x-semio-slot",
        "manifestName": "unit.json",
        "timeouts": {
          "lookupMilliseconds": 3000,
          "claimMilliseconds": 1500,
          "blobMilliseconds": 20000,
          "blobBytesPerSecond": 2097152,
          "awaitSliceMilliseconds": 20000,
          "headMilliseconds": 1500,
          "rideThroughMilliseconds": 12000,
          "rideThroughInitialMilliseconds": 250,
          "rideThroughMaximumMilliseconds": 2000
        },
        "breaker": { "downFaults": 2, "downMilliseconds": 15000, "deniedMilliseconds": 15000, "noClaimsMilliseconds": 600000, "reachableMilliseconds": 300000 },
        "claim": { "ttlMilliseconds": 30000, "heartbeatMilliseconds": 8000, "finalTtlMilliseconds": 90000, "minimumWaitMilliseconds": 30000, "maximumWaitMilliseconds": 1200000, "defaultExpectedMilliseconds": 90000, "waitFactor": 2, "maximumRounds": 40, "retries": 2, "retryBackoffMilliseconds": 750 },
        "limits": { "maximumEntryBytes": 1342177280, "maximumBlobBytes": 1342177280, "maximumBlobs": 64, "maximumManifestBytes": 4194304, "maximumDownloadConcurrency": 4, "maximumUploadConcurrency": 3, "maximumUploadJobs": 8, "maximumUploadBytesInFlight": 1073741824 },
        "spool": { "minimumEntries": 4096, "maximumEntries": 262144, "freeSharePercent": 1, "entryBytes": 8192, "waitMilliseconds": 30000, "boundTtlMilliseconds": 30000 },
        "uploader": { "heartbeatMilliseconds": 2000, "staleMilliseconds": 10000, "idleMilliseconds": 900000, "pollMilliseconds": 200, "waitingPollMilliseconds": 2000, "spawnThrottleMilliseconds": 3000, "jobMilliseconds": 120000, "maximumJobAgeMilliseconds": 21600000, "retryBackoffMilliseconds": 15000, "maximumBackoffMilliseconds": 300000, "takeoverMilliseconds": 30000, "sweepMilliseconds": 5000, "registryRefreshMilliseconds": 600000, "registryRetentionMilliseconds": 3600000, "pinMaximumJobs": 4096, "pinRefreshMilliseconds": 30000 },
        "linkedCrateTypes": ["proc-macro", "bin", "cdylib", "dylib", "staticlib"],
        "hostIndependent": { "targetPrefixes": ["wasm32-"], "crateTypes": ["lib", "rlib"], "token": "any" }
      }
    },
    "Digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "os", "arch", "host", "rustc", "toolchain", "linker", "cpu"],
      "properties": {
        "version": { "const": 1 },
        "os": { "enum": ["darwin", "linux", "win32", "any"] },
        "arch": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "rustc": { "$ref": "#/definitions/Digest" },
        "toolchain": { "type": "string" },
        "linker": { "type": "string" },
        "cpu": { "type": "string" }
      }
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes", "executable"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^/\\\\]+$" },
        "sha256": { "$ref": "#/definitions/Digest" },
        "bytes": { "type": "integer", "minimum": 0 },
        "executable": { "type": "boolean" },
        "template": { "type": "boolean" }
      }
    },
    "KeyComponents": {
      "description": "The named inputs of the key of a unit as individual digests (toolchain, source, platform, one extern:<dependency> per dependency artifact, env:<NAME> per observed variable, args.<class> per argument class), so the keys of one slot that differ can be explained by the inputs that differ without access to the machines. `values` carries the text of the small, path-free argument classes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "components"],
      "properties": {
        "origin": { "type": "string", "minLength": 1, "maxLength": 128 },
        "components": { "type": "object", "maxProperties": 512, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{8,64}$" } },
        "values": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "string", "maxLength": 512 } }
      }
    },
    "SlotKeys": {
      "description": "What the cache answers to `GET /<instance>/v1/slots/<slot>`: the action results currently stored under one slot, newest first.",
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "keys"],
      "properties": {
        "slot": { "$ref": "#/definitions/Digest" },
        "keys": { "type": "array", "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["key", "storedAtMs"], "properties": { "key": { "$ref": "#/definitions/Digest" }, "storedAtMs": { "type": "integer", "minimum": 0 } } } }
      }
    },
    "RemoteUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "key", "localKey", "slot", "crate", "platform", "createdMs", "costMs", "dependencies", "environment", "outputs", "stdout", "stderr"],
      "properties": {
        "version": { "const": 1 },
        "key": { "$ref": "#/definitions/Digest" },
        "localKey": { "$ref": "#/definitions/Digest" },
        "slot": { "$ref": "#/definitions/Digest" },
        "crate": { "type": "string", "minLength": 1 },
        "platform": { "$ref": "#/definitions/Platform" },
        "createdMs": { "type": "integer", "minimum": 0 },
        "costMs": { "type": "integer", "minimum": 0 },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "anyOf": [{ "$ref": "#/definitions/Digest" }, { "type": "null" }] } }
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "value": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          }
        },
        "outputs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/definitions/Output" } },
        "stdout": { "anyOf": [{ "$ref": "#/definitions/Digest" }, { "type": "null" }] },
        "stderr": { "anyOf": [{ "$ref": "#/definitions/Digest" }, { "type": "null" }] },
        "keyComponents": { "$ref": "#/definitions/KeyComponents" },
        "retention": { "description": "What the unit was built from (a Declaration of the slot schema, checked by the code that writes it): the server reads it when the unit arrives and judges the unit against its synchronized tree.", "type": "object" }
      }
    },
    "SpoolJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "key", "localKey", "slot", "crate", "cwd", "workspace", "laneRoot", "owner", "claimed", "costMs", "platform", "queuedMs"],
      "properties": {
        "version": { "const": 1 },
        "key": { "$ref": "#/definitions/Digest" },
        "localKey": { "$ref": "#/definitions/Digest" },
        "slot": { "$ref": "#/definitions/Digest" },
        "crate": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "workspace": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "laneRoot": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "owner": { "type": "string" },
        "claimed": { "type": "boolean" },
        "offer": { "type": "boolean" },
        "run": { "description": "The unit is the run of a package's build script (its OUT_DIR and output streams), not a compilation: the worker reads it from the local run store and the manifest carries its facts as `run.json`.", "type": "boolean" },
        "tools": {
          "description": "The tool roots of the machine that built the unit (Cargo home, rustup home, the compiler's sysroot when it lies outside the rustup home), so the worker tokenises their paths exactly as the key did.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cargoHome": { "type": "string", "minLength": 1 },
            "rustupHome": { "type": "string", "minLength": 1 },
            "sysroot": { "type": "string", "minLength": 1 }
          }
        },
        "hint": {
          "description": "The root hint of a unit that was compiled while the cache was unreachable and holds directories of this machine: the neutral key and the kinds; the upload worker publishes the hint before it uploads the unit under its root key.",
          "type": "object",
          "additionalProperties": false,
          "required": ["neutralKey", "kinds"],
          "properties": {
            "neutralKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "kinds": { "type": "array", "minItems": 1, "items": { "enum": ["cargo-home", "cwd", "manifest", "rustup-home", "workspace"] } }
          }
        },
        "costMs": { "type": "integer", "minimum": 0 },
        "platform": { "$ref": "#/definitions/Platform" },
        "queuedMs": { "type": "integer", "minimum": 0 },
        "keyComponents": { "$ref": "#/definitions/KeyComponents" },
        "attempts": { "type": "integer", "minimum": 0 },
        "notBeforeMs": { "type": "integer", "minimum": 0 },
        "deferredBy": { "description": "The fleet identity (endpoint, instance and credential) whose client was not usable (breaker open, credential denied) when the job was put off: a drainer with another identity takes it at once instead of after `notBeforeMs`.", "type": "string", "minLength": 1 }
      }
    },
    "KeySamplesRef": {
      "description": "The reference of the key samples an origin published: the sha256 of the blob (a KeySamples document in the fleet cache), how many units it holds and when it was taken.",
      "type": "object",
      "additionalProperties": false,
      "required": ["blob", "count", "atMs"],
      "properties": {
        "blob": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "count": { "type": "integer", "minimum": 1, "maximum": 400 },
        "atMs": { "type": "integer", "minimum": 0 }
      }
    },
    "KeySamples": {
      "description": "The key inputs of the most recent misses of one origin as digests only (never a path, argument text or value): per unit the crate, its slot and one digest per key component. Published as one content-addressed blob; compared across origins by `repo fleet status`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "atMs", "samples"],
      "properties": {
        "version": { "const": 1 },
        "atMs": { "type": "integer", "minimum": 0 },
        "samples": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["crate", "slot", "atMs", "components"],
            "properties": {
              "crate": { "type": "string", "maxLength": 200 },
              "slot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "components": { "type": "object", "maxProperties": 400, "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{4,64}$" } },
              "values": { "description": "The flag texts of the small classes (diagnostics, unstable, codegen, features, cfg, lints, kind, edition, target and the rustflags environment) with every token that holds a path replaced by <path#digest>; never a directory.", "type": "object", "maxProperties": 12, "additionalProperties": { "type": "string", "maxLength": 300, "pattern": "^[^/\\\\]*$" } }
            }
          }
        }
      }
    },
    "Counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "wallMs", "unit", "offload"],
      "properties": {
        "version": { "const": 1 },
        "wallMs": { "type": "integer", "minimum": 0 },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["localHit", "remoteHit", "miss", "stored"],
          "properties": {
            "skipped": { "type": "integer", "minimum": 0 },
            "localHit": { "type": "integer", "minimum": 0 },
            "remoteHit": { "type": "integer", "minimum": 0 },
            "miss": { "type": "integer", "minimum": 0 },
            "stored": { "type": "integer", "minimum": 0 }
          }
        },
        "keySamples": { "$ref": "#/definitions/KeySamplesRef" },
        "spool": {
          "description": "How deep the upload spool of the machine's unit cache root was when the upload worker last listed it: the jobs waiting for the fleet cache, the bound beyond which a compile waits for room, and when the depth was taken.",
          "type": "object",
          "additionalProperties": false,
          "required": ["depth", "bound", "atMs"],
          "properties": {
            "depth": { "type": "integer", "minimum": 0 },
            "bound": { "type": "integer", "minimum": 1 },
            "atMs": { "type": "integer", "minimum": 0 }
          }
        },
        "skipReasons": {
          "description": "Units compiled here and not shared with the fleet, by reason name; the counts add up to unit.skipped, which is their sum.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,40}$" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "offload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["out", "refused", "fellBack"],
          "properties": {
            "out": { "type": "integer", "minimum": 0 },
            "refused": { "type": "integer", "minimum": 0 },
            "fellBack": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "SlotVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments", "environment", "cwd", "rustc", "host", "slot", "parts"],
      "properties": {
        "name": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "cwd": { "type": "string" },
        "rustc": { "$ref": "#/definitions/Digest" },
        "host": { "type": "string" },
        "slot": { "$ref": "#/definitions/Digest" },
        "parts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
