{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "semio.cargo.unit-cache.interface/v1",
 "title": "Interface identity of a compiled library unit: which source bytes a dependant can observe and how a cached dependant is rebased onto a rebuilt dependency",
 "definitions": {
  "Policy": {
   "type": "object",
   "additionalProperties": false,
   "required": ["version", "namespace", "sidecars", "unit", "source", "rebase"],
   "properties": {
    "version": {"type": "integer"},
    "namespace": {"type": "string"},
    "sidecars": {"type": "object", "additionalProperties": false, "required": ["dependencies", "identity"], "properties": {"dependencies": {"type": "string"}, "identity": {"type": "string"}}},
    "unit": {"type": "object"},
    "source": {"type": "object"},
    "rebase": {"type": "object"}
   },
   "const": {
    "version": 1,
    "namespace": "semio.cargo.unit-cache.interface/v1",
    "sidecars": {"dependencies": ".semio-deps", "identity": ".semio-iface"},
    "unit": {
     "crateTypes": ["lib", "rlib"],
     "allowedUnstable": ["threads", "unstable-options", "embed-metadata", "checksum-hash-algorithm", "dep-info-omit-d-target", "binary-dep-depinfo"],
     "maximumOptimization": 0,
     "listTimeoutMilliseconds": 60000
    },
    "source": {
     "maskedBody": "{/*semio:masked*/}",
     "modifiersAllowed": ["unsafe"],
     "attributesAllowed": ["doc", "allow", "warn", "deny", "forbid", "expect", "must_use", "deprecated", "cfg"],
     "bodyKeywordsForbidden": ["impl", "trait", "macro_rules", "mod", "static", "extern", "union", "enum", "struct", "type", "include", "async"],
     "bodyAttributesForbidden": ["no_mangle", "export_name", "link_section", "used", "global_allocator", "panic_handler", "alloc_error_handler", "proc_macro", "proc_macro_derive", "proc_macro_attribute", "thread_local", "linkage"],
     "bodyMacrosAllowed": ["println", "print", "eprintln", "eprint", "format", "write", "writeln", "vec", "assert", "assert_eq", "assert_ne", "debug_assert", "debug_assert_eq", "debug_assert_ne", "panic", "todo", "unimplemented", "unreachable", "matches", "dbg", "format_args", "concat", "stringify", "line", "column", "file", "module_path", "env", "option_env", "cfg", "include_str", "include_bytes"],
     "featuresVoiding": ["type_alias_impl_trait", "impl_trait_in_assoc_type", "impl_trait_in_fn_trait_return", "rustc_attrs", "lang_items", "no_core", "coroutines", "generators", "stmt_expr_attributes", "adt_const_params", "generic_const_exprs", "const_trait_impl", "min_specialization", "specialization", "auto_traits", "negative_impls", "intrinsics", "core_intrinsics", "custom_mir", "unsized_fn_params", "unsized_locals", "fn_delegation", "proc_macro_hygiene", "decl_macro", "trait_alias"]
    },
    "rebase": {"occurrences": 1}
   }
  },
  "Dependencies": {
   "type": "object",
   "additionalProperties": false,
   "required": ["version", "svh", "dependencies"],
   "properties": {
    "version": {"const": 1},
    "svh": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "dependencies": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": [{"type": "string"}, {"type": "string", "pattern": "^[0-9a-f]{32}$"}]}}
   }
  },
  "Identity": {
   "type": "object",
   "additionalProperties": false,
   "required": ["version", "sha256"],
   "properties": {
    "version": {"const": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "basis": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "svh": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
   }
  }
 }
}
