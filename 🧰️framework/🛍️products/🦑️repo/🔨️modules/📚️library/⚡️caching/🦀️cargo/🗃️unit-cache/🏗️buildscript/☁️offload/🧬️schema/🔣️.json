{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/build-script-offload/v1",
  "title": "Build script offload",
  "description": "The closed policy of a build script run on another machine of the fleet: the layout of the worker's private root, the environment a command carries, the markers of scripts that are not hermetic (they spawn programs, reach the network or the host's libraries, read outside their package) and the stand-in tool.",
  "definitions": {
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "layout",
        "environment",
        "allEnvironment",
        "environmentRead",
        "sourceMarkers",
        "binaryMarkers",
        "buildDependencies",
        "tool"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "input",
            "manifest",
            "executable",
            "output",
            "outDirectory",
            "rootFile",
            "marker",
            "tools",
            "scratch"
          ],
          "properties": {
            "root": {
              "type": "string"
            },
            "input": {
              "type": "string"
            },
            "manifest": {
              "type": "string"
            },
            "executable": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "outDirectory": {
              "type": "string"
            },
            "rootFile": {
              "type": "string"
            },
            "marker": {
              "type": "string"
            },
            "tools": {
              "type": "string"
            },
            "scratch": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "names",
            "prefixes",
            "refused"
          ],
          "properties": {
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prefixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "refused": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "allEnvironment": {
          "type": "string"
        },
        "environmentRead": {
          "type": "string"
        },
        "sourceMarkers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "pattern"
            ],
            "properties": {
              "reason": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              }
            }
          }
        },
        "binaryMarkers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "text"
            ],
            "properties": {
              "reason": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "buildDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lines"
          ],
          "properties": {
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "policy": {
    "version": 1,
    "layout": {
      "root": "@root",
      "input": "in",
      "manifest": "manifest",
      "executable": "run",
      "output": "out",
      "outDirectory": "out-dir",
      "rootFile": "root",
      "marker": ".semio-offload",
      "tools": "x/build-script-tools",
      "scratch": "x/build-script-offload"
    },
    "environment": {
      "names": [
        "TARGET",
        "HOST",
        "PROFILE",
        "OPT_LEVEL",
        "DEBUG",
        "NUM_JOBS"
      ],
      "prefixes": [
        "CARGO_PKG_",
        "CARGO_CFG_",
        "CARGO_FEATURE_"
      ],
      "refused": [
        "DEP_",
        "CARGO_MANIFEST_LINKS"
      ]
    },
    "allEnvironment": "\\benv\\s*::\\s*vars(?:_os)?\\s*\\(",
    "environmentRead": "\\bvar(?:_os)?\\s*\\(\\s*\"([^\"]+)\"",
    "sourceMarkers": [
      {
        "reason": "spawns-process",
        "pattern": "\\bCommand\\s*::\\s*new\\b|process\\s*::\\s*Command"
      },
      {
        "reason": "network",
        "pattern": "std\\s*::\\s*net\\b|\\bTcpStream\\b|\\bUdpSocket\\b|\\bTcpListener\\b|\\breqwest\\b|\\bureq\\b|\\bcurl\\s*::|\\bhyper\\b"
      },
      {
        "reason": "host-probing",
        "pattern": "\\bpkg_config\\b|\\bcc\\s*::|\\bcmake\\s*::|\\bbindgen\\b|\\bvcpkg\\b|\\bsystem_deps\\b|\\bautocfg\\b|\\bversion_check\\b|\\brustc_version\\b|\\bwhich\\s*::|\\bprost_build\\b|\\btonic_build\\b|\\bcxx_build\\b|\\bprotoc\\b"
      },
      {
        "reason": "reads-outside-manifest",
        "pattern": "\"(?:/[A-Za-z0-9_.~-][^\"]*|~/[^\"]*|\\.\\.(?:/[^\"]*)?)\""
      }
    ],
    "binaryMarkers": [
      {
        "reason": "host-probing",
        "text": "PKG_CONFIG"
      },
      {
        "reason": "host-probing",
        "text": "CMAKE"
      },
      {
        "reason": "host-probing",
        "text": "VCPKG"
      },
      {
        "reason": "host-probing",
        "text": "LIBCLANG"
      },
      {
        "reason": "host-probing",
        "text": "CC_ENABLE_DEBUG_OUTPUT"
      },
      {
        "reason": "compiler-environment",
        "text": "RUSTC"
      },
      {
        "reason": "compiler-environment",
        "text": "RUSTDOC"
      },
      {
        "reason": "compiler-environment",
        "text": "CARGO_ENCODED_RUSTFLAGS"
      },
      {
        "reason": "network",
        "text": "TcpStream"
      },
      {
        "reason": "network",
        "text": "getaddrinfo"
      }
    ],
    "buildDependencies": [
      "cc",
      "pkg-config",
      "cmake",
      "bindgen",
      "vcpkg",
      "system-deps",
      "autocfg",
      "version_check",
      "rustc_version",
      "which",
      "reqwest",
      "ureq",
      "curl",
      "openssl-src",
      "cxx-build",
      "protobuf-codegen",
      "prost-build",
      "tonic-build",
      "protoc-bin-vendored"
    ],
    "tool": {
      "lines": [
        "#!/bin/sh",
        "# semio-build-script-offload",
        "root=${OUT_DIR%/out/out-dir}",
        "mkdir -p out \"$OUT_DIR\"",
        "printf '%s\\n%s\\n' \"$root\" \"$(pwd -P)\" > out/root",
        ": > \"$OUT_DIR/.semio-offload\"",
        "chmod 755 in/run",
        "cd in/manifest || exit 70",
        "exec ../run \"$@\""
      ]
    }
  }
}
