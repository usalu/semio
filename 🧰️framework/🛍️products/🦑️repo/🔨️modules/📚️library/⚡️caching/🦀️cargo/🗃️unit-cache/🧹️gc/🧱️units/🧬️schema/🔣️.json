{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/repo/cargo-build-units/v1",
  "definitions": {
    "Policy": {
      "const": {
        "minimumAgeMilliseconds": 1800000,
        "heldGraceMilliseconds": 10800000,
        "activeBuildMilliseconds": 21600000,
        "idleMilliseconds": 86400000,
        "keepNewestPerCrate": 2,
        "bases": [
          "b/*",
          "t/*",
          "u/l/*",
          "u/l/*/t",
          "components/*/b",
          "components/*/t"
        ],
        "maximumProfileDepth": 2,
        "directory": "build",
        "marker": "fingerprint",
        "usedMarker": "invoked.timestamp",
        "outputDirectory": "out",
        "lockName": ".lock",
        "maximumEntriesPerUnit": 262144,
        "reportedRemovals": 8,
        "yieldEvery": 8,
        "lease": {
          "namespace": "semio.cargo.build-lease/v1",
          "directoryFromStore": ".cache/b/l/m/data",
          "maximumAncestors": 12
        },
        "laneBase": "u/l/*",
        "excludedLaneChildren": [
          "t",
          "v",
          "m"
        ]
      }
    },
    "Reason": {
      "enum": [
        "superseded",
        "pressure"
      ]
    },
    "Unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "crate",
        "profile",
        "bytes",
        "lastUsedMs",
        "held"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "crate": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "lastUsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "held": {
          "type": "boolean"
        }
      }
    },
    "Input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needBytes",
        "nowMs",
        "units"
      ],
      "properties": {
        "needBytes": {
          "type": "integer",
          "minimum": 0
        },
        "budgetBytes": {
          "type": "integer",
          "minimum": 0
        },
        "nowMs": {
          "type": "integer",
          "minimum": 0
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Unit"
          }
        }
      }
    },
    "Removal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "$ref": "#/definitions/Reason"
        }
      }
    },
    "Vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "remove"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/definitions/Input"
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Removal"
          }
        }
      }
    },
    "Messages": {
      "const": {
        "scan": {
          "en": "[repo cache] scanning stale Cargo build units below {root}",
          "de": "[repo cache] durchsuche veraltete Cargo-Build-Einheiten unter {root}"
        },
        "would": {
          "en": "[repo cache] would remove build unit {path} ({bytes}, {reason})",
          "de": "[repo cache] würde Build-Einheit {path} entfernen ({bytes}, {reason})"
        },
        "removed": {
          "en": "[repo cache] removed build unit {path} ({bytes}, {reason})",
          "de": "[repo cache] Build-Einheit {path} entfernt ({bytes}, {reason})"
        },
        "held": {
          "en": "[repo cache] kept build unit {path}: a running compiler holds its lock",
          "de": "[repo cache] Build-Einheit {path} behalten: ein laufender Compiler hält ihre Sperre"
        },
        "busyProfile": {
          "en": "[repo cache] profile {profile} of {directory} is held by running compilers: only the units they use stay",
          "de": "[repo cache] Profil {profile} von {directory} wird von laufenden Compilern gehalten: nur die Einheiten, die sie verwenden, bleiben"
        },
        "summaryPlan": {
          "en": "[repo cache] build units: would remove {count} of {total} ({bytes}); {held} held by running compilers, {kept} kept",
          "de": "[repo cache] Build-Einheiten: würde {count} von {total} entfernen ({bytes}); {held} von laufenden Compilern gehalten, {kept} behalten"
        },
        "summaryApply": {
          "en": "[repo cache] build units: removed {count} of {total} ({bytes}); {held} held by running compilers, {kept} kept",
          "de": "[repo cache] Build-Einheiten: {count} von {total} entfernt ({bytes}); {held} von laufenden Compilern gehalten, {kept} behalten"
        },
        "reason.superseded": {
          "en": "idle for {hours} h and superseded by newer variants of its crate",
          "de": "seit {hours} h ungenutzt und durch neuere Varianten seines Crates abgelöst"
        },
        "reason.pressure": {
          "en": "image below its free-space floor",
          "de": "Image unter der Freiraum-Untergrenze"
        }
      }
    },
    "Cover": {
      "description": "Which units of a profile that compilers hold (its build lease is busy) stay: a build touches the fingerprint of every unit it plans, fresh ones included (Cargo `-Z mtime-on-use`, set in the repository's Cargo config), so a unit used within `activeBuildMilliseconds` or among the newest `keepNewestPerCrate` variants of its crate belongs to an active build and stays; every other unit of the profile may go like in a profile nobody holds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nowMs", "units", "covered"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "nowMs": {"type": "integer", "minimum": 0},
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "lastUsedMs"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "lastUsedMs": {"type": "integer", "minimum": 0}
            }
          }
        },
        "covered": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ImagePlan": {
      "description": "The units of a split partition planned image by image: `mounts` name the image of a unit by the longest leading path (`home` when none leads it), `needs` and `budgets` are what each image must free and the most its units may hold; the removals equal the plan of the units of every image alone, oldest first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "nowMs",
        "units",
        "mounts",
        "needs",
        "remove"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nowMs": {
          "type": "integer",
          "minimum": 0
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Unit"
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prefix",
              "id"
            ],
            "properties": {
              "prefix": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "needs": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Removal"
          }
        }
      }
    },
    "Discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directories",
        "expected"
      ],
      "properties": {
        "directories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
