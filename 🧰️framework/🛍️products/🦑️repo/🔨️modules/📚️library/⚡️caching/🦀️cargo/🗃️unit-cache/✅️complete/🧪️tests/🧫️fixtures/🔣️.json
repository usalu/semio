{
  "vectors": [
    {
      "name": "pipelined library",
      "platform": "darwin",
      "arguments": [
        "--crate-name",
        "equivalent",
        "--crate-type",
        "lib",
        "--emit=dep-info,metadata,link",
        "-C",
        "extra-filename=-0bf2463dafad4359",
        "--out-dir",
        "/o"
      ],
      "expected": [
        "equivalent-0bf2463dafad4359.d",
        "libequivalent-0bf2463dafad4359.rmeta",
        "libequivalent-0bf2463dafad4359.rlib"
      ],
      "runnable": true
    },
    {
      "name": "library without extra filename and joined emit",
      "platform": "linux",
      "arguments": [
        "--crate-name=plain",
        "--crate-type=rlib",
        "--emit=dep-info,link",
        "--out-dir=/o"
      ],
      "expected": [
        "plain.d",
        "libplain.rlib"
      ],
      "runnable": true
    },
    {
