  "announcements": [
    {
      "name": "three artifacts",
      "text": "{\"$message_type\":\"artifact\",\"artifact\":\"/o/libx-1.rmeta\",\"emit\":\"metadata\"}\n{\"$message_type\":\"artifact\",\"artifact\":\"/o/libx-1.rlib\",\"emit\":\"link\"}\n{\"$message_type\":\"artifact\",\"artifact\":\"/o/x-1.d\",\"emit\":\"dep-info\"}\n",
      "paths": [
        "/o/libx-1.rmeta",
        "/o/libx-1.rlib",
        "/o/x-1.d"
      ]
    },
    {
      "name": "diagnostics and other emits are ignored",
      "text": "{\"$message_type\":\"diagnostic\",\"message\":\"artifact\"}\n{\"$message_type\":\"artifact\",\"artifact\":\"/o/y.ll\",\"emit\":\"llvm-ir\"}\nwarning: plain text\n{\"artifact\":\"/o/y.d\",\"emit\":\"dep-info\"}\n",
      "paths": [
        "/o/y.d"
      ]
    },
    {
      "name": "repeated artifacts count once",
      "text": "{\"artifact\":\"/o/z.d\",\"emit\":\"dep-info\"}\n{\"artifact\":\"/o/z.d\",\"emit\":\"dep-info\"}\nnot json {\n",
      "paths": [
