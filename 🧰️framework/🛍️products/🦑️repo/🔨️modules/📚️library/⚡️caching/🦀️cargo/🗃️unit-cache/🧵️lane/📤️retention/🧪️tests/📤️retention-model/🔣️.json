{
 "version": 1,
 "policy": {
  "ledgerPattern": "^cargo-unit-provenance-[A-Za-z0-9._-]{1,200}\\.json$",
  "maximumFiles": 4096,
  "maximumFileBytes": 134217728,
  "layout": {
   "lanes": "l",
   "build": "b",
   "target": "t"
  }
 },
 "plan": [
  {
   "id": "an empty shared ledger receives every receipt in name order",
   "lane": [
    {
     "name": "cargo-unit-provenance-b.json",
     "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-a.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    }
   ],
   "shared": [],
   "expect": [
    {
     "action": "publish",
     "name": "cargo-unit-provenance-a.json",
     "bytes": 100
    },
    {
     "action": "publish",
     "name": "cargo-unit-provenance-b.json",
     "bytes": 100
    }
   ]
  },
  {
   "id": "the same bytes under the same name are dropped",
   "lane": [
    {
     "name": "cargo-unit-provenance-a.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    }
   ],
   "shared": [
    {
     "name": "cargo-unit-provenance-a.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    }
   ],
   "expect": [
    {
     "action": "same",
     "name": "cargo-unit-provenance-a.json",
     "bytes": 100
    }
   ]
  },
  {
   "id": "another digest under the same name is a conflict and never published",
   "lane": [
    {
     "name": "cargo-unit-provenance-a.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    }
   ],
   "shared": [
    {
     "name": "cargo-unit-provenance-a.json",
     "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
     "bytes": 100
    }
   ],
   "expect": [
    {
     "action": "conflict",
     "name": "cargo-unit-provenance-a.json",
     "bytes": 100
    }
   ]
  },
  {
   "id": "a mixed set decides every name on its own",
   "lane": [
    {
     "name": "cargo-unit-provenance-1.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-2.json",
     "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-3.json",
     "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
     "bytes": 100
    }
   ],
   "shared": [
    {
     "name": "cargo-unit-provenance-2.json",
     "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-3.json",
     "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-9.json",
     "sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
     "bytes": 100
    }
   ],
   "expect": [
    {
     "action": "publish",
     "name": "cargo-unit-provenance-1.json",
     "bytes": 100
    },
    {
     "action": "same",
     "name": "cargo-unit-provenance-2.json",
     "bytes": 100
    },
    {
     "action": "conflict",
     "name": "cargo-unit-provenance-3.json",
     "bytes": 100
    }
   ]
  },
  {
   "id": "names outside the ledger pattern are ignored",
   "lane": [
    {
     "name": ".tmp-x",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    },
    {
     "name": "notes.txt",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-a/b.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-a.json\n",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-é.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    },
    {
     "name": "cargo-unit-provenance-ok.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    }
   ],
   "shared": [],
   "expect": [
    {
     "action": "publish",
     "name": "cargo-unit-provenance-ok.json",
     "bytes": 100
    }
   ]
  },
  {
   "id": "a receipt over the byte bound is refused, one exactly at the bound is published",
   "lane": [
    {
     "name": "cargo-unit-provenance-big.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 134217729
    },
    {
     "name": "cargo-unit-provenance-edge.json",
     "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
     "bytes": 134217728
    }
   ],
   "shared": [],
   "expect": [
    {
     "action": "refuse",
     "name": "cargo-unit-provenance-big.json",
     "bytes": 134217729
    },
    {
     "action": "publish",
     "name": "cargo-unit-provenance-edge.json",
     "bytes": 134217728
    }
   ]
  },
  {
   "id": "an empty lane plans nothing",
   "lane": [],
   "shared": [
    {
     "name": "cargo-unit-provenance-a.json",
     "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "bytes": 100
    }
   ],
   "expect": []
  }
 ],
 "origin": [
  {
   "id": "the shared build and target directories are owned",
   "cacheRoot": "/s/u",
   "shared": {
    "build": "/s/m/b/prototype",
    "target": "/s/m/t/prototype"
   },
   "origin": {
    "buildDirectory": "/s/m/b/prototype",
    "targetDirectory": "/s/m/t/prototype"
   },
   "expect": true,
   "lane": false
  },
  {
