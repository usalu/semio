{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "chargeBytes": 4294967296,
        "parentMetadataBytes": 67108864,
        "maximumBackingBytes": 4227858432,
        "filesystemBytes": 4226809856,
        "maximumSlots": 8,
        "maximumCatalogBytes": 32768,
        "maximumEntries": 262144,
        "maximumDepth": 64,
        "maximumPathBytes": 256,
        "maximumPending": 32,
        "maximumOutputBytes": 16777216,
        "maximumOutputLines": 65536,
        "namespace": "cs",
        "workDirectory": "w",
        "slotDirectory": "i",
        "catalogFile": "slots.json",
        "chargeFile": "compiler-state.json",
        "intentFile": "compiler-state.intent.json",
        "volumeDirectory": "v",
        "minimumAvailableBytes": 1073741824,
        "initialParentFloorBytes": 4294967296,
        "owner": "repo:compiler-state:prototype",
        "workspaceOwner": "repo:compiler:prototype",
        "workspaceFile": "compiler-prototype.json",
        "outputDirectory": "b/p",
        "producerFilesystemBytes": 1073741824,
        "producerMetadataBytes": 65536,
        "catalogueMetadataBytes": 67108864
      }
    },
    "Environment": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 32768
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "EnvironmentPolicy": {
      "const": {
        "maximumEntries": 512,
        "maximumBytes": 2097152,
        "maximumNameBytes": 128,
        "maximumValueBytes": 32768,
        "semanticName": "^SEMIO_[A-Za-z0-9_]+$",
        "machine": [
          "PATH",
          "SystemRoot",
          "WINDIR",
          "PATHEXT",
          "RUSTUP_HOME",
          "RUSTC_BOOTSTRAP",
          "RUST_MIN_STACK"
        ],
        "owned": [
          "SEMIO_SCRIPT_PROCESS_INVOCATION",
          "SEMIO_COMPILER_CAPACITY_HELD",
          "SEMIO_COMPILER_PARALLELISM",
          "TMPDIR",
          "TMP",
          "TEMP"
        ]
      }
    },
    "FundingKind": {
      "enum": [
        "compiler-state",
        "compiler-store"
      ]
    },
    "FundingRefusalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "failure",
        "effects"
      ],
      "properties": {
        "name": {
          "enum": [
            "state-store",
            "state-operation",
            "state-funding",
            "compile-state",
            "compile-store",
            "compile-store-prototype",
            "compile-absent"
          ]
        },
        "failure": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "const": 0
        }
      }
    }
  }
}
