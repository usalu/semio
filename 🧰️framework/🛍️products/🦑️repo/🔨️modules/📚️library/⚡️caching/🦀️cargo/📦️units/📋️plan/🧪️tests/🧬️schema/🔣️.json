{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutations",
    "graphs",
    "construction"
  ],
  "properties": {
    "mutations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MutationCase"
      }
    },
    "graphs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GraphCase"
      }
    },
    "construction": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ConstructionCase"
      }
    }
  },
  "definitions": {
    "MutationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "value": {
          "type": "string"
        }
      }
    },
    "GraphCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "admitted"
      ],
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "admitted": {
          "type": "boolean"
        }
      }
    },
    "ConstructionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reverse",
        "unicode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reverse": {
          "type": "boolean"
        },
        "unicode": {
          "type": "boolean"
        }
      }
    }
  }
}
