{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/rust-rlib-command-recipe-v1",
  "$ref": "#/definitions/Recipe",
  "definitions": {
    "Policy": {
      "const": {
        "maximumBytes": 16777216,
        "maximumDependencies": 4096
      }
    },
    "Argument": {
      "type": "string",
      "maxLength": 32768,
      "pattern": "^[^\u0000]*$"
    },
    "Path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\u0000]+$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "digest",
        "sysrootDigest",
        "linkerDigest"
      ],
      "properties": {
        "program": {
          "$ref": "#/definitions/Path"
        },
        "digest": {
          "$ref": "#/definitions/Digest"
        },
        "sysrootDigest": {
          "$ref": "#/definitions/Digest"
        },
        "linkerDigest": {
          "$ref": "#/definitions/Digest"
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "path",
        "prefix"
      ],
      "properties": {
        "location": {
          "const": "source"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\\\:\u0000]+$"
        },
        "prefix": {
          "$ref": "#/definitions/Argument"
        }
      }
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "prefix"
      ],
      "properties": {
        "location": {
          "enum": [
            "output",
            "dep-info",
            "incremental"
          ]
        },
        "prefix": {
          "$ref": "#/definitions/Argument"
        }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "unit",
        "prefix"
      ],
      "properties": {
        "location": {
          "enum": [
            "dependency-output",
            "dependency-directory"
          ]
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,79}$"
        },
        "prefix": {
          "$ref": "#/definitions/Argument"
        }
      }
    },
    "Token": {
      "anyOf": [
        {
          "$ref": "#/definitions/Argument"
        },
        {
          "$ref": "#/definitions/Source"
        },
        {
          "$ref": "#/definitions/Location"
        },
        {
          "$ref": "#/definitions/Dependency"
        }
      ]
    },
    "Temporary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location"
      ],
      "properties": {
        "location": {
          "const": "temporary"
        }
      }
    },
    "Execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location"
      ],
      "properties": {
        "location": {
          "const": "execution"
        }
      }
    },
    "Recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "compiler",
        "cwd",
        "arguments",
        "cfgArguments",
        "environment",
        "outputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "compiler": {
          "$ref": "#/definitions/Compiler"
        },
        "cwd": {
          "$ref": "#/definitions/Execution"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Token"
          }
        },
        "cfgArguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Argument"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/definitions/Argument"
              },
              {
                "$ref": "#/definitions/Temporary"
              }
            ]
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_-]+\\.rlib$"
          }
        }
      }
    }
  }
}
