{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "unit",
    "semanticDigest",
    "mode",
    "dependencyDigests",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "semanticDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "dependencyDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "semanticDigest",
          "artifactDigest"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "semanticDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifactDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f])(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\u0000-\\u001f]+$",
            "maxLength": 200
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
