{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "unit",
    "semanticDigest",
    "mode",
    "dependencyDigests",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "semanticDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "dependencyDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "semanticDigest",
          "artifactDigest"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "semanticDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifactDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 4096
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f])(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\u0000-\\u001f]+$",
            "maxLength": 200
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "maxItems": 4096
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumReceiptBytes": 1048576,
        "maximumArtifactFiles": 4096,
        "maximumDependencyDigests": 4096,
        "maximumDirectories": 65536,
        "maximumArtifactFileBytes": 536870912,
        "maximumSourceBytes": 8388608,
        "maximumPolicyBytes": 65536
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumBytes",
            "initialBytes",
            "finalBytes"
          ],
          "properties": {
            "maximumBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            },
            "initialBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870912
            },
            "finalBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870912
            }
          }
        }
      }
    }
  }
}
