{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maxSourceBytes",
        "maxSourceFiles",
        "maxActiveLines"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "maxSourceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxSourceFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxActiveLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumSourceBytes",
        "maximumSourceFiles",
        "maximumArtifactBytes"
      ],
      "properties": {
        "maximumSourceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumSourceFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
