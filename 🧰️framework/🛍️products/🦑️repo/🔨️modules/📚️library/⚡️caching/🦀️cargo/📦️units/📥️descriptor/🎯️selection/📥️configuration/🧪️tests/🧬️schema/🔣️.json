{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packages",
    "edges",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "base",
          "consumer",
          "sibling"
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "additionalItems": false,
        "items": [
          {
            "type": "string",
            "enum": [
              "base",
              "consumer",
              "sibling"
            ]
          },
          {
            "type": "string",
            "enum": [
              "base",
              "consumer",
              "sibling"
            ]
          }
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/definitions/Case"
      }
    }
  },
  "definitions": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "affected"
      ],
      "properties": {
        "name": {
          "enum": [
            "baseline",
            "workspace-member",
            "lock-comment",
            "lock-row",
            "unused-config",
            "unconsumed-manifest",
            "profile",
            "package-env",
            "sibling-env",
            "source",
            "manifest-included",
            "cfg",
            "feature",
            "compiler",
            "sealed-program",
            "sealed-receipt"
          ]
        },
        "affected": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "base",
              "consumer",
              "sibling"
            ]
          }
        }
      }
    }
  }
}
