{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/rust-unit-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "package",
    "manifest",
    "target",
    "mode",
    "profile",
    "features",
    "cfg",
    "compiler",
    "arguments",
    "environment",
    "inputs",
    "dependencies",
    "outputs",
    "limits",
    "cfgSnapshot",
    "profileData",
    "packageIdentity",
    "operation",
    "evidence",
    "execution"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,79}$"
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "string",
      "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f])(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\u0000-\\u001f]+$",
      "maxLength": 200
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "role",
        "triple",
        "entry",
        "edition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "library",
            "binary",
            "proc-macro",
            "build-script",
            "test",
            "link"
          ]
        },
        "role": {
          "enum": [
            "host",
            "target"
          ]
        },
        "triple": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f])(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\u0000-\\u001f]+$",
          "maxLength": 200
        },
        "edition": {
          "enum": [
            "2015",
            "2018",
            "2021",
            "2024"
          ]
        }
      }
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cfg": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "digest",
        "sysrootDigest",
        "linkerDigest"
      ],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sysrootDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "linkerDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "propertyNames": {
        "not": {
          "const": "SEMIO_SCRIPT_PROCESS_INVOCATION"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "bytes",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f])(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\u0000-\\u001f]+$",
            "maxLength": 200
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "source",
              "generated",
              "configuration",
              "toolchain"
            ]
          }
        }
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "artifactDigest",
          "externName",
          "public",
          "noprelude"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "artifactDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "externName": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "public": {
            "type": "boolean"
          },
          "noprelude": {
            "type": "boolean"
          }
        }
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f])(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\u0000-\\u001f]+$",
        "maxLength": 200
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumSourceBytes",
        "maximumSourceFiles",
        "maximumArtifactBytes"
      ],
      "properties": {
        "maximumSourceBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumSourceFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maximumArtifactBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cfgSnapshot": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "profileData": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "opt_level",
        "lto",
        "codegen_backend",
        "codegen_units",
        "debuginfo",
        "split_debuginfo",
        "debug_assertions",
        "overflow_checks",
        "rpath",
        "incremental",
        "panic",
        "strip"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "opt_level": {
          "enum": [
            "0",
            "1",
            "2",
            "3",
            "s",
            "z"
          ]
        },
        "lto": {
          "enum": [
            "false",
            "off",
            "thin",
            "fat",
            "true"
          ]
        },
        "codegen_backend": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "codegen_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 256
        },
        "debuginfo": {
          "enum": [
            null,
            0,
            1,
            2,
            "none",
            "limited",
            "full",
            "line-tables-only",
            "line-directives-only"
          ]
        },
        "split_debuginfo": {
          "enum": [
            null,
            "off",
            "packed",
            "unpacked"
          ]
        },
        "debug_assertions": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "overflow_checks": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rpath": {
          "type": "boolean"
        },
        "incremental": {
          "type": "boolean"
        },
        "panic": {
          "enum": [
            "abort",
            "unwind"
          ]
        },
        "strip": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resolved"
              ],
              "properties": {
                "resolved": {
                  "oneOf": [
                    {
                      "const": "None"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "Named"
                      ],
                      "properties": {
                        "Named": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "deferred"
              ],
              "properties": {
                "deferred": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          ]
        },
        "trim_paths": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "enum": [
              "diagnostics",
              "macro",
              "object"
            ]
          }
        }
      },
      "definitions": {
        "SchedulerSuffix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "-Zthreads=1"
          }
        }
      }
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity"
          ],
          "properties": {
            "kind": {
              "enum": [
                "workspace",
                "registry",
                "git",
                "external-path"
              ]
            },
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      }
    },
    "operation": {
      "enum": [
        "build",
        "check",
        "test",
        "doc",
        "doctest",
        "run-custom-build"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "compilation"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compilation": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "policy"
      ],
      "properties": {
        "policy": {
          "enum": [
            "compiler-context-v2",
            "temporary-v1"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
