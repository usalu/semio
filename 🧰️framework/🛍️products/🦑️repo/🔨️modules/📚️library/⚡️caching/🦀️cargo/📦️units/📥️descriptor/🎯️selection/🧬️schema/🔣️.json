{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifest",
    "cwd",
    "arguments",
    "mode"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    }
  },
  "$defs": {
    "DataPolicy": {
      "const": {
        "maximumSelections": 65536,
        "maximumArguments": 4096,
        "maximumArgumentBytes": 1048576,
        "maximumEnvironmentEntries": 4096,
        "maximumEnvironmentBytes": 1048576
      }
    }
  }
}
