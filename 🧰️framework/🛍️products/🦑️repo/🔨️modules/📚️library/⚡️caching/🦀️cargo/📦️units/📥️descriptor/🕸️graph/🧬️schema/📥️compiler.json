{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "programDigest",
    "hostTriple"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "digest",
        "sysrootDigest",
        "linkerDigest"
      ],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sysrootDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "linkerDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "programDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hostTriple": {
      "type": "string",
      "minLength": 1
    }
  }
}
