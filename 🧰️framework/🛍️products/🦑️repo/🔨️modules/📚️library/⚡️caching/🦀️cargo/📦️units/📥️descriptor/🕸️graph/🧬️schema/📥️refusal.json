{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit",
    "reason",
    "adapters"
  ],
  "properties": {
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "foreign-source",
          "binary",
          "proc-macro",
          "build-script",
          "build-script-run",
          "compiler-operation",
          "library-output"
        ]
      }
    }
  }
}
