    "entry",
    "cache",
    "projectRoot",
    "compiler"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "entry": {
      "const": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/📦️units/🏗️compiler/📥️entry/📜️script.ts"
