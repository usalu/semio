{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "bytes",
    "limits",
    "accepted"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "integer"
      }
    },
    "accepted": {
      "type": "boolean"
    }
  },
  "definitions": {
    "Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "accepted"
      ],
      "properties": {
        "name": {
          "enum": [
            "Cargo.toml",
            "Cargo.lock",
            "sealed/code.mjs"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "RequestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "Aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "accepted"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "Epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "stage",
        "accepted"
      ],
      "properties": {
        "target": {
          "enum": [
            "source",
            "policy"
          ]
        },
        "stage": {
          "enum": [
            "entry",
            "delivery"
          ]
        },
        "accepted": {
          "const": false
        }
      }
    },
    "Guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "stage",
        "accepted"
      ],
      "properties": {
        "target": {
          "enum": [
            "source",
            "policy"
          ]
        },
        "stage": {
          "enum": [
            "entry",
            "delivery",
            "bootstrap"
          ]
        },
        "accepted": {
          "const": false
        }
      }
    }
  }
}
