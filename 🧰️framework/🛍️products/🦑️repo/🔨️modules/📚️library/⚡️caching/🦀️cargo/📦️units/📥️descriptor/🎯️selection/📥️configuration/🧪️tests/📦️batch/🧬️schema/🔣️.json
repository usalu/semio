{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "files",
    "manifests",
    "changes",
    "epochs",
    "limit",
    "empty",
    "guards"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "manifests": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "accepted"
        ],
        "properties": {
          "name": {
            "enum": [
              "unchanged",
              "changed",
              "added",
              "removed"
            ]
          },
          "kind": {
            "enum": [
              "none",
              "write",
              "remove"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "epochs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "stage"
        ],
        "properties": {
          "target": {
            "enum": [
              "source",
              "policy"
            ]
          },
          "stage": {
            "enum": [
              "entry",
              "delivery"
            ]
          }
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commonBytes",
        "manifestBytes",
        "accepted"
      ],
      "properties": {
        "commonBytes": {
          "const": 67108864
        },
        "manifestBytes": {
          "const": 1
        },
        "accepted": {
          "const": false
        }
      }
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestReads",
        "commonOpens"
      ],
      "properties": {
        "manifestReads": {
          "const": 0
        },
        "commonOpens": {
          "const": 0
        }
      }
    },
    "guards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "message"
        ],
        "properties": {
          "name": {
            "enum": [
              "proxy",
              "escape"
            ]
          },
          "message": {
            "enum": [
              "Canonical finite Source root required",
              "Owned Cargo coordinate required"
            ]
          }
        }
      }
    }
  }
}
