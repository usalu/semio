{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/caching/module-source-references/v1",
  "title": "Module Source References",
  "description": "Literal runtime module specifiers grouped by the import or require resolution mode selected by their source syntax. These facts do not resolve or authorize files.",
  "type": "object",
  "required": [
    "version",
    "imports",
    "requires"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "imports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
