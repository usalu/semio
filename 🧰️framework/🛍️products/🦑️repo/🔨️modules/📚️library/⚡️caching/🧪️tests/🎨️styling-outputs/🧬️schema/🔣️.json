{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "project", "package", "source", "output", "assembly", "type", "field", "values"],
  "properties": {
    "owner": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "package": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "output": { "const": "dist/build" },
    "assembly": { "type": "string", "pattern": "\\.dll$" },
    "type": { "type": "string", "minLength": 1 },
    "field": { "type": "string", "minLength": 1 },
    "values": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^#[0-9a-f]{6}$" } }
  }
}
