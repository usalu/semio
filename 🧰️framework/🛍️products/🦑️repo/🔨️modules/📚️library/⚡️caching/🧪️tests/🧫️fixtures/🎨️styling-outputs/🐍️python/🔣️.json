{
  "owner": "🧰️framework/🔨️modules/🖱️ui/🎨️styling",
  "project": "@semio-tech/ui-styling-py",
  "package": "📦️packages/🐍️python",
  "source": "🔤️tokens/🐍️.py",
  "backend": "hatchling==1.27.0",
  "module": "🎨️styling.🐍️",
  "wheel": "semio_framework_ui_styling-0.1.0-py3-none-any.whl",
  "values": [
    "#ff344f",
    "#123456"
  ],
  "outputs": [
    "{workspaceRoot}/.cache/b/p/m/python/ui-styling/{options.env.SEMIO_BUILD_MODE}"
  ],
  "runtimeCases": [
    {
      "operation": "cold",
      "runs": 1,
      "sameBytes": true
    },
    {
      "operation": "warm",
      "runs": 1,
      "sameBytes": true
    },
    {
      "operation": "restore",
      "runs": 1,
      "sameBytes": true
    },
    {
      "operation": "source-change",
      "runs": 2,
      "sameBytes": false
    },
    {
      "operation": "backend-failure",
      "runs": 2,
      "sameBytes": true
    }
  ]
}
