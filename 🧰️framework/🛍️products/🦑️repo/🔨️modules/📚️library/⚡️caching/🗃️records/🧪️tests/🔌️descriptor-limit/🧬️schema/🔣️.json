{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "namespace",
    "limit",
    "packs",
    "records"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "namespace": {
      "type": "string"
    },
    "limit": {
      "const": 32
    },
    "packs": {
      "type": "integer",
      "minimum": 33
    },
    "records": {
      "type": "array",
      "minItems": 33,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "text",
          "digest"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      }
    }
  }
}
