{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry",
    "environments",
    "forbiddenImports",
    "cargo",
    "bindgenLock",
    "browserPaths",
    "rejected"
  ],
  "properties": {
    "browserPaths": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "expected"
        ],
        "properties": {
          "input": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entry": {
      "type": "string"
    },
    "bindgenLock": {
      "type": "string"
    },
    "forbiddenImports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "commands"
        ],
        "properties": {
          "kind": {
            "enum": [
              "python",
              "cargo",
              "go",
              "dotnet",
              "cpp",
              "browsers",
              "wasm",
              "trunk",
              "tools",
              "cargo-lock"
            ]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "files",
        "invalidLock"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "required": [
            "Cargo.toml",
            "Cargo.lock",
            "🦀️.rs"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "invalidLock": {
          "type": "string"
        }
      }
    }
  }
}
