{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "files",
    "contracts",
    "cases",
    "nativeTargets",
    "arguments"
  ],
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "ownership",
          "ownerPath",
          "target",
          "nativeConsumers",
          "inputPatterns",
          "outputRoots"
        ],
        "properties": {
          "nativeConsumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^./][^\\\\]*$"
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "root",
          "tests",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "tests": {
            "type": "boolean"
          },
          "targets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nativeTargets": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "build",
          "check",
          "test"
        ]
      }
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "args",
          "valid"
        ],
        "properties": {
          "operation": {
            "enum": [
              "build",
              "check",
              "test"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
