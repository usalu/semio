{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "files",
    "contracts",
    "cases",
    "nativeTargets",
    "arguments",
    "artifactArguments",
    "artifactProgress",
    "artifactCapture",
    "generatedWrites",
    "artifactTestRunner"
  ],
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "ownership",
          "ownerPath",
          "target",
          "nativeConsumers",
          "inputPatterns",
          "outputRoots"
        ],
        "properties": {
          "nativeConsumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^./][^\\\\]*$"
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "root",
          "tests",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "tests": {
            "type": "boolean"
          },
          "targets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nativeTargets": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "build",
          "check",
          "test"
        ]
      }
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "args",
          "valid"
        ],
        "properties": {
          "operation": {
            "enum": [
              "build",
              "check",
              "test"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    },
    "artifactArguments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "args",
          "valid",
          "cargoArgs"
        ],
        "properties": {
          "operation": {
            "enum": [
              "build",
              "check",
              "test"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valid": {
            "type": "boolean"
          },
          "cargoArgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifactProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "intervalMs",
        "pattern"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "artifactCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency",
        "primary",
        "replacement",
        "delayMs"
      ],
      "properties": {
        "dependency": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "string",
          "minLength": 1
        },
        "delayMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "generatedWrites": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "initial",
          "next",
          "rewritten"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "initial": {
            "type": "string"
          },
          "next": {
            "type": "string"
          },
          "rewritten": {
            "type": "boolean"
          }
        }
      }
    },
    "artifactTestRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "level",
        "includedSkips",
        "excludedSkips",
        "runtimeFilters",
        "required",
        "forbidden"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "level": {
          "enum": [
            "fundamental",
            "quick",
            "long",
            "exhaustive"
          ]
        },
        "includedSkips": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excludedSkips": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "runtimeFilters": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
