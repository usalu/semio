{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.semio-tech.com/repo/artifact-packages/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "rust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargoName", "nxName", "manifest"],
      "properties": {
        "cargoName": { "type": "string", "pattern": "^semio-(?:s|framework)-artifact-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "nxName": { "type": "string", "pattern": "^@semio-tech/[a-z0-9]+(?:-[a-z0-9]+)*-rs$" },
        "manifest": { "$ref": "#/$defs/path" }
      }
    },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nxName", "manifest", "entry"],
      "properties": {
        "name": { "type": "string", "pattern": "^@semio-tech/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "nxName": { "type": "string", "pattern": "^@semio-tech/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "manifest": { "$ref": "#/$defs/path" },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["types", "import"],
          "properties": {
            "types": { "const": "./dist/🟦️.d.ts" },
            "import": { "const": "./dist/🟦️.js" }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "source", "rust"],
      "properties": {
        "root": { "$ref": "#/$defs/path" },
        "source": { "$ref": "#/$defs/path" },
        "rust": { "$ref": "#/$defs/rust" },
        "typescript": { "$ref": "#/$defs/typescript" }
      }
    }
  }
}
