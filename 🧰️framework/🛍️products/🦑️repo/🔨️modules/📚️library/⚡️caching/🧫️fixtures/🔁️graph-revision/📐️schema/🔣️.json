{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "library",
    "files",
    "runtimes",
    "helpers",
    "expected",
    "installationSchema",
    "component",
    "commandSources"
  ],
  "properties": {
    "library": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "enum": [
          "bun",
          "node"
        ]
      }
    },
    "helpers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "cache",
          "executor"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "cache": {
            "type": "boolean"
          },
          "executor": {
            "type": "string"
          }
        }
      }
    },
    "installationSchema": {
      "type": "string"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargo",
        "directoryName",
        "targets",
        "absent"
      ],
      "properties": {
        "cargo": {
          "type": "string"
        },
        "directoryName": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commandSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
