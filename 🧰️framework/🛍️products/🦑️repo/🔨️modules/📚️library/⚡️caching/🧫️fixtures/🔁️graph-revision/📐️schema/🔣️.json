{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "library",
    "files",
    "runtimes",
    "helpers",
    "expected"
  ],
  "properties": {
    "library": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "enum": [
          "bun",
          "node"
        ]
      }
    },
    "helpers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "cache",
          "executor"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "cache": {
            "type": "boolean"
          },
          "executor": {
            "type": "string"
          }
        }
      }
    }
  }
}

