{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases", "maximumConcurrentComputations", "failures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "failures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["configuration", "plugins", "nodes", "dependencies"] } },
    "maximumConcurrentComputations": { "const": 1 },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "phase", "changes", "requests", "invalidate", "plugins", "dotenv", "computations"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "phase": { "enum": ["nodes", "dependencies"] },
          "changes": { "type": "integer", "minimum": 0 },
          "requests": { "type": "integer", "minimum": 1 },
          "invalidate": { "type": "boolean" },
          "plugins": { "type": "boolean" },
          "dotenv": { "type": "boolean" },
          "computations": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
