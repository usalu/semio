{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "contract",
    "projects",
    "expected",
    "files",
    "changedWorker"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "contract": {
      "type": "object",
      "required": [
        "ownership",
        "ownerPath",
        "target",
        "inputPatterns",
        "outputRoots"
      ],
      "properties": {
        "outputRoots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "inclusion"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "inclusion": {
                "enum": [
                  "ignored",
                  "tracked"
                ]
              },
              "producer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ownerPath",
                  "target"
                ],
                "properties": {
                  "ownerPath": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[^:]+:[^:]+$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "changedWorker": {
      "type": "string"
    }
  }
}
