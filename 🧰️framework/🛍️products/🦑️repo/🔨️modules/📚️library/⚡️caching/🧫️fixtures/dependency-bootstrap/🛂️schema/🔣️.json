{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/test/dependency-bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "entry",
    "command",
    "arguments",
    "dependency",
    "tooling",
    "cancellation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "content"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "packages",
        "graphSources"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "graphSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "signal",
        "timeoutMs"
      ],
      "properties": {
        "actors": {
          "const": [
            "installer",
            "child"
          ]
        },
        "signal": {
          "const": "SIGTERM"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
