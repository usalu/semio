{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/caching/continuous-services/fixtures.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "runs",
    "expectedServices",
    "preservesOtherService",
    "cases",
    "cancellationExitCode",
    "timeouts"
  ],
  "properties": {
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wait", "gate", "service", "health"],
      "properties": {
        "wait": { "type": "integer", "minimum": 1 },
        "gate": { "type": "integer", "minimum": 1 },
        "service": { "type": "integer", "minimum": 1 },
        "health": { "type": "integer", "minimum": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semio"
      ],
      "properties": {
        "semio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "continuousSharing"
          ],
          "properties": {
            "continuousSharing": {
              "const": false
            }
          }
        }
      }
    },
    "runs": {
      "const": [
        "first",
        "second"
      ]
    },
    "expectedServices": {
      "const": 2
    },
    "preservesOtherService": {
      "const": true
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sharing",
          "cancelFirst",
          "services"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sharing": {
            "type": "boolean"
          },
          "cancelFirst": {
            "type": "boolean"
          },
          "services": {
            "enum": [
              1,
              2
            ]
          },
          "vite": {
            "type": "boolean"
          }
        }
      }
    },
    "cancellationExitCode": {
      "const": 130
    }
  }
}
