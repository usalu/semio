{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.caching/NxGraphCacheOwnerV1",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "maximumPoolBytes": 939524096,
        "maximumNamespaceBytes": 536870912,
        "minimumFreeBytes": 1073741824,
        "maximumNamespaces": 64,
        "maximumEntriesPerNamespace": 4096,
        "allocationUnitBytes": 4096,
        "metadataReserveBytes": 16777216,
        "imageControlBytes": 1048576,
        "namespaceMetadataBytes": 4194304,
        "maximumAuxiliaryFileBytes": 67108864,
        "maximumAuxiliaryBytes": 134217728,
        "maximumDaemonDisabledMarkerBytes": 4096,
        "maximumWatchersPerNamespace": 64
      }
    },
    "Namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "toolingIdentity",
        "workspaceRoot",
        "graphIdentity",
        "implementationIdentity"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "toolingIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workspaceRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "graphIdentity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "implementationIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespaceBytes",
        "extraBytes",
        "availableBytes",
        "namespaceLimits"
      ],
      "properties": {
        "namespaceBytes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 939524096
          }
        },
        "extraBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 939524096
        },
        "availableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "namespaceLimits": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          }
        }
      }
    },
    "NativePolicy": {
      "const": {
        "version": 1,
        "maximumPhysicalBytes": 67108864,
        "filesystemBytes": 66060288,
        "directory": "native",
        "environment": "SEMIO_NX_NATIVE_GRAPH_DIRECTORY"
      }
    },
    "NativeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "namespace",
        "directory",
        "maximumPhysicalBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "namespace": {
          "$ref": "#/definitions/Namespace"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maximumPhysicalBytes": {
          "const": 67108864
        }
      }
    },
    "DiagnosticPolicy": {
      "const": {
        "version": 1,
        "environment": "SEMIO_NX_GRAPH_DIAGNOSTIC_DIRECTORY",
        "partition": "diagnostics"
      }
    },
    "DiagnosticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "namespace",
        "watcherIdentity",
        "directory"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "namespace": {
          "$ref": "#/definitions/Namespace"
        },
        "watcherIdentity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            }
          ]
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "AuxiliaryWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "extraBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "extraBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      }
    },
    "DaemonDisabledMarker": {
      "type": "string",
      "maxLength": 4096
    }
  }
}
