{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "allocation",
    "owner",
    "bytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "allocation": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^repository:(rust|tooling|graph|dependencies|products|diagnostics|leases)-store$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 33554432,
      "maximum": 68719476736
    }
  },
  "definitions": {
    "CallbackScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "live"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "live": {
          "const": true
        }
      }
    },
    "QueuedMaintenanceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "maximumWaitMilliseconds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "const": "queued"
        },
        "maximumWaitMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "ConsumerFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "consumer-lifetime"
        }
      }
    },
    "ConsumerFixturePolicy": {
      "const": {
        "version": 1,
        "filesystemBytes": 33554432,
        "capacityBytes": 41943040,
        "allocationBytes": 8388608
      }
    },
    "ConsumerPolicy": {
      "const": {
        "version": 1,
        "maximumPending": 32
      }
    },
    "PhaseOpeningProtocol": {
      "const": {
        "version": 1,
        "arguments": [
          "workspace",
          "id",
          "invocation",
          "phaseControl",
          "body"
        ],
        "normal": [
          "authenticate-phase",
          "open-image",
          "enter-body",
          "drain-body",
          "close-image",
          "retire-owner"
        ],
        "maintenance": [
          "authenticate-phase",
          "open-image",
          "enter-maintenance",
          "drain-maintenance",
          "close-image"
        ],
        "callbackArguments": [
          "store",
          "actualControl"
        ]
      }
    },
    "CallerPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ts$"
      }
    }
  }
}
