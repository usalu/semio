{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectiveCapacityBytes",
        "state",
        "parentIdentity",
        "childDirectory",
        "namespaceDirectory",
        "childPresent",
        "birthDirectoryPresent"
      ],
      "properties": {
        "effectiveCapacityBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "$ref": "https://semio.tech/framework/process/native-storage/v1#/definitions/State"
        },
        "parentIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "childDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "namespaceDirectory": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "childPresent": {
          "type": "boolean"
        },
        "birthDirectoryPresent": {
          "type": "boolean"
        }
      }
    }
  }
}
