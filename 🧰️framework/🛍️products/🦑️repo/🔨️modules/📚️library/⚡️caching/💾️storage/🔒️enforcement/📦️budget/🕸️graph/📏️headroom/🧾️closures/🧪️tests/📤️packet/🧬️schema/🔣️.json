{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maximumWireBytes",
    "maximumReplyBytes",
    "maximumLines",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maximumWireBytes": {
      "const": 16777216
    },
    "maximumLines": {
      "const": 128
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "character",
          "characters",
          "wireBytes",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "character": {
            "enum": [
              "a",
              "é"
            ]
          },
          "characters": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777217
          },
          "wireBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554435
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "maximumReplyBytes": {
      "const": 16764800
    }
  }
}
