{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maximumSnapshotBytes",
    "maximumRetainedBytes",
    "maximumAdmissionAttempts",
    "retention",
    "records"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maximumSnapshotBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "maximumRetainedBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483648
    },
    "maximumAdmissionAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lowWaterBasisPoints",
        "recheckMilliseconds"
      ],
      "properties": {
        "lowWaterBasisPoints": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9900
        },
        "recheckMilliseconds": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "projectsPerYield",
        "edgesPerRecord",
        "externalNodesPerRecord",
        "maximumRecordBytes",
        "compressionLevel",
        "internMinimumItems"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "projectsPerYield": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "edgesPerRecord": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "externalNodesPerRecord": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximumRecordBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "compressionLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "internMinimumItems": {
          "type": "integer",
          "minimum": 2,
          "maximum": 65536
        }
      }
    }
  }
}
