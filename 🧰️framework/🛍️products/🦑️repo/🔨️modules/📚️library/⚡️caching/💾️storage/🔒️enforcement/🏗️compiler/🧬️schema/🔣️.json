{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/repo/storage/compiler-store/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "allocation",
    "owner",
    "bytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "allocation": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^repo:compiler:(prototype|release)$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
