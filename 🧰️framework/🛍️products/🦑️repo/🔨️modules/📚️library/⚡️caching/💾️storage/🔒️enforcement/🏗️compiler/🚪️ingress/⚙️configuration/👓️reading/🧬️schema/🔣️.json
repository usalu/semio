{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "maxItems": 64,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "sha256",
      "bytes"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4456448
      }
    }
  }
}
