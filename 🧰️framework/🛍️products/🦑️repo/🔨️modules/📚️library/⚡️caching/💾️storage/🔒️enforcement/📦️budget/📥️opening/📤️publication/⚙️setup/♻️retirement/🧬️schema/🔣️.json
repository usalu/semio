{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "Protocol": {
      "const": {
        "maximumRetirements": 4096,
        "maximumPlanBytes": 67108864,
        "progressResource": "dependencies:obsolete-retired",
        "returns": "physical-generation-prefixes",
        "unknown": "refuse-before-effects",
        "authority": "genuine-fresh-parent-and-selected-owner-each-phase",
        "unreadyPayloadRoles": [
          "node_modules",
          "w",
          "patches",
          "package.json",
          "{{lockFile}}",
          "{{scopeConfig}}"
        ],
        "capsuleRoles": [
          "i",
          "p",
          "r"
        ],
        "capsuleMetadataRoles": [
          "i",
          "r"
        ],
        "inactiveMissingReferences": "fresh-complete-roster-absence-and-exclusive-target-pin"
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "artifact",
        "current",
        "roles",
        "generations",
        "candidates",
        "selected",
        "wholeAllocationRetired",
        "publicationRetirementDispatches"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "current-selected-dependency-plan"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "purpose",
            "action",
            "policy",
            "backing",
            "journalSha256",
            "journalBytes",
            "allocation"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "purpose": {
              "const": "current-artifact-maintenance"
            },
            "action": {
              "const": "retain-allocation-payload"
            },
            "policy": {
              "type": "object"
            },
            "backing": {
              "type": "object"
            },
            "journalSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "journalBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "allocation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "owner",
                "kind",
                "phase",
                "bytes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                },
                "owner": {
                  "const": "repository:dependencies-store"
                },
                "kind": {
                  "const": "artifact-publication"
                },
                "phase": {
                  "const": "committed"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "scopes",
            "sha256"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "members",
                  "generation",
                  "receiptFingerprint",
                  "bindings"
                ],
                "properties": {
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "members": {
                    "type": "array",
                    "maxItems": 4095,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "generation": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "receiptFingerprint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "bindings": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4096,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "sourceDirectory",
                        "targetDirectory"
                      ],
                      "properties": {
                        "sourceDirectory": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "targetDirectory": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      }
                    }
                  }
                }
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stamp",
            "names"
          ],
          "properties": {
            "stamp": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "names": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "generations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stamp",
            "names"
          ],
          "properties": {
            "stamp": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "names": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{20}|\\.p[a-f0-9]{8})$"
              }
            }
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prefix",
              "generation",
              "status",
              "receiptFingerprint",
              "rootStamp",
              "roles",
              "ownerReferences",
              "payloadQualified"
            ],
            "properties": {
              "prefix": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{20}|\\.p[a-f0-9]{8})$"
              },
              "generation": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "active",
                  "inactive",
                  "unqualified",
                  "unready",
                  "retained-unready",
                  "unready-metadata"
                ]
              },
              "receiptFingerprint": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rootStamp": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "roles": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "ownerReferences": {
                "type": "array",
                "maxItems": 63,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "scope",
                    "generation"
                  ],
                  "properties": {
                    "scope": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "generation": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "payloadQualified": {
                "const": false
              }
            }
          }
        },
        "selected": {
          "type": "null"
        },
        "wholeAllocationRetired": {
          "const": false
        },
        "publicationRetirementDispatches": {
          "const": 0
        }
      }
    },
    "AcquiredPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquired",
        "value"
      ],
      "properties": {
        "acquired": {
          "const": true
        },
        "value": {
          "$ref": "#/$defs/Plan"
        }
      }
    },
    "AcquiredSettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquired",
        "value"
      ],
      "properties": {
        "acquired": {
          "const": true
        },
        "value": {
          "$ref": "#/$defs/SelectedRetirementResult"
        }
      }
    }
  }
}
