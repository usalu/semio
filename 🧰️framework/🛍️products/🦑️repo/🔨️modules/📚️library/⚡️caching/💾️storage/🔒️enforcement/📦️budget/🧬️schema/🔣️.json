{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maximumBytes",
    "maximumControlBytes",
    "partitions",
    "reclaim"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maximumBytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 274877906944
    },
    "maximumControlBytes": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 16777216
    },
    "partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rust",
        "tools",
        "graph",
        "dependencies",
        "products",
        "diagnostics",
        "nx",
        "leases"
      ],
      "properties": {
        "rust": {
          "$ref": "#/$defs/partition"
        },
        "tools": {
          "$ref": "#/$defs/partition"
        },
        "graph": {
          "$ref": "#/$defs/partition"
        },
        "dependencies": {
          "$ref": "#/$defs/partition"
        },
        "products": {
          "$ref": "#/$defs/partition"
        },
        "diagnostics": {
          "$ref": "#/$defs/partition"
        },
        "nx": {
          "$ref": "#/$defs/partition"
        },
        "leases": {
          "$ref": "#/$defs/partition"
        }
      }
    },
    "reclaim": {
      "$ref": "#/$defs/reclaimRule"
    },
    "elastic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "products",
        "rust"
      ],
      "properties": {
        "graph": {
          "$ref": "#/$defs/elasticPartition"
        },
        "products": {
          "$ref": "#/$defs/elasticPartition"
        },
        "rust": {
          "$ref": "#/$defs/elasticPartition"
        }
      }
    }
  },
  "$defs": {
    "reclaimRule": {
      "description": "When the host allocation of an image counts as bloat for every partition without an elastic rule of its own; an idle bloated image is reclaimed in place by `repo cache gc` (an attach through the UNMAP-capable stack returns the blocks freed inside to the host), never recreated.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reclaimFloorBytes", "reclaimRatioPercent", "reclaimTightHostFreeBytes"],
      "properties": {
        "reclaimFloorBytes": {"type": "integer", "minimum": 1048576, "maximum": 103080263680},
        "reclaimRatioPercent": {"type": "integer", "minimum": 101, "maximum": 10000},
        "reclaimTightHostFreeBytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776}
      }
    },
    "filesystemOverhead": {
      "const": {
        "tinyCapacityBytes": 268435456
      }
    },
    "ordinaryMaintenance": {
      "const": {
        "version": 1,
        "mode": "queued",
        "maximumWaitMilliseconds": 1800000
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "capacityBytes",
        "maximumLogicalBytes"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 103080263680
        },
        "maximumArtifactBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 68719476736
        },
        "maximumLogicalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 103080263680
        }
      }
    },
    "logicalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "maximumLogicalBytes",
        "missing",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "maximumLogicalBytes": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "elasticCapacityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "minimumBytes",
        "hostFreeBytes",
        "capacityBytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "minimumBytes": {
          "type": "integer",
          "minimum": 33554432
        },
        "hostFreeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 33554432
        }
      }
    },
    "elasticPartition": {
      "description": "Sizes an image when it is created: the working set it must hold times the headroom factor, never more than the cap and half of what the host volume has free, never below the partition's own minimum (`minimumBytes`, the smallest image that still makes the partition useful, so a host with less free space than the declared capacity still gets an image that fits); the created image's own receipt then pins the size.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needBytes",
        "headroomPercent",
        "hostFreeReservePercent",
        "alignBytes",
        "maximumBytes",
        "minimumBytes",
        "reclaimFloorBytes",
        "reclaimRatioPercent",
        "reclaimTightHostFreeBytes",
        "automatic",
        "pressureFreeBytes"
      ],
      "properties": {
        "needBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 103080263680
        },
        "headroomPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "hostFreeReservePercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "alignBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 68719476736
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 103080263680
        },
        "minimumBytes": {
          "description": "The smallest image the partition is born with; it never exceeds the declared partition capacity and the maximum.",
          "type": "integer",
          "minimum": 33554432,
          "maximum": 103080263680
        },
        "reclaimFloorBytes": {
          "description": "An idle image is reclaimed in place by `repo cache gc` when its host allocation exceeds the bytes used inside by at least this floor and by the ratio below.",
          "type": "integer",
          "minimum": 1048576,
          "maximum": 103080263680
        },
        "reclaimRatioPercent": {
          "description": "Host allocation as a percentage of the bytes used inside from which the allocation counts as bloated (300 = three times).",
          "type": "integer",
          "minimum": 101,
          "maximum": 10000
        },
        "reclaimTightHostFreeBytes": {
          "description": "Free bytes of the host volume below which the floor is an eighth: a nearly full disk gets its bloat back early.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "automatic": {
          "description": "Whether a command that finds the image quiescent (nobody holds it, a non-waiting exclusive try succeeds) and still below its pressure floor recreates it at the elastic size; the graph, compiler and products images qualify (all hold only derived data; `repo run repo-cache-reset:cache-reset-<graph|rust|products>` is the on-demand step).",
          "type": "boolean"
        },
        "pressureFreeBytes": {
          "description": "Free bytes of the mounted image below which a quiescent image counts as exhausted.",
          "type": "integer",
          "minimum": 1048576,
          "maximum": 68719476736
        }
      }
    },
    "imageBackendCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "backing",
        "mounted"
      ],
      "properties": {
        "id": {
          "enum": [
            "mounted-image",
            "directory-partition"
          ]
        },
        "backing": {
          "enum": [
            "fixed.dmg",
            "fixed.dir"
          ]
        },
        "mounted": {
          "type": "boolean"
        }
      }
    }
  }
}
