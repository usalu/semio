{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "partition",
    "resource"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "partition": {
      "enum": [
        "rust",
        "products"
      ]
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
