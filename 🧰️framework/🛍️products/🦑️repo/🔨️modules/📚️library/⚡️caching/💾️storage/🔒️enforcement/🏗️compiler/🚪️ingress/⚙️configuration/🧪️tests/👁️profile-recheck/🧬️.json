{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "original",
    "loadedPolicy",
    "observations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "original": {
      "type": "string"
    },
    "loadedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "replacement", "cases"],
      "properties": {
        "initial": { "type": "string" },
        "replacement": { "type": "string" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "producer", "pinned", "loaded", "edit", "result"],
            "properties": {
              "id": { "type": "string" },
              "producer": { "enum": ["artifact", "descriptor-emitter"] },
              "pinned": { "type": "boolean" },
              "loaded": { "enum": ["initial", "replacement"] },
              "edit": { "enum": ["before", "after"] },
              "result": { "enum": ["accepted", "drift", "stale"] }
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "reason"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "enum": [
              null,
              "length",
              "bytes",
              "vanished"
            ]
          }
        }
      }
    }
  }
}
