{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "bodyFails",
      "closeFails",
      "same",
      "errors"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "bodyFails": {
        "type": "boolean"
      },
      "closeFails": {
        "type": "boolean"
      },
      "same": {
        "type": "boolean"
      },
      "errors": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      }
    }
  }
}
