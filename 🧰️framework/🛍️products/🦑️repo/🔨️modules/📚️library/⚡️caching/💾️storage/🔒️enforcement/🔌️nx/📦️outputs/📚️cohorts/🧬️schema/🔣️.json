{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Request": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "productsRoot", "mode", "platform"],
      "properties": {
        "version": {"const": 1},
        "productsRoot": {"type": "string", "minLength": 1, "maxLength": 224},
        "mode": {"enum": ["prototype", "release"]},
        "platform": {"enum": ["posix", "windows"]}
      }
    },
    "Protocol": {
      "const": {"prefix": "play", "directory": "pages", "resource": "repository:play-pages:", "members": ["play", "map", "media", "modules", "cohort"], "maximumPathUnits": 256}
    }
  }
}
