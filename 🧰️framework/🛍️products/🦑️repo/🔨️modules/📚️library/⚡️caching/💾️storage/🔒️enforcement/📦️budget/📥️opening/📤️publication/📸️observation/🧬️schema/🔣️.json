{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "directory",
    "backing",
    "root",
    "receiptSha256",
    "maximumPhysicalBytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "directory": {
      "$ref": "#/$defs/Directory"
    },
    "backing": {
      "$ref": "#/$defs/Backing"
    },
    "root": {
      "$ref": "#/$defs/Directory"
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "maximumPhysicalBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "Directory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino",
        "mode",
        "kind"
      ],
      "properties": {
        "dev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "directory"
        }
      }
    },
    "Backing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino",
        "mode",
        "kind",
        "nlink",
        "size",
        "allocatedBytes"
      ],
      "properties": {
        "dev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "file"
        },
        "nlink": {
          "const": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "allocatedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "Protocol": {
      "const": {
        "maximumPathUnits": 256,
        "maximumAncestors": 64,
        "receiptName": "image.json",
        "receiptMinimumBytes": 1,
        "progressResource": "dependencies:maintenance-parent-observation",
        "authority": false
      }
    }
  }
}
