{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "roots",
    "excludedSegments",
    "queued",
    "nonwaiting",
    "scenarios",
    "request"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "excludedSegments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "queued": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "tokens"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "nonwaiting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sites",
          "kind",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sites": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "kind": {
            "enum": [
              "explicit-command",
              "inherited",
              "opportunistic",
              "inside-own-writer",
              "type-only"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 16
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "holder",
          "requester",
          "event",
          "expect"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "holder": {
            "const": "shared"
          },
          "requester": {
            "enum": [
              "queued",
              "opportunistic"
            ]
          },
          "event": {
            "enum": [
              "release",
              "cancel",
              "late-reader",
              "none"
            ]
          },
          "expect": {
            "enum": [
              "acquired-after-release",
              "cancelled-holder-intact",
              "maintenance-before-late-reader",
              "not-acquired"
            ]
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "maximumWaitMilliseconds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "const": "queued"
        },
        "maximumWaitMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      }
    }
  }
}
