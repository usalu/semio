{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "initial",
          "restriction",
          "mkdir",
          "accepted",
          "created"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "initial": {
            "enum": [
              "none",
              "cache",
              "both",
              "cache-file",
              "cache-link",
              "base-file",
              "base-link",
              "workspace-link"
            ]
          },
          "restriction": {
            "enum": [
              "live",
              "cancelled",
              "forged",
              "noncanonical",
              "long",
              "ancestor-link"
            ]
          },
          "mkdir": {
            "enum": [
              "normal",
              "race-directory",
              "throw-undefined",
              "cancel-after-cache",
              "race-link"
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "created": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        }
      }
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "ancestors": [
          ".cache",
          ".cache/b"
        ],
        "maximumPathCharacters": 256
      }
    }
  }
}
