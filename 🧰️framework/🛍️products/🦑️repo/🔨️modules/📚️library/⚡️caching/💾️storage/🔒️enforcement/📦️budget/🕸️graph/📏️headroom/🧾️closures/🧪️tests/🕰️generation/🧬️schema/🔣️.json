{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "wire",
          "accepted",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "generation-index",
              "generation-frontier"
            ]
          },
          "wire": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          },
          "references": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(source|lock):[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
