{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "availableBytes",
        "requiredBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "availableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        }
      }
    },
    "Protocol": {
      "const": {
        "version": 1,
        "resource": "repo:compiler-writer",
        "admission": "initial-free-headroom",
        "envelope": "fixed-image",
        "maintenanceTargetBytes": 4294967296,
        "maintenanceRetainedBytes": 17179869184,
        "maximumDeletionBytes": 4294967296,
        "maximumTerminalBytes": 134217728,
        "nativePublicationMetadataBytes": 1048576,
        "maximumMaintenancePasses": 4,
        "maximumOperations": 1024
      }
    },
    "Wait": {
      "const": {
        "minimumMilliseconds": 250,
        "maximumIntervalMilliseconds": 15000,
        "reportMilliseconds": 15000,
        "maximumMilliseconds": 1800000,
        "messages": {
          "en": {
            "waiting": "[repo cargo] waiting {seconds} s for compiler image space: {available} GiB free of the {required} GiB a compile needs; other compiles or maintenance may still free it",
            "refused": "Insufficient physical compiler initial headroom: {available} GiB free of the {required} GiB a compile needs after {seconds} s"
          },
          "de": {
            "waiting": "[repo cargo] wartet seit {seconds} s auf Platz im Compiler-Image: {available} GiB frei von den {required} GiB, die ein Compile braucht; andere Compiles oder die Wartung geben vielleicht noch Platz frei",
            "refused": "Unzureichender physischer Compiler-Startplatz: {available} GiB frei von den {required} GiB, die ein Compile braucht, nach {seconds} s"
          }
        }
      }
    },
    "WriterRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "wait"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "wait": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "exclusive",
            "shared"
          ]
        }
      }
    },
    "CustodyCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "live",
        "writer",
        "producer"
      ],
      "properties": {
        "mode": {
          "enum": [
            "exclusive",
            "shared",
            "lifetime"
          ]
        },
        "live": {
          "type": "boolean"
        },
        "writer": {
          "type": "boolean"
        },
        "producer": {
          "type": "boolean"
        }
      }
    },
    "BorrowCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "effects"
      ],
      "properties": {
        "method": {
          "enum": [
            "lifetime",
            "write",
            "borrow",
            "custody",
            "borrow-custody",
            "store",
            "artifact-cache",
            "writer-operation"
          ]
        },
        "effects": {
          "const": 0
        }
      }
    }
  }
}
