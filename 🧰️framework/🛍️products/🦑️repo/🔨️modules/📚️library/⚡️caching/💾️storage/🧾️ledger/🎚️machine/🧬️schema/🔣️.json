{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:machine-disk-budget:v1",
  "title": "Machine Disk Budget",
  "description": "One declared disk budget for every cache of a development machine: a total in bytes (configurable per machine) shared out to stores by weight, with floors, a headroom per image and a host free-space floor. The plan is pure: it only says how much each store may keep, how much must go and how much stays because a holder or an owner keeps it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultTotalBytes", "environment", "file", "hostFreeFloorBytes", "alignBytes", "toleranceBytes", "stores", "dedupe"],
  "properties": {
    "version": { "const": 1 },
    "defaultTotalBytes": { "$ref": "#/$defs/bytes" },
    "environment": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "file": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^/\\\\:*?\"<>|\\u0000-\\u001f]+$" },
    "hostFreeFloorBytes": { "$ref": "#/$defs/bytes" },
    "alignBytes": { "type": "integer", "minimum": 1048576, "maximum": 4294967296 },
    "toleranceBytes": { "$ref": "#/$defs/bytes" },
    "stores": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/store" } },
    "dedupe": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/dedupe" } }
  },
  "$defs": {
    "bytes": { "type": "integer", "minimum": 0, "maximum": 1125899906842624 },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 240 },
        "de": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "dedupe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "partition", "minimumBytes", "quietMs", "maximumFiles"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "partition": { "$ref": "#/$defs/identifier" },
        "directory": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^/\\\\:*?\"<>|\\u0000-\\u001f]+(/[^/\\\\:*?\"<>|\\u0000-\\u001f]+){0,3}$" },
        "minimumBytes": { "type": "integer", "minimum": 4096, "maximum": 1125899906842624 },
        "quietMs": { "$ref": "#/$defs/bytes" },
        "maximumFiles": { "type": "integer", "minimum": 1, "maximum": 5000000 }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weightBasisPoints", "floorBytes", "headroomBasisPoints", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "partition": { "$ref": "#/$defs/identifier" },
        "loose": { "const": true },
        "weightBasisPoints": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "floorBytes": { "$ref": "#/$defs/bytes" },
        "headroomBasisPoints": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "purpose": { "$ref": "#/$defs/bilingual" }
      }
    },
    "machineFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "totalBytes"],
      "properties": {
        "version": { "const": 1 },
        "totalBytes": { "oneOf": [{ "$ref": "#/$defs/bytes" }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?\\s*(B|KiB|MiB|GiB|TiB|K|M|G|T)?$" }] }
      }
    }
  }
}
