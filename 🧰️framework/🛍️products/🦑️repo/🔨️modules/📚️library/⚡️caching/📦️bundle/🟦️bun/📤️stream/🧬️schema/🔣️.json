{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "chunkBytes": 32768,
        "maximumFrameBytes": 65536,
        "maximumOutputBytes": 536870912,
        "maximumFiles": 3,
        "maximumMetadataBytes": 16777216,
        "maximumWireBytes": 738197504
      }
    },
    "Frame": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "byteLength",
            "sha256"
          ],
          "properties": {
            "type": {
              "const": "file"
            },
            "name": {
              "enum": [
                "source.js",
                "source.js.map",
                "metadata.json"
              ]
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870912
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "data"
          ],
          "properties": {
            "type": {
              "const": "chunk"
            },
            "data": {
              "type": "string",
              "minLength": 4,
              "maxLength": 43692,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "end"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "requestSha256"
          ],
          "properties": {
            "type": {
              "const": "complete"
            },
            "requestSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  }
}
