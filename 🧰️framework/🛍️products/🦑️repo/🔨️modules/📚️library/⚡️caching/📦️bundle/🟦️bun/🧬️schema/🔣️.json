{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "mode"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "snapshot",
        "actor",
        "module",
        "bun-package"
      ]
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contents": {
      "type": "string",
      "maxLength": 8388608
    },
    "runtime": {
      "type": "object",
      "required": [
        "host",
        "wasi"
      ],
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "maxLength": 8388608
        },
        "wasi": {
          "type": "string",
          "maxLength": 8388608
        }
      }
    },
    "external": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observe": {
      "type": "boolean"
    }
  },
  "definitions": {
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requestSha256",
        "kind",
        "mode",
        "source",
        "metadata"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "snapshot",
            "actor",
            "module",
            "bun-package"
          ]
        },
        "mode": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "byteLength"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^bundle-(prototype|release)-[A-Za-z0-9_-]+/(source\\.js|source\\.js\\.map|metadata\\.json)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "sourceMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "byteLength"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^bundle-(prototype|release)-[A-Za-z0-9_-]+/(source\\.js|source\\.js\\.map|metadata\\.json)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "byteLength"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^bundle-(prototype|release)-[A-Za-z0-9_-]+/(source\\.js|source\\.js\\.map|metadata\\.json)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "physicalInputs",
        "loadedRuntime"
      ],
      "properties": {
        "loadedRuntime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "inputs": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logicalPath",
              "sha256",
              "byteLength"
            ],
            "properties": {
              "logicalPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "physicalInputs": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logicalPath",
              "sha256",
              "byteLength",
              "path"
            ],
            "properties": {
              "logicalPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      }
    }
  }
}
