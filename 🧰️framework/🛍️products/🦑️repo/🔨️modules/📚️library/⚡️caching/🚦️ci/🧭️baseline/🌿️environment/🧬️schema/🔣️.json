{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["head", "full", "history"],
  "properties": {
    "head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "full": { "type": "boolean" },
    "history": { "type": ["object", "null"] }
  }
}
