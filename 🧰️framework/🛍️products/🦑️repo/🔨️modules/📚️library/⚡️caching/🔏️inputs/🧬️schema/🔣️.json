{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generator Input Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "digest"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
