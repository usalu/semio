{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/library/normalization/schema.json",
  "$ref": "#/$defs/SourceAdmissionInput",
  "$defs": {
    "Origin": {
      "enum": [
        "tracked",
        "nonignored-untracked",
        "ignored-generator",
        "explicit-ticket"
      ]
    },
    "IndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "mode",
        "objectId"
      ],
      "properties": {
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "mode": {
          "enum": [
            "100644",
            "100755",
            "120000",
            "160000"
          ]
        },
        "objectId": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "GeneratorOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "rootPath",
        "inclusion"
      ],
      "properties": {
        "contractId": {
          "type": "string",
          "minLength": 1
        },
        "rootPath": {
          "type": "string",
          "minLength": 1
        },
        "inclusion": {
          "enum": [
            "tracked",
            "ignored"
          ]
        }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "observedKind",
        "worktreeMode",
        "explicitDirectory",
        "origins",
        "indexEntries",
        "unsafeAncestor"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "observedKind": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "absent",
            "unobserved",
            "other"
          ]
        },
        "worktreeMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "100644",
            "100755",
            "120000",
            "160000",
            "040000",
            null
          ]
        },
        "explicitDirectory": {
          "type": "boolean"
        },
        "origins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Origin"
          }
        },
        "indexEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndexEntry"
          }
        },
        "unsafeAncestor": {
          "type": "boolean"
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "observedKind",
        "worktreeMode",
        "explicitDirectory",
        "origins",
        "indexEntries",
        "generatorOutputs",
        "repositoryBoundary"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "observedKind": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "absent",
            "unobserved",
            "other"
          ]
        },
        "worktreeMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "100644",
            "100755",
            "120000",
            "160000",
            "040000",
            null
          ]
        },
        "explicitDirectory": {
          "type": "boolean"
        },
        "origins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Origin"
          }
        },
        "indexEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndexEntry"
          }
        },
        "generatorOutputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeneratorOutput"
          }
        },
        "repositoryBoundary": {
          "enum": [
            "gitlink",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "repositoryBoundary"
            ],
            "properties": {
              "repositoryBoundary": {
                "const": "gitlink"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "origins": {
                "type": "array",
                "contains": {
                  "const": "tracked"
                }
              },
              "indexEntries": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/IndexEntry"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "stage": {
                          "const": 0
                        },
                        "mode": {
                          "const": "160000"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "observedKind": {
                    "const": "directory"
                  },
                  "worktreeMode": {
                    "const": "040000"
                  },
                  "explicitDirectory": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "observedKind": {
                    "const": "absent"
                  },
                  "worktreeMode": {
                    "type": "null"
                  },
                  "explicitDirectory": {
                    "const": false
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/SourceAdmissionInput"
        },
        "expected": {
          "$ref": "#/$defs/SourceAdmission"
        }
      }
    },
    "SchemaRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidate",
        "expectedKeyword"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "object"
        },
        "expectedKeyword": {
          "enum": [
            "enum",
            "pattern",
            "type",
            "required",
            "additionalProperties"
          ]
        }
      }
    },
    "SourceAdmissionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "opaquePrefixes",
        "generatorOutputRoots",
        "candidates"
      ],
      "properties": {
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "cancelledDuring": {
          "type": [
            "string",
            "null"
          ]
        },
        "opaquePrefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatorOutputRoots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeneratorOutput"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          }
        }
      }
    },
    "SourceAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "scope",
        "status",
        "observations",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "rejected"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        }
      }
    },
    "SourceAdmissionCases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "schemaRejections",
        "schemaCases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Case"
          }
        },
        "schemaRejections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SchemaRejection"
          }
        },
        "schemaCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SchemaCase"
          }
        }
      }
    },
    "SchemaCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "value",
        "valid"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "enum": [
            "Candidate",
            "SourceAdmissionInput",
            "Observation",
            "SourceAdmission"
          ]
        },
        "value": true,
        "valid": {
          "type": "boolean"
        }
      }
    }
  }
}
