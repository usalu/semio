{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.repo.source-services/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owners",
    "denied",
    "directTypeOwners",
    "taxonomyLoad"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owners": {
      "type": "array",
      "const": [
        {
          "path": "🛣️path/🟦️.ts",
          "dependencies": []
        },
        {
          "path": "📁️input/🟦️.ts",
          "dependencies": []
        },
        {
          "path": "🏃️operation/🟦️.ts",
          "dependencies": []
        },
        {
          "path": "🔣️taxonomy/🟦️.ts",
          "dependencies": [
            "🛣️path/🟦️.ts",
            "📁️input/🟦️.ts"
          ]
        },
        {
          "path": "🚪️source-admission/🟦️.ts",
          "dependencies": [
            "🛣️path/🟦️.ts"
          ]
        },
        {
          "path": "🚪️source-admission/📁️io/🟦️.ts",
          "dependencies": [
            "🛣️path/🟦️.ts",
            "📁️input/🟦️.ts",
            "🏃️operation/🟦️.ts",
            "🔣️taxonomy/🟦️.ts",
            "🚪️source-admission/🟦️.ts"
          ]
        }
      ]
    },
    "denied": {
      "const": [
        "🟦️.ts",
        "🧬️mutation/"
      ]
    },
    "directTypeOwners": {
      "const": [
        { "name": "TaxonomyProgress", "path": "🏃️operation/🟦️.ts" },
        { "name": "TaxonomyNodeKind", "path": "🚪️source-admission/🟦️.ts" }
      ]
    },
    "taxonomyLoad": {
      "const": {
        "input": "required",
        "parser": "private",
        "facts": ["schema", "discoverySchema", "exclusions", "fileKinds", "directoryKinds"]
      }
    }
  }
}
