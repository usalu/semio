{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/framing"
          },
          {
            "$ref": "#/$defs/raw"
          },
          {
            "$ref": "#/$defs/opaque"
          },
          {
            "$ref": "#/$defs/nofollow"
          },
          {
            "$ref": "#/$defs/fifo"
          },
          {
            "$ref": "#/$defs/git"
          },
          {
            "$ref": "#/$defs/drift"
          },
          {
            "$ref": "#/$defs/setup"
          },
          {
            "$ref": "#/$defs/generatedOutput"
          },
          {
            "$ref": "#/$defs/callbackSnapshot"
          }
        ]
      }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "law",
        "input",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "law": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "expected": {
          "type": "object"
        }
      }
    },
    "framing": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "strict-git-framing"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "recordsHex"
              ],
              "properties": {
                "recordsHex": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]+$"
                  }
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "errors"
              ],
              "properties": {
                "errors": {
                  "const": 3
                }
              }
            }
          }
        }
      ]
    },
    "raw": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "raw-git-spelling"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "opaque": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "opaque-untracked-pruning"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "opaque"
              ],
              "properties": {
                "opaque": {
                  "type": "string"
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "beforeBoundary"
              ],
              "properties": {
                "beforeBoundary": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nofollow": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "root-and-candidate-nofollow"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root",
                "candidate"
              ],
              "properties": {
                "root": {
                  "type": "string"
                },
                "candidate": {
                  "type": "string"
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error",
                "descendantLstat"
              ],
              "properties": {
                "error": {
                  "const": "UnsafeDirectoryAncestorError"
                },
                "descendantLstat": {
                  "const": 0
                }
              }
            }
          }
        }
      ]
    },
    "fifo": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "fifo-and-permission"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "errno"
              ],
              "properties": {
                "mode": {
                  "type": "integer"
                },
                "errno": {
                  "const": "EACCES"
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "error"
              ],
              "properties": {
                "kind": {
                  "const": "other"
                },
                "error": {
                  "const": "EACCES"
                }
              }
            }
          }
        }
      ]
    },
    "git": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "nested-git-terminal"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "const": "owner/.git"
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rows",
                "readdir"
              ],
              "properties": {
                "rows": {
                  "const": [
                    "owner/.git"
                  ]
                },
                "readdir": {
                  "const": 0
                }
              }
            }
          }
        }
      ]
    },
    "drift": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "directory-identity-drift"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "before",
                "after"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "before": {
                  "type": "number"
                },
                "after": {
                  "type": "number"
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "const": "changed during enumeration"
                }
              }
            }
          }
        }
      ]
    },
    "setup": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "loaded-hash-and-opaque-setup"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contentHash",
                "scope"
              ],
              "properties": {
                "contentHash": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contentHash",
                "filesystem",
                "error"
              ],
              "properties": {
                "contentHash": {
                  "type": "string"
                },
                "filesystem": {
                  "const": 0
                },
                "error": {
                  "const": "opaque"
                }
              }
            }
          }
        }
      ]
    },
    "generatedOutput": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "ticket-generated-output-exclusion"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ticketDir"
              ],
              "properties": {
                "ticketDir": {
                  "const": "ticket"
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rows",
                "readdirCalls"
              ],
              "properties": {
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "readdirCalls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "callbackSnapshot": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "callback-request-snapshot"
            },
            "input": {
              "type": "object",
              "const": {
                "options": {
                  "repoRoot": "/fixture",
                  "scope": "owned",
                  "taxonomyPath": "taxonomy",
                  "structuralDirectoryNames": [
                    "🧪️tests"
                  ]
                },
                "mutation": {
                  "scope": "../escaped",
                  "structuralDirectoryNames": [
                    "📦️packages"
                  ]
                },
                "indexRows": [{ "path": "nested-repository", "entry": { "mode": "160000", "objectId": "0123456789012345678901234567890123456789", "stage": 0 } }],
                "repositoryFences": ["nested-repository"],
                "inventoryWorkerCases": [{ "workers": 0, "mutation": 1 }, { "workers": 1, "mutation": 0 }]
              },
              "additionalProperties": false,
              "required": [
                "options",
                "mutation",
                "indexRows",
                "repositoryFences",
                "inventoryWorkerCases"
              ],
              "properties": {
                "options": {
                  "type": "object"
                },
                "mutation": {
                  "type": "object"
                },
                "indexRows": {
                  "type": "array"
                },
                "repositoryFences": {
                  "type": "array"
                },
                "inventoryWorkerCases": {
                  "type": "array"
                }
              }
            },
            "expected": {
              "type": "object",
              "const": {
                "scope": "owned",
                "structuralDirectoryNames": [
                  "🧪️tests"
                ],
                "replacementCallbacks": 0,
                "progressFrozen": true,
                "preparedFactsFrozen": true,
                "workerOutcomes": ["workers must be a positive integer", "taxonomy-boundary"]
              },
              "additionalProperties": false,
              "required": [
                "scope",
                "structuralDirectoryNames",
                "replacementCallbacks",
                "progressFrozen",
                "preparedFactsFrozen",
                "workerOutcomes"
              ],
              "properties": {
                "scope": {
                  "const": "owned"
                },
                "structuralDirectoryNames": {
                  "const": [
                    "🧪️tests"
                  ]
                },
                "replacementCallbacks": {
                  "const": 0
                },
                "progressFrozen": {
                  "const": true
                },
                "preparedFactsFrozen": {
                  "const": true
                },
                "workerOutcomes": {
                  "const": ["workers must be a positive integer", "taxonomy-boundary"]
                }
              }
            }
          }
        }
      ]
    }
  }
}
