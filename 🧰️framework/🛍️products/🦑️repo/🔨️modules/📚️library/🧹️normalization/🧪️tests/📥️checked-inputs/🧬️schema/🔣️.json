{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "operation",
    "source",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "ticket",
        "documentation"
      ]
    },
    "source": {
      "type": "string"
    },
    "expected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
