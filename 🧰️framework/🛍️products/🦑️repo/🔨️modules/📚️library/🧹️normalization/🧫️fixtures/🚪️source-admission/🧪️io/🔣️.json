  { "id": "directory-identity-drift", "law": "Reject changed directory identity after readdir.", "input": { "path": "owner", "before": 1, "after": 2 }, "expected": { "error": "changed during enumeration" } },
  { "id": "loaded-hash-and-opaque-setup", "law": "Return the loaded hash and reject virtual opaque setup before filesystem callbacks.", "input": { "contentHash": "loaded-hash", "scope": "virtual/CoMpOsE/leaf" }, "expected": { "contentHash": "loaded-hash", "filesystem": 0, "error": "opaque" } },
  { "id": "ticket-generated-output-exclusion", "law": "Skip the ticket root's reserved generated-output child entirely: never stat it, never read it, never admit it as a reference candidate.", "input": { "ticketDir": "ticket" }, "expected": { "rows": [{ "path": "ticket", "mode": "040000", "explicitDirectory": true }, { "path": "ticket/keep", "mode": "040000", "explicitDirectory": true }, { "path": "ticket/keep/file.txt", "mode": "100644" }], "readdirCalls": ["repo/ticket", "repo/ticket/keep"] } }
