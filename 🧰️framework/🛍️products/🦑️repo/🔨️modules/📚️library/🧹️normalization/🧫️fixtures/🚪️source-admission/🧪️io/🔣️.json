  { "id": "strict-git-framing", "law": "Reject missing terminal NUL, interior empty records, and malformed UTF-8.", "input": { "recordsHex": ["626164", "610000", "ff00"] }, "expected": { "errors": 3 } },
  { "id": "raw-git-spelling", "law": "Preserve an NFD source path without source-relative rewriting.", "input": { "path": "raw/café.rs" }, "expected": { "path": "raw/café.rs" } },
  { "id": "opaque-untracked-pruning", "law": "Supply case-insensitive compose and literal opaque exclusions before --.", "input": { "opaque": "opaque [a]" }, "expected": { "beforeBoundary": ["--exclude=[cC][oO][mM][pP][oO][sS][eE]", "--exclude=/opaque\\ \\[a\\]"] } },
  { "id": "root-and-candidate-nofollow", "law": "Reject a symlink root ancestor before a descendant observation.", "input": { "root": "/fixture", "candidate": "link/child" }, "expected": { "error": "SourceAdmissionUnsafeAncestorError", "descendantLstat": 0 } },
  { "id": "fifo-and-permission", "law": "Classify FIFO as other and propagate EACCES.", "input": { "mode": 4096, "errno": "EACCES" }, "expected": { "kind": "other", "error": "EACCES" } },
