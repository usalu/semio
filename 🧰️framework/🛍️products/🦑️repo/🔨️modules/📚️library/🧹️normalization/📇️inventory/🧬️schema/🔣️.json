{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/repo/library/inventory/violation/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "code",
    "severity",
    "message"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "error",
        "warning"
      ]
    },
    "message": {
      "type": "string"
    }
  }
}
