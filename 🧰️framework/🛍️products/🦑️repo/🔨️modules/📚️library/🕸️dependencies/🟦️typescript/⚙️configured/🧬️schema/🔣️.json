{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "entries",
    "project",
    "packages",
    "externalDependencies",
    "maximumFiles",
    "maximumBytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/Path"
      }
    },
    "project": {
      "$ref": "#/definitions/Path"
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:@[^/]+/)?[^/]+$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/Path"
      }
    },
    "externalDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:@[^/]+/)?[^/]+$"
      }
    },
    "maximumFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "maximumBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    }
  },
  "definitions": {
    "Path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "AssetExtension": {
      "type": "string",
      "enum": [
        ".json",
        ".css",
        ".scss",
        ".svg",
        ".png",
        ".jpg",
        ".jpeg",
        ".webp",
        ".wasm",
        ".ico",
        ".gif",
        ".avif",
        ".txt",
        ".woff",
        ".woff2",
        ".ttf",
        ".otf",
        ".bmp",
        ".webmanifest"
      ]
    },
    "CodeExtension": {
      "type": "string",
      "enum": [
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ]
    }
  }
}
