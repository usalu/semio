{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relative TypeScript Source Inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries",
    "generated",
    "externalDependencies"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    },
    "generated": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    },
    "externalDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:@[^/]+/)?[^/]+$"
      }
    }
  }
}
