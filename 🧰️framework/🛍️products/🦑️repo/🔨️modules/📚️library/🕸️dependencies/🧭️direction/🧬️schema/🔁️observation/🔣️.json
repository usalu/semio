{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/repo/dependencies/direction/observation",
  "title": "Dependency direction observation scenarios",
  "description": "Scripted worlds for the bounded re-observation of the dependency direction lane: each scenario lists the events in the order the lane consumes them (an observation of the scope returns an inventory or throws, a resolver pass succeeds or fails) and the verdict every implementation must reach.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarios"],
  "properties": {
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Scenario"}}
  },
  "definitions": {
    "Event": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["observe"], "properties": {"observe": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["observeFails"], "properties": {"observeFails": {"enum": ["ENOENT", "EACCES"]}, "path": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["run"], "properties": {"run": {"enum": ["ok", "fail"]}}}
      ]
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "runs"],
      "properties": {
        "result": {"enum": ["ok", "failed", "exhausted"]},
        "runs": {"type": "integer", "minimum": 0},
        "reason": {"enum": ["vanished", "appeared"]},
        "path": {"type": "string"}
      }
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "events", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Event"}},
        "expected": {"$ref": "#/definitions/Expected"}
      }
    }
  }
}
