{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "ownerSource",
    "activationCases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 55,
      "maxItems": 55,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "expectedCodes",
          "nativeCompiles",
          "expectedDiagnostic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "expectedCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "declaration-origin",
                "family-alias",
                "unproven-family-context",
                "unproven-family-provider",
                "unproven-family-binding"
              ]
            }
          },
          "nativeCompiles": {
            "type": "boolean"
          },
          "expectedDiagnostic": {
            "enum": [
              "none",
              "E0425",
              "E0433",
              "E0659"
            ]
          }
        }
      }
    },
    "ownerSource": {
      "type": "string",
      "minLength": 1
    },
    "activationCases": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sources",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean"
          },
          "nativeAliases": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "provider",
                "other"
              ]
            }
          }
        }
      }
    }
  }
}
