{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/repo/rust-binding-cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases",
    "nativeCases",
    "mountCase",
    "scopeCases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "consumerManifest",
          "compileKind",
          "manifests",
          "expectedRoots",
          "expectedProblems",
          "expectedProviders"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "consumerManifest": {
            "type": "string"
          },
          "compileKind": {
            "enum": [
              "library",
              "test",
              "build"
            ]
          },
          "manifests": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expectedRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedProblems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputNodes": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "missing",
                "symlink",
                "file",
                "directory"
              ]
            }
          },
          "sourceLocator": {
            "type": "string"
          },
          "rootSources": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "authorityWitness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifest",
              "field"
            ],
            "properties": {
              "manifest": {
                "type": "string"
              },
              "field": {
                "enum": [
                  "library-path",
                  "workspace-path",
                  "dependency-path"
                ]
              }
            }
          }
        }
      }
    },
    "nativeCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "accept"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "accept": {
            "type": "boolean"
          },
          "output": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "accept": {
                  "const": true
                }
              },
              "required": [
                "accept"
              ]
            },
            "then": {
              "required": [
                "output"
              ],
              "properties": {
                "output": {
                  "type": "string"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "output"
                ],
                "properties": {
                  "output": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "mountCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sources",
        "source",
        "expectedBindings",
        "nativeOutputs",
        "linkedAncestor",
        "expectedLinkedProblem"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "expectedBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "root",
              "provider",
              "module"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "root": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "module": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "nativeOutputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linkedAncestor": {
          "type": "string"
        },
        "expectedLinkedProblem": {
          "const": "linked-input"
        }
      }
    },
    "scopeCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "sourceScope",
              "state",
              "modulePaths"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "sourceScope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "state": {
                "const": "resolved"
              },
              "modulePaths": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "sourceScope",
              "state",
              "modulePath",
              "code"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "sourceScope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "state": {
                "const": "unresolved"
              },
              "modulePath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "code": {
                "enum": [
                  "unsupported-attribute",
                  "scope-not-unique"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    }
  }
}
