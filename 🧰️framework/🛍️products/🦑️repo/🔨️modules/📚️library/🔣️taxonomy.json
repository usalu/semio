  "rustEntryPathRules": {
    "_comment": "🦀️ #[path] resolution is CUMULATIVE: every nested `pub mod X { … }` resolves its own #[path] against its immediately enclosing scope's ALREADY-RESOLVED dir, and `#[path = \".\"]` means \"keep the enclosing base\". Under entryLocation=\"packages\" the entry file sits entryDirFromOwner deep, so the owner tree is leafPathPrefix away. TWO conventions are valid and both appear in the repo today (confirmed by real compiles: 🏛️architect/📸️remodel/🖍️draw use leaf-prefixed, 🖨️raster uses once-reset) — a validator must model the base stack, not do a flat join.",
    "entryDirFromOwner": "📦️packages/🦀️rust",
    "resolution": "cumulative",
    "groupingResetPath": ".",
    "leafPathPrefix": "../../",
    "conventions": [
      {
        "id": "leaf-prefixed",
        "outerReset": null,
        "groupingReset": ".",
        "leafPrefix": "../../"
      },
      {
        "id": "once-reset",
        "outerReset": "../../.",
        "groupingReset": ".",
        "leafPrefix": ""
      }
    ]
  },
