{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "parameters",
    "cases",
    "receiverCallbacks",
    "commandCases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "parameters": {
      "const": [
        "request",
        "policy",
        "workspace",
        "invocation",
        "phaseControl"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "phase",
          "lint",
          "grant",
          "cap",
          "accepted",
          "stores",
          "runs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "phase": {
            "enum": [
              "issued",
              "cancelled",
              "copied",
              "foreign",
              "expired",
              "after-store",
              "after-run"
            ]
          },
          "lint": {
            "type": "boolean"
          },
          "grant": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4000
          },
          "cap": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "accepted": {
            "type": "boolean"
          },
          "stores": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "receiverCallbacks": {
      "const": 3
    },
    "commandCases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "accepted",
          "dispatches"
        ],
        "properties": {
          "phase": {
            "enum": [
              "issued",
              "copied",
              "foreign",
              "cancelled",
              "expired",
              "missing",
              "after-import",
              "mutable",
              "undefined",
              "frozen"
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "dispatches": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
