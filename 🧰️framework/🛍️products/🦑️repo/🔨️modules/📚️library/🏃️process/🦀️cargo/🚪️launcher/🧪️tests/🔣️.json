{
  "version": 1,
  "arguments": [
    {
      "name": "shared-check",
      "argv": [
        "--store=shared",
        "--configuration=prototype",
        "--",
        "check",
        "-p",
        "semio-framework-diagnostic"
      ],
      "environment": {},
      "request": {
        "version": 1,
        "store": "shared",
        "configuration": "prototype",
        "parallelism": "available",
        "kind": "compile",
        "cargo": [
          "check",
          "-p",
          "semio-framework-diagnostic"
        ]
      }
    },
    {
      "name": "split-options-wasm",
      "argv": [
        "--store",
        "isolated",
        "--configuration",
        "release",
        "--",
        "check",
        "--manifest-path",
        "🧰️framework/🔨️modules/⚠️diagnostic/📦️packages/🦀️rust/Cargo.toml",
        "--target",
        "wasm32-wasip2"
      ],
      "environment": {},
      "request": {
        "version": 1,
        "store": "isolated",
        "configuration": "release",
        "parallelism": "available",
        "kind": "compile",
        "cargo": [
          "check",
          "--manifest-path",
          "🧰️framework/🔨️modules/⚠️diagnostic/📦️packages/🦀️rust/Cargo.toml",
          "--target",
          "wasm32-wasip2"
        ]
      }
    },
    {
      "name": "explicit-parallelism-test-passthrough",
