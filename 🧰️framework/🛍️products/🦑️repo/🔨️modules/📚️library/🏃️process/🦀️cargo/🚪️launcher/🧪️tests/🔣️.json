        "check"
      ],
      "environment": {
        "SEMIO_BUILD_MODE": "prototype"
      },
      "request": null
    }
  ],
  "lifecycle": [
    {
      "name": "completed",
      "outcome": "return",
      "removedAfterOwner": true,
      "removedBySweep": false
    },
    {
      "name": "failed",
      "outcome": "throw",
      "removedAfterOwner": true,
      "removedBySweep": false
    },
    {
      "name": "cancelled",
      "outcome": "abort",
      "removedAfterOwner": true,
      "removedBySweep": false
    },
    {
      "name": "killed-owner",
      "outcome": "killed",
      "removedAfterOwner": false,
      "removedBySweep": true
    },
    {
      "name": "live-peer",
      "outcome": "live",
      "removedAfterOwner": false,
      "removedBySweep": false
    }
  ],
  "diagnostics": {
    "partition": "diagnostics",
    "directory": ".cache/b/o/m/tests",
    "sameFilesystem": true,
    "allCacheTestBranches": true,
    "specificHelpers": true,
    "asyncChildren": true
  }
}
