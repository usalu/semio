          "-p",
          "x"
        ]
      }
    },
    {
      "name": "lock-resync",
      "argv": [
        "--store=shared",
        "--configuration=prototype",
        "--",
        "generate-lockfile",
        "--offline"
      ],
      "environment": {},
      "request": {
        "version": 1,
        "store": "shared",
        "configuration": "prototype",
        "parallelism": "available",
        "kind": "lock",
        "cargo": [
          "generate-lockfile",
          "--offline"
