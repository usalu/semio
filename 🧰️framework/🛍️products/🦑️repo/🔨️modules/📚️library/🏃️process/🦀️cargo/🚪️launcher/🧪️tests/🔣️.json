        "--configuration=prototype",
        "--",
        "test",
        "-p",
        "x",
        "--",
        "--nocapture"
      ],
      "environment": {
        "SEMIO_BUILD_MODE": "prototype"
      },
      "request": {
        "version": 1,
        "store": "shared",
        "configuration": "prototype",
        "parallelism": 4,
        "kind": "compile",
        "cargo": [
          "test",
          "-p",
          "x",
          "--",
          "--nocapture"
        ]
      }
    },
    {
