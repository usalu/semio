{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/repo/cargo/executable-test/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifest",
    "package",
    "test",
    "arguments"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:\\u0000]).+/Cargo\\.toml$"
    },
    "package": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "test": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "arguments": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000]*$"
      }
    }
  }
}
