{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/repo/cargo/executable-test/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifest",
    "package",
    "test",
    "arguments"
  ],
  "definitions": {
    "RuntimeKeys": { "const": ["SEMIO_TEST_CLI", "SEMIO_TEST_ARTIFACT_DIR", "SEMIO_KEEP_WORKSPACES", "SEMIO_TYPE_BUDGET_MS"] },
    "RuntimeEnvironment": { "type": "object", "additionalProperties": false, "properties": { "SEMIO_TEST_CLI": { "$ref": "#/definitions/RuntimeValue" }, "SEMIO_TEST_ARTIFACT_DIR": { "$ref": "#/definitions/RuntimeValue" }, "SEMIO_KEEP_WORKSPACES": { "$ref": "#/definitions/RuntimeValue" }, "SEMIO_TYPE_BUDGET_MS": { "$ref": "#/definitions/RuntimeValue" } } },
    "RuntimeValue": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000]*$" },
    "EnvironmentCase": { "type": "object", "additionalProperties": false, "required": ["name", "windows", "compiler", "consumer", "accepted", "expected"], "properties": { "name": { "type": "string" }, "windows": { "type": "boolean" }, "compiler": { "type": "object", "additionalProperties": { "type": "string" } }, "consumer": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }, "accepted": { "type": "boolean" }, "expected": { "type": ["object", "null"], "additionalProperties": { "type": "string" } } } }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:\\u0000]).+/Cargo\\.toml$"
    },
    "package": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "test": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "arguments": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000]*$"
      }
    }
  }
}
