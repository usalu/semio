{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "entrySuffix": ".fetched.json",
        "stageSuffix": ".stage",
        "maximumLocks": 64,
        "maximumLockBytes": 4194304,
        "maximumPackages": 8192,
        "maximumReceiptBytes": 262144,
        "registryCache": "registry/cache"
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request", "locks", "registry"],
      "properties": {
        "version": {"const": 1},
        "request": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "locks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 256},
              "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "bytes": {"type": "integer", "minimum": 0, "maximum": 4194304}
            }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "count"],
          "properties": {
            "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "count": {"type": "integer", "minimum": 1, "maximum": 8192}
          }
        }
      }
    }
  }
}
