{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cargo registry freshness and input consumption",
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["change", "attempts", "consumptions", "settles"],
    "properties": {
      "change": {"enum": ["before", "during", "after", "none"]},
      "attempts": {"enum": [1, 2]},
      "consumptions": {"const": 1},
      "settles": {"type": "boolean"}
    }
  }
}
