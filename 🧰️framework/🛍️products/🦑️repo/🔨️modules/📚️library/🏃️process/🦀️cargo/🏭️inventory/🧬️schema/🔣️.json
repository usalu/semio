{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifest",
    "binary",
    "command",
    "artifact",
    "standard",
    "subset"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*Cargo\\.toml$"
    },
    "binary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "command": {
      "const": "list-mutations"
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "standard": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "subset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "surface": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maximumUnits",
        "maximumOwnedBytes",
        "maximumMilliseconds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "maximumUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maximumOwnedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "maximumMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        }
      }
    }
  }
}
