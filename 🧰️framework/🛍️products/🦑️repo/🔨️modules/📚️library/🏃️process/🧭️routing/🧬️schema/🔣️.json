{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:repo:command-routing:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "commands", "requests", "parallel", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "mode", "refuse"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
                "mode": { "enum": ["eager", "lazy"] },
                "refuse": { "type": "boolean" }
              }
            }
          },
          "requests": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
          "parallel": { "type": "boolean" },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trace", "rejected"],
            "properties": {
              "trace": { "type": "array", "items": { "type": "string" } },
              "rejected": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
