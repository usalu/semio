    [
     2,
     "spawnSync",
     "spawn",
     "git",
     "prod"
    ],
    [
     3,
     "execFileSync",
     "spawn",
     "<self>",
     "prod"
    ],
    [
     4,
     "spawnSync",
     "spawn",
     "<dynamic>",
     "prod"
    ]
   ]
  },
