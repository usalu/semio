{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Naming Law Corpus",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "cases"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "rule",
     "files"
    ],
    "oneOf": [
     {
      "properties": {
       "expect": true
      },
      "required": [
       "expect"
      ]
     },
     {
      "properties": {
       "expectCounts": true
      },
      "required": [
       "expectCounts"
      ]
     },
     {
      "properties": {
       "expectList": true
      },
      "required": [
       "expectList"
      ]
     }
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "rule": {
      "enum": [
       "policyBannedNameStemBreaches",
       "policyPluginRootShapeBreaches",
       "policyPluginBuilderBreaches",
       "policySprNamingBreaches",
       "policyEmojiPrefixBreaches"
      ]
     },
     "files": {
      "type": "object",
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "generate": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "path",
        "count"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "lines": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "count": {
         "type": "integer",
         "minimum": 1
        }
       }
      }
     },
     "expect": {
      "type": "array",
      "items": {
       "type": "array",
       "minItems": 4,
       "maxItems": 4,
       "items": [
        {
         "type": "string"
        },
        {
         "type": "string"
        },
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      }
     },
     "expectCounts": {
      "type": "object",
      "additionalProperties": {
       "type": "integer"
      }
     },
     "defect": {
      "type": "string"
     },
     "oracle": {
      "type": "boolean"
     },
     "git": {
      "type": "boolean"
     },
     "expectList": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "crates": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "libRelPath",
        "role",
        "pluginId",
        "ownerRel",
        "shape",
        "dir"
       ],
       "properties": {
        "libRelPath": {
         "type": "string"
        },
        "role": {
         "type": "string"
        },
        "pluginId": {
         "type": "string"
        },
        "ownerRel": {
         "type": "string"
        },
        "shape": {
         "type": "string"
        },
        "dir": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}
