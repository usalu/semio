  {
   "id": "raw-spawn-ignores-comments-and-strings",
   "rule": "policyRawSpawnBreaches",
   "files": {
    "📜️script.ts": [
     "import { spawnSync } from \"node:child_process\";",
     "const r = spawnSync(\"git\", [\"x\"]);",
     "execSync(\"ls\"); Bun.spawn([\"a\"]); spawn(\"b\")",
     "// spawnSync(\"x\")",
     "const s = \"spawnSync(x)\";",
     "const t = `spawn(${x})`;",
     "child.spawn(a);"
    ],
    "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🎛️commands/x/🟦️.ts": [
     "spawnSync(1);"
    ],
    "🧰️framework/🛍️products/💻️os/📦️packages/🦀️rust/🎛️commands/y/🟦️.ts": [
     "execSync(2);"
    ],
    "other/🟦️.ts": [
     "spawnSync(1);"
    ],
    "sub/📜️script.ts": [
     "spawn(1);"
    ],
    "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🎛️commands/x/🧪️tests/🟦️.ts": [
     "spawnSync(1);"
    ]
   },
   "expect": [
    [
