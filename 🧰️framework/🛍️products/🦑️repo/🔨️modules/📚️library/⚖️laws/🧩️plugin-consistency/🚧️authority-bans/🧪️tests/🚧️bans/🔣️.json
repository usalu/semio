  {
   "id": "raw-spawn-line-numbers-survive-block-comments",
   "rule": "policyRawSpawnBreaches",
   "files": {
    "📜️script.ts": [
     "/* c */",
     "spawnSync(1);"
    ]
   },
   "expect": [
    [
     "no-raw-spawn-📜️script.ts-2",
     "budget/no-raw-spawn",
     "high",
     2
    ]
   ],
   "defect": "🟦️.ts:365-369 drops the comment delimiters from the stripped text, so offsets taken from it no longer index the original content and the reported line shifts"
  },
  {
   "id": "budget-null-literals",
   "rule": "policyBudgetNullBreaches",
   "files": {
    "📜️script.ts": [
     "run({ budgetMs: null });",
     "run({ budgetMs:null, budgetMs: null });",
     "run({ budgetMs: 5 });"
    ],
    "other/🟦️.ts": [
     "budgetMs: null"
    ]
   },
   "expect": [
    [
     "no-budget-null-📜️script.ts-1",
     "budget/no-budget-null",
     "high",
     1
    ],
    [
     "no-budget-null-📜️script.ts-2",
     "budget/no-budget-null",
     "high",
     2
    ]
   ]
  },
  {
   "id": "strip-line-comments-strings-and-templates-are-blanked",
   "rule": "policyStripTsCommentsAndStrings",
   "files": {},
   "input": "a // c\nb \"x\" 'y' `z${1}` c",
   "expectList": [
    "a     \nb                 c"
   ]
  },
  {
   "id": "strip-escapes-stay-inside-their-string",
   "rule": "policyStripTsCommentsAndStrings",
   "files": {},
   "input": "p \"a\\\"b\" q",
   "expectList": [
    "p        q"
   ]
  },
  {
   "id": "strip-block-comments-keep-their-length",
   "rule": "policyStripTsCommentsAndStrings",
   "files": {},
   "input": "a /* c */ b",
   "expectList": [
    "a         b"
   ],
   "defect": "🟦️.ts:363-370 skips the two delimiter characters on both sides without emitting blanks, so a one-line block comment shrinks by four characters"
  }
 ]
