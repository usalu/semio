     "budget/no-raw-spawn",
     "high",
     3
    ],
    [
     "no-raw-spawn-📜️script.ts-7",
     "budget/no-raw-spawn",
     "high",
     7
    ],
    [
     "no-raw-spawn-🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🎛️commands/x/🟦️.ts-1",
     "budget/no-raw-spawn",
     "high",
     1
    ],
    [
     "no-raw-spawn-🧰️framework/🛍️products/💻️os/📦️packages/🦀️rust/🎛️commands/y/🟦️.ts-1",
     "budget/no-raw-spawn",
     "high",
     1
    ],
    [
     "no-raw-spawn-sub/📜️script.ts-1",
     "budget/no-raw-spawn",
     "high",
