     "static mut COUNTER: u32 = 0;",
     "thread_local! { static X: u8 = 0; }",
     "lazy_static! {",
     "    static ref M: Mutex<u8> = Mutex::new(0);",
     "}",
     "static CACHE: Mutex<Vec<u8>> = Mutex::new(Vec::new());",
     "const LAZY: OnceLock<u8> = OnceLock::new();",
     "static NAMES: &[&str] = &[];",
     "pub struct SessionStore {",
