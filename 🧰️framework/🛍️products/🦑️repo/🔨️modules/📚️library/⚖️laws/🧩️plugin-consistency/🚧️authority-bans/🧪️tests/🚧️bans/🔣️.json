{
 "version": 1,
 "cases": [
  {
   "id": "cargo-manifests-skip-generated-and-dependency-directories",
   "rule": "policyDiscoverCargoTomlFiles",
   "files": {
    "Cargo.toml": [],
    "a/Cargo.toml": [],
    "a/b/Cargo.toml": [],
    "node_modules/x/Cargo.toml": [],
    "target/y/Cargo.toml": [],
    "a/Cargo.lock": []
   },
   "expectList": [
    "Cargo.toml",
    "a/Cargo.toml",
    "a/b/Cargo.toml"
   ]
  },
  {
   "id": "db-crates-are-server-only",
   "rule": "policyDbServerOnlyBreaches",
   "files": {
    "app/Cargo.toml": [
     "[dependencies]",
     "db_core = { path = \"../db/core\" }",
     "db = { path = \"../db\", features = [\"x\"] }",
     "dbx = { path = \"../dbx\" }",
     "db_store = { version = \"1\" }",
     "db_net_v2 = { path = \"../n\" }"
    ],
    "Cargo.toml": [
     "db_root = { path = \"db/root\" }"
    ],
    "db/core/Cargo.toml": [
     "db_core = { path = \"../x\" }"
    ],
    "hub/app/Cargo.toml": [
     "db_core = { path = \"../x\" }"
    ]
   },
   "expect": [
    [
     "db-server-only-app/Cargo.toml-db_core",
     "protocol-migration/db-server-only",
     "high",
     0
    ],
    [
     "db-server-only-app/Cargo.toml-db",
     "protocol-migration/db-server-only",
     "high",
     0
    ],
    [
     "db-server-only-app/Cargo.toml-db_net_v2",
     "protocol-migration/db-server-only",
     "high",
     0
    ],
    [
     "db-server-only-Cargo.toml-db_root",
     "protocol-migration/db-server-only",
     "high",
     0
    ]
   ]
  },
  {
   "id": "os-state-authority-globals-ids-and-authority-maps",
