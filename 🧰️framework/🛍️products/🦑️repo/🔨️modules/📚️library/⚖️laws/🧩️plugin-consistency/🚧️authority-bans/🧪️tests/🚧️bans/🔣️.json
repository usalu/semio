  {
   "id": "document-apps-carry-no-state",
   "rule": "policyDocumentAppShapeBreaches",
   "files": {
    "a/stateful.rs": [
     "pub struct Counter { value: u32 }",
     "impl DocumentApp for Counter {",
     "    type Snapshot = S;",
     "    type Mutation = M;",
     "}"
    ],
    "a/unit.rs": [
     "pub struct Unit;",
     "impl DocumentApp for Unit {",
     "    type Snapshot = S;",
     "    type Mutation = M;",
     "}"
    ],
    "a/tuple.rs": [
     "",
     "pub struct T(u8);",
     "impl DocumentApp for T {",
     "    type Snapshot = S;",
     "    type Mutation = M;",
     "}"
    ],
    "a/empty.rs": [
     "struct Empty { /* none */ }",
     "impl DocumentApp for Empty {",
     "    type Snapshot = S;",
     "    type Mutation = M;",
     "}"
    ],
    "a/nomutation.rs": [
     "struct Half { a: u8 }",
     "impl DocumentApp for Half {",
     "    type Snapshot = S;",
     "}"
    ],
    "a/tested.rs": [
     "#[cfg(test)]",
     "mod tests {",
     "    struct X { a: u8 }",
     "    impl DocumentApp for X {",
     "        type Snapshot = S;",
     "        type Mutation = M;",
     "    }",
     "}"
    ],
    "🌎️hub/stateful.rs": [
     "pub struct Counter { value: u32 }",
     "impl DocumentApp for Counter {",
     "    type Snapshot = S;",
     "    type Mutation = M;",
     "}"
    ]
   },
   "expect": [
    [
     "document-app-shape-a/stateful.rs-Counter",
     "os-state-authority/document-app-shape",
     "high",
     1
    ],
    [
     "document-app-shape-a/tuple.rs-T",
     "os-state-authority/document-app-shape",
     "high",
     2
    ]
   ]
  },
  {
