{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Mutation Outcome Law Corpus",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "cases"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "rule",
     "expect",
     "path",
     "source",
     "vocabulary"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "rule": {
      "enum": [
       "policyOutcomeCodeFileBreaches"
      ]
     },
     "oracle": {
      "type": "boolean"
     },
     "defect": {
      "type": "string"
     },
     "expect": {
      "type": "array",
      "items": {
       "type": "array",
       "minItems": 4,
       "maxItems": 4,
       "items": [
        {
         "type": "string"
        },
        {
         "type": "string"
        },
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      }
     },
     "path": {
      "type": "string"
     },
     "source": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "codes",
       "applyPattern",
       "applyLevel"
      ],
      "properties": {
       "codes": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "code",
          "level"
         ],
         "properties": {
          "code": {
           "type": "string"
          },
          "level": {
           "type": "string"
          }
         }
        }
       },
       "applyPattern": {
        "type": "string"
       },
       "applyLevel": {
        "type": "string"
       }
      }
     }
    }
   }
  }
 }
}
