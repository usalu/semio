{
 "version": 1,
 "cases": [
  {
   "id": "rust-leaf-sources-use-the-frozen-vocabulary",
   "rule": "policyOutcomeCodeFileBreaches",
   "path": "a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs",
   "source": [
    "fn build() -> MutationOutcome<D> {",
    "    let ok = MutationOutcome::error(\"mutation.target-missing\");",
    "    let bad_level = MutationOutcome::fatal(\"mutation.target-missing\");",
    "    let unknown = MutationMessage::info(\"mutation.not-a-code\");",
    "    out.warning(\"mutation.clamped\");",
    "    out.info(\"mutation.target-missing\");",
    "    let l = \"mutation.leaf-literal\";",
    "    MutationMessage::warn(\"x\");",
    "}",
    "fn other() { let c = x.warning(\"mutation.zzz\"); y.warn(1); }",
    "let e = MutationApplyError::new(\"mutation.apply.bad-thing\");",
    "let f = MutationApplyError { code: \"nope\" };",
    "    \"warn\" => Severity::Warning,"
   ],
   "vocabulary": {
    "codes": [
     {
      "code": "mutation.target-missing",
      "level": "error"
     },
     {
      "code": "mutation.no-op",
      "level": "warning"
     },
     {
      "code": "mutation.clamped",
      "level": "warning"
     }
    ],
    "applyPattern": "^mutation\\.apply\\.[a-z-]+$",
    "applyLevel": "error"
   },
   "expect": [
    [
     "mutation-message-code-a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs-3-mutation.target-missing",
     "mutation-migration/message-code",
     "high",
     3
    ],
    [
     "mutation-message-code-a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs-4-mutation.not-a-code",
     "mutation-migration/message-code",
     "high",
     4
    ],
    [
     "mutation-message-code-a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs-6-mutation.target-missing",
     "mutation-migration/message-code",
     "high",
     6
    ],
    [
     "mutation-message-code-a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs-7-mutation.leaf-literal",
     "mutation-migration/message-code",
     "high",
     7
    ],
    [
     "mutation-message-code-a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs-10-mutation.zzz",
     "mutation-migration/message-code",
     "high",
     10
    ],
    [
     "mutation-message-code-a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs-12-nope",
     "mutation-migration/message-code",
     "high",
     12
    ],
    [
     "mutation-message-retired-builder-a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs-8-353",
     "mutation-migration/message-code",
     "high",
     8
    ],
    [
     "mutation-message-level-alias-a/🧬️mutations/🔹️m/🔺️diff/🦀️.rs-13",
     "mutation-migration/message-code",
     "high",
     13
    ]
   ]
