  {
   "id": "validate-overrides-inside-mutation-kind-impls-are-located-at-the-override",
   "rule": "policyNoValidateOverrideBreaches",
   "git": true,
   "files": {
    "a/b/🦀️.rs": [
     "fn first() {}",
     "impl<T> MutationKind<D> for K {",
     "    fn validate(&self) {}",
     "}"
    ]
   },
   "expect": [
    [
     "no-validate-override-a/b/🦀️.rs-3",
     "mutation-migration/no-validate-override",
     "high",
     3
    ]
   ],
   "defect": "🟦️.ts:94 adds the override offset, which is relative to the impl body, to the offset of the impl header, so the breach points at the header line instead of the validate line"
  },
