{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Crate Shape Law Corpus",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "cases"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "rule",
     "expect",
     "source"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "rule": {
      "enum": [
       "policyRegionFormatBreaches",
       "policyManifestRegionBreaches",
       "policyStructNamingBreaches",
       "policyModLayoutBreaches",
       "policySelectionIdsBreaches",
       "policyArtifactAppLawDelegateBreaches",
       "policyTreeItemBreaches",
       "policyLabelsStructBreaches"
      ]
     },
     "oracle": {
      "type": "boolean"
     },
     "defect": {
      "type": "string"
     },
     "expect": {
      "type": "array",
      "items": {
       "type": "array",
       "minItems": 4,
       "maxItems": 4,
       "items": [
        {
         "type": "string"
        },
        {
         "type": "string"
        },
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      }
     },
     "scope": {
      "type": "string"
     },
     "source": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "crate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "dir",
       "pluginId"
      ],
      "properties": {
       "dir": {
        "type": "string"
       },
       "pluginId": {
        "type": "string"
       }
      }
     }
    }
   }
  }
 }
}
