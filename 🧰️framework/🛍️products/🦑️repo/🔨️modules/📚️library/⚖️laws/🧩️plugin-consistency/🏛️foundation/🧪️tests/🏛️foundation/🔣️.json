    "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🎛️commands/🔸️a/🧪️tests/🟦️.ts": [],
    "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🎛️commands/🔸️a/other.ts": [],
    "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚖️laws/🧩️plugin-consistency/🔸️b/🟦️.ts": [],
    "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🚨️policy/🔸️c/🟦️.ts": [],
    "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🎛️commands/node_modules/🟦️.ts": []
