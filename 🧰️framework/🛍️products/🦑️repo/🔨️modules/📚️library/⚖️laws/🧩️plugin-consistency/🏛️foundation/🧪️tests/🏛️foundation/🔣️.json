    "🧰️framework/🛍️products/💻️os/📦️packages/🦀️rust/🎛️commands/🔸️x/🧪️tests/🟦️.ts": [],
    "🧰️framework/🛍️products/💻️os/📦️packages/🦀️rust/🔸️y/🟦️.ts": []
