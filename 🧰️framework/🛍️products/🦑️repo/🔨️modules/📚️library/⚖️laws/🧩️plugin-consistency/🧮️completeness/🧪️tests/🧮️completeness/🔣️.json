    "x.txt": []
   },
   "expect": []
  },
  {
   "id": "document-app-usages-are-extracted-from-source",
   "rule": "policyDocumentAppUsages",
   "files": {},
   "scope": "scope/x",
   "source": [
    "impl DocumentApp for One {",
    "    type Snapshot = crate::a::Snap<T>;",
    "    type Mutation = Mut;",
    "}",
    "impl DocumentApp for Half {",
    "    type Snapshot = S;",
    "}",
    "impl DocumentApp for Two {",
    "    type Mutation = m::M;",
    "    type Snapshot = S2;",
    "}"
   ],
   "expectList": [
    "scope/x|1|One|Snap|Mut",
    "scope/x|8|Two|S2|M"
   ]
  }
 ]
}
