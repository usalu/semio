{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Interactivity All App Corpus",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "cases"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "rule",
     "expect"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "rule": {
      "enum": [
       "descriptor",
       "descriptorCounts",
       "disposition",
       "production",
       "playgrounds",
       "renderers",
       "surfaces",
       "coverage",
       "gates",
       "discovery",
       "discoverySummary",
       "constants",
       "oracleJson"
      ]
     },
     "args": {
      "type": "array"
     },
     "files": {
      "type": "object",
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "oracle": {
      "type": "boolean"
     },
     "defect": {
      "type": "string"
     },
     "git": {
      "type": "boolean"
     },
     "expect": true
    }
   }
  }
 }
}
