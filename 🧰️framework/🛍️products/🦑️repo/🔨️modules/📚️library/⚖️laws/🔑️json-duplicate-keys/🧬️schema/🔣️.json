{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:laws/json-duplicate-key/fixtures",
  "title": "JSON duplicate key fixtures",
  "description": "Language-agnostic cases of the json-duplicate-key law: a JSON text and the repeated object keys a detector must report, as `$`-rooted path, 1-based line of the later occurrence and decoded key. The TypeScript law and the independent Python model both read this document; the Python model checks path and key only and skips cases that set `oracle` to false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "duplicates"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string"},
          "oracle": {"type": "boolean"},
          "duplicates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line", "key"],
              "properties": {
                "path": {"type": "string", "pattern": "^\\$"},
                "line": {"type": "integer", "minimum": 1},
                "key": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
