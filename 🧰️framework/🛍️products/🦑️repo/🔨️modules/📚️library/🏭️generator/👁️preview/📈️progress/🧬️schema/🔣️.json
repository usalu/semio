{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/library/generator/preview/progress/component.json",
  "title": "GeneratorPreviewProgressPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "maxEventBytes",
    "maxBytes",
    "maxEvents",
    "maxWork",
    "maxDurationMs",
    "maxSourceBytes",
    "maxSources"
  ],
  "properties": {
    "protocol": {
      "const": "physical-file-progress-v1"
    },
    "maxEventBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "maxEvents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "maxWork": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "maxDurationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "maxSourceBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "maxSources": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    }
  }
}
