{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/repo/library/testing/mutation-scenario-identities/schema.json",
  "type": "object",
  "required": [
    "id",
    "directoryName"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "directoryName": {
      "type": "string",
      "pattern": "^[^a-z0-9/\\\\]+[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
