{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/library/testing/typed-fixture/v1",
  "title": "Typed fixture loader: the corpus of cases that pair one schema with one value and the verdict every validator must give",
  "definitions": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "value", "valid"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "schema": {"type": "object"},
        "value": {},
        "valid": {"type": "boolean"}
      }
    },
    "Corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cases"],
      "properties": {
        "version": {"const": 1},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Case"}}
      }
    }
  },
  "$ref": "#/definitions/Corpus"
}
