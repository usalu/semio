        ],
        [
          "nx",
          "run",
          "@semio-tech/repo-lib:test-wasm-outputs:release"
        ],
        [
          "nx",
          "run",
          "repo:test-wasm-outputs"
        ],
        [
          "nx",
          "run",
          "repo:test-wasm-outputs:prototype"
        ],
        [
          "nx",
          "run",
          "repo:test-wasm-outputs:release"
        ],
        [
          "nx",
          "run",
          "@semio-tech/repo-lib:test-private-native-birth"
        ],
        [
          "nx",
          "run",
          "@semio-tech/repo-lib:test-private-native-birth:prototype"
        ],
        [
          "nx",
          "run",
          "@semio-tech/repo-lib:test-private-native-birth:release"
        ]
      ]
    },
    "Funding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remainingMilliseconds",
        "maximumChildMilliseconds",
        "maximumBytes",
        "maximumLines"
      ],
      "properties": {
        "remainingMilliseconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "maximumChildMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "RecordCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "metadataBytes",
        "ownerBytes",
        "kind",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "metadataBytes": {
          "type": "integer",
          "minimum": 0
        },
        "ownerBytes": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "regular",
            "symlink",
            "hardlink"
          ]
        },
        "accepted": {
          "type": "boolean"
        }
      }
    }
  },
  "$id": "semio:repo/private-native-test-process/v1"
