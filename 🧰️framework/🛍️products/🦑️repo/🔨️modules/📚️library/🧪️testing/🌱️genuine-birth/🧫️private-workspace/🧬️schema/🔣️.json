{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private Native Test Birth",
  "definitions": {
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "codeRoot",
        "parentProcessId",
        "rootDevice",
        "rootInode"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "enum": [
            "wgpu-wasm-outputs",
            "native-birth-witness"
          ]
        },
        "codeRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "parentProcessId": {
          "type": "integer",
          "minimum": 1
        },
        "rootDevice": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "rootInode": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "Protocol": {
      "const": {
        "version": 1,
        "maximumMetadataBytes": 4096,
        "maximumObservationBytes": 4096,
        "ownerFile": ".owner",
        "metadataFile": ".native-test-birth.json",
        "outputDirectory": ".tmp/native-test",
        "receiptPrefix": "[private-native-test] ",
        "maximumCaptureBytes": 16777216,
        "maximumCaptureLines": 65536,
        "maximumOwnerBytes": 16
      }
    },
    "Purposes": {
      "const": {
        "wgpu-wasm-outputs": {
          "target": "@semio-tech/repo-lib:test-wasm-outputs",
          "entry": "⚡️caching/🧪️tests/🧊️wasm-outputs/📥️os/📜️script.ts",
          "allowedParentTargets": [
            "@semio-tech/repo-lib:test-wasm-outputs",
            "repo:test-wasm-outputs"
          ]
        },
        "native-birth-witness": {
          "target": "@semio-tech/repo-lib:test-private-native-birth",
          "entry": "🧪️testing/🌱️genuine-birth/🧫️private-workspace/🧪️tests/👷️child/📜️script.ts",
          "allowedParentTargets": [
            "@semio-tech/repo-lib:test-private-native-birth"
          ]
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "codeRoot",
        "workspace",
        "parentProcessId",
        "processId",
        "deadlineEpochMilliseconds",
        "transport",
        "child",
        "network",
        "retired"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "$ref": "#/definitions/Metadata/properties/purpose"
        },
        "codeRoot": {
          "$ref": "#/definitions/Metadata/properties/codeRoot"
        },
        "workspace": {
          "$ref": "#/definitions/Metadata/properties/codeRoot"
        },
        "parentProcessId": {
          "type": "integer",
          "minimum": 1
        },
        "processId": {
          "type": "integer",
          "minimum": 1
        },
        "deadlineEpochMilliseconds": {
          "type": "integer",
          "minimum": 1
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumBytes",
            "maximumLines"
          ],
          "properties": {
            "maximumBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumLines": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "child": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumElapsedMilliseconds"
          ],
          "properties": {
            "maximumElapsedMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "idleMilliseconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offline"
          ],
          "properties": {
            "offline": {
              "type": "boolean"
            }
          }
        },
        "retired": {
          "const": true
        }
      }
    },
    "ParentSelectionHeader": {
      "enum": [
        [
          "repo",
          "run",
          "@semio-tech/repo-lib:test-wasm-outputs"
        ],
        [
          "repo",
          "run",
