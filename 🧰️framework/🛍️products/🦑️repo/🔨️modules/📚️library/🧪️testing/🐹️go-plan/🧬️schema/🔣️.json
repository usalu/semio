{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Go Build Lease Ownership Cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "fault",
          "events",
          "errors"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "fault": {
            "enum": [
              "none",
              "open",
              "recheck",
              "build",
              "close",
              "build-close",
              "tools"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "enum": [
                "open",
                "recheck",
                "path",
                "build",
                "close",
                "tools"
              ]
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
