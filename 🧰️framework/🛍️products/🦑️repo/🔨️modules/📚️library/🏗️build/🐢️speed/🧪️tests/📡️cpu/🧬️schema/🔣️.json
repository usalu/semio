{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["platform", "pid", "text"],
    "properties": {
      "platform": { "enum": ["darwin", "linux", "win32"] },
      "pid": { "type": "integer", "minimum": 0 },
      "text": { "type": "string", "maxLength": 1024 }
    }
  }
}
