    {
      "name": "root-body",
      "edits": [
        {
          "path": "lib.rs",
          "before": "VALUE:u8=7",
          "after": "VALUE:u8=8"
        }
      ],
      "affected": [
        "profile_arguments"
      ]
    },
    {
      "name": "leaf-body",
      "edits": [
        {
          "path": "leaf/lib.rs",
          "before": "{11}",
          "after": "{12}"
        }
      ],
      "affected": [
        "profile_arguments",
        "profile_dependency"
      ]
    },
    {
      "name": "context",
      "edits": [
        {
          "path": "Cargo.toml",
          "before": "codegen-units=256",
          "after": "codegen-units=128"
