{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "platform", "contended"],
        "properties": {
          "code": {"type": "string", "pattern": "^E[A-Z]+$"},
          "platform": {"enum": ["linux", "darwin", "win32"]},
          "contended": {"type": "boolean"}
        }
      }
    }
  }
}
