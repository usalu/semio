{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["maximumWorkers", "unrelatedLoads", "requests"],
  "properties": {
    "maximumWorkers": {"const": 2},
    "unrelatedLoads": {"type": "integer", "minimum": 64},
    "requests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "name", "arguments"],
        "properties": {
          "root": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
