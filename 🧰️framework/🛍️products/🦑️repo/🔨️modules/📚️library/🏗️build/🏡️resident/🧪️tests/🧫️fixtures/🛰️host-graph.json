 },
 "dependencies": [
  {
   "source": "util",
   "target": "core"
  },
  {
   "source": "app",
   "target": "util"
  },
  {
   "source": "app",
   "target": "core"
  },
  {
   "source": "tool",
   "target": "core"
  }
 ]
}