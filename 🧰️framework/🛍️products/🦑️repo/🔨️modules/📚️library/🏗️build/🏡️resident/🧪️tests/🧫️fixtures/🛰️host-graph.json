{
 "projects": {
  "core": {
   "name": "core",
   "root": "libs/core",
   "targets": {
    "build": {
     "execution": {
      "command": "build core"
     },
     "dependsOn": [
      "^build"
     ],
     "outputs": [
      "{projectRoot}/dist"
     ]
    },
    "test": {
     "execution": {
      "command": "test core"
     },
     "dependsOn": [
      "build",
      "^build"
     ],
     "outputs": []
    }
   }
  },
  "util": {
   "name": "util",
   "root": "libs/util",
   "targets": {
    "build": {
     "execution": {
      "command": "build util"
     },
     "dependsOn": [
      "^build"
     ],
     "outputs": [
      "{projectRoot}/dist"
     ]
    },
    "test": {
     "execution": {
      "command": "test util"
     },
     "dependsOn": [
      "build",
      "^build"
     ],
     "outputs": []
    }
   }
  },
  "app": {
   "name": "app",
   "root": "libs/app",
   "targets": {
    "build": {
     "execution": {
      "command": "build app"
     },
     "dependsOn": [
      "^build"
     ],
     "outputs": [
      "{projectRoot}/dist"
     ]
    },
    "test": {
     "execution": {
      "command": "test app"
     },
     "dependsOn": [
      "build",
      "^build"
     ],
     "outputs": []
    }
   }
