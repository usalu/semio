    "test": {
     "execution": {
      "command": "test tool"
     },
     "dependsOn": [
      "build",
      "^build"
     ],
     "outputs": []
    }
   }
  },
  "docs": {
   "name": "docs",
   "root": "libs/docs",
   "targets": {
    "build": {
     "execution": {
      "command": "build docs"
     },
     "dependsOn": [
      "^build"
     ],
