{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository Target Execution Contract",
  "oneOf": [
    {
      "$ref": "#/definitions/Source"
    },
    {
      "$ref": "#/definitions/Native"
    },
    {
      "$ref": "#/definitions/Orchestration"
    }
  ],
  "definitions": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "source"
        }
      }
    },
    "Native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "scope"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "native"
        },
        "scope": {
          "enum": [
            "production",
            "test"
          ]
        }
      }
    },
    "Orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "orchestration"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project",
              "target"
            ],
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^:\\s\\u0000]+$"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "configuration": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_-]+$"
              }
            }
          }
        }
      }
    }
  }
}
