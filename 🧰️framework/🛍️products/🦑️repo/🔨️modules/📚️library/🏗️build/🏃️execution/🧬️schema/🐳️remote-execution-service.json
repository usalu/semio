{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local Remote Execution Service",
  "description": "🐳️ An optional, ephemeral developer service that runs a Remote Execution API cluster (storage, frontend, scheduler, worker and runner) in a container runtime on this machine so hermetic Bazel actions can run remotely without any external service. Nothing depends on it: unset, every action stays local.",
  "oneOf": [
    {
      "$ref": "#/definitions/Service"
    }
  ],
  "definitions": {
    "Name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "Platform": {
      "description": "The execution platform id of the workers; it is the id the remote execution contract routes hermetic actions to.",
      "enum": [
        "linux-arm64",
        "linux-x64"
      ]
    },
    "Digest": {
      "description": "The content digest of the image index, so a moved tag can never change what runs.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "services"
      ],
      "properties": {
        "repository": {
          "description": "Official registry path of the image.",
          "type": "string",
          "pattern": "^(ghcr\\.io/buildbarn/bb-[a-z-]+|docker\\.io/library/ubuntu)$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "digest": {
          "$ref": "#/definitions/Digest"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Name"
          }
        }
      }
    },
    "Environment": {
      "description": "Names of the variables the compose file reads; the command sets them from its flags.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "dockerPlatform",
        "port",
        "diagnosticsPort"
      ],
      "properties": {
        "platform": {
          "const": "SEMIO_RBE_PLATFORM"
        },
        "dockerPlatform": {
          "const": "SEMIO_RBE_DOCKER_PLATFORM"
        },
        "port": {
          "const": "SEMIO_RBE_PORT"
        },
        "diagnosticsPort": {
          "const": "SEMIO_RBE_DIAGNOSTICS_PORT"
        }
      }
    },
    "Service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "name",
        "title",
        "runtime",
        "project",
        "compose",
        "instance",
        "host",
        "port",
        "diagnostics",
        "platforms",
        "readyTimeoutSeconds",
        "ephemeral",
        "environment",
        "images"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "$ref": "#/definitions/Name"
        },
        "title": {
          "$ref": "#/definitions/Text"
        },
        "runtime": {
          "description": "The container runtime interface the command speaks.",
          "const": "docker-compose"
        },
        "project": {
          "$ref": "#/definitions/Name"
        },
        "compose": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "instance": {
          "description": "The Remote Execution API instance name the workers serve; clients send it as their instance name.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "host": {
          "description": "Loopback only: the service has no authentication.",
          "enum": [
            "127.0.0.1"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "path"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9/_.-]*$"
            }
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Platform"
          }
        },
        "readyTimeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1800
        },
        "ephemeral": {
          "description": "Stopping the service removes its volumes: the state is ephemeral local-only.",
          "const": true
        },
        "environment": {
          "$ref": "#/definitions/Environment"
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/Image"
          }
        }
      }
    },
    "Rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "compose",
        "client"
      ],
      "properties": {
        "platform": {
          "$ref": "#/definitions/Platform"
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "project",
            "environment"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "project": {
              "$ref": "#/definitions/Name"
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "SEMIO_REMOTE_EXECUTION_ENDPOINT",
            "SEMIO_REMOTE_EXECUTION_PLATFORM",
            "SEMIO_REMOTE_EXECUTION_INSTANCE"
          ],
          "properties": {
            "SEMIO_REMOTE_EXECUTION_ENDPOINT": {
              "type": "string",
              "pattern": "^grpc://127\\.0\\.0\\.1:[0-9]{4,5}$"
            },
            "SEMIO_REMOTE_EXECUTION_PLATFORM": {
              "$ref": "#/definitions/Platform"
            },
            "SEMIO_REMOTE_EXECUTION_INSTANCE": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            }
          }
        }
      }
    },
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "service",
        "runtime",
        "containers",
        "endpoint",
        "client"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "service": {
          "$ref": "#/definitions/Name"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "version": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service",
              "state"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "exitCode": {
                "type": "integer"
              }
            }
          }
        },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "answers"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "answers": {
              "type": "boolean"
            }
          }
        },
        "client": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
