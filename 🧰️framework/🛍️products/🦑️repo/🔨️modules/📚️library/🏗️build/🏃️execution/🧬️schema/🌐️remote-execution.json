        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "pressure": {
          "$ref": "#/definitions/Pressure"
        },
        "freeMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "load": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "headroom": {
          "type": "boolean"
        },
        "wallMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "worker": {
          "$ref": "#/definitions/WorkerState"
        },
        "counters": {
          "$ref": "#/definitions/MachineCounters"
        }
      }
    },
    "LoadRow": {
      "description": "One machine of the live table.",
