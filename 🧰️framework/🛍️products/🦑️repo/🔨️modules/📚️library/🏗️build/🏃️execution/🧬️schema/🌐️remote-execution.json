              "type": "null"
            }
          ]
        },
        "requester": {
          "oneOf": [
            {
              "$ref": "#/definitions/Origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsedSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "FleetLoad": {
      "description": "What `GET /v1/fleet/load` answers: the live table of the fleet.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "service",
        "wallMs",
        "expireSeconds",
        "machines",
        "tasks",
        "queued",
        "executing",
        "counters"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "service": {
