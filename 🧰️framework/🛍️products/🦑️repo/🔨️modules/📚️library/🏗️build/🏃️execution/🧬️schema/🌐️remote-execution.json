            "$ref": "#/definitions/LoadRow"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskRow"
          }
        },
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "executing": {
          "type": "integer",
          "minimum": 0
        },
        "counters": {
          "$ref": "#/definitions/Counter"
        }
      }
