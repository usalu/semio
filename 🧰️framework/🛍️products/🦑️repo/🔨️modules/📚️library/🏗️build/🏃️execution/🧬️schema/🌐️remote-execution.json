    "Refusal": {
      "enum": [
        "memory",
        "swap",
        "swap-activity",
        "pressure-critical",
        "pressure-warn",
        "files",
        "attaches",
        "load",
        "queue-order",
        "ramp",
        "quiet-limit",
        "slots",
        "disk",
        "not-ready",
        "draining"
