{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Remote execution",
  "description": "Closed shapes of the in-house remote execution service: policy, worker protocol, status and message catalogue. The protocol towards build tools (the Remote Execution API over gRPC) is generated from Bazel's own descriptors into the wire schema of the module and is not repeated here.",
  "definitions": {
    "Digest": {
      "description": "A content digest: lowercase SHA-256 and the size in bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "size"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Instance": {
      "type": "string",
      "pattern": "^([a-z0-9][a-z0-9._-]{0,63})?$",
      "description": "The instance name of the protocol; empty selects the default instance of the cache."
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "Sandbox": {
      "enum": [
        "darwin-sandbox",
        "linux-sandbox",
        "isolated-root"
      ],
      "description": "How a worker confines an action: the macOS sandbox, a Linux user-namespace sandbox, or a private input root with a cleaned environment (every platform)."
    },
    "Language": {
      "enum": [
        "en",
        "de"
      ]
    },
    "EnvironmentNames": {
      "description": "The variables of the client contract (shared with the build tool adapters) and of the worker agent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "platform",
        "instance",
        "properties",
        "jobs",
        "scheduler",
        "workerToken"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "platform": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "instance": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "properties": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "jobs": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "scheduler": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "workerToken": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        }
      }
    },
    "ServerPolicy": {
      "description": "Bounds of the scheduler and its two listeners: gRPC for build clients and an HTTP API for workers and status.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "workerPort",
        "localWorkers",
        "unmatchedSeconds",
        "lingerSeconds",
        "leaseSeconds",
        "maximumAttempts",
        "defaultActionSeconds",
        "maximumActionSeconds",
        "maximumQueued",
        "maximumWorkers",
        "maximumRequestBytes",
        "maximumMessageBytes",
        "maximumBatchBytes",
        "defaultInstance",
        "loadExpireSeconds",
        "refusalCooldownSeconds"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "workerPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "localWorkers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "unmatchedSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "lingerSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3600
        },
        "maximumAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "defaultActionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "maximumActionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "The longest an action may run; a longer timeout in a request is cut to it."
        },
        "maximumQueued": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maximumWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "How many workers may be registered at once."
        },
        "maximumRequestBytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 1073741824,
          "description": "The largest body the worker API accepts."
        },
        "maximumMessageBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 268435456
        },
        "maximumBatchBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "defaultInstance": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "loadExpireSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "refusalCooldownSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "WorkerPolicy": {
      "description": "Defaults of a worker agent; concurrency 0 means one slot per CPU.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "heartbeatSeconds",
        "pollSeconds",
        "directory",
        "materialize",
        "maximumBlobBytes",
        "sandbox",
        "inlineOutputBytes",
        "loadIntervalSeconds",
        "network",
        "confinement",
        "actions",
        "disk"
      ],
      "properties": {
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reserveGigabytes",
            "perActionGigabytes"
          ],
          "properties": {
            "reserveGigabytes": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000,
              "description": "Free space of the volume of the work directory that stays untouched for the machine itself: the worker's blob cache (256 MiB), swap, the replica and the owner's own builds. A worker takes no action below this plus one action."
            },
            "perActionGigabytes": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000,
              "description": "The worst case one action adds to the volume: the largest compiler outputs measured are 140 MB, written beside a temporary copy and the dependency file. The worker runs one action at once for every such share of free space above the reserve, at most its concurrency."
            }
          }
        },
        "concurrency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "heartbeatSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "materialize": {
          "enum": [
            "clone",
            "copy"
          ]
        },
        "maximumBlobBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1125899906842624
        },
        "sandbox": {
          "enum": [
            "auto",
            "darwin-sandbox",
            "linux-sandbox",
            "isolated-root"
          ]
        },
        "inlineOutputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "loadIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "network": {
          "enum": [
            "deny",
            "allow"
          ],
          "description": "`deny`: every action runs without network (a strategy that cannot enforce it is reported as `unenforced`); `allow`: actions may use the network."
        },
        "confinement": {
          "enum": [
            "required",
            "best-effort"
          ],
          "description": "`required`: a worker whose host has no confining sandbox refuses to start; `best-effort`: it starts with the private input root alone and reports `confinement: none`."
        },
        "actions": {
          "enum": [
            "rustc",
            "any",
            "none"
          ],
          "description": "Which actions the worker runs. `rustc`: only the declared rustc unit of the offload, with arguments and environment from a closed allow-list (the default, and the only choice an unconfined worker accepts besides `none`); `any`: every command, refused at start on a worker without a confining sandbox; `none`: no action."
        }
      }
    },
    "Policy": {
      "description": "The authored data in the build policy.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "environment",
        "server",
        "worker"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "environment": {
          "$ref": "#/definitions/EnvironmentNames"
        },
        "server": {
          "$ref": "#/definitions/ServerPolicy"
        },
        "worker": {
          "$ref": "#/definitions/WorkerPolicy"
        }
      }
    },
    "WorkerRegistration": {
      "description": "What a worker announces when it joins.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "name",
        "host",
        "platform",
        "properties",
        "concurrency",
        "sandbox",
        "runtime",
        "origin",
        "capacity",
        "confinement",
        "network"
      ],
      "properties": {
        "resumed": {
          "description": "The tasks a worker is still running when it joins again after the scheduler lost its state (a restart): the scheduler adopts them instead of running the same actions a second time.",
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "instance", "action"],
            "properties": {
              "task": { "type": "string", "pattern": "^[0-9a-f-]{36}\\.[0-9]{1,3}$" },
              "instance": { "type": "string", "maxLength": 64 },
              "action": { "type": "object", "additionalProperties": false, "required": ["hash", "size"], "properties": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "size": { "type": "integer", "minimum": 0 } } }
            }
          }
        },
        "version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Property"
          },
          "maxItems": 64
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "sandbox": {
          "$ref": "#/definitions/Sandbox"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "origin": {
          "$ref": "#/definitions/Origin"
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cores",
            "memoryMegabytes"
          ],
          "properties": {
            "cores": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "memoryMegabytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "confinement": {
          "$ref": "#/definitions/Confinement"
        },
        "network": {
          "$ref": "#/definitions/NetworkPolicy"
        }
      }
    },
    "WorkerRegistered": {
      "description": "The scheduler's answer to a registration; `relative` means the cache lives on the scheduler's host at the url's port.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "heartbeatSeconds",
        "pollSeconds",
        "leaseSeconds",
        "cache",
        "language"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "heartbeatSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "relative"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "relative": {
              "type": "boolean"
            }
          }
        },
        "language": {
          "enum": [
            "en",
            "de",
            "none"
          ]
        }
      }
    },
    "Task": {
      "description": "One action assigned to a worker.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "instance",
        "action",
        "timeoutSeconds",
        "attempt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance": {
          "$ref": "#/definitions/Instance"
        },
        "action": {
          "$ref": "#/definitions/Digest"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "PollAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "task",
        "cancel",
        "known"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "task": {
          "oneOf": [
            {
              "$ref": "#/definitions/Task"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "known": {
          "type": "boolean"
        }
      }
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "running"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "running": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 512
        }
      }
    },
    "HeartbeatAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "known",
        "cancel"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "known": {
          "type": "boolean"
        },
        "cancel": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "TaskStatus": {
      "description": "Outcome in the vocabulary of gRPC; `missing` lists input blobs the worker could not find (FAILED_PRECONDITION).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "missing": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Digest"
          },
          "maxItems": 100000
        }
      }
    },
    "TaskResult": {
      "description": "A worker's report; `actionResult` is the serialized ActionResult of the protocol in base64.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "outcome",
        "status",
        "actionResult"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "refused"
          ]
        },
        "status": {
          "$ref": "#/definitions/TaskStatus"
        },
        "actionResult": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "refusal": {
          "oneOf": [
            {
              "$ref": "#/definitions/Refusal"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Counter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queued",
        "executing",
        "completed",
        "cached",
        "failed",
        "cancelled",
        "retried",
        "deduplicated",
        "refused",
        "offloadRejected"
      ],
      "properties": {
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "executing": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "retried": {
          "type": "integer",
          "minimum": 0
        },
        "deduplicated": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "offloadRejected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WorkerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "host",
        "platform",
        "properties",
        "concurrency",
        "running",
        "sandbox",
        "lastSeenSeconds",
        "draining",
        "origin",
        "confinement",
        "network",
        "headroom",
        "offloadedIn",
        "refused"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Property"
          }
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "sandbox": {
          "$ref": "#/definitions/Sandbox"
        },
        "lastSeenSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "draining": {
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/definitions/Origin"
        },
        "confinement": {
          "$ref": "#/definitions/Confinement"
        },
        "network": {
          "$ref": "#/definitions/NetworkPolicy"
        },
        "headroom": {
          "type": "boolean"
        },
        "offloadedIn": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ServerStatus": {
      "description": "What `GET /status` of the worker API answers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "service",
        "startedAt",
        "grpc",
        "workerApi",
        "cache",
        "counters",
        "workers",
        "platforms"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "service": {
          "const": "semio-remote-execution"
        },
        "startedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "grpc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workerApi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "answers"
          ],
          "properties": {
            "url": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "answers": {
              "type": "boolean"
            }
          }
        },
        "counters": {
          "$ref": "#/definitions/Counter"
        },
        "workers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkerRow"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "queued",
              "workers"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "queued": {
                "type": "integer",
                "minimum": 0
              },
              "workers": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "Probe": {
      "description": "One reachability probe.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reachable",
        "milliseconds",
        "detail"
      ],
      "properties": {
        "reachable": {
          "type": "boolean"
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "Status": {
      "description": "What `remote-execution status` prints.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "configured",
        "contract",
        "scheduler",
        "grpc",
        "server",
        "token"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "configured": {
          "type": "boolean"
        },
        "contract": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "endpoint",
                "platform",
                "instance",
                "properties",
                "jobs"
              ],
              "properties": {
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "platform": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "instance": {
                  "$ref": "#/definitions/Instance"
                },
                "properties": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Property"
                  }
                },
                "jobs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 512
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduler": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "grpc": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capabilities",
                "execution",
                "apiVersions",
                "digestFunctions",
                "probe"
              ],
              "properties": {
                "capabilities": {
                  "type": "boolean"
                },
                "execution": {
                  "type": "boolean"
                },
                "apiVersions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "digestFunctions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "probe": {
                  "$ref": "#/definitions/Probe"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "server": {
          "oneOf": [
            {
              "$ref": "#/definitions/ServerStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "environment",
                "present"
              ],
              "properties": {
                "environment": {
                  "type": "string",
                  "pattern": "^SEMIO_[A-Z0-9_]+$"
                },
                "present": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TextCatalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "languages",
        "messages"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Language"
          },
          "minItems": 2
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "description": "The bilingual messages of the command; there is no default language."
    },
    "Origin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "The origin id of a machine of the fleet (for example g1-m03)."
    },
    "Pressure": {
      "enum": [
        "normal",
        "warn",
        "critical"
      ],
      "description": "The pressure level of the host capacity sample."
    },
    "Confinement": {
      "enum": [
        "full",
        "none"
      ],
      "description": "Whether the sandbox of a worker confines the file system of an action (`none` for the private input root alone)."
    },
    "NetworkPolicy": {
      "enum": [
        "denied",
        "unenforced",
        "allowed"
      ],
      "description": "What a worker does about the network of an action: `denied` (the sandbox cuts it), `unenforced` (denial is asked for but the strategy cannot enforce it), `allowed` (the policy lets actions use it)."
    },
    "PlatformIdentity": {
      "description": "The platform key of a machine: operating system, architecture and the build id of its Rust toolchain (the first 16 hex digits of the sha256 of `rustc -vV`); units are shared and offloaded only between equal keys.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "os",
        "arch",
        "toolchain",
        "target"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "toolchain": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MachineCounters": {
      "description": "Counters of the rustc wrapper and unit cache of one machine, read from `.cache/f/build-counters.json` (zeros when absent).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "offload"
      ],
      "properties": {
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "localHit",
            "remoteHit",
            "miss",
            "stored"
          ],
          "properties": {
            "localHit": {
              "type": "integer",
              "minimum": 0
            },
            "remoteHit": {
              "type": "integer",
              "minimum": 0
            },
            "miss": {
              "type": "integer",
              "minimum": 0
            },
            "stored": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "description": "Units that skipped the fleet cache lookup because the cache was unreachable or refused the credential (counted, never silent).",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "offload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "out",
            "refused",
            "fellBack"
          ],
          "properties": {
            "out": {
              "type": "integer",
              "minimum": 0
            },
            "refused": {
              "type": "integer",
              "minimum": 0
            },
            "fellBack": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "WorkerState": {
      "description": "What the build worker of a machine does right now.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "concurrency",
        "running",
        "sandbox",
        "confinement",
        "network"
      ],
      "properties": {
        "state": {
          "enum": [
            "absent",
            "idle",
            "busy",
            "refusing"
          ]
        },
        "concurrency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "sandbox": {
          "oneOf": [
            {
              "$ref": "#/definitions/Sandbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "confinement": {
          "oneOf": [
            {
              "$ref": "#/definitions/Confinement"
            },
            {
              "type": "null"
            }
          ]
        },
        "network": {
          "oneOf": [
            {
              "$ref": "#/definitions/NetworkPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "why": {
          "$ref": "#/definitions/WorkerWhy"
        }
      }
    },
    "WorkerWhy": {
      "description": "Why a worker is absent: a closed reason code and the same sentence in English and German.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "en",
        "de"
      ],
      "properties": {
        "code": {
          "enum": [
            "starting",
            "no-scheduler",
            "scheduler-unreachable",
            "identity-unregistered",
            "no-toolchain",
            "provisioning",
            "sandbox-unavailable",
            "action-unsupported",
            "disk-full",
            "policy-off",
            "not-registered",
            "no-headroom",
            "failed"
          ]
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "LoadReport": {
      "description": "What every machine sends to the scheduler every few seconds: who it is, its platform key, capacity, running and queued work, the pressure level of the host capacity sample, free memory, load, its own admission verdict (`headroom`) and its wall clock.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
