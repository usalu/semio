{
  "version": 1,
  "cases": [
    {"name": "links are listed in order", "list": ["tsc", "esbuild"], "targets": {"tsc": "../typescript/bin/tsc", "esbuild": "../esbuild/bin/esbuild"}, "expect": [["esbuild", "../esbuild/bin/esbuild"], ["tsc", "../typescript/bin/tsc"]]},
    {"name": "an absent .bin is no shim", "listError": "ENOENT", "expect": []},
    {"name": ".bin that is not a directory is no shim", "listError": "ENOTDIR", "expect": []},
    {"name": "a regular file as bun writes it on Windows is no shim", "list": ["tsc", "tsc.cmd"], "targets": {"tsc": "../typescript/bin/tsc", "tsc.cmd": "EINVAL"}, "expect": [["tsc", "../typescript/bin/tsc"]]},
    {"name": "an entry that vanished while scanning is no shim", "list": ["gone"], "targets": {"gone": "ENOENT"}, "expect": []},
    {"name": "a refused permission on the directory is thrown", "listError": "EACCES", "throws": "EACCES"},
    {"name": "an I/O error on one entry is thrown", "list": ["a", "b"], "targets": {"a": "../a/bin/a", "b": "EIO"}, "throws": "EIO"},
    {"name": "a permission error on one entry is thrown", "list": ["a"], "targets": {"a": "EPERM"}, "throws": "EPERM"}
  ]
}
