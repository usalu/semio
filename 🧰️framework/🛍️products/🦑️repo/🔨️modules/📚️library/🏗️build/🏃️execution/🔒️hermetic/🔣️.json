{
  "$schema": "../🧬️schema/🔒️hermetic-classes.json",
  "version": 1,
  "runtime": {
    "entry": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🏃️execution/🔒️hermetic/🚪️entry/🟦️.ts",
    "inputs": [
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🏃️execution/🔒️hermetic/🚪️entry/🟦️.ts",
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏃️process/🔌️providers/**/*",
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🏃️execution/🔒️hermetic/🔌️providers/**/*.ts",
      "package.json",
      "bunfig.toml"
    ],
    "markers": [
      "📋️project.json"
    ],
    "maximumElapsedMilliseconds": 3600000,
    "covered": [
      "bun --version",
      "node -p \"process.platform.concat(process.arch)\""
    ]
  },
  "environment": {
    "names": [
      "SEMIO_BUILD_MODE",
      "SEMIO_BUILD_BUDGET_MS",
      "SEMIO_TEST_BUDGET_MS",
      "SEMIO_TEST_LEVEL",
      "SOURCE_DATE_EPOCH"
    ],
    "denied": [
      "SEMIO_SCRIPT",
      "SEMIO_WORKSPACE",
      "SEMIO_TASK",
      "SEMIO_REMOTE",
      "SEMIO_HERMETIC",
      "SEMIO_BUILD_TOOL"
    ]
  },
  "strategies": {
    "darwin": [
      "remote",
      "sandboxed",
      "isolated-root"
    ],
    "linux": [
      "remote",
      "sandboxed",
      "isolated-root"
    ],
    "win32": [
      "remote",
      "isolated-root"
    ]
  },
  "classes": [
    {
      "id": "ts-typecheck",
      "description": "TypeScript project type checks: the repository script runs `tsc --noEmit` through the typescript-check port; the hermetic provider runs the compiler from the declared dependency tree without store authority or compiler state.",
      "evidence": "assumed",
      "select": {
        "targets": [
          "typecheck",
          "typecheck-*"
        ],
        "projects": [
          "@teaching/architecture-course",
          "@semio-tech/mathematical-equation",
          "@semio-tech/writer-js"
        ],
        "excludeRoots": [
          "**/🦀️*",
          "**/🦀️*/**"
        ]
      },
      "dependencies": "packages",
      "packages": [
        "typescript"
      ],
      "providers": {
        "typescript-check": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🏃️execution/🔒️hermetic/🔌️providers/🔷️typescript/🟦️.ts"
      }
    },
    {
      "id": "ts-test",
      "description": "Bun and vitest test targets of TypeScript projects: the repository script runs the declared test files, which read only the declared sources, fixtures and dependency tree.",
      "evidence": "assumed",
      "select": {
        "targets": [
          "test",
          "test-*",
          "🧪️test"
        ],
        "projects": [
          "@teaching/architecture-course",
          "@semio-tech/mathematical-equation",
          "@semio-tech/writer-js"
        ],
        "excludeRoots": [
          "**/🦀️*",
          "**/🦀️*/**"
        ]
      },
      "dependencies": "packages",
      "packages": [],
      "providers": {}
    },
    {
      "id": "ts-generate",
      "description": "Schema and code generators of TypeScript projects: a pure function of the declared sources writing only declared outputs.",
      "evidence": "assumed",
      "select": {
        "targets": [
          "generate",
          "generate-*",
          "typegen",
          "typegen-*"
        ],
        "projects": [
          "@teaching/architecture-course",
          "@semio-tech/mathematical-equation",
          "@semio-tech/writer-js"
        ],
        "excludeRoots": [
          "**/🦀️*",
          "**/🦀️*/**"
        ]
      },
      "dependencies": "packages",
      "packages": [],
      "providers": {}
    },
    {
      "id": "ts-build",
      "description": "Bundling and site builds of TypeScript projects: bundlers read the declared sources and dependency tree and write only declared outputs.",
      "evidence": "assumed",
      "select": {
        "targets": [
          "build",
          "build-*"
        ],
        "projects": [
          "@teaching/architecture-course",
          "@semio-tech/mathematical-equation",
          "@semio-tech/writer-js"
        ],
        "excludeRoots": [
          "**/🦀️*",
          "**/🦀️*/**"
        ]
      },
      "dependencies": "packages",
      "packages": [],
      "providers": {}
    },
    {
      "id": "ts-check",
      "description": "Read-only verification of TypeScript projects: check, verify and lint targets that declare no outputs.",
      "evidence": "assumed",
      "select": {
        "targets": [
          "check",
          "check-*",
          "verify",
          "verify-*",
          "lint",
          "lint-*"
        ],
        "projects": [
          "@teaching/architecture-course",
          "@semio-tech/mathematical-equation",
          "@semio-tech/writer-js"
        ],
        "excludeRoots": [
          "**/🦀️*",
          "**/🦀️*/**"
        ]
      },
      "dependencies": "packages",
      "packages": [],
      "providers": {}
    }
  ],
  "exceptions": []
}
