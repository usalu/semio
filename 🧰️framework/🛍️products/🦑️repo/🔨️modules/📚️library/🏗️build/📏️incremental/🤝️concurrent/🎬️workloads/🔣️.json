  "workloads": [
    {
      "id": "disjoint-projects",
      "title": {
        "en": "Agents edit and build disjoint projects",
        "de": "Agenten ändern und bauen getrennte Projekte"
      },
      "summary": {
        "en": "A TypeScript package, a Rust crate, a Go module and a schema crate are edited, built and tested at the same time; nobody may wait for an unrelated project and every result equals a serial run.",
        "de": "Ein TypeScript-Paket, eine Rust-Crate, ein Go-Modul und eine Schema-Crate werden gleichzeitig geändert, gebaut und getestet; niemand darf auf ein fremdes Projekt warten und jedes Ergebnis entspricht einem seriellen Lauf."
      },
      "criteria": "default",
      "setup": [],
      "sessions": [
        {
          "id": "ts",
          "area": "disjoint-ts",
          "group": "g-ts",
          "steps": [
            {
              "kind": "edit",
              "file": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust/📜️script.ts",
              "op": "comment",
              "language": "ts"
            },
            {
              "kind": "barrier",
              "id": "go"
            },
            {
              "kind": "run",
              "target": "@semio-tech/framework-graph:test"
            },
            {
              "kind": "revert"
            },
            {
              "kind": "run",
              "target": "@semio-tech/framework-graph:test"
            }
          ]
        },
        {
          "id": "rust",
          "area": "disjoint-rust",
          "group": "g-rust",
          "steps": [
            {
              "kind": "edit",
              "file": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust/🦀️.rs",
              "op": "comment",
              "language": "rs"
            },
            {
              "kind": "barrier",
              "id": "go"
            },
            {
              "kind": "run",
              "target": "@teaching/proctor:build"
            },
            {
              "kind": "revert"
            },
            {
              "kind": "run",
              "target": "@teaching/proctor:build"
            }
          ]
        },
        {
          "id": "go",
          "area": "disjoint-go",
          "group": "g-go",
          "steps": [
            {
              "kind": "edit",
              "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🚚️move/📦️packages/🐹️go/🐹️.go",
              "op": "comment",
              "language": "go"
            },
            {
              "kind": "barrier",
              "id": "go"
            },
            {
              "kind": "run",
              "target": "@semio-tech/repo-move-go:test"
            },
            {
              "kind": "revert"
            },
            {
              "kind": "run",
              "target": "@semio-tech/repo-move-go:test"
            }
          ]
        },
        {
          "id": "schema",
          "area": "disjoint-schema",
          "group": "g-schema",
          "steps": [
            {
              "kind": "edit",
              "file": "🧰️framework/🔨️modules/🧬️schema/📦️packages/🦀️rust/🦀️.rs",
              "op": "comment",
              "language": "rs"
            },
            {
              "kind": "barrier",
              "id": "go"
            },
            {
              "kind": "run",
              "target": "@semio-tech/framework-schema:test-subset-contract"
            },
            {
              "kind": "revert"
            },
            {
              "kind": "run",
              "target": "@semio-tech/framework-schema:test-subset-contract"
            }
          ]
        }
      ]
    },
    {
      "id": "same-target-cold",
      "title": {
        "en": "Agents build the same changed target at once",
        "de": "Agenten bauen gleichzeitig dasselbe geänderte Ziel"
      },
      "summary": {
        "en": "One edit makes every cache stale; three agents then build the same target together. Each task may execute once, the other agents must find its result.",
        "de": "Eine Änderung macht jeden Cache ungültig; drei Agenten bauen dann zusammen dasselbe Ziel. Jeder Task darf einmal laufen, die anderen Agenten müssen sein Ergebnis finden."
      },
      "criteria": "default",
      "setup": [
        {
          "kind": "edit",
          "file": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust/📜️script.ts",
          "op": "private-body",
          "language": "ts"
        }
      ],
      "sessions": [
        {
          "id": "a",
          "area": "same-target",
          "group": "g-same",
          "delayMilliseconds": 0,
          "steps": [
            {
              "kind": "barrier",
              "id": "go"
            },
            {
              "kind": "run",
              "target": "@semio-tech/framework-graph:test"
            }
          ]
        },
        {
          "id": "b",
          "area": "same-target",
          "group": "g-same",
          "delayMilliseconds": 250,
          "steps": [
            {
              "kind": "barrier",
              "id": "go"
            },
            {
              "kind": "run",
              "target": "@semio-tech/framework-graph:test"
            }
          ]
        },
        {
          "id": "c",
          "area": "same-target",
          "group": "g-same",
          "delayMilliseconds": 500,
          "steps": [
            {
              "kind": "barrier",
              "id": "go"
            },
            {
              "kind": "run",
              "target": "@semio-tech/framework-graph:test"
            }
          ]
        }
      ]
    },
    {
      "id": "warm-fanout",
      "title": {
        "en": "Agents build a warm target at once",
        "de": "Agenten bauen gleichzeitig ein warmes Ziel"
      },
      "summary": {
        "en": "The target is built once before; three agents then build it together and every one must find everything in the cache.",
        "de": "Das Ziel wird vorab einmal gebaut; drei Agenten bauen es dann zusammen und jeder muss alles im Cache finden."
      },
      "criteria": "warm",
      "setup": [
        {
          "kind": "run",
          "target": "@semio-tech/framework-graph:test"
        }
      ],
      "sessions": [
        {
          "id": "a",
          "area": "same-target",
          "group": "g-same",
          "delayMilliseconds": 0,
          "steps": [
