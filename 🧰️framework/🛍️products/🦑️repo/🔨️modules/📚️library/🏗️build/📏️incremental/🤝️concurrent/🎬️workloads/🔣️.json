  "classes": [
    {
      "id": "graph-facts",
      "label": {
        "en": "Graph facts",
        "de": "Graph-Fakten"
      },
      "scope": "workspace",
      "patterns": [
        "^repository-graph-facts:"
      ]
    },
    {
      "id": "dependency-image",
      "label": {
        "en": "Dependency image",
        "de": "Abhängigkeits-Image"
      },
      "scope": "workspace",
      "patterns": [
        "^native-fixed-image:"
      ]
    },
    {
      "id": "bazel-server",
      "label": {
        "en": "Bazel server",
        "de": "Bazel-Server"
      },
      "scope": "workspace",
      "patterns": [
        "^bazel:server$",
        "^bazel-server"
      ]
    },
    {
      "id": "cargo-units",
      "label": {
        "en": "Cargo units",
        "de": "Cargo-Einheiten"
      },
      "scope": "workspace",
      "patterns": [
        "^cargo:",
        "^cargo-unit"
      ]
    },
    {
      "id": "capacity-admission",
      "label": {
        "en": "Capacity admission",
        "de": "Kapazitätszulassung"
      },
      "scope": "host",
      "patterns": [
        "^semio\\.host\\.capacity/",
        "^compiler:capacity"
      ]
    },
    {
      "id": "toolchain-acquisition",
      "label": {
        "en": "Toolchain acquisition",
        "de": "Werkzeugbeschaffung"
      },
      "scope": "host",
      "patterns": [
        "^/.*/(?:bun|bazel|cargo|node)(?:\\.exe)?$",
        "^[A-Za-z]:[\\\\/].*(?:bun|bazel|cargo|node)(?:\\.exe)?$"
      ]
    },
    {
      "id": "other",
      "label": {
        "en": "Other lock",
        "de": "Andere Sperre"
      },
      "scope": "workspace",
      "patterns": [
        "^"
      ]
    }
  ],
  "criteria": [
    {
      "id": "default",
      "title": {
        "en": "Isolation, sharing and correctness",
        "de": "Isolation, gemeinsame Nutzung und Korrektheit"
      },
      "rules": [
        {
          "id": "all-steps-succeed",
          "kind": "no-failure",
          "title": {
            "en": "Every step exits successfully",
            "de": "Jeder Schritt endet erfolgreich"
          },
          "owners": [
            "conc-graph",
            "conc-bazel",
            "conc-cargo",
            "conc-deps",
            "conc-leases"
          ]
        },
        {
          "id": "outputs-equal-serial",
          "kind": "serial-equal",
          "compare": [
            "exit",
            "outputs",
            "stdout"
          ],
          "title": {
            "en": "Every session's results equal a serial run",
            "de": "Die Ergebnisse jeder Sitzung entsprechen einem seriellen Lauf"
          },
          "owners": [
            "conc-graph",
            "conc-bazel",
            "conc-cargo",
            "conc-deps",
            "conc-leases"
          ]
        },
        {
          "id": "graph-facts-unrelated-wait",
          "kind": "max-wait",
          "title": {
            "en": "No wait above 5 s on the graph facts for an unrelated project",
            "de": "Keine Wartezeit über 5 s auf die Graph-Fakten für ein fremdes Projekt"
          },
          "owners": [
            "conc-graph"
          ],
          "classes": [
            "graph-facts"
          ],
          "relation": "unrelated",
          "maximumMilliseconds": 5000
