{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build/format-stamps/v1",
  "title": "Declared format stamps",
  "description": "Schema-first table of every format stamp a producer of a shared artifact carries (graph generation, project records, inferrers, dependency generation receipt, cache image format). A process declares the stamps of the implementation it loaded; when it is admitted to the exclusive resource of a producer and again before it publishes, it compares them with the stamps declared NOW in the schemas on disk (a stat-cached read of a few small files, never a closure hash). A moved stamp means the process holds an obsolete implementation: it yields the resource without producing and the outermost command re-executes itself once with the current implementation. Readers of an artifact written under a newer stamp refuse with the same message instead of overwriting it.",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 64
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema",
        "pointer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pointer": {
          "type": "string",
          "pattern": "^(/[^/]+)+$",
          "maxLength": 200
        },
        "member": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "stamps"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stamps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    },
    "Protocol": {
      "const": {
        "version": 1,
        "exitCode": 75,
        "maximumReexecutions": 1,
        "reexecutionEnvironment": "SEMIO_STALE_REEXEC",
        "admissionGuardRegistry": "semio.resourceLeaseAdmissionGuards.v1",
        "maximumSchemaBytes": 1048576,
        "readAttempts": 5,
        "readRetryMilliseconds": 20,
        "settleMilliseconds": 2000,
        "maximumReportedStamps": 6,
        "languages": [
          "en",
          "de"
        ],
        "stamps": [
          {
            "id": "graph.generation",
            "schema": "🏗️build/🕸️graph/🕰️generations/🧬️schema/🔣️.json",
            "pointer": "/definitions/Identity/const"
          },
          {
            "id": "graph.record",
            "schema": "🏗️build/👁️observation/🧬️schema/🔣️.json",
            "pointer": "/$defs/record/const/stamp"
          },
          {
            "id": "graph.inferrers",
            "schema": "🏗️build/🕸️graph/📥️inference/🔖️stamps/🧬️schema/🔣️.json",
            "pointer": "/definitions/Protocol/const/inferrers",
            "member": "stamp"
          },
          {
            "id": "dependency.walk",
            "schema": "⚡️caching/🚀️bootstrap/📦️dependencies/🧾️generation/🧬️schema/🔣️.json",
            "pointer": "/$defs/Protocol/const/walkStamp"
          },
          {
            "id": "cache.graph-image",
            "schema": "⚡️caching/💾️storage/🔒️enforcement/📦️budget/📥️opening/🏪️store/📇️format/🧬️schema/🔣️.json",
            "pointer": "/$defs/Protocol/const/format"
          },
          {
            "id": "native.publication",
            "schema": "../../../../🔨️modules/🏃️process/📦️artifacts/🏗️native-build/💾️storage/🧬️schema/🔣️.json",
            "pointer": "/definitions/ImageProtocol/const/publicationFormat"
          }
        ],
        "resources": [
          {
            "prefix": "repository-graph-facts:",
            "stamps": [
              "graph.generation",
              "graph.record",
              "graph.inferrers"
            ]
          },
          {
            "prefix": "build-graph-state:",
            "stamps": [
              "graph.generation",
              "graph.record",
              "graph.inferrers"
            ]
          },
          {
            "prefix": "javascript-dependency-build:",
            "stamps": [
              "dependency.walk"
            ]
          },
          {
            "prefix": "javascript-dependency-bindings:",
            "stamps": [
              "dependency.walk"
            ]
          },
          {
            "prefix": "javascript-dependency-generation-writer:",
            "stamps": [
              "dependency.walk"
            ]
          },
          {
            "prefix": "native-fixed-image:",
            "stamps": [
              "cache.graph-image",
              "native.publication"
            ]
          }
        ],
        "texts": {
          "en": {
            "moved": "This command runs an outdated implementation: the declared format stamp {id} moved from {own} to {live}.",
            "yield": "It yields {resource} without producing anything.",
            "refuse": "It neither reads nor overwrites {resource}.",
            "more": "... and {count} more stamps moved.",
            "restart": "Restarting with the current implementation ({attempt} of {maximum}).",
            "final": "The stamps moved again after the restart: run the command again.",
            "unreadable": "The declared stamp table cannot be read ({path}): {reason}.",
            "missing": "The declared stamp {id} is missing at {pointer} of {path}.",
            "unknown": "No stamp {id} is declared in the stamp table."
          },
          "de": {
            "moved": "Dieser Befehl führt eine veraltete Implementierung aus: der deklarierte Formatstempel {id} wechselte von {own} zu {live}.",
            "yield": "Er gibt {resource} frei, ohne etwas zu erzeugen.",
            "refuse": "Er liest und überschreibt {resource} nicht.",
            "more": "... und {count} weitere Stempel wechselten.",
            "restart": "Neustart mit der aktuellen Implementierung ({attempt} von {maximum}).",
            "final": "Die Stempel wechselten nach dem Neustart erneut: den Befehl noch einmal ausführen.",
            "unreadable": "Die deklarierte Stempeltabelle kann nicht gelesen werden ({path}): {reason}.",
            "missing": "Der deklarierte Stempel {id} fehlt bei {pointer} in {path}.",
            "unknown": "In der Stempeltabelle ist kein Stempel {id} deklariert."
          }
        }
      }
    }
  }
}
