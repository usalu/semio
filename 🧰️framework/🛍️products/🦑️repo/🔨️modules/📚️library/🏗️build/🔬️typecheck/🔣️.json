      "id": "next",
      "declaration": "node_modules/next/types/global.d.ts",
      "projects": ["server-next"]
    }
  ],
  "fallback": {
    "id": "workspace",
    "tsconfig": "tsconfig.json"
  },
  "scanRoots": [
    "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library",
    "🧰️framework/🔨️modules/🏃️process"
  ],
  "skipDirectories": ["node_modules", "target", "🎯️target", "🗑️generated", "🤖️generated", "📤️dist", "dist", ".nx", "⚡️cache", "📁️some"],
  "checkExtensions": [".ts", ".tsx", ".mts"],
  "declarationExtensions": [".d.mts"],
  "scriptExtensions": [".mjs"],
  "compiler": {
    "script": "node_modules/typescript/lib/tsc.js",
    "typeRoots": "node_modules/@types",
    "heap": {"maximumMegabytes": 12000, "minimumMegabytes": 4096, "hostShare": 0.6}
  },
  "cache": {
    "directory": "typecheck",
    "variable": "SEMIO_TYPECHECK_CACHE"
  },
  "report": {
    "file": "library-report.json",
    "project": "library",
    "maximumAgeSeconds": 86400,
    "maximumAreas": 60,
    "testSegments": ["/🧪️tests/"],
    "areaRoots": [
      {"prefix": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build", "label": "build"},
      {"prefix": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching", "label": "caching"},
      {"prefix": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library", "label": "library"},
      {"prefix": "🧰️framework/🔨️modules/🏃️process", "label": "process"}
    ]
  },
  "budgetMs": 600000,
  "limits": {
    "maximumFiles": 256,
    "maximumImporters": 400,
    "maximumDiagnostics": 200,
    "errorCharacters": 400
  }
}
