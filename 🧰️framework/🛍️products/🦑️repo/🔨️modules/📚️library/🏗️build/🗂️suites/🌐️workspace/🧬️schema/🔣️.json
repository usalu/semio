{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/build/workspace-test-selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(🏗️build|⚡️caching)/(?!(?:.*\\/)?\\.\\.?\\/)[^\\\\]+\\.ts$"
      }
    }
  }
}
