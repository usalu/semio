          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "projects": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "Policy": {
      "const": {
        "maximumDescendants": 64
      }
    }
  }
}
