{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "graph",
    "watch",
    "tasks",
    "bail"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "graph": {
      "type": "object"
    },
    "watch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "args",
          "path",
          "selected",
          "global"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          },
          "global": {
            "type": "boolean"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "args",
          "git",
          "tasks",
          "forwarded"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "git": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forwarded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "bail": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "args",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
