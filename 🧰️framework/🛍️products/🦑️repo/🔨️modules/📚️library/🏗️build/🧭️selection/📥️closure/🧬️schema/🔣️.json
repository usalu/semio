{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasks",
    "mode",
    "excludeDependencies",
    "maximumTasks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256
      }
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "excludeDependencies": {
      "type": "boolean"
    },
    "maximumTasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    }
  },
  "definitions": {
    "SelectorCases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patterns",
          "expected"
        ],
        "properties": {
          "patterns": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1
          },
          "expected": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
