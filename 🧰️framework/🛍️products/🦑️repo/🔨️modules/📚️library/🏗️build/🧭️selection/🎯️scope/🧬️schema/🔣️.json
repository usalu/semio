{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Target Scope and Scoped Plan",
  "description": "A demand-driven planning request (TargetScopeV1) and its result (ScopedPlanV1): only the transitive closure of the requested targets and, on request, the closure of the tools that run them is ever read.",
  "definitions": {
    "Name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "TargetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "target"],
      "properties": { "project": { "$ref": "#/definitions/Name" }, "target": { "$ref": "#/definitions/Name" } }
    },
    "TargetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "targets", "includeToolClosure"],
      "properties": {
        "version": { "const": 1 },
        "targets": { "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/definitions/TargetRef" } },
        "includeToolClosure": { "type": "boolean" }
      }
    },
    "ScopedPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scope", "projects", "tasks", "edges", "projectsRead"],
      "properties": {
        "version": { "const": 1 },
        "scope": { "$ref": "#/definitions/TargetScope" },
        "projects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/Name" } },
        "tasks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/TargetRef" } },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": { "from": { "$ref": "#/definitions/TargetRef" }, "to": { "$ref": "#/definitions/TargetRef" } }
          }
        },
        "projectsRead": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$ref": "#/definitions/TargetScope"
}
