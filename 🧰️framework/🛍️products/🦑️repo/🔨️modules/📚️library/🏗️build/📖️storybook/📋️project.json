        "env": {
          "STORYBOOK_PORT": "6010"
        },
        "cwd": "."
      },
      "cache": false,
      "outputs": [
        "{workspaceRoot}/.🧾️store/build-storybook.json"
      ],
      "inputs": [
        "{workspaceRoot}/.storybook/**/*",
        {
          "env": "STORYBOOK_SCOPE"
        },
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/**/*",
        "{workspaceRoot}/**/*.stories.{ts,tsx}",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/**/*"
      ],
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      },
      "metadata": {
        "semio": {
          "orchestrator": true,
          "execution": {
            "version": 1,
            "kind": "orchestration"
          },
          "cache": {
            "version": 1,
            "class": "aggregate",
            "reason": "orders-prerequisites"
          }
        }
