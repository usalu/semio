      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/📖️stories/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧪️tests/**/*",
