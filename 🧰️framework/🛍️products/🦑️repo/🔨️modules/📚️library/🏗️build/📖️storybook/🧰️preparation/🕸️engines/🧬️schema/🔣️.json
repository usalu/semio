{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scopes",
    "catalog",
    "expected"
  ],
  "properties": {
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "wasmPackages"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "wasmPackages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "maximumPackages": 32,
        "helpFlags": [
          "-h",
          "--help"
        ],
        "workspaceProject": "workspace",
        "enginePhaseAdditionalMilliseconds": 0
      }
    }
  }
}
