{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "scope"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "scope": {
      "type": "string",
      "maxLength": 512
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "root": "storybook",
        "maximumOutputBytes": 1073741824,
        "maximumOutputFiles": 65536,
        "writerShards": 16
      }
    }
  }
}
