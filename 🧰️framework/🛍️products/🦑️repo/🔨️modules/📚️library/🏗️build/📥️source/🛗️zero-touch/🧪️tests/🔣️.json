      },
      "findings": [
        "cli|external-package|a.ts|ajv/dist/2020.js"
      ],
      "closureFiles": {
        "cli": 1
      }
    },
    {
      "name": "a workspace specifier must be relative and names the owner file",
      "roster": {
        "version": 1,
        "closures": [
          {
            "id": "cli",
            "entry": "a.ts",
            "mode": "full",
            "reason": "fixture"
          }
        ],
        "seams": []
      },
      "files": {
        "a.ts": "import { x } from \"@scope/lib\";\nimport { y } from \"@scope/lib/sub\";\nimport { z } from \"@scope/lib/feature/alpha\";\nimport { w } from \"@scope/lib/missing\";\nexport const all = [x, y, z, w];\n"
      },
      "findings": [
        "cli|workspace-specifier|a.ts|@scope/lib",
        "cli|workspace-specifier|a.ts|@scope/lib/feature/alpha",
        "cli|workspace-specifier|a.ts|@scope/lib/missing",
        "cli|workspace-specifier|a.ts|@scope/lib/sub"
      ],
      "details": {
        "cli|workspace-specifier|a.ts|@scope/lib": "Import the owner module by the relative path to pkg/lib/index.ts.",
        "cli|workspace-specifier|a.ts|@scope/lib/sub": "Import the owner module by the relative path to pkg/lib/sub/bun.ts.",
        "cli|workspace-specifier|a.ts|@scope/lib/feature/alpha": "Import the owner module by the relative path to pkg/lib/features/alpha/mod.ts.",
        "cli|workspace-specifier|a.ts|@scope/lib/missing": "Import the owner module by a relative path; no export of the package resolves this specifier."
      },
      "closureFiles": {
        "cli": 1
      }
    },
    {
      "name": "type-only imports carry no runtime",
