    {
      "name": "a seam is cut when loaded dynamically and refused when imported statically",
      "roster": {
        "version": 1,
        "closures": [
          {
            "id": "cli",
            "entry": "a.ts",
            "mode": "full",
            "reason": "fixture"
          },
