{
  "version": 1,
  "packages": {
    "@scope/lib": {
      "directory": "pkg/lib",
      "exports": {
        ".": "./index.ts",
        "./sub": {
          "bun": "./sub/bun.ts",
          "default": "./sub/default.ts"
        },
        "./feature/*": "./features/*/mod.ts",
        "./package.json": "./package.json"
      }
    }
  },
  "cases": [
    {
      "name": "a relative closure with builtins is clean",
      "roster": {
        "version": 1,
        "closures": [
          {
            "id": "cli",
            "entry": "a.ts",
            "mode": "full",
            "reason": "fixture"
          }
        ],
        "seams": []
      },
      "files": {
        "a.ts": "import { readFileSync } from \"node:fs\";\nimport { b } from \"./sub/b.ts\";\nimport os from \"os\";\nimport \"bun:test\";\nexport const a = b;\n",
        "sub/b.ts": "import data from \"../data.json\" with { type: \"json\" };\nexport const b = data;\n",
        "data.json": "{\"leaf\":true}"
      },
      "findings": [],
      "closureFiles": {
        "cli": 2
      }
    },
    {
      "name": "an external package is refused with the capture message",
      "roster": {
        "version": 1,
        "closures": [
          {
            "id": "cli",
            "entry": "a.ts",
            "mode": "full",
            "reason": "fixture"
          }
        ],
        "seams": []
      },
      "files": {
        "a.ts": "import ts from \"typescript\";\nexport { ts };\n"
      },
      "findings": [
        "cli|external-package|a.ts|typescript"
      ],
      "details": {
        "cli|external-package|a.ts|typescript": "External implementation runtime dependency refused: typescript"
      },
      "closureFiles": {
        "cli": 1
      }
    },
    {
      "name": "a scoped external subpath is refused",
