  "scans": [
    {
      "name": "static, dynamic and require kinds",
      "path": "a.ts",
      "text": "import a from \"s1\";\nexport { b } from \"s2\";\nexport * from \"s3\";\nimport \"s4\";\nconst d = await import(\"s5\");\nconst r = require(\"s6\");\n",
      "imports": [
        [
          "s1",
          "static"
        ],
        [
          "s2",
          "static"
        ],
        [
          "s3",
          "static"
        ],
        [
          "s4",
          "static"
        ],
        [
          "s5",
          "dynamic"
        ],
        [
          "s6",
          "require"
        ]
      ]
    },
    {
      "name": "type-only forms are dropped",
      "path": "a.ts",
      "text": "import type { A } from \"t1\";\nimport { type B } from \"t2\";\nexport type { C } from \"t3\";\nimport { type D, e } from \"kept\";\n",
      "imports": [
        [
          "kept",
          "static"
        ]
      ]
    },
    {
      "name": "a javascript module",
      "path": "a.mjs",
      "text": "import { createRequire } from \"node:module\";\nconst require = createRequire(import.meta.url);\nconst c = require(\"typescript\");\n",
      "imports": [
        [
          "node:module",
          "static"
        ],
        [
          "typescript",
          "require"
        ]
      ]
    },
    {
      "name": "a shebang and an emoji specifier",
      "path": "📜️script.ts",
      "text": "#!/usr/bin/env bun\nimport { x } from \"./🧭️routing/🟦️.ts\";\n",
      "imports": [
        [
          "./🧭️routing/🟦️.ts",
          "static"
        ]
      ]
    }
  ],
  "commandCases": [
    {
      "name": "a none command with a relative closure and builtins is clean",
      "commands": [
        {
          "id": "a",
          "module": "a.ts",
          "requires": "none"
        }
      ],
      "seams": [],
      "files": {
        "a.ts": "import { readFileSync } from \"node:fs\";\nimport { b } from \"./b.ts\";\nexport const a = [b, readFileSync];\n",
        "b.ts": "export const b = 1;\n"
      },
      "closureFiles": {
        "command:a": 2
      },
      "findings": []
    },
    {
      "name": "a none command refuses an external package and says what to declare",
      "commands": [
        {
          "id": "a",
          "module": "a.ts",
          "requires": "none"
        }
      ],
      "seams": [],
      "files": {
        "a.ts": "import { z } from \"zod\";\nexport { z };\n"
      },
      "closureFiles": {
        "command:a": 1
      },
      "findings": [
        "command:a|external-package|a.ts|zod"
      ],
      "details": {
        "command:a|external-package|a.ts|zod": "The command declares requires none but reaches the external package zod; declare requires dependencies or remove the import."
      }
    },
    {
      "name": "a dependencies command may reach external packages",
      "commands": [
        {
          "id": "a",
          "module": "a.ts",
          "requires": "dependencies"
