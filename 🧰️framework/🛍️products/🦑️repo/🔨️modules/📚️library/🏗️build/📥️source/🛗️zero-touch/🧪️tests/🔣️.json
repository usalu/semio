      "files": {
        "a.ts": "import { b } from \"./b.ts\";\nexport const load = () => import(\"./c.ts\");\nexport const r = require(\"./d.cjs\");\nexport { b };\n",
        "b.ts": "export const b = 1;\n",
        "c.ts": "import \"chalk\";\n",
        "d.cjs": "require(\"lodash\");\n"
