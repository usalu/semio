            "entry": "z.ts",
            "mode": "full",
            "reason": "fixture"
          }
        ],
        "seams": [
          {
            "module": "seam.ts",
            "reason": "fixture"
          }
        ]
      },
      "files": {
        "a.ts": "export const load = () => import(\"./seam.ts\");\n",
        "z.ts": "import { s } from \"./seam.ts\";\nexport { s };\n",
        "seam.ts": "import \"typescript\";\nexport const s = 1;\n"
