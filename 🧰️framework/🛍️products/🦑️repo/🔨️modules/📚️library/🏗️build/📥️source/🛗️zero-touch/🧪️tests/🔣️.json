    },
    {
      "name": "findings are found transitively through static, dynamic and require edges",
      "roster": {
        "version": 1,
        "closures": [
          {
            "id": "cli",
            "entry": "a.ts",
            "mode": "full",
            "reason": "fixture"
          }
        ],
        "seams": []
      },
      "files": {
        "a.ts": "import { b } from \"./b.ts\";\nexport const load = () => import(\"./c.ts\");\nexport const r = require(\"./d.cjs\");\nexport { b };\n",
        "b.ts": "import \"left-pad\";\n",
        "c.ts": "export * from \"./e.mjs\";\n",
        "e.mjs": "import \"chalk\";\n",
        "d.cjs": "module.exports = require(\"lodash\");\n"
      },
      "findings": [
        "cli|external-package|b.ts|left-pad",
        "cli|external-package|d.cjs|lodash",
        "cli|external-package|e.mjs|chalk"
      ],
      "closureFiles": {
        "cli": 5
      }
    },
    {
      "name": "static mode follows static imports only",
