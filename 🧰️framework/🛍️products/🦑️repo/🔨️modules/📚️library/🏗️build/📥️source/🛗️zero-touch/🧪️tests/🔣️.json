      "seams": [],
      "files": {
        "a.ts": "import { z } from \"zod\";\nimport Ajv from \"ajv/dist/2020.js\";\nexport { z, Ajv };\n"
      },
      "closureFiles": {
        "command:a": 1
      },
      "findings": []
    },
    {
      "name": "every command refuses a workspace specifier",
      "commands": [
        {
          "id": "a",
          "module": "a.ts",
          "requires": "none"
        },
        {
          "id": "b",
          "module": "b.ts",
          "requires": "dependencies"
        }
      ],
      "seams": [],
      "files": {
        "a.ts": "import { lib } from \"@scope/lib\";\nexport { lib };\n",
        "b.ts": "import { sub } from \"@scope/lib/sub\";\nexport { sub };\n"
      },
      "closureFiles": {
        "command:a": 1,
        "command:b": 1
      },
      "findings": [
        "command:a|workspace-specifier|a.ts|@scope/lib",
        "command:b|workspace-specifier|b.ts|@scope/lib/sub"
      ],
      "details": {
        "command:a|workspace-specifier|a.ts|@scope/lib": "Import the owner module by the relative path to pkg/lib/index.ts.",
        "command:b|workspace-specifier|b.ts|@scope/lib/sub": "Import the owner module by the relative path to pkg/lib/sub/bun.ts."
      }
    },
    {
      "name": "a none command loads a seam dynamically and never statically",
      "commands": [
        {
          "id": "a",
          "module": "a.ts",
          "requires": "none"
        },
        {
          "id": "c",
          "module": "c.ts",
          "requires": "none"
        }
      ],
      "seams": [
        "s.ts"
      ],
      "files": {
        "a.ts": "export const load = () => import(\"./s.ts\");\n",
        "c.ts": "import { s } from \"./s.ts\";\nexport { s };\n",
        "s.ts": "import { z } from \"zod\";\nexport const s = z;\n"
      },
      "closureFiles": {
        "command:a": 1,
        "command:c": 1
      },
      "findings": [
        "command:c|seam-static|c.ts|./s.ts"
      ]
    },
    {
      "name": "a dependencies command follows the seam like any other module",
      "commands": [
        {
          "id": "d",
          "module": "d.ts",
          "requires": "dependencies"
        }
      ],
      "seams": [
        "s.ts"
      ],
      "files": {
        "d.ts": "import { s } from \"./s.ts\";\nexport { s };\n",
        "s.ts": "import { lib } from \"@scope/lib\";\nimport { z } from \"zod\";\nexport const s = [lib, z];\n"
      },
      "closureFiles": {
        "command:d": 2
      },
      "findings": [
        "command:d|workspace-specifier|s.ts|@scope/lib"
      ]
    },
    {
      "name": "a missing command module is a finding",
