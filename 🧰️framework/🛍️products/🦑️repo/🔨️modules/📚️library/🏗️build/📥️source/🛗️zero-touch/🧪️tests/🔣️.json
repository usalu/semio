    {
      "name": "dynamic and require edges are followed",
      "commands": [
        {
          "id": "a",
          "module": "a.ts",
          "requires": "none"
        }
      ],
      "seams": [],
      "files": {
        "a.ts": "export const load = () => import(\"./b.ts\");\n",
        "b.ts": "const c = require(\"./c.ts\");\nexport { c };\n",
        "c.ts": "import { z } from \"zod\";\nexport { z };\n"
      },
      "closureFiles": {
