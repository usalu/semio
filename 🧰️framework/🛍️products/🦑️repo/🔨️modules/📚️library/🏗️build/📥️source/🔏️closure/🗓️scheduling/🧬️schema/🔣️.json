{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:scheduling-domains:v1",
  "title": "Build Scheduling Domains",
  "description": "The code that only schedules, admits, stores or reports an action and never computes the bytes of its outputs, as workspace-relative directory prefixes grouped in named domains. A captured implementation scope that opts into a domain keeps those files out of its action key: they travel in an unkeyed overlay beside the keyed snapshot. Everything that no domain names stays keyed (fail closed). The ports of a domain are the only modules of it that keyed code may import.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "domains"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contract",
          "prefixes",
          "ports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 40
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "de": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          "prefixes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[^/].*/$",
              "minLength": 2,
              "maxLength": 200
            }
          },
          "ports": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
