{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root",
    "entry",
    "files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "base64",
          "imports"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "base64": {
            "type": "string",
            "maxLength": 5592408
          },
          "imports": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumFiles": 512,
        "maximumFileBytes": 4194304,
        "maximumSourceBytes": 16777216,
        "maximumSnapshotBytes": 25165824,
        "readChunkBytes": 65536,
        "progressFiles": 16
      }
    }
  }
}
