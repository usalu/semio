{
  "version": 1,
  "checkoutFromTests": "../../../../../../../../../..",
  "forgedPolicies": [
    "duplicate-domain-id",
    "nested-prefix",
    "duplicate-prefix",
    "parent-segment",
    "port-outside-domain",
    "port-is-directory",
    "extra-key",
    "no-domains",
    "bad-id",
    "native-keyed-outside-domain",
    "island-inside-prefix",
    "prefix-inside-island",
    "island-duplicate",
    "island-parent-segment",
    "keyed-missing"
  ],
  "loaderCases": [
    {
      "case": "merged",
      "outcome": "runs",
      "message": ""
    },
    {
      "case": "edited-overlay",
      "outcome": "runs",
      "message": ""
    },
    {
      "case": "missing-overlay",
      "outcome": "refused",
      "message": "Closed captured resolution target required"
    },
    {
      "case": "outside-declared-domains",
      "outcome": "refused",
      "message": "outside the declared domains"
    },
    {
      "case": "shadows-keyed",
      "outcome": "refused",
      "message": "Immutable implementation image changed"
    },
    {
      "case": "other-root",
      "outcome": "refused",
      "message": "Closed scheduling overlay required"
    },
    {
      "case": "writable-hardlink",
      "outcome": "refused",
      "message": "Bounded scheduling overlay required"
    }
  ],
  "nativeFallback": {
    "stays": [
      "🧰️framework/🔨️modules/🏃️process/📦️artifacts/🏗️native-build/",
      "🧰️framework/🔨️modules/🏃️process/📦️packages/🟦️typescript/📦️artifacts/🏗️native-build/"
    ],
    "leaves": [
      "🧰️framework/🔨️modules/🏃️process/🔒️leases/",
      "🧰️framework/🔨️modules/🏃️process/🏗️build/🎟️capacity/",
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/💾️storage/",
      "🧰️framework/🔨️modules/🏃️process/🪪️agent-sessions/",
      "🧰️framework/🔨️modules/🏃️process/🏗️build/🗣️language/"
    ],
    "cargoScript": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/📜️script.ts"
  }
}
