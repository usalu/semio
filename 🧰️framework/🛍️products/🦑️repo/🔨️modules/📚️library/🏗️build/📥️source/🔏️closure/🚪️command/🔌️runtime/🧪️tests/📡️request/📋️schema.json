{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "modes",
    "files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "modes": {
      "const": [
        "control",
        "publish",
        "fixed",
        "native",
        "inventory"
      ]
    },
    "files": {
      "const": [
        {
          "name": "project-graph.json",
          "value": {
            "nodes": {},
            "externalNodes": {},
            "dependencies": {}
          }
        },
        {
          "name": "source-maps.json",
          "value": {}
        }
      ]
    }
  }
}
