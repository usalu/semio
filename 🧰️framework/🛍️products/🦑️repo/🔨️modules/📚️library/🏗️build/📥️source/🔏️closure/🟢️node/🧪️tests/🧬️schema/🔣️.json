{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maximumWindowsCommandUnits",
    "cases",
    "arguments",
    "mapContract",
    "bootstrapContract"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maximumWindowsCommandUnits": {
      "const": 32767
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mutation",
          "accepted",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mutation": {
            "enum": [
              "none",
              "code",
              "schema",
              "data",
              "digest",
              "module",
              "import",
              "path",
              "buffer",
              "uncaptured",
              "descriptor",
              "maps",
              "maps-code",
              "maps-schema"
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "expected": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "executable",
          "accepted"
