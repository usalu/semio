        "resolutionKeys": [
          "imports",
          "path",
          "sha256"
        ],
        "imports": {
          "./value.ts": "value.ts",
          "./schema.json": "schema.json"
        }
      }
    },
    "bootstrapContract": {
      "const": {
        "version": 1,
        "builtins": [
          "node:crypto",
          "node:fs",
          "node:fs/promises",
          "node:module",
          "node:path",
          "node:url"
