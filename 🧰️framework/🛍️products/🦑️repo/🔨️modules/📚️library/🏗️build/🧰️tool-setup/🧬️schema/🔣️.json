{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pinned Tool Setup",
  "description": "🧰️ Declares every pinned tool of the repository once: where its pin is written (a pointer into the pin file that already owns it), how to ask it for its version, where a provisioned copy lives and which provisioner installs it. `repo tools setup` installs from this table, `repo tools verify` compares it with the machine; both read the pins and never copy them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "groups",
    "tools",
    "steps",
    "messages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Id"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Tool"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Step"
      }
    },
    "messages": {
      "$ref": "#/definitions/Messages"
    }
  },
  "definitions": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Pin": {
      "description": "Where the version of a tool is written: a JSON pointer, the field of the rows of a JSON array, a capture group over a text file or the value itself.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "file",
            "pointer"
          ],
          "properties": {
            "format": {
              "const": "json"
            },
            "file": {
              "$ref": "#/definitions/RelativePath"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:/[^/]+)+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "file",
            "pointer",
            "where",
            "field"
          ],
          "properties": {
            "format": {
              "const": "rows"
            },
            "file": {
              "$ref": "#/definitions/RelativePath"
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:/[^/]+)+$"
            },
            "where": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "file",
            "pattern"
          ],
          "properties": {
            "format": {
              "const": "regex"
            },
            "file": {
              "$ref": "#/definitions/RelativePath"
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "flags": {
              "enum": [
                "m"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "value"
          ],
          "properties": {
            "format": {
              "const": "value"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "Probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "arguments",
        "pattern"
      ],
      "properties": {
        "mode": {
          "enum": [
            "version",
            "listed",
            "hook"
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "Locate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "family",
            "executable"
          ],
          "properties": {
            "kind": {
              "const": "provisioned"
            },
            "family": {
              "enum": [
                "native",
                "bun",
                "bazel",
                "binaryen",
                "dotnet",
                "cargo"
              ]
            },
            "tool": {
              "$ref": "#/definitions/Id"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "names",
            "directories"
          ],
          "properties": {
            "kind": {
              "const": "path"
            },
            "names": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "directories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "interpreter"
          ],
          "properties": {
            "kind": {
              "const": "python"
            },
            "interpreter": {
              "$ref": "#/definitions/Id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "hook"
            }
          }
        }
      ]
    },
    "Setup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool"
          ],
          "properties": {
            "kind": {
              "const": "native"
            },
            "tool": {
              "enum": [
                "go",
                "uv",
                "cmake",
                "ninja"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "interpreter"
          ],
          "properties": {
            "kind": {
              "const": "python"
            },
            "interpreter": {
              "$ref": "#/definitions/Id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "bun",
                "bazel",
                "binaryen",
                "dotnet",
                "rust",
                "bootstrap"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "script",
            "prepare"
          ],
          "properties": {
            "kind": {
              "const": "script"
            },
            "script": {
              "$ref": "#/definitions/RelativePath"
            },
            "prepare": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verify": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "Tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "pin",
        "probe",
        "locate",
        "setup"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "summary": {
          "$ref": "#/definitions/Text"
        },
        "pin": {
          "$ref": "#/definitions/Pin"
        },
        "probe": {
          "$ref": "#/definitions/Probe"
        },
        "locate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Locate"
          }
        },
        "setup": {
          "$ref": "#/definitions/Setup"
        }
      }
    },
    "Messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "texts"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "en",
              "de"
            ]
          }
        },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "header",
            "ok",
            "missing",
            "differs",
            "failed",
            "deferred",
            "clean",
            "drift",
            "step",
            "done",
            "skipped",
            "manual",
            "mismatch",
            "usage",
            "unknown",
            "pinfile",
            "postponed",
            "installer",
            "runtime",
            "running",
            "cancelled",
            "progress",
            "warm",
            "warmed",
            "warmFailed"
          ],
          "properties": {
            "header": {
              "$ref": "#/definitions/Text"
            },
            "ok": {
              "$ref": "#/definitions/Text"
            },
            "missing": {
              "$ref": "#/definitions/Text"
            },
            "differs": {
              "$ref": "#/definitions/Text"
            },
            "failed": {
              "$ref": "#/definitions/Text"
            },
            "deferred": {
              "$ref": "#/definitions/Text"
            },
            "postponed": {
              "$ref": "#/definitions/Text"
            },
            "clean": {
              "$ref": "#/definitions/Text"
            },
            "drift": {
              "$ref": "#/definitions/Text"
            },
            "step": {
              "$ref": "#/definitions/Text"
            },
            "done": {
              "$ref": "#/definitions/Text"
            },
            "skipped": {
              "$ref": "#/definitions/Text"
            },
            "manual": {
              "$ref": "#/definitions/Text"
            },
            "mismatch": {
              "$ref": "#/definitions/Text"
            },
            "usage": {
              "$ref": "#/definitions/Text"
            },
            "unknown": {
              "$ref": "#/definitions/Text"
            },
            "pinfile": {
              "$ref": "#/definitions/Text"
            },
            "installer": {
              "$ref": "#/definitions/Text"
            },
            "runtime": {
              "$ref": "#/definitions/Text"
            },
            "running": {
              "$ref": "#/definitions/Text"
            },
            "cancelled": {
              "$ref": "#/definitions/Text"
            },
            "progress": {
              "$ref": "#/definitions/Text"
            },
            "warm": {
              "$ref": "#/definitions/Text"
            },
            "warmed": {
              "$ref": "#/definitions/Text"
            },
            "warmFailed": {
              "$ref": "#/definitions/Text"
            }
          }
        }
      }
    },
    "Step": {
      "description": "A preparation that is not a pinned tool: it has no version to compare, runs only when the whole table is set up and, when optional, never fails the setup.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "summary",
        "platforms",
        "configuration",
        "timeoutSeconds",
        "optional"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "kind": {
          "enum": [
            "cargo-helpers"
          ]
        },
        "summary": {
          "$ref": "#/definitions/Text"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "darwin",
              "linux",
              "win32"
            ]
          }
        },
        "configuration": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        },
        "optional": {
          "type": "boolean"
        }
      }
    }
  }
}
