  "messages": {
    "languages": [
      "en",
      "de"
    ],
    "texts": {
      "header": {
        "en": "tool           pin                   found                 status    location",
        "de": "Werkzeug        Pin                   gefunden              Status    Ort"
      },
      "ok": {
        "en": "ok",
        "de": "ok"
      },
      "missing": {
        "en": "missing",
        "de": "fehlt"
      },
      "differs": {
        "en": "differs",
        "de": "weicht ab"
      },
      "failed": {
        "en": "failed",
        "de": "fehlgeschlagen"
      },
      "deferred": {
        "en": "deferred",
        "de": "zurückgestellt"
      },
      "clean": {
        "en": "All {count} pinned tools match their pins.",
        "de": "Alle {count} gepinnten Werkzeuge entsprechen ihren Pins."
      },
      "drift": {
        "en": "{count} of {total} pinned tools differ from their pins; run `repo tools setup all`.",
        "de": "{count} von {total} gepinnten Werkzeugen weichen von ihren Pins ab; führe `repo tools setup all` aus."
      },
      "step": {
        "en": "Provisioning {tool} {pin}.",
        "de": "Richte {tool} {pin} ein."
      },
      "done": {
        "en": "{tool} {found} is ready.",
        "de": "{tool} {found} ist bereit."
      },
      "skipped": {
        "en": "{tool} {found} already matches its pin.",
        "de": "{tool} {found} entspricht bereits dem Pin."
      },
      "manual": {
        "en": "{tool} {pin} is installed by the bootstrap script, not by this command; run the bootstrap again.",
        "de": "{tool} {pin} wird vom Bootstrap-Skript installiert, nicht von diesem Befehl; führe das Bootstrap erneut aus."
      },
      "mismatch": {
        "en": "{tool} was provisioned but reports {found}, not the pin {pin}.",
        "de": "{tool} wurde eingerichtet, meldet aber {found} statt des Pins {pin}."
      },
      "usage": {
        "en": "{command} takes {choices}.",
        "de": "{command} erwartet {choices}."
      },
      "unknown": {
        "en": "Unknown pinned tool: {tool}.",
        "de": "Unbekanntes gepinntes Werkzeug: {tool}."
      },
      "pinfile": {
        "en": "The pin of {tool} cannot be read from {file}.",
