{
  "$schema": "./🧬️schema/🔣️.json",
  "version": 1,
  "groups": {
    "all": [
      "bun",
      "node",
      "rustup",
      "rust",
      "node-native-core",
      "go",
      "uv",
      "python-main",
      "python-oracle",
      "dotnet",
      "cmake",
      "ninja",
      "wasm-opt",
      "tectonic",
      "wasm-pack",
      "wasm-bindgen",
      "trunk",
      "cargo-nextest",
      "cargo-llvm-cov",
      "chromium",
      "bazel"
    ]
  },
  "tools": [
    {
      "id": "bun",
      "summary": {
        "en": "JavaScript runtime and package manager that runs every repository script.",
        "de": "JavaScript-Laufzeit und Paketmanager, der jedes Repository-Skript ausführt."
      },
      "pin": {
        "format": "regex",
        "file": "package.json",
        "pattern": "\"packageManager\"\\s*:\\s*\"bun@(\\d+\\.\\d+\\.\\d+)\""
      },
      "probe": {
        "mode": "version",
        "arguments": [
          "--version"
        ],
        "pattern": "^(\\d+\\.\\d+\\.\\d+)"
      },
      "locate": [
        {
          "kind": "provisioned",
          "family": "bun",
          "executable": "bun"
        }
      ],
      "setup": {
        "kind": "bun"
      }
    },
    {
      "id": "node",
      "summary": {
        "en": "Node.js for the tools that do not run on Bun.",
        "de": "Node.js für die Werkzeuge, die nicht auf Bun laufen."
      },
      "pin": {
        "format": "rows",
        "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🔩️native/🥾️bootstrap/🧬️schema/🔣️.json",
        "pointer": "/definitions/Pins/const/assets",
        "where": {
          "tool": "node"
        },
        "field": "version"
      },
      "probe": {
        "mode": "version",
        "arguments": [
          "--version"
        ],
        "pattern": "^v(\\d+\\.\\d+\\.\\d+)"
      },
      "locate": [
        {
          "kind": "path",
          "names": [
            "node"
          ],
          "directories": [
            "~/.local/node/bin"
          ]
        }
      ],
      "setup": {
        "kind": "bootstrap"
      }
    },
    {
      "id": "rustup",
      "summary": {
        "en": "Rust toolchain manager.",
        "de": "Verwaltung der Rust-Toolchains."
      },
      "pin": {
        "format": "rows",
        "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🔩️native/🥾️bootstrap/🧬️schema/🔣️.json",
        "pointer": "/definitions/Pins/const/assets",
        "where": {
          "tool": "rustup"
        },
        "field": "version"
      },
      "probe": {
        "mode": "version",
        "arguments": [
          "--version"
        ],
        "pattern": "^rustup (\\d+\\.\\d+\\.\\d+)"
      },
      "locate": [
        {
          "kind": "path",
          "names": [
            "rustup"
          ],
          "directories": [
            "~/.cargo/bin"
          ]
        }
      ],
      "setup": {
        "kind": "bootstrap"
      }
    },
    {
      "id": "rust",
      "summary": {
        "en": "Rust nightly with the WebAssembly targets of rust-toolchain.toml.",
        "de": "Rust-Nightly mit den WebAssembly-Zielen aus rust-toolchain.toml."
      },
      "pin": {
        "format": "regex",
        "file": "rust-toolchain.toml",
        "pattern": "^channel\\s*=\\s*\"([^\"]+)\"",
        "flags": "m"
      },
      "probe": {
        "mode": "version",
        "arguments": [
          "show",
          "active-toolchain"
        ],
        "pattern": "^(nightly-\\d{4}-\\d{2}-\\d{2})"
      },
      "locate": [
        {
          "kind": "path",
          "names": [
            "rustup"
          ],
          "directories": [
            "~/.cargo/bin"
          ]
        }
      ],
      "setup": {
        "kind": "rust"
      }
    },
    {
      "id": "node-native-core",
      "summary": {
        "en": "Native core that gives Node the system calls the repository tools bind (built once from the pinned Rust toolchain).",
        "de": "Nativer Kern, der Node die Systemaufrufe gibt, die die Repository-Werkzeuge binden (einmal mit der gepinnten Rust-Toolchain gebaut)."
      },
      "pin": {
        "format": "regex",
        "file": "🧰️framework/🔨️modules/⚙️runtime/🟢️node/🧲️native/🧬️schema/🔣️.json",
        "pattern": "\"Protocol\"[\\s\\S]*?\"version\":\\s*(\\d+)"
      },
      "probe": {
        "mode": "hook",
        "arguments": [],
        "pattern": ""
      },
      "locate": [
        {
          "kind": "hook"
        }
      ],
      "setup": {
        "kind": "script",
        "script": "🧰️framework/🔨️modules/⚙️runtime/🟢️node/🧲️native/🏗️addon/🛠️prepare/📜️script.ts",
        "prepare": [
          "prepare"
        ],
        "verify": [
          "verify"
        ]
      }
    },
    {
      "id": "go",
      "summary": {
        "en": "Go for the repository's Go packages.",
        "de": "Go für die Go-Pakete des Repositorys."
      },
      "pin": {
