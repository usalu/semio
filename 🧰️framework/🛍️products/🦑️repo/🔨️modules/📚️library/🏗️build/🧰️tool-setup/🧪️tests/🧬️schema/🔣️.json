{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pin resolution fixture",
  "description": "🧫️ A miniature tree of pin files, the pins every implementation must read from it and the verdicts of the version matching; shared by the TypeScript engine and the independent Python implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "files",
    "packages",
    "expected",
    "matches"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "found",
          "pin",
          "expected"
        ],
        "properties": {
          "found": {
            "type": "string",
            "minLength": 1
          },
          "pin": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
