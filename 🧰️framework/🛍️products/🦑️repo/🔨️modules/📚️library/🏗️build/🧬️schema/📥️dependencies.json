{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Direct JavaScript Dependency Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "selection"
  ],
  "properties": {
    "mode": {
      "enum": [
        "sync",
        "lock",
        "ensure"
      ]
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "all"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner"
          ],
          "properties": {
            "kind": {
              "const": "scope"
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owners"
          ],
          "properties": {
            "kind": {
              "const": "scopes"
            },
            "owners": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000]+$"
              }
            }
          }
        }
      ]
    }
  }
}
