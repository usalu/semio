{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Build Native Caller",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceRoot",
    "arguments",
    "buildMode",
    "native",
    "selection",
    "tool",
    "launches"
  ],
  "properties": {
    "buildMode": {
      "type": "string",
      "pattern": "^(prototype|release)$"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 65536
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactDirectory",
        "transport",
        "child",
        "network"
      ],
      "properties": {
        "artifactDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumBytes",
            "maximumLines"
          ],
          "properties": {
            "maximumBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumLines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "child": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumElapsedMilliseconds"
          ],
          "properties": {
            "maximumElapsedMilliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offline"
          ],
          "properties": {
            "offline": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 65536
    },
    "launches": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "maxItems": 65536
      },
      "minItems": 1,
      "maxItems": 65536
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "worktree",
        "keyDigest",
        "operations",
        "maximumRequests",
        "maximumConcurrent"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "worktree": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "keyDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "run",
              "run-many",
              "affected"
            ]
          }
        },
        "maximumRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximumConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    }
  }
}
