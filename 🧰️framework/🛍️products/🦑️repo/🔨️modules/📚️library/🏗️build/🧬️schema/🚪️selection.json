{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Closed Build Graph Selection V1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "all"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "tasks"
      ],
      "properties": {
        "kind": {
          "const": "tasks"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "project",
              "target"
            ],
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "configuration": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "projects",
        "exclude"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "owners"
        },
        "projects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!(?:tag:|!))[^*?\\[\\]{}()\\\\]+$"
          }
        },
        "exclude": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!(?:tag:|!))[^*?\\[\\]{}()\\\\]+$"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^*?\\[\\]{}()\\\\:]+$"
          }
        }
      }
    }
  ]
}
