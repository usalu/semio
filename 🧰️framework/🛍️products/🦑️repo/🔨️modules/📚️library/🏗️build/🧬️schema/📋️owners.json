{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Build Owner Registry V1",
  "type": "object",
  "required": [
    "version",
    "owners",
    "catalogProviders"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "owners": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "required": [
          "name",
          "root",
          "manifest",
          "packages"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "$ref": "#/$defs/Path"
          },
          "manifest": {
            "$ref": "#/$defs/Path"
          },
          "packages": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nativeRoots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/Path"
            }
          }
        }
      }
    },
    "catalogProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ownerRoot",
          "sourcePath",
          "consumerRoots"
        ],
        "additionalProperties": false,
        "properties": {
          "ownerRoot": {
            "$ref": "#/$defs/Path"
          },
          "sourcePath": {
            "$ref": "#/$defs/Path"
          },
          "consumerRoots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/Path"
            }
          }
        }
      },
      "description": "Providers are admitted by an actual selected task below a consumer root, an explicit provider Source input, or intentional all-owner selection. Source-only consumer ownership does not activate a provider."
    }
  },
  "$defs": {
    "Path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    }
  }
}
