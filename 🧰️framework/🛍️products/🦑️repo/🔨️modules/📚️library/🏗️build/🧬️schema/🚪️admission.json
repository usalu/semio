{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closed Build Owner Admission V1",
  "$defs": {
    "sourceInputObservation": {
      "const": {
        "selectedTask": "compile",
        "declaredEntry": "compile",
        "namedInputOnly": "freshness"
      }
    },
    "relativeImportOwnership": {
      "const": {
        "workspaceRoot": ".",
        "workspaceAncestorRole": "source",
        "nestedOwnerRole": "project"
      }
    },
    "generatedImportResolution": {
      "const": {
        "files": [
          ".ts",
          ".tsx",
          ".js",
          ".jsx"
        ],
        "probes": [
          "",
          ".ts",
          ".tsx",
          ".d.ts",
          ".js",
          ".jsx",
          ".json",
          ".node",
          ".mts",
          ".cts",
          ".mjs",
          ".cjs",
          "/package.json",
          "/index.ts",
          "/index.tsx",
          "/index.d.ts",
          "/index.js",
          "/index.jsx",
          "/index.json",
          "/index.node",
          "/index.mts",
          "/index.cts",
          "/index.mjs",
          "/index.cjs"
        ]
      }
    },
    "generatedTaskDependencies": {
      "type": "object",
      "maxProperties": 65536,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u0020:]+$"
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 65536,
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u0020:]+:[^\\u0000-\\u0020:]+$"
        }
      }
    },
    "ownerInputs": {
      "type": "object",
      "maxProperties": 65536,
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ownerFacts": {
      "type": "object",
      "required": [
        "project",
        "files",
        "dependencies"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "object",
          "required": [
            "name",
            "targets"
          ],
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "targets": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedDependencies": {
          "$ref": "#/$defs/generatedTaskDependencies"
        },
        "dependencyInputs": {
          "$ref": "#/$defs/ownerInputs"
        }
      }
    },
    "candidateInvalidation": {
      "type": "object",
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "invalidated"
        },
        "reason": {
          "enum": [
            "owner-registry",
            "source-authority"
          ]
        }
      }
    },
    "sourceInputRole": {
      "type": "string",
      "enum": [
        "compile",
        "freshness"
      ]
    },
    "sourceDemandRole": {
      "type": "string",
      "enum": [
        "runtime",
        "compile"
      ]
    },
    "sourceDemand": {
      "const": {
        "command": "runtime",
        "compileInput": "compile",
        "declaredEntry": "compile",
        "priority": {
          "runtime": 0,
          "compile": 1
        }
      }
    },
    "moduleSourceFacts": {
      "type": "object",
      "required": [
        "imports",
        "runtimeImports",
        "productionImports"
      ],
      "additionalProperties": false,
      "properties": {
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runtimeImports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "productionImports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "sourceContractScope": {
      "const": {
        "reservedGroups": [
          "default",
          "production",
          "nativeSources",
          "nativeTestSources",
          "artifactSources",
          "artifactCommandSources"
        ],
        "maximumDepth": 128,
        "maximumReferences": 65536,
        "defaultInputs": [
          "default"
        ]
      }
    }
  },
  "type": "object",
  "required": [
    "owners",
    "files",
    "targets",
    "catalogProviders",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "generatedDependencies": {
      "type": "object",
      "maxProperties": 65536,
      "additionalProperties": {
        "$ref": "#/$defs/generatedTaskDependencies"
      }
    },
    "owners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 65536
    },
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1048576
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "maxProperties": 65536
    },
    "catalogProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "ownerRoot",
          "sourcePath"
        ],
        "additionalProperties": false,
        "properties": {
          "ownerRoot": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/ownerInputs"
    }
  }
}
