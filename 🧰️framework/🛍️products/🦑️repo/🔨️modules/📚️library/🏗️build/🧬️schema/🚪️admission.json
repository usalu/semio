{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closed Build Owner Admission V1",
  "$defs": {
    "sourceInputObservation": {
      "const": {
        "selectedTask": "compile",
        "declaredEntry": "compile",
        "namedInputOnly": "freshness"
      }
    },
    "relativeImportOwnership": {
      "const": {
        "workspaceRoot": ".",
        "workspaceAncestorRole": "source",
        "nestedOwnerRole": "project"
      }
    },
    "generatedImportResolution": {
      "const": {
        "files": [
          ".ts",
          ".tsx",
          ".js",
          ".jsx"
        ],
        "probes": [
          "",
          ".ts",
          ".tsx",
          ".d.ts",
          ".js",
          ".jsx",
          ".json",
          ".node",
          ".mts",
          ".cts",
          ".mjs",
          ".cjs",
          "/package.json",
          "/index.ts",
          "/index.tsx",
          "/index.d.ts",
          "/index.js",
          "/index.jsx",
          "/index.json",
          "/index.node",
          "/index.mts",
          "/index.cts",
          "/index.mjs",
          "/index.cjs"
        ]
      }
    },
    "generatedTaskDependencies": {
      "type": "object",
      "maxProperties": 65536,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u0020:]+$"
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 65536,
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u0020:]+:[^\\u0000-\\u0020:]+$"
        }
      }
    },
    "ownerInputs": {
      "type": "object",
      "maxProperties": 65536,
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ownerFacts": {
      "type": "object",
      "required": [
        "project",
        "files",
        "dependencies"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "object",
          "required": [
            "name",
            "targets"
          ],
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "targets": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedDependencies": {
          "$ref": "#/$defs/generatedTaskDependencies"
        },
        "dependencyInputs": {
          "$ref": "#/$defs/ownerInputs"
        }
      }
    },
    "candidateInvalidation": {
      "type": "object",
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "invalidated"
        },
        "reason": {
          "enum": [
            "owner-registry",
            "source-authority"
          ]
        }
      }
    },
    "sourceInputRole": {
      "type": "string",
      "enum": [
        "compile",
        "freshness"
      ]
    },
    "sourceDemandRole": {
      "type": "string",
      "enum": [
        "runtime",
        "compile"
      ]
    },
    "sourceDemand": {
      "const": {
        "command": "runtime",
        "compileInput": "compile",
        "declaredEntry": "compile",
        "priority": {
          "runtime": 0,
          "compile": 1
        },
        "scope": "target"
      }
    },
    "moduleSourceFacts": {
      "type": "object",
      "required": [
        "imports",
        "runtimeImports",
        "productionImports"
      ],
      "additionalProperties": false,
      "properties": {
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runtimeImports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "productionImports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "sourceContractScope": {
      "const": {
        "reservedGroups": [
          "default",
          "production",
          "nativeSources",
          "nativeTestSources",
          "artifactSources",
          "artifactCommandSources"
        ],
        "maximumDepth": 128,
        "maximumReferences": 65536,
        "defaultInputs": [
          "default"
        ]
      }
    },
    "taskSourceDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "source",
        "role"
      ],
      "properties": {
        "target": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/sourceDemandRole"
        }
      }
    },
    "nativeSourceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedSource",
        "selectedNative",
        "requestedInputs",
        "dependencyInputs",
        "inputRole"
      ],
      "properties": {
        "selectedSource": {
          "type": "boolean"
        },
        "selectedNative": {
          "type": "boolean"
        },
        "requestedInputs": {
          "type": "boolean"
        },
        "dependencyInputs": {
          "type": "boolean"
        },
        "inputRole": {
          "$ref": "#/$defs/sourceInputRole"
        }
      }
    },
    "nativeSourceDemand": {
      "enum": [
        "none",
        "source",
        "compile"
      ]
    },
    "nativeAssemblyCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "selected",
        "targets",
        "inputs",
        "rootDiscovery",
        "preparation",
        "release",
        "commandExpansion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "selected": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "source",
              "test",
              "release",
              "generator"
            ]
          }
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rootDiscovery": {
          "enum": [
            0,
            1
          ]
        },
        "preparation": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "release": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commandExpansion": {
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "sourceObservationRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "suite",
        "execution",
        "observation",
        "typechecks",
        "entry"
      ],
      "properties": {
        "target": {
          "const": "test-native-image-observation"
        },
        "suite": {
          "const": "native-image-observation"
        },
        "execution": {
          "const": "source"
        },
        "observation": {
          "const": "freshness"
        },
        "typechecks": {
          "const": false
        },
        "entry": {
          "const": "{projectRoot}/📦️artifacts/🏗️native-build/💾️storage/🍎️image/🤫️silence/🧪️tests/🟦️.ts"
        }
      }
    },
    "nativeDiscoveryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targets",
        "inputNames",
        "caret",
        "observation",
        "nativeCalls",
        "preparation",
        "dependencies",
        "inputGroups"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caret": {
          "type": "boolean"
        },
        "observation": {
          "$ref": "#/$defs/sourceInputRole"
        },
        "nativeCalls": {
          "type": "integer",
          "minimum": 0
        },
        "preparation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputGroups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "packageDependency": {
          "type": "boolean"
        },
        "matchedData": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtimeImport": {
          "type": "boolean"
        },
        "rejectSelfGenerated": {
          "type": "boolean"
        },
        "upgradeNative": {
          "type": "boolean"
        }
      }
    }
  },
  "type": "object",
  "required": [
    "owners",
    "files",
    "targets",
    "catalogProviders",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "generatedDependencies": {
      "type": "object",
      "maxProperties": 65536,
      "additionalProperties": {
        "$ref": "#/$defs/generatedTaskDependencies"
      }
    },
    "owners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 65536
    },
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1048576
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "maxProperties": 65536
    },
    "catalogProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "ownerRoot",
          "sourcePath"
        ],
        "additionalProperties": false,
        "properties": {
          "ownerRoot": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/ownerInputs"
    }
  }
}
