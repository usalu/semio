{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Build Graph V1",
  "type": "object",
  "required": [
    "version",
    "projects",
    "dependencies"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "root",
          "targets"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "execution"
              ],
              "properties": {
                "execution": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "command",
                        "noop"
                      ]
                    },
                    "command": {
                      "type": "string"
                    },
                    "commands": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "required": [
                              "command"
                            ],
                            "properties": {
                              "command": {
                                "type": "string"
                              },
                              "forwardAllArgs": {
                                "type": "boolean"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "cwd": {
                      "type": "string"
                    },
                    "env": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "parallel": {
                      "type": "boolean"
                    },
                    "forwardAllArgs": {
                      "type": "boolean"
                    },
                    "args": {
                      "$ref": "#/$defs/LiteralArguments"
                    }
                  },
                  "additionalProperties": true,
                  "allOf": [
                    {
                      "anyOf": [
                        {
                          "properties": {
                            "command": false
                          },
                          "type": "object"
                        },
                        {
                          "properties": {
                            "commands": false
                          },
                          "type": "object"
                        }
                      ]
                    }
                  ]
                },
                "configurations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "execution"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "execution": {
                        "$ref": "#/$defs/ExecutionConfiguration"
                      }
                    }
                  }
                },
                "dependsOn": {
                  "type": "array"
                },
                "inputs": {
                  "type": "array"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cache": {
                  "type": "boolean"
                },
                "continuous": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true,
              "allOf": [
                {
                  "anyOf": [
                    {
                      "properties": {
                        "execution": {
                          "properties": {
                            "command": false
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "configurations": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "object",
                            "properties": {
                              "execution": {
                                "type": "object",
                                "properties": {
                                  "commands": false
                                }
                              }
                            }
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "properties": {
                        "execution": {
                          "properties": {
                            "commands": false
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "configurations": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "object",
                            "properties": {
                              "execution": {
                                "type": "object",
                                "properties": {
                                  "command": false
                                }
                              }
                            }
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "sourceFile": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "namedInputs": {
      "type": "object"
    },
    "externalNodes": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "LiteralArguments": {
      "type": "array",
      "items": {"type": "string"}
    },
    "ExecutionConfiguration": {
      "type": "object",
      "properties": {
        "kind": false,
        "ownerArguments": false,
        "nativeOwnerCommand": false,
        "executor": false,
        "inputs": false,
        "outputs": false,
        "dependsOn": false,
        "cache": false,
        "continuous": false,
        "parallelism": false,
        "metadata": false,
        "defaultConfiguration": false,
        "configurations": false,
        "options": false,
        "command": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "forwardAllArgs": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parallel": {
          "type": "boolean"
        },
        "forwardAllArgs": {
          "type": "boolean"
        },
        "args": {
          "$ref": "#/$defs/LiteralArguments"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "command": false
              },
              "type": "object"
            },
            {
              "properties": {
                "commands": false
              },
              "type": "object"
            }
          ]
        }
      ]
    },
    "ScriptBuildRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "go",
        "wasm"
      ],
      "properties": {
        "go": {
          "type": "boolean"
        },
        "wasm": {
          "type": "boolean"
        }
      }
    }
  }
}
