{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository Build Graph V1",
  "type": "object",
  "required": [
    "version",
    "projects",
    "dependencies"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "root",
          "targets"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "execution"
              ],
              "properties": {
                "execution": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "command",
                        "noop"
                      ]
                    },
                    "command": {
                      "type": "string"
                    },
                    "commands": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "required": [
                              "command"
                            ],
                            "properties": {
                              "command": {
                                "type": "string"
                              },
                              "forwardAllArgs": {
                                "type": "boolean"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "cwd": {
                      "type": "string"
                    },
                    "env": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "parallel": {
                      "type": "boolean"
                    },
                    "forwardAllArgs": {
                      "type": "boolean"
                    },
                    "args": {
                      "$ref": "#/$defs/LiteralArguments"
                    },
                    "program": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true,
                  "allOf": [
                    {
                      "anyOf": [
                        {
                          "properties": {
                            "command": false
                          },
                          "type": "object"
                        },
                        {
                          "properties": {
                            "commands": false
                          },
                          "type": "object"
                        }
                      ]
                    },
                    {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "program": false
                          }
                        },
                        {
                          "type": "object",
                          "properties": {
                            "command": false
                          }
                        }
                      ]
                    },
                    {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "program": false
                          }
                        },
                        {
                          "type": "object",
                          "properties": {
                            "commands": false
                          }
                        }
                      ]
                    }
                  ]
                },
                "configurations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "execution"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "execution": {
                        "$ref": "#/$defs/ExecutionConfiguration"
                      }
                    }
                  }
                },
                "dependsOn": {
                  "type": "array"
                },
                "inputs": {
                  "type": "array"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cache": {
                  "type": "boolean"
                },
                "continuous": {
                  "type": "boolean"
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "semio": {
                      "type": "object",
                      "properties": {
                        "dashboard": {
                          "type": "object",
                          "properties": {
                            "ready": {
                              "$ref": "#/$defs/ReadyDeclaration"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "additionalProperties": true,
              "allOf": [
                {
                  "anyOf": [
                    {
                      "properties": {
                        "execution": {
                          "properties": {
                            "command": false
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "configurations": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "object",
                            "properties": {
                              "execution": {
                                "type": "object",
                                "properties": {
                                  "commands": false
                                }
                              }
                            }
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "properties": {
                        "execution": {
                          "properties": {
                            "commands": false
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "configurations": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "object",
                            "properties": {
                              "execution": {
                                "type": "object",
                                "properties": {
                                  "command": false
                                }
                              }
                            }
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "sourceFile": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "namedInputs": {
      "type": "object"
    },
    "externalNodes": {
      "type": "object"
    },
    "unavailable": {
      "description": "Projects whose own declaration, or a source their inference consumed, does not parse in the published snapshot; they contribute no targets until that source parses, while every other project stays available.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/UnavailableProject"
      }
    },
    "admission": {
      "type": "object",
      "required": [
        "selection",
        "registry",
        "closure"
      ],
      "additionalProperties": false,
      "properties": {
        "selection": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "all"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "tasks"
              ],
              "properties": {
                "kind": {
                  "const": "tasks"
                },
                "tasks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 65536,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "required": [
                      "project",
                      "target"
                    ],
                    "properties": {
                      "project": {
                        "type": "string",
                        "minLength": 1
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      },
                      "configuration": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "projects",
                "exclude"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "owners"
                },
                "projects": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1024,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?!(?:tag:|!))[^*?\\[\\]{}()\\\\]+$"
                  }
                },
                "exclude": {
                  "type": "array",
                  "maxItems": 1024,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?!(?:tag:|!))[^*?\\[\\]{}()\\\\]+$"
                  }
                },
                "targets": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[^*?\\[\\]{}()\\\\:]+$"
                  }
                }
              }
            }
          ]
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "closure": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "externalInputs": {
          "type": "array",
          "maxItems": 65536,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "UnavailableProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "source",
        "sha256",
        "reason"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "description": "Workspace-relative path of the source that does not parse.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "description": "Digest of the unparseable bytes the snapshot observed.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "missing": {
          "description": "Present exactly when the project is withheld because it depends on projects the snapshot does not hold (a project created or removed while the graph was built): their names in code point order. `source` is then the file that declares the withheld project and `sha256` the digest of its bytes (the digest of no bytes when the file vanished); the next run picks the dependency up.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "LiteralArguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ExecutionConfiguration": {
      "type": "object",
      "properties": {
        "kind": false,
        "ownerArguments": false,
        "nativeOwnerCommand": false,
        "executor": false,
        "inputs": false,
        "outputs": false,
        "dependsOn": false,
        "cache": false,
        "continuous": false,
        "parallelism": false,
        "metadata": false,
        "defaultConfiguration": false,
        "configurations": false,
        "options": false,
        "command": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "forwardAllArgs": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parallel": {
          "type": "boolean"
        },
        "forwardAllArgs": {
          "type": "boolean"
        },
        "args": {
          "$ref": "#/$defs/LiteralArguments"
        },
        "program": false
      },
      "additionalProperties": true,
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "command": false
              },
              "type": "object"
            },
            {
              "properties": {
                "commands": false
              },
              "type": "object"
            }
          ]
        }
      ]
    },
    "ScriptBuildRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "go",
        "wasm"
      ],
      "properties": {
        "go": {
          "type": "boolean"
        },
        "wasm": {
          "type": "boolean"
        }
      }
    },
    "BuildTool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "BuildPolicy": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "BuildPolicyAuthority": {
      "const": {
        "path": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🔣️policy.json",
        "maximumBytes": 65536,
        "windows": {
          "shareMode": 1,
          "openFlags": 2097152,
          "reparseAttribute": 1024
        },
        "launchers": [
          "📜️script.ts",
          "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/📜️script.ts"
        ]
      }
    },
    "ReadyDeclaration": {
      "type": "object",
      "description": "🟢️ A continuous task is ready after its visible output shows `http://(127.0.0.1|localhost|0.0.0.0):<port>` and the exact ready address answers HTTP with a 2xx or 3xx status. The ready address is the printed match plus `path`, or with `printed` the whole printed address up to whitespace. `portEnv` names the environment value that carries the port of one run; `port` is its default and may stand alone.",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "portEnv": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[/?#][^\\s\\u0000]*$"
        },
        "printed": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "properties": {
            "port": true
          },
          "required": [
            "port"
          ]
        },
        {
          "properties": {
            "portEnv": true
          },
          "required": [
            "portEnv"
          ]
        }
      ],
      "allOf": [
        {
          "$ref": "#/$defs/ReadyPrinted"
        }
      ],
      "additionalProperties": false
    },
    "ReadyPrinted": {
      "type": "object",
      "description": "🖨️ A printed address leaves no room for `path`.",
      "anyOf": [
        {
          "properties": {
            "printed": {
              "enum": [
                false
              ]
            }
          }
        },
        {
          "properties": {
            "path": false
          }
        }
      ]
    },
    "Ready": {
      "type": "object",
      "description": "🎯 The resolved readiness of one run: a concrete port and the path that follows the printed match.",
      "required": [
        "port",
        "path"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string"
        },
        "printed": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "ReadinessPolicy": {
      "const": {
        "version": 1,
        "firstProbeMilliseconds": 50,
        "lastProbeMilliseconds": 1000,
        "probeBudgetMilliseconds": 500,
        "connectMilliseconds": 100,
        "maximumHeaderBytes": 8192,
        "maximumLineCharacters": 4096,
        "keptLineCharacters": 64,
        "maximumAddressCharacters": 2048,
        "marker": "[semio] ready"
      }
    }
  }
}
