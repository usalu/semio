{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private Build Engine Source References",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind",
      "specifier"
    ],
    "properties": {
      "kind": {
        "enum": [
          "module",
          "file-url",
          "directory-url"
        ]
      },
      "specifier": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "definitions": {
    "NamedInput": {
      "const": "__semioPrivateEngine"
    },
    "NativeNamedInput": {
      "const": "__semioPrivateEngineNative"
    }
  }
}
