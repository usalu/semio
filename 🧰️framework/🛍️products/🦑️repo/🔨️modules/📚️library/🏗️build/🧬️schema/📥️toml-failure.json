{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Observed TOML Parse Failure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "path",
    "namespace",
    "sha256",
    "bytes",
    "line",
    "column",
    "position",
    "sourceLine"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "column": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "position": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sourceLine": {
      "type": "string",
      "maxLength": 512
    }
  }
}
