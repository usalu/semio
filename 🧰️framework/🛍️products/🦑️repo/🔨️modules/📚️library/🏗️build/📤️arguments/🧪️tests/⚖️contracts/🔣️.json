{
 "version": 1,
 "contracts": [
  {
   "name": "a string constant",
   "contract": {
    "const": "a"
   },
   "values": [
    {
     "value": "a",
     "accepted": true
    },
    {
     "value": "b",
     "accepted": false
    },
    {
     "value": 1,
     "accepted": false
    },
    {
     "value": null,
     "accepted": false
    },
    {
     "value": [
      "a"
     ],
     "accepted": false
    }
   ]
  },
  {
   "name": "a numeric constant",
   "contract": {
    "const": 1
   },
   "values": [
    {
     "value": 1,
     "accepted": true
    },
    {
     "value": "1",
     "accepted": false
    },
    {
     "value": true,
     "accepted": false
    },
    {
     "value": 2,
     "accepted": false
    }
   ]
  },
  {
   "name": "a null constant",
   "contract": {
    "const": null
   },
   "values": [
    {
     "value": null,
     "accepted": true
    },
    {
     "value": 0,
     "accepted": false
    },
    {
     "value": "",
     "accepted": false
    },
    {
     "value": false,
     "accepted": false
    }
   ]
  },
  {
   "name": "an object constant matches by content",
   "contract": {
    "const": {
     "a": 1,
     "b": [
      1,
      2
     ]
    }
   },
   "values": [
    {
     "value": {
      "a": 1,
      "b": [
       1,
       2
      ]
     },
     "accepted": true
    },
    {
     "value": {
      "b": [
       1,
       2
      ],
      "a": 1
     },
     "accepted": true
    },
    {
     "value": {
      "a": 1
     },
     "accepted": false
    },
    {
     "value": {
      "a": 1,
      "b": [
       2,
       1
      ]
     },
     "accepted": false
    }
   ]
  },
  {
   "name": "the null type",
   "contract": {
    "type": "null"
   },
   "values": [
    {
     "value": null,
     "accepted": true
    },
    {
     "value": 0,
     "accepted": false
    },
    {
     "value": "null",
     "accepted": false
    },
    {
     "value": {},
     "accepted": false
    }
   ]
  },
  {
   "name": "a string enum",
   "contract": {
    "enum": [
     "a",
     "b"
    ]
   },
   "values": [
    {
     "value": "a",
     "accepted": true
    },
    {
     "value": "c",
     "accepted": false
    },
    {
     "value": null,
     "accepted": false
    },
    {
     "value": [
      "a"
     ],
     "accepted": false
    }
   ]
  },
  {
   "name": "an enum with a null and a number",
   "contract": {
    "enum": [
     1,
     null
    ]
   },
   "values": [
    {
     "value": null,
     "accepted": true
    },
    {
     "value": 1,
     "accepted": true
    },
    {
     "value": "1",
     "accepted": false
    },
    {
     "value": true,
     "accepted": false
    }
   ]
  },
  {
   "name": "an enum of objects matches by content",
   "contract": {
    "enum": [
     {
      "a": 1
     },
     [
      1,
      2
     ]
    ]
   },
   "values": [
    {
     "value": {
      "a": 1
     },
     "accepted": true
    },
    {
     "value": [
      1,
      2
     ],
     "accepted": true
    },
    {
     "value": [
      2,
      1
     ],
     "accepted": false
    },
    {
     "value": {
      "a": 2
     },
     "accepted": false
    }
   ]
  },
  {
   "name": "an enum decides before the type",
   "contract": {
    "type": "string",
    "enum": [
     "a"
    ]
   },
   "values": [
    {
     "value": "a",
     "accepted": true
    },
    {
     "value": 1,
     "accepted": false
    },
    {
     "value": "b",
     "accepted": false
    }
   ]
  },
  {
   "name": "a constant decides before an enum",
