{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/rustc-offload/v1",
  "title": "Rustc offload",
  "description": "A machine hands rustc units of the fleet's unit cache to any ready machine of the fleet (distribute), or to one named machine (pin): the policy (thresholds, timeouts, virtual paths, platform properties), the manifest of one offloaded action, the events and the bilingual texts.",
  "definitions": {
    "Mode": {
      "type": "string",
      "enum": [
        "never",
        "distribute",
        "pin"
      ]
    },
    "Reason": {
      "type": "string",
      "enum": [
        "not-portable",
        "no-endpoint",
        "no-credential",
        "unmapped-path",
        "inputs-too-large",
        "unreadable-input",
        "no-idle-machine",
        "queue-timeout",
        "infrastructure",
        "toolchain-missing",
        "path-dependent-output",
        "worker-policy",
        "incomplete-inputs",
        "crate-type",
        "source-kind",
        "cheap",
        "pin-failed",
        "cancelled"
      ]
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "limits",
        "timeouts",
        "deadline",
        "virtual",
        "property",
        "tool",
        "root",
        "environment",
        "crateTypes",
        "wasm",
        "link"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment",
            "default",
            "pinPrefix"
          ],
          "properties": {
            "environment": {
              "type": "string"
            },
            "default": {
              "$ref": "#/definitions/Mode"
            },
            "pinPrefix": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queueThresholdMilliseconds",
            "fanOutJobs",
            "roundTripMilliseconds",
            "maximumInputFiles",
            "maximumInputBytes",
            "maximumUploadBytes",
            "fleetStatusMilliseconds",
            "maximumOutputBytes",
            "maximumClosureFiles",
            "maximumArgumentBytes",
            "maximumCheckConfigurationBytes",
            "tokenWaitMilliseconds",
            "admissionMemoMilliseconds",
            "unitMegabytes",
            "declineMemoMilliseconds",
            "reachableMemoMilliseconds",
            "contentRetries",
            "contentRetryAfterCapMilliseconds"
          ],
          "properties": {
            "roundTripMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "fanOutJobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "queueThresholdMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "maximumInputFiles": {
              "type": "integer",
              "minimum": 1
            },
            "maximumInputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumUploadBytes": {
              "type": "integer",
              "minimum": 1
            },
            "fleetStatusMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "maximumOutputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumClosureFiles": {
              "type": "integer",
              "minimum": 1
            },
            "maximumArgumentBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumCheckConfigurationBytes": {
              "type": "integer",
              "minimum": 1
            },
            "tokenWaitMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "admissionMemoMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "unitMegabytes": {
              "type": "integer",
              "minimum": 1
            },
            "declineMemoMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "reachableMemoMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "contentRetries": {
              "type": "integer",
              "minimum": 0
            },
            "contentRetryAfterCapMilliseconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectMilliseconds",
            "uploadMilliseconds",
            "queueMilliseconds",
            "executeMarginMilliseconds",
            "downloadMilliseconds",
            "actionSeconds",
            "probeMilliseconds",
            "requestMilliseconds",
            "rideThroughMilliseconds",
            "queueSaturatedMilliseconds",
            "pinQueueMilliseconds"
          ],
          "properties": {
            "connectMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "uploadMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "queueMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "executeMarginMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "downloadMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "actionSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "probeMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "requestMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "rideThroughMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "queueSaturatedMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "pinQueueMilliseconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "deadline": {
          "description": "How long an offloaded action may take on the fleet before the unit compiles here instead: factor times the recorded local cost of the unit (floor and cap bound it, a unit without a record takes the unknown value; a linked wasm unit or a command has its own cap and unknown value) from the moment it executes, and how long the stream of an operation may stay silent before the client re-attaches to it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factor",
            "floorMilliseconds",
            "capMilliseconds",
            "unknownMilliseconds",
            "linkedCapMilliseconds",
            "linkedUnknownMilliseconds",
            "silenceMilliseconds",
            "reattachMilliseconds"
          ],
          "properties": {
            "factor": {
              "type": "integer",
              "minimum": 1
            },
            "floorMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "capMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "unknownMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "linkedCapMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "linkedUnknownMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "silenceMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "reattachMilliseconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "virtual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "out",
            "deps",
            "package",
            "generated",
            "external",
            "native",
            "root"
          ],
          "properties": {
            "base": {
              "type": "string"
            },
            "out": {
              "type": "string"
            },
            "deps": {
              "type": "string"
            },
            "package": {
              "type": "string"
            },
            "generated": {
              "type": "string"
            },
            "external": {
              "type": "string"
            },
            "native": {
              "type": "string"
            },
            "root": {
              "type": "string"
            }
          }
        },
        "property": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offload",
            "offloadValue",
            "origin",
            "toolchain",
            "target",
            "targetPrefix",
            "format",
            "formatValue",
            "peak",
            "queueValue",
            "pin",
            "sdk"
          ],
          "properties": {
            "offload": {
              "type": "string"
            },
            "offloadValue": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "toolchain": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "targetPrefix": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "formatValue": {
              "type": "string"
            },
            "peak": {
              "type": "string"
            },
            "queueValue": {
              "type": "string"
            },
            "pin": {
              "type": "string"
            },
            "sdk": {
              "type": "string"
            }
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "windowsExecutable",
            "placeholder"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "windowsExecutable": {
              "const": "rustc.exe"
            },
            "placeholder": {
              "type": "string"
            }
          }
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placeholder",
            "report",
            "home",
            "directories"
          ],
          "properties": {
            "placeholder": {
              "type": "string"
            },
            "report": {
              "type": "string"
            },
            "home": {
              "type": "string"
            },
            "directories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deniedNames",
            "deniedPrefixes",
            "pathNames",
            "path"
          ],
          "properties": {
            "deniedNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedPrefixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pathNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "path": {
              "type": "string"
            }
          }
        },
        "crateTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wasm": {
          "type": "object",
          "additionalProperties": false,
          "description": "The one linked crate type that offloads, and only for WebAssembly targets: the targets, the crate types, the numeric linker arguments (full-match patterns) of the release's wasm-ld flags, how long such an action may run and how much memory placement reserves for it.",
          "required": [
            "targets",
            "crateTypes",
            "linkArguments",
            "actionSeconds",
            "peakMegabytes"
          ],
          "properties": {
            "targets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "crateTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "linkArguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actionSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "peakMegabytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "description": "What a native unit may link on another machine: the linked crate types, the linker arguments (full-match patterns), the kinds of `-l`, the kinds of `-L` search directories (always a directory shipped with the action), the system libraries and frameworks that the worker resolves against its own SDK, the directories that every machine has (dropped from a command line, never shipped) and the bound of `-l` arguments of one unit.",
          "required": [
            "crateTypes",
            "arguments",
            "libraryKinds",
            "searchKinds",
            "systemLibraries",
            "frameworks",
            "systemDirectories",
            "maximumLibraries"
          ],
          "properties": {
            "crateTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "libraryKinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "searchKinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "systemLibraries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frameworks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "systemDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maximumLibraries": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "atMs",
        "pid",
        "kind",
        "crate",
        "key",
        "milliseconds",
        "waitedMs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "atMs": {
          "type": "integer"
        },
        "pid": {
          "type": "integer"
        },
        "lane": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "offload-run",
            "offload-declined",
            "offload-failed",
            "offload-local-fallback"
          ]
        },
        "crate": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/Reason"
        },
        "milliseconds": {
          "type": "number",
          "minimum": 0
        },
        "waitedMs": {
          "type": "number",
          "minimum": 0
        },
        "detail": {
          "type": "string"
        },
        "bytesShipped": {
          "type": "integer",
          "minimum": 0,
          "description": "The size of the input files of the unit's action (the files rustc reads)."
        },
        "bytesUploaded": {
          "type": "integer",
          "minimum": 0,
          "description": "The bytes of the action that the content store lacked and this machine uploaded."
        },
        "bytesReturned": {
          "type": "integer",
          "minimum": 0,
          "description": "The bytes of the compiler outputs and streams that came back."
        }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "crate",
        "unitKey",
        "toolchain",
        "files",
        "bytes",
        "mappings"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "crate": {
          "type": "string"
        },
        "unitKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "host"
          ],
          "properties": {
            "commit": {
              "type": "string"
            },
            "host": {
              "type": "string"
            }
          }
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "real",
              "virtual"
            ],
            "properties": {
              "real": {
                "type": "string"
              },
              "virtual": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "$ref": "#/definitions/Texts"
        },
        "de": {
          "$ref": "#/definitions/Texts"
        }
      }
    },
    "Texts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "policy": {
    "version": 1,
    "mode": {
      "environment": "SEMIO_OFFLOAD",
      "default": "distribute",
      "pinPrefix": "pin:"
    },
    "limits": {
      "fanOutJobs": 12,
      "roundTripMilliseconds": 2500,
      "queueThresholdMilliseconds": 1500,
      "maximumInputFiles": 8192,
      "maximumInputBytes": 4294967296,
      "maximumUploadBytes": 4294967296,
      "fleetStatusMilliseconds": 3000,
      "maximumOutputBytes": 1073741824,
      "maximumClosureFiles": 32768,
      "maximumArgumentBytes": 262144,
      "maximumCheckConfigurationBytes": 1048576,
      "tokenWaitMilliseconds": 30000,
      "admissionMemoMilliseconds": 2000,
      "unitMegabytes": 768,
      "declineMemoMilliseconds": 3000,
      "reachableMemoMilliseconds": 15000,
      "contentRetries": 3,
      "contentRetryAfterCapMilliseconds": 2000
    },
    "timeouts": {
      "connectMilliseconds": 3000,
      "uploadMilliseconds": 300000,
      "queueMilliseconds": 8000,
      "executeMarginMilliseconds": 30000,
      "downloadMilliseconds": 120000,
      "actionSeconds": 1200,
      "probeMilliseconds": 4000,
      "requestMilliseconds": 20000,
      "rideThroughMilliseconds": 20000,
      "queueSaturatedMilliseconds": 120000,
      "pinQueueMilliseconds": 3600000
    },
    "deadline": {
      "factor": 4,
      "floorMilliseconds": 60000,
      "capMilliseconds": 900000,
      "unknownMilliseconds": 240000,
      "linkedCapMilliseconds": 3600000,
      "linkedUnknownMilliseconds": 2400000,
      "silenceMilliseconds": 20000,
      "reattachMilliseconds": 10000
    },
    "virtual": {
      "base": ".semio-offload",
      "out": ".semio-offload/o",
      "deps": ".semio-offload/d",
      "package": ".semio-offload/p",
      "generated": ".semio-offload/g",
      "external": ".semio-offload/x",
      "native": ".semio-offload/n",
      "root": ".semio-offload/root"
    },
    "property": {
      "offload": "semio-offload",
      "offloadValue": "if-idle",
      "origin": "semio-origin",
      "toolchain": "semio-toolchain",
      "target": "semio-target",
      "targetPrefix": "semio-rustc-target-",
      "format": "semio-offload-format",
      "formatValue": "argv-1",
      "peak": "semio-peak-mb",
      "queueValue": "queue",
      "pin": "semio-pin",
      "sdk": "semio-sdk"
    },
    "tool": {
      "name": "rustc",
      "windowsExecutable": "rustc.exe",
      "placeholder": "@tool"
    },
    "root": {
      "placeholder": "@root",
      "report": "SEMIO_ROOT_REPORT",
      "home": ".tmp",
      "directories": [
        ".semio-offload/o"
      ]
    },
    "environment": {
      "deniedNames": [
        "PATH",
        "HOME",
        "USER",
        "LOGNAME",
        "SHELL",
        "PWD",
        "OLDPWD",
        "TMPDIR",
        "TMP",
        "TEMP",
        "TERM",
        "LANG",
        "CARGO",
        "CARGO_HOME",
        "CARGO_MAKEFLAGS",
        "MAKEFLAGS",
        "MFLAGS",
        "MAKELEVEL",
        "NUM_JOBS",
        "CARGO_TARGET_DIR",
        "RUSTC",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "RUSTDOC",
        "RUSTUP_TOOLCHAIN",
        "RUSTUP_HOME",
        "LD_LIBRARY_PATH",
        "SSH_AUTH_SOCK",
        "OUT_DIR",
        "CARGO_MANIFEST_DIR",
        "TZ",
        "SECURITYSESSIONID",
        "COMMAND_MODE",
        "XPC_FLAGS",
        "XPC_SERVICE_NAME",
        "LaunchInstanceID",
        "DEVELOPER_DIR",
        "CARGO_MANIFEST_PATH"
      ],
      "deniedPrefixes": [
        "SEMIO_",
        "DYLD_",
        "LD_",
        "RUSTUP_",
        "CARGO_BUILD_",
        "CARGO_REGISTRIES_",
        "CARGO_NET_",
        "CARGO_HTTP_",
        "__CF",
        "XPC_",
        "SSH_",
        "TERM_",
        "LC_",
        "BUN_",
        "NODE_",
        "npm_",
        "GIT_",
        "HOMEBREW_",
        "ZSH",
        "COLOR",
        "ITERM",
        "VSCODE_",
        "CLAUDE",
        "CODEX_",
        "ANTHROPIC_",
        "OPENAI_"
      ],
      "pathNames": [
        "CARGO_MANIFEST_DIR",
        "CARGO_MANIFEST_PATH",
        "OUT_DIR"
      ],
      "path": "/usr/bin:/bin:/usr/sbin:/sbin"
    },
    "crateTypes": [
      "lib",
      "rlib",
      "proc-macro",
      "bin"
    ],
    "wasm": {
      "targets": [
        "wasm32-unknown-unknown",
        "wasm32-wasip2"
      ],
      "crateTypes": [
        "cdylib"
      ],
      "linkArguments": [
        "^--max-memory=[0-9]{1,12}$",
        "^-zstack-size=[0-9]{1,10}$",
        "^-Wl,--export=[A-Za-z_][A-Za-z0-9_]{0,200}$"
      ],
      "actionSeconds": 3600,
      "peakMegabytes": 6144
    },
    "link": {
      "crateTypes": [
        "cdylib",
        "dylib",
        "staticlib"
      ],
      "arguments": [
        "^-Wl,-undefined,dynamic_lookup$"
      ],
      "libraryKinds": [
        "static",
        "dylib",
        "framework"
      ],
      "searchKinds": [
        "native",
        "all",
        "framework"
      ],
      "systemLibraries": [
        "System",
        "c",
        "m",
        "pthread",
        "dl",
        "rt",
        "util",
        "iconv",
        "objc",
        "c++",
        "c++abi",
        "stdc++",
        "gcc_s",
        "z",
        "resolv",
        "sqlite3",
        "bz2",
        "xml2",
        "ncurses",
        "curl"
      ],
      "frameworks": [
        "Accelerate",
        "AppKit",
        "AudioToolbox",
        "AudioUnit",
        "AVFoundation",
        "Carbon",
        "CoreAudio",
        "CoreFoundation",
        "CoreGraphics",
        "CoreHaptics",
        "CoreImage",
        "CoreMedia",
        "CoreServices",
        "CoreText",
        "CoreVideo",
        "Foundation",
        "IOKit",
        "IOSurface",
        "Metal",
        "MetalKit",
        "QuartzCore",
        "Security",
        "SystemConfiguration",
        "UniformTypeIdentifiers"
      ],
      "systemDirectories": [
        "/usr/lib",
        "/System/Library/Frameworks",
        "/Library/Frameworks",
        "/Library/Developer/CommandLineTools/SDKs",
        "/Applications/Xcode.app/Contents/Developer/Platforms"
      ],
      "maximumLibraries": 256
    }
  },
  "messages": {
    "en": {
      "offloaded": "Unit {crate} offloaded to {origin} ({milliseconds} ms).",
      "declined": "Unit {crate} stays here: {reason}.",
      "fallback": "Unit {crate} compiles here after the offload failed: {reason}.",
      "stage.queued": "Unit {crate} waits for a machine.",
