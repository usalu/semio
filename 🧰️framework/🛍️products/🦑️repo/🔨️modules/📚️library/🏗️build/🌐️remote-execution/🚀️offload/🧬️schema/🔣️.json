{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/rustc-offload/v1",
  "title": "Rustc offload",
  "description": "A machine under pressure hands one rustc unit of the fleet's unit cache to an unsaturated machine: the policy (thresholds, timeouts, virtual paths, platform properties), the manifest of one offloaded action, the events and the bilingual texts.",
  "definitions": {
    "Mode": {
      "type": "string",
      "enum": [
        "always",
        "auto",
        "never"
      ]
    },
    "Reason": {
      "type": "string",
      "enum": [
        "not-portable",
        "no-endpoint",
        "no-credential",
        "unmapped-path",
        "inputs-too-large",
        "unreadable-input",
        "no-idle-machine",
        "queue-timeout",
        "infrastructure",
        "toolchain-missing",
        "path-dependent-output",
        "worker-policy",
        "incomplete-inputs",
        "cancelled"
      ]
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "limits",
        "timeouts",
        "virtual",
        "property",
        "tool",
        "script",
        "environment",
        "crateTypes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment",
            "default"
          ],
          "properties": {
            "environment": {
              "type": "string"
            },
            "default": {
              "$ref": "#/definitions/Mode"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queueThresholdMilliseconds",
            "fanOutJobs",
            "roundTripMilliseconds",
            "maximumInputFiles",
            "maximumInputBytes",
            "maximumOutputBytes",
            "maximumClosureFiles",
            "maximumArgumentBytes",
            "tokenWaitMilliseconds",
            "admissionMemoMilliseconds",
            "unitMegabytes",
            "declineMemoMilliseconds",
            "reachableMemoMilliseconds"
          ],
          "properties": {
            "roundTripMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "fanOutJobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "queueThresholdMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "maximumInputFiles": {
              "type": "integer",
              "minimum": 1
            },
            "maximumInputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumOutputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumClosureFiles": {
              "type": "integer",
              "minimum": 1
            },
            "maximumArgumentBytes": {
              "type": "integer",
              "minimum": 1
            },
            "tokenWaitMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "admissionMemoMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "unitMegabytes": {
              "type": "integer",
              "minimum": 1
            },
            "declineMemoMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "reachableMemoMilliseconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectMilliseconds",
            "uploadMilliseconds",
            "queueMilliseconds",
            "executeMilliseconds",
            "downloadMilliseconds",
            "actionSeconds",
            "probeMilliseconds",
            "requestMilliseconds",
            "rideThroughMilliseconds"
          ],
          "properties": {
            "connectMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "uploadMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "queueMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "executeMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "downloadMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "actionSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "probeMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "requestMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "rideThroughMilliseconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "virtual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "out",
            "deps",
            "package",
            "generated",
            "external",
            "root"
          ],
          "properties": {
            "base": {
              "type": "string"
            },
            "out": {
              "type": "string"
            },
            "deps": {
              "type": "string"
            },
            "package": {
              "type": "string"
            },
            "generated": {
              "type": "string"
            },
            "external": {
              "type": "string"
            },
            "root": {
              "type": "string"
            }
          }
        },
        "property": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offload",
            "offloadValue",
            "origin",
            "toolchain",
            "target",
            "targetPrefix"
          ],
          "properties": {
            "offload": {
              "type": "string"
            },
            "offloadValue": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "toolchain": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "targetPrefix": {
              "type": "string"
            }
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "environment",
            "placeholder"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "placeholder": {
              "type": "string"
            }
          }
        },
        "script": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deniedNames",
            "deniedPrefixes",
            "pathNames",
            "path"
          ],
          "properties": {
            "deniedNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedPrefixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pathNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "path": {
              "type": "string"
            }
          }
        },
        "crateTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "atMs",
        "pid",
        "kind",
        "crate",
        "key",
        "milliseconds",
        "waitedMs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "atMs": {
          "type": "integer"
        },
        "pid": {
          "type": "integer"
        },
        "lane": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "offload-run",
            "offload-declined",
            "offload-failed",
            "offload-local-fallback"
          ]
        },
        "crate": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/Reason"
        },
        "milliseconds": {
          "type": "number",
          "minimum": 0
        },
        "waitedMs": {
          "type": "number",
          "minimum": 0
        },
        "detail": {
          "type": "string"
        },
        "bytesShipped": {
          "type": "integer",
          "minimum": 0,
          "description": "The size of the input files of the unit's action (the files rustc reads)."
        },
        "bytesUploaded": {
          "type": "integer",
          "minimum": 0,
          "description": "The bytes of the action that the content store lacked and this machine uploaded."
        },
        "bytesReturned": {
          "type": "integer",
          "minimum": 0,
          "description": "The bytes of the compiler outputs and streams that came back."
        }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "crate",
        "unitKey",
        "toolchain",
        "files",
        "bytes",
        "mappings"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "crate": {
          "type": "string"
        },
        "unitKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "host"
          ],
          "properties": {
            "commit": {
              "type": "string"
            },
            "host": {
              "type": "string"
            }
          }
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "real",
              "virtual"
            ],
            "properties": {
              "real": {
                "type": "string"
              },
              "virtual": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "$ref": "#/definitions/Texts"
        },
        "de": {
          "$ref": "#/definitions/Texts"
        }
      }
    },
    "Texts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "policy": {
    "version": 1,
    "mode": {
      "environment": "SEMIO_OFFLOAD",
      "default": "auto"
    },
    "limits": {
      "fanOutJobs": 12,
      "roundTripMilliseconds": 2500,
      "queueThresholdMilliseconds": 1500,
      "maximumInputFiles": 8192,
      "maximumInputBytes": 536870912,
      "maximumOutputBytes": 1073741824,
      "maximumClosureFiles": 4096,
      "maximumArgumentBytes": 262144,
      "tokenWaitMilliseconds": 30000,
      "admissionMemoMilliseconds": 2000,
      "unitMegabytes": 768,
      "declineMemoMilliseconds": 3000,
      "reachableMemoMilliseconds": 15000
    },
    "timeouts": {
      "connectMilliseconds": 3000,
      "uploadMilliseconds": 90000,
      "queueMilliseconds": 8000,
      "executeMilliseconds": 1500000,
      "downloadMilliseconds": 120000,
      "actionSeconds": 1200,
      "probeMilliseconds": 4000,
      "requestMilliseconds": 20000,
      "rideThroughMilliseconds": 20000
    },
    "virtual": {
      "base": ".semio-offload",
      "out": ".semio-offload/o",
      "deps": ".semio-offload/d",
      "package": ".semio-offload/p",
      "generated": ".semio-offload/g",
      "external": ".semio-offload/x",
      "root": ".semio-offload/root"
    },
    "property": {
      "offload": "semio-offload",
      "offloadValue": "if-idle",
      "origin": "semio-origin",
      "toolchain": "semio-toolchain",
      "target": "semio-target",
      "targetPrefix": "semio-rustc-target-"
    },
    "tool": {
      "name": "rustc",
      "environment": "SEMIO_TOOL_RUSTC",
      "placeholder": "@tool"
    },
    "script": "root=$PWD\nmkdir -p .semio-offload/o .tmp\nprintf '%s' \"$root\" > .semio-offload/root\nfor name in $SEMIO_ABSOLUTE; do\n eval \"rel=\\$SEMIO_REL_$name\"\n eval \"export $name=\\\"\\$root/\\$rel\\\"\"\ndone\nexport HOME=\"$root/.tmp\"\ncase \"$(uname -s)\" in Darwin) set -- \"-Clink-arg=-Wl,-oso_prefix,$root/.semio-offload/o/\" \"$@\";; esac\nkeep=$IFS\nIFS='\n'\nfor entry in $SEMIO_REMAPS; do set -- \"$@\" \"--remap-path-prefix=$root/${entry%%=*}=${entry#*=}\"; done\nIFS=$keep\nif [ -n \"$SEMIO_SOURCE\" ]; then set -- \"$@\" \"$root/$SEMIO_SOURCE\"; fi\nexec \"$SEMIO_TOOL_RUSTC\" \"--remap-path-prefix=$root=$SEMIO_CWD_NAME\" \"$@\"\n",
    "environment": {
      "deniedNames": [
        "PATH",
        "HOME",
        "USER",
        "LOGNAME",
        "SHELL",
        "PWD",
        "OLDPWD",
        "TMPDIR",
        "TMP",
        "TEMP",
        "TERM",
        "LANG",
        "CARGO",
        "CARGO_HOME",
        "CARGO_MAKEFLAGS",
        "MAKEFLAGS",
        "MFLAGS",
        "MAKELEVEL",
        "NUM_JOBS",
        "CARGO_TARGET_DIR",
        "RUSTC",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "RUSTDOC",
        "RUSTUP_TOOLCHAIN",
        "RUSTUP_HOME",
        "LD_LIBRARY_PATH",
        "SSH_AUTH_SOCK",
        "OUT_DIR",
        "CARGO_MANIFEST_DIR",
        "TZ",
        "SECURITYSESSIONID",
        "COMMAND_MODE",
        "XPC_FLAGS",
        "XPC_SERVICE_NAME",
        "LaunchInstanceID",
        "DEVELOPER_DIR",
        "CARGO_MANIFEST_PATH"
      ],
      "deniedPrefixes": [
        "SEMIO_",
        "DYLD_",
        "LD_",
        "RUSTUP_",
        "CARGO_BUILD_",
        "CARGO_REGISTRIES_",
        "CARGO_NET_",
        "CARGO_HTTP_",
        "__CF",
        "XPC_",
        "SSH_",
        "TERM_",
        "LC_",
        "BUN_",
        "NODE_",
        "npm_",
        "GIT_",
        "HOMEBREW_",
        "ZSH",
        "COLOR",
        "ITERM",
        "VSCODE_",
        "CLAUDE",
        "CODEX_",
        "ANTHROPIC_",
        "OPENAI_"
      ],
      "pathNames": [
        "CARGO_MANIFEST_DIR",
        "CARGO_MANIFEST_PATH",
        "OUT_DIR"
      ],
      "path": "/usr/bin:/bin:/usr/sbin:/sbin"
    },
    "crateTypes": [
      "lib",
      "rlib",
      "proc-macro",
      "bin"
    ]
  },
  "messages": {
    "en": {
      "offloaded": "Unit {crate} offloaded to {origin} ({milliseconds} ms).",
      "declined": "Unit {crate} stays here: {reason}.",
      "fallback": "Unit {crate} compiles here after the offload failed: {reason}.",
      "reason.not-portable": "its kind cannot be compiled elsewhere",
      "reason.no-endpoint": "no execution endpoint is configured",
      "reason.no-credential": "no fleet credential is available",
      "reason.unmapped-path": "it names a path outside the workspace that cannot be mapped",
      "reason.inputs-too-large": "its inputs are too large to ship",
      "reason.unreadable-input": "an input could not be read",
      "reason.no-idle-machine": "no other machine has headroom",
      "reason.queue-timeout": "no machine took it in time",
      "reason.infrastructure": "the execution service failed",
      "reason.toolchain-missing": "the compiler identity is unknown",
      "reason.path-dependent-output": "the result depends on the path of the other machine",
      "reason.worker-policy": "the action policy of a worker refuses its arguments",
      "reason.incomplete-inputs": "the other machine lacked an input",
      "reason.cancelled": "the build was cancelled",
      "flag.invalid": "--offload takes always, auto or never, once."
    },
    "de": {
      "offloaded": "Einheit {crate} auf {origin} ausgelagert ({milliseconds} ms).",
      "declined": "Einheit {crate} bleibt hier: {reason}.",
      "fallback": "Einheit {crate} wird hier kompiliert, nachdem das Auslagern fehlschlug: {reason}.",
      "reason.not-portable": "ihre Art lässt sich nicht anderswo kompilieren",
      "reason.no-endpoint": "kein Ausführungsendpunkt ist eingerichtet",
      "reason.no-credential": "kein Flottenzugang ist verfügbar",
      "reason.unmapped-path": "sie nennt einen Pfad außerhalb des Arbeitsbereichs, der sich nicht abbilden lässt",
      "reason.inputs-too-large": "ihre Eingaben sind zu groß zum Versenden",
      "reason.unreadable-input": "eine Eingabe war nicht lesbar",
      "reason.no-idle-machine": "keine andere Maschine hat Luft",
      "reason.queue-timeout": "keine Maschine hat sie rechtzeitig übernommen",
      "reason.infrastructure": "der Ausführungsdienst ist ausgefallen",
      "reason.toolchain-missing": "die Identität des Compilers ist unbekannt",
      "reason.path-dependent-output": "das Ergebnis hängt vom Pfad der anderen Maschine ab",
      "reason.worker-policy": "die Aktionsrichtlinie eines Workers lehnt ihre Argumente ab",
      "reason.incomplete-inputs": "der anderen Maschine fehlte eine Eingabe",
      "reason.cancelled": "der Build wurde abgebrochen",
      "flag.invalid": "--offload nimmt always, auto oder never, genau einmal."
    }
  }
}
