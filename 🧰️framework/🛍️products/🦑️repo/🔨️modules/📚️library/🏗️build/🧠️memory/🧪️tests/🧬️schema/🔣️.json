{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Graph memory law fixture / Gesetz der Speichergrenze",
  "description": "EN: Closed tables of the language choice, the rendered messages and the owner concurrency a cgroup headroom admits. DE: Geschlossene Tabellen der Sprachwahl, der ausgegebenen Texte und der Projektparallelität, die eine cgroup-Reserve zulässt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy",
    "messages",
    "languages",
    "messageCases",
    "headroom",
    "admission",
    "scenarios"
  ],
  "definitions": {
    "Environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "policy": {
      "type": "object"
    },
    "messages": {
      "type": "object"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "environment",
          "expect"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "environment": {
            "$ref": "#/definitions/Environment"
          },
          "expect": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "enum": [
                "en",
                "de"
              ]
            }
          }
        }
      }
    },
    "messageCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "fields",
          "environment",
          "expect"
        ],
        "properties": {
          "key": {
            "enum": [
              "waiting",
              "serial",
              "resumed",
              "learning"
            ]
          },
          "fields": {
            "type": "object"
          },
          "environment": {
            "$ref": "#/definitions/Environment"
          },
          "expect": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "headroom": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "limitMegabytes",
          "currentMegabytes",
          "ownerMegabytes",
          "workers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "limitMegabytes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currentMegabytes": {
            "type": "number",
            "minimum": 0
          },
          "ownerMegabytes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "workers": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "admission": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "headroomMegabytes",
          "running",
          "inflight",
          "estimateMegabytes",
          "learned",
          "expect"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "headroomMegabytes": {
            "type": "number"
          },
          "running": {
            "type": "integer",
            "minimum": 0
          },
          "inflight": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estimateMegabytes",
                "takenMegabytes"
              ],
              "properties": {
                "estimateMegabytes": {
                  "type": "number",
                  "minimum": 0
                },
                "takenMegabytes": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "estimateMegabytes": {
            "type": "number",
            "minimum": 0
          },
          "learned": {
            "type": "boolean"
          },
          "expect": {
            "type": "boolean"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "limitMegabytes",
          "currentMegabytes",
          "workers",
          "persisted",
          "tasks",
          "guessMegabytes",
          "expectPeak",
          "expectLearned"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "limitMegabytes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currentMegabytes": {
            "type": "number",
            "minimum": 0
          },
          "workers": {
            "type": "integer",
            "minimum": 1
          },
          "persisted": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "growthMegabytes"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "growthMegabytes": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "guessMegabytes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "expectPeak": {
            "type": "integer",
            "minimum": 1
          },
          "expectLearned": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
