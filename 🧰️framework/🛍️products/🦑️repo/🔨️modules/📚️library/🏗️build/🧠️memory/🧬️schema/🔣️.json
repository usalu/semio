{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Graph memory governor / Speichergrenze des Graph-Aufbaus",
  "description": "EN: The managed memory of one graph construction is bounded by a budget: a new project inference starts only while the heap is within the budget (after one collection), never more than the worker count run at once, a budget exceeded by retained data degrades to one project at a time, equal long strings of results and stored documents are one instance. DE: Der verwaltete Speicher eines Graph-Aufbaus ist durch ein Budget begrenzt: eine neue Projektableitung startet nur, solange der Heap im Budget liegt (nach einer Speicherbereinigung), es laufen nie mehr Projekte als Arbeiter, ein durch gehaltene Daten überschrittenes Budget führt zu einem Projekt nach dem anderen, gleiche lange Zeichenketten von Ergebnissen und gespeicherten Dokumenten sind eine Instanz. EN: The language of every line is the one the environment names (SEMIO_LANGUAGE, dashboard locale, system locale); when none is named every supported language is printed, English first and German second, so there is no default language. DE: Die Sprache jeder Zeile ist die, die die Umgebung nennt; nennt sie keine, werden alle unterstützten Sprachen ausgegeben, zuerst Englisch, dann Deutsch, es gibt also keine Standardsprache. EN: The graph child that plans a build is told a fixed JavaScriptCore memory size (childHeapMegabytes), never the capacity grant of the whole run: the grant pays for every process of the run, and a larger size only lets the child keep more garbage before it collects. DE: Dem Graph-Kindprozess, der einen Build plant, wird eine feste JavaScriptCore-Speichergröße genannt (childHeapMegabytes), nie die Kapazitätszusage des ganzen Laufs: die Zusage bezahlt jeden Prozess des Laufs, und eine größere Angabe lässt das Kind nur mehr Abfall halten, bevor es aufräumt.",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "languages": [
          "en",
          "de"
        ],
        "minimumBudgetMegabytes": 1024,
        "maximumBudgetMegabytes": 16384,
        "hostShare": 0.25,
        "grantShare": 0.5,
        "resumeRatio": 0.85,
        "pollMilliseconds": 50,
        "sampleMilliseconds": 25,
        "admitMinimumMilliseconds": 100,
        "collectMinimumMilliseconds": 2000,
        "retainedMilliseconds": 30000,
        "progressMilliseconds": 5000,
        "retainedImageBytes": 33554432,
        "minimumInternedLength": 24,
        "maximumInternedCharacters": 67108864,
        "maximumCachedClosureEntries": 4194304,
        "maximumParsedManifests": 256,
        "childHeapMegabytes": 2048,
        "budgetEnvironment": "SEMIO_GRAPH_MEMORY_MB",
        "planEnvironment": "SEMIO_HOST_CAPACITY_PLAN"
      }
    },
    "Messages": {
      "const": {
        "en": {
          "waiting": "graph: waiting for memory ({used} of {budget} MB in use, {running} projects running)",
          "serial": "graph: memory above the budget of {budget} MB ({used} MB in use), inferring one project at a time",
          "resumed": "graph: memory below the budget again ({used} of {budget} MB), resuming"
        },
        "de": {
          "waiting": "Graph: wartet auf Speicher ({used} von {budget} MB belegt, {running} Projekte laufen)",
          "serial": "Graph: Speicher über dem Budget von {budget} MB ({used} MB belegt), Projekte werden einzeln abgeleitet",
          "resumed": "Graph: Speicher wieder unter dem Budget ({used} von {budget} MB), es geht weiter"
        }
      }
    },
    "ReservationBudgetCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "carriedMegabytes",
        "fixedMegabytes",
        "expectedMegabytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "carriedMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "fixedMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "reservedMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "explicitMegabytes": {
          "type": "integer",
          "minimum": 1024
        },
        "foreign": {
          "type": "boolean"
        },
        "expectedMegabytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PhysicalPressureCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "counters",
        "expectedBytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rss",
            "heapUsed",
            "external"
          ],
          "properties": {
            "rss": {
              "type": "integer",
              "minimum": 0
            },
            "heapUsed": {
              "type": "integer",
              "minimum": 0
            },
            "external": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "expectedBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ParentAllocationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reservedMegabytes",
        "expected"
      ],
      "properties": {
        "reservedMegabytes": {
          "type": "integer",
          "minimum": 1
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parentMegabytes",
            "fixedMegabytes",
            "workerMegabytes",
            "ownMegabytes"
          ],
          "properties": {
            "parentMegabytes": {
              "type": "integer",
              "minimum": 0
            },
            "fixedMegabytes": {
              "type": "integer",
              "minimum": 0
            },
            "workerMegabytes": {
              "type": "integer",
              "minimum": 0
            },
            "ownMegabytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "ReservationLivenessCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "expectedMegabytes"
      ],
      "properties": {
        "state": {
          "enum": [
            "active",
            "stale",
            "previous-boot",
            "dead",
            "quiet",
            "zero"
          ]
        },
        "expectedMegabytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "WorkerRefreshCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "previous",
        "next",
        "retire"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "previous": {
          "type": "object",
          "required": [
            "workers",
            "megabytes"
          ],
          "additionalProperties": false,
          "properties": {
            "workers": {
              "type": "integer",
              "minimum": 1
            },
            "megabytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "next": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "workers",
                "megabytes"
              ],
              "additionalProperties": false,
              "properties": {
                "workers": {
                  "type": "integer",
                  "minimum": 1
                },
                "megabytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "retire": {
          "type": "boolean"
        }
      }
    }
  }
}
