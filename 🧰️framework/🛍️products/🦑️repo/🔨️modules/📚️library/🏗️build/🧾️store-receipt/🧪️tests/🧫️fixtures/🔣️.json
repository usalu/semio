  "scenarios": [
    {
      "name": "a hit with its store content present runs once",
      "receipt": "valid",
      "firstRun": "ok",
      "repairWrites": "valid",
      "secondRun": "ok",
      "expected": {
        "runs": 1,
        "repairs": 0,
        "outcome": "ok"
      }
    },
    {
      "name": "a hit whose store content is gone is a miss and re-executes",
      "receipt": "store-missing",
      "firstRun": "ok",
      "repairWrites": "valid",
      "secondRun": "ok",
      "expected": {
        "runs": 1,
        "repairs": 1,
        "outcome": "ok"
      }
    },
    {
      "name": "a repair that does not restore the content fails closed",
      "receipt": "store-missing",
      "firstRun": "ok",
      "repairWrites": "nothing",
      "secondRun": "ok",
      "expected": {
        "runs": 1,
        "repairs": 1,
        "outcome": "error",
        "message": "still not valid"
      }
    },
    {
      "name": "a receipt the handler never wrote after a success is re-executed",
      "receipt": "absent",
      "firstRun": "ok",
      "repairWrites": "valid",
      "secondRun": "ok",
      "expected": {
        "runs": 1,
        "repairs": 1,
        "outcome": "ok"
      }
    },
    {
      "name": "a receipt still unwritten after re-execution fails closed",
      "receipt": "absent",
      "firstRun": "ok",
      "repairWrites": "nothing",
      "secondRun": "ok",
      "expected": {
        "runs": 1,
        "repairs": 1,
        "outcome": "error",
        "message": "unwritten"
      }
    },
    {
      "name": "a malformed receipt is re-executed",
      "receipt": "malformed",
      "firstRun": "ok",
      "repairWrites": "valid",
      "secondRun": "ok",
      "expected": {
        "runs": 1,
        "repairs": 1,
        "outcome": "ok"
      }
    },
    {
      "name": "a failed run with no receipt state is the original failure",
      "receipt": "absent",
      "firstRun": "fail",
      "repairWrites": "nothing",
      "secondRun": "ok",
      "expected": {
        "runs": 1,
        "repairs": 0,
        "outcome": "error",
        "message": "run failed"
      }
    },
    {
      "name": "a failed run with a valid receipt is the original failure",
      "receipt": "valid",
      "firstRun": "fail",
      "repairWrites": "nothing",
      "secondRun": "ok",
      "expected": {
        "runs": 1,
        "repairs": 0,
        "outcome": "error",
        "message": "run failed"
      }
    },
    {
      "name": "a failed run with gone store content repairs and retries once",
      "receipt": "store-missing",
      "firstRun": "fail",
      "repairWrites": "valid",
      "secondRun": "ok",
      "expected": {
        "runs": 2,
        "repairs": 1,
        "outcome": "ok"
      }
    },
    {
      "name": "a retry that fails again is its failure",
      "receipt": "store-missing",
      "firstRun": "fail",
      "repairWrites": "valid",
      "secondRun": "fail",
      "expected": {
        "runs": 2,
        "repairs": 1,
        "outcome": "error",
        "message": "run failed"
      }
    }
  ],
  "receiptFiles": [
