  "declarations": [
    {
      "name": "a declared receipt resolves under the project root",
      "projectRoot": "a/b",
      "target": "build",
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "expected": "a/b/.🧾️store/build.json"
    },
    {
      "name": "other outputs do not declare one",
      "projectRoot": "a/b",
      "target": "build",
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "expected": null
    },
    {
      "name": "no outputs declare none",
      "projectRoot": "a/b",
      "target": "build",
      "outputs": [],
      "expected": null
    },
    {
      "name": "another target's receipt is not this target's",
      "projectRoot": "a/b",
      "target": "site",
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "expected": null
    },
    {
      "name": "the mode token keeps the receipt a different output",
      "projectRoot": "a/b",
      "target": "build",
      "outputs": [
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}/🧾️store/build.json"
      ],
      "expected": null
    },
    {
      "name": "a target that declares no receipt output is never name-validated, whatever its characters",
      "projectRoot": "a/b",
      "target": "🏭️generator",
      "outputs": [],
      "expected": null
    },
    {
      "name": "a target with other outputs only is never name-validated",
      "projectRoot": "a/b",
      "target": "🏭️generator-manifests",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "expected": null
    },
    {
      "name": "a project at the workspace root",
      "projectRoot": ".",
      "target": "build",
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "expected": ".🧾️store/build.json"
    }
  ],
