{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/build/graph/owner-checkpoint/v1",
  "title": "Selected Owner Checkpoint",
  "description": "An optional batch has one UTF-8 JSON header followed by a newline and the concatenated UTF-8 owner records in header order. A record key hashes the owning scope, admission format and exact owner question. Each record also has a content digest. The batch sequence maps to a fixed ring slot.",
  "$defs": {
    "Limits": {
      "const": {
        "slots": 256,
        "maximumPackBytes": 2097152,
        "maximumHeaderBytes": 16384,
        "maximumRecords": 32,
        "flushMilliseconds": 15000
      }
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "format",
        "sequence",
        "records"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/Digest"
        },
        "format": {
          "$ref": "#/$defs/Digest"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "bytes",
              "hash"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/Digest"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2097152
              },
              "hash": {
                "$ref": "#/$defs/Digest"
              }
            }
          }
        }
      }
    },
    "Record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "facts",
        "observations"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/Digest"
        },
        "facts": {
          "type": "object"
        },
        "observations": {
          "type": "array",
          "minItems": 2
        }
      }
    }
  },
  "$ref": "#/$defs/Header"
}
