  {"name": "a sibling with a common prefix owns nothing", "owners": [{"name": "app", "root": "app"}], "paths": ["application/x.ts", "app/x.ts", "app-extra/x.ts"], "expected": [null, "app", null]},
  {"name": "the workspace root owns nothing", "owners": [{"name": "workspace", "root": "."}, {"name": "pkg", "root": "pkg"}], "paths": ["x.ts", "pkg/x.ts"], "expected": [null, "pkg"]},
  {"name": "equal roots keep the smallest name", "owners": [{"name": "b", "root": "r"}, {"name": "a", "root": "r"}, {"name": "c", "root": "r"}], "paths": ["r/f.ts"], "expected": ["a"]},
