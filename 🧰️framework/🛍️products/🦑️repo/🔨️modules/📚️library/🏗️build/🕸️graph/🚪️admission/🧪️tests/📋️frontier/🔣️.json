{
  "depth": 1024,
  "cases": [
    {
      "name": "cycle keeps the next-pass boundary",
      "selection": {"kind":"tasks","tasks":[{"project":"z","target":"build"}]},
      "rows": {"a":{"targets":{"build":["z:extra"]}},"z":{"targets":{"build":["a:build"],"extra":[]}}}
    },
    {
      "name": "dependencies update later members before newly admitted members",
      "selection": {"kind":"owners","projects":["z","m","a"],"exclude":[],"targets":["build"]},
      "rows": {
        "a":{"targets":{"build":["m:extra","b:build"],"verify":[]}},
        "b":{"targets":{"build":[]},"observedFiles":["m/observed.ts"]},
        "m":{"targets":{"build":[],"extra":[]},"files":["b/member.ts"],"generated":{"extra":["z:extra"]}},
        "z":{"targets":{"build":["a:verify"],"extra":[]},"inputs":{"m":["api"]}}
      }
    },
    {
      "name": "a pruned optional target can become required on the next pass",
