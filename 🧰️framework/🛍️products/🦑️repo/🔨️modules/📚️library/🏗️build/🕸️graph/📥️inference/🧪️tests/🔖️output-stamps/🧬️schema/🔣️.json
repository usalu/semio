{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "probes",
  "unprobed",
  "golden"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "probes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "inferrer"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
     },
     "inferrer": {
      "type": "string"
     },
     "call": {
      "type": "string"
     },
     "fn": {
      "type": "string"
     },
     "args": {
      "type": "array"
     },
     "calls": {
      "type": "array",
      "items": {
       "type": "array"
      }
     },
     "analysis": {
      "enum": [
       "module",
       "command",
       "references",
       "script",
       "nativeScript",
       "rust"
      ]
     },
     "file": {
      "type": "string"
     },
     "files": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    }
   }
  },
  "unprobed": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "minLength": 10
   }
  },
  "golden": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  }
 }
}
