{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/schema/durable-closure-entries-law.json",
 "type": "object",
 "required": ["version", "files", "entries", "differential", "question", "steps"],
 "additionalProperties": false,
 "properties": {
  "version": {"const": 1},
  "files": {"type": "object", "additionalProperties": {"type": "string"}},
  "entries": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "differential": {"type": "object", "required": ["entry", "modules", "extras"], "additionalProperties": false, "properties": {"entry": {"type": "string"}, "modules": {"type": "integer", "minimum": 1}, "extras": {"type": "array", "items": {"type": "string"}}}},
  "question": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "edit", "forget", "derived", "loaded", "stale", "closures"], "additionalProperties": false, "properties": {
   "name": {"type": "string"}, "edit": {"type": "object", "additionalProperties": {"type": "string"}}, "forget": {"type": "boolean"}, "damage": {"type": "string"},
   "derived": {"type": "integer", "minimum": 0}, "loaded": {"type": "integer", "minimum": 0}, "stale": {"type": "integer", "minimum": 0},
   "closures": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}}}}
 }
}
