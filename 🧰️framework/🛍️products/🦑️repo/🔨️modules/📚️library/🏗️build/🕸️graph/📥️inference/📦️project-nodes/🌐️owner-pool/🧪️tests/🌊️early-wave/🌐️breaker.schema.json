{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "headTimeout",
      "requiredTimeout"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "headTimeout": {
        "type": "boolean"
      },
      "requiredTimeout": {
        "enum": [
          null,
          "cas",
          "ac"
        ]
      }
    }
  }
}
