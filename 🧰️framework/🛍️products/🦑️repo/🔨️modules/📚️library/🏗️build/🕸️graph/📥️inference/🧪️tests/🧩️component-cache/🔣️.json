    { "id": "library", "root": "owner/📦️packages/🦀️rust", "kind": "library", "crateTypes": ["rlib"], "expect": null },
    { "id": "not-cdylib", "root": "owner/🧩️component/📦️packages/🦀️rust", "kind": "plugin", "crateTypes": ["rlib"], "expect": "refused" }
