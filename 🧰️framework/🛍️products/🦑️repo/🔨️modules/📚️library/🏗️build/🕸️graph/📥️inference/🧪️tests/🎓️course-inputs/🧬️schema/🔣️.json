{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course cached-target input closure law",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "project", "workspaces", "inventory", "targets"],
  "properties": {
    "site": { "type": "string" },
    "project": { "type": "string" },
    "workspaces": { "type": "string", "description": "Workspace-relative package.json whose `workspaces` list names the scope members whose manifests the vitest alias helper reads." },
    "inventory": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Top-level directories the file inventory walks, besides the workspace's top-level files." },
    "targets": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["reads"], "properties": { "reads": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Read" } } } } }
  },
  "definitions": {
    "Read": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "config"], "properties": { "kind": { "const": "vitest" }, "config": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "entries"], "properties": { "kind": { "const": "imports" }, "entries": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "types": { "type": "boolean" }, "command": { "type": "string" }, "specifiers": { "type": "array", "items": { "type": "string" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "workspace-manifests" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "nearest-tsconfig" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "paths"], "properties": { "kind": { "const": "files" }, "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "tsconfig" }, "path": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "workspaceManifest", "package", "pattern"], "properties": { "kind": { "const": "rust" }, "workspaceManifest": { "type": "string" }, "package": { "type": "string" }, "pattern": { "type": "string" } } }
      ]
    }
  }
}
