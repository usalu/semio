{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/build/inference-provider-inputs-corpus/v1",
  "title": "Build inference provider input corpus",
  "description": "A language-agnostic scenario: a workspace of files, a provider designation, command entries that define provider ports (by literal name, by a name no literal states, or not at all) or only import the loader, and the input relations every implementation must reproduce: the designation, its schema and the designated module of every port a closure defines (all of them for an unnamed port) are inputs of exactly that entry, and editing one changes the input hash of exactly those entries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "designation", "files", "cases", "edits"],
  "properties": {
    "version": { "const": 1 },
    "designation": { "$ref": "#/definitions/Designation" },
    "files": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "directory", "definesPorts", "importsLoader", "includes", "excludes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "directory": { "type": "string", "minLength": 1 },
          "definesPorts": { "type": "boolean" },
          "importsLoader": { "type": "boolean" },
          "includes": { "type": "array", "items": { "type": "string" } },
          "excludes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "changes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "designation": { "$ref": "#/definitions/Designation" },
          "changes": { "type": "array", "items": { "type": "string" } },
          "gains": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      }
    }
  },
  "definitions": {
    "Designation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "providers"],
      "properties": {
        "version": { "const": 1 },
        "providers": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      }
    }
  }
}
