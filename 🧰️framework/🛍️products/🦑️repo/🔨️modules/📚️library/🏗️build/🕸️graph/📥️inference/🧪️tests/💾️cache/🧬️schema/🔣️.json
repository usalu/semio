{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inferred Target Cache Decision Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "decisions",
    "policy",
    "nativeRunsTests",
    "nativeInputs",
    "playground",
    "artifact",
    "nativeAuthored"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "valid"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": "object"
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    },
    "policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "decision",
          "cache"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "authored": {
            "type": "boolean"
          },
          "decision": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "cache": {
            "type": "boolean"
          },
          "continuous": {
            "type": "boolean"
          }
        }
      }
    },
    "nativeRunsTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "execution",
          "commandSources",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "execution": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "source",
                      "native",
                      "orchestration"
                    ]
                  },
                  "scope": {
                    "enum": [
                      "production",
                      "test"
                    ]
                  }
                }
              }
            ]
          },
          "commandSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expect": {
            "type": "boolean"
          }
        }
      }
    },
    "nativeInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "runsTests",
          "generated",
          "declared",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "runsTests": {
            "type": "boolean"
          },
          "generated": {
            "type": "array"
          },
          "declared": {
            "type": "array"
          },
          "expect": {
            "type": "array"
          }
        }
      }
    },
    "playground": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "variants",
        "profiles",
        "components",
        "generator",
        "publication",
        "perProfile",
        "perVariant",
        "once",
        "sessions",
        "sites"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "distDir": {
                "type": "string"
              }
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "prototype",
              "release"
            ]
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dependencies"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "generator": {
          "type": "object"
        },
        "publication": {
          "type": "object"
        },
        "perProfile": {
          "$ref": "#/definitions/Rows"
        },
        "perVariant": {
          "$ref": "#/definitions/Rows"
        },
        "once": {
          "$ref": "#/definitions/Rows"
        },
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "reason",
            "cache"
          ],
          "properties": {
            "class": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "cache": {
              "type": "boolean"
            }
          }
        },
        "sites": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "reason",
            "cache"
          ],
          "properties": {
            "class": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "cache": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "files",
        "tags",
        "targets",
        "expect"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cache",
              "decision"
            ],
            "properties": {
              "cache": {
                "type": "boolean"
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "decision": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "nativeAuthored": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "policyInputs",
          "commandInputs",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "policyInputs": {
            "type": "array"
          },
          "commandInputs": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array"
              }
            ]
          },
          "expect": {
            "type": "array"
          }
        }
      }
    }
  },
  "definitions": {
    "Rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "class",
          "reason",
          "cache",
          "continuous"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9{}-]+$"
          },
          "class": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "cache": {
            "type": "boolean"
          },
          "continuous": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
