{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared closure prime fixture / Vorabableitung gemeinsamer Closures",
  "description": "EN: The files of a fixture workspace, the entries whose closure entries are shared, every owner with the entries it asks and the roster it must read, and the counts of entries the prime and each owner derive. DE: Die Dateien eines Fixture-Arbeitsbereichs, die Einstiege, deren Closure-Einträge geteilt werden, jeder Eigner mit den Einstiegen, die er fragt, und der Liste, die er lesen muss, sowie die Zahl der Einträge, die die Vorabableitung und jeder Eigner ableiten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "files",
    "shared",
    "owners",
    "question",
    "primed",
    "ownerDerived"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "shared": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "entries",
          "closures"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "closures": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "question": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipes",
        "derived"
      ],
      "properties": {
        "recipes": {
          "type": "integer",
          "minimum": 1
        },
        "derived": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ownerDerived": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
