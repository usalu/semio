      "outputs": [
        "made/directory"
      ],
      "expected": ""
    },
    {
      "id": "extensionless",
      "request": "made/file",
      "outputs": [
        "made/file.ts"
      ],
      "expected": "made/file.ts"
    },
    {
      "id": "extensionless-physical-competitor",
      "request": "made/file",
      "outputs": [
        "made/file.ts"
      ],
      "physical": [
        "made/file.d.ts"
      ],
      "expected": "ambiguous-resolution"
    },
    {
      "id": "extensionless-declared-competitor",
      "request": "made/file",
