{
  "files": {
    "package.json": "{\"name\":\"covered-root\",\"private\":true}\n",
    "tools/📜️script.ts": "import { a } from './a.ts';\nimport source from './rawsrc.ts?raw';\nexport const x = a + source.length;\n",
    "tools/a.ts": "import { b } from './b.ts';\nexport const a = b;\n",
    "tools/b.ts": "export const b = 1;\n",
    "tools/rawsrc.ts": "import { deep } from './deep.ts';\nexport const raw = deep;\n",
    "tools/deep.ts": "export const deep = 2;\n",
    "tools/check.test.ts": "import { helper } from './helper.ts';\nexport const checked = helper;\n",
    "tools/helper.ts": "export const helper = 3;\n"
  },
  "command": "repo ./tools/📜️script.ts check",
  "base": ["tools/a.ts", "tools/b.ts", "tools/rawsrc.ts", "tools/📜️script.ts"],
  "cases": [
    { "id": "modules the entry closure compiled change nothing", "projectRoot": ".", "inputs": ["{workspaceRoot}/tools/a.ts", "{workspaceRoot}/tools/b.ts"], "closure": ["tools/a.ts", "tools/b.ts", "tools/rawsrc.ts", "tools/📜️script.ts"] },
    { "id": "a member named through the project root changes nothing", "projectRoot": "tools", "inputs": ["{projectRoot}/a.ts"], "closure": ["tools/a.ts", "tools/b.ts", "tools/rawsrc.ts", "tools/📜️script.ts"] },
    { "id": "a module outside the closure joins with its own imports", "projectRoot": ".", "inputs": ["{workspaceRoot}/tools/check.test.ts"], "closure": ["tools/a.ts", "tools/b.ts", "tools/check.test.ts", "tools/helper.ts", "tools/rawsrc.ts", "tools/📜️script.ts"] },
    { "id": "covered and uncovered inputs together", "projectRoot": "tools", "inputs": ["{workspaceRoot}/tools/a.ts", "{projectRoot}/check.test.ts"], "closure": ["tools/a.ts", "tools/b.ts", "tools/check.test.ts", "tools/helper.ts", "tools/rawsrc.ts", "tools/📜️script.ts"] },
    { "id": "a file the closure only hashed as a resource still follows its imports when declared as a module", "projectRoot": ".", "inputs": ["{workspaceRoot}/tools/rawsrc.ts"], "closure": ["tools/a.ts", "tools/b.ts", "tools/deep.ts", "tools/rawsrc.ts", "tools/📜️script.ts"] },
    { "id": "non-module inputs are ignored", "projectRoot": ".", "inputs": ["default", "^default", "{workspaceRoot}/package.json", "{workspaceRoot}/tools/*.ts", "!{workspaceRoot}/tools/a.ts", "{workspaceRoot}/tools/missing.ts"], "closure": ["tools/a.ts", "tools/b.ts", "tools/rawsrc.ts", "tools/📜️script.ts"] }
  ]
}
