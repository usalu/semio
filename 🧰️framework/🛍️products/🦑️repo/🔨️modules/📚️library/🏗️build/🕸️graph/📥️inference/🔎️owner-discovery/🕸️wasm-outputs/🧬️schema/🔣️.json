{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specifier",
        "path"
      ],
      "properties": {
        "specifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^@[^/]+/[^/?#]+(?:/[^?#*]+)?$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000:*?\"<>|]+\\.(?:[cm]?js|d\\.[cm]?ts)$"
        },
        "declarations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000:*?\"<>|]+\\.d\\.[cm]?ts$"
        }
      }
    },
    "Producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceOwner",
        "compileOutputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sourceOwner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000:*?\"<>|]+$"
        },
        "compileOutputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Output"
          }
        }
      }
    }
  }
}
