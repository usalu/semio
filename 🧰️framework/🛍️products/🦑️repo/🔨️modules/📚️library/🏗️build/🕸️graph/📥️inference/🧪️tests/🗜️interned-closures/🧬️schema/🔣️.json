{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:inference:interned-closures-fixture:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "sink", "producers", "wrapper", "cases"],
  "properties": {
    "component": { "type": "string", "minLength": 1 },
    "sink": { "type": "string", "minLength": 1 },
    "producers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "wrapper": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "violations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "violations": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
