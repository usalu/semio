{
 "version": 1,
 "documents": [
  {
   "name": "a package with inline dependency tables",
   "text": "[package]\nname = \"a\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\nserde = { version = \"1\", features = [\"derive\"] }\nb = { path = \"../b\" }\n",
   "expected": {
    "package": {
     "name": "a",
     "version": "0.1.0",
     "edition": "2021"
    },
    "dependencies": {
     "serde": {
      "version": "1",
      "features": [
       "derive"
      ]
     },
     "b": {
      "path": "../b"
     }
    }
   },
   "bun": "same"
  },
  {
   "name": "arrays of tables",
   "text": "[[bin]]\nname = \"x\"\npath = \"src/x.rs\"\n[[bin]]\nname = \"y\"\npath = \"src/y.rs\"\n",
   "expected": {
    "bin": [
     {
      "name": "x",
      "path": "src/x.rs"
     },
     {
      "name": "y",
      "path": "src/y.rs"
     }
    ]
   },
   "bun": "same"
  },
  {
   "name": "target tables with a cfg expression and a triple",
   "text": "[target.'cfg(unix)'.dependencies]\nlibc = \"0.2\"\n[target.\"x86_64-pc-windows-msvc\".dependencies]\nwinapi = { path = \"../w\" }\n",
   "expected": {
    "target": {
     "cfg(unix)": {
      "dependencies": {
       "libc": "0.2"
      }
     },
     "x86_64-pc-windows-msvc": {
      "dependencies": {
       "winapi": {
        "path": "../w"
       }
      }
     }
    }
   },
   "bun": "same"
  },
  {
   "name": "a cfg expression with parentheses and commas",
   "text": "[target.'cfg(any(unix, windows))'.dependencies]\nlibc = \"0.2\"\n",
   "expected": {
    "target": {
     "cfg(any(unix, windows))": {
      "dependencies": {
       "libc": "0.2"
      }
     }
    }
   },
   "bun": "same"
  },
  {
   "name": "dotted keys at the top and in tables",
   "text": "a.b.c = 1\n[x]\ny.z = \"q\"\n",
   "expected": {
    "a": {
     "b": {
      "c": 1
     }
    },
    "x": {
     "y": {
      "z": "q"
     }
    }
   },
   "bun": "same"
  },
  {
   "name": "dotted keys with spaces",
   "text": "a . b = 1\n",
   "expected": {
    "a": {
     "b": 1
    }
   },
   "bun": "same"
  },
  {
   "name": "dotted keys inside a table",
   "text": "[a]\nb.c = 1\nb.d = 2\n",
   "expected": {
    "a": {
     "b": {
      "c": 1,
      "d": 2
     }
    }
   },
   "bun": "same"
  },
  {
   "name": "integers in every base",
   "text": "i = 1_000\nh = 0xff\no = 0o17\nb = 0b101\nneg = -5\nplus = +3\nz = 0\n",
   "expected": {
    "i": 1000,
    "h": 255,
    "o": 15,
    "b": 5,
    "neg": -5,
    "plus": 3,
    "z": 0
   },
   "bun": "same"
  },
  {
   "name": "floats",
   "text": "a = 3.14\nb = 1e2\nc = -1.5\nd = 6.626e-34\ne = 5e+22\nf = 1_0.5\n",
   "expected": {
    "a": 3.14,
    "b": 100,
    "c": -1.5,
    "d": 6.626e-34,
    "e": 5e+22,
    "f": 10.5
   },
   "bun": "same"
  },
  {
   "name": "a trailing comma in an array",
   "text": "a = [1, 2, 3,]\n",
   "expected": {
    "a": [
     1,
     2,
     3
    ]
   },
   "bun": "same"
  },
  {
   "name": "a multi line array with comments and a trailing comma",
   "text": "features = [\n  \"a\",\n  \"b\", # why\n  \"c\",\n]\n",
   "expected": {
    "features": [
     "a",
     "b",
     "c"
    ]
   },
   "bun": "same"
  },
  {
   "name": "a multi line array without a trailing comma",
   "text": "features = [\n  \"a\",\n  \"b\"\n]\n",
   "expected": {
    "features": [
     "a",
     "b"
    ]
   },
   "bun": "same"
  },
  {
   "name": "empty arrays and tables",
   "text": "a = []\nb = {}\n",
   "expected": {
    "a": [],
    "b": {}
   },
   "bun": "same"
  },
  {
   "name": "arrays of inline tables",
   "text": "c = [ {x=1}, {x=2} ]\n",
   "expected": {
    "c": [
     {
      "x": 1
     },
     {
      "x": 2
     }
    ]
   },
   "bun": "same"
  },
  {
   "name": "nested inline tables",
   "text": "t = { a = 1, b = { c = 2 } }\n",
   "expected": {
    "t": {
     "a": 1,
     "b": {
      "c": 2
     }
    }
   },
   "bun": "same"
  },
  {
   "name": "quoted keys",
   "text": "\"a.b\" = 1\n'c d' = 2\n[ \"e\" . f ]\ng = 3\n",
   "expected": {
    "a.b": 1,
    "c d": 2,
    "e": {
     "f": {
      "g": 3
     }
    }
   },
   "bun": "same"
  },
  {
   "name": "an empty quoted key",
   "text": "\"\" = 1\n",
   "expected": {
    "": 1
   },
   "bun": "same"
  },
  {
   "name": "bare keys with dashes and underscores",
   "text": "a-b_c1 = 1\n",
   "expected": {
    "a-b_c1": 1
   },
   "bun": "same"
  },
  {
   "name": "spaces in a table header and CRLF line ends",
   "text": "[ package ]\r\nname = \"w\"\r\n",
   "expected": {
    "package": {
     "name": "w"
    }
   },
   "bun": "same"
  },
  {
   "name": "comments and a hash inside a string",
   "text": "# c\na = 1 # trailing\nb = \"#notcomment\"\n",
   "expected": {
    "a": 1,
    "b": "#notcomment"
   },
   "bun": "same"
  },
  {
   "name": "booleans",
   "text": "t = true\nf = false\n",
   "expected": {
    "t": true,
    "f": false
   },
   "bun": "same"
  },
  {
   "name": "a workspace with inherited dependencies",
   "text": "[workspace]\nmembers = [\"a\", \"b/*\"]\nexclude = [\"c\"]\n[workspace.dependencies]\nx = { path = \"crates/x\", package = \"real\" }\ny = \"1\"\n",
   "expected": {
    "workspace": {
     "members": [
      "a",
      "b/*"
     ],
     "exclude": [
      "c"
     ],
     "dependencies": {
      "x": {
       "path": "crates/x",
       "package": "real"
      },
      "y": "1"
     }
    }
   },
   "bun": "same"
  },
  {
   "name": "a super table defined after its sub table",
   "text": "[a.b]\nx=1\n[a]\ny=2\n",
   "expected": {
    "a": {
     "b": {
      "x": 1
     },
     "y": 2
    }
   },
   "bun": "same"
  },
  {
   "name": "nested arrays of tables",
   "text": "[[a.b]]\nx=1\n[[a.b]]\nx=2\n",
   "expected": {
    "a": {
     "b": [
      {
       "x": 1
      },
      {
       "x": 2
      }
     ]
    }
   },
   "bun": "same"
  },
  {
   "name": "an array of tables with a sub table",
   "text": "[[a]]\nx=1\n[a.sub]\ny=2\n[[a]]\nx=3\n",
   "expected": {
    "a": [
     {
      "x": 1,
      "sub": {
       "y": 2
      }
     },
     {
      "x": 3
     }
    ]
   },
   "bun": "same"
  },
  {
   "name": "equals signs and brackets inside strings",
   "text": "a = \"x=y\"\nb = '[z]'\n",
   "expected": {
    "a": "x=y",
    "b": "[z]"
   },
   "bun": "same"
  },
  {
   "name": "raw unicode and a four digit escape",
   "text": "k = \"é\"\ns = \"\\u00e9\"\nj = \"日本\"\n",
   "expected": {
    "k": "é",
    "s": "é",
    "j": "日本"
   },
   "bun": "same"
  },
  {
   "name": "common escapes",
   "text": "a = \"q\\\"uote\"\nb = \"l\\nm\"\nc = \"r\\rs\"\nd = \"b\\\\s\"\n",
   "expected": {
    "a": "q\"uote",
    "b": "l\nm",
    "c": "r\rs",
    "d": "b\\s"
   },
   "bun": "same"
  },
  {
   "name": "literal strings keep backslashes",
   "text": "a = 'C:\\path\\n'\n",
   "expected": {
    "a": "C:\\path\\n"
   },
   "bun": "same"
  },
  {
   "name": "a literal multi line string",
   "text": "l = '''raw\\n'''\n",
   "expected": {
    "l": "raw\\n"
   },
   "bun": "same"
  },
  {
   "name": "an empty document",
   "text": "",
   "expected": {},
   "bun": "same"
  },
  {
   "name": "a tab escape",
   "text": "a = \"x\\ty\"\n",
   "expected": {
    "a": "x\ty"
   },
   "bun": "differs"
  },
  {
   "name": "a form feed escape",
   "text": "a = \"x\\fy\"\n",
   "expected": {
    "a": "x\fy"
   },
   "bun": "differs"
  },
  {
   "name": "an eight digit unicode escape",
   "text": "a = \"\\U0001F600\"\n",
   "expected": {
    "a": "😀"
   },
   "bun": "differs"
  },
  {
   "name": "a multi line basic string drops its first newline",
   "text": "s = \"\"\"\nline1\nline2\"\"\"\n",
   "expected": {
    "s": "line1\nline2"
   },
   "bun": "differs"
  },
  {
   "name": "a line ending backslash joins lines",
   "text": "a = \"\"\"x \\\n   y\"\"\"\n",
   "expected": {
    "a": "x y"
   },
   "bun": "differs"
  },
  {
   "name": "nested arrays",
   "text": "b = [[1,2],[\"a\"]]\n",
   "expected": {
    "b": [
     [
      1,
      2
     ],
     [
      "a"
     ]
    ]
   },
   "bun": "refuses"
  },
  {
   "name": "a duplicate key",
   "text": "a = 1\na = 2\n",
   "expected": null,
   "bun": "same"
  },
  {
   "name": "a table defined twice",
   "text": "[a]\nx = 1\n[a]\ny = 2\n",
   "expected": null,
   "bun": "differs"
  },
  {
   "name": "an unterminated string",
   "text": "a = \"x\n",
   "expected": null,
   "bun": "same"
  },
  {
   "name": "a key without a value",
   "text": "a =\n",
   "expected": null,
   "bun": "same"
  },
  {
   "name": "a bare word value",
   "text": "a = nope\n",
   "expected": null,
   "bun": "differs"
  },
  {
   "name": "a missing equals sign",
   "text": "a \"x\"\n",
   "expected": null,
   "bun": "same"
  },
  {
   "name": "an unclosed table header",
   "text": "[a\nx = 1\n",
   "expected": null,
   "bun": "same"
  },
  {
   "name": "an unclosed array",
   "text": "a = [1, 2\n",
   "expected": null,
   "bun": "same"
  },
  {
   "name": "a dotted key redefining a value",
   "text": "a = 1\na.b = 2\n",
   "expected": null,
   "bun": "same"
  },
  {
   "name": "a leading zero integer",
   "text": "a = 01\n",
   "expected": null,
   "bun": "differs"
  }
 ],
 "refusals": [
  {
   "name": "a refused file reports the file, its hash and the parser",
   "text": "a = 1\nb = !\n",
   "line": 1
  }
 ]
}