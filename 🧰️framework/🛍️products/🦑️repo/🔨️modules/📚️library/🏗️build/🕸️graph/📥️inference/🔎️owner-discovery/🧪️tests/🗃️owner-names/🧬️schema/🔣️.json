{
  "type": "object",
  "additionalProperties": false,
  "required": ["owners", "cases"],
  "properties": {
    "owners": { "type": "integer", "minimum": 2 },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "projects", "accepted"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": { "type": "string" },
          "projects": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
