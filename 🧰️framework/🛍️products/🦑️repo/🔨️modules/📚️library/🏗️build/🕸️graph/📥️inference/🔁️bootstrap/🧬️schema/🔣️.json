{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fault",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fault": {
            "enum": [
              "none",
              "missing",
              "not-function",
              "accessor"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "ProjectInputs": {
      "const": [
        "inferProjectInputs",
        "compactSourceInputs",
        "cargoManifestInputV1",
        "cargoLockInput",
        "deduplicateProjectInputs",
        "buildInputPathMatchesV1"
      ]
    }
  }
}
