{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:build:graph-farm:fixture:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "jobs", "plan", "languages", "messages", "runtime", "corpus"],
  "properties": {
    "version": { "const": 1 },
    "jobs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["n", "delay", "value"], "properties": { "n": { "type": "integer", "minimum": 0 }, "delay": { "type": "integer", "minimum": 0 }, "value": { "type": "integer", "minimum": 0 } } } },
    "plan": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["projects", "environment", "cores"], "properties": { "projects": { "type": "integer", "minimum": 0 }, "environment": { "type": "object", "additionalProperties": { "type": "string" } }, "cores": { "type": "integer", "minimum": 1 } } } },
    "languages": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["environment"], "properties": { "environment": { "type": "object", "additionalProperties": { "type": "string" } } } } },
    "messages": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["key", "fields"], "properties": { "key": { "type": "string" }, "fields": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "integer" }] } } } } },
    "runtime": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["runtime", "megabytes"], "properties": { "runtime": { "type": "string" }, "megabytes": { "type": "integer", "minimum": 1 } } } },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closures", "blocks", "projects", "workers", "seeds"],
      "properties": {
        "closures": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["namespace", "text"], "properties": { "namespace": { "enum": ["build-input-closures", "build-lock-closures"] }, "text": { "type": "string" } } } },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "workers": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "seeds": { "type": "array", "items": { "type": "integer" } },
        "projects": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["root", "record", "closures", "blocks", "receipts", "packs"], "properties": {
          "root": { "type": "string" }, "record": { "type": "string" },
          "closures": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "blocks": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "receipts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "text"], "properties": { "name": { "type": "string" }, "text": { "type": "string" } } } },
          "packs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "text"], "properties": { "name": { "type": "string" }, "text": { "type": "string" } } } }
        } } }
      }
    }
  }
}
