{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/schema/late-closures-law.json",
 "type": "object",
 "required": ["version", "entry", "files", "question", "steps"],
 "additionalProperties": false,
 "properties": {
  "version": {"const": 1},
  "entry": {"type": "string"},
  "files": {"type": "object", "additionalProperties": {"type": "string"}},
  "question": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "edit", "reused", "closure", "answer"], "additionalProperties": false, "properties": {
   "name": {"type": "string"}, "edit": {"type": "object", "additionalProperties": {"type": "string"}}, "forget": {"type": "boolean"},
   "reused": {"type": "boolean"}, "closure": {"type": "array", "items": {"type": "string"}}, "answer": {"type": "boolean"}}}}
 }
}
