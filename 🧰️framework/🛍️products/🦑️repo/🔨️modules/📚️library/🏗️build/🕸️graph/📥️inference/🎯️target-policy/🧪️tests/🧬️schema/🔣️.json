{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:target-policy-corpus:v1",
  "title": "Target Policy Corpus",
  "description": "Language-agnostic cases for the target cache policy: names and predicates, class rows, targets with the policy that decides whether they replay, output admission and execution contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "names", "normalize", "uncachedPolicy", "matches", "verify", "classRows", "classes", "classRefusals", "policy", "policies", "outputs", "executions"],
  "definitions": {
    "name": { "type": "string" },
    "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["version", "class", "reason"], "properties": { "version": { "const": 1 }, "class": { "type": "string" }, "reason": { "type": "string" } } },
    "row": { "type": "object", "additionalProperties": false, "required": ["decision"], "properties": { "decision": { "type": "object", "additionalProperties": false, "required": ["class", "reason"], "properties": { "class": { "type": "string" }, "reason": { "type": "string" } } }, "exact": { "type": "array", "items": { "type": "string" } }, "heads": { "type": "array", "items": { "type": "string" } }, "tails": { "type": "array", "items": { "type": "string" } }, "tokens": { "type": "array", "items": { "type": "string" } } } },
    "policy": { "type": "object", "additionalProperties": false, "required": ["continuous", "uncached", "uncachedExact", "cachedExact", "targetClasses"], "properties": { "continuous": { "type": "array", "items": { "type": "string" } }, "uncached": { "type": "array", "items": { "type": "string" } }, "uncachedExact": { "type": "array", "items": { "type": "string" } }, "cachedExact": { "type": "array", "items": { "type": "string" } }, "targetClasses": { "type": "array", "items": { "$ref": "#/definitions/row" } } } }
  },
  "properties": {
    "version": { "const": 1 },
    "names": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "mutating", "live", "uncached", "normalized"], "properties": { "name": { "type": "string" }, "mutating": { "type": "boolean" }, "live": { "type": "boolean" }, "uncached": { "$ref": "#/definitions/pair" }, "normalized": { "type": "string" } } } },
    "normalize": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "bare"], "properties": { "name": { "type": "string" }, "bare": { "type": "string" } } } },
    "uncachedPolicy": { "type": "object", "additionalProperties": false, "required": ["uncached", "uncachedExact"], "properties": { "uncached": { "type": "array", "items": { "type": "string" } }, "uncachedExact": { "type": "array", "items": { "type": "string" } } } },
    "matches": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "matches"], "properties": { "name": { "type": "string" }, "matches": { "type": "boolean" } } } },
    "verify": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["target", "verify"], "properties": { "target": { "type": "object" }, "verify": { "type": "boolean" } } } },
    "classRows": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/row" } },
    "classes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "decision"], "properties": { "name": { "type": "string" }, "decision": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/decision" }] } } } },
    "classRefusals": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "rows", "target", "error"], "properties": { "name": { "type": "string" }, "rows": { "type": "array", "items": { "$ref": "#/definitions/row" } }, "target": { "type": "string" }, "error": { "type": "string", "minLength": 1 } } } },
    "policy": { "$ref": "#/definitions/policy" },
    "policies": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "target", "input"], "oneOf": [{ "required": ["expected"] }, { "required": ["error"] }], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "target": { "type": "string" }, "input": { "type": "object" }, "expected": { "type": "object" }, "error": { "type": "string", "minLength": 1 } } } },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "target", "expected"], "properties": { "name": { "type": "string", "minLength": 1 }, "target": { "type": "object" }, "expected": { "type": "object" } } } },
    "executions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "target"], "oneOf": [{ "required": ["kind"] }, { "required": ["error"] }], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "target": { "type": "object" }, "identity": { "type": "string" }, "kind": { "anyOf": [{ "type": "null" }, { "enum": ["source", "native", "orchestration"] }] }, "error": { "type": "string", "minLength": 1 } } } }
  }
}
