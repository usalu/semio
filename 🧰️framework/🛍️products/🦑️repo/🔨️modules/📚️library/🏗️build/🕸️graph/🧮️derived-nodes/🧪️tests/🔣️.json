      "steps": [
        {
          "name": "whitespace edit of project.json",
          "edit": {
            "a/project.json": "{\n    \"name\": \"a\",\n    \"implicitDependencies\": [\n        \"b\"\n    ],\n    \"namedInputs\": {\n        \"default\": [\n            \"{projectRoot}/src/**/*.ts\",\n            \"!{projectRoot}/src/**/*.test.ts\"\n        ],\n        \"docs\": [\n            \"docs/*.md\"\n        ]\n    },\n    \"targets\": {\n        \"build\": {\n            \"command\": \"tsc -p .\",\n            \"inputs\": [\n                \"default\",\n                \"^default\",\n                \"{projectRoot}/tsconfig.json\"\n            ]\n        },\n        \"test\": {\n            \"command\": \"bun test\",\n            \"inputs\": [\n                \"default\",\n                \"docs\"\n            ]\n        }\n    }\n}\n"
          },
          "expect": {
            "recomputedByKind": {
              "manifest": 1
            },
            "changedByKind": {}
          }
        },
        {
          "name": "comment edit of go.mod",
          "edit": {
            "c/go.mod": "module example.com/c\n\ngo 1.22\n\nrequire (\n\tgithub.com/pkg/errors v0.9.1 // pulled in by errors\n\tgolang.org/x/sync v0.7.0\n)\n\nrequire github.com/a/b v1.0.0\n"
          },
          "expect": {
            "recomputedByKind": {
              "manifest": 1
            },
            "changedByKind": {}
          }
        },
        {
          "name": "touch without change",
          "edit": {},
          "touch": [
            "a/src/index.ts",
            "a/package.json"
          ],
          "expect": {
            "recomputedByKind": {},
            "changedByKind": {}
          }
        },
        {
          "name": "unrelated file inside a project",
          "edit": {
            "a/notes.txt": "scratch 2\n"
          },
          "expect": {
            "recomputedByKind": {},
            "changedByKind": {}
          }
        },
        {
          "name": "excluded test file edit",
          "edit": {
            "a/src/util.test.ts": "test('u2',()=>{});\n"
          },
          "expect": {
            "recomputedByKind": {},
            "changedByKind": {}
          }
        },
        {
          "name": "source body edit",
          "edit": {
            "a/src/index.ts": "export const a = 2;\n"
