        "ts-program": {
          "members": [
            "manifest|a/package.json",
            "action-key|a:build",
            "target-inputs|b:build",
            "manifest|a/tsconfig.json"
          ]
        },
        "rust-crate": {
          "members": [
            "manifest|b/Cargo.toml",
            "named-input|b#rust"
          ]
        }
      },
      "requests": [
        "closure|ts-program",
        "closure|rust-crate",
        "action-key|a:build",
        "action-key|a:test",
        "action-key|b:build",
        "action-key|c:build",
        "action-key|d:build",
        "project|a",
        "project|b",
        "directory-names|a",
        "directory-names|a/src",
        "directory-names|d/src",
        "directory-names|b"
