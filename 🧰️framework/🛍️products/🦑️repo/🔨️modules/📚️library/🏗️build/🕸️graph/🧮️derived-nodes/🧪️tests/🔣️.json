          "edit": {
            "a/project.json": "{\n  \"name\": \"a\",\n  \"implicitDependencies\": [\n    \"b\"\n  ],\n  \"namedInputs\": {\n    \"default\": [\n      \"{projectRoot}/src/**/*.ts\"\n    ],\n    \"docs\": [\n      \"docs/*.md\"\n    ]\n  },\n  \"targets\": {\n    \"build\": {\n      \"command\": \"tsc -p . --noEmit\",\n      \"inputs\": [\n        \"default\",\n        \"^default\",\n        \"{projectRoot}/tsconfig.json\"\n      ]\n    },\n    \"test\": {\n      \"command\": \"bun test\",\n      \"inputs\": [\n        \"default\",\n        \"docs\"\n      ]\n    }\n  }\n}"
