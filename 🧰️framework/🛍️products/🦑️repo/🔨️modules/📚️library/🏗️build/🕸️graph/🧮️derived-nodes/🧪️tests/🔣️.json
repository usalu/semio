      "projects": {
        "a": {
          "manifests": [
            "a/project.json",
            "a/package.json"
          ]
        },
        "b": {
          "manifests": [
            "b/project.json",
            "b/Cargo.toml"
          ]
        },
        "c": {
          "manifests": [
