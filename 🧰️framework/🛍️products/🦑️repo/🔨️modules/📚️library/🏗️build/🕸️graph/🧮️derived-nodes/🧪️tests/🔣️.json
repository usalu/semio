          "edit": {
            "c/go.mod": "module example.com/c\n\ngo 1.22\n\nrequire (\n\tgithub.com/pkg/errors v0.9.1 // indirect\n\tgolang.org/x/sync v0.8.0\n)\n\nrequire github.com/a/b v1.0.0\n"
