{
  "version": 1,
  "scenarios": [
    {
      "id": "workspace",
      "files": {
        "a/project.json": "{\n  \"name\": \"a\",\n  \"implicitDependencies\": [\n    \"b\"\n  ],\n  \"namedInputs\": {\n    \"default\": [\n      \"{projectRoot}/src/**/*.ts\",\n      \"!{projectRoot}/src/**/*.test.ts\"\n    ],\n    \"docs\": [\n      \"docs/*.md\"\n    ]\n  },\n  \"targets\": {\n    \"build\": {\n      \"command\": \"tsc -p .\",\n      \"inputs\": [\n        \"default\",\n        \"^default\",\n        \"{projectRoot}/tsconfig.json\"\n      ]\n    },\n    \"test\": {\n      \"command\": \"bun test\",\n      \"inputs\": [\n        \"default\",\n        \"docs\"\n      ]\n    }\n  }\n}",
        "a/package.json": "{\n  \"name\": \"@x/a\",\n  \"dependencies\": {\n    \"left-pad\": \"1.0.0\",\n    \"b\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"5.0.0\"\n  }\n}",
        "a/tsconfig.json": "{\"compilerOptions\":{}}",
        "a/src/index.ts": "export const a = 1;\n",
        "a/src/util.ts": "export const u = 2;\n",
        "a/src/util.test.ts": "test('u',()=>{});\n",
        "a/docs/readme.md": "# a\n",
        "a/notes.txt": "scratch\n",
        "b/project.json": "{\n  \"name\": \"b\",\n  \"namedInputs\": {\n    \"rust\": [\n      \"src/**/*.rs\",\n      \"Cargo.toml\"\n    ]\n  },\n  \"targets\": {\n    \"build\": {\n      \"command\": \"cargo build\",\n      \"inputs\": [\n        \"rust\"\n      ]\n    }\n  }\n}",
        "b/Cargo.toml": "# crate b\n[package]\nname = \"b\"\nversion = \"0.1.0\"\n\n[dependencies]\nserde = { version = \"1\", features = [\"derive\", \"alloc\"] }\nanyhow = \"1.0\"\nlocal.path = \"../local\"\ntokio = { version = \"1\", features = [\n    \"rt\", # runtime\n    \"macros\",\n  ] }\n\n[dev-dependencies]\ncriterion = \"0.5\"\n\n[target.'cfg(unix)'.dependencies]\nlibc = \"0.2\"\n\n[[bin]]\nname = \"b\"\n",
        "b/src/lib.rs": "pub fn b() {}\n",
        "c/project.json": "{\n  \"name\": \"c\",\n  \"targets\": {\n    \"build\": {\n      \"command\": \"go build ./...\",\n      \"inputs\": [\n        \"**/*.go\"\n      ]\n    }\n  }\n}",
        "c/go.mod": "module example.com/c\n\ngo 1.22\n\nrequire (\n\tgithub.com/pkg/errors v0.9.1 // indirect\n\tgolang.org/x/sync v0.7.0\n)\n\nrequire github.com/a/b v1.0.0\n",
        "c/main.go": "package main\n",
        "d/📋️project.json": "{\"name\": \"d\", \"namedInputs\": {\"all\": [\"src/*.ts\"], \"ws\": [\"all\", \"{workspaceRoot}/README.md\", {\"env\": \"X\"}]}, \"targets\": {\"build\": {\"options\": {\"command\": \"tsc\"}, \"inputs\": [\"ws\", {\"env\": \"Y\"}]}}}",
        "d/src/😀.ts": "export {};\n",
        "d/src/ｚ.ts": "export {};\n",
        "d/src/a.ts": "export {};\n",
        "README.md": "workspace\n"
