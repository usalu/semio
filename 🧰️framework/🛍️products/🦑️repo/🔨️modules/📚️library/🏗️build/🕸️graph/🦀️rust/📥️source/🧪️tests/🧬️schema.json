{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/rust/selected-source-test/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "files",
    "failures",
    "rosters"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "changed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]+\\.rs$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "changed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "failures": {
      "const": [
        "stale",
        "ancestor",
        "copied",
        "retired"
      ]
    },
    "rosters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object"
            }
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
