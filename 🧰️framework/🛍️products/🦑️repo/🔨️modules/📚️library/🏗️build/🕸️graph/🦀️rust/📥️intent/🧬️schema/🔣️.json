{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Selected Cargo Build Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifest",
    "package",
    "scope"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 10,
      "maxLength": 256,
      "pattern": "^(?!(?:/|[A-Za-z]:))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\u0000-\\u0020])(?:[^/]+/)*Cargo\\.toml$"
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$(?![\\s\\S])"
    },
    "scope": {
      "enum": [
        "package",
        "library",
        "binary"
      ]
    },
    "binary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$(?![\\s\\S])"
    },
    "sourcesRecord": {
      "description": "🧾️ The file the build publishes beside the binary, in the same atomic publication: every source Cargo compiled it from (its own dep-info) and when that build started (`semio.cargo.binary-sources/v1`). Only a binary deliverable has one.",
      "type": "string",
      "minLength": 14,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*\\.sources\\.json(?![\\s\\S])"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./?-]*$(?![\\s\\S])"
      }
    },
    "defaultFeatures": {
      "type": "boolean"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$(?![\\s\\S])"
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "adapters"
      ],
      "properties": {
        "kind": {
          "const": "bounded-cargo"
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "foreign-source",
              "binary",
              "proc-macro",
              "build-script",
              "build-script-run",
              "effective-profile"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "binary"
          }
        }
      },
      "then": {
        "required": [
          "binary"
        ],
        "properties": {
          "binary": {},
          "sourcesRecord": {}
        }
      },
      "else": {
        "properties": {
          "binary": false,
          "sourcesRecord": false
        }
      }
    }
  ]
}
