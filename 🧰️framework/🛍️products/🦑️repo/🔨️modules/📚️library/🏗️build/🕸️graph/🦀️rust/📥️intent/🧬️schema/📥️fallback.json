{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "title":"Selected Rust Bounded Fallback Decision",
 "type":"object",
 "additionalProperties":false,
 "required":["version","intentDigest","adapters"],
 "properties":{
  "version":{"const":1},
  "intentDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "adapters":{"type":"array","minItems":1,"maxItems":6,"uniqueItems":true,"items":{"enum":["foreign-source","binary","proc-macro","build-script","build-script-run","effective-profile"]}}
 }
}
