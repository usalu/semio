{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/rust/selected-source-inputs/v1",
  "type": "array",
  "maxItems": 65536,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "digest",
      "bytes"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:\\u0000-\\u001f]).+$"
      },
      "digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "bytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  }
}
