    { "name": "more outermost directories than the limit fall back to the whole workspace", "moves": [["a/Cargo.toml", "b/Cargo.toml"], ["c/Cargo.toml", "d/Cargo.toml"], ["e/Cargo.toml", "f/Cargo.toml"]], "limit": 5, "scopes": ["."] },
