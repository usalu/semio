{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Graph generation store",
 "definitions": {
  "Identity": {
   "const": "graph-generations-v3"
  },
  "Policy": {
   "const": {
    "version": 1,
    "pointer": "current.json",
    "manifests": "m",
    "fragments": "o",
    "indexes": "x",
    "frontiers": "f",
    "envOwner": "@env",
    "policies": [
     "fresh",
     "current"
    ],
    "retainGenerations": 4,
    "graceMilliseconds": 600000,
    "verifyChunkRows": 4096,
    "verifyParallelChunks": 4,
    "bisectBudgetCalls": 64,
    "racyMilliseconds": 2000,
    "readConcurrency": 32,
    "publishWaitMilliseconds": 30000,
    "pollMaximumMilliseconds": 250,
    "maximumOwners": 65536,
    "maximumManifestBytes": 134217728,
    "maximumFragmentBytes": 67108864,
    "maximumIndexBytes": 536870912,
    "compactionFactor": 2,
    "compactionFloor": 1024,
    "brotliQuality": 5,
    "brotliWindow": 22,
    "reasonRows": 16
   }
  },
  "Messages": {
   "const": {
    "en": {
     "current": "graph: serving generation {generation} without verification (graph policy current)",
     "verified": "graph: generation {generation} verified, {checked} facts checked",
     "waiting": "graph: waiting for the graph build of a peer to finish",
     "building": "graph: refreshing {dirty} projects (generation {generation})",
     "published": "graph: generation {generation} published, {computed} projects refreshed in {seconds} s",
     "closure": "graph: {count} projects of the closure verified, no other project read",
     "cold": "graph: no usable generation ({reason}), building the first one",
     "stale": "graph: serving generation {generation} built by another implementation (graph policy current)",
     "reason": "graph: {project} is stale: {why}",
     "reasonStamp": "the inference protocol of {inferrer} changed from {recorded} to {current}",
     "reasonInput": "the input file {path} changed",
     "reasonListing": "the entries of the directory {path} changed",
     "reasonData": "the declared data file {path} changed",
     "reasonAnalysis": "the source analysis of {path} changed",
     "reasonFact": "the recorded {kind} fact of {path} changed",
     "reasonMembership": "the workspace file {path} was {change}",
     "reasonMore": "graph: {count} more stale inputs are not listed",
     "withheldDependency": "graph: {project} is withheld: {source} depends on projects that this graph snapshot does not contain ({target}), created or removed while the graph was built; run the command again to include them, or remove them from the native sources of {project}",
     "withheldSource": "graph: {project} is withheld: {source} does not parse (sha256 {sha}); fix that file and run the command again",
     "changeAdded": "added",
     "changeRemoved": "removed",
     "changeChanged": "changed"
    },
    "de": {
     "current": "Graph: Generation {generation} wird ohne Prüfung geliefert (Graph-Richtlinie current)",
     "verified": "Graph: Generation {generation} geprüft, {checked} Fakten kontrolliert",
     "waiting": "Graph: wartet auf den Graph-Aufbau eines anderen Prozesses",
     "building": "Graph: {dirty} Projekte werden erneuert (Generation {generation})",
     "published": "Graph: Generation {generation} veröffentlicht, {computed} Projekte in {seconds} s erneuert",
     "closure": "Graph: {count} Projekte der Hülle geprüft, kein weiteres Projekt gelesen",
     "cold": "Graph: keine brauchbare Generation ({reason}), die erste wird aufgebaut",
     "stale": "Graph: Generation {generation} stammt von einer anderen Implementierung und wird geliefert (Graph-Richtlinie current)",
     "reason": "Graph: {project} ist veraltet: {why}",
     "reasonStamp": "das Inferenzprotokoll von {inferrer} wechselte von {recorded} zu {current}",
     "reasonInput": "die Eingabedatei {path} hat sich geändert",
     "reasonListing": "die Einträge des Verzeichnisses {path} haben sich geändert",
     "reasonData": "die deklarierte Datendatei {path} hat sich geändert",
     "reasonAnalysis": "die Quellanalyse von {path} hat sich geändert",
     "reasonFact": "der aufgezeichnete Fakt {kind} von {path} hat sich geändert",
     "reasonMembership": "die Arbeitsbereichsdatei {path} wurde {change}",
     "reasonMore": "Graph: {count} weitere veraltete Eingaben werden nicht aufgelistet",
     "withheldDependency": "Graph: {project} wird zurückgehalten: {source} hängt von Projekten ab, die dieser Graph-Schnappschuss nicht enthält ({target}); sie wurden während des Graph-Aufbaus angelegt oder entfernt; den Befehl erneut ausführen, um sie aufzunehmen, oder sie aus den nativen Quellen von {project} entfernen",
     "withheldSource": "Graph: {project} wird zurückgehalten: {source} lässt sich nicht lesen (sha256 {sha}); die Datei korrigieren und den Befehl erneut ausführen",
     "changeAdded": "hinzugefügt",
     "changeRemoved": "entfernt",
     "changeChanged": "geändert"
    }
   }
  },
  "Hex": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "Pointer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "generation",
    "manifest",
    "parent"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "generation": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "manifest": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "parent": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    }
   }
  },
  "OwnerRow": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "root",
    "kind",
    "fragment",
    "bytes",
    "edgesEnv",
    "targets"
   ],
   "properties": {
    "root": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "kind": {
     "enum": [
      "project",
      "unavailable"
     ]
    },
    "fragment": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 67108864
    },
    "edgesEnv": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "targets": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "config": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "nativeRoot": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "tag": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    }
   }
  },
  "Manifest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "generation",
    "parent",
    "identity",
    "implementation",
    "env",
    "membership",
    "frontier",
    "factIndex",
    "global",
    "owners",
    "built"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "generation": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "parent": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "identity": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "implementation": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "env": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "membership": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "frontier": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "factIndex": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "global": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "owners": {
     "type": "object",
     "maxProperties": 65536,
     "additionalProperties": {
      "$ref": "#/definitions/OwnerRow"
     }
    },
    "built": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "base",
      "dirty"
     ],
     "properties": {
      "kind": {
       "enum": [
        "cold",
        "delta",
        "refresh"
       ]
      },
      "base": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "maximum": 9007199254740991
        },
        {
         "type": "null"
        }
       ]
      },
      "dirty": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "Fragment": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "name",
    "root",
    "kind",
    "node",
    "edges",
    "edgesEnv",
    "targets"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "root": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "kind": {
     "enum": [
      "project",
      "unavailable"
     ]
    },
    "node": {},
    "edges": {
     "type": "array"
    },
    "edgesEnv": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "targets": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "config": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "nativeRoot": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    }
   }
  },
  "Row": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "path",
    "fact"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "minLength": 1
    },
    "path": {
     "type": "string"
    },
    "fact": {}
   }
  },
  "FactClass": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "r",
    "o"
   ],
   "properties": {
    "r": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     }
    },
    "o": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     }
    }
   }
  },
  "FactIndex": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "owners",
    "rows",
    "classes"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "owners": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "rows": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/Row"
     }
    },
    "classes": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/FactClass"
     }
    }
   }
  },
  "Frontier": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "capturedAt",
    "directories",
    "members"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "capturedAt": {
     "type": "number"
    },
    "directories": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
     }
    },
    "members": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
     }
    }
   }
  },
  "DocumentByteLimit": {
   "type": "integer",
   "minimum": 1,
   "maximum": 536870912
  }
 }
}
