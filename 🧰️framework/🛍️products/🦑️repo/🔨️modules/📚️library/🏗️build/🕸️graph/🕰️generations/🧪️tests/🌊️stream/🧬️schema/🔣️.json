{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Graph assembly corpus V1",
 "type": "object",
 "additionalProperties": false,
 "required": ["version", "owners", "global", "cases", "expect"],
 "properties": {
  "version": {"const": 1},
  "owners": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Owner"}},
  "global": {
   "type": "object",
   "additionalProperties": false,
   "required": ["externalNodes", "edges", "unavailable"],
   "properties": {
    "externalNodes": {"type": "object"},
    "edges": {"type": "array", "items": {"$ref": "#/definitions/Edge"}},
    "unavailable": {"type": "array", "items": {"type": "object", "required": ["root"]}}
   }
  },
  "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "names"], "properties": {"name": {"type": "string"}, "names": {"type": ["array", "null"], "items": {"type": "string"}}}}},
  "expect": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Expectation"}}
 },
 "definitions": {
  "Edge": {"type": "object", "required": ["source", "target"], "properties": {"source": {"type": "string"}, "target": {"type": "string"}, "type": {"type": "string"}}},
  "Owner": {"type": "object", "additionalProperties": false, "required": ["name", "root", "kind", "node", "edges"], "properties": {"name": {"type": "string"}, "root": {"type": "string"}, "kind": {"enum": ["project", "unavailable"]}, "node": {"type": "object"}, "edges": {"type": "array", "items": {"$ref": "#/definitions/Edge"}}}},
  "Expectation": {"type": "object", "additionalProperties": false, "required": ["projects", "dependencies", "externalNodes", "unavailable"], "properties": {"projects": {"type": "object"}, "dependencies": {"type": "array", "items": {"$ref": "#/definitions/Edge"}}, "externalNodes": {"type": "object"}, "unavailable": {"type": "array", "items": {"type": "object", "required": ["root"]}}}}
 }
}
