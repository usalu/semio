{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "graph-generation-exchange-v1",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "domain": "semio.graph-generation.v1",
        "document": "^(?:m/[0-9a-f]{64}\\.json|o/[0-9a-f]{64}\\.json\\.br|x/[0-9a-f]{64}\\.facts\\.br|f/[0-9a-f]{64}\\.json\\.br)$",
        "maximumDocuments": 20000,
        "maximumDocumentBytes": 536870912,
        "concurrency": 8,
        "probeTimeoutSeconds": 5,
        "probeRetries": 1
      }
    },
    "Note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generation", "owners", "identity", "manifest"],
      "properties": {
        "version": { "const": 1 },
        "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "owners": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "identity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manifest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
