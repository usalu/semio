{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["affected", "retained", "cases"],
  "additionalProperties": false,
  "properties": {
    "affected": {"type": "integer", "minimum": 49},
    "retained": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3,
      "items": {"enum": ["unchanged", "missing at patch", "altered at patch"]}
    }
  }
}
