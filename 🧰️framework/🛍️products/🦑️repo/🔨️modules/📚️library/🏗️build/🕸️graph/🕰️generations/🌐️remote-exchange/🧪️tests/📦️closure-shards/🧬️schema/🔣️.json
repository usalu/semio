{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["fragments", "uniqueClosures", "ownerLinks", "actionBytesCeiling", "shards", "cases"],
  "properties": {
    "fragments": {"type": "integer", "minimum": 2},
    "uniqueClosures": {"type": "integer", "minimum": 20001},
    "ownerLinks": {"type": "integer", "minimum": 20001},
    "actionBytesCeiling": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "shards": {"type": "integer", "minimum": 2},
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "head"],
        "properties": {
          "condition": {"enum": ["missing shard", "omitted shard", "missing leaf", "complete"]},
          "head": {"enum": ["incomplete", "restored"]}
        }
      }
    }
  }
}
