{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"array",
  "minItems":1,
  "items":{
    "type":"object",
    "additionalProperties":false,
    "required":["name","defect"],
    "properties":{
      "name":{"type":"string"},
      "defect":{"enum":["none","size","manifest","abort"]}
    }
  }
}
