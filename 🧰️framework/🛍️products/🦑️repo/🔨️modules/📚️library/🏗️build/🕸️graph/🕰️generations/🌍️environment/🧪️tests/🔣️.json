   "name": "project without name",
   "text": "{\"targets\":{}}"
  },
  {
   "expected": {
    "error": "parse"
   },
   "extractor": "project-json",
   "name": "project not json",
   "text": "{"
  },
  {
   "expected": null,
   "extractor": "package-json",
   "name": "missing manifest",
   "text": null
  },
  {
   "expected": {
    "name": "@x/y"
   },
   "extractor": "package-json",
   "name": "package name",
   "text": "{\"name\":\"@x/y\",\"dependencies\":{\"z\":\"1\"}}"
  },
  {
   "expected": {
    "name": null
   },
   "extractor": "package-json",
   "name": "package without name",
   "text": "{\"private\":true}"
  },
  {
   "expected": {
    "module": "example.com/x"
   },
   "extractor": "go-mod",
   "name": "go module",
   "text": "module example.com/x\n\ngo 1.22\n"
  },
  {
   "expected": {
    "module": "example.com/y"
   },
   "extractor": "go-mod",
   "name": "go module after a comment",
   "text": "// header\nmodule example.com/y\nrequire a v1\n"
  },
  {
   "expected": {
    "module": null
   },
   "extractor": "go-mod",
   "name": "go without module",
   "text": "go 1.22\n"
  },
  {
   "expected": {
    "name": "my-crate"
   },
   "extractor": "cargo-package",
   "name": "crate",
   "text": "[package]\nname = \"my-crate\"\nversion = \"0.1.0\"\n"
  },
  {
   "expected": {
    "name": "later"
   },
   "extractor": "cargo-package",
   "name": "crate after dependencies",
   "text": "[dependencies]\nserde = \"1\"\n\n[package]\nname = \"later\"\n"
  },
  {
   "expected": {
    "name": "meta"
   },
   "extractor": "cargo-package",
   "name": "crate with metadata table",
   "text": "[package]\nversion = \"1\"\nname = \"meta\"\n\n[package.metadata]\nname = \"not-this\"\n"
  },
  {
   "expected": {
    "name": "new"
   },
   "extractor": "cargo-package",
   "name": "crate with commented name",
   "text": "[package]\n# name = \"old\"\nname = \"new\"\n"
  },
  {
   "expected": {
    "name": "literal"
   },
   "extractor": "cargo-package",
   "name": "crate with literal string",
   "text": "[package]\nname = 'literal'\n"
  },
  {
   "expected": {
    "name": "crlf"
   },
   "extractor": "cargo-package",
   "name": "crate with windows line endings",
   "text": "[package]\r\nname = \"crlf\"\r\nversion = \"1\"\r\n"
  },
  {
   "expected": {
    "name": null
   },
   "extractor": "cargo-package",
   "name": "workspace manifest without package",
   "text": "[workspace]\nmembers = [\"a\"]\n"
  }
 ],
