{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "emptyDigest",
    "cases",
    "laws"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "emptyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "projects",
          "configs",
          "digests",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "projects": {
            "description": "The inventory of the graph snapshot: project name to the part of the project the withholding reads.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root"
              ],
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "targets": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "inputs"
                    ],
                    "properties": {
                      "inputs": {
                        "type": "array"
                      }
                    }
                  }
                }
              }
            }
          },
          "configs": {
            "description": "Declaring file of a project by name.",
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "digests": {
            "description": "Digest of the bytes of a file; a file that is absent has the digest of no bytes.",
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dangling",
              "withheld",
              "remaining",
              "unavailable",
              "text"
            ],
            "properties": {
              "dangling": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "root",
                    "missing"
                  ],
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "root": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "withheld": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "remaining": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unavailable": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "root",
                    "project",
                    "source",
                    "sha256",
                    "reason",
                    "missing"
                  ],
                  "properties": {
                    "root": {
                      "type": "string"
                    },
                    "project": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "text": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "en",
                    "de"
                  ],
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "de": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "laws": {
      "description": "Ordered text laws of the graph assembly source: inside the function between `start` and `end`, `before` occurs before `after`, each exactly where it is searched.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start",
          "end",
          "before",
          "after"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "minLength": 1
          },
          "end": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
