{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:report-name-corpus:v1",
  "title": "Build Report Name Corpus",
  "description": "Language-agnostic cases for admitting a declared build report name: literal names, a length sweep of one repeated character and values that are not strings. `maximumAccepted` is the longest accepted whole name in characters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "names", "lengths", "notStrings"],
  "properties": {
    "version": { "const": 1 },
    "names": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "accepted"], "properties": { "name": { "type": "string" }, "accepted": { "type": "boolean" } } } },
    "lengths": { "type": "object", "additionalProperties": false, "required": ["stem", "from", "to", "maximumAccepted"], "properties": { "stem": { "type": "string", "minLength": 1, "maxLength": 1 }, "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 }, "maximumAccepted": { "type": "integer", "minimum": 1 } } },
    "notStrings": { "type": "array", "minItems": 1 }
  }
}
