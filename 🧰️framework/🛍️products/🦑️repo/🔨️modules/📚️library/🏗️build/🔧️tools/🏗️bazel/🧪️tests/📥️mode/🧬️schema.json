{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "graphs",
    "cases",
    "authority",
    "refusals",
    "authorized"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "graphs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "undeclared",
        "pinned",
        "partial"
      ],
      "properties": {
        "declared": {
          "type": "object"
        },
        "undeclared": {
          "type": "object"
        },
        "pinned": {
          "type": "object"
        },
        "partial": {
          "type": "object"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "graph",
          "request",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "graph": {
            "enum": [
              "declared",
              "undeclared",
              "pinned",
              "partial"
            ]
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tasks"
            ],
            "properties": {
              "tasks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]+:[a-z]+(:[a-z]+)?$"
                }
              },
              "configuration": {
                "type": "string"
              },
              "authority": {
                "enum": [
                  "prototype",
                  "release"
                ]
              }
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selected",
                  "tasks"
                ],
                "properties": {
                  "selected": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/definitions/TaskId"
                    }
                  },
                  "tasks": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "$ref": "#/definitions/TaskId"
                    },
                    "additionalProperties": {
                      "enum": [
                        "prototype",
                        "release",
                        null
                      ]
                    }
                  },
                  "inheritedMode": {
                    "enum": [
                      "prototype",
                      "release"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "refused"
                ],
                "properties": {
                  "refused": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            ]
          }
        }
      }
    },
    "authority": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "configuration",
          "caller",
          "refused"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "configuration": {
            "type": [
              "string",
              "null"
            ]
          },
          "caller": {
            "enum": [
              "prototype",
              "release"
            ]
          },
          "refused": {
            "type": "boolean"
          }
        }
      }
    },
    "refusals": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "minLength": 10
      }
    },
    "authorized": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "graph",
          "caller",
          "tasks",
          "selected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "graph": {
            "enum": [
              "declared",
              "undeclared"
            ]
          },
          "caller": {
            "enum": [
              "prototype",
              "release"
            ]
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "selected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/TaskId"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TaskId": {
      "type": "string",
      "pattern": "^[a-z]+:[a-z]+(:(prototype|release|staging))?$"
    }
  }
}
