{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Bazel Cargo Action Contract",
 "type": "object",
 "additionalProperties": false,
 "definitions": {
  "Policy": {
   "const": {
    "version": 1,
    "launcher": {
     "command": "cargo",
     "store": "shared",
     "delimiter": "--",
     "parallelism": 1
    },
    "subcommands": [
     "check",
     "build",
     "test"
    ],
    "selections": [
     "--lib",
     "--bins",
     "--tests",
     "--all-targets"
    ],
    "messageFormat": "--message-format=json-render-diagnostics",
    "nativeCommand": "^repo (?:\"[^\"]+\"|\\S+) native cargo (check|build|test) --manifest (\"[^\"]+\"|\\S+)$",
    "componentCommand": "^repo (?:\"[^\"]+\"|\\S+) component --manifest (\"[^\"]+\"|\\S+)$",
    "toolchain": {
     "file": "rust-toolchain.toml",
     "manifest": "lib/rustlib/multirust-channel-manifest.toml",
     "hosts": {
      "darwin-arm64": "aarch64-apple-darwin",
      "darwin-x64": "x86_64-apple-darwin",
      "linux-arm64": "aarch64-unknown-linux-gnu",
      "linux-x64": "x86_64-unknown-linux-gnu",
      "win32-x64": "x86_64-pc-windows-msvc"
     }
    },
    "exclusive": {
     "cpu": 1024
    }
   }
  },
  "Action": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "id",
    "subcommand",
    "manifest",
    "package",
    "selection",
    "configuration",
    "toolchain",
    "artifacts"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 512
    },
    "subcommand": {
     "enum": [
      "check",
      "build",
      "test"
     ]
    },
    "manifest": {
     "type": "string",
     "pattern": "^[^/\\\\\\u0000][^\\\\\\u0000]*$"
    },
    "package": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]+$"
    },
    "selection": {
     "enum": [
      "--lib",
      "--bins",
      "--tests",
      "--all-targets"
     ]
    },
    "target": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "configuration": {
     "enum": [
      "prototype",
      "release"
     ]
    },
    "features": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_/.-]+$"
     }
    },
    "toolchain": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
     "enum": [
      "none",
      "files"
     ]
    },
    "suffixes": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^\\.[a-z0-9]+$"
     }
    }
   }
  },
  "Manifest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "id",
    "package",
    "toolchain",
    "argv",
    "artifacts",
    "suffixes"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "id": {
     "type": "string"
    },
    "package": {
     "type": "string"
    },
    "argv": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 8
    },
    "artifacts": {
     "enum": [
      "none",
      "files"
     ]
    },
    "suffixes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "toolchain": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  },
  "Message": {
   "type": "object",
   "required": [
    "reason"
   ],
   "properties": {
    "reason": {
     "type": "string"
    }
   }
  }
 }
}
