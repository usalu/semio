{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:bazel-witness-corpus:v1",
  "title": "Bazel Input Witness Corpus",
  "description": "Language-agnostic cases for the input witness: declared files and the digest document the witness must contain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "files", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "content"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "pattern": "^[^\\n\\\\]+$" },
                "content": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string" } } }, { "type": "object", "additionalProperties": false, "required": ["repeat", "times"], "properties": { "repeat": { "type": "string", "minLength": 1 }, "times": { "type": "integer", "minimum": 1, "maximum": 1000000 } } }] }
              }
            }
          },
          "expected": { "type": "object", "additionalProperties": false, "required": ["version", "files", "sha256"], "properties": { "version": { "const": 1 }, "files": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
        }
      }
    }
  }
}
