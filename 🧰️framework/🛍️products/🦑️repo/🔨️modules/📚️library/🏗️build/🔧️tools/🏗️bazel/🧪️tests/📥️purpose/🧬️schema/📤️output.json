{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {
        "maximumBytes": 65536,
        "maximumLines": 256,
        "readChunkBytes": 65536,
        "variants": [
          "parity-nx",
          "parity-bazel"
        ]
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "variant",
        "wireSha256",
        "policy",
        "deadlineEpochMilliseconds",
        "capabilities"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "variant": {
          "enum": [
            "parity-nx",
            "parity-bazel"
          ]
        },
        "wireSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy": {
          "type": "object"
        },
        "deadlineEpochMilliseconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "capabilities": {
          "type": "object"
        }
      }
    },
    "Cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "accepted"
        ],
        "properties": {
          "kind": {
            "enum": [
              "valid",
              "oversize",
              "excess-lines",
              "foreign-variant"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
