{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaults",
    "caller",
    "cases",
    "literal",
    "bailCases"
  ],
  "properties": {
    "defaults": {
      "$ref": "#/definitions/Arguments"
    },
    "caller": {
      "$ref": "#/definitions/Arguments"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "forwardAllArgs",
          "commands",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "forwardAllArgs": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command",
                    "forwardAllArgs"
                  ],
                  "properties": {
                    "command": {
                      "type": "string"
                    },
                    "forwardAllArgs": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "expected": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Arguments"
            }
          }
        }
      }
    },
    "literal": {
      "$ref": "#/definitions/Arguments"
    },
    "bailCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected"
        ],
        "properties": {
          "bail": {
            "type": "boolean"
          },
          "expected": {
            "$ref": "#/definitions/Arguments"
          }
        }
      }
    }
  },
  "definitions": {
    "Arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
