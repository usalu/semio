{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bazel session slots fixture",
  "description": "Language-agnostic rows of the session slot laws. `plans`: host and memory floor to the server plan; `ranks`: slot states and a key to the slot order; `garbage`: inventory to what is collected; `restore`: snapshot roots to hierarchical lease resources; `messages`: rendered progress lines in English and German. Every expected value was computed by an independent Python implementation (`mkfixture.py`), never by the code under test.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plans", "ranks", "garbage", "restore", "restoreRefused", "messages", "workspaces", "languages", "overrides"],
  "properties": {
    "version": {"const": 1},
    "plans": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "host", "memory", "expected"], "properties": {"name": {"type": "string"}, "host": {"$ref": "sessions.json#/definitions/Host"}, "memory": {"$ref": "sessions.json#/definitions/MemoryPolicy"}, "expected": {"$ref": "sessions.json#/definitions/ServerPlan"}}}},
    "ranks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "slots", "states", "key", "expected"], "properties": {"name": {"type": "string"}, "slots": {"type": "array", "items": {"$ref": "sessions.json#/definitions/Slot"}}, "states": {"type": "object", "additionalProperties": {"$ref": "sessions.json#/definitions/SlotState"}}, "key": {"$ref": "sessions.json#/definitions/Key"}, "expected": {"type": "array", "items": {"$ref": "sessions.json#/definitions/Slot"}}}}},
    "garbage": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "slots", "services", "now", "held", "inventory", "expected"], "properties": {"name": {"type": "string"}, "slots": {"type": "integer", "minimum": 1}, "services": {"type": "integer", "minimum": 1}, "now": {"type": "integer"}, "held": {"type": "array", "items": {"$ref": "sessions.json#/definitions/Slot"}}, "inventory": {"$ref": "sessions.json#/definitions/Inventory"}, "expected": {"$ref": "sessions.json#/definitions/Garbage"}}}},
    "restore": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "roots", "expected"], "properties": {"name": {"type": "string"}, "roots": {"type": "array", "items": {"type": "string"}}, "expected": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["resource", "mode"], "properties": {"resource": {"type": "string"}, "mode": {"enum": ["shared", "exclusive"]}}}}}}},
    "restoreRefused": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "roots"], "properties": {"name": {"type": "string"}, "roots": {"type": "array", "items": {"type": "string"}}}}},
    "messages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "values", "en", "de"], "properties": {"id": {"type": "string"}, "values": {"type": "object", "additionalProperties": {"anyOf": [{"type": "string"}, {"type": "integer"}]}}, "en": {"type": "string"}, "de": {"type": "string"}}}},
    "workspaces": {"type": "object", "additionalProperties": false, "required": ["root", "accepted", "refused"], "properties": {"root": {"type": "string"}, "accepted": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["slot", "key", "path"], "properties": {"slot": {"type": "string"}, "key": {"type": "string"}, "path": {"type": "string"}}}}, "refused": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["slot", "key"], "properties": {"slot": {"type": "string"}, "key": {"type": "string"}}}}}},
    "languages": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["environment", "expected"], "properties": {"environment": {"type": "object", "additionalProperties": {"type": "string"}}, "expected": {"enum": ["en", "de", null]}}}},
    "overrides": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["environment", "slots"], "properties": {"environment": {"type": "object", "additionalProperties": {"type": "string"}}, "slots": {"anyOf": [{"type": "integer"}, {"type": "string"}, {"type": "null"}]}}}}
  }
}
