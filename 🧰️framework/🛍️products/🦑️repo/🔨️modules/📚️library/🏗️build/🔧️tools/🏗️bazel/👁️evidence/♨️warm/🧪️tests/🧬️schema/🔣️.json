{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:bazel-warm-verdicts-corpus:v1",
  "title": "Bazel Warm Verdicts Corpus",
  "description": "Language-agnostic cases for attributing a warm Bazel run: the cold and the warm execution-log spawns in, one verdict per warm action out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cold", "warm", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "cold": { "type": "array", "items": { "$ref": "#/definitions/Spawn" } },
          "warm": { "type": "array", "items": { "$ref": "#/definitions/Spawn" } },
          "expected": { "type": "array", "items": { "$ref": "#/definitions/Verdict" } }
        }
      }
    }
  },
  "definitions": {
    "Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash"],
      "properties": { "hash": { "type": "string", "minLength": 1 } }
    },
    "Spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetLabel", "mnemonic", "runner", "cacheHit", "cacheable", "commandArgs", "environmentVariables", "inputs", "actualOutputs"],
      "properties": {
        "targetLabel": { "type": "string", "pattern": "^//:" },
        "mnemonic": { "type": "string" },
        "runner": { "type": "string" },
        "cacheHit": { "type": "boolean" },
        "cacheable": { "type": "boolean" },
        "commandArgs": { "type": "array", "items": { "type": "string" } },
        "environmentVariables": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "type": "string" }, "value": { "type": "string" } } }
        },
        "inputs": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "type": "string" }, "digest": { "$ref": "#/definitions/Digest" } } }
        },
        "actualOutputs": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "type": "string" }, "digest": { "$ref": "#/definitions/Digest" } } }
        }
      }
    },
    "Verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "verdict", "changedInputs", "addedInputs", "removedInputs", "argumentsChanged", "environmentChanged", "outputsIdentical", "derivedInputsChanged", "sourceInputsChanged"],
      "properties": {
        "label": { "type": "string" },
        "verdict": { "enum": ["hit", "uncached", "new", "key-changed", "executed-with-stable-key"] },
        "changedInputs": { "type": "array", "items": { "type": "string" } },
        "addedInputs": { "type": "array", "items": { "type": "string" } },
        "removedInputs": { "type": "array", "items": { "type": "string" } },
        "argumentsChanged": { "type": "boolean" },
        "environmentChanged": { "type": "array", "items": { "type": "string" } },
        "outputsIdentical": { "type": ["boolean", "null"] },
        "derivedInputsChanged": { "type": "boolean" },
        "sourceInputsChanged": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
