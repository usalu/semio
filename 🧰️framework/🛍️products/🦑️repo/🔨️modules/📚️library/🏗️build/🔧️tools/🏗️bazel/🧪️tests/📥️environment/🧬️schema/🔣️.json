{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "cases", "maximumChildMilliseconds"],
  "properties": {
    "version": {"const": 1},
    "maximumChildMilliseconds": {"const": 120000},
    "cases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "root", "inheritedRoot"],
        "properties": {
          "name": {"enum": ["absent-root", "foreign-root", "windows-root"]},
          "root": {"type": "string", "minLength": 1, "maxLength": 256},
          "inheritedRoot": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]}
        }
      }
    }
  }
}
