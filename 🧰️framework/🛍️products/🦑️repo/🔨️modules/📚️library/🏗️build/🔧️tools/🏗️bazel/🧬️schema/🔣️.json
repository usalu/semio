{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasks",
    "selected"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "project",
          "target",
          "label",
          "dependencies",
          "args"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "configuration": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "pattern": "^t_[a-f0-9]{16}$"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ActionBirth": {
      "title": "Private Bazel Action Birth",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "task",
        "manifestSha256",
        "parameters"
      ],
      "properties": {
        "kind": {
          "enum": [
            "action",
            "launcher",
            "launch"
          ]
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parameters": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          }
        }
      },
      "definitions": {
        "Protocol": {
          "const": {
            "maximumManifestBytes": 1048576,
            "maximumRuntimeBytes": 1048576,
            "maximumHandshakeMilliseconds": 10000,
            "readChunkBytes": 65536,
            "cooperativeCancellationRole": "execution"
          }
        },
        "ParameterGrants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ActionBirth/properties/parameters"
          }
        },
        "ControlRole": {
          "enum": [
            "birth",
            "execution"
          ]
        }
      }
    },
    "OutputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "roots",
        "entries"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "kind",
                  "mode"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "directory"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "path",
                  "kind",
                  "mode",
                  "file",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "file"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  "file": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "path",
                  "kind",
                  "mode",
                  "link",
                  "linkKind"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "symlink"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  "link": {
                    "type": "string",
                    "minLength": 1
                  },
                  "linkKind": {
                    "enum": [
                      "directory",
                      "file"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "ModuleSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "identity",
        "lockSha256",
        "blobs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lockSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "ImplementationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "serverIdleSeconds",
        "moduleSetupMilliseconds",
        "terminationReceiptMilliseconds",
        "maximumControlMessageBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "serverIdleSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "moduleSetupMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "terminationReceiptMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximumControlMessageBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "Planner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "workspace",
        "graph",
        "request",
        "implementation"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "graph": {
          "type": "object"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tasks"
          ],
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 65536,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "args": {
              "type": "array",
              "maxItems": 65536,
              "items": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "configuration": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "parallel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "excludeDependencies": {
              "type": "boolean"
            },
            "skipCache": {
              "type": "boolean"
            },
            "skipRemoteCache": {
              "type": "boolean"
            },
            "bail": {
              "type": "boolean"
            },
            "verbose": {
              "type": "boolean"
            },
            "outputStyle": {
              "enum": [
                "stream",
                "stream-without-prefixes",
                "static"
              ]
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "snapshot",
            "runner",
            "sha256",
            "loaderSha256"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "snapshot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "runner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "loaderSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "definitions": {
        "Policy": {
          "const": {
            "maximumDataBytes": 536870912,
            "readChunkBytes": 65536
          }
        },
        "Result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspace",
            "plan",
            "implementation"
          ],
          "properties": {
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "implementation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "snapshot",
                "runner",
                "sha256",
                "loaderSha256"
              ],
              "properties": {
                "version": {
                  "const": 1
                },
                "snapshot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "runner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "loaderSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "plan": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "selected",
                "tasks"
              ],
              "properties": {
                "version": {
                  "const": 1
                },
                "selected": {
                  "type": "array",
                  "maxItems": 65536,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "tasks": {
                  "type": "object",
                  "maxProperties": 65536,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "project",
                      "target",
                      "label",
                      "dependencies",
                      "args",
                      "definition",
                      "root"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "project": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "root": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "configuration": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "label": {
                        "type": "string",
                        "pattern": "^t_[a-f0-9]{16}$"
                      },
                      "dependencies": {
                        "type": "array",
                        "maxItems": 65536,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024
                        }
                      },
                      "args": {
                        "type": "array",
                        "maxItems": 65536,
                        "items": {
                          "type": "string",
                          "maxLength": 65536
                        }
                      },
                      "definition": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "snapshot",
        "runner",
        "sha256",
        "loaderSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "loaderSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "StorageLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "executable",
        "install",
        "modules",
        "workspace",
        "outputs",
        "actions",
        "temporary"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "install": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modules": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outputs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "temporary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "OwnerCommandBudgetCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "effects"
      ],
      "properties": {
        "kind": {
          "enum": [
            "root0",
            "finite",
            "cancelled",
            "expired",
            "fractional"
          ]
        },
        "effects": {
          "enum": [
            0,
            2
          ]
        }
      }
    },
    "OwnerCommandBudgetCaller": {
      "enum": [
        "captured-planner",
        "launch",
        "build"
      ]
    },
    "Policy": {
      "const": {
        "version": 1,
        "serverIdleSeconds": 60,
        "moduleSetupMilliseconds": 120000,
        "terminationReceiptMilliseconds": 5000,
        "maximumControlMessageBytes": 65536
      }
    }
  }
}
