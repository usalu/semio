{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "snapshot",
    "runner",
    "sha256",
    "loaderSha256"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "snapshot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "loaderSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
