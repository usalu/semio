{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "additionalProperties": false,
 "required": ["version", "files", "graph", "request", "variants", "onlyRuntimeMayDiffer", "snapshot"],
 "properties": {
  "version": {"const": 1},
  "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
  "graph": {"type": "object"},
  "request": {"type": "object", "required": ["tasks", "args"], "additionalProperties": false, "properties": {"tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "args": {"type": "array", "items": {"type": "string"}}}},
  "variants": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["name", "maximumElapsedMilliseconds", "ambient"], "properties": {"name": {"type": "string"}, "maximumElapsedMilliseconds": {"type": "integer", "minimum": 1000}, "ambient": {"type": "object", "additionalProperties": {"type": "string"}}}}},
  "onlyRuntimeMayDiffer": {"type": "array", "items": {"type": "string"}},
  "snapshot": {"type": "object", "additionalProperties": false, "required": ["outputs", "files", "edited", "missing"], "properties": {"outputs": {"type": "array", "items": {"type": "string"}}, "files": {"type": "object", "additionalProperties": {"type": "string"}}, "edited": {"type": "object", "additionalProperties": {"type": "string"}}, "missing": {"type": "string"}}}
 }
}
