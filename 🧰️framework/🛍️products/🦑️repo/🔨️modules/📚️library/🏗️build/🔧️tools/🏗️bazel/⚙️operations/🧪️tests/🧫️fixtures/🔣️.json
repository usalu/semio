     "web",
     "lib"
    ]
   ],
   "files": [
    "web/a.ts"
   ],
   "targets": [
    "serve"
   ],
   "bazelQuery": true,
   "expected": {
    "affected": [
     "web"
    ],
    "roots": [
     "api:serve",
     "lib:build"
    ],
    "dependencies": {
     "web:serve": [
      "lib:build"
     ],
     "api:serve": [],
     "lib:build": []
    },
    "continuousDependencies": {
     "web:serve": [
      "api:serve"
     ],
     "api:serve": [],
     "lib:build": []
    }
   }
  },
  {
   "name": "excluding task dependencies keeps only the affected tasks",
   "projects": {
