 "cases": [
  {
   "name": "dependents follow a changed library",
   "projects": {
    "app": {
     "root": "app",
     "targets": {
      "build": {
       "dependsOn": [
        "^build"
       ]
      }
     }
    },
    "lib": {
     "root": "lib",
     "targets": {
      "build": {}
     }
    },
    "tool": {
     "root": "tool",
     "targets": {
      "build": {}
     }
    }
   },
   "edges": [
    [
     "app",
     "lib"
    ]
   ],
   "files": [
    "lib/src/a.ts"
   ],
   "targets": [
    "build"
   ],
   "bazelQuery": true,
   "expected": {
    "affected": [
     "app",
     "lib"
    ],
    "roots": [
     "lib:build"
    ],
    "dependencies": {
     "app:build": [
      "lib:build"
     ],
     "lib:build": []
    },
    "continuousDependencies": {
     "app:build": [],
     "lib:build": []
    }
   }
  },
  {
   "name": "the deepest project root owns a file",
   "projects": {
    "lib": {
     "root": "lib",
     "targets": {
      "build": {}
     }
    },
    "nested": {
     "root": "lib/nested",
     "targets": {
      "build": {
       "dependsOn": [
        "^build"
       ]
      }
     }
    }
   },
   "edges": [
    [
     "nested",
     "lib"
    ]
   ],
   "files": [
    "lib/nested/x.ts"
   ],
   "targets": [
    "build"
   ],
   "bazelQuery": true,
   "expected": {
    "affected": [
     "nested"
    ],
    "roots": [
     "lib:build"
    ],
    "dependencies": {
     "nested:build": [
      "lib:build"
     ],
     "lib:build": []
    },
    "continuousDependencies": {
     "nested:build": [],
     "lib:build": []
    }
   }
  },
  {
