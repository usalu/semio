  {
   "name": "continuous dependencies are kept apart from ordering dependencies",
   "projects": {
    "web": {
     "root": "web",
     "targets": {
      "serve": {
       "dependsOn": [
        "^build",
        "api:serve"
       ]
      }
     }
    },
    "api": {
     "root": "api",
     "targets": {
      "serve": {
       "continuous": true
      }
     }
    },
    "lib": {
     "root": "lib",
     "targets": {
      "build": {}
     }
    }
   },
   "edges": [
