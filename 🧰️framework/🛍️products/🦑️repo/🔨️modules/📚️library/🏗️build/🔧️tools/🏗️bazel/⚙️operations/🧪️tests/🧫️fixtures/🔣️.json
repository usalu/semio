   "files": [
    "app/a.ts"
   ],
   "targets": [
    "build"
   ],
   "excludeDependencies": true,
   "bazelQuery": true,
   "expected": {
    "affected": [
     "app"
    ],
    "roots": [
     "app:build"
    ],
    "dependencies": {
