{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root",
    "workspace",
    "graph",
    "request",
    "implementation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "graph": {
      "type": "object"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "args": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "configuration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "excludeDependencies": {
          "type": "boolean"
        },
        "skipCache": {
          "type": "boolean"
        },
        "skipRemoteCache": {
          "type": "boolean"
        },
        "bail": {
          "type": "boolean"
        },
        "verbose": {
          "type": "boolean"
        },
        "outputStyle": {
          "enum": [
            "stream",
            "stream-without-prefixes",
            "static"
          ]
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "snapshot",
        "runner",
        "sha256",
        "loaderSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "loaderSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumDataBytes": 536870912,
        "readChunkBytes": 65536
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "plan",
        "implementation"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "snapshot",
            "runner",
            "sha256",
            "loaderSha256"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "snapshot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "runner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "loaderSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "selected",
            "tasks"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "selected": {
              "type": "array",
              "maxItems": 65536,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "tasks": {
              "type": "object",
              "maxProperties": 65536,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "project",
                  "target",
                  "label",
                  "dependencies",
                  "args",
                  "definition",
                  "root"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "project": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "configuration": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "label": {
                    "type": "string",
                    "pattern": "^t_[a-f0-9]{16}$"
                  },
                  "dependencies": {
                    "type": "array",
                    "maxItems": 65536,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 65536,
                    "items": {
                      "type": "string",
                      "maxLength": 65536
                    }
                  },
                  "definition": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
