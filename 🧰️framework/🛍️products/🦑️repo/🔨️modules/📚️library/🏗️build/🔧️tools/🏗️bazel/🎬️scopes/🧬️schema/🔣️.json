{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scopes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scopes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "roots",
          "leaves",
          "classes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 40
          },
          "roots": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "leaves": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "scheduling": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "classes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "select",
                "traced"
              ],
              "properties": {
                "select": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command",
                    "workerKind",
                    "executionKind",
                    "semioKind",
                    "owner"
                  ],
                  "properties": {
                    "command": {
                      "enum": [
                        "action",
                        "launch",
                        "test",
                        "launcher"
                      ]
                    },
                    "workerKind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "executionKind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "semioKind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "owner": {
                      "enum": [
                        "none",
                        "native"
                      ]
                    }
                  }
                },
                "traced": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "processes",
                    "modules",
                    "reads",
                    "physical"
                  ],
                  "properties": {
                    "processes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "modules": {
                      "type": "array",
                      "maxItems": 2048,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "reads": {
                      "type": "array",
                      "maxItems": 2048,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "physical": {
                      "type": "array",
                      "maxItems": 2048,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
