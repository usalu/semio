{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/build/test-file/v1",
  "title": "Test file: run one or more test files exactly as their suite runner would, without reading the project graph",
  "definitions": {
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root",
        "table",
        "owner",
        "route",
        "project",
        "launchers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "route": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "project": {
          "type": "string",
          "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
        },
        "launchers": {
          "type": "boolean"
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tables",
        "plain",
        "providers",
        "launcherScript",
        "strip",
        "scrub",
        "environment",
        "defaultBuildMode",
        "elapsedSlackMs",
        "extensions",
        "pythonHints",
        "limits"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Table"
          }
        },
        "plain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "owner",
            "route",
            "project",
            "budgetMs",
            "typecheck"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "owner": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "route": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "project": {
              "type": "string",
              "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
            },
            "budgetMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000
            },
            "typecheck": {
              "const": "none"
            }
          }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "provider"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "enum": [
                  "cargo-preparation-storage"
                ]
              }
            }
          }
        },
        "launcherScript": {
          "type": "string",
          "minLength": 1
        },
        "strip": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "scrub": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "defaultBuildMode": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "elapsedSlackMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z]+$"
          }
        },
        "pythonHints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tailCharacters",
            "errorCharacters",
            "maximumFiles"
          ],
          "properties": {
            "tailCharacters": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "errorCharacters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maximumFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        }
      }
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "mode",
        "table",
        "suite",
        "owner",
        "typecheck",
        "budgetMs",
        "python",
        "launcher",
        "runsOnHost"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "suite",
            "plain"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "typecheck": {
          "enum": [
            "none",
            "strict",
            "strict-indexed"
          ]
        },
        "budgetMs": {
          "type": "integer",
          "minimum": 1
        },
        "python": {
          "type": "boolean"
        },
        "launcher": {
          "type": [
            "string",
            "null"
          ]
        },
        "runsOnHost": {
          "type": "boolean"
        }
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "files"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Route"
          }
        }
      }
    },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "mode",
        "table",
        "suite",
        "status",
        "seconds"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "suite",
            "plain"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "not-run"
          ]
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        },
        "tail": {
          "type": "string"
        }
      }
    },
    "Counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "skipped",
        "notRun"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "notRun": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "seconds",
        "bail",
        "counts",
        "files"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "bail": {
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/definitions/Counts"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Row"
          }
        }
      }
    },
    "Corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "arguments",
        "routes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
