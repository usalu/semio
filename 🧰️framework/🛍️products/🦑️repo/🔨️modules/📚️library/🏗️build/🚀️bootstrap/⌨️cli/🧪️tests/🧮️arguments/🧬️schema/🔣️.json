{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:native-recovery-arguments-corpus:v1",
  "title": "Native Recovery Arguments Corpus",
  "description": "Language-agnostic cases for the native recovery selection: an argument vector in, the kind and target of the fixed recovery command or nothing out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "args", "kind", "target"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "kind": { "enum": ["frontend", "maintenance", "cache-reset", null] },
          "target": { "enum": ["build", "install", "preview", "retire", "nx", null] }
        },
        "oneOf": [
          { "properties": { "kind": { "const": null }, "target": { "const": null } } },
          { "properties": { "kind": { "enum": ["frontend", "maintenance", "cache-reset"] }, "target": { "enum": ["build", "install", "preview", "retire", "nx"] } } }
        ]
      }
    }
  }
}
