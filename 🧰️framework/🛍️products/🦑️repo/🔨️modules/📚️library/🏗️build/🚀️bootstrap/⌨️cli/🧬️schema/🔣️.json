{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.repo.build.native-recovery/1",
  "$defs": {
    "Protocol": {
      "const": {
        "project": "repo-mcp",
        "owner": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🔌️mcp",
        "targets": [
          "build",
          "install"
        ],
        "options": [
          "--skip-cache",
          "--skip-cache=true",
          "--skip-remote-cache",
          "--skip-remote-cache=true",
          "--output=stream"
        ],
        "buildChild": [
          "run",
          "repo-mcp:build"
        ],
        "buildOnlyOptions": [
          "--exclude-dependencies",
          "--exclude-dependencies=true"
        ]
      }
    },
    "Owner": {
      "type": "object",
      "required": [
        "name",
        "targets"
      ],
      "properties": {
        "name": {
          "const": "repo-mcp"
        },
        "targets": {
          "type": "object",
          "required": [
            "build",
            "install"
          ],
          "properties": {
            "build": {
              "type": "object",
              "required": [
                "options",
                "executor"
              ],
              "properties": {
                "dependsOn": {
                  "const": []
                },
                "options": {
                  "type": "object",
                  "required": [
                    "command",
                    "cwd"
                  ],
                  "properties": {
                    "command": {
                      "const": "bun ./📜️script.ts build"
                    },
                    "cwd": {
                      "const": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🔌️mcp"
                    }
                  }
                },
                "executor": {
                  "const": "repo:script"
                }
              }
            },
            "install": {
              "type": "object",
              "required": [
                "options",
                "dependsOn",
                "executor"
              ],
              "properties": {
                "dependsOn": {
                  "const": [
                    "build"
                  ]
                },
                "options": {
                  "type": "object",
                  "required": [
                    "command"
                  ],
                  "properties": {
                    "command": {
                      "const": "bun ./📜️script.ts install"
                    },
                    "cwd": {
                      "const": "🧰️framework/🛍️products/🦑️repo/🔨️modules/💻️client/🔌️mcp"
                    }
                  }
                },
                "executor": {
                  "const": "repo:script"
                }
              }
            }
          }
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args",
        "fault",
        "target",
        "events"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fault": {
          "enum": [
            "none",
            "owner",
            "command",
            "dependencies",
            "spread",
            "abort",
            "reject"
          ]
        },
        "target": {
          "enum": [
            "build",
            "install",
            null
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
