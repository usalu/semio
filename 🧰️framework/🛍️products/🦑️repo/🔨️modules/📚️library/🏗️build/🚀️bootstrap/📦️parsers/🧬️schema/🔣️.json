{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "key",
    "generation",
    "bindingDigest",
    "parsers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parsers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "digest",
          "files",
          "bytes"
        ],
        "properties": {
          "name": {
            "enum": [
              "typescript",
              "@iarna/toml"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          }
        }
      }
    }
  }
}
