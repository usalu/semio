{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "key",
    "generation",
    "bindingDigest",
    "parsers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parsers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "digest",
          "files",
          "bytes"
        ],
        "properties": {
          "name": {
            "enum": [
              "typescript",
              "@iarna/toml"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          }
        }
      }
    }
  },
  "definitions": {
    "Inspection": {
      "enum": [
        "ready",
        "receipt-required",
        "material-required"
      ]
    },
    "BootstrapCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "material",
        "receipt",
        "matches",
        "writeFails",
        "state",
        "installs",
        "writes",
        "failure"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "material": {
          "type": "boolean"
        },
        "receipt": {
          "type": "boolean"
        },
        "matches": {
          "type": "boolean"
        },
        "writeFails": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "ready",
            "receipt-required",
            "material-required"
          ]
        },
        "installs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "writes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "failure": {
          "type": "boolean"
        }
      }
    },
    "ProgressProtocol": {
      "const": {
        "operationBatch": 64,
        "minimumIntervalMilliseconds": 1000
      }
    },
    "ProgressCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "events",
        "published"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "operation",
              "completedOperations"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0
              },
              "operation": {
                "enum": [
                  "state",
                  "list",
                  "readText",
                  "membership",
                  "selection",
                  "publication"
                ]
              },
              "completedOperations": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "published": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
