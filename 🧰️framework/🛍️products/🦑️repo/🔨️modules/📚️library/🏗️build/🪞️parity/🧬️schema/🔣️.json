{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Build Parity",
  "description": "Schema of the build parity verifier: the sample set, the documented normalizations, the evidence one tool leaves per task, the divergences found and the report. Language-neutral: every other implementation of the comparator reads and writes exactly these shapes.",
  "type": "object",
  "definitions": {
    "Language": {
      "enum": [
        "en",
        "de"
      ]
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Tool": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "Area": {
      "enum": [
        "framework",
        "s-plugins",
        "hub",
        "teaching",
        "mit-bestand",
        "semio-tech"
      ]
    },
    "Check": {
      "enum": [
        "graph",
        "closure",
        "outputs",
        "results",
        "inputs",
        "restore"
      ]
    },
    "Phase": {
      "enum": [
        "fresh",
        "restored"
      ]
    },
    "Status": {
      "enum": [
        "equal",
        "diverged",
        "not-applicable",
        "unavailable"
      ]
    },
    "TaskId": {
      "type": "string",
      "pattern": "^[^\\s:]+:[^\\s:]+(:[^\\s:]+)?$"
    },
    "Path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "target",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "area": {
          "$ref": "#/definitions/Area"
        },
        "target": {
          "$ref": "#/definitions/TaskId"
        },
        "configuration": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Phase"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Check"
          }
        },
        "expectExit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "inputTasks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/TaskId"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maximumOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "$ref": "#/definitions/Text"
        },
        "skipCache": {
          "type": "boolean"
        }
      }
    },
    "Samples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "defaults",
        "samples"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phases",
            "checks",
            "expectExit",
            "timeoutSeconds",
            "maximumOutputBytes"
          ],
          "properties": {
            "phases": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/Phase"
              }
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/Check"
              }
            },
            "expectExit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "maximumOutputBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Sample"
          }
        }
      }
    },
    "IgnoreGlobRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "surface",
        "glob",
        "justification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "ignore-glob"
        },
        "surface": {
          "enum": [
            "output",
            "input-nx",
            "input-bazel"
          ]
        },
        "glob": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "$ref": "#/definitions/Text"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TextReplaceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "surface",
        "glob",
        "pattern",
        "flags",
        "replacement",
        "justification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "text-replace"
        },
        "surface": {
          "const": "output"
        },
        "glob": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "string",
          "pattern": "^[gimsu]*$"
        },
        "replacement": {
          "type": "string"
        },
        "justification": {
          "$ref": "#/definitions/Text"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "JsonRedactRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "surface",
        "glob",
        "pointers",
        "justification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "json-redact"
        },
        "surface": {
          "const": "output"
        },
        "glob": {
          "type": "string",
          "minLength": 1
        },
        "pointers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(/[^/]+)+$"
          }
        },
        "justification": {
          "$ref": "#/definitions/Text"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "StripPrefixRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "surface",
        "prefix",
        "justification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "strip-prefix"
        },
        "surface": {
          "const": "input-bazel"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[^/]+/$"
        },
        "justification": {
          "$ref": "#/definitions/Text"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ModeMaskRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "surface",
        "mask",
        "justification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "mode-mask"
        },
        "surface": {
          "const": "output"
        },
        "mask": {
          "type": "integer",
          "minimum": 1,
          "maximum": 511
        },
        "justification": {
          "$ref": "#/definitions/Text"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AmbientEnvRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "surface",
        "names",
        "justification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "ambient-env"
        },
        "surface": {
          "const": "env-bazel"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "justification": {
          "$ref": "#/definitions/Text"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CoveredByRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "surface",
        "category",
        "anyOf",
        "justification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "covered-by"
        },
        "surface": {
          "const": "input-nx"
        },
        "category": {
          "enum": [
            "external",
            "runtime"
          ]
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "justification": {
          "$ref": "#/definitions/Text"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Rule": {
      "oneOf": [
        {
          "$ref": "#/definitions/IgnoreGlobRule"
        },
        {
          "$ref": "#/definitions/TextReplaceRule"
        },
        {
          "$ref": "#/definitions/JsonRedactRule"
        },
        {
          "$ref": "#/definitions/StripPrefixRule"
        },
        {
          "$ref": "#/definitions/ModeMaskRule"
        },
        {
          "$ref": "#/definitions/AmbientEnvRule"
        },
        {
          "$ref": "#/definitions/CoveredByRule"
        }
      ]
    },
    "Extractors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failedTasksHeading",
        "failedTask",
        "testTarget"
      ],
      "properties": {
        "failedTasksHeading": {
          "type": "string",
          "minLength": 1
        },
        "failedTask": {
          "type": "string",
          "minLength": 1
        },
        "testTarget": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "extractors",
        "rules"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "extractors": {
          "$ref": "#/definitions/Extractors"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Rule"
          }
        }
      }
    },
    "Plan": {
      "type": "object",
      "required": [
        "roots",
        "tasks",
        "dependencies"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "object",
                "required": [
                  "project",
                  "target"
                ],
                "properties": {
                  "project": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "configuration": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "continuousDependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "FileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "directory",
            "symlink"
          ]
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/definitions/Sha256"
        },
        "link": {
          "type": "string"
        },
        "normalized": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Sha256"
          }
        }
      }
    },
    "Outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "files"
      ],
      "properties": {
        "roots": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Path"
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/FileRecord"
          }
        }
      }
    },
    "TestStatus": {
      "enum": [
        "passed",
        "failed",
        "no-status"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit",
        "reason",
        "failedTasks",
        "tests"
      ],
      "properties": {
        "exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "enum": [
            "exit",
            "timeout",
            "cancelled",
            "output-limit",
            "spawn-error"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "failedTasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskId"
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/TestStatus"
          }
        }
      }
    },
    "NxInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "environment",
        "runtime",
        "depOutputs",
        "external"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depOutputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "env",
        "exit"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "Closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queried"
      ],
      "properties": {
        "queried": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskId"
          }
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sample",
        "tool",
        "phase",
        "plan",
        "run",
        "outputs",
        "inputs",
        "spawns",
        "closure",
        "errors"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "$ref": "#/definitions/Tool"
        },
        "phase": {
          "$ref": "#/definitions/Phase"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/definitions/Plan"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/definitions/Run"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Outputs"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NxInputs"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "spawns": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Spawn"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "closure": {
          "anyOf": [
            {
              "$ref": "#/definitions/Closure"
            },
            {
              "type": "null"
            }
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Code": {
      "enum": [
        "observation-error",
        "plan-unavailable",
        "task-missing-nx",
        "task-missing-bazel",
        "edge-missing-nx",
        "edge-missing-bazel",
        "root-differs",
        "continuous-edge-differs",
        "closure-unavailable",
        "closure-task-missing-in-query",
        "closure-task-extra-in-query",
        "output-missing-nx",
        "output-missing-bazel",
        "output-kind-differs",
        "output-link-differs",
        "output-mode-differs",
        "output-bytes-differ",
        "output-root-differs",
        "run-unavailable",
        "exit-differs",
        "exit-unexpected",
        "reason-differs",
        "failed-tasks-differ",
        "test-status-differs",
        "inputs-unavailable",
        "input-file-only-nx",
        "input-file-only-bazel",
        "env-hashed-not-visible",
        "env-visible-not-hashed",
        "external-uncovered",
        "runtime-uncovered",
        "restore-missing",
        "restore-kind-differs",
        "restore-mode-differs",
        "restore-bytes-differ"
      ]
    },
    "Divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "code",
        "subject"
      ],
      "properties": {
        "check": {
          "$ref": "#/definitions/ReportedCheck"
        },
        "code": {
          "$ref": "#/definitions/Code"
        },
        "subject": {
          "type": "string"
        },
        "nx": {
          "type": "string"
        },
        "bazel": {
          "type": "string"
        }
      }
    },
    "CheckReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "phase",
        "status",
        "divergences"
      ],
      "properties": {
        "check": {
          "$ref": "#/definitions/ReportedCheck"
        },
        "phase": {
          "$ref": "#/definitions/Phase"
        },
        "status": {
          "$ref": "#/definitions/Status"
        },
        "divergences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Divergence"
          }
        }
      }
    },
    "SampleReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample",
        "area",
        "target",
        "status",
        "checks"
      ],
      "properties": {
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "$ref": "#/definitions/Area"
        },
        "target": {
          "$ref": "#/definitions/TaskId"
        },
        "status": {
          "enum": [
            "equal",
            "diverged",
            "error"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CheckReport"
          }
        }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "samples",
        "totals",
        "rules"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SampleReport"
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "samples",
            "equal",
            "diverged",
            "error",
            "divergences"
          ],
          "properties": {
            "samples": {
              "type": "integer",
              "minimum": 0
            },
            "equal": {
              "type": "integer",
              "minimum": 0
            },
            "diverged": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": "integer",
