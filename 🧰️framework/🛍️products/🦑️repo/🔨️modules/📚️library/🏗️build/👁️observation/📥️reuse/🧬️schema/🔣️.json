{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:graph:inference-inventory-reuse:v1",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "maximumDepth": 64,
        "maximumValues": 1048576,
        "maximumMembers": 65536,
        "maximumTextBytes": 67108864,
        "maximumReferences": 65536,
        "maximumInventoryBytes": 4294967296,
        "maximumPathUnits": 256,
        "changeAttempts": 3
      }
    },
    "ConsumerTimings": {
      "description": "Elapsed milliseconds summed across started batches, including the currently active portion. Reader runs until the retained consumer starts. Verify phases cover their respective store.verify calls. Body covers the inventory callback.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reader", "preVerify", "body", "postVerify"],
      "properties": {
        "reader": { "$ref": "#/definitions/ConsumerTiming" },
        "preVerify": { "$ref": "#/definitions/ConsumerTiming" },
        "body": { "$ref": "#/definitions/ConsumerTiming" },
        "postVerify": { "$ref": "#/definitions/ConsumerTiming" }
      }
    },
    "BodyTimings": {
      "description": "Wall milliseconds and call counts at existing operations inside the inventory presence body, including active work. No paths, counters for individual records, or verifications outside the body.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storeRecheck": { "$ref": "#/definitions/ConsumerTiming" },
        "continuation": { "$ref": "#/definitions/ConsumerTiming" },
        "fileChecks": { "$ref": "#/definitions/ConsumerTiming" },
        "recordRead": { "$ref": "#/definitions/ConsumerTiming" },
        "implementationCheck": { "$ref": "#/definitions/ConsumerTiming" }
      }
    },
    "ConsumerTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started", "active", "milliseconds"],
      "properties": {
        "started": { "$ref": "#/definitions/TimingNumber" },
        "active": { "$ref": "#/definitions/TimingNumber" },
        "milliseconds": { "$ref": "#/definitions/TimingNumber" }
      }
    },
    "TimingNumber": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "Value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Value"
          }
        }
      ]
    },
    "References": {
      "type": "array",
      "maxItems": 65536,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SEMIO_(?:SOURCE_CLOSURE|CARGO_LOCK)_[a-f0-9]{64}$"
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/definitions/Value"
        },
        "references": {
          "$ref": "#/definitions/References"
        }
      }
    },
    "Cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usedBytes",
        "records",
        "accepted"
      ],
      "properties": {
        "usedBytes": {
          "type": "integer"
        },
        "records": {
          "type": "integer"
        },
        "accepted": {
          "type": "boolean"
        },
        "maximumBytes": {
          "type": "integer"
        }
      }
    },
    "InventoryCohortPlanCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runs",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "bytes"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65536
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 134217728
              }
            }
          }
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset",
              "records",
              "maximumBytes"
            ],
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "records": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "maximumBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 134217728
              }
            }
          }
        }
      }
    },
    "PortableInventoryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "batches"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "batches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      }
    },
    "PresenceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fault",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fault": {
          "enum": [
            "unchanged",
            "settled-ancestry-replacement",
            "exact-leaf-absent",
            "ancestor-absent",
            "ancestor-replaced",
            "hash",
            "contract",
            "symlink",
            "hardlink",
            "leaf-disappears",
            "absence-reappears",
            "permission",
            "prior-leaf-disappears",
            "cold-fifo",
            "cold-close",
            "cold-utf8"
          ]
        },
        "outcome": {
          "enum": [
            "reuse",
            "recompute",
            "refuse"
          ]
        }
      }
    },
    "PresenceCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "validityMilliseconds",
        "cases",
        "primaryFailures",
        "errorCases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "validityMilliseconds": {
          "const": 600000
        },
        "cases": {
          "type": "array",
          "minItems": 11,
          "items": {
            "$ref": "#/definitions/PresenceCase"
          }
        },
        "primaryFailures": {
          "type": "array",
          "items": {
            "enum": [
              "false",
              "undefined"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "errorCases": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/definitions/ErrorClassificationCase"
          }
        }
      }
    },
    "SourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "files"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "LockRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ErrorClassificationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "missing"
      ],
      "properties": {
        "code": {
          "enum": [
            "ENOENT",
            "ENOTDIR",
            "EACCES",
            "EPERM",
            "EIO",
            "ECANCELED",
            "ETIMEDOUT"
          ]
        },
        "missing": {
          "type": "boolean"
        }
      }
    }
  }
}
