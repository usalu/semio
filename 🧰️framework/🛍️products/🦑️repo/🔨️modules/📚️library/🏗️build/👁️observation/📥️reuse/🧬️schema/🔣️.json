{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:graph:inference-inventory-reuse:v1",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "maximumDepth": 64,
        "maximumValues": 1048576,
        "maximumMembers": 65536,
        "maximumTextBytes": 67108864,
        "maximumReferences": 65536,
        "maximumInventoryBytes": 4294967296
      }
    },
    "Value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Value"
          }
        }
      ]
    },
    "References": {
      "type": "array",
      "maxItems": 65536,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SEMIO_(?:SOURCE_CLOSURE|CARGO_LOCK)_[a-f0-9]{64}$"
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/definitions/Value"
        },
        "references": {
          "$ref": "#/definitions/References"
        }
      }
    },
    "Cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usedBytes",
        "records",
        "accepted"
      ],
      "properties": {
        "usedBytes": {
          "type": "integer"
        },
        "records": {
          "type": "integer"
        },
        "accepted": {
          "type": "boolean"
        },
        "maximumBytes": {
          "type": "integer"
        }
      }
    },
    "InventoryCohortPlanCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runs",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "bytes"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65536
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 134217728
              }
            }
          }
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset",
              "records",
              "maximumBytes"
            ],
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "records": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "maximumBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 134217728
              }
            }
          }
        }
      }
    },
    "PortableInventoryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "batches"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "batches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      }
    }
  }
}
