{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/build/inference-observation/v1",
  "title": "Build inference observation record",
  "description": "The first line of a persisted inference cache: the digest of the implementation revision and inference key, plus every filesystem fact the computation observed. The second line is the exactly JSON-representable result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest",
    "observations",
    "authorityObservations",
    "resultSha256"
  ],
  "properties": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "authorityObservations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "resultSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "fact"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "exists",
            "stat",
            "lstat",
            "readdir",
            "realpath",
            "realpathNative",
            "resolve",
            "readdirNames",
            "fileExists",
            "directoryExists",
            "directories",
            "typescriptText",
            "typescriptRealpath",
            "analysis"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fact": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "size",
                "mtimeMs",
                "ctimeMs",
                "ino",
                "sha256"
              ],
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "mtimeMs": {
                  "type": "number"
                },
                "ctimeMs": {
                  "type": "number"
                },
                "ino": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "$ref": "#/$defs/sourceAnalysis"
            }
          ]
        }
      }
    },
    "sourceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "revision",
        "source",
        "resultSha256",
        "nestedObservations"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "mtimeMs",
            "ctimeMs",
            "ino",
            "sha256"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "mtimeMs": {
              "type": "number"
            },
            "ctimeMs": {
              "type": "number"
            },
            "ino": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "resultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nestedObservations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    }
  }
}
