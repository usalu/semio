{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"array",
  "items":{
    "type":"object",
    "additionalProperties":false,
    "required":["name","first","second"],
    "properties":{
      "name":{"type":"string"},
      "first":{"$ref":"#/definitions/probes"},
      "second":{"$ref":"#/definitions/probes"}
    }
  },
  "definitions":{
    "probes":{"type":"array","minItems":1,"maxItems":2,"items":{"enum":["recorded","changed","unreadable","unparsable"]}}
  }
}
