{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/schema/observation-registry-law.json",
 "type": "object",
 "required": ["version", "owners", "recorded", "steps"],
 "additionalProperties": false,
 "properties": {
  "version": {"const": 1},
  "owners": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "items": {"type": "object", "required": ["name", "root", "manifest", "packages"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "root": {"type": "string"}, "manifest": {"type": "string"}, "packages": {"type": "array", "items": {"type": "string"}}}}}},
  "recorded": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "from"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "from": {"type": "string"}}}},
  "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "registry", "holds"], "additionalProperties": false, "properties": {"label": {"type": "string"}, "registry": {"type": ["string", "null"]}, "holds": {"type": "object", "additionalProperties": {"type": "boolean"}}}}}
 }
}
