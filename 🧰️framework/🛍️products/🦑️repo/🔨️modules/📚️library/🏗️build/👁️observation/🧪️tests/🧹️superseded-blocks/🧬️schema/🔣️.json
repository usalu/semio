{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/schema/observation-superseded-blocks-law.json",
 "type": "object",
 "required": ["version", "graceMilliseconds", "nowMilliseconds", "scenarios"],
 "additionalProperties": false,
 "definitions": {"Hex64": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
 "properties": {
  "version": {"const": 1},
  "graceMilliseconds": {"type": "integer", "minimum": 0},
  "nowMilliseconds": {"type": "integer", "minimum": 0},
  "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "headers", "blocks", "expectedRemoved"], "additionalProperties": false, "properties": {
   "name": {"type": "string"},
   "headers": {"type": "object", "patternProperties": {"^[a-f0-9]{24}$": {"type": "array", "items": {"$ref": "#/definitions/Hex64"}}}, "additionalProperties": false},
   "blocks": {"type": "array", "items": {"type": "object", "required": ["digest", "ageMilliseconds"], "additionalProperties": false, "properties": {"digest": {"$ref": "#/definitions/Hex64"}, "ageMilliseconds": {"type": "integer", "minimum": 0}}}},
   "foreign": {"type": "array", "items": {"type": "string"}},
   "expectedRemoved": {"type": "array", "items": {"$ref": "#/definitions/Hex64"}}}}}
 }
}
