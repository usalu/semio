{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "repo doctor",
  "description": "Tool-neutral contract of `repo doctor`: the policy (thresholds, safe repairs), the rule catalogue, the facts a probe run reads from a machine, and the report derived from them. Facts and reports are plain JSON so any language can produce or consume them.",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "areas": [
          "tools",
          "storage",
          "leases",
          "capacity",
          "sessions",
          "graph",
          "dependencies",
          "caches",
          "processes",
          "host",
          "doctor"
        ],
        "severities": [
          "error",
          "warn",
          "info"
        ],
        "maximumFindings": 500,
        "maximumProcessRows": 60,
        "maximumWaitRows": 40,
        "maximumCommandCharacters": 100
      }
    },
    "Area": {
      "enum": [
        "tools",
        "storage",
        "leases",
        "capacity",
        "sessions",
        "graph",
        "dependencies",
        "caches",
        "processes",
        "host",
        "doctor"
      ]
    },
    "Severity": {
      "enum": [
        "error",
        "warn",
        "info"
      ]
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "Scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "Data": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/Scalar"
      }
    },
    "RuleId": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "RepairId": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "RuleFix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "note"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "automatic",
            "wait",
            "ask"
          ]
        },
        "command": {
          "type": "string",
          "pattern": "^repo [a-z]"
        },
        "repair": {
          "$ref": "#/definitions/RepairId"
        },
        "note": {
          "$ref": "#/definitions/Text"
        }
      }
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "owner",
        "severities",
        "data",
        "title",
        "detail",
        "fix"
      ],
      "properties": {
        "area": {
          "$ref": "#/definitions/Area"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "severities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Severity"
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "title": {
          "$ref": "#/definitions/Text"
        },
        "detail": {
          "$ref": "#/definitions/Text"
        },
        "fix": {
          "$ref": "#/definitions/RuleFix"
        }
      }
    },
    "Rules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/RuleId"
      },
      "additionalProperties": {
        "$ref": "#/definitions/Rule"
      }
    },
    "Repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "rules",
        "summary",
        "safety"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/RepairId"
        },
        "area": {
          "$ref": "#/definitions/Area"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/RuleId"
          }
        },
        "summary": {
          "$ref": "#/definitions/Text"
        },
        "safety": {
          "$ref": "#/definitions/Text"
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "probe",
        "leases",
        "capacity",
        "host",
        "storage",
        "tools",
        "sessions",
        "graph",
        "dependencies",
        "caches",
        "processes",
        "repairs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeoutMilliseconds",
            "parallelism",
            "timeoutOverrides"
          ],
          "properties": {
            "timeoutMilliseconds": {
              "type": "integer",
              "minimum": 500,
              "maximum": 600000
            },
            "parallelism": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "timeoutOverrides": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]+$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 500,
                "maximum": 600000
              }
            }
          }
        },
        "leases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "waitWarnSeconds",
            "waitErrorSeconds",
            "holdWarnSeconds",
            "holdErrorSeconds",
            "queueDepthWarn",
            "registryOrphanFoldersWarn",
            "violationsLimit"
          ],
          "properties": {
            "waitWarnSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "waitErrorSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "holdWarnSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "holdErrorSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "queueDepthWarn": {
              "type": "integer",
              "minimum": 2
            },
            "registryOrphanFoldersWarn": {
              "type": "integer",
              "minimum": 1
            },
            "violationsLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "waitWarnSeconds",
            "waitErrorSeconds",
            "idleGrantSeconds",
            "idleObservedPercent"
          ],
          "properties": {
            "waitWarnSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "waitErrorSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "idleGrantSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "idleObservedPercent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lowMemoryHeadroomPercent",
            "swapWarnMegabytes",
            "swapOutWarnMegabytesPerSecond",
            "loadPerCoreWarn",
            "loadPerCoreError",
            "openFilesWarnPercent",
            "imagesWarn",
            "imagesError"
          ],
          "properties": {
            "lowMemoryHeadroomPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "swapWarnMegabytes": {
              "type": "integer",
              "minimum": 1
            },
            "swapOutWarnMegabytesPerSecond": {
              "type": "integer",
              "minimum": 1
            },
            "loadPerCoreWarn": {
              "type": "number",
              "minimum": 0.1
            },
            "loadPerCoreError": {
              "type": "number",
              "minimum": 0.1
            },
            "openFilesWarnPercent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "imagesWarn": {
              "type": "integer",
              "minimum": 1
            },
            "imagesError": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freePercentWarn",
            "freePercentError",
            "floorBytes",
            "hostFreeWarnBytes",
            "hostFreeErrorBytes",
            "publicationErrorSeconds"
          ],
          "properties": {
            "freePercentWarn": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "freePercentError": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "floorBytes": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "hostFreeWarnBytes": {
              "type": "integer",
              "minimum": 1
            },
            "hostFreeErrorBytes": {
              "type": "integer",
              "minimum": 1
            },
            "publicationErrorSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "essential"
          ],
          "properties": {
            "essential": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            }
          }
        },
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "crowdedLive"
          ],
          "properties": {
            "crowdedLive": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementationRoots",
            "implementationSkip",
            "walkEntries"
          ],
          "properties": {
            "implementationRoots": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "implementationSkip": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "walkEntries": {
              "type": "integer",
              "minimum": 100,
              "maximum": 100000
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orphanCountWarn",
            "unreadyAgeSeconds"
          ],
          "properties": {
            "orphanCountWarn": {
              "type": "integer",
              "minimum": 1
            },
            "unreadyAgeSeconds": {
              "type": "integer",
              "minimum": 60
            }
          }
        },
        "caches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deadPublications",
            "deadPublicationWarnBytes",
            "deadPublicationQuietSeconds",
            "walkEntries",
            "retiredNamesShown"
          ],
          "properties": {
            "deadPublications": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "partition",
                  "path",
                  "prefix"
                ],
                "properties": {
                  "partition": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "path": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "prefix": {
                    "type": "string",
                    "pattern": "^[a-z]-$"
                  }
                }
              }
            },
            "deadPublicationWarnBytes": {
              "type": "integer",
              "minimum": 1
            },
            "deadPublicationQuietSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "walkEntries": {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000000
            },
            "retiredNamesShown": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        },
        "processes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patterns",
            "exclude",
            "orphanAgeSeconds",
            "idleHolderSeconds",
            "idleCpuPercent"
          ],
          "properties": {
            "patterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "orphanAgeSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "idleHolderSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "idleCpuPercent": {
              "type": "number",
              "minimum": 0
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "repairs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Repair"
          }
        }
      }
    },
    "HostFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cores",
        "totalMegabytes",
        "availableMegabytes",
        "floorMegabytes",
        "pressure",
        "swapUsedMegabytes",
        "swapOutMegabytesPerSecond",
        "load",
        "openFiles",
        "openFilesMaximum",
        "attachedImages",
        "governor"
      ],
      "properties": {
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "totalMegabytes": {
          "type": "integer",
          "minimum": 1
        },
        "availableMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "floorMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "pressure": {
          "enum": [
            "normal",
            "warn",
            "critical"
          ]
        },
        "swapUsedMegabytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "swapOutMegabytesPerSecond": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "load": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "openFiles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "openFilesMaximum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "attachedImages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "governor": {
          "enum": [
            "on",
            "off"
          ]
        }
      }
    },
    "PartitionFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "capacityBytes",
        "freeBytes",
        "imageBytes",
        "backing",
        "publication",
        "publicationAgeSeconds",
        "image"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "state": {
          "enum": [
            "mounted",
            "detached",
            "directory",
            "absent"
          ]
        },
        "capacityBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "freeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "imageBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "backing": {
          "enum": [
            "present",
            "missing",
            "none"
          ]
        },
        "publication": {
          "enum": [
            "none",
            "intent",
            "receipt"
          ]
        },
        "publicationAgeSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "image": {
          "enum": [
            "ok",
            "damaged",
            "none"
          ]
        }
      }
    },
    "StorageFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostFreeBytes",
        "hostTotalBytes",
        "partitions"
      ],
      "properties": {
        "hostFreeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hostTotalBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "partitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PartitionFacts"
          }
        }
      }
    },
    "ToolRowFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "pin",
        "found"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "state": {
          "enum": [
            "ok",
            "missing",
            "drift",
            "unprobed"
          ]
        },
        "pin": {
          "type": [
            "string",
            "null"
          ]
        },
        "found": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ToolsFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolRowFacts"
          }
        }
      }
    },
    "HolderFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "hash",
        "mode",
        "pid",
        "heldSeconds",
        "class",
        "owner",
        "command"
      ],
      "properties": {
        "resource": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "enum": [
            "shared",
            "exclusive"
          ]
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "heldSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "class": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    },
    "WaiterFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "hash",
        "mode",
        "pid",
        "waitedSeconds",
        "class",
        "owner",
        "position",
        "queued",
        "blockers",
        "command"
      ],
      "properties": {
        "resource": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "enum": [
            "shared",
            "exclusive"
          ]
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "waitedSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "class": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "queued": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "command": {
          "type": "string"
        }
      }
    },
    "LeasesFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holders",
        "waiters",
        "cycles",
        "violations",
        "registry",
        "deadTickets",
        "deadHolders"
      ],
      "properties": {
        "holders": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HolderFacts"
          }
        },
        "waiters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WaiterFacts"
          }
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "members",
              "victim"
            ],
            "properties": {
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "victim": {
                "type": "string"
              }
            }
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "held",
              "requested"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "out-of-order",
                  "hold-and-wait",
                  "self-deadlock",
                  "cycle"
                ]
              },
              "held": {
                "type": "string"
              },
              "requested": {
                "type": "string"
              }
            }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "folders",
            "orphanFolders",
            "deadEntries",
            "liveEntries"
          ],
          "properties": {
            "folders": {
              "type": "integer",
              "minimum": 0
            },
            "orphanFolders": {
              "type": "integer",
              "minimum": 0
            },
            "deadEntries": {
              "type": "integer",
              "minimum": 0
            },
            "liveEntries": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "deadTickets": {
          "type": "integer",
          "minimum": 0
        },
        "deadHolders": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "GrantFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "pid",
        "jobs",
        "reservedMegabytes",
        "observedMegabytes",
        "heldSeconds"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "jobs": {
          "type": "integer",
          "minimum": 1
        },
        "reservedMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "observedMegabytes": {
          "type": [
            "integer",
