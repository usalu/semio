{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Owner view inference corpus",
  "description": "🌳️ Projects with an owner view and a provisioning dependency run through the real input inference: the shared owner globs, the private ones and the activated toolchain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "runtimeState",
    "scopeNames",
    "toolchains",
    "version",
    "views"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scopeNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolchains": {
      "type": "object"
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root",
          "entries",
          "targets",
          "sharedHas",
          "sharedLacks",
          "ownerPrivate",
          "tex"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2
            }
          },
          "targets": {
            "type": "object"
          },
          "sharedHas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharedLacks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownerPrivate": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "tex": {
            "type": "boolean"
          }
        }
      }
    },
    "runtimeState": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
