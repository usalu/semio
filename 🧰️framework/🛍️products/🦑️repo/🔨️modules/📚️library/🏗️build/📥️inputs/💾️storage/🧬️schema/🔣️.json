{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string",
  "enum": [
    "build-input-closures",
    "build-lock-closures",
    "inference",
    "admission"
  ],
  "definitions": {
    "GraphWriterLeaseProtocol": {
      "const": {
        "version": 1,
        "partition": "leases",
        "role": "infrastructure-reader",
        "artifactReservation": false
      }
    },
    "GraphWriterLeaseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "failAt",
        "releaseFails",
        "closeFails",
        "usedBytes",
        "expectedFailure",
        "expectedClosed",
        "expectedAcquired"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "failAt": {
          "enum": [
            "none",
            "open",
            "recheck",
            "acquire",
            "graph",
            "body",
            "cancel",
            "body-undefined",
            "cancel-body"
          ]
        },
        "releaseFails": {
          "type": "boolean"
        },
        "closeFails": {
          "type": "boolean"
        },
        "usedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedFailure": {
          "enum": [
            null,
            "open",
            "recheck",
            "acquire",
            "graph",
            "body",
            "cancel",
            "release",
            "close",
            "capacity",
            "body-undefined",
            "cancel-body"
          ]
        },
        "expectedClosed": {
          "type": "boolean"
        },
        "expectedAcquired": {
          "type": "boolean"
        }
      }
    },
    "OptionalQuota": {
      "title": "Optional Graph Cache Quota",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumBytes",
        "usedBytes",
        "availableBytes",
        "minimumAvailableBytes"
      ],
      "properties": {
        "maximumBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "availableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimumAvailableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "policy": {
        "maximumBytes": 1073741824,
        "lowWaterBytes": 536870912,
        "minimumAvailableBytes": 1073741824
      },
      "optionalPath": "^(?:(?:selections|contexts)/[a-f0-9]{64}/)?(?:(?:(?:np|ip|rr)/[a-f0-9]{24}\\.json|inference/emoji-project-json\\.json|(?:inference/)?test-cases\\.json)(?:\\.[0-9]+\\.[0-9]+\\.tmp|\\.records/[0-9a-z]+-[0-9]+-[a-f0-9]{16}\\.(?:pack|idx)(?:\\.[a-f0-9]{8}\\.tmp)?)?|mr/[0-9a-z]+-[0-9]+-[a-f0-9]{16}\\.(?:pack|idx)(?:\\.[a-f0-9]{8}\\.tmp)?|(?:(?:np|ip|rr|inference)/)?ob/[a-f0-9]{64}\\.br(?:\\.[0-9]+\\.[0-9]+\\.tmp)?)$",
      "definitions": {
        "Headroom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumAvailableBytes"
          ],
          "properties": {
            "minimumAvailableBytes": {
              "type": "integer",
              "minimum": 1073741824,
              "maximum": 2684354560
            }
          }
        },
        "WriterFacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "usedBytes",
            "pendingBytes"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "usedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pendingBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "OptionalLedger": {
      "title": "Shared Optional Graph Publication Ledger",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "maximumBytes",
        "usedBytes",
        "dirty"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "protocol": {
        "applicationId": 1397573457,
        "filename": "optional.sqlite",
        "maximumDatabaseBytes": 32768,
        "gateFilename": "optional-gate.sqlite",
        "gateApplicationId": 1397573458,
        "maximumGateDatabaseBytes": 16384,
        "maximumJournalHeaderBytes": 65536,
        "journalPageOverheadBytes": 8,
        "journalMode": "delete",
        "synchronous": 2,
        "cacheSpill": 0,
        "pageBytes": 4096,
        "inventoryEntryLimit": 131072,
        "writerShards": 64
      },
      "definitions": {
        "Publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peakBytes",
            "retainedDeltaBytes"
          ],
          "properties": {
            "peakBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "retainedDeltaBytes": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "WriterScope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity"
          ],
          "properties": {
            "kind": {
              "enum": [
                "selection",
                "dataset"
              ]
            },
            "identity": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "WriterDirectory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "namespace"
          ],
          "properties": {
            "scope": {
              "$ref": "#/definitions/OptionalLedger/definitions/WriterScope"
            },
            "namespace": {
              "enum": [
                "build-input-closures",
                "build-lock-closures",
                "inference",
                "admission"
              ]
            }
          }
        },
        "Maintenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "usedBytes",
            "availableBytes"
          ],
          "properties": {
            "kind": {
              "enum": [
                "full",
                "selection",
                "dataset"
              ]
            },
            "usedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "availableBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "InferenceDataset": {
      "title": "Original Build Inference Dataset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "identity",
        "sourceRoot"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/|[A-Za-z]:)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
        }
      }
    }
  }
}
