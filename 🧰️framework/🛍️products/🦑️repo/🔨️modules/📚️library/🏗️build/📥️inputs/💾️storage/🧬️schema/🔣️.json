      "protocol": {
        "applicationId": 1397573457,
        "filename": "optional.sqlite",
        "maximumDatabaseBytes": 32768,
        "gateFilename": "optional-gate.sqlite",
        "gateApplicationId": 1397573458,
        "maximumGateDatabaseBytes": 16384,
        "maximumJournalHeaderBytes": 65536,
        "journalPageOverheadBytes": 8,
