{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optional Graph Cache Quota",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maximumBytes",
    "usedBytes",
    "availableBytes",
    "minimumAvailableBytes"
  ],
  "properties": {
    "maximumBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "usedBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "availableBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minimumAvailableBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "policy": {
    "maximumBytes": 1073741824,
    "lowWaterBytes": 536870912,
    "minimumAvailableBytes": 1073741824
  },
  "optionalPath": "^(?:(?:selections|contexts)/[a-f0-9]{64}/)?(?:(?:np/[a-f0-9]{24}\\.json|inference/emoji-project-json\\.json|(?:inference/)?test-cases\\.json)(?:\\.[0-9]+\\.[0-9]+\\.tmp|\\.records/[0-9a-z]+-[0-9]+-[a-f0-9]{16}\\.(?:pack|idx)(?:\\.[a-f0-9]{8}\\.tmp)?)?|mr/[0-9a-z]+-[0-9]+-[a-f0-9]{16}\\.(?:pack|idx)(?:\\.[a-f0-9]{8}\\.tmp)?)$",
  "definitions": {
    "Headroom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumAvailableBytes"
      ],
      "properties": {
        "minimumAvailableBytes": {
          "type": "integer",
          "minimum": 1073741824,
          "maximum": 2684354560
        }
      }
    }
  }
}
