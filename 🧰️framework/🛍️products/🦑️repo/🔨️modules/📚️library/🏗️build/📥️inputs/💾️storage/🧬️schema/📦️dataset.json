{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Build Inference Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "identity",
    "sourceRoot"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/|[A-Za-z]:)(?!.*//)(?!.*\/$)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
    }
  }
}
