{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared Optional Graph Publication Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root",
    "maximumBytes",
    "usedBytes",
    "dirty"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "maximumBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "usedBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dirty": {
      "type": "boolean"
    }
  },
  "protocol": {
    "applicationId": 1397573457,
    "filename": "optional.sqlite",
    "maximumDatabaseBytes": 32768,
    "gateFilename": "optional-gate.sqlite",
    "gateApplicationId": 1397573458,
    "maximumGateDatabaseBytes": 16384,
    "maximumJournalHeaderBytes": 65536,
    "journalPageOverheadBytes": 8,
    "journalMode": "delete",
    "synchronous": 2,
    "cacheSpill": 0,
    "pageBytes": 4096,
    "inventoryEntryLimit": 131072,
    "writerShards": 64
  },
  "definitions": {
    "Publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peakBytes",
        "retainedDeltaBytes"
      ],
      "properties": {
        "peakBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retainedDeltaBytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "WriterScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "enum": [
            "selection",
            "dataset"
          ]
        },
        "identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "WriterDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "namespace"
      ],
      "properties": {
        "scope": {
          "$ref": "#/definitions/WriterScope"
        },
        "namespace": {
          "enum": [
            "build-input-closures",
            "build-lock-closures",
            "inference",
            "admission"
          ]
        }
      }
    },
    "Maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "usedBytes",
        "availableBytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "full",
            "selection",
            "dataset"
          ]
        },
        "usedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "availableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
