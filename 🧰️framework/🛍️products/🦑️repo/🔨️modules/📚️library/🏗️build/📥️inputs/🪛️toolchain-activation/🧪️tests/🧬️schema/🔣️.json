{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Toolchain activation corpus",
  "description": "🪛️ Cases of the toolchain activation: the toolchains of a policy, the targets of a project and the toolchains the provisioning dependencies activate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "toolchains", "cases"],
  "properties": {
    "version": { "const": 1 },
    "toolchains": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "properties": { "activatedBy": { "type": "array", "items": { "type": "string" } } } } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "targets", "expect"],
        "properties": {
          "id": { "type": "string" },
          "targets": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "properties": { "dependsOn": { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "object" }] } } } } },
          "expect": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
