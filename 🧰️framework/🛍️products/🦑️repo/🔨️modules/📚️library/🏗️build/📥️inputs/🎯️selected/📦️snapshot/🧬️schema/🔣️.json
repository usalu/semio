{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Selected Native Source Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "inputs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\\\u0000-\\u001f])[^:]+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          }
        }
      }
    }
  },
  "definitions": {
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maximumSourceBytes",
        "maximumSourceFiles",
        "slots",
        "maximumPathCharacters",
        "maximumGrantBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "maximumSourceBytes": {
          "const": 16777216
        },
        "maximumSourceFiles": {
          "const": 8192
        },
        "slots": {
          "const": 16
        },
        "maximumPathCharacters": {
          "const": 256
        },
        "maximumGrantBytes": {
          "const": 4194304
        }
      }
    },
    "Capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest",
        "allocation"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "allocation": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "allocation",
        "request"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "allocation": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "request": {
          "$ref": "#"
        }
      }
    }
  }
}
