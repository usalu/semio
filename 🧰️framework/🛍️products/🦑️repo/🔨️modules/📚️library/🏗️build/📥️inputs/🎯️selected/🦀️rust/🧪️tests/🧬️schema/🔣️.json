{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:selected-rust-corpus:v1",
  "title": "Selected Rust Inventory Corpus",
  "description": "Language-agnostic cases for the selected Rust Native input inventory: a request in, either the sorted literal workspace paths, a fallback (null) or a refusal message out. `expand` appends generated numbered inputs to the first task.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "request", "paths", "error", "expand", "count"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "request": { "type": "object" },
          "paths": { "anyOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }] },
          "error": { "type": "string" },
          "expand": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["prefix", "suffix", "count"], "properties": { "prefix": { "type": "string" }, "suffix": { "type": "string" }, "count": { "type": "integer", "minimum": 1 } } }] },
          "count": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] }
        }
      }
    }
  }
}
