{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Selected Rust Pinned Record Publication Cases",
  "type":"object","additionalProperties":false,"required":["version","graph","cases"],
  "properties":{
    "version":{"const":1},
    "graph":{"type":"object"},
    "cases":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["id","change","mode","tasks","skip","outcome"],"properties":{
      "id":{"type":"string","minLength":1},
      "change":{"enum":["none","missing-path","missing-digest","wrong-path","wrong-digest","changed-record","missing-record","whole-graph"]},
      "mode":{"enum":["prototype","release","invalid"]},
      "tasks":{"enum":["unit","other","none"]},
      "skip":{"enum":["none","daemon","watch","snapshot","non-run"]},
      "outcome":{"enum":["selected","fallback","refused"]}
    }}}
  }
}
