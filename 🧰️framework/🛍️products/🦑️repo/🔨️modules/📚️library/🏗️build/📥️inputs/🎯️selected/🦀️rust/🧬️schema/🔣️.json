{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasks",
    "engineInputs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "inputs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "unit",
              "aggregate",
              "other"
            ]
          },
          "inputs": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "maxItems": 8192,
                "items": {
                  "type": "string",
                  "maxLength": 512
                }
              }
            ]
          }
        }
      }
    },
    "engineInputs": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "requiredFiles": [
          "📋️project.json",
          "nx.json",
          "package.json"
        ],
        "maximumInputs": 8192,
        "maximumBytes": 16777216
      }
    }
  }
}
