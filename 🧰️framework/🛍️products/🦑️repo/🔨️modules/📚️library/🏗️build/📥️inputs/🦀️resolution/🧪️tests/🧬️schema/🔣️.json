{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cargo Resolution Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "files",
    "trees",
    "canonical",
    "crates",
    "queries",
    "edits",
    "toolEdits",
    "refusals",
    "keys",
    "exemptCases",
    "expect"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "trees": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "canonical": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "text"
        ],
        "properties": {
          "value": {},
          "text": {
            "type": "string"
          }
        }
      }
    },
    "crates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^.+:[tb]$"
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "set",
          "note",
          "changed",
          "toolChanged"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "set": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2
            }
          },
          "note": {
            "type": "string"
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "toolChanged": {
            "type": "boolean"
          }
        }
      }
    },
    "toolEdits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "text",
          "changed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "crate",
          "tests",
          "error",
          "trees"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "trees": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "crate": {
            "type": "string"
          },
          "tests": {
            "type": "boolean"
          },
          "error": {
            "enum": [
              "cycle",
              "escape",
              "workspace"
            ]
          }
        }
      }
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "violation"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "violation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "exemptCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "inputs",
          "violations"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "tool",
        "composed"
      ],
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolchain",
            "config"
          ],
          "properties": {
            "toolchain": {
              "type": "string"
            },
            "config": {
              "type": "string"
            }
          }
        },
        "composed": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
