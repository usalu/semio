            "module": "copy",
            "pin": false,
            "expected": false
          }
        ]
      },
      {
        "name": "nested-copy-pin-restores-own-lineage",
        "scopes": [
          {
            "id": "outer",
            "parent": null,
            "module": "copy",
            "pin": true,
            "expected": true
          },
          {
            "id": "inner",
            "parent": "outer",
            "module": "main",
            "pin": true,
            "expected": true
          },
          {
            "id": "child",
            "parent": "inner",
            "module": "copy",
            "pin": false,
            "expected": true
          },
          {
            "id": "outside",
            "parent": null,
            "module": "main",
            "pin": false,
            "expected": false
          }
        ]
      }
    ],
