    "scopeCases": [
      {
        "name": "unrelated-concurrent-lanes",
        "scopes": [
          {
            "id": "owner",
            "parent": null,
            "module": "main",
            "pin": true,
            "expected": true
          },
          {
            "id": "inherited",
            "parent": "owner",
            "module": "copy",
            "pin": false,
            "expected": true
