{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sha256",
    "byteLength",
    "text"
  ],
  "properties": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "text": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 65536
        }
      ]
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumSourceBytes": 8388608,
        "maximumTextBytes": 65536,
        "maximumChunkBytes": 65536,
        "maximumPathUnits": 256,
        "maximumAncestors": 64
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "maximumBytes",
        "retainText",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388609
        },
        "maximumBytes": {
          "type": "number"
        },
        "retainText": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "PhysicalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "primary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "enum": [
            "ancestry",
            "leaf",
            "body",
            "undefined",
            "close",
            "short",
            "eof",
            "changed"
          ]
        }
      }
    },
    "CapturedPhysicalSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "sources"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "ModuleOrigin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^file:"
    },
    "CapturedReadRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "path",
        "sourceCount"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "scope": {
          "enum": [
            "workspace",
            "outside"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "sourceCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "CapturedReadRefusalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path",
        "sources",
        "expected"
      ],
      "properties": {
        "root": {
          "type": "string",
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "expected": {
          "$ref": "#/definitions/CapturedReadRefusal"
        }
      }
    }
  }
}
