{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sha256",
    "byteLength",
    "text"
  ],
  "properties": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "text": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 65536
        }
      ]
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumSourceBytes": 8388608,
        "maximumTextBytes": 65536,
        "maximumChunkBytes": 65536,
        "maximumPathUnits": 256,
        "maximumAncestors": 64
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "maximumBytes",
        "retainText",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388609
        },
        "maximumBytes": {
          "type": "number"
        },
        "retainText": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "PhysicalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "primary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "enum": [
            "ancestry",
            "leaf",
            "body",
            "undefined",
            "close",
            "short",
            "eof",
            "changed"
          ]
        }
      }
    }
  }
}
