{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/build/source/current-revision-cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "initial",
          "edits",
          "changed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "initial": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "changed": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
