       "type": "string"
      },
      "sourceGroup": {
       "type": "string"
      }
     }
    },
    "reads": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "extension"
     ],
     "properties": {
      "extension": {
       "type": "string"
      }
     }
    }
   },
   "const": {
    "version": 1,
    "namespace": "semio.build.inputs.interface/v1",
    "group": "nativeInterface",
    "marker": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/📥️inputs/🔭️interface/🧬️schema/🔣️.json",
    "members": [
     "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/📥️inputs/🔭️interface/🧬️schema/🔣️.json",
     "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/📥️inputs/🔭️interface/🟦️.ts",
     "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🔭️interface/🧬️schema/🔣️.json",
     "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🔭️interface/🟦️.ts"
    ],
    "targets": {
     "names": [
      "check"
     ],
     "scope": "production",
     "dependencyInput": "^nativeSources",
     "sourceGroup": "nativeSources"
    },
    "reads": {
