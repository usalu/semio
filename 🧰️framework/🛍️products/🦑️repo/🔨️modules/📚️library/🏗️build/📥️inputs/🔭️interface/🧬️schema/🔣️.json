     "type": "string"
    },
    "group": {
     "type": "string"
    },
    "marker": {
     "type": "string"
    },
    "members": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "uniqueItems": true
    },
    "targets": {
