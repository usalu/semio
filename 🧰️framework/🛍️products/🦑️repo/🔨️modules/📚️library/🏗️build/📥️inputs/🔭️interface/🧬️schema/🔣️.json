{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "semio.build.inputs.interface/v1",
 "title": "Interface closure of check-class Rust targets: a dependency crate of a check task is keyed by what a type check can observe of its sources, never by their bytes. A closure that lists the marker is such a closure.",
 "definitions": {
  "Policy": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
