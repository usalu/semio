{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:sealed-syntax-corpus:v1",
  "title": "Sealed syntax corpus",
  "description": "Language-agnostic sources with a path (its extension selects the loader) and whether they parse; the runtime's transpiler and the independent TypeScript parser must agree with the verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "source",
          "valid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "\\.[cm]?[jt]sx?$"
          },
          "source": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}