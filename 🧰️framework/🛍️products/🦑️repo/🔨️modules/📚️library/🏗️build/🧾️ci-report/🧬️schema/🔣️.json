{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Closed contracts of the continuous integration report: the CacheStatus and DryRunPlan documents the neutral entry prints, the test results directory a run exports, and the verdicts the report prints. Tool-neutral: nothing here names a build implementation except the `Tool` enumeration of the neutral entry.",
  "definitions": {
    "Tool": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "Activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builds", "actions", "executed", "cacheHits"],
      "properties": {
        "builds": {"type": "integer", "minimum": 0},
        "actions": {"type": "integer", "minimum": 0},
        "executed": {"type": "integer", "minimum": 0},
        "cacheHits": {"type": "integer", "minimum": 0}
      }
    },
    "CacheStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tool", "available", "directory", "entries", "bytes"],
      "properties": {
        "version": {"const": 1},
        "tool": {"$ref": "#/definitions/Tool"},
        "available": {"type": "boolean"},
        "directory": {"type": ["string", "null"]},
        "entries": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "activity": {"$ref": "#/definitions/Activity"}
      }
    },
    "Delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "entries", "bytes", "builds", "actions", "executed", "cacheHits", "hitRate"],
      "properties": {
        "tool": {"$ref": "#/definitions/Tool"},
        "entries": {"type": "integer"},
        "bytes": {"type": "integer"},
        "builds": {"type": "integer"},
        "actions": {"type": "integer"},
        "executed": {"type": "integer"},
        "cacheHits": {"type": "integer"},
        "hitRate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "ProofRule": {"enum": ["log-marker", "activity", "spawn-marker", "none"]},
    "Proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "ok", "rule", "entries", "bytes", "problems"],
      "properties": {
        "tool": {"$ref": "#/definitions/Tool"},
        "ok": {"type": "boolean"},
        "rule": {"$ref": "#/definitions/ProofRule"},
        "entries": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
        "bytes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
        "problems": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "PlanTask": {
      "type": "object",
      "required": ["id", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {
          "type": "object",
          "required": ["project", "target"],
          "properties": {
            "project": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "configuration": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "DryRunPlan": {
      "type": "object",
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "object",
          "required": ["roots", "tasks", "dependencies"],
          "properties": {
            "roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "tasks": {"type": "object", "additionalProperties": {"$ref": "#/definitions/PlanTask"}},
            "dependencies": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}}
          }
        }
      }
    },
    "PlanSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "selected", "projects", "targets"],
      "properties": {
        "tasks": {"type": "integer", "minimum": 0},
        "selected": {"type": "integer", "minimum": 0},
        "projects": {"type": "integer", "minimum": 0},
        "targets": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "Parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equal", "first", "second", "onlyFirst", "onlySecond"],
      "properties": {
        "equal": {"type": "boolean"},
        "first": {"type": "integer", "minimum": 0},
        "second": {"type": "integer", "minimum": 0},
        "onlyFirst": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "onlySecond": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "TestStatus": {"enum": ["passed", "failed", "flaky", "timeout", "error"]},
    "TestResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "status", "cached", "durationMillis", "file"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/definitions/TestStatus"},
        "cached": {"type": "boolean"},
        "durationMillis": {"type": "integer", "minimum": 0},
        "file": {"type": "string", "minLength": 5, "maxLength": 140, "pattern": "^[A-Za-z0-9._-]+$"}
      }
    },
    "TestResultsIndex": {
      "description": "`index.json` of the directory named by SEMIO_BUILD_TEST_RESULTS_DIR: one row per exported JUnit XML file, whose name is the row's `file`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tool", "results"],
      "properties": {
        "version": {"const": 1},
        "tool": {"$ref": "#/definitions/Tool"},
        "results": {"type": "array", "items": {"$ref": "#/definitions/TestResult"}}
      }
    },
    "JUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "failures", "errors", "skipped"],
      "properties": {
        "tests": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "TestsSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "tests", "failures", "errors", "skipped", "failed", "cached"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "tests": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "cached": {"type": "integer", "minimum": 0},
        "failed": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
