{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:leases-status-corpus:v1",
  "title": "Leases Status Corpus",
  "description": "Language-agnostic cases for `repo leases status`: argument vectors with the kind of outcome (text lines, one JSON document or a refusal message), the repository lease directory and the bounds of the admission floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "leaseDirectory",
    "floorMegabytes",
    "commands",
    "environment",
    "floorCases",
    "grantCases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "leaseDirectory": {
      "type": "string",
      "minLength": 1
    },
    "floorMegabytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum",
        "basisPoints"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        },
        "basisPoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "args",
          "outcome"
        ],
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "enum": [
              "text",
              "json",
              "throw"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "SEMIO_LANGUAGE": {
                "enum": [
                  "en",
                  "de"
                ]
              }
            }
          },
          "messageIncludes": {
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": {
            "outcome": {
              "const": "throw"
            }
          }
        },
        "then": {
          "oneOf": [
            {
              "required": [
                "message"
              ]
            },
            {
              "required": [
                "messageIncludes"
              ]
            }
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SEMIO_LANGUAGE": {
          "enum": [
            "en",
            "de"
          ]
        }
      },
      "required": [
        "SEMIO_LANGUAGE"
      ]
    },
    "floorCases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "totalMegabytes",
          "expected"
        ],
        "properties": {
          "totalMegabytes": {
            "type": "integer",
            "minimum": 1
          },
          "expected": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "grantCases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobs",
          "valid"
        ],
        "properties": {
          "jobs": {
            "type": "integer"
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
