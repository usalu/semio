{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:graph-state:platform-class:v1",
  "title": "Which platforms share the inferred project records and the requests of the graph exchange",
  "description": "A project's inferred record is a function of the project's files plus one platform parameter that only a few projects read: `process.platform` in project assembly, only for a target that declares `metadata.semio.hostPlatformOutputsV1` (one project of the repository, the plugin descriptor emitter, whose declaration names a closed enumeration darwin, linux and win32). Everything else that differs between a Windows and a POSIX host is representation and is normalised in the portable record (`../../📦️project-records/🧳️portable`): root spelling, path separators, drive and case of the root, the owner identity of the source analysis providers and the closure keys, which are hashes of texts that name the root. Measured on the production cache (2026-11-15): of 371 projects recorded on win32-x64 and on a POSIX host, 353 have byte-identical result texts once the root token spelling is mapped, the other 18 differ in the tree (generated files that exist on one machine only) or in the keys of the closure recipes, whose recipes are equal in 371 of 371. So a record is keyed by the neutral tag for every platform, a record whose key text names a host-bound declaration is keyed by the exact platform, and the platform classes decide only who serves whom: a machine serves every project of the requests of its own class and, across classes, every project that is not bound to its host; the bound owners of a request of another class are named and left to a machine of that class.",
  "definitions": {
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "classes",
        "hostBound",
        "boundOwners",
        "neutral"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "classes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+-[a-z0-9_]+$"
            }
          }
        },
        "hostBound": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundOwners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "neutral": {
          "type": "string",
          "minLength": 1
        }
      },
      "const": {
        "version": 1,
        "classes": {
          "posix-shared": [
            "darwin-arm64",
            "darwin-x64",
            "linux-x64",
            "linux-arm64"
          ],
          "windows-shared": [
            "win32-x64",
            "win32-arm64"
          ]
        },
        "hostBound": [
          "hostPlatformOutputsV1"
        ],
        "boundOwners": [
          "@semio-tech/os-plugin-describe-rs"
        ],
        "neutral": "all"
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "platform",
        "keyText",
        "record",
        "class"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "keyText": {
          "type": "string"
        },
        "record": {
          "type": "string",
          "description": "the platform tag the record of this project is stored under"
        },
        "class": {
          "type": "string",
          "description": "the class of the platform"
        }
      }
    },
    "Serves": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "requester",
        "serves"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "requester": {
          "type": "string"
        },
        "serves": {
          "type": "boolean"
        }
      }
    },
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "serves",
        "splits"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Case"
          }
        },
        "serves": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Serves"
          }
        },
        "splits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Split"
          }
        }
      }
    },
    "Split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "server",
        "requester",
        "projects",
        "served",
        "left"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "requester": {
          "type": "string"
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "served": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "left": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
