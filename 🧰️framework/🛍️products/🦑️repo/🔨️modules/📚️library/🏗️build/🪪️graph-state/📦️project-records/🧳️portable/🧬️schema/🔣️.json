    "RealCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "windows",
        "posix"
      ],
      "description": "The records of one project as two real machines produced them (stored in the production cache of the fleet on 2026-11-15, written back into the spelling of their producers): a Windows checkout at C:\\\\semio and a POSIX checkout at the root named. Their neutral forms must be equal apart from the volatile stamps of the files.",
      "properties": {
        "name": {
          "type": "string"
