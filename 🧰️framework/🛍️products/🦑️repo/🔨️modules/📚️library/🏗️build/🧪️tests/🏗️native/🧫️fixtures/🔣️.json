{
  "workspaces": [
    "Cargo.toml",
    "🧰️framework/Cargo.toml",
    "🌎️hub/Cargo.toml",
    "🎓️teaching/Cargo.toml"
  ],
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "cmakeEntry": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🛠️cmake/📜️script.ts",
  "cppTargets": [
    "cpp-setup",
    "cpp-configure",
    "cpp-build",
    "cpp-test"
  ],
  "synchronization": {
    "actions": [
      "initial",
      "unchanged",
      "manifest-changed",
      "lock-changed",
      "unrelated-owner"
    ],
    "commands": [
      2,
      0,
      2,
      2,
      2
    ]
  },
  "originalPreparationControl": {
    "maximumElapsedMilliseconds": 120000,
    "transport": {
      "maximumBytes": 1048576,
      "maximumLines": 65536
    }
  },
  "modes": [
    {
      "mode": "prototype",
      "nativeProfile": "prototype",
      "configuration": "Debug",
      "optLevel": "0"
    },
    {
      "mode": "release",
      "nativeProfile": "release",
      "configuration": "Release",
      "optLevel": "3"
    }
  ],
  "centralProfiles": {
    "prototype": {
      "inherits": "dev",
      "opt-level": 0,
      "incremental": true,
      "lto": false,
      "codegen-units": 256
    },
    "release": {
      "opt-level": 3,
      "incremental": false,
      "lto": "thin",
      "codegen-units": 1
    }
  }
}
