{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sourceInputObservation",
    "cases",
    "supplemental"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sourceInputObservation": {
      "const": "freshness"
    },
    "cases": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "target",
          "typedCompiler",
          "runtimeEntries",
          "dataEntries",
          "dispatchOwners"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "typedCompiler": {
            "const": false
          },
          "runtimeEntries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^\\{(?:projectRoot|workspaceRoot)\\}/(?!.*//)(?!(?:[^/]+/)*\\.{1,2}(?:/|$))(?!.*\\.d\\.[cm]?[jt]sx?$)[^\\u0000-\\u001f\\u007f\\\\:*?\"<>|{}\\[\\]]+\\.[cm]?[jt]sx?$"
            }
          },
          "dataEntries": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^\\{(?:workspaceRoot|projectRoot)\\}/(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))[^*?\\[\\]\\\\\\x00-\\x1f\\x7f]+\\.(?:json|ts)$"
            }
          },
          "dispatchOwners": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^.+\\.ts$"
            }
          }
        }
      }
    },
    "supplemental": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "typedCompiler",
          "runtimeEntries",
          "compileEntries",
          "dispatchOwner"
        ],
        "properties": {
          "target": {
            "enum": [
              "repo:test-rustup-protocol",
              "repo:test-authorizers",
              "@semio-tech/value-rs:test-close-demand-source"
            ]
          },
          "typedCompiler": {
            "type": "boolean"
          },
          "runtimeEntries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^\\{(?:projectRoot|workspaceRoot)\\}/(?!.*//)(?!(?:[^/]+/)*\\.{1,2}(?:/|$))(?!.*\\.d\\.[cm]?[jt]sx?$)[^\\u0000-\\u001f\\u007f\\\\:*?\"<>|{}\\[\\]]+\\.[cm]?[jt]sx?$"
            }
          },
          "compileEntries": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^\\{(?:projectRoot|workspaceRoot)\\}/(?!.*//)(?!(?:[^/]+/)*\\.{1,2}(?:/|$))(?!.*\\.d\\.[cm]?[jt]sx?$)[^\\u0000-\\u001f\\u007f\\\\:*?\"<>|{}\\[\\]]+\\.[cm]?[jt]sx?$"
            }
          },
          "dispatchOwner": {
            "type": "string",
            "pattern": "^.+\\.ts$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "typedCompiler": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "compileEntries": {
                  "type": "array",
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "compileEntries": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
