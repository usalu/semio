{
  "type": "object",
  "required": [
    "version",
    "cases",
    "inventoryCases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "name",
          "selection",
          "outcomes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "selection": {
            "enum": [
              "all",
              "tasks"
            ]
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 9,
            "items": {
              "enum": [
                "ready",
                "owner-registry",
                "source-authority",
                "fatal",
                "undefined"
              ]
            }
          },
          "closeFails": {
            "type": "boolean"
          },
          "refreshFails": {
            "type": "boolean"
          }
        }
      }
    },
    "inventoryCases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "name",
          "changeAt",
          "fatal"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "changeAt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "fatal": {
            "enum": [
              "none",
              "frozen",
              "undefined"
            ]
          }
        }
      }
    }
  }
}
