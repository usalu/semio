{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "required", "targets", "dependsOn", "prepared"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "targets": { "type": "object" },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "prepared": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "PreparedTarget": {
      "type": "object", "required": ["dependsOn", "options"],
      "properties": {
        "dependsOn": { "type": "array", "uniqueItems": true, "contains": { "const": "workspace:deps-wasm" } },
        "options": { "type": "object", "required": ["env"], "properties": { "env": { "type": "object", "required": ["SEMIO_WASM_BUILD_REQUIRED"], "properties": { "SEMIO_WASM_BUILD_REQUIRED": { "const": "1" } } } } }
      }
    }
  }
}
