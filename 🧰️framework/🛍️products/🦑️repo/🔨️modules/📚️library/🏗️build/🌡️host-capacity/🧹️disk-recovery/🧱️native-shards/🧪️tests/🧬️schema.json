{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.disk-recovery/NativeShardCasesV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "facts"],
        "properties": {"id": {"type": "string", "minLength": 1}, "facts": {"type": "array", "items": {"$ref": "schema://repo.disk-recovery/NativeShardsV1#/definitions/Fact"}}}
      }
    }
  }
}
