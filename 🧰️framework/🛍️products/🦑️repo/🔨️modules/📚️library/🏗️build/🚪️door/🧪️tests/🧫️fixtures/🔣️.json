{
  "version": 1,
  "plans": [
    {
      "name": "bare repo prints the help",
      "args": [
        "repo"
      ],
      "language": "en",
      "route": {
        "kind": "help",
        "args": []
      }
    },
    {
      "name": "global help",
      "args": [
        "repo",
        "--help"
      ],
      "language": "en",
      "route": {
        "kind": "help",
        "args": [
          "--help"
        ]
      }
    },
    {
      "name": "short help",
      "args": [
        "repo",
        "-h"
      ],
      "language": "en",
      "route": {
        "kind": "help",
        "args": [
          "-h"
        ]
      }
    },
    {
      "name": "command help",
      "args": [
        "repo",
        "run",
        "--help"
      ],
      "language": "en",
      "route": {
        "kind": "help",
        "args": [
          "run",
          "--help"
        ]
      }
    },
    {
      "name": "separate global value is consumed before help",
      "args": [
        "repo",
        "--tool",
        "bazel",
        "run",
        "--help"
      ],
      "language": "en",
      "route": {
        "kind": "help",
        "args": [
          "run",
          "--help"
        ]
      }
    },
    {
      "name": "help of an unknown command is the help renderer's business",
      "args": [
        "repo",
        "nonsense",
        "--help"
      ],
      "language": "en",
      "route": {
        "kind": "help",
        "args": [
          "nonsense",
          "--help"
        ]
      }
    },
    {
      "name": "the language option does not reach the operation",
      "args": [
        "repo",
        "--lang=de",
        "leases",
        "--help"
      ],
      "language": "de",
      "route": {
        "kind": "help",
        "args": [
          "leases",
          "--help"
        ]
      }
    },
    {
      "name": "separate language value",
      "args": [
        "repo",
        "leases",
        "--lang",
        "de",
        "--help"
      ],
      "language": "de",
      "route": {
        "kind": "help",
        "args": [
          "leases",
          "--help"
        ]
      }
    },
    {
      "name": "leases status is light",
      "args": [
        "repo",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status"
        ]
      }
    },
    {
      "name": "global selections are consumed before the command",
      "args": [
        "repo",
        "--tool=nx",
        "--workers",
        "on",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status"
        ]
      }
    },
    {
      "name": "graph policy is consumed in both spellings",
      "args": [
        "repo",
        "--graph-policy=current",
        "--graph-policy",
        "fresh",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status"
        ]
      }
    },
    {
      "name": "light operation keeps its own options",
      "args": [
        "repo",
        "leases",
        "status",
        "--json",
        "--all"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status",
          "--json",
          "--all"
        ]
      }
    },
    {
      "name": "a tail after the separator is opaque to the help request",
      "args": [
        "repo",
        "leases",
        "status",
        "--",
        "--help"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status",
          "--",
          "--help"
        ]
      }
    },
    {
      "name": "doctor is light",
      "args": [
        "repo",
        "doctor",
        "--json",
        "--only=leases"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "doctor",
        "args": [
          "doctor",
          "--json",
          "--only=leases"
        ]
      }
    },
    {
      "name": "capacity status is light",
      "args": [
        "repo",
        "capacity",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "capacity",
        "args": [
          "capacity",
          "status"
        ]
      }
    },
    {
      "name": "capacity run keeps the command tail",
      "args": [
        "repo",
        "capacity",
        "run",
        "--memory=100",
        "--",
        "echo",
        "x"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "capacity",
        "args": [
          "capacity",
          "run",
          "--memory=100",
          "--",
          "echo",
          "x"
        ]
      }
    },
    {
      "name": "no prefix at all",
      "args": [
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status"
        ]
      }
    },
    {
      "name": "an unknown subcommand of a closed set is refused",
      "args": [
        "repo",
        "tools",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "refused",
        "id": "unknownSubcommand",
        "values": {
          "command": "tools",
          "subcommand": "status",
          "known": "@subcommands:tools"
        }
      }
    },
    {
      "name": "a closed set with several subcommands",
      "args": [
        "repo",
        "show",
        "nothing"
      ],
      "language": "en",
      "route": {
        "kind": "refused",
        "id": "unknownSubcommand",
        "values": {
          "command": "show",
          "subcommand": "nothing",
          "known": "projects, project, targets"
        }
      }
    },
    {
      "name": "an unknown command is refused with the catalogue",
      "args": [
        "repo",
        "nonsense"
      ],
      "language": "en",
      "route": {
        "kind": "refused",
        "id": "unknownCommand",
        "values": {
          "command": "nonsense",
          "known": "@operations"
        }
      }
    },
    {
      "name": "a target is not a command",
      "args": [
        "repo",
        "@semio-tech/x:build"
      ],
      "language": "en",
      "route": {
        "kind": "refused",
        "id": "unknownCommand",
        "values": {
          "command": "@semio-tech/x:build",
          "known": "@operations"
        }
      }
    },
    {
      "name": "German refusal values are language free",
      "args": [
        "repo",
        "tools",
        "status"
      ],
      "language": "de",
      "route": {
        "kind": "refused",
        "id": "unknownSubcommand",
        "values": {
          "command": "tools",
          "subcommand": "status",
          "known": "@subcommands:tools"
        }
      }
    },
    {
      "name": "an option value outside the enumeration is refused",
      "args": [
        "repo",
        "--workers=zig",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "refused",
        "id": "invalidValue",
        "values": {
          "option": "--workers",
          "value": "zig",
          "allowed": "on|off"
        }
      }
    },
    {
      "name": "a build implementation is not closed by the door: the backend registry owns the list and the full implementation checks it",
      "args": [
        "repo",
        "--tool=bazel",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status"
        ]
      }
    },
    {
      "name": "workers accept on and off only",
      "args": [
        "repo",
        "--workers=maybe",
        "doctor"
      ],
      "language": "en",
      "route": {
        "kind": "refused",
        "id": "invalidValue",
        "values": {
          "option": "--workers",
          "value": "maybe",
          "allowed": "on|off"
        }
      }
    },
    {
      "name": "an environment workers value outside the enumeration is refused",
      "args": [
        "repo",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "refused",
        "id": "invalidValue",
        "values": {
          "option": "SEMIO_BUILD_WORKERS",
          "value": "zig",
          "allowed": "on|off"
        }
      },
      "environment": {
        "SEMIO_BUILD_WORKERS": "zig"
      }
    },
    {
      "name": "an environment worker switch outside the enumeration is refused",
      "args": [
        "repo",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "refused",
        "id": "invalidValue",
        "values": {
          "option": "SEMIO_BUILD_WORKERS",
          "value": "2",
          "allowed": "on|off"
        }
      },
      "environment": {
        "SEMIO_BUILD_WORKERS": "2"
      }
    },
    {
      "name": "an empty worker switch means unset",
      "args": [
        "repo",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status"
        ]
      },
      "environment": {
        "SEMIO_BUILD_WORKERS": ""
      }
    },
    {
      "name": "the flag overrides a bad environment value",
      "args": [
        "repo",
        "--tool=bazel",
        "leases",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "light",
        "operation": "leases",
        "args": [
          "leases",
          "status"
        ]
      },
      "environment": {
        "SEMIO_BUILD_TOOL": "zig"
      }
    },
    {
      "name": "a task run is the full implementation",
      "args": [
        "repo",
        "run",
        "a:b"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    },
    {
      "name": "a task tail with help is opaque",
      "args": [
        "repo",
        "run",
        "a:b",
        "--",
        "--help"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    },
    {
      "name": "the dashboard target goes to the full implementation even with help",
      "args": [
        "repo",
        "run",
        "@semio-tech/repo-dashboard-rs:build",
        "--help"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    },
    {
      "name": "cache status is not light",
      "args": [
        "repo",
        "cache",
        "status"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    },
    {
      "name": "show projects is a declared subcommand",
      "args": [
        "repo",
        "show",
        "projects"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    },
    {
      "name": "an option in the subcommand position is not a subcommand",
      "args": [
        "repo",
        "dependencies",
        "--all"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    },
    {
      "name": "tools setup is declared",
      "args": [
        "repo",
        "tools",
        "setup",
        "nx"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    },
    {
      "name": "the build script route is untouched",
      "args": [
        "build",
        "canvas",
        "fonts"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    },
    {
      "name": "the test script route is untouched",
      "args": [
        "test",
        "bazel"
      ],
      "language": "en",
      "route": {
        "kind": "full"
      }
    }
  ],
  "refusals": [
    {
      "id": "unknownCommand",
      "values": {
        "command": "foo",
        "known": "a, b"
      },
      "text": {
        "en": "Unknown command \"foo\". Known commands: a, b. Run \"repo --help\" for the list.",
        "de": "Unbekannter Befehl \"foo\". Bekannte Befehle: a, b. \"repo --help\" zeigt die Liste."
      }
    },
    {
      "id": "unknownSubcommand",
      "values": {
        "command": "tools",
        "subcommand": "status",
        "known": "setup"
      },
      "text": {
        "en": "Unknown subcommand \"status\" of \"tools\". Known subcommands: setup. Run \"repo tools --help\".",
        "de": "Unbekannter Unterbefehl \"status\" von \"tools\". Bekannte Unterbefehle: setup. \"repo tools --help\" zeigt die Hilfe."
      }
    },
    {
      "id": "invalidValue",
      "values": {
        "option": "--tool",
        "value": "zig",
        "allowed": "nx|bazel"
      },
      "text": {
        "en": "--tool accepts nx|bazel, not \"zig\".",
        "de": "--tool akzeptiert nx|bazel, nicht \"zig\"."
      }
    }
  ],
  "roots": [
    {
      "name": "nearest marker pair wins",
      "files": {
        "a/b/c/x": "",
        "a/package.json": "{\"workspaces\":[\"p\"]}",
        "a/📋️project.json": "{}",
        "a/b/package.json": "{}"
      },
      "start": "a/b/c",
      "expected": "a"
    },
    {
      "name": "the start itself may be the root",
      "files": {
        "p/q/package.json": "{\"workspaces\":[]}",
        "p/q/📋️project.json": "{}",
        "p/q/x": ""
      },
      "start": "p/q",
      "expected": "p/q"
    },
    {
      "name": "workspaces object counts",
      "files": {
        "w/package.json": "{\"workspaces\":{\"packages\":[]}}",
        "w/📋️project.json": "{}",
        "w/q/x": ""
      },
      "start": "w/q",
      "expected": "w"
    },
    {
      "name": "missing marker pair refuses",
      "files": {
        "m/package.json": "{\"workspaces\":[]}",
        "m/n/x": ""
      },
      "start": "m/n",
      "expected": null
    }
  ]
}
