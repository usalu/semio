{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neutral Build Orchestration Delegation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "children"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "orchestration"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "target"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^:\\s\\u0000]+$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "configuration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "enum": [
              "prototype",
              "release"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "target"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^:\\s\\u0000]+$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "configuration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "enum": [
            "prototype",
            "release"
          ]
        }
      }
    },
    "Policy": {
      "const": {
        "maximumChildren": 64,
        "maximumGraphBytes": 268435456,
        "readChunkBytes": 1048576
      }
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "task",
        "targets"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "task": {
          "$ref": "#/definitions/Task"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project",
              "target",
              "delegation"
            ],
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^:\\s\\u0000]+$"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "delegation": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
