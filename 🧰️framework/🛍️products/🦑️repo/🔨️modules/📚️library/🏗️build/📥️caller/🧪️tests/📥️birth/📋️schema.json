{
  "type": "object",
  "required": [
    "version",
    "cases",
    "childArguments",
    "ceilings",
    "defaultPolicy",
    "budgetCases",
    "preparationCases",
    "pressureCases",
    "controlCases",
    "diagnosticCases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "args",
          "mode",
          "main"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "enum": [
              "prototype",
              "release"
            ]
          },
          "main": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "watch": {
            "type": "string"
          }
        }
      }
    },
    "childArguments": {
      "const": [
        "run",
        "app:test"
      ]
    },
    "ceilings": {
      "const": {
        "transport": {
          "maximumBytes": 12345,
          "maximumLines": 123
        },
        "child": {
          "maximumElapsedMilliseconds": 1234
        },
        "network": {
          "offline": true
        }
      }
    },
    "defaultPolicy": {
      "const": {
        "version": 1,
        "owner": "repository:build",
        "maximumElapsedMilliseconds": 0
      }
    },
    "budgetCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "environment",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "preparationCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requested",
          "parent",
          "expected"
        ],
        "properties": {
          "requested": {
            "type": "integer",
            "minimum": 0
          },
          "parent": {
            "type": "integer",
            "minimum": 0
          },
          "expected": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "pressureCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "accepted",
          "effects"
        ],
        "properties": {
          "kind": {
            "enum": [
              "valid",
              "copied-control",
              "copied-original"
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "effects": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "controlCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "neutralBootstrap"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "neutralBootstrap": {
            "type": "boolean"
          }
        }
      }
    },
    "diagnosticCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "args",
          "route",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "route": {
            "enum": [
              "capacity",
              "leases",
              "help",
              "admitted"
            ]
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language": {
            "enum": [
              "en",
              "de"
            ]
          }
        }
      }
    }
  }
}
