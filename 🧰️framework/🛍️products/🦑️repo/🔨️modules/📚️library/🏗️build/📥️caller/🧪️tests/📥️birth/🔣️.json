  "budgetCases": [
    {
      "name": "ordinary-viewer",
      "environment": {},
      "expected": 0
    },
    {
      "name": "explicit-unlimited-viewer",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "0"
      },
      "expected": 0
    },
    {
      "name": "explicit-finite-original",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "21600000"
      },
      "expected": 21600000
    },
    {
      "name": "invalid-original",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "-1"
      },
      "expected": null
    }
  ],
