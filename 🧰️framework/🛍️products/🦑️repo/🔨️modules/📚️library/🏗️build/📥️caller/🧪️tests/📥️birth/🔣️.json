  "ceilings": {
    "transport": {
      "maximumBytes": 12345,
      "maximumLines": 123
    },
    "child": {
      "maximumElapsedMilliseconds": 1234
    },
    "network": {
      "offline": true
    }
  },
  "defaultPolicy": {
    "version": 1,
    "owner": "repository:build",
    "maximumElapsedMilliseconds": 0
