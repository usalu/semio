  "ceilings": {
    "transport": {
      "maximumBytes": 12345,
      "maximumLines": 123
    },
    "child": {
      "maximumElapsedMilliseconds": 1234
    },
    "network": {
      "offline": true
    }
  },
  "defaultPolicy": {
    "version": 1,
    "owner": "repository:build",
    "maximumElapsedMilliseconds": 0
  },
  "budgetCases": [
    {
      "name": "ordinary-viewer",
      "environment": {},
      "expected": 0
    },
    {
      "name": "explicit-unlimited-viewer",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "0"
      },
      "expected": 0
    },
    {
      "name": "explicit-finite-original",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "21600000"
      },
      "expected": 21600000
    },
    {
      "name": "invalid-original",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "-1"
      },
      "expected": null
    }
  ],
  "preparationCases": [
    {
      "requested": 5000,
      "parent": 1000,
      "expected": 1000
