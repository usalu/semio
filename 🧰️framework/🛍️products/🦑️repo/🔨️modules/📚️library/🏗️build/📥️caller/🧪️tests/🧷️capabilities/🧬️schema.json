{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commands",
    "modes",
    "rows",
    "diagnostics"
  ],
  "properties": {
    "commands": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "modes": {
      "const": [
        "prototype",
        "release"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "patch",
          "valid"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "patch": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "op",
                "path"
              ],
              "properties": {
                "op": {
                  "enum": [
                    "add",
                    "remove",
                    "replace"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "value": {}
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "environment",
          "expectedPath",
          "forbidden"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expectedPath": {
            "type": "string"
          },
          "forbidden": {
            "type": "string"
          }
        }
      }
    }
  }
}
