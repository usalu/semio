{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "platform", "architecture", "distribution", "distributionVersion", "minimumAvailableBytes", "minimumFreeLoops", "tools"],
      "properties": {
        "version": {"const": 1}, "platform": {"const": "linux"}, "architecture": {"enum": ["x64", "arm64"]},
        "distribution": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "distributionVersion": {"type": "string", "pattern": "^[0-9]+$"},
        "minimumAvailableBytes": {"type": "integer", "minimum": 1}, "minimumFreeLoops": {"type": "integer", "minimum": 1, "maximum": 64},
        "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}}
      }
    },
    "Facts": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "architecture", "distribution", "distributionVersion", "capEff", "availableBytes", "loopControl", "freeLoops", "tools"],
      "properties": {
        "platform": {"type": "string"}, "architecture": {"type": "string"}, "distribution": {"type": "string"}, "distributionVersion": {"type": "string"},
        "capEff": {"type": "string", "pattern": "^[0-9a-fA-F]{1,16}$"}, "availableBytes": {"type": "integer", "minimum": 0},
        "loopControl": {"type": "boolean"}, "freeLoops": {"type": "integer", "minimum": 0},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "Registry": {
      "type": "object", "additionalProperties": false, "required": ["version", "scopes"],
      "properties": {
        "version": {"const": 1},
        "scopes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["owner", "project"], "properties": {
          "owner": {"type": "string", "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"}, "project": {"type": "string", "minLength": 1}
        }}}
      }
    }
  }
}
