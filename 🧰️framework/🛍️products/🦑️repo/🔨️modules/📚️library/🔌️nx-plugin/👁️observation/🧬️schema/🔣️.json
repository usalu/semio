{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/nx-plugin/inference-observation/v1",
  "title": "Nx inference observation record",
  "description": "The first line of a persisted inference cache: the digest of the implementation revision and inference key, plus every filesystem fact the computation observed. The second line is the exactly JSON-representable result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["digest", "observations"],
  "properties": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "fact"],
        "properties": {
          "kind": { "enum": ["file", "exists", "stat", "lstat", "readdir", "realpath", "realpathNative", "resolve"] },
          "path": { "type": "string", "minLength": 1 },
          "fact": {
            "oneOf": [
              { "type": "boolean" },
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["size", "mtimeMs", "ctimeMs", "ino", "sha256"],
                "properties": {
                  "size": { "type": "integer", "minimum": 0 },
                  "mtimeMs": { "type": "number" },
                  "ctimeMs": { "type": "number" },
                  "ino": { "type": "integer", "minimum": 0 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["error"],
                "properties": { "error": { "type": "string", "minLength": 1 } }
              }
            ]
          }
        }
      }
    }
  }
}
