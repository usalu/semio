{
  "schemaVersion": 1,
  "files": { "a/one.txt": "1", "a/two.txt": "2", "b/three.txt": "3" },
  "scenarios": [
    { "id": "unchanged", "mutation": { "op": "none" }, "expected": "hit" },
    { "id": "identical-rewrite", "mutation": { "op": "write", "path": "a/one.txt", "content": "1" }, "expected": "hit" },
    { "id": "content-change", "mutation": { "op": "write", "path": "a/one.txt", "content": "one" }, "expected": "miss" },
    { "id": "same-size-content-change", "mutation": { "op": "write", "path": "a/one.txt", "content": "9" }, "expected": "miss" },
    { "id": "probed-absence-created", "mutation": { "op": "write", "path": "c/missing.txt", "content": "x" }, "expected": "miss" },
    { "id": "listing-change", "mutation": { "op": "write", "path": "a/new.txt", "content": "n" }, "expected": "miss" },
    { "id": "unobserved-change", "mutation": { "op": "write", "path": "b/three.txt", "content": "333" }, "expected": "hit" },
    { "id": "type-change", "mutation": { "op": "replace-directory-with-file", "path": "b" }, "expected": "miss" }
  ]
}
