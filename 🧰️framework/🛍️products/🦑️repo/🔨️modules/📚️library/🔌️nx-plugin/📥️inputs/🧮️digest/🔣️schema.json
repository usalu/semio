{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact Source Closure",
  "type": "object",
  "required": [
    "version",
    "files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\\\u0000]+$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SourceDigestReceipt": {
      "type": "object",
      "required": [
        "version",
        "values"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "values": {
          "type": "object",
          "patternProperties": {
            "^SEMIO_(?:SOURCE_CLOSURE|CARGO_LOCK)_[a-f0-9]{64}$": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
