{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/discovery/schema-reads/schema.json",
  "$defs": {
    "SchemaSourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash",
        "selector",
        "start",
        "end"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "type": "string"
        },
        "selector": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SchemaValidationRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value",
        "callStart",
        "callEnd",
        "resolution"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaSourceOrigin"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaSourceOrigin"
            },
            {
              "type": "null"
            }
          ]
        },
        "callStart": {
          "type": "integer",
          "minimum": 0
        },
        "callEnd": {
          "type": "integer",
          "minimum": 0
        },
        "resolution": {
          "enum": [
            "whole",
            "projected",
            "unresolved"
          ]
        },
        "inlineSchema": {
          "type": "object"
        }
      }
    },
    "SchemaReadIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "reason"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "SchemaValidationReadReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readerPath",
        "readerHash",
        "completeSyntax",
        "reads",
        "unresolved"
      ],
      "properties": {
        "readerPath": {
          "type": "string"
        },
        "readerHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "completeSyntax": {
          "type": "boolean"
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaValidationRead"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaReadIssue"
          }
        }
      }
    },
    "SchemaReadProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "completed",
        "total",
        "path"
      ],
      "properties": {
        "phase": {
          "enum": [
            "walk",
            "inspect"
          ]
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SchemaValidationReadIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reports",
        "unavailablePaths"
      ],
      "properties": {
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaValidationReadReport"
          }
        },
        "unavailablePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
