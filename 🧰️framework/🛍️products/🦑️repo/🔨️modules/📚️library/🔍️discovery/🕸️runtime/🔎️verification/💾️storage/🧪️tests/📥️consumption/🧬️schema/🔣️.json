{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "calls",
          "consumption",
          "operations",
          "consumes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "calls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "consumption": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "resolution"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "producer",
                  "operation"
                ],
                "properties": {
                  "kind": {
                    "const": "compiler"
                  },
                  "producer": {
                    "const": "artifact"
                  },
                  "operation": {
                    "const": "build"
                  }
                }
              }
            ]
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "enum": [
                "rustc",
                "build",
                null
              ]
            }
          },
          "consumes": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        }
      }
    }
  }
}
