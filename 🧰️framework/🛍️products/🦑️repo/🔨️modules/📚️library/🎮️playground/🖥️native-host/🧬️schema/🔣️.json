{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.playground.native-host/v1",
  "$defs": {
    "NativeHostV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cratePath",
        "project",
        "package",
        "binary",
        "target"
      ],
      "properties": {
        "cratePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000]+$"
        },
        "project": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:@[a-z0-9][a-z0-9-]*/)?[a-z0-9][a-z0-9-]*$"
        },
        "package": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "binary": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "target": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "NativeHostOwnerFactsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "project",
        "binaries",
        "targets",
        "modes"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "binaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "modes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "prototype",
                "release"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "NativeHostSourceFactsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "project",
        "binaries",
        "targets",
        "modes",
        "outputs"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "binaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "modes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "prototype",
                "release"
              ]
            },
            "uniqueItems": true
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prototype",
              "release"
            ],
            "properties": {
              "prototype": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "release": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "NativeHostScriptAdmissionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withinLimit"
      ],
      "properties": {
        "withinLimit": {
          "type": "boolean"
        }
      }
    },
    "NativeHostMessagesV1": {
      "description": "The refusal of an executable host that disagrees with its authored producer, per language; {placeholders} are filled by the admission.",
      "const": {
        "languages": [
          "en",
          "de"
        ],
        "fields": {
          "en": {
            "package": "package",
            "project": "project",
            "binary": "binary",
            "target": "target",
            "modes": "modes"
          },
          "de": {
            "package": "Paket",
            "project": "Projekt",
            "binary": "Programm",
            "target": "Ziel",
            "modes": "Modi"
          }
        },
        "texts": {
          "en": {
            "mismatch": "Native host does not match its authored producer{context}: declared project {project} at {cratePath}; {differences}.",
            "difference": "{field}: declared \"{declared}\", authored {authored}",
            "none": "none"
          },
          "de": {
            "mismatch": "Der native Host passt nicht zu seinem verfassten Erzeuger{context}: deklariertes Projekt {project} unter {cratePath}; {differences}.",
            "difference": "{field}: deklariert \"{declared}\", verfasst {authored}",
            "none": "keine"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/NativeHostV1"
}
