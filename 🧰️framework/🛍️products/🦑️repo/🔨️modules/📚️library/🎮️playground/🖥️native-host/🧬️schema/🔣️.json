{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.playground.native-host/v1",
  "$defs": {
    "NativeHostV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cratePath",
        "project",
        "package",
        "binary",
        "target"
      ],
      "properties": {
        "cratePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000]+$"
        },
        "project": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:@[a-z0-9][a-z0-9-]*/)?[a-z0-9][a-z0-9-]*$"
        },
        "package": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "binary": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "target": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    }
  },
  "$ref": "#/$defs/NativeHostV1"
}
