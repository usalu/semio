{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/library/schema.json",
  "title": "MutationDescriptor",
  "description": "Language-neutral identity and registry metadata for one authoritative direct mutation leaf.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owner",
    "semanticKind",
    "displayName",
    "emoji",
    "aggregateVariant",
    "payloadSchema",
    "textOpcode",
    "binaryTag",
    "invertibility",
    "diffParticipation",
    "outcomeClasses",
    "composition",
    "requiredLanguageSurfaces"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!compose(?:/|$))(?!.*(?:^|/)compose(?:/|$)).+/🧬️mutations/.+$"
    },
    "semanticKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "emoji": {
      "type": "string",
      "minLength": 1
    },
    "aggregateVariant": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "payloadSchema": {
      "type": "string",
      "minLength": 1
    },
    "textOpcode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "binaryTag": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "null"
        }
      ]
    },
    "invertibility": {
      "enum": [
        "self",
        "explicit-mutation",
        "plan",
        "non-invertible"
      ]
    },
    "diffParticipation": {
      "enum": [
        "detect",
        "apply-only",
        "plan",
        "none"
      ]
    },
    "outcomeClasses": {
      "description": "🎯️ Every protocol outcome class the leaf's own diff can reach, read from its code: `applied` (a change), `no-op` (no change, no refusal), `empty`/`disjoint` (format-defined empty or disjoint results), `rejected` (an Error or Fatal message). Bridges and manifests carry these values verbatim.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "applied",
          "no-op",
          "empty",
          "disjoint",
          "rejected"
        ]
      }
    },
    "composition": {
      "enum": [
        "atomic",
        "composite"
      ]
    },
    "requiredLanguageSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "rust"
      },
      "items": {
        "enum": [
          "rust",
          "typescript",
          "graphql",
          "protobuf",
          "json-schema",
          "text",
          "binary"
        ]
      }
    }
  }
}
