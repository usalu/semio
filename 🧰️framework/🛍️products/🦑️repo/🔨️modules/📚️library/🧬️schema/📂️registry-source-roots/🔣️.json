{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/registry-source-roots.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f])(?!.*(?:^|/)\\.(?:/|$))[^/]+(?:/[^/]+)*$"
      }
    }
  }
}
