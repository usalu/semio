{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owners", "contexts", "consumers", "artifactEnvironment", "route"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owners": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "directoryName", "parentKindId", "kindId", "declarations"],
        "properties": {
          "path": { "type": "string", "pattern": "/🟦️\\.ts$" },
          "directoryName": { "type": "string" },
          "parentKindId": { "type": "string" },
          "kindId": { "type": "string" },
          "declarations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directoryName", "parentKindId", "kindId"],
        "properties": {
          "directoryName": { "type": "string" },
          "parentKindId": { "type": "string" },
          "kindId": { "type": "string" }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owners"],
        "properties": {
          "path": { "type": "string" },
          "owners": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "artifactEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "defaultRelativeRoot", "explicitRelativeRoot", "routes"],
      "properties": {
        "owner": { "type": "string", "pattern": "/🟦️\\.ts$" },
        "defaultRelativeRoot": { "type": "string", "pattern": "^\\.🧬semio/.+/🗑️generated/" },
        "explicitRelativeRoot": { "type": "string", "pattern": "^\\.🧬semio/.+/🗑️generated/" },
        "routes": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "command", "launchName", "launchCommand"],
      "properties": {
        "target": { "type": "string" },
        "command": { "type": "string" },
        "launchName": { "type": "string" },
        "launchCommand": { "type": "string" }
      }
    }
  }
}
