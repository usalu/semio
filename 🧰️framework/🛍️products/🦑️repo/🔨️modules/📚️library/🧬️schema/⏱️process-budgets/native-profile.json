{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configPath",
    "profile",
    "coverage",
    "workspaces",
    "periods",
    "nativePackage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "configPath": {
      "const": ".config/nextest.toml"
    },
    "profile": {
      "enum": [
        "fundamental",
        "quick",
        "long",
        "exhaustive"
      ]
    },
    "coverage": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "boolean"
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "directory",
          "overrideCount"
        ],
        "properties": {
          "directory": {
            "enum": [
              ".",
              "✏️s",
              "🌎️hub",
              "🎓️teaching"
            ]
          },
          "overrideCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "periods": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fundamental",
        "quick",
        "long",
        "exhaustive"
      ],
      "properties": {
        "fundamental": {
          "const": "15s"
        },
        "quick": {
          "const": "300s"
        },
        "long": {
          "const": "900s"
        },
        "exhaustive": {
          "const": "1800s"
        }
      }
    },
    "nativePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "workspace",
        "manifest"
      ],
      "properties": {
        "name": {
          "const": "semio-s-artifact-stdio-mp4"
        },
        "workspace": {
          "const": "✏️s"
        },
        "manifest": {
          "const": "✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🎥️mp4/📦️packages/🦀️rust/Cargo.toml"
        }
      }
    }
  }
}
