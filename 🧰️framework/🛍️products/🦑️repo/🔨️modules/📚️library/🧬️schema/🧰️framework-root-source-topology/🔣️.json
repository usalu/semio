{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/framework-root-source-topology.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "moves", "packages", "directoryContexts"],
  "properties": {
    "version": { "const": 1 },
    "moves": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "owner", "kind", "anchor", "consumer"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["rust", "typescript"] },
          "anchor": { "type": "string", "minLength": 1 },
          "consumer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust", "typescript"],
      "properties": {
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "entry", "name", "feature", "maximumEntryLines"],
          "properties": {
            "manifest": { "type": "string", "minLength": 1 },
            "entry": { "type": "string", "minLength": 1 },
            "name": { "const": "semio-framework" },
            "feature": { "const": "typegen" },
            "maximumEntryLines": { "type": "integer", "minimum": 1 }
          }
        },
        "typescript": { "$ref": "#/definitions/nodePackage" }
      }
    },
    "directoryContexts": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "parentKind", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "parentKind": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "nodePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "entry", "name", "maximumEntryLines", "testOwner", "vitestConfig"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "maximumEntryLines": { "type": "integer", "minimum": 1 },
        "testOwner": { "type": "string", "minLength": 1 },
        "vitestConfig": { "type": "string", "minLength": 1 }
      }
    }
  }
}
