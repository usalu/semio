{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/taxonomy/planner-blockers/v1",
  "title": "Taxonomy planner blocker laws",
  "description": "Decoded command strings with the exact embedded-argv path candidates the JSON reference adapter must emit for them once JSON-encoded into a launch configuration, plus the frozen evidence contract whose tampered bytes must become a planner violation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "argumentCases", "frozenEvidenceContractId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "argumentCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "values"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "command": { "type": "string", "minLength": 1 },
          "values": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "frozenEvidenceContractId": { "type": "string", "minLength": 1 }
  }
}
