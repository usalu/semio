{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "contract",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "runtime-taxonomy-asset-paths-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "valid"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
