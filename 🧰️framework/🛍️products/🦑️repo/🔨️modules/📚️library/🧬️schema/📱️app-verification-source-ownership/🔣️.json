{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/app-verification-source-ownership.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["owners", "routers", "directoryContexts", "consumers", "registration"],
  "properties": {
    "owners": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "language", "exports"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "language": { "enum": ["typescript", "python"] },
          "exports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "routers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "maximumLines"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "maximumLines": { "type": "integer", "minimum": 1, "maximum": 40 }
        }
      }
    },
    "directoryContexts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "parentKind", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "parentKind": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owners"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "owners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "target"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}
