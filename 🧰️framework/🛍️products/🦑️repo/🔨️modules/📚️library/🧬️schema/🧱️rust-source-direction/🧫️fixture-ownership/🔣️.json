{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "domains",
              "inline-controls",
              "raster-residency",
              "paint-editing"
            ]
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "former": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consumers": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "fixtureReference": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "fixtureReference"
              ]
            }
          }
        },
        "required": [
          "id",
          "fixture",
          "schema",
          "former",
          "sha256",
          "consumers"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "cases"
  ]
}
