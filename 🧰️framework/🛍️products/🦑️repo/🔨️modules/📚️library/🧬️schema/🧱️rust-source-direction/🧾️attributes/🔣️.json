{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.repo.rust-source-attributes/v1",
  "$ref": "#/$defs/result",
  "$defs": {
    "reference": {
      "$ref": "https://json.schemas.assets.semio-tech.com/framework/compiler/syntax/rust#/$defs/reference"
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "references"
          ],
          "properties": {
            "state": {
              "const": "resolved"
            },
            "references": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "unsupported-expression"
            }
          }
        }
      ]
    }
  }
}
