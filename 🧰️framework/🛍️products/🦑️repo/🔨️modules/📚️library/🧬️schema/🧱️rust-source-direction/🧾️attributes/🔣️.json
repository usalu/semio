{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases",
    "featureCases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "featureCases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "modulePath",
          "resolved",
          "native",
          "diagnostic",
          "files",
          "mountPath",
          "mountResolved"
        ],
        "properties": {
          "id": {
            "enum": [
              "crate-associated-type-defaults",
              "unknown-crate-feature",
              "mixed-crate-features",
              "outer-associated-type-defaults",
              "inline-associated-type-defaults",
              "out-of-line-feature-is-not-crate-authority"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "modulePath": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "const": "subject"
            }
          },
          "resolved": {
            "type": "boolean"
          },
          "native": {
            "type": "boolean"
          },
          "diagnostic": {
            "enum": [
              "none",
              "E0635",
              "E0658"
            ]
          },
          "files": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject.rs": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "mountPath": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "const": "subject"
            }
          },
          "mountResolved": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "line"
      ],
      "properties": {
        "kind": {
          "const": "include_str"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "references"
          ],
          "properties": {
            "state": {
              "const": "resolved"
            },
            "references": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "unsupported-expression"
            }
          }
        }
      ]
    },
    "removal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paths",
            "native"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "allOf": [
                {
                  "$ref": "#/$defs/inputs"
                }
              ],
              "minItems": 1
            },
            "native": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "files",
        "nativeInputs",
        "result",
        "removal"
      ],
      "properties": {
        "id": {
          "enum": [
            "active-outer-documentation",
            "active-inner-documentation",
            "dormant-outer-documentation",
            "dormant-inner-documentation",
            "outer-opaque-attribute",
            "inner-opaque-attribute",
            "opaque-documentation-macro",
            "outer-documentation-string-decoy",
            "inner-documentation-string-decoy"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]+\\.txt$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "nativeInputs": {
          "type": "array",
          "allOf": [
            {
              "$ref": "#/$defs/inputs"
            }
          ],
          "items": {
            "type": "string",
            "pattern": "^(?:source\\.rs|[a-z]+\\.txt)$"
          }
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "removal": {
          "$ref": "#/$defs/removal"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "unsupported-expression"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "removal": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
