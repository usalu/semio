{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "routes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "sourcePath",
          "sourceScope",
          "specifier",
          "unavailable",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "alternate": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "sourceScope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "specifier": {
            "type": "string",
            "minLength": 1
          },
          "unavailable": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "targets",
                  "provenance",
                  "reason"
                ],
                "properties": {
                  "state": {
                    "const": "admitted"
                  },
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  },
                  "provenance": {
                    "const": "graph"
                  },
                  "reason": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "targets",
                  "provenance",
                  "reason"
                ],
                "properties": {
                  "state": {
                    "const": "denied"
                  },
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true,
                    "maxItems": 0
                  },
                  "provenance": {
                    "type": "null"
                  },
                  "reason": {
                    "enum": [
                      "invalid-manifest",
                      "unavailable-manifest",
                      "unresolved-target",
                      "unresolved-scope",
                      "unavailable-source",
                      "conflicting-target",
                      "cyclic-target",
                      "nonportable-target"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "targets",
                  "provenance",
                  "reason"
                ],
                "properties": {
                  "state": {
                    "const": "unmounted"
                  },
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "provenance": {
                    "enum": [
                      "physical",
                      null
                    ]
                  },
                  "reason": {
                    "enum": [
                      null,
                      "unmounted-path",
                      "unavailable-source",
                      "unresolved-scope",
                      "ambiguous-local-target",
                      "nonportable-target"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
