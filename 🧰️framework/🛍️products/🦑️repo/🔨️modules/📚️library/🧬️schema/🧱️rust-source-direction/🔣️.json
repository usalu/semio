{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.repo.rust-source-direction/v1",
  "$ref": "#/$defs/report",
  "$defs": {
    "moduleMetadataProblem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "attributes"
          ],
          "properties": {
            "code": {
              "const": "unsupported-attribute"
            },
            "attributes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "paths"
          ],
          "properties": {
            "code": {
              "const": "ambiguous-path"
            },
            "paths": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      ]
    },
    "moduleScopeFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "modulePath",
        "bodyStartOffset",
        "bodyEndOffset"
      ],
      "properties": {
        "kind": {
          "enum": [
            "root",
            "inline"
          ]
        },
        "modulePath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bodyStartOffset": {
          "type": "integer",
          "minimum": 0
        },
        "bodyEndOffset": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "$ref": "#/$defs/moduleMetadataProblem"
        },
        "crateCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "associated_type_defaults"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "crateCapabilities"
            ],
            "properties": {
              "crateCapabilities": {}
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "root"
              },
              "modulePath": {
                "maxItems": 0,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "moduleScopeProof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "scopes"
          ],
          "properties": {
            "state": {
              "const": "resolved"
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/moduleScopeFact"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "modulePath",
            "problem"
          ],
          "properties": {
            "state": {
              "const": "unresolved"
            },
            "modulePath": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "problem": {
              "oneOf": [
                {
                  "$ref": "#/$defs/moduleMetadataProblem"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "count"
                  ],
                  "properties": {
                    "code": {
                      "const": "scope-not-unique"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "files",
        "references",
        "violations",
        "problems",
        "runtime"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "references": {
          "type": "integer",
          "minimum": 0
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "from",
              "to",
              "kind",
              "line"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "include",
                  "include_str",
                  "include_bytes",
                  "path"
                ]
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "expansion": {
                "$ref": "#/$defs/compileExpansion"
              }
            }
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "from",
              "detail"
            ],
            "properties": {
              "code": {
                "enum": [
                  "unsupported-expression",
                  "unresolved-target",
                  "linked-input",
                  "missing-input",
                  "non-directory-ancestor",
                  "unexpected-input-kind",
                  "uncensused-source",
                  "unresolved-template-scope"
                ]
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "include",
                  "include_str",
                  "include_bytes",
                  "path"
                ]
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "expansion": {
                "$ref": "#/$defs/compileExpansion"
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "references",
            "violations"
          ],
          "properties": {
            "scope": {
              "const": "owner-qualified-literal-first-arguments"
            },
            "references": {
              "type": "integer",
              "minimum": 0
            },
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule",
                  "from",
                  "to",
                  "line",
                  "call",
                  "context",
                  "start",
                  "end"
                ],
                "properties": {
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "call": {
                    "type": "string",
                    "minLength": 1
                  },
                  "context": {
                    "enum": [
                      "method",
                      "qualified"
                    ]
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "macroScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "modulePath"
          ],
          "properties": {
            "kind": {
              "const": "module"
            },
            "modulePath": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "startOffset",
            "endOffset"
          ],
          "properties": {
            "kind": {
              "const": "local-block"
            },
            "startOffset": {
              "type": "integer",
              "minimum": 0
            },
            "endOffset": {
              "type": "integer",
              "minimum": 0
            },
            "compilerAttributes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "test",
                  "doc"
                ]
              }
            }
          }
        }
      ]
    },
    "compileExpansion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "macro",
        "definitionLine",
        "invocationLine",
        "definitionOffset",
        "templateOffset",
        "invocationOffset",
        "scope"
      ],
      "properties": {
        "kind": {
          "const": "local-macro"
        },
        "macro": {
          "type": "string",
          "minLength": 1
        },
        "definitionLine": {
          "type": "integer",
          "minimum": 1
        },
        "invocationLine": {
          "type": "integer",
          "minimum": 1
        },
        "definitionOffset": {
          "type": "integer",
          "minimum": 0
        },
        "templateOffset": {
          "type": "integer",
          "minimum": 0
        },
        "invocationOffset": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/macroScope"
        }
      }
    },
    "moduleMount": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "root"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "from",
            "modulePath",
            "sourceScope",
            "declarationOffset",
            "inline",
            "visibility"
          ],
          "properties": {
            "kind": {
              "const": "module"
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "modulePath": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sourceScope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "declarationOffset": {
              "type": "integer",
              "minimum": 0
            },
            "inline": {
              "type": "boolean"
            },
            "visibility": {
              "type": "string",
              "pattern": "^(private|pub|pub\\([^)]*\\))$"
            },
            "macroUse": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "from",
            "modulePath",
            "sourceScope",
            "line",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "include"
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "modulePath": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sourceScope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "participationProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "state",
            "reason"
          ],
          "properties": {
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "const": "manifest"
                },
                "path": {
                  "type": "string"
                }
              }
            },
            "state": {
              "const": "denied"
            },
            "reason": {
              "enum": [
                "invalid-manifest",
                "unavailable-manifest"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "crateRoot",
            "manifestPath",
            "modulePath",
            "sourceScope",
            "mount",
            "state",
            "reason"
          ],
          "properties": {
            "target": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "path"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "source"
                      ]
                    },
                    "path": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "rawPath"
                  ],
                  "properties": {
                    "kind": {
                      "const": "unresolved"
                    },
                    "rawPath": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "crateRoot": {
              "type": "string"
            },
            "manifestPath": {
              "type": [
                "string",
                "null"
              ]
            },
            "modulePath": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sourceScope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mount": {
              "enum": [
                "root",
                "module",
                "include"
              ]
            },
            "state": {
              "enum": [
                "admitted",
                "denied"
              ]
            },
            "reason": {
              "enum": [
                "invalid-manifest",
                "unavailable-manifest",
                "nonportable-target",
                "unavailable-source",
                "unresolved-scope",
                "unresolved-target",
                "conflicting-target",
                "cyclic-target",
                null
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "admitted"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
