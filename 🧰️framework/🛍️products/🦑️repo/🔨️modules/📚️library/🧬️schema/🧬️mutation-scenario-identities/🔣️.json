{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "contract",
    "scenarioSchema",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "mutation-scenario-identities-v1"
    },
    "scenarioSchema": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenarios",
          "valid"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "directoryName"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "directoryName": {
                  "type": "string"
                }
              }
            }
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
