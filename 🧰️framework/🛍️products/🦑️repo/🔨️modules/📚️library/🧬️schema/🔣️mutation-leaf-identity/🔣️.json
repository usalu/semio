{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MutationLeafIdentityVectors",
  "description": "Language-agnostic vectors for structural mutation leaf identity: a directory is a mutation leaf when its own canonical descriptor names it as owner; a `🧫️fixtures/🧬️mutations/<leaf>` mirror and a `🧫️fixtures/<leaf>` or `🧫️fixtures/<leaf>-<scenario>` vector directory (leaf names compared without U+FE0F) inherit that proof from their schema-side owner, as does a vector's scenario child that holds a fixture bundle.",
  "type": "object",
  "required": ["contract", "descriptor", "leafKindId", "vectorKindId", "retiredRegistries", "cases"],
  "additionalProperties": false,
  "definitions": {
    "kindId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$" }
  },
  "properties": {
    "contract": { "type": "string", "const": "mutation-leaf-identity-v1" },
    "descriptor": {
      "type": "object",
      "required": ["filename", "schemaVersion", "ownerField", "identityField"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string", "const": "🔣️.json" },
        "schemaVersion": { "type": "integer", "const": 1 },
        "ownerField": { "type": "string", "const": "owner" },
        "identityField": { "type": "string", "const": "semanticKind" }
      }
    },
    "leafKindId": { "type": "string", "const": "members-of-schema" },
    "vectorKindId": { "type": "string", "const": "members-of-fixtures" },
    "retiredRegistries": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/kindId" } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scope", "path", "owner", "form", "expectedKindId"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "scope": { "$ref": "#/definitions/relativePath" },
          "path": { "$ref": "#/definitions/relativePath" },
          "owner": { "anyOf": [{ "$ref": "#/definitions/relativePath" }, { "type": "null" }] },
          "form": { "type": "string", "enum": ["descriptor", "fixture-mirror", "fixture-vector", "fixture-scenario-vector", "fixture-vector-scenario", "none"] },
          "expectedKindId": { "anyOf": [{ "$ref": "#/definitions/kindId" }, { "type": "null" }] }
        }
      }
    }
  }
}
