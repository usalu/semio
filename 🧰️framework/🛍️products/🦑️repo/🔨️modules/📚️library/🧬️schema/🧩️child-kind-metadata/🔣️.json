{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/policy/child-kind-metadata.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "declarations",
          "rejectedKinds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "declarations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "format",
                "kind"
              ],
              "properties": {
                "owner": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+$"
                },
                "format": {
                  "enum": [
                    "rs",
                    "ts",
                    "json",
                    "graphql",
                    "proto"
                  ]
                },
                "kind": {
                  "type": "string"
                }
              }
            }
          },
          "rejectedKinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifactKind": {
      "type": "string",
      "pattern": "^s\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
