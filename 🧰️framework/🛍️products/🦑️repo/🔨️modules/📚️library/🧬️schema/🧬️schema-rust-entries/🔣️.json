{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.repo.schema-rust-entry/v1",
  "$ref": "#/$defs/Dump",
  "$defs": {
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "formats",
        "exports"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "formats": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "exports": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "facet"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "facet": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "Dump": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "generator",
        "entries"
      ],
      "properties": {
        "contractId": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "export",
              "format"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "export": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              },
              "format": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
