{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "activeLease"
  ],
  "properties": {
    "schema": {
      "const": "semio.repo.exact-cargo-cleanup/v1"
    },
    "activeLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directoryPrefix",
        "manifestName",
        "version",
        "heartbeatMaxAgeMs"
      ],
      "properties": {
        "directoryPrefix": {
          "const": ".exact-cargo-laws-active-"
        },
        "manifestName": {
          "const": "lease.json"
        },
        "version": {
          "const": 1
        },
        "heartbeatMaxAgeMs": {
          "const": 120000
        }
      }
    }
  }
}
