{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "🚧️ Vectors of the workspace-negation closure law: a throwaway workspace (files), one project, and per case its named inputs, whether every `!{workspaceRoot}/…` negation of the expanded `subject` input has a workspace positive, and the files Nx's hash planner plans for it (without nx.json and the project's project.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectRoot", "files", "cases"],
  "properties": {
    "version": { "const": 1 },
    "projectRoot": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "namedInputs", "closed", "planned"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z0-9]+)*$" },
          "namedInputs": {
            "type": "object",
            "required": ["subject"],
            "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "closed": { "type": "boolean" },
          "planned": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
