{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/repo/storybook-discovery-v1.json",
  "title": "Storybook discovery identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stories"],
  "properties": {
    "version": { "const": 1 },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "title", "stories"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "(?:^|/)📖️stories/(?:🎭️[a-z0-9]+(?:-[a-z0-9]+)*/)?🧪️\\.story\\.tsx$"
          },
          "title": { "type": "string", "minLength": 1 },
          "stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["exportName", "id", "name"],
              "properties": {
                "exportName": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
