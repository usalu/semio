{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "$defs": {
    "case": {
      "type": "object",
      "required": ["owner", "domain", "case", "package", "production", "test"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "case": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "production": { "type": "string", "minLength": 1 },
        "productionImports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "test": { "type": "string", "minLength": 1 }
      }
    },
    "nativePackage": {
      "type": "object",
      "required": ["owner", "package", "production"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "production": { "type": "string", "minLength": 1 }
      }
    }
  },
  "required": [
    "contract",
    "layout",
    "module",
    "dependency",
    "nativePackages",
    "cases",
    "opaqueCases",
    "expectedPackages",
    "expectedSources",
    "expectedTests"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "canonical-go-input-projection-v2"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "dependency": {
      "type": "object",
      "required": ["directory", "module", "domain", "package", "production"],
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "production": { "type": "string", "minLength": 1 }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "testsDirectory",
        "implementationFilename",
        "opaqueDirectoryNames",
        "sourceDirectoryNames"
      ],
      "additionalProperties": false,
      "properties": {
        "testsDirectory": {
          "type": "string",
          "minLength": 1
        },
        "implementationFilename": {
          "type": "string",
          "pattern": "\\.go$"
        },
        "opaqueDirectoryNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceDirectoryNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "nativePackages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nativePackage" }
    },
    "opaqueCases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "expectedPackages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expectedSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedTests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
