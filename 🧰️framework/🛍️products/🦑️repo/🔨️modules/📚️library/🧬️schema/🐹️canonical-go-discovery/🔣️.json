{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "contract",
    "layout",
    "cases",
    "opaqueCases",
    "expectedPackages",
    "expectedTests"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "canonical-go-test-discovery-v1"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "object",
      "required": [
        "testsDirectory",
        "implementationFilename",
        "opaqueDirectoryNames"
      ],
      "additionalProperties": false,
      "properties": {
        "testsDirectory": {
          "type": "string",
          "minLength": 1
        },
        "implementationFilename": {
          "type": "string",
          "pattern": "\\.go$"
        },
        "opaqueDirectoryNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1
    },
    "opaqueCases": {
      "type": "array",
      "minItems": 1
    },
    "expectedPackages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    },
    "expectedTests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
