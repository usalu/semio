{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.repo.cargo-dependency-direction/v1",
  "$ref": "#/$defs/Policy",
  "$defs": {
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaLayers",
        "roles",
        "rules",
        "ownerRoles"
      ],
      "properties": {
        "areaLayers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "framework",
              "implementation",
              "repo-wide"
            ]
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromRoles",
              "toRoles"
            ],
            "properties": {
              "fromRoles": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "toRoles": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "toOwnerSegments": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^/\\\\]+$",
                  "not": {
                    "enum": [
                      ".",
                      ".."
                    ]
                  }
                }
              },
              "fromOwnerPaths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "properties": {
                      "fromRoles": {
                        "type": "array",
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "fromOwnerPaths"
                    ],
                    "properties": {
                      "fromOwnerPaths": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "properties": {
                      "toRoles": {
                        "type": "array",
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "toOwnerSegments"
                    ],
                    "properties": {
                      "toOwnerSegments": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^/\\\\]+$",
                          "not": {
                            "enum": [
                              ".",
                              ".."
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "ownerRoles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "roles"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "alias",
        "owner",
        "kind",
        "optional",
        "platform"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "normal",
            "dev",
            "build"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner",
        "role",
        "dependencies"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        }
      }
    },
    "Violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "from",
        "to",
        "alias",
        "kind",
        "optional",
        "platform"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "normal",
            "dev",
            "build"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "owner"
      ],
      "properties": {
        "code": {
          "enum": [
            "missing-role",
            "unknown-role",
            "unclassified-owner",
            "owner-role-mismatch",
            "unclassified-role-owner"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
