{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Node Native TypeScript Surface",
  "description": "✂️ The TypeScript Node loads without a bundler (strip-only): the package entries vite/vitest configs externalize, and the syntax vectors Node's type stripper and TypeScript's erasableSyntaxOnly must judge alike.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configImportSpecifiers",
    "nativeEntries",
    "vectors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "configImportSpecifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nativeEntries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\].*\\.ts$"
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "stripOnly"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "stripOnly": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
