{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://semio/library-cargo-transaction-command-source/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owners", "contexts", "consumers", "routes", "nativeArguments", "goSelection", "transaction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owners": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "declarations", "contextChain"],
        "properties": {
          "path": { "type": "string", "pattern": "/🟦️\\.ts$" },
          "declarations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "contextChain": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^repo-" } }
        }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directoryName", "parentKindId", "kindId"],
        "properties": {
          "directoryName": { "type": "string", "minLength": 1 },
          "parentKindId": { "type": "string", "minLength": 1 },
          "kindId": { "type": "string", "pattern": "^repo-" }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owners"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "owners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "go", "goProjection", "goDispatch", "transaction"],
      "properties": {
        "source": { "$ref": "#/$defs/route" },
        "go": { "$ref": "#/$defs/route" },
        "goProjection": { "$ref": "#/$defs/route" },
        "goDispatch": { "$ref": "#/$defs/route" },
        "transaction": { "$ref": "#/$defs/route" }
      }
    },
    "nativeArguments": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "args", "valid"],
        "properties": {
          "operation": { "enum": ["build", "check", "test"] },
          "args": { "type": "array", "items": { "type": "string" } },
          "valid": { "type": "boolean" }
        }
      }
    },
    "goSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "replacements", "cases"],
      "properties": {
        "packages": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "replacements": { "type": "object", "additionalProperties": { "type": "string" } },
        "cases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "directories", "accepted"],
            "properties": {
              "input": { "type": "string" },
              "directories": { "type": "array", "items": { "type": "string" } },
              "accepted": { "type": "boolean" },
              "expected": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runOwnerPath", "ledgerBoundaries", "harness", "suite", "normalization", "taxonomy", "discovery"],
      "properties": {
        "runOwnerPath": { "type": "string", "pattern": "KIND-ONLY-BASENAMES-ACROSS-THE-TAXONOMY-TREE/.+🧾️runs$" },
        "ledgerBoundaries": { "type": "string" },
        "harness": { "type": "string" },
        "suite": { "type": "string" },
        "normalization": { "type": "string" },
        "taxonomy": { "type": "string" },
        "discovery": { "type": "string" }
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "command", "launchName", "launchCommand"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "launchName": { "type": "string", "minLength": 1 },
        "launchCommand": { "type": "string", "minLength": 1 }
      }
    }
  }
}
