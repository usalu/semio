{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/test/owner-only",
  "title": "🔐️ Owner-only files: whoami SID parsing, icacls arguments and SDDL verdicts shared by the TypeScript and Rust twins",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "whoami",
    "icacls",
    "sddl"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "whoami": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "stdout",
          "sid"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "stdout": {
            "type": "string"
          },
          "sid": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^S-1-[0-9]+(-[0-9]+)+$"
          }
        }
      }
    },
    "icacls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sid",
          "kind",
          "arguments"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sid": {
            "type": "string",
            "pattern": "^S-1-[0-9]+(-[0-9]+)+$"
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "arguments": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sddl": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sid",
          "sddl",
          "violations"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sid": {
            "type": "string",
            "pattern": "^S-1-[0-9]+(-[0-9]+)+$"
          },
          "sddl": {
            "type": "string",
            "minLength": 1
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
