      "name": "a",
      "optional": false,
      "cardinality": "scalar",
      "scalar": "string",
      "state": ""
     },
     {
      "name": "b",
      "optional": false,
      "cardinality": "scalar",
      "scalar": "number",
      "state": ""
     }
    ]
   },
   "defect": "🟦️typescript/🟦️.ts: semicolon-free interfaces (valid, common style) merge members into one mistyped field"
  }
 ],
