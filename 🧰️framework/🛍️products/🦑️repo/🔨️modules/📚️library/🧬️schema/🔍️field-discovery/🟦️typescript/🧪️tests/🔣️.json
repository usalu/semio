 "defects": [
  {
   "name": "a line comment that looks like a member is not a field",
   "text": "export interface C {\n  // legacy: string;\n  real: number;\n}\n",
   "type": "C",
   "expected": {
    "typeName": "C",
    "fields": [
     {
      "name": "real",
      "optional": false,
      "cardinality": "scalar",
      "scalar": "number",
      "state": ""
     }
    ]
   },
   "defect": "🟦️typescript/🟦️.ts:policyExtractTypescriptSchemaFields scans the body with a regex and does not skip comments, so `// legacy: string;` becomes a field"
  },
  {
   "name": "an inline object type is one field, not several",
   "text": "export interface D {\n  inline: { a: string; b: number };\n  after: boolean;\n}\n",
   "type": "D",
   "expected": {
    "typeName": "D",
    "fields": [
     {
      "name": "inline",
      "optional": false,
      "cardinality": "scalar",
      "scalar": "{ a: string; b: number }",
      "state": ""
     },
     {
      "name": "after",
      "optional": false,
      "cardinality": "scalar",
      "scalar": "boolean",
      "state": ""
     }
    ]
   },
   "defect": "🟦️typescript/🟦️.ts: the member regex ends a type at the first `;`, so an inline object type yields a truncated type and its inner members leak as top-level fields (`b`)"
  },
  {
   "name": "the last member may omit its semicolon",
   "text": "export interface Other { zzz: string }\n",
   "type": "Other",
   "expected": {
    "typeName": "Other",
    "fields": [
     {
      "name": "zzz",
      "optional": false,
      "cardinality": "scalar",
      "scalar": "string",
      "state": ""
     }
    ]
   },
   "defect": "🟦️typescript/🟦️.ts: every member must end with `;`, so a member without a trailing semicolon (valid TypeScript, e.g. the last member of a one-line interface) is dropped"
  },
  {
   "name": "members separated by newlines only",
   "text": "export interface Asi {\n  a: string\n  b: number\n}\n",
   "type": "Asi",
   "expected": {
    "typeName": "Asi",
    "fields": [
