{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.repo.process-row/v1",
  "$ref": "#/definitions/row",
  "definitions": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "parent",
        "stat",
        "command"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "parent": {
          "type": "integer",
          "minimum": 0
        },
        "stat": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
