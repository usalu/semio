{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/test/process-table",
  "title": "📋️ Process table snapshots: POSIX ps and Windows Get-CimInstance projections parse to the same rows",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "posix",
    "windows",
    "activeBuild"
  ],
  "definitions": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "parent",
        "stat",
        "command"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "parent": {
          "type": "integer",
          "minimum": 0
        },
        "stat": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "posix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "rows"
      ],
      "properties": {
        "stdout": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/row"
          }
        }
      }
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "stdout",
          "rows"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "stdout": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/row"
            }
          }
        }
      }
    },
    "activeBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "matches"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    }
  }
}
