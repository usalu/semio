{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio-tech.com/schema/tool-configuration-ownership.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owners",
    "removedShims",
    "fixedContractIds",
    "consumers",
    "projectInputs",
    "registration",
    "postcss"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owners": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "previousPath",
          "ownerPath",
          "effectiveRoot",
          "loader",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "tool": {
            "enum": [
              "vite",
              "playwright",
              "tailwind",
              "eslint",
              "dependency-cruiser",
              "vscode-test",
              "postcss"
            ]
          },
          "previousPath": {
            "type": "string",
            "minLength": 1
          },
          "ownerPath": {
            "type": "string",
            "pattern": "(?:^|/)(?:🟦️\\.ts|🟨️\\.(?:mjs|cjs))$"
          },
          "effectiveRoot": {
            "type": "string",
            "minLength": 1
          },
          "loader": {
            "enum": [
              "vite-native",
              "module",
              "eslint",
              "dependency-cruiser",
              "vscode-test",
              "postcss-load-config"
            ]
          },
          "mode": {
            "enum": [
              "serve",
              "build",
              "test",
              "lint",
              "verify"
            ]
          }
        }
      }
    },
    "removedShims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixedContractIds": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "enum": [
          "tailwind-config",
          "eslint-config",
          "dependency-cruiser-config",
          "root-eslint-config",
          "vscode-test-cli-config",
          "postcss-config"
        ]
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "target"
      ],
      "properties": {
        "name": {
          "const": "🧹clean🧩️taxonomy🎚️tool-configuration-ownership"
        },
        "command": {
          "const": "bun nx run @semio-tech/repo-lib:test-tool-configuration-ownership"
        },
        "target": {
          "const": "test-tool-configuration-ownership"
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "tokens"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "projectInputs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "owners"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owners": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "postcss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerId",
        "packageManifestPath",
        "packageEntryPath",
        "packageExport",
        "packageExportTarget",
        "standaloneLoader",
        "viteLoader",
        "historicalFixturePath",
        "historicalOwnerPath",
        "cases"
      ],
      "properties": {
        "ownerId": {
          "const": "ui-react-postcss"
        },
        "packageManifestPath": {
          "type": "string",
          "minLength": 1
        },
        "packageEntryPath": {
          "type": "string",
          "pattern": "(?:^|/)🟦️\\.mts$"
        },
        "packageExport": {
          "const": "./postcss.config"
        },
        "packageExportTarget": {
          "const": "./🟦️.mts"
        },
        "standaloneLoader": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "searchPlace"
          ],
          "properties": {
            "kind": {
              "const": "explicit-search-place"
            },
            "searchPlace": {
              "const": "🟦️.mts"
            }
          }
        },
        "viteLoader": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exportName"
          ],
          "properties": {
            "kind": {
              "const": "inline-plugin-array"
            },
            "exportName": {
              "const": "uiPostcssInlinePlugins"
            }
          }
        },
        "historicalFixturePath": {
          "type": "string",
          "minLength": 1
        },
        "historicalOwnerPath": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "expectedDeclarations"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "expectedDeclarations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "selector",
                    "property",
                    "value"
                  ],
                  "properties": {
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "property": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
