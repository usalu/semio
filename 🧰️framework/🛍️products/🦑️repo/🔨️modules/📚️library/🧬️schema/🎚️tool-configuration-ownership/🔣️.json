{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio-tech.com/schema/tool-configuration-ownership.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owners",
    "removedShims",
    "fixedContractIds",
    "consumers",
    "projectInputs",
    "registration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owners": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "previousPath",
          "ownerPath",
          "effectiveRoot",
          "loader",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "tool": {
            "enum": [
              "vite",
              "playwright",
              "tailwind",
              "eslint",
              "dependency-cruiser",
              "vscode-test"
            ]
          },
          "previousPath": {
            "type": "string",
            "minLength": 1
          },
          "ownerPath": {
            "type": "string",
            "pattern": "(?:^|/)(?:🟦️\\.ts|🟨️\\.(?:mjs|cjs))$"
          },
          "effectiveRoot": {
            "type": "string",
            "minLength": 1
          },
          "loader": {
            "enum": [
              "vite-native",
              "module",
              "eslint",
              "dependency-cruiser",
              "vscode-test"
            ]
          },
          "mode": {
            "enum": [
              "serve",
              "build",
              "test",
              "lint",
              "verify"
            ]
          }
        }
      }
    },
    "removedShims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixedContractIds": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "enum": [
          "tailwind-config",
          "eslint-config",
          "dependency-cruiser-config",
          "root-eslint-config",
          "vscode-test-cli-config"
        ]
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "target"
      ],
      "properties": {
        "name": {
          "const": "🧹clean🧩️taxonomy🎚️tool-configuration-ownership"
        },
        "command": {
          "const": "bun nx run @semio-tech/repo-lib:test-tool-configuration-ownership"
        },
        "target": {
          "const": "test-tool-configuration-ownership"
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "tokens"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "projectInputs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "owners"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owners": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
