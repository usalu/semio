{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["tree", "spawnDeadlineMs", "settleDeadlineMs", "cases"],
  "properties": {
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "breadth"],
      "properties": {
        "depth": { "type": "integer", "minimum": 1, "maximum": 4 },
        "breadth": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "spawnDeadlineMs": { "type": "integer", "minimum": 1 },
    "settleDeadlineMs": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "terminator", "survivors"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "terminator": { "enum": ["terminateOwnedChildTree", "tree-kill", "child.kill"] },
          "survivors": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
