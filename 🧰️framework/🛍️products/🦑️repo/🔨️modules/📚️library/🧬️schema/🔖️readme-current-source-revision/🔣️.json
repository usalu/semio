{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Current Source Approval Registry",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9-]*$"
  },
  "additionalProperties": {
    "$ref": "#/definitions/CurrentSourceApproval"
  },
  "definitions": {
    "CurrentSourceApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "baselineCommit",
        "baselineBlob",
        "baselinePreimage",
        "currentPreimage",
        "approvalPath",
        "approvalSha256"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[\\\\:*?\"<>|\\u0000-\\u001f])(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
        },
        "baselineCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "baselineBlob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "baselinePreimage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "mode",
            "size"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "const": "0644"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "currentPreimage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "mode",
            "size"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "const": "0644"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "approvalPath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[\\\\:*?\"<>|\\u0000-\\u001f])(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
        },
        "approvalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "CurrentSourceApprovalDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "sourcePath",
        "policy",
        "baseline",
        "currentPreimage"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "current-source-approval"
        },
        "sourcePath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[\\\\:*?\"<>|\\u0000-\\u001f])(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*[\\\\:*?\"<>|\\u0000-\\u001f])(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "blob",
            "preimage"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "blob": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "preimage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "mode",
                "size"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "mode": {
                  "const": "0644"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        },
        "currentPreimage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "mode",
            "size"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "const": "0644"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  }
}
