{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checkout", "components"],
  "properties": {
    "version": { "const": 1 },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "maxPathUnits", "ticketRoot"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "maxPathUnits": { "type": "integer", "minimum": 1 },
        "ticketRoot": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "illegal"],
        "properties": {
          "name": { "type": "string" },
          "illegal": { "type": "boolean" }
        }
      }
    }
  }
}
