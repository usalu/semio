{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/rust/physical-reference/source-participation",
  "type": "array",
  "minItems": 45,
  "maxItems": 45,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "source", "participation"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "source": { "type": "string", "minLength": 1 },
      "participation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state"],
            "properties": { "state": { "const": "admitted" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "reason"],
            "properties": {
              "state": { "const": "denied" },
              "reason": { "const": "unresolved-scope" }
            }
          }
        ]
      }
    }
  }
}
