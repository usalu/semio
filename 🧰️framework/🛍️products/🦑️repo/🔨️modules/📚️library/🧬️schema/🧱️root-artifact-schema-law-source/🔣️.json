{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owners", "contexts", "consumers", "sourceStates", "discovery", "lawKinds", "route"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owners": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "directoryName", "parentKindId", "kindId", "declarations"],
        "properties": {
          "path": { "type": "string", "pattern": "/🟦️\\.ts$" },
          "directoryName": { "type": "string" },
          "parentKindId": { "type": "string" },
          "kindId": { "type": "string" },
          "declarations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directoryName", "parentKindId", "kindId"],
        "properties": {
          "directoryName": { "type": "string" },
          "parentKindId": { "type": "string" },
          "kindId": { "type": "string" }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owners"],
        "properties": {
          "path": { "type": "string" },
          "owners": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "sourceStates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "stat", "read", "expected"],
        "properties": {
          "name": { "type": "string" },
          "stat": { "enum": ["missing", "file", "directory", "symlink"] },
          "read": { "enum": ["text", "unreadable"] },
          "expected": { "enum": ["missing", "file", "not-file", "symlink", "unreadable"] }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "symlink"],
      "properties": {
        "owner": { "type": "string" },
        "symlink": { "type": "string" }
      }
    },
    "lawKinds": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "command", "launchName", "launchCommand"],
      "properties": {
        "target": { "type": "string" },
        "command": { "type": "string" },
        "launchName": { "type": "string" },
        "launchCommand": { "type": "string" }
      }
    }
  }
}
