{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.repo.schema-scope/v1",
  "$ref": "#/$defs/Scope",
  "$defs": {
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "level",
        "exports",
        "dependsOn"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "exports": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "facet"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "facet": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
