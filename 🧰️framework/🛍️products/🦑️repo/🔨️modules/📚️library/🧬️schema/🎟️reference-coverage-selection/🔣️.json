{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "execution", "nonRustAdapters", "tokens", "rustCases", "nonRustSupported", "nonRustUnsupported", "scale"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "adapter-local-reference-coverage-v1" },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "route", "launchName", "launchOrder"],
      "properties": {
        "target": { "const": "test-reference-coverage-selection" },
        "route": { "const": "reference-coverage-selection" },
        "launchName": { "const": "🧹clean🧩️taxonomy🎟️reference-coverage-selection" },
        "launchOrder": { "const": 410.208 }
      }
    },
    "nonRustAdapters": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "adapter"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "adapter": { "enum": ["typescript", "go", "python", "dotnet", "native", "json", "jsonc", "toml", "yaml", "xml", "markdown", "gherkin"] } }
      }
    },
    "tokens": { "type": "object", "minProperties": 13, "maxProperties": 13, "additionalProperties": { "$ref": "#/definitions/token" } },
    "rustCases": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/definitions/case" } },
    "nonRustSupported": { "$ref": "#/definitions/ids" },
    "nonRustUnsupported": { "$ref": "#/definitions/ids" },
    "scale": {
      "type": "object", "additionalProperties": false, "required": ["supported", "unsupported", "expectedCoverageCalls"],
      "properties": { "supported": { "const": 256 }, "unsupported": { "const": 256 }, "expectedCoverageCalls": { "const": 0 } }
    }
  },
  "definitions": {
    "ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["id", "supported", "unsupported", "retained"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "supported": { "$ref": "#/definitions/ids" }, "unsupported": { "$ref": "#/definitions/ids" }, "retained": { "$ref": "#/definitions/ids" } }
    },
    "token": {
      "type": "object", "additionalProperties": false, "required": ["adapter", "start", "end", "value"],
      "properties": {
        "adapter": { "enum": ["rust", "json"] },
        "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 }, "value": { "type": "string" },
        "rewriteKind": { "enum": ["rust-path-join", "path-prefix"] },
        "physicalInterpretation": { "const": "rust-finite-manifest-targets" },
        "physicalTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unsupportedReason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
