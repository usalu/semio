{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/repo/ui/router-ownership.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generalScript",
    "generalProject",
    "repoScript",
    "repoProject",
    "retainedRoutes",
    "movedRoutes",
    "censusDeclarations",
    "productRoots",
    "parentKind",
    "directoryKind",
    "storybookCases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generalScript": {
      "type": "string",
      "minLength": 1
    },
    "generalProject": {
      "type": "string",
      "minLength": 1
    },
    "repoScript": {
      "type": "string",
      "minLength": 1
    },
    "repoProject": {
      "type": "string",
      "minLength": 1
    },
    "retainedRoutes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "movedRoutes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "target"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "censusDeclarations": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "productRoots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parentKind": {
      "const": "repo-server-library"
    },
    "directoryKind": {
      "const": "repo-library-ui"
    },
    "storybookCases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "declaration",
          "arguments",
          "scope"
        ],
        "properties": {
          "declaration": {
            "enum": [
              "DevScript",
              "BuildScript"
            ]
          },
          "arguments": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "enum": [
              null,
              "ui"
            ]
          }
        }
      }
    }
  }
}
