{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "dependency",
    "chain",
    "baselineMissing"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "workspace"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "chain": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "workspace",
          "inherited"
        ],
        "properties": {
          "manifest": {
            "type": "string"
          },
          "workspace": {
            "type": "string"
          },
          "inherited": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "baselineMissing": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "table",
          "name"
        ],
        "properties": {
          "manifest": {
            "type": "string"
          },
          "table": {
            "const": "dependencies"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
