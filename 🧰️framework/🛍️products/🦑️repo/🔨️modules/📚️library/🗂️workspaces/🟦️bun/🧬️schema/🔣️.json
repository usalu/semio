{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "members",
    "owners"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!!?$)(?!!?/)(?!!?[A-Za-z]:/)(?!.*\\\\).+$"
      },
      "contains": {
        "type": "string",
        "pattern": "^[^!]"
      }
    },
    "owners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "const": "*/package.json"
      }
    }
  },
  "description": "Portable authoritative Source membership recipes use literal path components, * and ? within a component, and ** for zero or more components. Brackets and braces are literal Source names. Native Bun workspaces are the complete current byte-sorted native literal directory projection of independently owned packages, excluding the installation scope itself and all testing collections. Native metacharacters are escaped and an empty brace alternative selects that same exact directory through Bun glob interpretation; ordinary directories remain direct literal entries. Leading ! is prefixed with ./ to preserve literal identity. Source discovery does not depend on published native projection. Only the explicitly selected scopes are refreshed through the original caller control before the first installation; current topology, manifest and policy guards refuse concurrent changes.",
  "$defs": {
    "OwnershipProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "path",
        "completedOperations"
      ],
      "properties": {
        "operation": {
          "enum": [
            "state",
            "list",
            "readText",
            "selection",
            "publication"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "completedOperations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OwnershipScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "beforeSha256",
        "patterns",
        "packages"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "beforeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "OwnershipReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scopes",
        "packages"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OwnershipScope"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "OwnershipSelection": {
      "description": "Explicit whole-repository or one authored installation owner. A scoped operation reads only its selected Source membership and admission, excluding separate installation owners; topology, manifest and original-control guards remain mandatory.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "all"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner"
          ],
          "properties": {
            "kind": {
              "const": "scope"
            },
            "owner": {
              "type": "string",
              "pattern": "^(?:\\.|[^./\\\\:\\u0000][^/\\\\:\\u0000]*)$"
            }
          }
        }
      ]
    },
    "InstallationCustody": {
      "description": "One original controlled publisher computation retains all raw Source texts, physical state/topology and policy observations throughout its callback. Callback recheck replays those original observations without rediscovering package membership. Scope enumeration admits current owner manifests with the same guards but performs no package scan. Reports alone never grant installation authority. Recheck must retain live callback custody both at entry and after every awaited validation; a continuation paused inside original control cannot settle successfully after callback release.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "packages"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "PhysicalLimits": {
      "const": {
        "maximumManifestBytes": 8388608,
        "maximumAggregateManifestBytes": 67108864,
        "maximumTextDocuments": 16384,
        "maximumObservationPaths": 131072,
        "maximumObservationFacts": 262144,
        "maximumDirectoryEntries": 65536,
        "maximumAggregateDirectoryEntries": 262144,
        "maximumPendingRechecks": 32,
        "maximumPathUnits": 256,
        "maximumPolicyBytes": 65536,
        "readChunkBytes": 65536
      }
    },
    "PhysicalObservationProtocol": {
      "const": {
        "version": 1,
        "unit": "distinct-physical-path",
        "facts": ["state", "list"],
        "maximumFactsPerPath": 2,
        "record": "original-state-and-optional-complete-original-listing",
        "order": "original-global-first-fact-admission",
        "replay": "bounded-record-references-without-payload-duplication",
        "previousUnit": "operation-and-path",
        "previousMaximumFacts": 131072
      }
    },
    "PhysicalObservationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "state": {"oneOf": [{"type": "array", "minItems": 1, "maxItems": 1, "items": [{"const": "missing"}], "additionalItems": false}, {"type": "array", "minItems": 4, "maxItems": 4, "items": [{"enum": ["file", "directory", "symlink", "other"]}, {"type": "string", "pattern": "^[0-9]+$"}, {"type": "string", "pattern": "^[0-9]+$"}, {"type": "integer", "minimum": 0}], "additionalItems": false}]},
        "list": {"type": "array", "maxItems": 65536, "items": {"type": "object", "additionalProperties": false, "required": ["name", "kind"], "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"enum": ["file", "directory", "symlink", "other"]}}}}
      }
    },
    "PhysicalObservationCase": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "pathCapacity", "factCapacity", "steps", "accepted", "paths", "facts"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "pathCapacity": {"type": "integer", "minimum": 1, "maximum": 4},
        "factCapacity": {"type": "integer", "minimum": 1, "maximum": 8},
        "steps": {"type": "array", "maxItems": 9, "items": {"type": "object", "additionalProperties": false, "required": ["operation", "path", "value"], "properties": {"operation": {"enum": ["state", "list"]}, "path": {"type": "string", "minLength": 1}, "value": {"type": "array"}}}},
        "accepted": {"type": "boolean"},
        "paths": {"type": "integer", "minimum": 0, "maximum": 4},
        "facts": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "ReadonlyCustody": {
      "description": "One actual controlled verification refuses stale published membership and retains its original Source/text/topology observations through the callback. It never calls publication or writes. Rechecks enroll before effects under a finite pending bound; admission closes after body, accepted rechecks drain with their first failure including undefined retained, and a final successful-body replay precedes custody closure. Escaped callbacks cannot start or resume effects after release.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "packages"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
