{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "members",
    "owners"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!!?$)(?!!?/)(?!!?[A-Za-z]:/)(?!.*\\\\).+$"
      },
      "contains": {
        "type": "string",
        "pattern": "^[^!]"
      }
    },
    "owners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "const": "*/package.json"
      }
    }
  }
}
