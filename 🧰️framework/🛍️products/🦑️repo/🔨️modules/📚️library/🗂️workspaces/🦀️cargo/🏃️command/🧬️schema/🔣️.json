{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:cargo-command-request:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root",
    "cwd",
    "args",
    "environment",
    "storage",
    "provenance"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "args": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000]*$"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "directory"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 135,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "buildDirectory",
        "mirrorDirectory"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "buildDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
        },
        "mirrorDirectory": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
