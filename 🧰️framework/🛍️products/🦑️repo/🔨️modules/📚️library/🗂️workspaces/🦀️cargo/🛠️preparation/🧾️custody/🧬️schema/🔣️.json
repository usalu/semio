{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/library/workspaces/cargo/preparation/custody/component.json",
  "title": "CargoPreparationCustody",
  "$defs": {
    "CargoPreparationInputV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "presence"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CargoPreparationObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "script",
        "command",
        "sources",
        "inputs",
        "outputs",
        "resolutions"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CargoPreparationInputV1"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/CargoPreparationInputV1"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/CargoPreparationInputV1"
          }
        },
        "resolutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CargoPreparationResolutionV1"
          }
        }
      }
    },
    "CargoPreparationResolutionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "specifier",
        "selected"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "specifier": {
          "type": "string",
          "minLength": 1
        },
        "selected": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CargoPreparationSelectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "packages"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?:Cargo\\.toml|.+/Cargo\\.toml)$"
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        }
      }
    },
    "CargoPreparationInvocationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "args",
        "cwd",
        "environment"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/CargoPreparationObservationV1"
}
