{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "waitMillis", "expectedPublication", "expectedMachineOutput"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "waitMillis": { "type": "integer", "minimum": 31000, "maximum": 35000 },
    "expectedPublication": { "type": "string", "minLength": 1 },
    "expectedMachineOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepared"],
      "properties": { "prepared": { "const": true } }
    }
  }
}
