{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:repository:workspace:contribution:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "members",
    "exclude"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    }
  }
}
