{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dependency",
          "package",
          "valid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dependency": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "package": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
