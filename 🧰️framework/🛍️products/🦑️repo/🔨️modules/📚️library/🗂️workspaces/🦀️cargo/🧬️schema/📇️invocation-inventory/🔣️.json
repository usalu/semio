{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "members",
    "maxParsesPerManifest",
    "rename",
    "removeIndex",
    "selectedIndices",
    "maxRepositoryParses",
    "publicationOwners",
    "maxPublicationParses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "members": {
      "type": "integer",
      "minimum": 2
    },
    "maxParsesPerManifest": {
      "const": 1
    },
    "rename": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "removeIndex": {
      "type": "integer",
      "minimum": 0
    },
    "selectedIndices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "maxRepositoryParses": {
      "const": 3
    },
    "publicationOwners": {
      "type": "integer",
      "minimum": 1
    },
    "maxPublicationParses": {
      "const": 4
    }
  }
}
