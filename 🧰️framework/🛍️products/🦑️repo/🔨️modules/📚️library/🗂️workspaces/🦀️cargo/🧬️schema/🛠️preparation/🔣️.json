{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "script",
    "command"
  ],
  "properties": {
    "script": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?:.*/)?📜️script\\.ts$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000]+$"
      }
    }
  }
}
