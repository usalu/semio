{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "member-manifests",
    "exclude-patterns"
  ],
  "properties": {
    "schema-version": {
      "const": 1
    },
    "member-manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?:.*/)?Cargo\\.toml$"
      }
    },
    "owner-manifests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?:.*/)?Cargo\\.toml$"
      }
    },
    "exclude-patterns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    }
  },
  "$defs": {
    "CargoWorkspaceProgressV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "path",
        "completedOperations"
      ],
      "properties": {
        "operation": {
          "enum": [
            "state",
            "presence",
            "list",
            "text",
            "recipe"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "completedOperations": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
