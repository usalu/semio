{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "compilerDiagnostic": {
      "type": "object",
      "required": ["code", "start", "length"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      }
    },
    "expected": {
      "type": "object",
      "required": ["completeness", "providerInference"],
      "additionalProperties": false,
      "properties": {
        "completeness": { "const": "incomplete" },
        "providerInference": { "const": "forbidden" }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "language", "source", "compilerDiagnostics", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "language": { "const": "ts" },
        "source": { "type": "string", "minLength": 1 },
        "compilerDiagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compilerDiagnostic" }
        },
        "expected": { "$ref": "#/$defs/expected" }
      }
    }
  }
}
