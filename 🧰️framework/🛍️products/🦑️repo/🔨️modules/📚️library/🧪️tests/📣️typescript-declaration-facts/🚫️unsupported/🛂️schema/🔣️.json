{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Valid Unsupported TypeScript Declaration Cases",
  "type": "object",
  "required": ["schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "language", "source", "compilerDiagnostics", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "language": { "const": "ts" },
          "source": { "type": "string", "minLength": 1 },
          "compilerDiagnostics": { "type": "array", "maxItems": 0 },
          "expected": {
            "type": "object",
            "required": ["completeness", "forbiddenDiagnosticCodes"],
            "additionalProperties": false,
            "properties": {
              "completeness": { "const": "incomplete" },
              "forbiddenDiagnosticCodes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["parse-error", "unresolved-computed-property"] }
              }
            }
          }
        }
      }
    }
  }
}
