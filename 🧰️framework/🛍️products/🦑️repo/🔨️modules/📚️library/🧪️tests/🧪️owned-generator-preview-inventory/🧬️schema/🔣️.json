{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "ownedGeneratorIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "owned-generator-preview-inventory-v1" },
    "ownedGeneratorIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
    }
  }
}
