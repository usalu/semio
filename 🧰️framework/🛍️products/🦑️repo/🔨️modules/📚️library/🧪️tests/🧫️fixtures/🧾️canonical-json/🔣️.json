    { "id": "stable-ties", "input": [{ "id": "a", "value": "z" }, { "id": "a", "value": "b" }], "oracle": [{ "id": "a", "value": "z" }, { "id": "a", "value": "b" }], "canonical": "[{\"id\":\"a\",\"value\":\"z\"},{\"id\":\"a\",\"value\":\"b\"}]" },
