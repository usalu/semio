{
  "schemaVersion": 1,
  "contractId": "path-budget-v1",
  "semantics": {
    "maxPathUtf16Units": "A tracked repo-relative path may have at most this many UTF-16 code units (Windows MAX_PATH semantics). U+FE0F counts one unit, an astral emoji two.",
    "maxComponentUtf8Bytes": "Every path component, split at slash or backslash, may have at most this many UTF-8 bytes (Linux and macOS NAME_MAX).",
    "parts": "The path is the concatenation of every part text repeated count times.",
    "reserve": "A canonical root fits when its units plus the reserved descendant suffix units stay within maxPathUtf16Units and its components stay within maxComponentUtf8Bytes."
  },
  "policy": {
    "maxPathUtf16Units": 256,
    "maxComponentUtf8Bytes": 255
  },
  "cases": [
    {
      "id": "ascii-256-units",
      "note": "ASCII path of exactly 256 UTF-16 units passes",
      "parts": [
        {
          "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/",
          "count": 5
        },
        {
          "text": "a",
          "count": 1
        }
      ],
      "utf16Units": 256,
      "longestComponentUtf8Bytes": 50,
      "codes": []
    },
    {
      "id": "ascii-257-units",
      "note": "one unit more is too long",
      "parts": [
        {
          "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/",
          "count": 5
        },
        {
          "text": "aa",
          "count": 1
        }
      ],
      "utf16Units": 257,
      "longestComponentUtf8Bytes": 50,
      "codes": [
        "path-too-long"
      ]
    },
    {
      "id": "ascii-component-255-bytes",
      "note": "single ASCII component of 255 bytes passes",
      "parts": [
        {
          "text": "a",
          "count": 255
        }
      ],
      "utf16Units": 255,
      "longestComponentUtf8Bytes": 255,
      "codes": []
    },
    {
      "id": "ascii-component-256-bytes",
      "note": "single ASCII component of 256 bytes is too long",
      "parts": [
        {
          "text": "a",
          "count": 256
        }
      ],
      "utf16Units": 256,
      "longestComponentUtf8Bytes": 256,
      "codes": [
        "path-component-too-long"
      ]
    },
    {
