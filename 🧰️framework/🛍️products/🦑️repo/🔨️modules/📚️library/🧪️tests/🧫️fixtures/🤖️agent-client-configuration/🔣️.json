{
  "description": "🤖️ Dashboard declarations derive only headless agent MCP configurations; independent parsed server tables validate text and meaning, while IDE clients are refused.",
  "declaration": {
    "tools": [
      {
        "id": "alpha-mcp",
        "verb": "dev",
        "command": [
          "bun",
          "./run.ts",
          "serve"
        ],
        "continuous": true,
        "parameters": [
          {
            "id": "profile",
            "kind": "text",
            "default": "base",
            "valuePositional": true
          }
        ],
        "mcp": {
          "server": "alpha",
          "clients": {
            "claude-code": {},
            "codex": {
              "parameters": {
                "profile": "codex"
              }
            }
          }
        }
      },
      {
        "id": "beta.mcp",
        "verb": "dev",
        "command": [
          "bun",
          "./run.ts",
          "gateway",
          "--scopes",
          "a.read,b.write"
        ],
        "parameters": [
          {
            "id": "folder",
            "kind": "text",
            "required": true,
            "valueFlag": "--folder="
          }
        ],
        "mcp": {
          "server": "beta.gateway",
          "clients": {
            "claude-code": {
              "parameters": {
                "folder": "space"
              }
            },
            "codex": {
              "parameters": {
                "folder": "space"
              }
            }
          }
        }
      },
      {
        "id": "gamma-mcp",
        "verb": "dev",
        "command": [
          "repo",
          "mcp"
        ],
        "continuous": true,
        "parameters": [
          {
            "id": "client",
            "kind": "text",
            "default": "client",
            "valueEnv": "GAMMA_CLIENT"
          }
        ],
        "mcp": {
          "server": "gamma",
          "clients": {
            "claude-code": {},
            "codex": {
              "parameters": {
                "client": "codex"
              }
            }
          }
        }
      },
      {
        "id": "not-mcp",
        "verb": "run",
        "command": [
          "echo",
          "hello"
        ]
      }
    ]
  },
  "servers": {
    "claude-code": [
      {
        "name": "alpha",
        "command": "bun",
        "args": [
          "./run.ts",
          "serve",
          "base"
        ]
      },
      {
        "name": "beta.gateway",
        "command": "bun",
        "args": [
          "./run.ts",
          "gateway",
          "--scopes",
          "a.read,b.write",
          "--folder=space"
        ]
      },
      {
        "name": "gamma",
        "command": "repo",
        "args": [
          "mcp"
        ],
        "env": {
          "GAMMA_CLIENT": "client"
        }
      }
    ],
    "codex": [
      {
        "name": "alpha",
        "command": "bun",
        "args": [
          "./run.ts",
          "serve",
          "codex"
        ]
      },
      {
        "name": "beta.gateway",
        "command": "bun",
        "args": [
          "./run.ts",
          "gateway",
          "--scopes",
          "a.read,b.write",
          "--folder=space"
        ]
      },
      {
        "name": "gamma",
        "command": "repo",
        "args": [
          "mcp"
        ],
        "env": {
          "GAMMA_CLIENT": "codex"
        }
      }
    ]
  },
  "files": {
    ".mcp.json": "{\n  \"mcpServers\": {\n    \"alpha\": {\n      \"type\": \"stdio\",\n      \"command\": \"bun\",\n      \"args\": [\n        \"./run.ts\",\n        \"serve\",\n        \"base\"\n      ]\n    },\n    \"beta.gateway\": {\n      \"type\": \"stdio\",\n      \"command\": \"bun\",\n      \"args\": [\n        \"./run.ts\",\n        \"gateway\",\n        \"--scopes\",\n        \"a.read,b.write\",\n        \"--folder=space\"\n      ]\n    },\n    \"gamma\": {\n      \"type\": \"stdio\",\n      \"command\": \"repo\",\n      \"args\": [\n        \"mcp\"\n      ],\n      \"env\": {\n        \"GAMMA_CLIENT\": \"client\"\n      }\n    }\n  }\n}\n",
    ".codex/config.toml": "[mcp_servers.alpha]\ncommand = \"bun\"\nargs = [\"./run.ts\", \"serve\", \"codex\"]\nenabled = true\ncwd = \".\"\n\n[mcp_servers.\"beta.gateway\"]\ncommand = \"bun\"\nargs = [\"./run.ts\", \"gateway\", \"--scopes\", \"a.read,b.write\", \"--folder=space\"]\nenabled = true\ncwd = \".\"\n\n[mcp_servers.gamma]\ncommand = \"repo\"\nargs = [\"mcp\"]\nenv = { GAMMA_CLIENT = \"codex\" }\nenabled = true\ncwd = \".\"\n"
  },
  "launchers": [
    {
      "server": "alpha",
      "expected": {
        "command": "bun",
        "args": [
          "./run.ts",
          "serve",
          "base"
        ]
      }
    },
    {
      "server": "beta.gateway",
      "expected": {
        "command": "bun",
        "args": [
          "./run.ts",
          "gateway"
        ]
      }
    },
    {
      "server": "gamma",
      "expected": {
        "command": "repo",
        "args": [
          "mcp"
        ]
      }
    }
  ],
  "refusals": [
    {
      "id": "unknown-parameter",
      "tool": {
        "id": "t",
        "command": [
          "bun"
        ],
        "mcp": {
          "server": "t",
          "clients": {
            "codex": {
              "parameters": {
                "nope": "x"
              }
            }
          }
        }
      },
      "message": "no parameter nope"
    },
    {
      "id": "missing-required",
      "tool": {
        "id": "t",
        "command": [
          "bun"
        ],
        "parameters": [
          {
            "id": "p",
            "kind": "text",
            "required": true,
            "valuePositional": true
          }
        ],
        "mcp": {
          "server": "t",
          "clients": {
            "codex": {}
          }
        }
      },
      "message": "needs a value"
    },
    {
      "id": "unknown-client",
      "tool": {
        "id": "t",
        "command": [
          "bun"
        ],
        "mcp": {
          "server": "t",
          "clients": {
            "windsurf": {}
          }
        }
      },
      "message": "unknown client windsurf"
    },
    {
      "id": "choice-parameter",
      "tool": {
        "id": "t",
        "command": [
          "bun"
        ],
        "parameters": [
          {
            "id": "p",
            "kind": "choice"
          }
        ],
        "mcp": {
          "server": "t",
          "clients": {
            "codex": {}
          }
        }
      },
      "message": "a flag or an environment variable"
    },
    {
      "id": "retired-ide-vscode",
      "tool": {
        "id": "t",
        "command": [
          "bun"
        ],
        "mcp": {
          "server": "t",
          "clients": {
            "vscode": {}
          }
        }
      },
      "message": "unknown client vscode"
    },
    {
      "id": "retired-ide-cursor",
      "tool": {
        "id": "t",
        "command": [
          "bun"
        ],
        "mcp": {
          "server": "t",
          "clients": {
            "cursor": {}
          }
        }
      },
      "message": "unknown client cursor"
    }
  ]
}
