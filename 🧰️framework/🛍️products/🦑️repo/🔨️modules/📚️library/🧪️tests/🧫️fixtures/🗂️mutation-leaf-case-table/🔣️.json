{
  "schemaVersion": 1,
  "contractId": "mutation-leaf-case-table-v1",
  "semantics": {
    "table": "`<owner>/🧪️tests/🔣️.cases.json` beside a schema-side mutation leaf: one JSON object whose only member lists every fixture bundle directory of that leaf (`🧪️tests/🧫️fixtures/🧬️mutations/<owner>/<case>`).",
    "valid": "Whether the repository's parser accepts the source as a case table.",
    "schemaValid": "Whether the JSON Schema in `schema` accepts the parsed document. The third-party Ajv result must equal it. Folded duplicates (U+FE0F removed, NFC) are beyond JSON Schema, so they are valid there and invalid for the parser.",
    "reason": "A fragment of the parser's refusal.",
    "problems": "How a table disagrees with the bundles of its leaf; names compare with U+FE0F removed and NFC applied."
  },
  "policy": {
    "fileKindId": "json-case-table",
    "casesField": "cases",
    "extensionChain": ".cases.json"
  },
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "mutation-leaf-case-table-v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "cases"
    ],
    "properties": {
      "cases": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[^/\\\\\\s](?:[^/\\\\]*[^/\\\\\\s])?$"
        }
      }
    }
  },
  "parse": [
    {
      "id": "two-cases",
      "note": "a plain table keeps its order",
      "source": "{\"cases\": [\"↔️flips\", \"⚠️unchanged\"]}",
      "valid": true,
      "schemaValid": true,
      "cases": [
        "↔️flips",
        "⚠️unchanged"
      ]
    },
    {
      "id": "variation-selector-absent",
      "note": "a name without U+FE0F is kept as written",
      "source": "{\"cases\": [\"🧹delete\"]}",
      "valid": true,
      "schemaValid": true,
      "cases": [
        "🧹delete"
      ]
    },
    {
      "id": "not-json",
      "note": "a truncated document is refused",
      "source": "{\"cases\": [",
      "valid": false,
      "schemaValid": false,
      "reason": "is not JSON"
    },
    {
      "id": "array-root",
      "note": "the root must be an object",
      "source": "[\"a\"]",
      "valid": false,
      "schemaValid": false,
      "reason": "must be a JSON object"
    },
    {
      "id": "extra-member",
      "note": "only the cases member is allowed",
      "source": "{\"cases\":[\"a\"],\"note\":\"x\"}",
      "valid": false,
      "schemaValid": false,
      "reason": "exactly the member"
    },
    {
      "id": "missing-member",
      "note": "the cases member is required",
      "source": "{\"list\":[\"a\"]}",
      "valid": false,
      "schemaValid": false,
      "reason": "exactly the member"
    },
    {
      "id": "empty-array",
      "note": "a table lists at least one case",
      "source": "{\"cases\":[]}",
      "valid": false,
      "schemaValid": false,
      "reason": "non-empty array"
    },
    {
      "id": "non-string-item",
      "note": "every case is a string",
      "source": "{\"cases\":[1]}",
      "valid": false,
      "schemaValid": false,
      "reason": "plain directory names"
    },
    {
      "id": "empty-item",
      "note": "a case is not empty",
      "source": "{\"cases\":[\"\"]}",
      "valid": false,
      "schemaValid": false,
      "reason": "plain directory names"
    },
    {
      "id": "slash-item",
      "note": "a case is one directory name",
      "source": "{\"cases\":[\"a/b\"]}",
      "valid": false,
      "schemaValid": false,
      "reason": "plain directory names"
    },
    {
      "id": "backslash-item",
      "note": "a case is one directory name",
      "source": "{\"cases\":[\"a\\\\b\"]}",
      "valid": false,
      "schemaValid": false,
      "reason": "plain directory names"
    },
    {
      "id": "padded-item",
      "note": "a case has no surrounding whitespace",
      "source": "{\"cases\":[\" a\"]}",
      "valid": false,
      "schemaValid": false,
      "reason": "plain directory names"
    },
    {
      "id": "literal-duplicate",
      "note": "the same name twice",
      "source": "{\"cases\":[\"a\",\"a\"]}",
      "valid": false,
      "schemaValid": false,
      "reason": "twice"
    },
    {
      "id": "folded-duplicate",
      "note": "U+FE0F variants are the same directory",
      "source": "{\"cases\": [\"🧹delete\", \"🧹️delete\"]}",
      "valid": false,
      "schemaValid": true,
      "reason": "twice"
    },
    {
      "id": "normalization-duplicate",
      "note": "NFC and NFD spellings are the same directory",
      "source": "{\"cases\": [\"é\", \"é\"]}",
      "valid": false,
      "schemaValid": true,
      "reason": "twice"
    }
  ],
  "problems": [
    {
      "id": "exact",
      "note": "the table lists exactly the bundles",
      "listed": [
        "↔️flips",
        "⚠️unchanged"
      ],
      "bundles": [
        "⚠️unchanged",
        "↔️flips"
      ],
      "expected": []
    },
    {
      "id": "fold-equal",
      "note": "U+FE0F spelling differences are not disagreements",
      "listed": [
        "🧹delete"
      ],
      "bundles": [
        "🧹️delete"
      ],
      "expected": []
    },
    {
      "id": "unlisted-bundle",
      "note": "a bundle the table does not list",
      "listed": [
        "↔️flips"
      ],
      "bundles": [
        "↔️flips",
        "⚠️unchanged"
      ],
      "expected": [
        "does not list the fixture bundle ⚠️unchanged"
      ]
    },
    {
      "id": "phantom-case",
      "note": "a listed case without a bundle",
      "listed": [
        "↔️flips",
        "⚠️unchanged"
      ],
      "bundles": [
        "↔️flips"
      ],
      "expected": [
        "lists ⚠️unchanged, which has no fixture bundle"
      ]
    }
  ]
}
