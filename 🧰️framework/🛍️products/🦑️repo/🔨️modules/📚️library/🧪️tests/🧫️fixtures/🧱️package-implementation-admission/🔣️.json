{
  "schemaVersion": 1,
  "contractId": "package-implementation-admission-v1",
  "semantics": {
    "admissionCases": "Whether a package file at relativePath (below the language package root) may hold implementation under the rule's implementationAdmission. directoryFiles lists the file names next to it.",
    "sourceCases": "The glue-grammar role of a package source. Every source parses with the language's own formatter (gofmt -e, rustfmt).",
    "directoryCases": "Whether a directory below a package root may exist under the rule's implementationAdmission and directoryAdmissions: it is or leads to an admitted build unit (unitBelow), it lies on the way to an entry the manifest declares (declaredEntryDirectories), or it leads to a file of a fixed contract anchored below the package root (contractTreeBelow).",
    "declaredEntryCases": "The directories (relative to the package root) on the way to the file targets of the named manifest fields. Targets that are not './'-relative or that leave the package root declare nothing. oracle=true cases are also resolved by the TypeScript compiler's bundler resolution and every resolved file must lie in a declared directory.",
    "scanCases": "A synthetic package tree (files by path below the language package root, language directory as named) and the exact set of paths the repository scan reports as packaging violations.",
    "contractTreePatterns": "The relative file patterns a rule's fixed contracts describe below the package root: only patterns anchored at the package's own prefix qualify.",
    "gitVisibleCases": "A temporary git work tree: tracked and untracked-not-ignored files are authored package content, ignored build output is never judged.",
    "bodyCases": "A synthetic package tree and the exact set of package-implementation findings the repository scan reports for it: a package stylesheet that only wires other stylesheets is glue, one that authors a rule is implementation."
  },
  "manifestFilenames": {
    "cargo-manifest": "Cargo.toml"
  },
