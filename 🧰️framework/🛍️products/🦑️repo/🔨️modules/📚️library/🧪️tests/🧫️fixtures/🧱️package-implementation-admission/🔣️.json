  "contractTreePatterns": [
    {
      "id": "next-route-pattern-is-a-tree",
      "packagePrefix": "📦️packages/🟦️typescript",
      "patterns": [
        "**/📦️packages/🟦️typescript/app/**/route.ts",
        "**/📦️packages/🟦️typescript/next.config.mjs",
        "**/📜️script.ts",
        "**/package.json",
        "**/📦️packages/🦀️rust/Cargo.toml"
      ],
      "expected": [
        "app/**/route.ts"
      ]
    },
    {
      "id": "no-anchored-pattern-no-tree",
      "packagePrefix": "📦️packages/🟦️typescript",
      "patterns": [
        "**/📜️script.ts",
        "**/tsconfig.json"
      ],
      "expected": []
    }
  ],
