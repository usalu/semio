  "declaredEntryCases": [
    {
      "id": "exports-subpaths-declare-every-ancestor-directory",
      "manifest": {
        "name": "fixture",
        "exports": {
          "./build": "./🏗️build/🟦️.ts",
          "./build/operations": "./🏗️build/⚙️operations/🟦️.ts"
        }
      },
      "entryFields": [
        "exports"
      ],
      "expectedDirectories": [
        "🏗️build",
        "🏗️build/⚙️operations"
      ],
      "oracle": true
    },
    {
      "id": "conditional-targets-are-followed",
      "manifest": {
        "name": "fixture",
        "exports": {
          "./a": {
            "types": "./🅰️a/🟦️.ts",
            "import": "./🅰️a/🅱️b/🟦️.ts"
          }
        }
      },
      "entryFields": [
        "exports"
      ],
      "expectedDirectories": [
        "🅰️a",
        "🅰️a/🅱️b"
      ],
      "oracle": true
    },
    {
      "id": "root-entry-declares-no-directory",
      "manifest": {
        "name": "fixture",
        "exports": "./🟦️.ts"
      },
      "entryFields": [
        "exports"
      ],
      "expectedDirectories": [],
      "oracle": true
    },
    {
      "id": "targets-leaving-the-package-declare-nothing",
      "manifest": {
        "name": "fixture",
        "exports": {
          "./x": "../../🏗️outside/🟦️.ts",
          "./y": "./🏗️in/../../escape/🟦️.ts"
        }
      },
      "entryFields": [
        "exports"
      ],
      "expectedDirectories": [],
      "oracle": false
    },
    {
      "id": "bare-specifiers-declare-nothing",
      "manifest": {
        "name": "fixture",
        "exports": {
          "./x": "fixture-other/🟦️.ts"
        }
      },
      "entryFields": [
        "exports"
      ],
      "expectedDirectories": [],
      "oracle": false
    },
    {
      "id": "main-and-types-declare-their-directories",
      "manifest": {
        "name": "fixture",
        "main": "./📦️dist/🟨️.mjs",
        "types": "./📦️dist/📜️types/🟦️.d.ts"
      },
      "entryFields": [
        "exports",
        "main",
        "types"
      ],
      "expectedDirectories": [
        "📦️dist",
        "📦️dist/📜️types"
      ],
      "oracle": false
    },
    {
      "id": "fields-outside-the-rule-declare-nothing",
      "manifest": {
        "name": "fixture",
        "bin": "./🛠️tool/🟦️.ts"
      },
      "entryFields": [
        "exports"
      ],
      "expectedDirectories": [],
      "oracle": false
    },
    {
      "id": "array-targets-are-followed",
      "manifest": {
        "name": "fixture",
        "exports": {
          "./x": [
            "./🅰️a/🟦️.ts",
            "./🅱️b/🟦️.ts"
          ]
        }
      },
      "entryFields": [
        "exports"
      ],
      "expectedDirectories": [
        "🅰️a",
        "🅱️b"
      ],
      "oracle": false
    }
  ],
  "scanCases": [
    {
      "id": "typescript-declared-facade-tree-is-admitted-and-a-stray-directory-is-not",
      "language": "🟦️typescript",
      "files": {
        "package.json": "{\"name\": \"@semio/fixture\", \"semio\": {\"role\": \"framework\", \"id\": \"scan-ts\"}, \"exports\": {\"./build\": \"./\\ud83c\\udfd7\\ufe0fbuild/\\ud83d\\udfe6\\ufe0f.ts\", \"./build/operations\": \"./\\ud83c\\udfd7\\ufe0fbuild/\\u2699\\ufe0foperations/\\ud83d\\udfe6\\ufe0f.ts\"}}",
        "🏗️build/🟦️.ts": "export * from \"./⚙️operations/🟦️.ts\";\n",
        "🏗️build/⚙️operations/🟦️.ts": "export { run } from \"../../../../../../🧯️owner/🟦️.ts\";\n",
        "🧯️stray/🟦️.ts": "export { run } from \"../../../../../🧯️owner/🟦️.ts\";\n"
      },
      "expectedViolations": [
        "🧯️stray"
      ]
    },
    {
      "id": "go-modules-and-nested-packages-are-admitted-and-a-directory-without-go-source-is-not",
      "language": "🐹️go",
      "files": {
        "go.mod": "module example.com/fixture\n\ngo 1.22\n",
        "go.sum": "",
        "📋️project.json": "{\"name\": \"fixture\", \"metadata\": {\"semio\": {\"role\": \"framework\", \"id\": \"scan-go\"}}}",
        "🐹️.go": "package fixture\n",
        "🌨️payloads/🐹️.go": "package payloads\n\nfunc Name() string { return \"payloads\" }\n",
        "🗄️store/📥️inner/🐹️.go": "package inner\n\nfunc Name() string { return \"inner\" }\n",
        "📂️assets/data.txt": "x\n"
      },
      "expectedViolations": [
        "📂️assets",
        "📂️assets/data.txt"
      ]
    },
    {
      "id": "cargo-crates-locks-are-admitted-and-a-module-directory-without-manifest-is-not",
      "language": "🦀️rust",
      "files": {
        "Cargo.toml": "[package]\nname = \"scan-rust\"\nversion = \"0.0.0\"\n[package.metadata.semio]\nrole = \"framework\"\nid = \"scan-rust\"\n[lib]\npath = \"🦀️.rs\"\n",
        "Cargo.lock": "version = 4\n",
        "🦀️.rs": "pub mod unit;\n",
        "🧩️unit/Cargo.toml": "[package]\nname = \"scan-rust-unit\"\nversion = \"0.0.0\"\n",
        "🧩️unit/🦀️.rs": "pub mod inner;\n",
        "🪞️mirror/🦀️.rs": "pub mod x;\n"
      },
      "expectedViolations": [
        "🪞️mirror"
      ]
    },
    {
      "id": "ignored-build-output-directories-are-never-judged",
      "language": "🔷️dotnet",
      "files": {
        "🧪️Fixture.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\"></Project>\n",
        "obj/project.assets.json": "{}\n",
        "bin/Fixture.dll": "x\n"
      },
      "expectedViolations": []
    },
    {
      "id": "next-route-tree-is-admitted-and-a-directory-without-routes-is-not",
      "language": "🟦️typescript",
      "files": {
        "package.json": "{\"name\": \"@semio/fixture\", \"semio\": {\"role\": \"framework\", \"id\": \"scan-next\"}}",
        "app/api/v1/auth/route.ts": "export { handle as GET } from \"../../../../../../🧯️owner/🟦️.ts\";\n",
        "app/layout.tsx": "export { Layout as default } from \"../../../../🧯️owner/🟦️.tsx\";\n",
        "🧯️stray/notes.txt": "x\n"
      },
      "expectedViolations": [
        "🧯️stray",
        "🧯️stray/notes.txt"
      ]
    },
    {
      "id": "fixed-contract-files-without-a-file-kind-and-package-locks-are-admitted",
