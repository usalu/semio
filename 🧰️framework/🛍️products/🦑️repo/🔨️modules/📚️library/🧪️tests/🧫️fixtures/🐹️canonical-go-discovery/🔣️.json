{
  "contract": "canonical-go-input-projection-v3",
  "layout": {
    "testsDirectory": "🧪️tests",
    "implementationFilename": "🐹️.go",
    "packagesDirectory": "📦️packages",
    "languageDirectory": "🐹️go",
    "opaqueDirectoryNames": ["🧫️fixtures", "📦️packages"],
    "sourceDirectoryNames": ["🧮️addition", "🔠️uppercase", "🎯️offset"]
  },
  "module": "example.com/semio/canonical-go-tests",
  "dependency": {
    "directory": "dependency",
    "module": "example.com/semio/canonical-go-offset",
    "domain": "🎯️offset",
    "package": "offset",
    "production": "func Zero() int { return 0 }"
  },
  "nativePackages": [
    {
      "owner": "internal/direct",
      "package": "direct",
      "production": "func Value() int { return 1 }"
    }
  ],
  "cases": [
    {
      "owner": ".",
      "domain": "🧮️addition",
      "case": "🧮️private-addition",
      "package": "proof",
      "production": "func add(left, right int) int { return left + right + offset.Zero() }",
      "productionImports": ["example.com/semio/canonical-go-offset"],
      "test": "func TestPrivateAddition(t *testing.T) { if add(2, 3) != 5 { t.Fatal(\"addition\") } }"
    },
    {
      "owner": "internal/text",
      "domain": "🔠️uppercase",
      "case": "🔠️private-uppercase",
      "package": "text",
      "production": "func upper(value string) string { return strings.ToUpper(value) }",
      "productionImports": ["strings"],
      "test": "func TestPrivateUppercase(t *testing.T) { if upper(\"go\") != \"GO\" { t.Fatal(\"uppercase\") } }"
    }
  ],
  "opaqueCases": [
    {
      "owner": "🧫️fixtures/opaque-go-repository",
      "domain": "🧮️addition",
      "case": "🧪️must-not-run",
      "package": "fixture",
      "production": "func fixtureValue() int { return 1 }",
      "test": "func TestFixtureMustStayOpaque(t *testing.T) { t.Fatal(\"fixture repository executed\") }"
    }
  ],
  "expectedPackages": [
    ".",
    "./internal/direct",
    "./internal/text"
  ],
  "expectedSources": [
    "dependency/🎯️offset/🐹️.go",
    "🧮️addition/🐹️.go",
    "internal/text/🔠️uppercase/🐹️.go"
  ],
  "expectedTests": [
    "TestPrivateAddition",
    "TestPrivateUppercase"
  ],
  "packageModule": {
    "owner": "owners/area",
    "module": "example.com/semio/canonical-go-area",
    "package": "area",
    "production": "func Zero() int { return 0 }",
    "members": [
      {
        "domain": "🧮️addition",
        "production": "func add(left, right int) int { return left + right + Zero() }"
      }
    ],
    "cases": [
      {
        "case": "🔬️unit",
        "package": "area",
        "mapped": true,
        "test": "func TestPackageModulePrivateAddition(t *testing.T) { if add(2, 3) != 5 { t.Fatal(\"addition\") } }"
      },
      {
        "case": "🌗️external",
        "package": "area_test",
        "mapped": true,
        "imports": ["example.com/semio/canonical-go-area"],
        "test": "func TestPackageModuleExternalZero(t *testing.T) { if area.Zero() != 0 { t.Fatal(\"zero\") } }"
      },
      {
        "case": "🤝️adapter",
        "package": "adapter",
        "mapped": false,
        "test": "func TestPackageModuleAdapterMustStayOutside(t *testing.T) { t.Fatal(\"adapter executed\") }"
      }
    ],
    "expectedPackages": ["."],
    "expectedSources": ["🧮️addition/🐹️.go"],
    "expectedTests": ["../../🧪️tests/🌗️external/🐹️.go", "../../🧪️tests/🔬️unit/🐹️.go"],
    "expectedGoTests": ["TestPackageModulePrivateAddition", "TestPackageModuleExternalZero"]
  }
}
