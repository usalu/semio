{
  "version": 1,
  "scripts": {
    "repo": "bun ./🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/📜️script.ts repo",
    "setup": "bun repo run workspace:setup",
    "dashboard": "bun repo run @semio-tech/repo-dashboard-rs:run --output=stream",
    "dashboard:install": "bun repo run @semio-tech/repo-dashboard-rs:build --exclude-dependencies --skip-cache --output=stream"
  },
  "postCreateCommand": [
    "bun",
    "repo",
    "run",
    "workspace:setup"
  ],
  "contexts": [
    {
      "environment": {
        "SEMIO_WORKSPACE_ROOT": "/repo/selected",
        "REPO_ROOT": "/repo/hint"
      },
      "expected": "/repo/selected"
    },
    {
      "environment": {
        "REPO_ROOT": "/repo/hint"
      },
      "expected": "/repo/hint"
    }
  ],
  "editorCommands": [
    {
      "labels": {
        "en": "🛠️ Build Tools · Set Up All",
        "de": "🛠️ Build-Werkzeuge · Alle Einrichten"
      },
      "args": "tools setup all",
      "group": "0_setup",
      "order": 20.1
    },
    {
      "labels": {
        "en": "🛠️ Build Tools · Set Up Nx",
        "de": "🛠️ Build-Werkzeuge · Nx Einrichten"
      },
      "args": "tools setup nx",
      "group": "0_setup",
      "order": 20.2
    },
    {
      "labels": {
        "en": "🛠️ Build Tools · Set Up Bazel",
        "de": "🛠️ Build-Werkzeuge · Bazel Einrichten"
      },
      "args": "tools setup bazel",
      "group": "0_setup",
      "order": 20.3
    },
    {
      "labels": {
        "en": "🕸️ Build Graph · Inspect",
        "de": "🕸️ Build-Graph · Anzeigen"
      },
      "args": "graph",
      "group": "4_build",
      "order": 20.4
    },
    {
      "labels": {
        "en": "🧩️ Build Projects · List",
        "de": "🧩️ Build-Projekte · Auflisten"
      },
      "args": "show projects",
      "group": "4_build",
      "order": 20.5
    },
    {
      "labels": {
        "en": "🎯️ Build Tasks · List",
        "de": "🎯️ Build-Aufgaben · Auflisten"
      },
      "args": "show targets",
      "group": "4_build",
      "order": 20.6
    },
    {
      "labels": {
        "en": "🧪️ Build Tools · Bazel End To End",
        "de": "🧪️ Build-Werkzeuge · Bazel Vollständig Prüfen"
      },
      "args": "run workspace:test-build-tool-bazel --exclude-dependencies --skip-cache",
      "group": "4_gate",
      "order": 20.7
    },
    {
      "labels": {
        "en": "🧪️ Build Tools · Bazel Bootstrap",
        "de": "🧪️ Build-Werkzeuge · Bazel Einrichtung Prüfen"
      },
      "args": "run workspace:test-build-tool-bazel-bootstrap --exclude-dependencies --skip-cache",
      "group": "4_gate",
      "order": 20.8
    },
    {
      "labels": {
        "en": "🧪️ Build Interface · Verify",
        "de": "🧪️ Build-Schnittstelle · Prüfen"
      },
      "args": "run @semio-tech/repo-lib:test-build-surfaces --exclude-dependencies --skip-cache",
      "group": "4_gate",
      "order": 20.9
    },
    {
      "labels": {
        "en": "🧪️ Workspace Identity · All Languages",
        "de": "🧪️ Workspace-Identität · Alle Sprachen"
      },
      "args": "run @semio-tech/framework-process:test-workspace --exclude-dependencies --skip-cache",
      "group": "4_gate",
      "order": 21
    },
    {
      "labels": {
        "en": "🏗️ Build Task · Run",
        "de": "🏗️ Build-Aufgabe · Ausführen"
      },
      "args": "--tool=${input:repoBuildTool} run \"${input:repoBuildTask}\" --output=stream",
      "group": "4_build",
      "order": 21.1
    },
    {
      "labels": {
        "en": "🔎️ Build Task · Inspect Plan",
        "de": "🔎️ Build-Aufgabe · Plan Anzeigen"
      },
      "args": "--tool=${input:repoBuildTool} run \"${input:repoBuildTask}\" --dry-run",
      "group": "4_build",
      "order": 21.2
    },
    {
      "labels": {
        "en": "🧩️ Build Project · Inspect",
        "de": "🧩️ Build-Projekt · Anzeigen"
      },
      "args": "show project \"${input:repoBuildProject}\"",
      "group": "4_build",
      "order": 21.3
    },
    {
      "labels": {
        "en": "👁️ Build Sources · Watch",
        "de": "👁️ Build-Quellen · Beobachten"
      },
      "args": "--tool=${input:repoBuildTool} watch --projects=\"${input:repoBuildProjects}\" -- bun repo run \"${input:repoBuildTask}\" --output=stream",
      "group": "4_build",
      "order": 21.4
    },
    {
      "labels": {
        "en": "🧹️ Build Cache · Reset",
        "de": "🧹️ Build-Cache · Zurücksetzen"
      },
      "args": "--tool=${input:repoBuildTool} reset",
      "group": "0_setup",
      "order": 21.5
    },
    {
      "labels": {
        "en": "🧪️ Runtime Build Producer · Verify",
        "de": "🧪️ Laufzeit-Build-Erzeuger · Prüfen"
      },
      "args": "run workspace:test-runtime-build-producer --exclude-dependencies --skip-cache",
      "group": "4_gate",
      "order": 21.6
    }
  ],
  "environmentSources": [
