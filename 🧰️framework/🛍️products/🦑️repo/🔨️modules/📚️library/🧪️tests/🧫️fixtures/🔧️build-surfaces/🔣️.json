  "editorInputs": [
    {
      "id": "repoBuildTool",
      "type": "pickString",
      "description": "Build tool / Build-Werkzeug",
      "options": [
        "nx",
        "bazel"
      ]
    },
    {
      "id": "repoBuildTask",
      "type": "promptString",
      "description": "Project:task[:configuration] / Projekt:Aufgabe[:Konfiguration]"
    },
    {
      "id": "repoBuildProject",
      "type": "promptString",
      "description": "Build project / Build-Projekt"
    },
    {
      "id": "repoBuildProjects",
      "type": "promptString",
      "description": "Project names or patterns separated by commas / Durch Komma getrennte Projektnamen oder Muster"
    }
  ],
  "fixedBuildFiles": [
    {
      "id": "root-bazel-configuration",
      "path": ".bazelrc"
    },
    {
      "id": "root-bazel-version",
      "path": ".bazelversion"
    },
    {
      "id": "root-bazel-module",
      "path": "MODULE.bazel"
    }
  ]
}
