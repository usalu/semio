        }
      },
      "accept": false,
      "edges": []
    },
    {
      "id": "a-package-specifier-never-matches-path-rules-when-the-resolver-resolved-it",
      "exports": {
        ".": "./dist/main.js",
        "./view": "./view.ts",
        "./subsets/base/schema": "./schema.ts"
      },
      "modules": [
        {
          "source": "pkg/a.ts",
          "dependencies": [
            {
              "module": "@semio-tech/x/subsets/base/schema",
              "resolved": "pkg/x/schema.ts",
              "couldNotResolve": false,
              "followable": true,
              "dependencyTypes": [
                "local"
              ],
              "circular": false
            }
          ]
        },
        {
          "source": "pkg/x/view.ts",
          "dependencies": []
        },
        {
          "source": "pkg/x/schema.ts",
          "dependencies": []
