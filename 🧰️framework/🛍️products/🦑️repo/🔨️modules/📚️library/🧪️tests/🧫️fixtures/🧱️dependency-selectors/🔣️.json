        },
        "to": {
          "path": "subsets/base"
        }
      },
      "accept": true,
      "edges": []
    },
    {
      "id": "the-resolved-path-still-matches-path-rules",
      "exports": {
        ".": "./dist/main.js",
        "./view": "./view.ts",
        "./subsets/base/schema": "./schema.ts"
      },
      "modules": [
        {
          "source": "pkg/a.ts",
          "dependencies": [
            {
              "module": "../x/schema",
              "resolved": "pkg/x/subsets/base/schema.ts",
              "couldNotResolve": false,
              "followable": true,
              "dependencyTypes": [
                "local"
              ],
              "circular": false
            }
          ]
        },
        {
          "source": "pkg/x/view.ts",
          "dependencies": []
        },
        {
          "source": "pkg/x/schema.ts",
          "dependencies": []
        }
      ],
      "rule": {
        "name": "to-base-subset",
        "severity": "error",
        "from": {
          "path": "^pkg/a"
        },
        "to": {
          "path": "subsets/base"
        }
      },
      "accept": true,
      "edges": [
        [
          "pkg/a.ts",
          "pkg/x/subsets/base/schema.ts"
        ]
      ],
      "extraSources": [
        "pkg/x/subsets/base/schema.ts"
      ]
    }
