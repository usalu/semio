  "contractId": "tracked-path-budget-v1",
  "semantics": {
    "policy": "The product limits of path-budget-v1: a path may have at most maxPathUtf16Units UTF-16 code units (Windows MAX_PATH semantics, U+FE0F counts one unit, an astral emoji two) and every component at most maxComponentUtf8Bytes UTF-8 bytes.",
    "checkoutRoots": "Absolute checkout roots a Windows developer really uses; utf16Units is the unit count of the root text including its trailing backslash.",
    "treeRoot": "The checkout root every tracked product path must fit under: units(root) + units(repo-relative path) stay within maxPathUtf16Units. The slash of a repo-relative path becomes one backslash of the same length.",
    "ticketPrefix": "Paths below this prefix are ticket workspace; they are held to the repo-relative limit only, because a ticket may never carry source copies.",
    "tracked": "Every path that git lists as indexed, plus every untracked path that is not ignored, and that still exists on disk.",
    "parts": "The repo-relative path is the concatenation of every part text repeated count times."
  },
  "policy": {
    "maxPathUtf16Units": 256,
    "maxComponentUtf8Bytes": 255
  },
