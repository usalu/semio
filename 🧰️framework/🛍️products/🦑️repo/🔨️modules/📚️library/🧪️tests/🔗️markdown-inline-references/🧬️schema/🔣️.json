{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bounded Markdown inline reference extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "grammar",
    "extraction",
    "oracle",
    "limits",
    "cases",
    "cacheSequence",
    "stress"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "markdown-inline-reference-spans-v1"
    },
    "grammar": {
      "const": {
        "label": "optional ! then [ then zero-or-more non-] code units then ]",
        "destination": "( then one-or-more non-whitespace non-) code units",
        "title": "optional whitespace plus double-quoted zero-or-more non-quote code units",
        "close": "immediate )",
        "coordinates": "UTF-16 destination-only half-open offsets; line/column count raw LF boundaries",
        "ordering": "inline then definitions then HTML; duplicates preserved",
        "escapes": "no new destination or title escape grammar",
        "scope": "source-only text scanner, not CommonMark document parsing"
      }
    },
    "extraction": {
      "const": {
        "required": [
          "referenceTokens",
          "regexTokens",
          "htmlTokens",
          "lineLocation",
          "markdownCommentPathReferenceAuthority",
          "markdownSourceCoordinateSpans"
        ],
        "optional": [
          "markdownInlineTokens"
        ],
        "globals": [
          "indexedLineContent",
          "indexedLineStarts"
        ],
        "missingDependencies": "fail, never stub"
      }
    },
    "oracle": {
      "const": {
        "package": "markdown-it",
        "version": "14.3.0",
        "dependencyKind": "devDependencies",
        "entry": "inline.parse raw content",
        "proof": "emitted normalized values plus distinct raw parseLinkDestination spans; speculative helper calls are not links"
      }
    },
    "limits": {
      "const": {
        "childMilliseconds": 2000,
        "childOutputBytes": 65536,
        "caseMilliseconds": 5000,
        "childDescendants": 0
      }
    },
    "cases": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "source",
          "oracleScope",
          "reason",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "enum": [
              "📝️.md",
              "📝️.mdx",
              "NOTES.MD",
              "source.txt"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 2048
          },
          "oracleScope": {
            "enum": [
              "common-subset",
              "scanner-only"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/definitions/token"
            }
          }
        }
      }
    },
    "cacheSequence": {
      "const": [
        "plain-link",
        "cache-content-newline",
        "cache-content-two-newlines",
        "plain-link",
        "crlf-prefix",
        "utf16-prefix"
      ]
    },
    "stress": {
      "const": [
        {
          "id": "ansi-open-labels",
          "unit": "\u001b[0m",
          "repeat": 16384,
          "suffix": "]\n[kept](./source.ts)",
          "codeUnits": 65557,
          "bytes": 65557,
          "expected": [
            {
              "adapter": "markdown",
              "structuredLocation": "markdown-link:2:8@65545",
              "start": 65545,
              "end": 65556,
              "value": "./source.ts"
            }
          ]
        },
        {
          "id": "repeated-title-candidates",
          "unit": "[x](word \"",
          "repeat": 8192,
          "suffix": "]\n[kept](./source.ts)",
          "codeUnits": 81941,
          "bytes": 81941,
          "expected": [
            {
              "adapter": "markdown",
              "structuredLocation": "markdown-link:2:8@81929",
              "start": 81929,
              "end": 81940,
              "value": "./source.ts"
            }
          ]
        }
      ]
    }
  },
  "definitions": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "structuredLocation",
        "start",
        "end",
        "value"
      ],
      "properties": {
        "adapter": {
          "const": "markdown"
        },
        "structuredLocation": {
          "type": "string",
          "pattern": "^(markdown-link|html-attribute):[1-9][0-9]*:[1-9][0-9]*@[0-9]+$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
