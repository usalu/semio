{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "ticketsRoot", "tickets", "special", "cases", "reopened"],
  "properties": {
    "version": { "const": 1 },
    "ticketsRoot": { "type": "string", "minLength": 1 },
    "tickets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "manifest"], "properties": { "path": { "type": "string", "minLength": 1 }, "manifest": { "type": ["string", "null"] } } } },
    "special": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "kind"], "properties": { "path": { "type": "string", "minLength": 1 }, "kind": { "enum": ["symlink", "unreadable"] } } } },
    "cases": { "type": "array", "minItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["name", "candidate", "allowed"], "properties": { "name": { "type": "string", "minLength": 1 }, "candidate": { "type": "string", "minLength": 1 }, "allowed": { "type": "boolean" } } } },
    "reopened": { "type": "string", "minLength": 1 }
  }
}
