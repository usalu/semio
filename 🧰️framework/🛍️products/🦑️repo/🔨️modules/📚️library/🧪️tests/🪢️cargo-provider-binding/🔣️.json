{
  "schemaVersion": 1,
  "accepted": [
    {
      "id": "direct-local-library-binding",
      "consumerManifest": "consumer/Cargo.toml",
      "consumerSource": "[package]\nname = 'consumer'\n\n[dependencies]\nupstream-package = { path = '../provider' }\n",
      "providerManifest": "provider/Cargo.toml",
      "providerSource": "[package]\nname = 'upstream-package'\n\n[lib]\nname = 'actual_library'\npath = 'src/lib.rs'\n",
      "librarySource": "pub fn marker() {}\n",
      "dependencyKey": "upstream-package",
      "workspaceSource": "[workspace]\n",
      "expected": { "externName": "actual_library", "packageName": "upstream-package", "libraryName": "actual_library", "workspaceInherited": false }
    },
    {
      "id": "explicit-same-name-package-override-binding",
