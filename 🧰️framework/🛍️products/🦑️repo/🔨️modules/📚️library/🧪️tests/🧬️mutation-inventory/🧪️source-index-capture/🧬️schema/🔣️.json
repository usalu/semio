{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "expectedRoots", "existingEvidence", "cases", "unknownPath", "cancelFile", "cancelProbePath"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "expectedRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "existingEvidence": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "cases": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/case" } },
    "unknownPath": { "type": "string", "minLength": 1 },
    "cancelFile": { "type": "string", "minLength": 1 },
    "cancelProbePath": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "path", "bytes", "expectedKind", "expectedRole", "retained"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^[^\\\\]+(?:/[^\\\\]+)*$" },
        "bytes": { "type": "string" },
        "expectedKind": { "type": ["string", "null"] },
        "expectedRole": { "enum": ["source", "schema", "specification", "documentation", null] },
        "retained": { "type": "boolean" }
      }
    }
  }
}
