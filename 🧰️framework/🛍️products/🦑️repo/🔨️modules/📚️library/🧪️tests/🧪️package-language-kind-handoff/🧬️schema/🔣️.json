{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "semantics",
    "oracleCompilation",
    "languages",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "package-language-semantic-kind-handoff-v1"
    },
    "semantics": {
      "const": {
        "boundary": "semantic-directory-registry",
        "parentKindId": "packages",
        "variation": "canonical-registered-emoji",
        "ambiguity": "fail-closed",
        "packagePurity": "unchanged"
      }
    },
    "oracleCompilation": {
      "const": {
        "scope": "single-test-invocation",
        "identity": "exact-serialized-json-schema",
        "maxCompilationsPerIdentity": 1,
        "validation": "every-scenario-step-and-compiler"
      }
    },
    "languages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "emoji",
          "slug",
          "allowedDirectoryKindIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "emoji": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "allowedDirectoryKindIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "removeKind": {
            "type": "string",
            "minLength": 1
          },
          "duplicateKind": {
            "type": "string",
            "minLength": 1
          },
          "duplicateBoundary": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "parentKindId",
                "kindId",
                "canonicalName",
                "violationCodes"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "parentKindId": {
                  "type": "string",
                  "minLength": 1
                },
                "kindId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "canonicalName": {
                  "type": "string",
                  "minLength": 1
                },
                "violationCodes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "directory-kind-unresolved",
                      "directory-kind-ambiguous",
                      "package-language-ambiguous"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
