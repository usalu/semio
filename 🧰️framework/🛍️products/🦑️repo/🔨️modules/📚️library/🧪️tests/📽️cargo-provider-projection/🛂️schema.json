{
  "type": "object",
  "required": ["schemaVersion", "accepted", "rejected"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "accepted": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "locator", "source", "tomlOracle", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "tomlOracle": { "type": "object" },
          "expected": { "type": "object" }
        }
      }
    },
    "rejected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "locator", "source", "reason", "tomlOracle"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "tomlOracle": { "type": ["object", "null"] }
        }
      }
    }
  }
}
