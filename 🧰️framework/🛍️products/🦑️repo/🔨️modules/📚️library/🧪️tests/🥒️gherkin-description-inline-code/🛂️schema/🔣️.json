{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gherkin Feature description inline-code span extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "cases", "corpus"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "gherkin-description-inline-code-v1" },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "expected", "oracle"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "source": { "type": "string", "minLength": 1, "maxLength": 512 },
          "oracle": { "type": "boolean" },
          "expected": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "value"],
              "properties": {
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 1 },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "corpus": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "values"],
        "properties": {
          "path": { "type": "string", "pattern": "🥒️\\.feature$" },
          "values": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
