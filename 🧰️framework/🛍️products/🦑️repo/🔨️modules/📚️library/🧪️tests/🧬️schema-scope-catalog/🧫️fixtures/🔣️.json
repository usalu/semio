{
  "contract": "schema-scope-catalog-cases-v1",
  "cases": [
    {
      "id": "valid-module",
      "reason": "A subset module with a draft-07 $id, a root object export and one $defs export is catalogued without findings.",
      "files": {
        "✏️s/🔌️plugins/🔷️probe/🗿️artifacts/🔶️thing/🏅️standards/🔖️1/🪆️subsets/✳️any/🧬️schema/🔣️.json": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "$id": "https://semio.tech/schema/s/probe/thing/artifact.json",
          "title": "ThingArtifact",
          "type": "object",
          "additionalProperties": false,
          "properties": { "corner": { "$ref": "#/$defs/Corner" } },
          "$defs": {
            "Corner": { "type": "object", "additionalProperties": false, "properties": { "x": { "type": "number" } } }
          }
        },
        "✏️s/🔌️plugins/🔷️probe/🗿️artifacts/🔶️thing/🏅️standards/🔖️1/🪆️subsets/✳️any/🧬️schema/🦀️.rs": "pub struct ThingArtifact;\n"
      },
      "expected": {
        "scopes": {
          "s.probe.thing": {
            "path": "✏️s/🔌️plugins/🔷️probe/🗿️artifacts/🔶️thing/🏅️standards/🔖️1/🪆️subsets/✳️any/🧬️schema",
            "level": "artifact-standard-subset",
            "exports": ["Corner", "ThingArtifact"],
            "dependsOn": []
          }
        },
        "diagnosticCodes": [],
        "placementPaths": []
      }
    },
    {
      "id": "cross-scope-reference",
      "reason": "A cross-scope $ref names the target $id and becomes a dependsOn edge, never a nearest-parent guess.",
      "files": {
        "🌎️hub/💡️inference/🧬️schema/🔣️.json": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "$id": "https://semio.tech/schema/hub/inference/contract.json",
          "title": "InferenceApproval",
          "type": "object",
          "additionalProperties": false,
          "properties": { "id": { "type": "string" } },
          "$defs": {
            "Receipt": { "type": "object", "additionalProperties": false, "properties": { "at": { "type": "string" } } }
          }
        },
        "✏️s/🔌️plugins/🔷️probe/🗿️artifacts/🔶️thing/🏅️standards/🔖️1/🪆️subsets/✳️any/🧬️schema/🔣️.json": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "$id": "https://semio.tech/schema/s/probe/thing/artifact.json",
          "title": "ThingArtifact",
          "type": "object",
          "additionalProperties": false,
          "properties": { "receipt": { "$ref": "https://semio.tech/schema/hub/inference/contract.json#/$defs/Receipt" } }
        }
      },
      "expected": {
        "scopes": {
          "hub.inference": {
            "path": "🌎️hub/💡️inference/🧬️schema",
            "level": "hub-area-module",
            "exports": ["InferenceApproval", "Receipt"],
            "dependsOn": []
          },
          "s.probe.thing": {
            "path": "✏️s/🔌️plugins/🔷️probe/🗿️artifacts/🔶️thing/🏅️standards/🔖️1/🪆️subsets/✳️any/🧬️schema",
            "level": "artifact-standard-subset",
            "exports": ["ThingArtifact"],
            "dependsOn": ["hub.inference"]
          }
        },
        "diagnosticCodes": [],
        "placementPaths": []
      }
    },
