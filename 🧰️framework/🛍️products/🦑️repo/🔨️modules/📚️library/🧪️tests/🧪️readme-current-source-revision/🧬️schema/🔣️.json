{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "One Approved Current README Source Revision",
  "definitions": {
    "fixtureInputs": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🧪️tests/🧪️readme-reviewed-fixture-inputs/🧫️fixtures/🔣️.json" },
        "sha256": { "const": "ce363f1cdf5395eacc3cd5ff5c036230d2eeaf76a44a7137e43bf1f8409f8135" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "command",
        "route",
        "source",
        "launchName",
        "launchCommand",
        "launchGroup",
        "launchOrder"
      ],
      "properties": {
        "target": {
          "const": "test-readme-current-source-revision"
        },
        "command": {
          "const": "bun ./📜️script.ts test readme-current-source-revision"
        },
        "route": {
          "const": "readme-current-source-revision"
        },
        "source": {
          "const": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🧪️tests/🟦️readme-current-source-revision.ts"
        },
        "launchName": {
          "const": "🧹clean🧩️taxonomy🧪️readme-current-source-revision"
        },
        "launchCommand": {
          "const": "bun nx run @semio-tech/repo-lib:test-readme-current-source-revision --skip-nx-cache"
        },
        "launchGroup": {
          "const": "4_gate"
        },
        "launchOrder": {
          "const": 410.195
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "testing-readme-protocol-v2-reviewed"
  ],
  "properties": {
    "testing-readme-protocol-v2-reviewed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogCaseIndex",
        "sourcePath",
        "baselineCommit",
        "baselineBlob",
        "baselinePreimage",
        "currentPreimage",
        "expectationsPath",
        "expectationsSha256"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\:*?\"<>|\\u0000-\\u001f])(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!compose(?:/|$))(?!temp/compose(?:/|$)).+/README\\.md$"
        },
        "catalogCaseIndex": {
          "const": 31
        },
        "baselineCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baselineBlob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baselinePreimage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size",
            "mode"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mode": {
              "const": "0644"
            }
          }
        },
        "currentPreimage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size",
            "mode"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mode": {
              "const": "0644"
            }
          }
        },
        "expectationsPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!compose(?:/|$))(?!temp/compose(?:/|$)).+\\.json$"
        },
        "expectationsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
