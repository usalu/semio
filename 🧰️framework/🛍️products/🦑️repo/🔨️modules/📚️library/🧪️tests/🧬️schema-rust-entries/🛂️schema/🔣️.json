{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/library/schema-rust-entry-cases.json",
  "title": "SchemaRustEntryCases",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "cases"],
  "properties": {
    "contract": { "const": "schema-rust-entry-cases-v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Case" }
    }
  },
  "$defs": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "scopes", "dump", "complete", "expectedCodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "reason": { "type": "string", "minLength": 16 },
        "scopes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Scope" } },
        "dump": { "$ref": "#/$defs/Dump" },
        "complete": { "type": "boolean" },
        "expectedCodes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" } }
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "formats", "exports"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "formats": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "exports": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" } }
      }
    },
    "Dump": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "generator", "entries"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "export", "format"],
            "properties": {
              "scope": { "type": "string", "minLength": 1 },
              "export": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
              "format": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
