{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "factory",
    "rounds",
    "uniqueNormalizedPatterns",
    "normalization",
    "integration",
    "oracle",
    "cases",
    "invalidPatterns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "taxonomy-pattern-compiler-reuse-v1"
    },
    "factory": {
      "const": "createTaxonomyPathMatcher"
    },
    "rounds": {
      "const": 4
    },
    "uniqueNormalizedPatterns": {
      "const": 14
    },
    "normalization": {
      "const": {
        "paths": "windows-separators-leading-dot-nfc",
        "patterns": "nfc-only"
      }
    },
    "integration": {
      "const": {
        "loadedField": "pathMatcher",
        "normalizerOwners": {
          "validatedContractPattern": 1,
          "parseTaxonomy": 2,
          "resolveFileKind": 2,
          "explicitTicketRows": 1,
          "matchingFixedContracts": 1,
          "renderCatalogGlob": 1,
          "projectNestedCargoPackages": 1,
          "mutationPayloadSchemaOwner": 1,
          "generatorInputPaths": 1,
          "generatorPlanning": 1,
          "assertRegenerationContract": 1,
          "assertTicketImportantRemovalAuthority": 2
        },
        "loadOwners": ["inventoryTaxonomyWithSourceParentPruning", "planTaxonomy", "applyTaxonomyPlan"],
        "fixedContractCallCount": 6,
        "changedInput": { "pointer": "/fixedFilenameContracts/cargo-manifest/reason", "suffix": " - fresh invocation" },
        "freshProbe": { "path": "🧪️fresh-session/🔣️.json", "pattern": "🧪️fresh-session/*.json" }
      }
    },
    "oracle": {
      "const": {
        "library": "picomatch",
        "options": {
          "dot": true,
          "nocase": false,
          "nonegate": true,
          "noext": true,
          "nobrace": true,
          "strictSlashes": true,
          "flags": "u"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "pattern",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "path": {
            "type": "string"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "boolean"
          }
        }
      }
    },
    "invalidPatterns": {
      "const": [
        "[",
        "🧪️root/[a",
        "[z-a]",
        "🧪️root/[z-a]"
      ]
    }
  }
}
