{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exact Current Owner Move Source Authority",
  "definitions": {
    "strictCompilation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strict", "noEmit", "diagnostics"],
      "properties": {
        "strict": { "const": true },
        "noEmit": { "const": true },
        "diagnostics": { "type": "array", "maxItems": 0 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "target", "packageCommand", "command", "route", "source", "launchName", "launchCommand", "launchGroup", "launchOrder"],
      "properties": {
        "packageName": { "const": "@semio-tech/repo-lib" },
        "target": { "const": "test-readme-move-source-authority" },
        "packageCommand": { "const": "nx run @semio-tech/repo-lib:test-readme-move-source-authority" },
        "command": { "const": "bun ./📜️script.ts test readme-move-source-authority" },
        "route": { "const": "readme-move-source-authority" },
        "source": { "const": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🧪️tests/🟦️readme-move-source-authority.ts" },
        "launchName": { "const": "🧹clean🧩️taxonomy🧪️readme-move-source-authority" },
        "launchCommand": { "const": "bun nx run @semio-tech/repo-lib:test-readme-move-source-authority --skip-nx-cache" },
        "launchGroup": { "const": "4_gate" },
        "launchOrder": { "const": 410.197 }
      }
    },
    "filePreimage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeKind",
        "contentHash",
        "mode",
        "size"
      ],
      "properties": {
        "nodeKind": {
          "const": "file"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "revisionId",
        "revisionDigest",
        "inputs"
      ],
      "properties": {
        "kind": {
          "const": "exact-owner-current-source-revision-v1"
        },
        "revisionId": {
          "const": "testing-readme-protocol-v2-reviewed"
        },
        "revisionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "path",
              "preimage"
            ],
            "properties": {
              "role": {
                "enum": [
                  "schema",
                  "catalog",
                  "expectation"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f:*?\"<>|])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.* /)(?!compose(?:/|$))(?!temp/compose(?:/|$))[^/]+(?:/[^/]+)*$"
              },
              "preimage": {
                "$ref": "#/definitions/filePreimage"
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "schema"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "catalog"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "expectation"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "sourcePath",
    "destinationPath",
    "sourcePreimage",
    "rationaleRule",
    "ownerId",
    "referenceEdits"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f:*?\"<>|])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.* /)(?!compose(?:/|$))(?!temp/compose(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "destinationPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f:*?\"<>|])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.* /)(?!compose(?:/|$))(?!temp/compose(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "sourcePreimage": {
      "$ref": "#/definitions/filePreimage"
    },
    "rationaleRule": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f:*?\"<>|])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.* /)(?!compose(?:/|$))(?!temp/compose(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "collisionGroup": {
      "type": "string"
    },
    "referenceEdits": {
      "type": "array",
      "maxItems": 0
    },
    "sourceAuthority": {
      "$ref": "#/definitions/sourceAuthority"
    }
  }
}
