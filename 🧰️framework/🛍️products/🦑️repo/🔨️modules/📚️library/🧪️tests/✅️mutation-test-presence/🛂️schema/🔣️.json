{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "mutationRoot", "leaf", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mutationRoot": {"type": "string", "minLength": 1},
    "leaf": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "files", "links", "compilerAccepted", "runnableTests", "policyAccepted"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string"},
          "files": {"type": "object", "additionalProperties": {"type": "string"}},
          "links": {"type": "object", "additionalProperties": {"type": "string"}},
          "compilerAccepted": {"type": "boolean"},
          "runnableTests": {"type": "integer", "minimum": 0},
          "policyAccepted": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
