  "manifestCases": [
    {
      "name": "unknown target input",
      "document": {
        "targets": {
          "compile": {
            "inputs": [
              "{workspaceRoot}/unknown/Other.sln"
            ]
          }
        }
      },
      "expected": [
        "{workspaceRoot}/unknown/Other.sln"
      ]
    },
    {
      "name": "unknown executable",
      "document": {
        "scripts": {
          "build": "dotnet build Unknown.slnx"
        }
      },
      "expected": [
        "dotnet build Unknown.slnx"
      ]
    },
    {
      "name": "configuration executable",
      "document": {
        "targets": {
          "build": {
            "configurations": {
              "release": {
                "command": "code --folder-uri .vscode"
              }
            }
          }
        }
      },
      "expected": [
        "code --folder-uri .vscode"
      ]
    },
    {
      "name": "dependency file",
      "document": {
        "targets": {
          "run": {
            "dependsOn": [
              "unknown/Workspace.code-workspace"
            ]
          }
        }
      },
      "expected": [
        "unknown/Workspace.code-workspace"
      ]
    },
    {
      "name": "policy named inputs",
      "document": {
        "namedInputs": {
          "dotnet": [
            "{workspaceRoot}/Fresh.sln"
          ]
        }
      },
      "expected": [
        "{workspaceRoot}/Fresh.sln"
      ]
    },
    {
      "name": "dashboard external tool",
      "document": {
        "metadata": {
          "semio": {
            "dashboard": {
              "tools": [
                {
                  "command": [
                    "code",
                    "unknown/Workspace.code-workspace"
                  ]
                }
              ]
            }
          }
        }
      },
      "expected": [
        "unknown/Workspace.code-workspace"
      ]
    },
    {
      "name": "task command",
      "document": {
        "tasks": [
          {
            "command": "code unknown/launch.json"
          }
        ]
      },
      "expected": [
        "code unknown/launch.json"
      ]
    },
    {
      "name": "negative input glob",
      "document": {
        "targets": {
          "build": {
            "inputs": [
              "!{projectRoot}/.vscode/**"
            ]
          }
        }
      },
      "expected": []
    },
    {
      "name": "negative command remains executable",
      "document": {
        "scripts": {
          "bad": "!code .vscode"
        }
      },
      "expected": [
        "!code .vscode"
      ]
    },
    {
      "name": "passive extension manifest",
      "document": {
        "name": "vscode-extension",
        "description": "Historical Other.sln and .vscode",
        "contributes": {
          "configuration": {
            "title": ".vscode"
          }
        }
      },
      "expected": []
    },
    {
      "name": "passive fixture strings",
      "document": {
        "fixture": {
          "command": "code .vscode"
        },
        "description": "launch.json"
      },
      "expected": []
    },
    {
      "name": "external path reference still refused",
      "document": {
        "scripts": {
          "bad": "code node_modules/vendor/.vscode"
        }
      },
      "expected": [
        "code node_modules/vendor/.vscode"
      ]
    },
    {
      "name": "neutral inputs",
      "document": {
        "targets": {
          "build": {
            "inputs": [
              "{workspaceRoot}/Directory.Build.props",
              "{projectRoot}/**/*.csproj"
            ],
            "options": {
              "command": "bun ./📜️script.ts build"
            }
          }
        }
      },
      "expected": []
    },
    {
      "name": "root task options",
      "document": {
        "options": {
          "command": "dotnet build Unknown.sln"
        }
      },
      "expected": [
        "dotnet build Unknown.sln"
      ]
    },
    {
      "name": "target dashboard effect",
      "document": {
        "targets": {
          "run": {
            "metadata": {
              "semio": {
                "dashboard": {
                  "parameters": [
                    {
                      "args": [
                        "Unknown.sln"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "expected": [
        "Unknown.sln"
      ]
    },
    {
      "name": "package Nx target input",
