{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "roles", "validInventory", "unknownRole", "extraRosterField"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "roles": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["source", "assignment-ledger", "taxonomy-schema", "mutation-descriptor-schema"] }
    },
    "validInventory": { "$ref": "#/$defs/inventory" },
    "unknownRole": { "type": "string", "minLength": 1 },
    "extraRosterField": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rosterRecord": {
      "type": "object",
      "required": ["path", "sha256", "role"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "role": { "enum": ["source", "assignment-ledger", "taxonomy-schema", "mutation-descriptor-schema"] }
      }
    },
    "inventory": {
      "type": "object",
      "required": ["schemaVersion", "kind", "sourceTreeDigest", "roots", "sourceRoster", "records", "unresolved", "violations"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 2 },
        "kind": { "const": "mutation" },
        "sourceTreeDigest": { "$ref": "#/$defs/digest" },
        "roots": { "type": "array", "items": { "type": "string" } },
        "sourceRoster": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/rosterRecord" } },
        "records": { "type": "array" },
        "unresolved": { "type": "array" },
        "violations": { "type": "array" }
      }
    }
  }
}
