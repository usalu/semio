{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": { "type": "array", "minItems": 37, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "expected": {
      "type": "object",
      "required": ["sourcePath", "fileKindId", "fileRole", "extensionChain"],
      "additionalProperties": false,
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "fileKindId": { "type": ["string", "null"] },
        "fileRole": { "enum": ["source", "schema", "specification", "configuration", "documentation", "test", "asset", "generated", "marker", null] },
        "extensionChain": { "type": ["string", "null"] }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "catalog", "admissionStatus", "sourcePath", "observedKind", "mode", "repositoryBoundary", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "catalog": { "enum": ["current", "synthetic-generated", "synthetic-tie"] },
        "admissionStatus": { "enum": ["complete", "rejected"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "observedKind": { "enum": ["file", "directory", "symlink", "absent", "other"] },
        "mode": { "enum": ["040000", "100644", "100755", "120000", "160000", null] },
        "repositoryBoundary": { "enum": ["gitlink", null] },
        "expected": { "anyOf": [{ "$ref": "#/$defs/expected" }, { "type": "null" }] }
      }
    }
  }
}
