{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "directoryName", "filename", "fileMode", "writePolicy", "nodeCases", "invalidContracts", "progress", "singleCase", "unsignedPlan"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "draw-submitted-plan-proof-v1" },
    "directoryName": { "const": "📓️submitted-plans" },
    "filename": { "const": "🔣️.json" },
    "fileMode": { "const": 384 },
    "writePolicy": { "const": "exclusive-synced-and-byte-identical-reuse" },
    "nodeCases": {
      "const": [
        { "kind": "absent", "outcome": "create" },
        { "kind": "identical-file", "outcome": "reuse" },
        { "kind": "changed-file", "outcome": "reject-preserve" },
        { "kind": "changed-mode", "outcome": "reject-preserve", "platform": "posix" },
        { "kind": "file-symlink", "outcome": "reject-preserve" },
        { "kind": "ancestor-symlink", "outcome": "reject-preserve" }
      ]
    },
    "invalidContracts": {
      "const": [
        { "field": "directoryName", "value": "📓️unowned" },
        { "field": "filename", "value": "../📝️.md" },
        { "field": "fileMode", "value": 420 }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalParentSegments", "intervalMs", "cases"],
      "properties": {
        "externalParentSegments": { "const": ["📓️draw-source-scenarios", "📓️progress"] },
        "intervalMs": { "const": 1000 },
        "cases": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "operation", "phase", "current", "total", "retain"],
            "properties": {
              "at": { "type": "integer", "minimum": 0 },
              "operation": { "enum": ["plan", "apply"] },
              "phase": { "enum": ["incoming-reference", "generator-preview"] },
              "current": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 1 },
              "retain": { "type": "boolean" }
            }
          }
        }
      }
    },
    "singleCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "target", "budgetMs", "bunTimeoutMs", "testName", "runner", "extraArguments", "launchName", "launchOrder"],
      "properties": {
        "command": { "const": "artifact-source-residue" },
        "target": { "const": "test-artifact-source-residue" },
        "budgetMs": { "const": 120000 },
        "bunTimeoutMs": { "const": 120000 },
        "testName": { "const": "rejects ignored and unplanned residual children in a projected source owner without following links" },
        "runner": { "const": "runTestBudgeted" },
        "extraArguments": { "const": false },
        "launchName": { "const": "🧹clean🧩️taxonomy🧪️artifact-source-residue" },
        "launchOrder": { "const": 410.194 }
      }
    },
    "unsignedPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taxonomySchemaVersion", "baselineCommit", "scope", "sourceTreeDigest", "excludedTreeDigests", "moves", "embeddedTicketRoots", "embeddedTicketRootRelocations", "symlinkTargetEdits", "evidenceRemovals", "destinationAncestorPreimages", "edits", "regenerations", "unresolved", "expectedAffectedPreStateDigest", "expectedPostStateDigest"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "taxonomySchemaVersion": { "const": 7 },
        "baselineCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "scope": { "const": "🧪️tests/🧪️fixture" },
        "sourceTreeDigest": { "$ref": "#/definitions/hash" },
        "excludedTreeDigests": { "$ref": "#/definitions/empty" },
        "moves": { "$ref": "#/definitions/empty" },
        "embeddedTicketRoots": { "$ref": "#/definitions/empty" },
        "embeddedTicketRootRelocations": { "$ref": "#/definitions/empty" },
        "symlinkTargetEdits": { "$ref": "#/definitions/empty" },
        "evidenceRemovals": { "$ref": "#/definitions/empty" },
        "destinationAncestorPreimages": { "$ref": "#/definitions/empty" },
        "edits": { "$ref": "#/definitions/empty" },
        "regenerations": { "$ref": "#/definitions/empty" },
        "unresolved": { "$ref": "#/definitions/empty" },
        "expectedAffectedPreStateDigest": { "$ref": "#/definitions/hash" },
        "expectedPostStateDigest": { "$ref": "#/definitions/hash" }
      }
    }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "empty": { "type": "array", "maxItems": 0 }
  }
}
