{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/library/root-test-birth/schema.json",
  "$defs": {
    "Protocol": {
      "const": {
        "prefix": [
          "test",
          "cache"
        ],
        "operands": 3,
        "schemaPrefix": [
          "schema"
        ],
        "schemaCommands": [
          "verify",
          "entries",
          "compile"
        ],
        "schemaMinimumOperands": 2,
        "helpFlags": [
          "-h",
          "--help"
        ]
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv",
        "received",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "received": {
          "type": "boolean"
        },
        "expected": {
          "enum": [
            "build",
            "workspace",
            "received"
          ]
        }
      }
    }
  }
}
