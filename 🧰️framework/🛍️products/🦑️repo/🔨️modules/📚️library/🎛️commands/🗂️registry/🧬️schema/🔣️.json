{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Root Command Registry V1",
  "description": "Every command of the root script `repo ./📜️script.ts <command>`: the module and export that implement it, what its process needs before it can start (`none`: it runs on a fresh clone with only Bun; `dependencies`: it needs the locked dependencies, which the router installs through `repo dependencies ensure` with progress before the module is loaded), and its help in every declared language. The `module` closure of a `none` row is held free of bare imports by the zero-touch law; every closure is held free of workspace package specifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "languages", "labels", "commands"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/Language" } },
    "labels": { "$ref": "#/definitions/Labels" },
    "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Command" } }
  },
  "definitions": {
    "Language": { "enum": ["en", "de"] },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
    },
    "Requires": { "enum": ["none", "dependencies"] },
    "Labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagline", "usage", "commands", "requires", "requiresNone", "requiresDependencies", "legend", "provisioning", "provisioned", "provisionFailed", "unknownCommand"],
      "properties": {
        "tagline": { "$ref": "#/definitions/LocalizedText" },
        "usage": { "$ref": "#/definitions/LocalizedText" },
        "commands": { "$ref": "#/definitions/LocalizedText" },
        "requires": { "$ref": "#/definitions/LocalizedText" },
        "requiresNone": { "$ref": "#/definitions/LocalizedText" },
        "requiresDependencies": { "$ref": "#/definitions/LocalizedText" },
        "legend": { "$ref": "#/definitions/LocalizedText" },
        "provisioning": { "$ref": "#/definitions/LocalizedText" },
        "provisioned": { "$ref": "#/definitions/LocalizedText" },
        "provisionFailed": { "$ref": "#/definitions/LocalizedText" },
        "unknownCommand": { "$ref": "#/definitions/LocalizedText" }
      }
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "export", "requires", "reason", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 32 },
        "module": { "type": "string", "pattern": "^[^/\\\\.][^\\\\]*\\.ts$", "maxLength": 200 },
        "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "requires": { "$ref": "#/definitions/Requires" },
        "reason": { "$ref": "#/definitions/LocalizedText" },
        "synopsis": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/definitions/LocalizedText" }
      }
    }
  }
}
