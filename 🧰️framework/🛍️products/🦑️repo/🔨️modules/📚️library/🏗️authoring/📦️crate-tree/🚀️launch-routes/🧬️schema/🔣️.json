{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schemas/repo/crate-launch-routes",
  "description": "The editor routes of one Cargo crate: build, check and test in each configuration. A route runs the crate as a build project of the same name and always carries the cache environment of the build-environment schema; the schema of that environment is the only place that names its variables.",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "type": "node-terminal",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "namePrefix": "🦀️",
        "command": "bun repo run {project}:{target} --configuration={configuration} --parallel=1 -- {arguments}",
        "configurations": [
          {
            "id": "prototype",
            "icon": "🛠️"
          },
          {
            "id": "release",
            "icon": "🚀️"
          }
        ],
        "targets": [
          {
            "id": "build",
            "icon": "🏗️",
            "group": "4_build",
            "orderBase": 900
          },
          {
            "id": "check",
            "icon": "🔎️",
            "group": "4_gate",
            "orderBase": 922
          },
          {
            "id": "test",
            "icon": "🧪️",
            "group": "4_test",
            "orderBase": 903
          }
        ],
        "shapes": {
          "lib": {
            "build": [
              "--lib",
              "--offline"
            ],
            "check": [
              "--lib",
              "--offline"
            ],
            "test": [
              "--lib",
              "--offline"
            ]
          },
          "tests": {
            "build": [
              "--tests",
              "--offline"
            ],
            "check": [
              "--tests",
              "--offline"
            ],
            "test": [
              "--offline"
            ]
          },
          "package": {
            "build": [
              "--lib",
              "--offline"
            ],
            "check": [
              "--lib",
              "--offline"
            ],
            "test": [
              "--offline"
            ]
          }
        }
      }
    },
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "shape"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "shape": {
          "enum": [
            "lib",
            "tests",
            "package"
          ]
        },
        "project": {
          "type": "string",
          "pattern": "^(?:@[a-z0-9-]+/)?[a-z0-9][a-z0-9._-]*$"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "build",
              "check",
              "test"
            ]
          }
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "build": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "check": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "test": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "description": "One crate; `project` names the build project that runs it and is the crate name when absent; `targets` limits the routes to some targets and `arguments` replaces the cargo arguments of a target that its shape does not fit."
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "request",
        "command",
        "cwd",
        "env",
        "presentation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "node-terminal"
        },
        "request": {
          "const": "launch"
        },
        "command": {
          "type": "string",
          "pattern": "^bun repo run [a-z@][^ ]*:(build|check|test) --configuration=(prototype|release) --parallel=1 -- "
        },
        "cwd": {
          "const": "${workspaceFolder}"
        },
        "env": {
          "type": "object"
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group",
            "order"
          ],
          "properties": {
            "group": {
              "enum": [
                "4_build",
                "4_gate",
                "4_test"
              ]
            },
            "order": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
