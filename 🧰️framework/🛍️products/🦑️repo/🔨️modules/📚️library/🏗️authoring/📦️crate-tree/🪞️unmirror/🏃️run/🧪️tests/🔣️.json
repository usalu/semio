    "semio_s_artifact_stdio"
   ]
  },
  {
   "name": "no crates",
   "crates": [],
   "expected": []
  }
 ],
 "graphs": [
  {
   "name": "a DAG",
   "edges": {
    "a": [
     "b",
     "c"
    ],
    "b": [
     "d"
    ],
    "c": [
     "d"
    ],
    "d": []
   },
   "expected": []
  },
  {
   "name": "a self loop",
   "edges": {
    "a": [
     "a"
    ]
   },
   "expected": [
    "a -> a"
   ]
  },
  {
   "name": "two nodes",
   "edges": {
    "a": [
     "b"
    ],
    "b": [
     "a"
    ]
   },
   "expected": [
    "a -> b -> a"
   ]
  },
  {
   "name": "a triangle",
   "edges": {
    "a": [
     "b"
    ],
    "b": [
     "c"
    ],
    "c": [
     "a"
    ]
   },
   "expected": [
    "a -> b -> c -> a"
   ]
  },
  {
   "name": "a cycle entered from a tail reports only the cycle",
   "edges": {
    "t": [
     "a"
    ],
    "a": [
     "b"
    ],
    "b": [
     "a"
    ]
   },
   "expected": [
    "a -> b -> a"
   ]
  },
  {
   "name": "two disjoint cycles",
   "edges": {
    "a": [
     "b"
    ],
    "b": [
     "a"
    ],
    "c": [
     "d"
    ],
    "d": [
     "c"
    ]
   },
   "expected": [
    "a -> b -> a",
    "c -> d -> c"
   ]
  },
  {
   "name": "edges to unknown nodes are ignored",
   "edges": {
    "a": [
     "x",
     "y"
    ]
   },
   "expected": []
  },
  {
   "name": "a diamond with a back edge reports the first cycle found",
   "edges": {
    "a": [
     "b",
     "c"
    ],
    "b": [
     "d"
    ],
    "c": [
     "d"
    ],
    "d": [
     "a"
    ]
   },
   "expected": [
    "a -> b -> d -> a"
   ]
  },
  {
   "name": "an empty graph",
   "edges": {},
   "expected": []
  },
  {
   "name": "a long chain closing on itself",
   "edges": {
    "n0": [
     "n1"
    ],
    "n1": [
     "n2"
    ],
    "n2": [
     "n3"
    ],
    "n3": [
     "n4"
    ],
    "n4": [
     "n0"
    ]
   },
   "expected": [
    "n0 -> n1 -> n2 -> n3 -> n4 -> n0"
   ]
  },
  {
   "name": "a cycle behind a shared node",
   "edges": {
    "r": [
     "x",
     "y"
    ],
    "x": [
     "z"
    ],
    "y": [
     "z"
    ],
    "z": [
     "w"
    ],
    "w": [
     "z"
    ]
   },
   "expected": [
    "z -> w -> z"
   ]
  },
  {
   "name": "a cycle through a non-first start",
   "edges": {
    "p": [
     "q"
    ],
    "q": [
     "r"
    ],
    "r": [
     "q"
    ],
    "s": [
     "p"
    ]
   },
   "expected": [
    "q -> r -> q"
   ]
  }
 ]
}
