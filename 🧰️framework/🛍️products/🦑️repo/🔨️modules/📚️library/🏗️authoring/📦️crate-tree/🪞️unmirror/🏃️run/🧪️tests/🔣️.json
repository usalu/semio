  },
  {
   "name": "an artifact crate without carved crates is not",
   "crates": [
    {
     "name": "semio-s-artifact-foo",
     "ident": "semio_s_artifact_foo",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/foo/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/foo/📦️packages/🦀️rust/lib.rs"
    }
   ],
   "expected": []
  },
  {
   "name": "a name prefix without the dash is not a carved crate",
   "crates": [
    {
     "name": "semio-s-artifact-bar",
     "ident": "semio_s_artifact_bar",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/bar/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/bar/📦️packages/🦀️rust/lib.rs"
    },
    {
     "name": "semio-s-artifact-barrel",
     "ident": "semio_s_artifact_barrel",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/bar/x/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/bar/x/📦️packages/🦀️rust/lib.rs"
    }
   ],
   "expected": []
  },
  {
   "name": "a carved crate in another directory does not count",
   "crates": [
    {
     "name": "semio-s-artifact-bar",
     "ident": "semio_s_artifact_bar",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/bar/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/bar/📦️packages/🦀️rust/lib.rs"
    },
    {
     "name": "semio-s-artifact-bar-x",
     "ident": "semio_s_artifact_bar_x",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/other/x/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/other/x/📦️packages/🦀️rust/lib.rs"
    }
   ],
   "expected": []
  },
  {
   "name": "crates outside the plugin tree are never facades",
   "crates": [
    {
     "name": "semio-framework",
     "ident": "semio_framework",
     "dir": "🧰️framework/x",
     "root": "🧰️framework/x/lib.rs"
    },
    {
     "name": "semio-framework-core",
     "ident": "semio_framework_core",
     "dir": "🧰️framework/x/core",
     "root": "🧰️framework/x/core/lib.rs"
    }
   ],
   "expected": []
  },
  {
   "name": "several facades",
   "crates": [
    {
     "name": "semio-s-artifact-foo",
     "ident": "semio_s_artifact_foo",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/foo/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/foo/📦️packages/🦀️rust/lib.rs"
    },
    {
     "name": "semio-s-artifact-foo-mut-alpha",
     "ident": "semio_s_artifact_foo_mut_alpha",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/foo/schema/alpha/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/foo/schema/alpha/📦️packages/🦀️rust/lib.rs"
    },
    {
     "name": "semio-s-artifact-stdio",
     "ident": "semio_s_artifact_stdio",
     "dir": "✏️s/🔌️plugins/p/📇️registry/stdio/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/📇️registry/stdio/📦️packages/🦀️rust/lib.rs"
    },
    {
     "name": "semio-s-artifact-stdio-core",
     "ident": "semio_s_artifact_stdio_core",
     "dir": "✏️s/🔌️plugins/p/📇️registry/stdio/core/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/📇️registry/stdio/core/📦️packages/🦀️rust/lib.rs"
    },
    {
     "name": "semio-s-artifact-bar",
     "ident": "semio_s_artifact_bar",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/bar/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/bar/📦️packages/🦀️rust/lib.rs"
    },
    {
     "name": "semio-s-artifact-barrel",
     "ident": "semio_s_artifact_barrel",
     "dir": "✏️s/🔌️plugins/p/🗿️artifacts/bar/x/📦️packages/🦀️rust",
     "root": "✏️s/🔌️plugins/p/🗿️artifacts/bar/x/📦️packages/🦀️rust/lib.rs"
    },
    {
     "name": "semio-framework",
     "ident": "semio_framework",
