     "root": "✏️s/🔌️plugins/p/🗿️artifacts/foo/schema/alpha/📦️packages/🦀️rust/lib.rs"
    }
   ],
   "expected": [
    "semio_s_artifact_foo"
   ]
  },
  {
   "name": "a registry crate with a carved crate below it is a facade",
