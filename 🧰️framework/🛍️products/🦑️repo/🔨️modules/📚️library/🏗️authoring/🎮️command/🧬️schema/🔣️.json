{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.repo.authoring-command/v1",
  "$ref": "#/$defs/request",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "owner",
        "newDirectory"
      ],
      "properties": {
        "kind": {
          "enum": [
            "artifact",
            "standard",
            "subset"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*[\\\\\\u0000-\\u001f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))[^/]+(?:/[^/]+)*$"
        },
        "newDirectory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}$)(?!.*[/:\\\\\\u0000-\\u001f])[^/]+$"
        }
      }
    }
  }
}
