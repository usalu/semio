{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.repo.scaffold-owner/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "vectors"
  ],
  "properties": {
    "schema": {
      "const": "semio.framework.repo.scaffold-owner/v1"
    },
    "vectors": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "owner",
          "newDirectory",
          "valid"
        ],
        "properties": {
          "kind": {
            "enum": [
              "artifact",
              "standard",
              "subset"
            ]
          },
          "owner": {
            "type": "string"
          },
          "newDirectory": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "destination": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "owner",
        "newDirectory"
      ],
      "properties": {
        "kind": {
          "enum": [
            "artifact",
            "standard",
            "subset"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*[\\\\\\u0000-\\u001f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))[^/]+(?:/[^/]+)*$"
        },
        "newDirectory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}$)(?!.*[/:\\\\\\u0000-\\u001f])[^/]+$"
        }
      }
    }
  }
}
