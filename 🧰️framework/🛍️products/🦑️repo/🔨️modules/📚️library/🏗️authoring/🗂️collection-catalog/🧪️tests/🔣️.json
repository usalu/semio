   "#[canonical_json(owner = Snapshot)]",
   "#[value(tag = \"kind\", content = \"row\", rename_all = \"camelCase\")]",
   "pub enum ShapeKey {\n    Nodes,\n    Edges,\n}",
   "pub enum ShapeRow {\n    Nodes(NodeRow),\n    Edges(EdgeRow),\n}",
   "pub struct ShapeLabel {",
   "pub const ALL: [ShapeKey; 2] = [ShapeKey::Nodes, ShapeKey::Edges];",
   "#[path = \"🪪️key-descriptors/🦀️.rs\"]\nmod key_descriptors;",
   "#[path = \"🔎️key-base-access/🦀️.rs\"]\nmod key_base_access;",
   "#[path = \"🧾️row-operations/🦀️.rs\"]\nmod row_operations;",
