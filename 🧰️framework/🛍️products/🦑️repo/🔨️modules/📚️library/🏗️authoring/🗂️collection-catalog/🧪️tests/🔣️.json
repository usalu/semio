  ],
  "🪪️key-descriptors": [
   "            Self::Nodes => \"node\",",
   "            Self::Edges => \"edge\",",
   "Self::Nodes => ShapeLabel { article: \"a\", en: \"node\", de: \"Knoten\" },",
   "Self::Edges => ShapeLabel { article: \"an\", en: \"edge\", de: \"Kante\" },",
   "            Self::Nodes => \"nodeDeltas\",",
   "            \"edgeDeltas\" => Some(Self::Edges),",
   "            _ => None,"
  ],
  "🔎️key-base-access": [
   "pub fn position(self, base: &Snapshot, id: &Id) -> Option<usize> {",
   "Self::Nodes => base.nodes.iter().position(|row| row.header.id == *id),",
   "Self::Edges => base.edges.len(),",
   "Self::Nodes => base.nodes.get(index).cloned().map(ShapeRow::Nodes),",
   "Self::Edges => SnapshotDiff { edgeDeltas: Some(EdgeDelta::removal(&base.edges, index)), ..Default::default() },",
   "Self::Nodes => SnapshotDiff { nodeDeltas: Some(NodeDelta::modification(id.0.clone(), NodePatch { name: Some(name), ..Default::default() })), ..Default::default() },"
  ],
  "🧾️row-operations": [
   "Self::Nodes(_) => ShapeKey::Nodes,",
   "Self::Edges(row) => &row.header,",
   "Self::Edges(row) => SnapshotDiff { edgeDeltas: Some(EdgeDelta::insertion(index, row.clone())), ..Default::default() },",
   "let mut delta = NodeDelta::removal(&base.nodes, index);",
   "delta.absorb(NodeDelta::insertion(index, row.clone()));",
   "Self::Nodes(row) => base.nodes.get(index) == Some(row),"
  ],
  "🔁️row-conversions": [
   "impl From<NodeRow> for ShapeRow {",
   "        Self::Nodes(row)",
