 "renderTs": "/** 🤖️ Generated by the collection-catalog generator (`📚️library/🏗️authoring/🗂️collection-catalog`) from the `x-semio-collection-catalog` extension of its snapshot schema. Edit the schema and regenerate. */\nimport type { EdgeRow } from \"../rows/edge.ts\";\nimport type { NodeRow } from \"../rows/node.ts\";\n\n/** 🗂️ Key of one id-keyed collection. */\nexport type ShapeKey = \"nodes\" | \"edges\";\n\n/** 🗂️ One typed row of one collection, adjacently tagged by its key. */\nexport type ShapeRow =\n  | { kind: \"nodes\"; row: NodeRow }\n  | { kind: \"edges\"; row: EdgeRow };\n\n/** 🗂️ One collection: its key, entity, snapshot and diff fields, and row labels. */\nexport interface ShapeKeyEntry { readonly key: ShapeKey; readonly entity: string; readonly rowsField: string; readonly diffField: string; readonly label: { readonly article: \"a\" | \"an\"; readonly en: string; readonly de: string } }\n\n/** 🗂️ Every collection, in declaration order. */\nexport const SHAPES: readonly ShapeKeyEntry[] = [\n  { key: \"nodes\", entity: \"node\", rowsField: \"nodes\", diffField: \"nodeDeltas\", label: {article: \"a\",en: \"node\",de: \"Knoten\"} },\n  { key: \"edges\", entity: \"edge\", rowsField: \"edges\", diffField: \"edgeDeltas\", label: {article: \"an\",en: \"edge\",de: \"Kante\"} },\n];\n",
