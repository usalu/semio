{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/repo/abstraction-ownership/schema.json",
  "title": "AbstractionOwnership",
  "description": "Scope authority for OS preferences and host controls consumed by artifact surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "fields", "commands"],
  "properties": {
    "owner": { "enum": ["os", "surface", "artifact"] },
    "fields": { "type": "array", "items": { "type": "string" } },
    "commands": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [{
    "if": { "properties": { "owner": { "const": "surface" } }, "required": ["owner"] },
    "then": { "properties": {
      "fields": { "type": "array", "items": { "not": { "$ref": "#/$defs/OsField" } } },
      "commands": { "type": "array", "items": { "not": { "$ref": "#/$defs/OsCommand" } } }
    } }
  }],
  "$defs": {
    "OsField": { "enum": ["locale", "uiLocale", "terminology", "uiTerminology", "uiAppearance", "uiLayout", "uiDriverId", "uiCustomDrivers", "uiDriverDraft", "uiThemeId", "uiCustomThemes", "uiThemeDraft", "uiKeybindingOverrides", "activeUtility", "activeUtilityId"] },
    "OsCommand": { "enum": ["set-locale", "set-ui-locale", "set-terminology", "set-appearance", "set-theme-id", "set-layout", "set-driver", "set-keybinding-override", "set-active-utility"] }
  }
}
