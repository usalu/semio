{
  "contract": "canonical-go-input-projection-v2",
  "layout": {
    "testsDirectory": "🧪️tests",
    "implementationFilename": "🐹️.go",
    "opaqueDirectoryNames": ["🧫️fixtures"],
    "sourceDirectoryNames": ["🧮️addition", "🔠️uppercase", "🎯️offset"]
  },
  "module": "example.com/semio/canonical-go-tests",
  "dependency": {
    "directory": "dependency",
    "module": "example.com/semio/canonical-go-offset",
    "domain": "🎯️offset",
    "package": "offset",
    "production": "func Zero() int { return 0 }"
  },
  "nativePackages": [
    {
      "owner": "internal/direct",
      "package": "direct",
      "production": "func Value() int { return 1 }"
    }
  ],
  "cases": [
    {
      "owner": ".",
      "domain": "🧮️addition",
      "case": "🧮️private-addition",
      "package": "proof",
      "production": "func add(left, right int) int { return left + right + offset.Zero() }",
      "productionImports": ["example.com/semio/canonical-go-offset"],
      "test": "func TestPrivateAddition(t *testing.T) { if add(2, 3) != 5 { t.Fatal(\"addition\") } }"
    },
    {
      "owner": "internal/text",
      "domain": "🔠️uppercase",
      "case": "🔠️private-uppercase",
      "package": "text",
      "production": "func upper(value string) string { return strings.ToUpper(value) }",
      "productionImports": ["strings"],
      "test": "func TestPrivateUppercase(t *testing.T) { if upper(\"go\") != \"GO\" { t.Fatal(\"uppercase\") } }"
    }
  ],
  "opaqueCases": [
    {
      "owner": "🧫️fixtures/opaque-go-repository",
      "domain": "🧮️addition",
      "case": "🧪️must-not-run",
      "package": "fixture",
      "production": "func fixtureValue() int { return 1 }",
      "test": "func TestFixtureMustStayOpaque(t *testing.T) { t.Fatal(\"fixture repository executed\") }"
    }
  ],
  "expectedPackages": [
    ".",
    "./internal/direct",
    "./internal/text"
  ],
  "expectedSources": [
    "dependency/🎯️offset/🐹️.go",
    "🧮️addition/🐹️.go",
    "internal/text/🔠️uppercase/🐹️.go"
  ],
  "expectedTests": [
    "TestPrivateAddition",
    "TestPrivateUppercase"
  ]
}
