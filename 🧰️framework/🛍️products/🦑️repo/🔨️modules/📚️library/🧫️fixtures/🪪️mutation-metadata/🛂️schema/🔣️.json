{
  "type": "object",
  "required": ["schemaVersion", "source", "expected"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string" },
    "expected": {
      "type": "object",
      "required": ["declarations", "aliases", "manualMutationLeafImpls"],
      "additionalProperties": false,
      "properties": {
        "declarations": {
          "type": "array", "minItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "kind", "visibility", "modulePath", "derives", "state", "contracts", "detail"],
            "properties": {
              "name": { "type": "string" }, "kind": { "enum": ["struct", "enum", "union"] }, "visibility": { "type": "string" }, "modulePath": { "type": "array", "items": { "type": "string" } }, "derives": { "type": "array", "items": { "type": "string" } }, "state": { "enum": ["absent", "valid", "malformed", "ambiguous", "conditional"] }, "contracts": { "type": "array", "items": { "type": "string" } }, "detail": { "type": ["string", "null"] }
            }
          }
        },
        "aliases": { "type": "array", "minItems": 15, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "source", "alias", "modulePath", "conditional"], "properties": { "kind": { "enum": ["extern", "self", "use", "reexport"] }, "source": { "type": "string" }, "alias": { "type": "string" }, "modulePath": { "type": "array", "items": { "type": "string" } }, "conditional": { "type": "boolean" } } } },
        "manualMutationLeafImpls": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["traitPath", "selfType", "methods", "associatedConstants"], "properties": { "traitPath": { "type": "string" }, "selfType": { "type": "string" }, "methods": { "type": "array", "items": { "type": "string" } }, "associatedConstants": { "type": "array", "items": { "type": "string" } } } } }
      }
    }
  }
}
