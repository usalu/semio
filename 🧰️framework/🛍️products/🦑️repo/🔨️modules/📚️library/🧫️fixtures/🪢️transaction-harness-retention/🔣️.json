{
  "schemaVersion": 2,
  "launcherPath": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔄️transactions/🧪️verification/🏃️shard-execution/🟦️.ts",
  "allocationPath": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔄️transactions/🧪️verification/📁️run-allocation/🟦️.ts",
  "filterWavesConstant": "TRANSACTION_V2_DEFAULT_FILTER_WAVES",
  "testPath": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🧪️tests/🔄️transaction-v2/🟦️.ts",
  "absoluteBundleExpression": "bundle",
  "runIdExpression": "runId",
  "runIdEntropyCall": "crypto.randomUUID()",
  "bundleRootFunction": "transactionV2BundleRoot",
  "runOwnerConstant": "TRANSACTION_V2_RUN_OWNER_DIRECTORY",
  "runRootPrefix": "🔖️",
  "bundleDirectory": "📦️bundle",
  "runRootEnvironment": "SEMIO_TRANSACTION_V2_RUN_ROOT",
  "runRootValidator": "assertFixtureRunRoot",
  "runIdPattern": "^[1-9][0-9]*-([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
  "invalidRunIds": [
    "",
    "0-00000000-0000-4000-8000-000000000000",
    "1-../escape",
    "1-00000000-0000-1000-8000-000000000000",
    "1-00000000-0000-4000-C000-000000000000"
  ],
  "rejections": [
    "invalid-id",
    "relative-root",
    "cross-run-root",
    "root-symlink",
    "ancestor-symlink",
    "root-file",
    "occupied-run",
    "fixture-cross-run",
    "fixture-symlink"
  ],
  "shards": [
    {
      "filter": "process-tree-killed|language-neutral|incomplete plans|rolls back after-regenerations|rejects stale generator",
      "tests": 5,
      "boundaries": 4
    },
    {
      "filter": "rolls back after-(?:staging|embedded-root-staging|moves|relocations|symlink-retargeting|edits)|rolls back before-verify",
      "tests": 7,
      "boundaries": 7
    },
    {
      "filter": "rejects forged|rejects unreachable|keeps double-plan|recovers caught",
      "tests": 4,
      "boundaries": 3
    },
    {
      "filter": "committed and rolled-back|elects exactly|restores a quarantined|rejects stale (?!generator)|rejects ordinal",
      "tests": 6,
      "boundaries": 4
    },
    {
      "filter": "parent-killed (?:transaction-attempt-preparation-mkdir|transaction-attempt-preparation-children|transaction-initial-lease-json-write-mkdir|transaction-initial-lease-json-candidate-written|transaction-initial-lease-json-canonical-exchanged|transaction-initial-lease-prepared|transaction-initial-wal-mkdir|transaction-initial-journal-write-mkdir|transaction-initial-journal-candidate-written|transaction-initial-journal-canonical-exchanged)$",
      "tests": 10,
      "boundaries": 20
    },
    {
      "filter": "parent-killed (?:transaction-initial-journal-canonical|transaction-attempt-canonical-published|transaction-journal-write-mkdir|transaction-journal-candidate-written|transaction-journal-previous-exchanged|transaction-journal-canonical-exchanged|transaction-wal-prepared|transaction-backup-write-mkdir|transaction-backup-write-mid|transaction-backup-write-prepared)$",
      "tests": 10,
      "boundaries": 20
    },
    {
      "filter": "parent-killed (?:transaction-backup-inner-exchange|transaction-backup-exchange|transaction-backup-retained|transaction-edit-write-mkdir|transaction-edit-write-mid|transaction-edit-write-prepared|transaction-edit-inner-exchange|transaction-edit-exchange|transaction-edit-canonical-exchange|transaction-restore-mkdir)$",
      "tests": 10,
      "boundaries": 20
    },
    {
      "filter": "parent-killed (?:transaction-restore-prepared|transaction-restore-exchange|transaction-restore-canonical-exchange|transaction-lease-stale-quarantined|transaction-lease-preparation-mkdir|transaction-lease-json-write-mkdir|transaction-lease-json-candidate-written|transaction-lease-json-canonical-exchanged|transaction-lease-prepared|transaction-lease-canonical-published)$",
      "tests": 10,
      "boundaries": 20
    }
  ],
  "retentionFunction": "retainFixture",
  "fixturePrefix": "🧪️",
  "cases": [
    {
      "name": "🧪️retained",
      "parent": "run",
      "accepted": true
    },
    {
      "name": "unowned",
      "parent": "run",
      "accepted": false
    },
    {
      "name": "🧪️outside",
      "parent": "ticket",
      "accepted": false
    },
    {
      "name": "🧪️nested",
      "parent": "nested",
      "accepted": false
    }
  ],
  "runOwnerDirectory": "🧾️runs"
}
