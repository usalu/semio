{
  "schemaVersion": 1,
  "policy": {
    "areaLayers": {
      "framework": "framework",
      "implementation": "implementation",
      "hub": "implementation"
    },
    "roles": [
      "framework",
      "product",
      "hub",
      "s-module",
      "plugin",
      "extension",
      "tool",
      "library",
      "artifact",
      "test"
    ],
    "rules": {
      "cargo-framework-no-implementation-role": {
        "fromRoles": [
          "framework"
        ],
        "toRoles": [
          "s-module",
          "plugin",
          "extension",
          "hub"
        ]
      },
      "cargo-modules-no-plugins": {
        "fromRoles": [
          "s-module"
        ],
        "toRoles": [
          "plugin",
          "extension"
        ],
        "fromOwnerPaths": [
          "^implementation/module$"
        ],
        "toOwnerSegments": [
          "🔌️plugins",
          "🧩️extensions"
        ]
      },
      "cargo-plugins-no-extensions": {
        "fromRoles": [
          "plugin"
        ],
        "toRoles": [
          "extension"
        ],
        "fromOwnerPaths": [
          "^implementation/plugin(?:$|/(?!🗿️artifacts/|🧩️extensions/))"
        ],
        "toOwnerSegments": [
          "🧩️extensions"
        ]
      },
      "cargo-plugins-no-artifacts": {
        "fromRoles": [
          "plugin"
        ],
        "toRoles": [
          "artifact"
        ],
        "toOwnerSegments": [
          "🗿️artifacts"
        ],
        "fromOwnerPaths": [
          "^implementation/plugin(?:$|/(?!🗿️artifacts/|🧩️extensions/))"
        ]
      }
    },
    "ownerRoles": [
      {
        "path": "(?:^|/)🗿️artifacts/",
        "roles": [
          "artifact"
        ]
      },
      {
        "path": "^implementation/(?:plugin/)?artifact$",
        "roles": [
          "artifact"
        ]
      },
      {
        "path": "^implementation/plugin$",
        "roles": [
          "plugin"
        ]
      },
      {
        "path": "^implementation/extension$",
        "roles": [
          "extension"
        ]
      },
      {
        "path": "^implementation/module$",
        "roles": [
          "s-module"
        ]
      },
      {
        "path": "^implementation/artifact$",
        "roles": [
          "artifact"
        ]
      },
      {
        "path": "^implementation/(?:.+/)?🧩️extensions/[^/]+$",
        "roles": [
          "extension"
        ]
      },
      {
        "path": "^implementation/",
        "roles": [
          "library",
          "test",
          "s-module"
        ]
      },
      {
        "path": "^framework/",
        "roles": [
          "framework",
          "product",
          "library",
          "tool",
          "test",
          "artifact"
        ]
      },
      {
        "path": "^hub/",
        "roles": [
          "hub"
        ]
      }
    ]
  },
