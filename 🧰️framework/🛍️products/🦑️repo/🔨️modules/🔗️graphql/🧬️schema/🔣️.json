{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/graphql/schema.json",
  "title": "🔗️ Repo GraphQL AST projection",
  "description": "The canonical, language-neutral projection of one parsed document. Every implementation of 🔗️graphql (Go, Rust) and the third-party oracle emit exactly this shape, so the harness compares ASTs rather than internal representations. The projection is deliberately LOSSY in the same places the grammar is: variable definitions, directives and directive arguments are parsed and dropped, an alias-free field projects a null alias, and the `null` literal and the empty list are indistinguishable because the reference implementation represents both as its zero value.",
  "$defs": {
    "Value": {
      "title": "One argument value",
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "variable"
            },
            "name": {
              "type": "string",
              "description": "🔢️ Variable name without the leading `$`."
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Value"
              }
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "object"
            },
            "fields": {
              "type": "array",
              "description": "📥️ Input-object fields, always sorted by name so map iteration order is never observable.",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/Value"
                  }
                },
                "required": [
                  "name",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "description": "🔤️ A string, an integer, a float, a boolean, or the bare name of an enum member projected as a string.",
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "null"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Selection": {
      "title": "One selected field",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "🧩️ Field name as written in the document, after alias resolution."
        },
        "alias": {
          "type": [
            "string",
            "null"
          ],
          "description": "🔑️ The result key, or null when the field is not aliased."
        },
        "arguments": {
          "type": "array",
          "description": "🎚️ Arguments, always sorted by name.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Value"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "fields": {
          "type": "array",
          "description": "🌳️ The sub-selection, empty for a leaf.",
          "items": {
            "$ref": "#/$defs/Selection"
          }
        }
      },
      "required": [
        "name",
        "alias",
        "arguments",
        "fields"
      ],
      "additionalProperties": false
    },
    "Document": {
      "title": "One parsed operation",
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "query",
            "mutation"
          ],
          "description": "⚡️ The operation kind, defaulting to `query` for a bare selection set."
        },
        "selections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Selection"
          }
        }
      },
      "required": [
        "operation",
        "selections"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "title": "One rejection, projected",
      "type": "object",
      "properties": {
        "input": {
          "type": "string"
        },
        "rejected": {
          "type": "boolean"
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "❌️ Byte offset of the failure. Dropped by the `diagnostic-v1` comparison profile: the oracle's own grammar reports different positions."
        },
        "detail": {
          "type": "string",
          "description": "❌️ The implementation's verbatim message. Dropped by `diagnostic-v1`; pinned instead by each implementation's own unit tests."
        }
      },
      "required": [
        "input",
        "rejected"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/Document"
}
