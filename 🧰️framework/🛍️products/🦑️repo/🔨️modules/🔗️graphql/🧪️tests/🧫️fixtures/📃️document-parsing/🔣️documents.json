{
  "$schema": "../../../🧬️schema/🔣️.json",
  "documents": [
    { "id": "bare-selection-set", "source": "{ repo }" },
    { "id": "explicit-query-keyword", "source": "query { repo }" },
    { "id": "named-query", "source": "query RepoOverview { repo }" },
    { "id": "mutation-keyword", "source": "mutation { ticketOpen }" },
    { "id": "named-mutation", "source": "mutation OpenTicket { ticketOpen }" },
    { "id": "sibling-fields", "source": "{ repo tickets goals }" },
    { "id": "comma-separated-fields", "source": "{ repo, tickets, goals }" },
    { "id": "nested-selection", "source": "{ repo { name technologies { name } } }" },
    { "id": "deeply-nested-selection", "source": "{ a { b { c { d { e } } } } }" },
    { "id": "typename-meta-field", "source": "{ node { __typename } }" },
    { "id": "leading-underscore-field", "source": "{ _internal }" },
    { "id": "digits-in-field-name", "source": "{ level2 tier3a }" },
    { "id": "single-alias", "source": "{ mine: tickets }" },
    { "id": "two-aliases-of-one-field", "source": "{ open: tickets(state: \"open\") closed: tickets(state: \"closed\") }" },
    { "id": "alias-on-nested-field", "source": "{ repo { label: name } }" },
    { "id": "string-argument", "source": "{ ticket(id: \"26/09/06/SOME-SLUG\") }" },
    { "id": "int-argument", "source": "{ tickets(limit: 25) }" },
    { "id": "negative-int-argument", "source": "{ tickets(offset: -3) }" },
    { "id": "float-argument", "source": "{ metrics(threshold: 1.5) }" },
    { "id": "negative-float-argument", "source": "{ metrics(threshold: -0.25) }" },
    { "id": "exponent-argument", "source": "{ metrics(threshold: 1.5e3) }" },
    { "id": "boolean-arguments", "source": "{ tickets(open: true, closed: false) }" },
    { "id": "null-argument", "source": "{ tickets(state: null) }" },
    { "id": "enum-argument", "source": "{ tickets(state: OPEN) }" },
    { "id": "multiple-arguments", "source": "{ tickets(state: OPEN, limit: 10, since: \"2026-09-06\") }" },
    { "id": "variable-argument", "source": "query Q($id: ID!) { ticket(id: $id) }" },
    { "id": "variable-with-default", "source": "query Q($limit: Int = 25) { tickets(limit: $limit) }" },
    { "id": "several-variable-definitions", "source": "query Q($a: String, $b: Int = 3, $c: [ID!]!) { tickets(a: $a, b: $b, c: $c) }" },
    { "id": "list-of-ints", "source": "{ tickets(ids: [1, 2, 3]) }" },
    { "id": "list-of-strings", "source": "{ tickets(ids: [\"a\", \"b\"]) }" },
    { "id": "nested-list", "source": "{ matrix(rows: [[1, 2], [3, 4]]) }" },
    { "id": "list-of-objects", "source": "{ upsert(rows: [{ id: 1 }, { id: 2 }]) }" },
    { "id": "object-literal", "source": "{ ticketOpen(input: { title: \"Some Title\", due: \"2026-09-30\" }) }" },
    { "id": "empty-object-literal", "source": "{ ticketOpen(input: {}) }" },
    { "id": "nested-object-literal", "source": "{ ticketOpen(input: { meta: { owner: \"ueli\", weight: 3 } }) }" },
    { "id": "object-with-variable-member", "source": "query Q($title: String!) { ticketOpen(input: { title: $title }) }" },
    { "id": "field-directive", "source": "{ tickets @include(if: true) }" },
    { "id": "directive-without-arguments", "source": "{ tickets @deprecated }" },
    { "id": "two-directives", "source": "{ tickets @include(if: true) @skip(if: false) }" },
    { "id": "directive-before-sub-selection", "source": "{ repo @include(if: true) { name } }" },
    { "id": "leading-comment", "source": "# what the repository looks like\n{ repo }" },
    { "id": "trailing-and-inline-comments", "source": "{\n  repo # the root\n  tickets\n}\n# done" },
    { "id": "comment-inside-arguments", "source": "{ tickets(\n  # only the open ones\n  state: OPEN\n) }" },
    { "id": "escaped-string-argument", "source": "{ search(query: \"a \\\"quoted\\\" word\") }" },
    { "id": "backslash-and-newline-escapes", "source": "{ search(query: \"line\\nnext\\ttab\\\\end\") }" },
    { "id": "unicode-escape-argument", "source": "{ search(query: \"\\u00e9\\u4e2d\") }" },
    { "id": "literal-unicode-argument", "source": "{ search(query: \"gemäß 中文 🧬\") }" },
    { "id": "unicode-in-object-member", "source": "{ ticketOpen(input: { title: \"Straße\" }) }" },
    { "id": "whitespace-heavy-document", "source": "\n\n   {\n\n     repo   (  id :  \"x\"  )   {\n\n        name\n\n     }\n\n   }\n\n" },
    { "id": "everything-at-once", "source": "query Everything($id: ID!, $limit: Int = 5) {\n  # the ticket itself\n  mine: ticket(id: $id) @include(if: true) {\n    __typename\n    title\n    labels(kinds: [BUG, CHORE], limit: $limit)\n    meta(filter: { nested: { flag: false, count: -2, ratio: 0.5 }, tags: [\"a\", \"b\"] })\n  }\n  goals(state: null)\n}" }
  ]
}
