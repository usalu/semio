{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Dashboard Cold Launch Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "command",
    "coldRequired",
    "warmReceiptUnchanged",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "command": {
      "const": [
        "commands",
        "--check"
      ]
    },
    "coldRequired": {
      "const": true
    },
    "warmReceiptUnchanged": {
      "const": true
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/Case"
      }
    }
  },
  "$defs": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "installed",
        "valid",
        "recorded",
        "current",
        "cold"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "installed": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "recorded": {
          "type": [
            "string",
            "null"
          ]
        },
        "current": {
          "type": "string"
        },
        "cold": {
          "type": "boolean"
        }
      }
    }
  }
}
