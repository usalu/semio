{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Workspace Control Plane",
  "description": "Local-only process commands, session projections and lifecycle events. A workspace daemon owns the processes independently of attached views.",
  "anyOf": [
    {
      "$ref": "#/definitions/ClientMessage"
    },
    {
      "$ref": "#/definitions/ServerMessage"
    }
  ],
  "definitions": {
    "Command": {
      "type": "object",
      "required": [
        "cmd",
        "args",
        "cwd",
        "env",
        "cols",
        "rows"
      ],
      "properties": {
        "cmd": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          }
        },
        "cwd": {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "pattern": "^[^=\\u0000]+$",
                "type": "string"
              },
              {
                "pattern": "^[^\\u0000]*$",
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32767
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32767
        }
      },
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "required": [
        "session_id",
        "command",
        "status",
        "pid",
        "code"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "command": {
          "$ref": "#/definitions/Command"
        },
        "status": {
          "enum": [
            "running",
            "stopping",
            "exited",
            "failed"
          ]
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "ClientMessage": {
      "oneOf": [
        {
          "required": [
            "type",
            "client_id"
          ],
          "properties": {
            "client_id": {
              "type": "string"
            },
            "type": {
              "const": "attach"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "detach"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "session_id",
            "command"
          ],
          "properties": {
            "command": {
              "$ref": "#/definitions/Command"
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "spawn"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "session_id",
            "data"
          ],
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "input"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "session_id",
            "cols",
            "rows"
          ],
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32767
            },
            "cols": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32767
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "resize"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "session_id"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "stop"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "session_id"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "kill"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "session_id"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "restart"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "list"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "shutdown"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "ping"
            }
          },
          "type": "object",
          "additionalProperties": false
        }
      ]
    },
    "ServerMessage": {
      "oneOf": [
        {
          "required": [
            "type",
            "daemon_pid"
          ],
          "properties": {
            "daemon_pid": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "attached"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "session"
          ],
          "properties": {
            "session": {
              "$ref": "#/definitions/Session"
            },
            "type": {
              "const": "session_changed"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "sessions"
          ],
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Session"
              }
            },
            "type": {
              "const": "sessions"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "replay_complete"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type",
            "message"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "type": {
              "const": "error"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "pong"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "shutdown"
            }
          },
          "type": "object",
          "additionalProperties": false
        }
      ]
    }
  }
}
