{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.coms/repo/dashboard/keyboard-batch.json",
  "title": "⌨️ Atomic launcher input batches",
  "type": "object",
  "required": ["version", "cases", "viewportCases", "defaultTextCases", "pointerCases"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Batch" } },
    "viewportCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Viewport" } },
    "defaultTextCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/DefaultText" } },
    "pointerCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Pointer" } }
  },
  "$defs": {
    "Batch": {
      "type": "object", "required": ["name", "field", "events", "expected"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "field": { "enum": ["parameter", "args", "env"] },
        "events": { "type": "array", "minItems": 2, "items": { "anyOf": [ { "enum": ["enter", "down"] }, { "type": "string", "pattern": "^char:[^\\u0000-\\u001f\\u007f]$" }, { "type": "string", "pattern": "^paste:[^\\u0000-\\u001f\\u007f]*$" } ] } },
        "expected": { "type": "string" }
      }
    },
    "Viewport": {
      "type": "object", "required": ["initialPage", "page", "expectedTop"], "additionalProperties": false,
      "properties": { "initialPage": { "type": "integer", "minimum": 1 }, "page": { "type": "integer", "minimum": 1 }, "expectedTop": { "type": "integer", "minimum": 0 } }
    },
    "DefaultText": {
      "type": "object", "required": ["default", "expected"], "additionalProperties": false,
      "properties": { "default": { "type": ["string", "null"] }, "expected": { "type": "string" } }
    },
    "Pointer": {
      "type": "object", "required": ["locale", "field", "expectedPlaceholder", "initialParameter", "initialArgs", "typed", "expectedText"], "additionalProperties": false,
      "properties": {
        "locale": { "enum": ["en", "de"] }, "field": { "const": "parameter" },
        "expectedPlaceholder": { "type": "string", "minLength": 1 },
        "initialParameter": { "type": "string" }, "initialArgs": { "type": "string" },
        "typed": { "type": "string", "minLength": 1, "maxLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]$" },
        "expectedText": { "type": "string" }
      }
    }
  }
}
