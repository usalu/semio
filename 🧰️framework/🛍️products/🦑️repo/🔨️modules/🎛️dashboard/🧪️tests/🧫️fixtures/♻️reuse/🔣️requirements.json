{
  "version": 1,
  "cases": [
    {
      "name": "distinct explicit tools for one required service",
      "entries": [
        {
          "id": "service:dev",
          "env": {},
          "requires": []
        },
        {
          "id": "app:dev",
          "env": {},
          "requires": [
            {
              "run": "service:dev",
              "env": {
                "SEMIO_BUILD_TOOL": "nx"
              }
            },
            {
              "run": "service:dev",
              "env": {
                "SEMIO_BUILD_TOOL": "bazel"
              }
            }
          ]
        }
      ],
      "root": "app:dev",
      "inherited": "nx",
      "required": [
        "service:dev=nx",
        "service:dev=bazel"
      ]
    },
    {
      "name": "compound member cannot suppress another backend service",
