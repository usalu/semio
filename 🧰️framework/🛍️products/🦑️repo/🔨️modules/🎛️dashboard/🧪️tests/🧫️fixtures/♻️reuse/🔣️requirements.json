              "run": "service:dev",
              "env": {
                "SEMIO_BUILD_TOOL": "bazel"
              }
            }
          ]
        },
        {
          "id": "compound:workspace/all",
          "env": {},
          "requires": [],
          "members": [
            {
              "run": "service:dev",
              "env": {
                "SEMIO_BUILD_TOOL": "nx"
              }
            },
            {
              "run": "app:dev",
              "env": {}
            }
          ]
        }
      ],
      "root": "compound:workspace/all",
      "inherited": "nx",
      "required": [
        "service:dev=bazel"
      ]
    },
