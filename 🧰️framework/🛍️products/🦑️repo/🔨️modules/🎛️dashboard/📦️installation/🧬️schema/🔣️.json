{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "platform",
    "mode",
    "path",
    "sources",
    "digest",
    "bytes",
    "permissions"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "platform": {
      "enum": [
        "darwin",
        "linux",
        "win32"
      ]
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "manifests",
        "digest"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9]+:[a-f0-9]{40}$"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "permissions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 511
    }
  },
  "definitions": {
    "SourceInputProtocol": {
      "const": {
        "rootFiles": ["rust-toolchain.toml", ".cargo/config.toml"],
        "selectedWorkspaceLock": "Cargo.lock",
        "dependencyWorkspaceLocks": false
      }
    },
    "SourceSignatureProtocol": {
      "const": {
        "metadataFields": [
          "dev",
          "ino",
          "size",
          "mtimeNs",
          "ctimeNs"
        ],
        "contentReads": 0
      }
    }
  }
}
