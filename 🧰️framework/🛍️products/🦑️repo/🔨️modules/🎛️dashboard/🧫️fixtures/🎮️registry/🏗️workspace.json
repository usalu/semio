          "hub": "http://127.0.0.1:8787",
          "dataDir": ".data/shell-base",
          "userDataDir": ".data/shell-user{N}",
          "localOnly": true,
          "examples": ["demo", "tower"],
          "engines": [],
          "assets": []
        },
        { "variant": "cad", "pluginId": "cad", "cratePath": "hub/cad", "aliases": ["design 3d"], "ports": { "react": 6020, "wgpu": 6120 }, "viewerPath": "/?plugin=cad&role=viewer", "examples": [], "engines": [], "assets": [] }
      ]
    },
    {
      "path": ".🧬semio/🦑️repo/🎫️tickets/🎆️26/🌙️09/☀️23/OPEN-PROBE/🎫️ticket.json",
      "json": { "title": "Open Probe", "emoji": "🔬️", "status": "open", "description": "A ticket with commands.", "goal": "🎯️dashboard" }
    },
    {
      "path": ".🧬semio/🦑️repo/🎫️tickets/🎆️26/🌙️09/☀️23/OPEN-PROBE/🎮️commands.json",
      "json": {
        "tools": [
          {
            "id": "probe",
            "verb": "test",
            "command": ["bun", ".🧬semio/🦑️repo/🎫️tickets/🎆️26/🌙️09/☀️23/OPEN-PROBE/probe.ts", "--mode={mode}"],
            "parameters": [
              { "id": "mode", "kind": "choice", "default": "fast", "values": [{ "id": "fast" }, { "id": "deep", "env": { "PROBE_DEPTH": "9" } }] }
            ]
          }
        ],
        "compounds": [{ "id": "probe-with-hub", "members": [{ "run": "hub:dev" }, { "run": "ticket:26/09/23/OPEN-PROBE/probe", "parameters": { "mode": "deep" } }] }]
      }
    },
    {
      "path": ".🧬semio/🦑️repo/🎫️tickets/🎆️26/🌙️08/☀️01/CLOSED-PROBE/🎫️ticket.json",
      "json": { "title": "Closed Probe", "emoji": "🧪️", "status": "closed", "summary": "Superseded.", "goal": "🎯️dashboard" }
    },
    {
      "path": ".🧬semio/🦑️repo/🎫️tickets/🎆️26/🌙️08/☀️01/CLOSED-PROBE/🎮️commands.json",
      "json": { "tools": [{ "id": "stale", "command": ["bun", "stale.ts"] }] }
    },
    {
      "path": ".🧬semio/🦑️repo/🎯️goals/dashboard/🎯️goal.json",
      "json": { "title": "Dashboard", "description": "Goal for the dashboard.", "prompt": "Instructions.", "status": "open", "dates": { "due": "2026-12-31" }, "client": "claude-code", "llm": "claude-opus-5" }
    }
  ]
}
