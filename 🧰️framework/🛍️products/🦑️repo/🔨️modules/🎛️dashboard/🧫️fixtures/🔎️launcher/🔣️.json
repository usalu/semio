  ],
  "journeys": [
    {
      "name": "search narrows the tree to the matching commands",
      "steps": [
        "type:quiz test"
      ],
      "expect": {
        "stage": "browse",
        "ids": [
          "@fx/quiz:test"
        ],
        "caption": "1 of 24 commands · bun nx run @fx/quiz:test",
        "input": "quiz test",
        "outcome": null
      }
    },
    {
      "name": "words may come in any order and also match the id",
      "steps": [
        "type:test @fx/quiz"
      ],
      "expect": {
        "ids": [
          "@fx/quiz:test"
        ]
      }
    },
    {
      "name": "nothing matching says so and backspace widens the search again",
      "steps": [
        "type:quizz"
      ],
      "expect": {
        "ids": [],
        "caption": "No command matches"
      }
    },
    {
      "name": "backspace after a miss finds the commands again",
      "steps": [
        "type:quizz",
        "backspace"
      ],
      "expect": {
        "ids": [
          "compound:workspace/quiz-with-hub",
          "@fx/quiz:dev",
          "@fx/quiz:build",
          "@fx/quiz:test"
        ]
      }
    },
    {
      "name": "an arrow opens a group and the opposite arrow closes it",
      "steps": [
        "right"
      ],
      "expect": {
        "contains": [
          "▾ dev"
        ]
      }
    },
    {
      "name": "closing a group hides its children",
      "steps": [
        "right",
        "left"
      ],
      "expect": {
        "lacks": [
          "▾"
        ]
      }
    },
    {
      "name": "enter on the found command opens its parameter form",
      "steps": [
        "type:quiz test",
        "enter"
      ],
      "expect": {
        "stage": "configure",
        "contains": [
          "cache: ‹use› (default)",
          "test-level:",
          "dependencies",
          "cargo-jobs",
          "[ Start ]",
          "bun nx run @fx/quiz:test"
        ]
      }
    },
    {
      "name": "choosing a value and starting sends exactly what was chosen",
      "steps": [
        "type:quiz test",
        "enter",
        "pgup",
        "down",
        "right",
        "pgdn",
        "enter"
      ],
      "expect": {
        "outcome": {
          "start": {
            "id": "@fx/quiz:test",
            "chosen": [
              [
                "test-level",
                "quick"
              ]
            ],
            "extra": [],
            "env": []
          }
        }
      }
    },
    {
      "name": "a flag toggles with space and left or right",
      "steps": [
        "type:quiz test",
        "enter",
        "pgup",
        "down",
        "down",
        "type: ",
        "pgdn",
        "enter"
      ],
      "expect": {
        "outcome": {
          "start": {
            "id": "@fx/quiz:test",
            "chosen": [
              [
                "dependencies",
                "true"
              ]
            ],
            "extra": [],
            "env": []
          }
        }
      }
    },
    {
      "name": "extra arguments and environment ride along",
      "steps": [
        "type:quiz test",
        "enter",
        "pgup",
        "down",
        "down",
        "down",
        "down",
        "type:--filter 'a b'",
        "down",
        "type:FOO=1 BAR='x y'",
        "down",
        "enter"
      ],
      "expect": {
        "outcome": {
          "start": {
            "id": "@fx/quiz:test",
            "chosen": [],
            "extra": [
              "--filter",
              "a b"
            ],
            "env": [
              [
                "FOO",
                "1"
              ],
              [
                "BAR",
                "x y"
              ]
            ]
          }
        }
      }
    },
    {
      "name": "a text parameter without a value blocks the start and says why",
      "steps": [
        "type:docs",
        "enter",
        "enter"
      ],
      "expect": {
        "stage": "configure",
        "outcome": null,
        "contains": [
          "Cannot start"
        ]
      }
    },
    {
      "name": "typing the required text lets the start through",
      "steps": [
        "type:docs",
        "enter",
        "type:site",
        "down",
        "down",
        "down",
        "enter"
      ],
      "expect": {
        "outcome": {
          "start": {
            "id": "tool:workspace/docs",
            "chosen": [
              [
                "dir",
                "site"
              ]
            ],
            "extra": [],
            "env": []
          }
        }
      }
    },
    {
      "name": "a command that changes the repository asks before it starts",
      "steps": [
        "type:ticket.close",
        "enter",
        "enter"
      ],
      "expect": {
        "stage": "confirm",
        "outcome": null,
        "contains": [
          "changes the repository"
        ]
      }
    },
    {
      "name": "confirming starts it",
      "steps": [
        "type:ticket.close",
        "enter",
        "enter",
        "enter"
      ],
      "expect": {
        "outcome": {
          "start": {
            "id": "repo:ticket.close:26/09/23/DEMO",
            "chosen": [],
            "extra": [],
            "env": []
          }
        }
      }
    },
    {
      "name": "going back from the confirmation returns to the form",
      "steps": [
        "type:ticket.close",
        "enter",
        "enter",
        "esc"
      ],
      "expect": {
        "stage": "configure",
        "outcome": null
      }
    },
    {
      "name": "a service the command requires is shown before it starts",
      "steps": [
        "type:@fx/quiz:dev",
        "enter"
      ],
      "expect": {
        "stage": "configure",
        "contains": [
          "Starts first",
          "hub"
        ]
      }
    },
    {
      "name": "a compound lists its members before it starts",
      "steps": [
        "type:quiz-with-hub",
        "enter"
      ],
      "expect": {
        "contains": [
          "Starts together (2)"
        ]
      }
    },
    {
      "name": "back steps out one level at a time and finally leaves",
      "steps": [
        "type:quiz test",
        "enter",
        "esc",
        "esc",
        "esc"
      ],
      "expect": {
        "stage": "browse",
        "input": "",
        "outcome": "leave"
      }
    }
  ]
}
