{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/dashboard/control-policy-products.json",
  "title": "🎛️ Dashboard Control Policy Products",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "removedPaths",
    "owners",
    "retiredDependencies",
    "dependencySections"
  ],
  "properties": {
    "removedPaths": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owners": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "active"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "retiredDependencies": {
      "const": [
        "@types/vscode",
        "@vscode/test-cli",
        "@vscode/vsce"
      ]
    },
    "dependencySections": {
      "const": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "peerDependencies"
      ]
    }
  }
}
