{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limit",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "limit": {
      "const": 32
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/definitions/PollCase"
      }
    }
  },
  "definitions": {
    "PollCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "progress",
        "cancelled",
        "polls"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "progress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "cancelled": {
          "type": "boolean"
        },
        "polls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 129
        }
      }
    }
  }
}
