{
  "name": "@semio-tech/repo-dashboard-rs",
  "$schema": "../../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build"
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/build/{options.env.SEMIO_BUILD_MODE}"
      ]
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "test-coverage": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test coverage"
      },
      "cache": false
    },
    "test-journeys": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test journeys"
      },
      "cache": false
    },
    "test-load": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test load"
      },
      "cache": false
    },
    "test-smoke": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test smoke"
      },
      "cache": false
    },
    "run": {
      "metadata": {
        "semio": {
          "dashboard": {
            "parameters": [
              {
                "id": "repo-implementation",
                "kind": "choice",
                "values": [
                  {
                    "id": "rust",
                    "env": {
                      "SEMIO_REPO_IMPLEMENTATION": "rust"
                    }
                  },
                  {
                    "id": "go",
                    "env": {
                      "SEMIO_REPO_IMPLEMENTATION": "go",
                      "GOWORK": "{workspace}/go.work"
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts run",
        "forwardAllArgs": true,
        "env": {
          "SEMIO_NATIVE_OWNER_PROGRESS": "delegated"
        }
      },
      "cache": false
    },
    "daemon": {
      "metadata": {
        "semio": {
          "dashboard": {
            "parameters": [
              {
                "id": "action",
                "kind": "choice",
                "default": "status",
                "values": [
                  {
                    "id": "start",
                    "args": [
                      "start"
                    ]
                  },
                  {
                    "id": "stop",
                    "args": [
                      "stop"
                    ]
                  },
                  {
                    "id": "status",
                    "args": [
                      "status"
                    ]
                  },
                  {
                    "id": "attach",
                    "args": [
                      "attach"
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts daemon",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "install": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts install"
      },
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "preferences": {
      "metadata": {
        "semio": {
          "dashboard": {
            "parameters": [
              {
                "id": "action",
                "kind": "choice",
                "default": "show",
                "values": [
                  {
                    "id": "show",
                    "args": [
                      "show"
                    ]
                  },
                  {
                    "id": "set",
                    "args": [
                      "set"
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts preferences",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "launch": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🎛️dashboard/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts launch",
        "forwardAllArgs": true
      },
      "cache": false
    }
  }
}
