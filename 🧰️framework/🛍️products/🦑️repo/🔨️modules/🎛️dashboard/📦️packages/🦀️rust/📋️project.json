    "run": {
      "metadata": {
        "semio": {
          "dashboard": {
            "parameters": [
              {
                "id": "repo-implementation",
                "kind": "choice",
                "values": [
                  {
                    "id": "rust",
                    "env": {
                      "SEMIO_REPO_IMPLEMENTATION": "rust"
                    }
                  },
                  {
                    "id": "go",
                    "env": {
                      "SEMIO_REPO_IMPLEMENTATION": "go",
                      "GOWORK": "{workspace}/go.work"
                    }
                  }
                ]
              }
            ]
          },
          "execution": {
            "version": 1,
            "kind": "orchestration",
            "children": [
