   "line": "prog.exe \"abc\" d e",
   "expected": [
    "prog.exe",
    "abc",
    "d",
    "e"
   ]
  },
  {
   "id": "ms-docs-backslashes-before-quote",
   "line": "prog.exe a\\\\\\b d\"e f\"g h",
   "expected": [
    "prog.exe",
    "a\\\\\\b",
    "de fg",
    "h"
   ]
  },
  {
   "id": "ms-docs-escaped-quote",
   "line": "prog.exe a\\\\\\\"b c d",
   "expected": [
    "prog.exe",
    "a\\\"b",
    "c",
    "d"
   ]
  },
  {
   "id": "ms-docs-even-backslashes-open-quote",
   "line": "prog.exe a\\\\\\\\\"b c\" d e",
   "expected": [
    "prog.exe",
    "a\\\\b c",
    "d",
    "e"
   ]
  },
  {
