{
  "name": "@semio-tech/repo-todos-rs",
  "$schema": "../../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "inputs": [
        "production",
        "^production",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📝️todos/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts build"
      },
      "metadata": {
        "semio": {
          "rustBuildIntent": {
            "version": 1,
            "manifest": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📝️todos/📦️packages/🦀️rust/Cargo.toml",
            "package": "semio-framework-repo-todos",
            "scope": "package",
            "fallback": {
              "kind": "bounded-cargo",
              "adapters": [
                "foreign-source",
                "proc-macro",
                "build-script",
                "build-script-run",
                "effective-profile"
              ]
            }
          }
        }
      },
      "cache": true
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📝️todos/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test"
      }
    }
  }
}
