{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/tickets/schema.json",
  "title": "🎫️ semio repo tickets",
  "description": "The wire shapes of the ticket domain: the persisted 🎫️ticket.json document, the ticket identity, the open/close/reopen/change requests and their outcomes, the important-document transaction journal, the plan attachment and the file scope of a close. Objects are deliberately open: neither implementation refuses an unknown member — a document may carry members such as `note`, `closedAt`, `files` or `contributors`, and the codec reads and then DROPS them.",
  "$defs": {
    "TicketStatus": {
      "description": "🔖️ The closed lifecycle vocabulary. A document without an explicit status is refused rather than defaulted.",
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "McpClientKind": {
      "description": "🪪️ Which agent client a plan or spec id is resolved against. Cursor and generic carry no plan attachment.",
      "type": "string",
      "enum": [
        "generic",
        "cursor",
        "kiro",
        "copilot",
        "claude",
        "codex"
      ]
    },
    "TicketId": {
      "description": "🪪️ The dated identity of a ticket. `id` is YY/MM/DD/SLUG, `relPath` is 🎆️YY/🌙️MM/☀️DD/SLUG. A slug may itself carry `/` for a child ticket.",
      "type": "object",
      "properties": {
        "year": {
          "type": "integer"
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "slug": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "year",
        "month",
        "day",
        "slug"
      ]
    },
    "TicketManagementData": {
      "description": "🐙️ The management-provider link of a ticket. Written under the member name `github`.",
      "type": "object",
      "properties": {
        "issue": {
          "type": "string"
        }
      }
    },
    "TicketPlan": {
      "description": "🗺️ The primary plan or spec of a ticket. A ticket owns every `<name>_<id>.plan.md` (or `<name>.plan.md`) file of its own folder and no plan lives in a client directory of the repository. `source` is the absolute path of a client-owned file (a home-directory plan or a Kiro spec directory) while the ticket is open; the close moves it into the ticket folder and swaps `source` for `local`.",
      "type": "object",
      "properties": {
        "client": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "local": {
          "type": "string"
        }
      }
    },
    "TicketDocument": {
      "description": "🎫️ The durable ticket document. Declared parent, plan, sessions, interactions and agents survive every save; date, slug and paths belong to the rooted ticket identity. Members other than title and status are omitted when empty.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "emoji": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TicketStatus"
        },
        "description": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "github": {
          "$ref": "#/$defs/TicketManagementData"
        },
        "goal": {
          "type": "string"
        },
        "parent": {
          "description": "🌿️ The persisted parent ticket identity.",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/TicketPlan"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interactions": {
          "description": "🧾️ Durable ordered human and agent interactions, preserved on every save.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Interaction"
          }
        },
        "agents": {
          "description": "🤖️ Durable ordered agent sessions and their plans.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TicketAgent"
          }
        }
      },
      "required": [
        "title",
        "status"
      ]
    },
    "Interaction": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "checkpoint": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "llm": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      "required": [
        "kind",
        "date",
        "author",
        "system",
        "client",
        "checkpoint"
      ]
    },
    "TicketOpenRequest": {
      "type": "object",
      "properties": {
        "emoji": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        },
        "llm": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string"
        },
        "noIssue": {
          "type": "boolean"
        },
        "noManagement": {
          "type": "boolean"
        },
        "issue": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "specId": {
          "type": "string"
        },
        "draft": {
          "type": "string"
        }
      },
      "required": [
        "emoji",
        "title",
        "prompt",
        "client",
        "goal"
      ]
    },
    "TicketCloseRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noManagement": {
          "type": "boolean"
        },
        "bulk": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "summary"
      ]
    },
    "TicketReopenRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "llm": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "client": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "noManagement": {
          "type": "boolean"
        },
        "session": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "specId": {
          "type": "string"
        },
        "draft": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "client"
      ]
    },
    "TicketChangeRequest": {
      "description": "♻️ An absent member leaves the ticket's value alone; a present one replaces it.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "noManagement": {
          "type": "boolean"
        },
        "llm": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "client": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "JournalStep": {
      "description": "📓️ One step of an important-document transaction, in the order it was attempted.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "inspect",
            "restore",
            "remove-file",
            "remove-dir",
            "ensure",
            "ensure-dir",
            "rollback-file",
            "rollback-dir",
            "create-important",
            "rename",
            "save"
          ]
        },
        "path": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "created",
            "preserved"
          ]
        }
      },
      "required": [
        "op",
        "path",
        "outcome"
      ]
    },
    "TransactionJournal": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JournalStep"
          }
        }
      },
      "required": [
        "steps"
      ]
    },
    "ImportantPreimage": {
      "description": "🖼️ The exact empty-document bundle a close must find. The document must be a regular file, empty, and the only child of its directory.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "mode": {
          "type": "integer"
        }
      },
      "required": [
        "path",
        "dir",
        "mode"
      ]
    },
    "ImportantCreation": {
      "description": "✨️ What a reopen created, so a failed save removes exactly that and nothing else.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "file_created": {
          "type": "boolean"
        },
        "dir_created": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "dir",
        "file_created",
        "dir_created"
      ]
    },
    "TicketOutcome": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "relPath": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TicketStatus"
        },
        "document": {
          "type": "string"
        },
        "journal": {
          "$ref": "#/$defs/TransactionJournal"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "relPath",
        "status",
        "document"
      ]
    },
    "PurgePolicy": {
      "description": "🧹️ The one purge law of ticket generated output, identical in Go, Rust and TypeScript: only the direct child folder `generatedDirectory` of a CLOSED ticket is eligible. Selection `oversized` removes files above `oversizedFileBytes` and folders above `oversizedFolderBytes` (the ticket close and `repo ticket purge-artifacts`), selection `generated` removes everything below it (`repo clean`). A file the git index tracks is never removed, a folder holding one is kept, a ticket with any file younger than `liveWriterSeconds` is skipped whole (a live lease only ever refreshes such a file), and an unanswerable tracking query fails closed. Authored inputs, scripts, configs and reports outside that folder are retained regardless of size, and a purge without `apply` only returns the plan.",
      "const": {
        "generatedDirectory": "🗑️generated",
        "oversizedFileBytes": 5242880,
        "oversizedFolderBytes": 10485760,
        "liveWriterSeconds": 600
      }
    },
    "PurgeSelection": {
      "description": "🎚️ Which part of an eligible generated folder is removed.",
      "enum": [
        "oversized",
        "generated"
      ]
    },
    "PurgeRemoval": {
      "description": "🗑️ One planned removal: a ticket-relative path below the dated tickets folder, a file or a whole folder, and the bytes it frees.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "kind",
        "bytes"
      ]
    },
    "PurgeSkip": {
      "description": "⏭️ Why a whole ticket is left alone.",
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "not-closed",
            "live-writer",
            "symlink-root",
            "not-directory",
            "tracked-unknown"
          ]
        }
      },
      "required": [
        "ticket",
        "reason"
      ]
    },
    "PurgePlan": {
      "description": "🧹️ What a purge removes (applied) or would remove (dry run), sorted by path and ticket.",
      "type": "object",
      "properties": {
        "removals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PurgeRemoval"
          }
        },
        "skips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PurgeSkip"
          }
        }
      },
      "required": [
        "removals",
        "skips"
      ]
    },
    "PurgeCase": {
      "description": "🧪️ One frozen purge case: declared facts of a throwaway repository (tickets with a manifest state, files with size, age and tracked flag, links) and the plan every implementation must reproduce from real files.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "git": {
          "type": "boolean"
        },
        "request": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "closed",
                "ticket"
              ]
            },
            "ticket": {
              "type": "string"
            },
            "selection": {
              "$ref": "#/$defs/PurgeSelection"
            }
          },
          "required": [
            "scope",
            "selection"
          ]
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "manifest": {
                "enum": [
                  "open",
                  "closed",
                  "closing",
                  "invalid",
                  "missing"
                ]
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "file",
                        "directory",
                        "symlink"
                      ]
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "ageSeconds": {
                      "type": "integer"
                    },
                    "tracked": {
                      "type": "boolean"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "kind"
                  ]
                }
              }
            },
            "required": [
              "id",
              "manifest",
              "entries"
            ]
          }
        },
        "expect": {
          "$ref": "#/$defs/PurgePlan"
        }
      },
      "required": [
        "id",
        "description",
        "git",
        "request",
        "tickets",
        "expect"
      ]
    },
    "DiffLines": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "added",
        "removed"
      ]
    },
    "TicketFileScope": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff_lines": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DiffLines"
          }
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "files",
        "excluded",
        "diff_lines",
        "statuses"
      ]
    },
    "PlanSource": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "is_directory": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "is_directory"
      ]
    },
    "TicketError": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "invalid",
            "not-found",
            "store",
            "conflict"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "class",
        "message"
      ]
    },
    "TicketInteractionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "system",
        "checkpoint"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "checkpoint": {
          "type": "string"
        }
      }
    },
    "TicketDraftPolicy": {
      "description": "Bounded portable draft preflight shared by the implementations.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximumImmediateEntries": {
          "const": 1024
        },
        "maximumNodes": {
          "const": 4096
        },
        "maximumDepth": {
          "const": 32
        },
        "maximumSuffix": {
          "const": 1024
        },
        "maximumPathUTF16": {
          "const": 256
        }
      },
      "required": [
        "maximumImmediateEntries",
        "maximumNodes",
        "maximumDepth",
        "maximumSuffix",
        "maximumPathUTF16"
      ]
    },
    "TicketAgent": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        },
        "contributor": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "llm": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "transcript": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/TicketAgentPlan"
        }
      },
      "required": [
        "session"
      ]
    },
    "TicketAgentPlan": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TicketAgentPlanStep"
          }
        }
      }
    },
    "TicketAgentPlanStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "ideated": {
          "type": "string"
        },
        "started": {
          "type": "string"
        },
        "completed": {
          "type": "string"
        },
        "abandoned": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}
