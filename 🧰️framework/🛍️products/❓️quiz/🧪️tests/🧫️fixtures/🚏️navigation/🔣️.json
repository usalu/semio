        { "open": { "screen": "home", "page": "board" }, "step": { "screen": "home", "page": "board" }, "back": { "screen": "home" }, "forward": null, "up": { "screen": "home" } },
        { "open": { "screen": "home", "page": "heating" }, "step": { "screen": "home", "page": "heating" }, "back": { "screen": "home", "page": "board" }, "forward": null, "up": { "screen": "home" } },
        { "go": "back", "step": { "screen": "home", "page": "board" }, "back": { "screen": "home" }, "forward": { "screen": "home", "page": "heating" }, "up": { "screen": "home" } },
        { "go": "back", "step": { "screen": "home" }, "back": null, "forward": { "screen": "home", "page": "board" }, "up": null },
        { "go": "back", "step": { "screen": "home" }, "back": null, "forward": { "screen": "home", "page": "board" }, "up": null },
        { "go": "forward", "step": { "screen": "home", "page": "board" }, "back": { "screen": "home" }, "forward": { "screen": "home", "page": "heating" }, "up": { "screen": "home" } },
