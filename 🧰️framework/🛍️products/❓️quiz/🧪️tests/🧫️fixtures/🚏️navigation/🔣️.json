        { "go": "forward", "step": { "screen": "home", "page": "prefs" }, "back": { "screen": "home", "page": "board" }, "forward": null, "up": { "screen": "home" } },
        { "open": { "screen": "home", "page": "prefs" }, "step": { "screen": "home", "page": "prefs" }, "back": { "screen": "home", "page": "board" }, "forward": null, "up": { "screen": "home" } },
        { "go": "overview", "step": { "screen": "home" }, "back": { "screen": "home", "page": "prefs" }, "forward": null, "up": null },
        { "go": "up", "step": { "screen": "home" }, "back": { "screen": "home", "page": "prefs" }, "forward": null, "up": null },
        { "go": "overview", "step": { "screen": "home" }, "back": { "screen": "home", "page": "prefs" }, "forward": null, "up": null }
