{
  "name": "@semio-tech/framework-os-scale-fixture",
  "root": "🧰️framework/🛍️products/💻️os/🧪️testkit/⚖️scale/📦️packages/🦀️rust",
  "sourceRoot": "🧰️framework/🛍️products/💻️os/🧪️testkit/⚖️scale",
  "projectType": "library",
  "namedInputs": {
    "default": ["{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🧬️schema/**/*.wit"]
  },
  "tags": [
    "lang:rust",
    "role:testkit",
    "family:scale-fixture"
  ],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun 📜️script.ts check",
        "cwd": "{projectRoot}"
      }
    },
    "check-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun 📜️script.ts check-wasm",
        "cwd": "{projectRoot}"
      }
    },
    "build-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun 📜️script.ts build-wasm",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "parallelism": false,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/component"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun 📜️script.ts test",
        "cwd": "{projectRoot}"
      }
    }
  }
}
