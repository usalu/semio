{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/dev/local-hub/provider/schema.json",
  "$ref": "#/$defs/DevLocalHubProviderV1",
  "$defs": {
    "DevLocalHubProviderV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "defaultProfileId"
      ],
      "properties": {
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "program",
            "args"
          ],
          "properties": {
            "program": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        },
        "defaultProfileId": {
          "$ref": "https://json.schemas.assets.semio-tech.com/os/directory/local-session/broker/schema.json#/$defs/LocalSessionProfileIdV1"
        }
      }
    }
  }
}
