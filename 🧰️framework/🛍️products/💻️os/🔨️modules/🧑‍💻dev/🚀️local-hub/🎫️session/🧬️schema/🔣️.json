{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Policy": {
      "const": {
        "maximumPendingRequests": 32,
        "maximumRecordBytes": 16384,
        "maximumResponseBytes": 65536,
        "maximumResponseChunks": 1024,
        "maximumHeaderBytes": 16384,
        "maximumConnections": 32,
        "maximumRequestsPerConnection": 16,
        "maximumRequestMilliseconds": 20000,
        "maximumJoinMilliseconds": 120000,
        "maximumJoinDelayMilliseconds": 1000,
        "progressIntervalMilliseconds": 10000,
        "maximumReadinessRequestMilliseconds": 1500,
        "runtimeChannelName": "os-local-hub-session"
      }
    },
    "Proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "endpoint",
        "secret"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/session$"
        },
        "secret": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localOnly"
      ],
      "properties": {
        "localOnly": {
          "type": "boolean"
        },
        "hubUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^https?://[^/?#@]+/?$"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "service",
            "defaultProfileId"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "service": {
              "const": "local-hub"
            },
            "defaultProfileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
            }
          }
        }
      }
    },
    "JoinObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "elapsedMilliseconds"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "elapsedMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "IoSettlement": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": [
        {
          "const": "admit"
        },
        {
          "const": "start"
        },
        {
          "const": "stop-transport"
        },
        {
          "const": "join"
        },
        {
          "const": "release"
        }
      ],
      "additionalItems": false
    }
  }
}
