    { "profile": "wasm-release", "valid": true, "shipped": true, "expectedArgs": ["-p", "semio-hub-vcs", "--lib", "--target", "wasm32-wasip2", "--profile", "wasm-release"] },
    { "profile": "wasm-prototype", "valid": true, "shipped": false, "expectedArgs": ["-p", "semio-hub-vcs", "--lib", "--target", "wasm32-wasip2", "--profile", "wasm-prototype"] },
    { "profile": "wasm-dev", "valid": false },
    { "profile": "dev", "valid": false },
    { "profile": "release", "valid": false },
    { "profile": "", "valid": false },
    { "profile": "wasm-release ", "valid": false },
    { "profile": "foreign", "valid": false }
  ]
