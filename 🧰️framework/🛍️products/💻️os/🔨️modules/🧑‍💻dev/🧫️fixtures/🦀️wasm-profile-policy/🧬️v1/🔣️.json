  "artifactPaths": [{"packageName": "semio-hub-gis", "profile": "wasm-release", "expectedRelativePath": "wasm32-wasip2/wasm-release/semio_hub_gis_component.wasm"}, {"packageName": "semio-hub-gis", "profile": "wasm-prototype", "expectedRelativePath": "wasm32-wasip2/wasm-prototype/semio_hub_gis_component.wasm"}],
