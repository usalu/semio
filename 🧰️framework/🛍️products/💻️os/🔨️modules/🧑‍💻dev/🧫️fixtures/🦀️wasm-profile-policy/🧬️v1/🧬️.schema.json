{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runtimeDirectories", "publicationProfile", "developmentPackageOverrides", "artifactPaths", "cases"],
  "properties": {
    "schema": { "const": "semio.build.wasi-profile-policy/v1" },
    "runtimeDirectories": { "const": ["wasm-dev", "wasm-release"] },
    "publicationProfile": { "const": "wasm-release" },
    "developmentPackageOverrides": { "const": {"semio-s-plugin-lowpoly":{"opt-level":2},"semio-s-plugin-puzzle":{"opt-level":2}} },
    "artifactPaths": { "const": [{"packageName":"semio-s-plugin-gis","profile":null,"expectedRelativePath":"wasm32-wasip2/wasm-dev/semio_s_plugin_gis.wasm"},{"packageName":"semio-s-plugin-gis","profile":"wasm-release","expectedRelativePath":"wasm32-wasip2/wasm-release/semio_s_plugin_gis.wasm"}] },
    "cases": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mode", "override", "expectedProfile", "expectedDirectory"],
        "properties": {
          "mode": { "enum": ["dev", "ship"] },
          "override": { "type": ["string", "null"], "maxLength": 64 },
          "expectedProfile": { "enum": ["wasm-dev", "wasm-release", null] },
          "expectedDirectory": { "enum": ["wasm-dev", "wasm-release", null] }
        }
      }
    }
  }
}
