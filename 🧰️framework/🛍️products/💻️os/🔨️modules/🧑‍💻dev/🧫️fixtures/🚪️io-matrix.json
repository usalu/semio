        { "id": "dsl", "verb": "exportProgram", "format": "text" },
        { "id": "csv", "verb": "exportRegistersCsv", "format": "csv" }
      ],
      "imports": [
        { "id": "dsl", "verb": "importProgramRequest", "via": "picker", "from": "dsl" },
        { "id": "csv", "verb": "importRegistersCsvRequest", "via": "picker", "from": "csv" }
      ],
      "reach": ["runAnalysis", "runReport", "runValidation", "search"]
    },
