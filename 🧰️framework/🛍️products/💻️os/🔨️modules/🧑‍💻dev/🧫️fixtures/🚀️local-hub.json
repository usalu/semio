  "joins": [
    {
      "name": "a hub that binds after the serve started is joined",
      "bindsAfterMs": 400,
      "boundMs": 8000,
      "expected": "joined"
    },
    {
      "name": "a hub that is already up is joined at once",
      "bindsAfterMs": 0,
      "boundMs": 8000,
      "expected": "joined"
    },
    {
      "name": "a hub that never binds is given up after the bound, and nothing binds its port",
      "bindsAfterMs": null,
      "boundMs": 1200,
      "expected": "gave-up"
    }
  ],
  "owns": [
    {
      "name": "no owner, free port: one owner is started and joined once it binds",
      "lease": "none",
      "portInUse": false,
      "readyAfterPolls": 3,
      "expected": {
        "spawned": 1,
        "statuses": [
          "starting",
          "joined"
        ],
        "up": true
      }
    },
    {
      "name": "a live owner that has not bound yet: waited for, never a second owner",
      "lease": "live",
      "portInUse": false,
      "readyAfterPolls": 3,
      "expected": {
        "spawned": 0,
        "statuses": [
          "owned",
          "joined"
        ],
        "up": true
      }
    },
    {
      "name": "a stale owner (process gone), free port: taken over by one new owner",
      "lease": "stale",
      "portInUse": false,
      "readyAfterPolls": 2,
      "expected": {
        "spawned": 1,
        "statuses": [
          "starting",
          "joined"
        ],
        "up": true
      }
    },
    {
      "name": "a port someone else holds: no owner, typed refusal",
      "lease": "none",
      "portInUse": true,
