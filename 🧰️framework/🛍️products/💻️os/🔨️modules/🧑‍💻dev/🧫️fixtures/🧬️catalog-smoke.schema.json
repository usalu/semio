{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseUrl",
    "shellPluginId",
    "startedAt",
    "durationMs",
    "boot",
    "programs",
    "failedPlugins",
    "totals"
  ],
  "properties": {
    "baseUrl": {
      "type": "string",
      "minLength": 1
    },
    "shellPluginId": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beacon",
        "failure",
        "phaseMs",
        "bodyExcerpt",
        "consoleErrors"
      ],
      "properties": {
        "beacon": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "phaseMs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "firstModule",
            "beacon"
          ],
          "properties": {
            "commit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "firstModule": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "beacon": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "bodyExcerpt": {
          "type": "string",
          "maxLength": 1000
        },
        "consoleErrors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pluginId",
          "appId",
          "label",
          "status",
          "durationMs",
          "windowId",
          "descendants",
          "width",
          "height",
          "firstError"
        ],
        "properties": {
          "pluginId": {
            "type": "string",
            "minLength": 1
          },
          "appId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "windowId": {
            "type": [
              "string",
              "null"
            ]
          },
          "descendants": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 0
          },
          "height": {
            "type": "integer",
            "minimum": 0
          },
          "firstError": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "failedPlugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pluginId",
          "status"
        ],
        "properties": {
          "pluginId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "failed",
              "crashed"
            ]
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "skipped"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
