{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "fileName", "bytes", "sha256", "facadeModuleId", "imports", "dynamicImports", "modules", "originalFileNames", "names"],
    "properties": {
      "type": { "enum": ["chunk", "asset"] },
      "fileName": { "type": "string", "minLength": 1 },
      "bytes": { "type": "integer", "minimum": 0 },
      "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "facadeModuleId": { "type": ["string", "null"] },
      "imports": { "type": "array", "items": { "type": "string" } },
      "dynamicImports": { "type": "array", "items": { "type": "string" } },
      "modules": { "type": "array", "items": { "type": "string" } },
      "originalFileNames": { "type": "array", "items": { "type": "string" } },
      "names": { "type": "array", "items": { "type": "string" } }
    }
  }
}
