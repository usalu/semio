{
  "description": "Manifest-admitted universal history serve selection. Catalog rows come from generated playground authority.",
  "cases": [
    {
      "name": "specialized journey keeps the declared scenario playground",
      "universal": false,
      "url": "http://127.0.0.1:6064/?plugin=$family",
      "renderer": "react",
      "expected": "$scenario",
      "scenarioVariant": "$scenario"
    },
    {
      "name": "custom route forwards a declared family",
      "universal": true,
      "url": "http://127.0.0.1:6064/?plugin=$family",
      "renderer": "react",
      "expected": "$family"
    },
    {
      "name": "native catalog port admits a declared family",
      "universal": true,
      "url": "http://127.0.0.1:$familyWgpuPort/",
      "renderer": "wgpu",
      "expected": "$family"
    },
    {
      "name": "explicit custom family works on a free port",
      "universal": true,
      "url": "http://127.0.0.1:6901/",
      "renderer": "react",
      "explicit": "$family",
      "expected": "$family"
    },
    {
      "name": "conflicting route and explicit family is refused",
      "universal": true,
      "url": "http://127.0.0.1:6901/?plugin=$scenario",
      "renderer": "react",
      "explicit": "$family",
      "error": true
    },
    {
      "name": "unknown route is refused before serve startup",
      "universal": true,
      "url": "http://127.0.0.1:6901/?plugin=not-declared",
      "renderer": "react",
      "error": true
    },
    {
      "name": "unclaimed port without declared variant is refused",
      "universal": true,
      "url": "http://127.0.0.1:6901/",
      "renderer": "react",
      "error": true
    }
  ],
  "startups": [
    {
      "name": "cold scenario React activates before listener",
      "variant": "$scenario",
      "renderer": "react",
      "port": 6012,
      "answers": false,
      "occupied": false,
      "cancel": null,
      "activationFails": false,
      "outcome": "ready",
      "trace": [
        "@semio-tech/framework-os-dev:activate-$scenario-react-prototype",
        "spawn",
        "stop"
      ]
    },
    {
      "name": "cold custom WGPU activates its declared family",
      "variant": "$family",
      "renderer": "wgpu",
      "port": 6164,
      "answers": false,
      "occupied": false,
      "cancel": null,
      "activationFails": false,
      "outcome": "ready",
      "trace": [
        "@semio-tech/framework-os-dev:activate-$family-wgpu-prototype",
        "spawn",
        "stop"
      ]
    },
    {
      "name": "existing serve is reused without activation",
      "variant": "$family",
      "renderer": "react",
      "port": 6064,
      "answers": true,
      "occupied": true,
      "cancel": null,
      "activationFails": false,
      "outcome": "reused",
      "trace": []
    },
    {
      "name": "failed activation starts no listener",
      "variant": "$scenario",
      "renderer": "react",
      "port": 6012,
      "answers": false,
      "occupied": false,
      "cancel": null,
      "activationFails": true,
      "outcome": "error",
      "trace": [
        "@semio-tech/framework-os-dev:activate-$scenario-react-prototype"
      ]
    },
    {
      "name": "pre-cancelled journey owns no producer or listener",
      "variant": "$family",
      "renderer": "wgpu",
      "port": 6164,
      "answers": false,
      "occupied": false,
      "cancel": "before",
      "activationFails": false,
      "outcome": "error",
      "trace": []
    },
    {
      "name": "cancelled activation starts no listener",
      "variant": "$family",
      "renderer": "wgpu",
      "port": 6164,
      "answers": false,
      "occupied": false,
      "cancel": "during",
      "activationFails": false,
      "outcome": "error",
      "trace": [
        "@semio-tech/framework-os-dev:activate-$family-wgpu-prototype"
      ]
    },
    {
      "name": "occupied non-server port refuses before activation",
      "variant": "$scenario",
      "renderer": "react",
      "port": 6012,
      "answers": false,
      "occupied": true,
      "cancel": null,
      "activationFails": false,
      "outcome": "error",
      "trace": []
    },
    {
      "name": "canonical hub port refuses before activation",
      "variant": "$scenario",
      "renderer": "react",
      "port": 7800,
      "answers": false,
      "occupied": false,
      "cancel": null,
      "activationFails": false,
      "outcome": "error",
      "trace": []
    },
    {
      "name": "another journey finishes the listener during activation",
      "variant": "$scenario",
      "renderer": "react",
      "port": 6012,
      "answers": false,
      "occupied": false,
      "cancel": null,
      "activationFails": false,
      "outcome": "reused",
      "trace": [
        "@semio-tech/framework-os-dev:activate-$scenario-react-prototype"
      ],
      "afterActivationAnswers": true,
      "afterActivationOccupied": true
    },
    {
      "name": "a non-server claims the port during activation",
      "variant": "$scenario",
      "renderer": "react",
      "port": 6012,
      "answers": false,
      "occupied": false,
      "cancel": null,
      "activationFails": false,
      "outcome": "error",
      "trace": [
        "@semio-tech/framework-os-dev:activate-$scenario-react-prototype"
      ],
      "afterActivationAnswers": false,
      "afterActivationOccupied": true
    }
  ]
}
