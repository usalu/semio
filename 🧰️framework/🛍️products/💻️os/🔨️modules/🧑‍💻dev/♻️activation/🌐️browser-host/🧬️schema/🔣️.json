{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/dev/activation/browser-host/component.json",
  "title": "Test Browser Host Staging Contracts",
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "GeneratedCoreV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "byteLength", "sha256"],
      "properties": {
        "relativePath": { "type": "string", "pattern": "^[^/\\\\\\u0000]+\\.wasm$" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 805306368 },
        "sha256": { "$ref": "#/$defs/Sha256Digest" }
      }
    },
    "TestBrowserGisMaterializationV1": {
      "title": "Selected GIS Browser Materialization Receipt",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "pluginId", "componentSha256", "descriptorSha256", "stagedDescriptorSha256", "bridgeSha256", "generatedCores"],
      "properties": {
        "schema": { "const": "semio.os.test-browser-host-gis-materialization/v1" },
        "pluginId": { "const": "gis" },
        "componentSha256": { "$ref": "#/$defs/Sha256Digest" },
        "descriptorSha256": { "$ref": "#/$defs/Sha256Digest" },
        "stagedDescriptorSha256": { "$ref": "#/$defs/Sha256Digest" },
        "bridgeSha256": { "$ref": "#/$defs/Sha256Digest" },
        "generatedCores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/GeneratedCoreV1" }
        }
      }
    },
    "TestBrowserGisProvenanceFixtureV1": {
      "title": "Selected GIS Browser Provenance Fixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "specimens", "hostiles"],
      "properties": {
        "schema": { "const": "semio.os.test-browser-host-gis-provenance-fixture/v1" },
        "specimens": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "utf8", "sha256"],
            "properties": {
              "id": { "enum": ["selected-component", "selected-descriptor", "staged-core", "staged-bridge"] },
              "utf8": { "type": "string", "minLength": 1, "maxLength": 64 },
              "sha256": { "$ref": "#/$defs/Sha256Digest" }
            }
          }
        },
        "hostiles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "target", "replacement", "recomputeModuleSet", "outcome"],
            "properties": {
              "id": { "enum": ["selected-component-receipt-hash", "staged-gis-descriptor", "staged-gis-bridge"] },
              "target": { "enum": ["host-receipt", "staged-descriptor", "staged-bridge"] },
              "replacement": { "type": "string", "minLength": 1, "maxLength": 128 },
              "recomputeModuleSet": { "type": "boolean" },
              "outcome": { "const": "refused" }
            }
          }
        }
      }
    },
    "TestBrowserHostStagingV1": {
      "title": "Test Browser Host Staging Receipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "variant",
        "profile",
        "moduleSetSha256",
        "activationReceiptSha256",
        "host",
        "selectedGis"
      ],
      "properties": {
        "schema": {
          "const": "semio.os.test-browser-host-staging/v1"
        },
        "variant": {
          "const": "s"
        },
        "profile": {
          "const": "dev"
        },
        "moduleSetSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "activationReceiptSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pluginId",
            "componentByteLength",
            "componentSha256",
            "coreSha256",
            "descriptorSha256"
          ],
          "properties": {
            "pluginId": {
              "const": "space"
            },
            "componentByteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "componentSha256": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "coreSha256": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "descriptorSha256": {
              "$ref": "#/$defs/Sha256Digest"
            }
          }
        },
        "selectedGis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generationId",
            "currentSha256",
            "componentSha256",
            "descriptorSha256",
            "stagedDescriptorSha256",
            "bridgeSha256",
            "generatedCores",
            "materializationReceiptSha256"
          ],
          "properties": {
            "generationId": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "currentSha256": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "componentSha256": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "descriptorSha256": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "stagedDescriptorSha256": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "bridgeSha256": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "generatedCores": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/GeneratedCoreV1" }
            },
            "materializationReceiptSha256": {
              "$ref": "#/$defs/Sha256Digest"
            }
          }
        }
      }
    }
  }
}
