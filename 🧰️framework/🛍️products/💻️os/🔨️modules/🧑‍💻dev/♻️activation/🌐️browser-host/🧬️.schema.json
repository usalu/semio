{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.os.test-browser-host-staging/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "variant", "profile", "moduleSetSha256", "activationReceiptSha256", "host", "selectedGis"],
  "properties": {
    "schema": { "const": "semio.os.test-browser-host-staging/v1" },
    "variant": { "const": "s" },
    "profile": { "const": "dev" },
    "moduleSetSha256": { "$ref": "#/$defs/digest" },
    "activationReceiptSha256": { "$ref": "#/$defs/digest" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "componentSha256", "descriptorSha256"],
      "properties": {
        "pluginId": { "const": "space" },
        "componentSha256": { "$ref": "#/$defs/digest" },
        "descriptorSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "selectedGis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationId", "currentSha256"],
      "properties": {
        "generationId": { "$ref": "#/$defs/digest" },
        "currentSha256": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
