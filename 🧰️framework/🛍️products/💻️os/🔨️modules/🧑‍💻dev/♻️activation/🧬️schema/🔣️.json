{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/dev/activation/component.json",
  "title": "Development Activation Contracts",
  "$defs": {
    "DevActivationV1": {
      "title": "Completed Development Activation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "variant",
        "profile",
        "plugins"
      ],
      "properties": {
        "schema": {
          "const": "semio.dev.activation/v1"
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "profile": {
          "enum": [
            "dev",
            "release"
          ]
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pluginId",
              "artifactSha256",
              "rebuiltAt"
            ],
            "properties": {
              "pluginId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "artifactSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "rebuiltAt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sourceContentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 of the plugin-owner source tree used when this receipt row was published"
              }
            }
          }
        }
      }
    },
    "SourceStatIndexV1": {
      "title": "Staged Plugin Source Stat Index",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contentSha256",
        "files"
      ],
      "properties": {
        "schema": {
          "const": "semio.dev.source-stat-index/v1"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Aggregate SHA-256 of relative paths and file bytes (same digest as componentSourceContentHash)"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "mtimeNs",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Repo-relative POSIX path under the plugin owner root"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mtimeNs": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "description": "Nanosecond mtime as a decimal string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
