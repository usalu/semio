{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "owner",
    "manifestSha256"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "owner": {
      "const": "os:distribution-witness"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "owner": "os:distribution-witness",
        "scratchOwner": "os/distribution-compile",
        "parentScratchOwner": "os/distribution-plan",
        "maximumReceiptBytes": 1024
      }
    }
  }
}
