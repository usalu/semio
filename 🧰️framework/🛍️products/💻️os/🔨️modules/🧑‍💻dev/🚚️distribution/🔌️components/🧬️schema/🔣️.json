{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/os/dev/distribution/browser-components/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "components"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "profile": {
      "enum": [
        "dev",
        "release"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pluginId",
          "role",
          "cratePath"
        ],
        "properties": {
          "pluginId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 128
          },
          "role": {
            "enum": [
              "plugin",
              "extension"
            ]
          },
          "cratePath": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\/\\u0000-\\u001f\\u007f:]+(?:/[^\\\\/\\u0000-\\u001f\\u007f:]+)*$"
          }
        }
      }
    }
  }
}
