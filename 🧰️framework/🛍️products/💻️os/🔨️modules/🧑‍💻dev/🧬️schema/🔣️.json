{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/dev/component.json",
  "title": "Development Product Contracts",
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "WasiProfileDirectory": {
      "enum": [
        "wasm-dev",
        "wasm-release"
      ]
    },
    "CanonicalBootstrapFolderMirrorFrontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainSha256"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "headEditOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "headEditId": {
          "type": "string",
          "minLength": 1
        },
        "lastCommitSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chainSha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      }
    },
    "CanonicalBootstrapFolderMirrorPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "packHex",
        "sprHex",
        "aggregateSha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "a",
            "b"
          ]
        },
        "packHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})+$"
        },
        "sprHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})+$"
        },
        "aggregateSha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      }
    },
    "LinkedSessionEnginesV1": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "engine"
        ],
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^(?:@[a-z0-9-]+/)?[a-z0-9][a-z0-9._-]*$"
          },
          "engine": {
            "type": "string",
            "pattern": "^\\./(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00-\\x1f])[^/]+(?:/[^/]+)+$"
          }
        }
      }
    },
    "BuildInspectionV1": {
      "title": "Build Inspection Records",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "fileName",
          "bytes",
          "sha256",
          "facadeModuleId",
          "imports",
          "dynamicImports",
          "modules",
          "originalFileNames",
          "names"
        ],
        "properties": {
          "type": {
            "enum": [
              "chunk",
              "asset"
            ]
          },
          "fileName": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "facadeModuleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dynamicImports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "originalFileNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "CatalogSmokeReportV1": {
      "title": "Catalog Smoke Report",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "shellPluginId",
        "startedAt",
        "durationMs",
        "boot",
        "programs",
        "failedPlugins",
        "totals"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "minLength": 1
        },
        "shellPluginId": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "boot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "beacon",
            "failure",
            "phaseMs",
            "bodyExcerpt",
            "consoleErrors"
          ],
          "properties": {
            "beacon": {
              "type": [
                "string",
                "null"
              ]
            },
            "failure": {
              "type": [
                "string",
                "null"
              ]
            },
            "phaseMs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commit",
                "firstModule",
                "beacon"
              ],
              "properties": {
                "commit": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "firstModule": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "beacon": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            },
            "bodyExcerpt": {
              "type": "string",
              "maxLength": 1000
            },
            "consoleErrors": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pluginId",
              "appId",
              "label",
              "status",
              "durationMs",
              "windowId",
              "descendants",
              "width",
              "height",
              "firstError"
            ],
            "properties": {
              "pluginId": {
                "type": "string",
                "minLength": 1
              },
              "appId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "skipped"
                ]
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              },
              "windowId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "descendants": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "type": "integer",
                "minimum": 0
              },
              "firstError": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "failedPlugins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pluginId",
              "status"
            ],
            "properties": {
              "pluginId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "failed",
                  "crashed"
                ]
              }
            }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "fail",
            "skipped"
          ],
          "properties": {
            "pass": {
              "type": "integer",
              "minimum": 0
            },
            "fail": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "DevHubLeaseV1": {
      "description": "One claim on a development hub: the owner process that holds a hub port and its data root. A claim whose process is gone is stale and may be taken over; a live one means the hub is owned even before it has bound its port.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "port",
        "dataDir",
        "hubUrl",
        "acquiredAt"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dataDir": {
          "type": "string",
          "minLength": 1
        },
        "hubUrl": {
          "type": "string",
          "pattern": "^https?://[^/]+$"
        },
        "acquiredAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "DevHubCatalogHeaderV1": {
      "description": "The part of a development hub's current trusted-catalog generation (`trusted-catalog/generations/<id>/trusted-catalog.json`) the dev hub owner reads before it boots the hub: the catalog format version the hub loads and the package record keys that format requires. A generation outside it was written by an older publisher and is republished instead of crashing the hub (`ArtifactAuthority(Catalog(\"missing field pluginModule\"))`, 26/09/23). Twins: `🌎️hub/📦️packages/🦀️rust/📜️script.ts` `materializeTrustedCatalogBundle`, `🌎️hub/🗿️artifact-authority/🔏️trusted-catalog/🦀️.rs` schema version check.",
      "type": "object",
      "required": [
        "schemaVersion",
        "profiles",
        "packages"
      ],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "profiles": {
          "type": "array",
          "minItems": 1
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "pluginId",
              "packageId",
              "version",
              "role",
              "dependencies",
              "component",
              "descriptor",
              "executionProtocol",
              "browserActor",
              "pluginModule",
              "nativeCodecs",
              "openTargets"
            ],
            "properties": {
              "pluginId": {
                "type": "string",
                "minLength": 1
              },
              "packageId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "array"
              },
              "component": {
                "type": "object"
              },
              "descriptor": {
                "type": "object"
              },
              "executionProtocol": {
                "type": "object"
              },
              "browserActor": {
                "type": "object"
              },
              "pluginModule": {
                "type": "object"
              },
              "nativeCodecs": {
                "type": "array"
              },
              "openTargets": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    "DevHubCatalogPointerV1": {
      "description": "`trusted-catalog/current.json` as far as the dev hub owner reads it: which generation is current.",
      "type": "object",
      "required": [
        "generationId"
      ],
      "properties": {
        "generationId": {
          "$ref": "#/$defs/Sha256Digest"
        }
      }
    },
    "DevServeSpawnRequestV1": {
      "description": "What the shared serve fixture `ensureDevServe` asks its world to start: one shell serve (`react` = the 🧑‍💻dev `serve <variant> react <profile>`, `wgpu` = the wgpu browser server `serve <variant> <profile> --port <port>`) on a loopback port that is never the canonical hub's, local-only when `hubUrl` is null, otherwise joined to that hub; output goes to `logPath`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "variant",
        "renderer",
        "profile",
        "hubUrl",
        "logPath"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "not": {
            "const": 7800
          }
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "renderer": {
          "enum": [
            "react",
            "wgpu"
          ]
        },
        "profile": {
          "enum": [
            "dev",
            "release"
          ]
        },
        "hubUrl": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^https?://[^/]+$"
            }
          ]
        },
        "logPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ProgramMatrixRenderedEditV1": {
      "description": "A program-matrix verb driven through the program's own rendered editor instead of the Actions rail: a revision-bound verb (`set-cell`, `set-node`) needs the document revision the render stamped into the control's binding, which no staged rail argument can know. The harness types `value` into the inline commit-on-blur input `control` (a selector inside the window body) and commits it with Enter, as a user does.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "value"
      ],
      "properties": {
        "control": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "ProgramMatrixPinsV1": {
      "description": "The program matrix's pins (`🧫️fixtures/🧮️program-matrix.json`): the verb each plugin / kind (`<plugin>/<kind>[/<subset>]`) is driven with, its staged rail arguments or its rendered edit (keyed `<plugin|kind>.<verb>`), pre-verbs (`!` = staged and submitted), the origin plugin of re-hosted kinds, and the hub sweep's kind verbs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "liveId",
        "excludedKinds",
        "pluginVerbs",
        "pluginArgs",
        "kindVerbs",
        "kindPre",
        "kindArgs",
        "pluginEdits",
        "kindEdits",
        "kindOrigin",
        "hubKindVerbs",
        "hubKindPre"
      ],
      "properties": {
        "schema": {
          "const": "semio.os-dev.program-matrix-pins/v1"
        },
        "liveId": {
          "type": "string",
          "pattern": "^@"
        },
        "excludedKinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "pluginVerbs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pluginArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*(/[a-z0-9-]+)*\\.[A-Za-z][A-Za-z0-9-]*$"
          }
        },
        "kindVerbs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "kindPre": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*!?$"
          }
        },
        "kindArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*(/[a-z0-9-]+)*\\.[A-Za-z][A-Za-z0-9-]*$"
          }
        },
        "pluginEdits": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*(/[a-z0-9-]+)*\\.[A-Za-z][A-Za-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ProgramMatrixRenderedEditV1"
          }
        },
        "kindEdits": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*(/[a-z0-9-]+)*\\.[A-Za-z][A-Za-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ProgramMatrixRenderedEditV1"
          }
        },
        "kindOrigin": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hubKindVerbs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hubKindPre": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "InteractionLatencyScenarioV1": {
      "description": "One interaction the latency gate (`verify latency`) drives in the served s shell: the program it opens from Home, the window (id suffix, empty = the first window the program opened) and the target inside its body, the gesture (`type`: keys; `drag`: a pressed pointer; `hover`: the pointer alternately onto a point whose hover the target paints into `hoverAttribute`, and off it), and the bounds: paints and React commits per input always judged, p95 input → frame only under the load ceiling.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pluginId",
        "appId",
        "window",
        "target",
        "action",
        "inputs",
        "intervalMs",
        "maxP95Ms",
        "maxPaintsPerInput"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string",
          "pattern": "^s\\.[^.]+\\.[^@]+@"
        },
        "window": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "type",
            "drag",
            "hover"
          ]
        },
        "hoverAttribute": {
          "type": "string",
          "pattern": "^data-"
        },
        "inputs": {
          "type": "integer",
          "minimum": 1
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxP95Ms": {
          "type": "number",
          "minimum": 0
        },
        "maxPaintsPerInput": {
          "type": "number",
          "minimum": 0
        },
        "maxCommitsPerInput": {
          "type": "number",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "hover"
          }
        }
      },
      "then": {
        "required": [
          "hoverAttribute"
        ]
      }
    },
    "InteractionLatencyScenariosV1": {
      "description": "The latency gate's scenarios (`🧫️fixtures/⏱️interaction-latency.json`) and the per-core load ceiling above which timings are not judged.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "description",
        "loadCeilingPerCore",
        "scenarios"
      ],
      "properties": {
        "schema": {
          "const": "semio.os-dev.interaction-latency-scenarios/v1"
        },
        "description": {
          "type": "string"
        },
        "loadCeilingPerCore": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/InteractionLatencyScenarioV1"
          }
        }
      }
    },
    "BootPayloadByKindV1": {
      "description": "Count, transferred and decoded megabytes per boot resource kind (every kind present).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "json",
        "font",
        "style",
        "wasm",
        "other"
      ],
      "properties": {
        "module": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "transferMB",
            "decodedMB"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "transferMB": {
              "type": "number",
              "minimum": 0
            },
            "decodedMB": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "transferMB",
            "decodedMB"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "transferMB": {
              "type": "number",
              "minimum": 0
            },
            "decodedMB": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "transferMB",
            "decodedMB"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "transferMB": {
              "type": "number",
              "minimum": 0
            },
            "decodedMB": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "transferMB",
            "decodedMB"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "transferMB": {
              "type": "number",
              "minimum": 0
            },
            "decodedMB": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "wasm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "transferMB",
            "decodedMB"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "transferMB": {
              "type": "number",
              "minimum": 0
            },
            "decodedMB": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "other": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "transferMB",
            "decodedMB"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "transferMB": {
              "type": "number",
              "minimum": 0
            },
            "decodedMB": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
