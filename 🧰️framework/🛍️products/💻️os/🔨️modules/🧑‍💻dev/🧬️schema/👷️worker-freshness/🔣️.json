{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module Worker Export Freshness on Navigation",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "before", "after"],
  "properties": {
    "version": { "const": 1 },
    "before": { "$ref": "#/$defs/export" },
    "after": { "$ref": "#/$defs/export" }
  },
  "$defs": {
    "export": {
      "type": "object", "additionalProperties": false, "required": ["name", "value"],
      "properties": { "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }, "value": { "type": "string", "minLength": 1 } }
    }
  }
}
