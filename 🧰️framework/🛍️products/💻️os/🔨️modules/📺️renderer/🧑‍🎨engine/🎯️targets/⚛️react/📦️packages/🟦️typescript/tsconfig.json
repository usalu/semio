{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "DOM",
      "DOM.AsyncIterable",
      "DOM.Iterable",
      "ESNext"
    ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "noEmit": true,
    "types": [
      "react",
      "react-dom",
      "vite/client",
      "bun"
    ]
  },
  "include": [
    "../../**/*.ts",
    "../../**/*.tsx",
    "../../../../🧱️elements/**/*.ts",
    "../../../../🧱️elements/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "./📜️script.ts",
    "**/📜️script.ts",
    "../../**/📜️script.ts",
    "**/*.mjs",
    "../../../../../../**/✏️s/**",
    "../../../../../../**/♻️mit-bestand/**"
  ]
}
