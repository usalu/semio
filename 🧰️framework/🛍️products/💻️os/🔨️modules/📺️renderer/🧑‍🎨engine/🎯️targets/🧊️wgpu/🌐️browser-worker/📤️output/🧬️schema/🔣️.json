{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.renderer.original-frame-output/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caller",
    "copies",
    "wire"
  ],
  "properties": {
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "generation",
        "clockUs",
        "deadlineUs",
        "fuel",
        "stock"
      ],
      "properties": {
        "operation": {
          "const": 71
        },
        "generation": {
          "const": 3
        },
        "clockUs": {
          "const": 12000
        },
        "deadlineUs": {
          "const": 12345
        },
        "fuel": {
          "type": "integer",
          "minimum": 0
        },
        "stock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 0
            },
            "maximumCopyBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "copies": {
      "const": [
        1,
        3,
        64
      ]
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentationGeneration",
        "mediaSlots",
        "cursor",
        "fullscreen",
        "requestFrame",
        "nextDeadlineDelayMs",
        "continueFrame",
        "progress",
        "quarantined",
        "faultCode",
        "faultDetail"
      ],
      "properties": {
        "presentationGeneration": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "mediaSlots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "token",
              "windowId",
              "nodeId",
              "nodeKey",
              "rect",
              "clip",
              "paintOrder",
              "occluded",
              "pluginId",
              "controllerId",
              "appInstanceId",
              "parentDocumentId",
              "props"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "windowId": {
                "type": "string"
              },
              "nodeId": {
                "type": "string"
              },
              "nodeKey": {
                "type": "string"
              },
              "rect": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                }
              },
              "clip": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                }
              },
              "paintOrder": {
                "type": "integer",
                "minimum": 0
              },
              "occluded": {
                "type": "boolean"
              },
              "pluginId": {
                "type": "string"
              },
              "controllerId": {
                "type": "string"
              },
              "appInstanceId": {
                "type": "integer",
                "minimum": 0
              },
              "parentDocumentId": {
                "type": "string"
              },
              "props": {
                "type": "object"
              }
            }
          }
        },
        "cursor": {
          "type": "string"
        },
        "fullscreen": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "requestFrame": {
          "type": "boolean"
        },
        "nextDeadlineDelayMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "continueFrame": {
          "type": "boolean"
        },
        "progress": {
          "type": "number"
        },
        "quarantined": {
          "type": "boolean"
        },
        "faultCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "faultDetail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
