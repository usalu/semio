{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "width",
    "height",
    "rgba",
    "denials",
    "custodyStages",
    "preserveSource",
    "fundClose"
  ],
  "properties": {
    "data": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "const": 3
    },
    "height": {
      "const": 2
    },
    "rgba": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "denials": {
      "type": "array",
      "items": {
        "enum": [
          "items",
          "copy",
          "depth",
          "work"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "custodyStages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "denials"],
        "properties": {
          "name": {"enum": ["decoded", "privateImage", "retiredDecoder"]},
          "denials": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"enum": ["items", "copy", "capacity", "depth", "work"]}
          }
        }
      }
    },
    "preserveSource": {
      "const": true
    },
    "fundClose": {
      "const": true
    }
  }
}
