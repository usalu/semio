{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://framework/presented-media-slots/v1",
  "title": "Presented Media Slot Contract",
  "type": "array",
  "maxItems": 32,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "token",
      "windowId",
      "nodeId",
      "nodeKey",
      "rect",
      "clip",
      "paintOrder",
      "pluginId",
      "controllerId",
      "appInstanceId",
      "parentDocumentId",
      "props",
      "occluded"
    ],
    "properties": {
      "token": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "windowId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "nodeKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "pluginId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "controllerId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "parentDocumentId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "nodeId": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0][0-9]|1844674407370955161[0-5])$"
      },
      "rect": {
        "$ref": "#/$defs/rect"
      },
      "clip": {
        "$ref": "#/$defs/rect"
      },
      "paintOrder": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31
      },
      "appInstanceId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "props": {
        "$ref": "semio://framework/media-transport/v1"
      },
      "occluded": {
        "type": "boolean"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "occluded": {
              "const": false
            }
          }
        },
        "then": {
          "properties": {
            "rect": {
              "properties": {
                "width": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "height": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              },
              "type": "object"
            },
            "clip": {
              "properties": {
                "width": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "height": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              },
              "type": "object"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
