{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fuel",
    "maximumElapsedMicroseconds",
    "grant",
    "retirementReserve"
  ],
  "properties": {
    "fuel": {
      "type": "integer",
      "minimum": 0
    },
    "maximumElapsedMicroseconds": {
      "type": "integer",
      "minimum": 1
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retirementReserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fuel",
        "grant"
      ],
      "properties": {
        "fuel": {
          "type": "integer",
          "minimum": 0
        },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 0
            },
            "maximumCopyBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "initiatingEventSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constructionClock",
        "firstEventClock",
        "secondEventClock",
        "birthBeforeEvent",
        "replacementWhileBorrowed",
        "policyDurationChanged",
        "sameStockRefill"
      ],
      "properties": {
        "constructionClock": {
          "const": 1000
        },
        "firstEventClock": {
          "const": 10000
        },
        "secondEventClock": {
          "const": 20000
        },
        "birthBeforeEvent": {
          "const": 0
        },
        "replacementWhileBorrowed": {
          "const": false
        },
        "policyDurationChanged": {
          "const": false
        },
        "sameStockRefill": {
          "const": false
        }
      }
    },
    "productionEventPolicy": {
      "const": {
        "fuel": 67108864,
        "maximumElapsedMicroseconds": 30000000,
        "grant": {
          "maximumItems": 33554432,
          "maximumCopyBytes": 536870912,
          "maximumCapacityBytes": 268435456,
          "maximumReleaseBytes": 536870912,
          "maximumDepth": 256
        },
        "retirementReserve": {
          "fuel": 8388608,
          "grant": {
            "maximumItems": 4194304,
            "maximumCopyBytes": 8388608,
            "maximumCapacityBytes": 4194304,
            "maximumReleaseBytes": 268435456,
            "maximumDepth": 256
          }
        }
      }
    },
    "expiryRetirement": {
      "const": {
        "semanticDenied": true,
        "sourceAdmissionDenied": true,
        "clockUnchanged": true,
        "deadlineUnchanged": true,
        "sourceLoanReturnPaid": true,
        "rootClosePaid": true,
        "stockRefill": false
      }
    },
    "productionReceivingBound": {
      "const": {
        "geometryBytes": 16777216,
        "minimumFieldItemBytes": 4,
        "geometryStepsPerItem": 2,
        "componentDomains": 3,
        "maximumComponentsPerDomain": 600000,
        "labelStepsPerComponent": 4,
        "metadataSteps": 65536
      }
    },
    "clockAuthority": {
      "const": {
        "mintOnlyOnActualSource": true,
        "opaqueBinding": true,
        "functionAddressSerialized": false,
        "mismatchReturnsNoClock": true,
        "continuationKeepsBinding": true,
        "sourceReturnDisarmsClock": true,
        "totalFuelSurvivesBusinessView": true,
        "absoluteDeadlineSurvivesBusinessView": true,
        "cleanupUsesInitialReserve": true
      }
    }
  }
}
