{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "refusals",
    "lifecycle",
    "observation",
    "fontPackages",
    "fontBuildDirectories",
    "rendererPackages",
    "domainPackages"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "manifest",
          "name",
          "raw",
          "binding",
          "optimized",
          "expectedCargo",
          "expectedBindgen",
          "expectedOptimizer"
        ],
        "properties": {
          "mode": {
            "enum": [
              "prototype",
              "release"
            ]
          },
          "manifest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "raw": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "binding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "optimized": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expectedCargo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedBindgen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedOptimizer": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "cancel",
          "events"
        ],
        "properties": {
          "mode": {
            "enum": [
              "prototype",
              "release"
            ]
          },
          "cancel": {
            "type": "boolean"
          },
          "events": {
            "type": "array",
            "items": {
              "enum": [
                "products",
                "lane",
                "compile",
                "lane-close",
                "products-close"
              ]
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "identity",
        "expected",
        "invalid"
      ],
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "invalid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fontPackages": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "name"
        ],
        "properties": {
          "manifest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45,
            "pattern": "^semio-font-[a-z0-9-]+$"
          }
        }
      }
    },
    "fontBuildDirectories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posix",
        "win32"
      ],
      "properties": {
        "posix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "win32": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "rendererPackages": {
      "type": "array",
      "minItems": 97,
      "maxItems": 97,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "name"
        ],
        "properties": {
          "manifest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 42,
            "pattern": "^semio-renderer-[a-z0-9-]+$"
          }
        }
      }
    },
    "domainPackages": {
      "type": "array",
      "minItems": 315,
      "maxItems": 315,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "name"
        ],
        "properties": {
          "manifest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 39,
            "pattern": "^semio-(os|ui|plugin)(-[a-z0-9-]+)?$"
          }
        }
      }
    }
  }
}
