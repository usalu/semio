{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.renderer.original-frame/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "generation",
    "presentation",
    "deadlineUs",
    "fuel",
    "grant",
    "deltas",
    "closeStages",
    "failure"
  ],
  "properties": {
    "operation": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "presentation": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "deadlineUs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "fuel": {
      "type": "integer",
      "minimum": 0
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deltas": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "copiedItems",
          "copiedBytes",
          "retainedCapacityBytes",
          "releasedBytes"
        ],
        "properties": {
          "copiedItems": {
            "type": "integer",
            "minimum": 0
          },
          "copiedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "retainedCapacityBytes": {
            "type": "integer",
            "minimum": 0
          },
          "releasedBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "closeStages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": [
        {
          "const": "frame"
        },
        {
          "const": "assets"
        },
        {
          "const": "world"
        },
        {
          "const": "hostTerminal"
        },
        {
          "const": "context"
        },
        {
          "const": "contextTerminal"
        }
      ],
      "additionalItems": false
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "nativeStatus",
        "bytes",
        "acknowledgement",
        "publication"
      ],
      "properties": {
        "format": {
          "const": "pack"
        },
        "nativeStatus": {
          "const": 2
        },
        "bytes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "acknowledgement": {
          "const": "originalDescriptor"
        },
        "publication": {
          "const": "afterNativeFullClose"
        }
      }
    }
  }
}
