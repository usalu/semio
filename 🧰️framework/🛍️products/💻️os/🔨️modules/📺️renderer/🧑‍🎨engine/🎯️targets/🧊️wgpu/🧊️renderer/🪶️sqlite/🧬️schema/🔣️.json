{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifactSchema",
    "dialect",
    "extension",
    "sql",
    "cases",
    "large",
    "edit",
    "invalidUtf8",
    "malformed",
    "callerGrant"
  ],
  "properties": {
    "schema": {
      "const": "semio.native-socket-probe.sqlite.v1"
    },
    "artifactSchema": {
      "const": "native.socket-grant.probe/v1"
    },
    "dialect": {
      "const": "native.socket-grant.probe@1/*"
    },
    "extension": {
      "const": "native-socket-probe"
    },
    "sql": {
      "const": "CREATE TABLE socket_probe (id INTEGER PRIMARY KEY CHECK (id = 1), text TEXT NOT NULL);\n"
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "utf8Bytes",
          "valueBytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "utf8Bytes": {
            "type": "integer",
            "minimum": 0
          },
          "valueBytes": {
            "type": "integer",
            "minimum": 8
          }
        }
      }
    },
    "large": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "repetitions",
        "utf8Bytes",
        "valueBytes",
        "cancelThreshold"
      ],
      "properties": {
        "unit": {
          "const": "λ🙂"
        },
        "repetitions": {
          "const": 24576
        },
        "utf8Bytes": {
          "const": 147456
        },
        "valueBytes": {
          "const": 147464
        },
        "cancelThreshold": {
          "const": 32768
        }
      }
    },
    "edit": {
      "const": "independent λ🙂\u0000 edit"
    },
    "invalidUtf8": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "malformed": {
      "type": "array",
      "items": {
        "enum": [
          "missingRow",
          "multipleRows",
          "wrongRowid",
          "wrongIdentity",
          "nullText",
          "extraCell"
        ]
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "callerGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
