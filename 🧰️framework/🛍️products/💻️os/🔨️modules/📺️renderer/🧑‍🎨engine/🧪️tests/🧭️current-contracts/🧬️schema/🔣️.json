{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "spacing",
    "presses",
    "labels"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "spacing": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "multiplier",
          "expectedCss"
        ],
        "properties": {
          "id": {
            "enum": [
              "empty-space",
              "small-space",
              "medium-space"
            ]
          },
          "multiplier": {
            "enum": [
              0,
              1,
              4
            ]
          },
          "expectedCss": {
            "type": "string",
            "pattern": "^calc\\([014] \\* var\\(--ui-spacing\\)\\)$"
          }
        }
      }
    },
    "presses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "clockMs",
          "keys",
          "expectedSerialSteps",
          "expectedUnique"
        ],
        "properties": {
          "id": {
            "enum": [
              "repeated-widget",
              "distinct-widgets"
            ]
          },
          "clockMs": {
            "type": "integer",
            "minimum": 0
          },
          "keys": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expectedSerialSteps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "const": 1
            }
          },
          "expectedUnique": {
            "const": true
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "locale",
          "language",
          "expected"
        ],
        "properties": {
          "id": {
            "enum": [
              "english-placeholder",
              "german-placeholder",
              "english-language",
              "german-language"
            ]
          },
          "locale": {
            "enum": [
              "en",
              "de"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
