      "blocked": true,
      "attachmentMismatch": "none"
    },
    {
      "id": "different-app-is-not-attachment",
      "artifact": true,
      "attached": true,
      "status": "saved",
      "blocked": true,
      "attachmentMismatch": "app"
    },
    {
      "id": "different-instance-is-not-attachment",
      "artifact": true,
      "attached": true,
      "status": "saved",
      "blocked": true,
      "attachmentMismatch": "instance"
    }
  ]
}
