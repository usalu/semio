{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "locale",
          "labels",
          "staged",
          "defaults",
          "expectedReason",
          "expectedDisabled",
          "expectedDispatch"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "enum": [
              "en",
              "de"
            ]
          },
          "labels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "staged": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "depth": {
                "type": "number"
              },
              "segments": {
                "type": "number"
              }
            }
          },
          "defaults": {
            "type": "boolean"
          },
          "expectedReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "expectedDisabled": {
            "type": "boolean"
          },
          "expectedDispatch": {
            "type": "boolean"
          }
        }
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "en-missing"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "en-partial"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "en-ready"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "en-default"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "de-missing"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "de-partial"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "de-ready"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "de-default"
              }
            }
          }
        }
      ]
    }
  }
}
