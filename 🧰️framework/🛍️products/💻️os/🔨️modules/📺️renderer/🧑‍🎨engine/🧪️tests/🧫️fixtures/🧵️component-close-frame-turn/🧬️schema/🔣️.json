{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "closeHost",
    "liveHost",
    "maxCloseUnitsPerTurn",
    "turns",
    "expected"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "semio.component-close-frame-turn.v2"
    },
    "closeHost": {
      "type": "string",
      "minLength": 1
    },
    "liveHost": {
      "type": "string",
      "minLength": 1
    },
    "maxCloseUnitsPerTurn": {
      "const": 1
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "closeOutcome",
          "inputSequence",
          "snapshotRevision"
        ],
        "properties": {
          "closeOutcome": {
            "enum": [
              "frameRetirement",
              "externalWait",
              "terminal"
            ]
          },
          "inputSequence": {
            "type": "integer",
            "minimum": 0
          },
          "snapshotRevision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closeTerminal",
        "liveInputSequences",
        "publishedSnapshotRevisions",
        "closingHostPublications",
        "sameGenerationReadmitted"
      ],
      "properties": {
        "closeTerminal": {
          "type": "boolean"
        },
        "liveInputSequences": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "publishedSnapshotRevisions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "closingHostPublications": {
          "type": "array",
          "maxItems": 0
        },
        "sameGenerationReadmitted": {
          "type": "boolean"
        }
      }
    }
  }
}
