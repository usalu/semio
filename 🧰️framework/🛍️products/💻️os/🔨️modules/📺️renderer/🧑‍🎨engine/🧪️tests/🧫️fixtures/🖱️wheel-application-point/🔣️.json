{
  "schema": "framework.wgpu.wheel-application-point/v2",
  "$comment": "🖱️ A browser wheel receiver publishes one owned Scroll dispatch per admitted DOM WheelEvent. The dispatch retains that event's point, horizontal and vertical deltas, and four modifier flags. A later pointer move, another wheel at the same point, an opposite wheel, or a long burst cannot rewrite, merge, cancel, or relocate an admitted dispatch.",
  "rule": {
    "id": "ownedScrollDispatch",
    "statement": "Every admitted Scroll event produces exactly one ordered owned dispatch with its own point, deltaX, deltaY, and modifier snapshot.",
    "producer": "🎯️targets/🧊️wgpu/🪟️ui-host/🟦️.ts::wheel event receiver",
    "consumer": "🎯️targets/🧊️wgpu/🧊️renderer/🦀️.rs::DispatchEvent::Scroll",
    "ticket": "26/09/17/WGPU-RENDERER-REACT-PARITY"
  },
  "cases": [
    {
      "name": "one-notch-dispatches-at-its-own-point",
      "why": "The baseline preserves one DOM wheel sample without projection or coalescing.",
      "events": [
        { "kind": "scroll", "x": 1207.5, "y": 461, "deltaX": 0, "deltaY": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ],
      "applications": [
        { "x": 1207.5, "y": 461, "deltaX": 0, "delta": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ]
    },
    {
      "name": "a-later-pointer-move-does-not-move-or-merge-admitted-scrolls",
      "why": "Four wheels over the preview remain four dispatches at the preview even when a later pointer move wakes the input-driven frame at the opposite corner.",
      "events": [
        { "kind": "scroll", "x": 1207.5, "y": 461, "deltaX": 0, "deltaY": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "scroll", "x": 1207.5, "y": 461, "deltaX": 0, "deltaY": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "scroll", "x": 1207.5, "y": 461, "deltaX": 0, "deltaY": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "scroll", "x": 1207.5, "y": 461, "deltaX": 0, "deltaY": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "pointer-move", "x": 5, "y": 5 }
      ],
      "applications": [
        { "x": 1207.5, "y": 461, "deltaX": 0, "delta": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 1207.5, "y": 461, "deltaX": 0, "delta": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 1207.5, "y": 461, "deltaX": 0, "delta": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 1207.5, "y": 461, "deltaX": 0, "delta": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ],
      "supersededApplication": { "x": 5, "y": 5, "deltaX": 0, "delta": -480, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
    },
    {
      "name": "notches-at-three-points-remain-three-dispatches",
      "why": "A wheel stream travelling from the preview to two corner points preserves every sample's own anchor.",
      "events": [
        { "kind": "scroll", "x": 1207.5, "y": 461, "deltaX": 0, "deltaY": 200, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "pointer-move", "x": 3, "y": 3 },
        { "kind": "scroll", "x": 3, "y": 3, "deltaX": 0, "deltaY": 200, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "pointer-move", "x": 4, "y": 4 },
        { "kind": "scroll", "x": 4, "y": 4, "deltaX": 0, "deltaY": 200, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ],
      "applications": [
        { "x": 1207.5, "y": 461, "deltaX": 0, "delta": 200, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 3, "y": 3, "deltaX": 0, "delta": 200, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 4, "y": 4, "deltaX": 0, "delta": 200, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ],
      "supersededApplication": { "x": 4, "y": 4, "deltaX": 0, "delta": 600, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
    },
    {
      "name": "a-travelling-wheel-stream-preserves-each-sample",
      "why": "Trackpad momentum under a moving cursor remains two ordered dispatches rather than one application at the end of the travel.",
      "events": [
        { "kind": "scroll", "x": 100, "y": 100, "deltaX": 0, "deltaY": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "pointer-move", "x": 140, "y": 160 },
        { "kind": "scroll", "x": 140, "y": 160, "deltaX": 0, "deltaY": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ],
      "applications": [
        { "x": 100, "y": 100, "deltaX": 0, "delta": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 140, "y": 160, "deltaX": 0, "delta": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ],
      "supersededApplication": { "x": 140, "y": 160, "deltaX": 0, "delta": 80, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
    },
    {
      "name": "a-stationary-burst-remains-three-owned-dispatches",
      "why": "Event ownership is per admitted sample even when every coordinate is identical.",
      "events": [
        { "kind": "scroll", "x": 640, "y": 400, "deltaX": 0, "deltaY": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "scroll", "x": 640, "y": 400, "deltaX": 0, "deltaY": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "scroll", "x": 640, "y": 400, "deltaX": 0, "deltaY": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ],
      "applications": [
        { "x": 640, "y": 400, "deltaX": 0, "delta": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 640, "y": 400, "deltaX": 0, "delta": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 640, "y": 400, "deltaX": 0, "delta": 40, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ]
    },
    {
      "name": "opposite-notches-remain-two-ordered-dispatches",
      "why": "Opposite wheel samples are two browser events and must not cancel before the renderer applies each factor.",
      "events": [
        { "kind": "scroll", "x": 300, "y": 220, "deltaX": 0, "deltaY": 120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "kind": "scroll", "x": 300, "y": 220, "deltaX": 0, "deltaY": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ],
      "applications": [
        { "x": 300, "y": 220, "deltaX": 0, "delta": 120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } },
        { "x": 300, "y": 220, "deltaX": 0, "delta": -120, "modifiers": { "shift": false, "ctrl": false, "meta": false, "alt": false } }
      ]
    },
    {
      "name": "horizontal-delta-and-modifiers-belong-to-each-event",
      "why": "Two samples at one point keep distinct horizontal deltas and modifier snapshots.",
      "events": [
        { "kind": "scroll", "x": 512.25, "y": 384.5, "deltaX": 24, "deltaY": -80, "modifiers": { "shift": true, "ctrl": false, "meta": false, "alt": true } },
        { "kind": "scroll", "x": 512.25, "y": 384.5, "deltaX": -8, "deltaY": 30, "modifiers": { "shift": false, "ctrl": true, "meta": true, "alt": false } }
      ],
      "applications": [
        { "x": 512.25, "y": 384.5, "deltaX": 24, "delta": -80, "modifiers": { "shift": true, "ctrl": false, "meta": false, "alt": true } },
        { "x": 512.25, "y": 384.5, "deltaX": -8, "delta": 30, "modifiers": { "shift": false, "ctrl": true, "meta": true, "alt": false } }
      ]
    },
    {
      "name": "pointer-events-alone-dispatch-no-scroll",
      "why": "Moving the pointer cannot invent a Scroll dispatch.",
      "events": [
        { "kind": "pointer-move", "x": 700, "y": 400 },
        { "kind": "pointer-move", "x": 5, "y": 5 }
      ],
      "applications": []
    }
  ]
}
