{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "presentedChrome", "settingsTabStrip", "transportCredits"],
  "properties": {
    "schema": { "const": "semio.renderer.wgpu.accessibility-interaction.v1" },
    "presentedChrome": {
      "type": "object",
      "required": ["firstEpoch", "successorEpoch", "controls", "generationRule"],
      "properties": {
        "firstEpoch": { "type": "integer", "minimum": 1 },
        "successorEpoch": { "type": "integer", "minimum": 1 },
        "controls": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/namedId" } },
        "generationRule": {
          "type": "object",
          "required": ["controlId", "firstRect", "sameChromeRect", "changedChromeRect"],
          "properties": {
            "controlId": { "type": "string", "minLength": 1 },
            "firstRect": { "$ref": "#/$defs/rect" },
            "sameChromeRect": { "$ref": "#/$defs/rect" },
            "changedChromeRect": { "$ref": "#/$defs/rect" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "settingsTabStrip": {
      "type": "object",
      "required": ["availableWidth", "activeId", "tabs", "tailIds"],
      "properties": {
        "availableWidth": { "type": "number", "exclusiveMinimum": 0 },
        "activeId": { "type": "string", "minLength": 1 },
        "tabs": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/namedId" } },
        "tailIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "transportCredits": {
      "type": "object",
      "description": "Addresses the frame transport and the Worker admit or refuse by credits alone; liveness is the renderer's `rejections`.",
      "required": ["note", "admitted", "refused"],
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "admitted": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/creditRow" } },
        "refused": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/creditRow" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "rect": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
    "creditRow": {
      "type": "object",
      "required": ["id", "wire"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "wire": {
          "type": "object",
          "required": ["kind", "windowId", "windowGeneration", "nodeId", "nodeKey"],
          "properties": {
            "kind": { "enum": ["accessibility-focus", "accessibility-blur", "accessibility-activate"] },
            "windowId": { "type": "string" },
            "windowGeneration": { "type": "number" },
            "nodeId": { "type": "number" },
            "nodeKey": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "namedId": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
