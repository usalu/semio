{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/renderer/local-folder-bindings/schema.json",
  "title": "Local Folder Values",
  "definitions": {
    "Mutation": {
      "oneOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/os/config/mutation/attach-local-folder/schema.json"
        },
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/os/config/mutation/detach-local-folder/schema.json"
        }
      ]
    },
    "Bindings": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/os/config/mutation/attach-local-folder/schema.json#/$defs/LocalFolderBinding"
      }
    },
    "Log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "events"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mutation"
          }
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "pluginId",
        "appId"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "message",
        "attach",
        "forget"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "attach": {
          "type": "string",
          "minLength": 1
        },
        "forget": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
