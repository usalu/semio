{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/wgpu-plugin-modules",
  "type": "array",
  "maxItems": 256,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "pluginId",
      "moduleUrl"
    ],
    "properties": {
      "pluginId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
      },
      "moduleUrl": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
      }
    }
  },
  "x-semio-admission": {
    "maxJsonBytes": 131072,
    "maxDependencies": 256,
    "schemes": [
      "http:",
      "https:",
      "file:"
    ],
    "uniqueFields": [
      "pluginId",
      "moduleUrl"
    ],
    "descriptorIdentity": "exact",
    "explicitRegistry": "supplied-only",
    "missingDependency": "refuse",
    "cycle": "refuse",
    "maxVersionLength": 128,
    "selectionModes": [
      "variant",
      "all"
    ],
    "libraryOmittedRegistry": "empty",
    "unfilteredPrimary": "first-supplied",
    "dependencyActivations": [
      "required",
      "on-demand"
    ],
    "defaultDependencyActivation": "required",
    "onDemandEdgeRequires": "activation-events",
    "onDemandPhases": [
      "resolving",
      "loading",
      "active",
      "unavailable",
      "cancelled"
    ],
    "onDemandUnavailableReasons": [
      "not-installed",
      "dependency-missing",
      "load-failed"
    ],
    "onDemandMissingOptional": "report-unavailable",
    "onDemandActivationEventPrefixes": [
      "on-node-kind:",
      "on-artifact-kind:",
      "on-extension-request:",
      "on-command:",
      "on-view-visible:",
      "on-file-type:"
    ]
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId"
      ],
      "properties": {
        "pluginId": {
          "$ref": "#/items/properties/pluginId"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^=[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
        },
        "activation": {
          "enum": [
            "required",
            "on-demand"
          ],
          "default": "required"
        }
      }
    },
    "descriptorAuthority": {
      "type": "object",
      "required": [
        "pluginId",
        "version"
      ],
      "properties": {
        "pluginId": {
          "$ref": "#/items/properties/pluginId"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "onDemandRequestTopic": {
      "description": "The topic a guest publishes (Effect::PublishEvent) to ask its host to activate a deferred extension. The payload is the UTF-8 JSON of an onDemandRequest.",
      "const": "os.on-demand.request"
    },
    "onDemandRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nodeKind"
          ],
          "properties": {
            "kind": {
              "const": "node-kind"
            },
            "nodeKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f.][^\\u0000-\\u001f\\u007f]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tag"
          ],
          "properties": {
            "kind": {
              "const": "tag"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "event"
          ],
          "properties": {
            "kind": {
              "const": "event"
            },
            "event": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^on-[a-z-]+:[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pluginId"
          ],
          "properties": {
            "kind": {
              "const": "plugin"
            },
            "pluginId": {
              "$ref": "#/items/properties/pluginId"
            }
          }
        }
      ]
    },
    "onDemandStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "phase",
        "completed",
        "total"
      ],
      "properties": {
        "pluginId": {
          "$ref": "#/items/properties/pluginId"
        },
        "phase": {
          "enum": [
            "resolving",
            "loading",
            "active",
            "unavailable",
            "cancelled"
          ]
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "not-installed",
            "dependency-missing",
            "load-failed"
          ]
        }
      }
    }
  }
}
