{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capacity", "wordBits", "wordCount", "indexBytes", "initial", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capacity": { "const": 512 },
    "wordBits": { "const": 64 },
    "wordCount": { "const": 8 },
    "indexBytes": { "const": 72 },
    "initial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "occupied"],
      "properties": {
        "cursor": { "type": "integer", "minimum": 0, "maximum": 511 },
        "occupied": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 511 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "slot", "terminal", "nextCursor", "occupiedCount"],
            "properties": {
              "op": { "const": "closePage" },
              "slot": { "type": "integer", "minimum": 0, "maximum": 511 },
              "terminal": { "type": "boolean" },
              "nextCursor": { "type": "integer", "minimum": 0, "maximum": 511 },
              "occupiedCount": { "type": "integer", "minimum": 0, "maximum": 512 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "slot", "epoch", "occupiedCount"],
            "properties": {
              "op": { "const": "admit" },
              "slot": { "type": "integer", "minimum": 0, "maximum": 511 },
              "epoch": { "type": "integer", "minimum": 1 },
              "occupiedCount": { "type": "integer", "minimum": 1, "maximum": 512 }
            }
          }
        ]
      }
    }
  }
}
