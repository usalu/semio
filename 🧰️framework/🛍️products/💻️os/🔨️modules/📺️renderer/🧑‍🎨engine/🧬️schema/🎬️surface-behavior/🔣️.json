{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/renderer/surface-behavior-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "staleContinuation", "duplicateCancel", "freshGesture"],
      "properties": {
        "identity": { "const": ["surfaceId", "generation", "pointerId"] },
        "staleContinuation": { "const": "inert" },
        "duplicateCancel": { "const": "inert" },
        "freshGesture": { "const": "accepted" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "phase", "cancelled"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "phase": { "type": ["string", "null"] },
        "cancelled": { "type": ["boolean", "null"] }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pluginId", "appId", "exampleId", "windowKindId", "surfaceKind", "controllerId", "utility", "points", "terminalPolicy", "acceptedBeforeCancel", "publishedOnCancel", "blockedAfterCancel", "artifactAfterCancel", "previewAfterCancel", "freshGestureResult"],
      "properties": {
        "id": { "enum": ["draw-canvas2d", "note-ink-canvas"] },
        "pluginId": { "enum": ["s.draw", "s.note"] },
        "appId": { "enum": ["s.draw.drawing@1/*#editor", "s.note.note@1/*#editor"] },
        "exampleId": { "const": "demo" },
        "windowKindId": { "enum": ["drawing-composite", "note-composite"] },
        "surfaceKind": { "enum": ["canvas-2d", "ink-canvas"] },
        "controllerId": { "enum": ["s.draw.drawing@1/*#editor", "s.note.note@1/*#editor"] },
        "utility": { "enum": ["selectDirect", "pencil"] },
        "points": {
          "type": "object",
          "additionalProperties": false,
          "required": ["down", "move", "terminal"],
          "properties": {
            "down": { "$ref": "#/definitions/point" },
            "move": { "$ref": "#/definitions/point" },
            "terminal": { "$ref": "#/definitions/point" }
          }
        },
        "terminalPolicy": { "const": "cancelled-action-discards-draft" },
        "acceptedBeforeCancel": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/definitions/action" }
        },
        "publishedOnCancel": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/definitions/action" }
        },
        "blockedAfterCancel": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["canvasPointerMove", "canvasPointerUp", "inkApplyEvents:stream", "inkApplyEvents:commit"] }
        },
        "artifactAfterCancel": { "const": "unchanged" },
        "previewAfterCancel": { "const": "cleared" },
        "freshGestureResult": { "const": "one-artifact-publication" }
      }
    }
  }
}
