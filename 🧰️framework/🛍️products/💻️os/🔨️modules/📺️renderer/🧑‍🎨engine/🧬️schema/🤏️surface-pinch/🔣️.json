{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/renderer/surface-pinch-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "viewport", "gestures", "surfaces"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "viewport": { "$ref": "#/definitions/viewport" },
    "gestures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spread", "translation"],
      "properties": {
        "spread": { "$ref": "#/definitions/gesture" },
        "translation": { "$ref": "#/definitions/gesture" }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board2d", "tiledMap"],
      "properties": {
        "board2d": { "$ref": "#/definitions/surface" },
        "tiledMap": { "$ref": "#/definitions/surface" }
      }
    }
  },
  "definitions": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointerId", "x", "y"],
      "properties": {
        "pointerId": { "type": "integer", "minimum": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialCamera", "down", "move", "expectedCamera"],
      "properties": {
        "initialCamera": { "$ref": "#/definitions/camera" },
        "down": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/definitions/point" }
        },
        "move": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/definitions/point" }
        },
        "expectedCamera": { "$ref": "#/definitions/camera" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transfer", "moves", "lifts", "successor"],
      "properties": {
        "transfer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cancelSinglePointerLane", "syntheticPointerUps"],
          "properties": {
            "cancelSinglePointerLane": { "const": true },
            "syntheticPointerUps": { "type": "integer", "minimum": 0, "maximum": 1 }
          }
        },
        "moves": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cameraPublications", "pointerMoves"],
          "properties": {
            "cameraPublications": { "const": 0 },
            "pointerMoves": { "const": 0 }
          }
        },
        "lifts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cameraPublications", "pointerUps", "selectionPublications"],
          "properties": {
            "cameraPublications": { "const": 1 },
            "pointerUps": { "const": 0 },
            "selectionPublications": { "const": 0 }
          }
        },
        "successor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["firstContactVerdict"],
          "properties": {
            "firstContactVerdict": { "const": "single" }
          }
        }
      }
    }
  }
}
