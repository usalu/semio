{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "defaultVariant",
    "ambientVariants",
    "cases",
    "generator",
    "refusals"
  ],
  "properties": {
    "$schema": {
      "const": "semio.framework.wgpu.boot-cache-inputs/v1"
    },
    "defaultVariant": {
      "type": "string"
    },
    "ambientVariants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "search",
          "expected"
        ],
        "properties": {
          "search": {
            "type": "string"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pluginVariant",
              "appId",
              "appRole",
              "appMode",
              "appExample",
              "brandId",
              "brand",
              "brokerProof",
              "locks",
              "defaults",
              "hub"
            ],
            "properties": {
              "pluginVariant": {
                "type": "string"
              },
              "appId": {
                "type": "string"
              },
              "appRole": {
                "enum": [
                  "viewer",
                  "editor"
                ]
              },
              "appMode": {
                "type": "string"
              },
              "appExample": {
                "type": "string"
              },
              "brandId": {
                "type": "string"
              },
              "brand": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "windowTitle",
                  "ephemeral",
                  "replayIntroductionOnLoad"
                ],
                "properties": {
                  "windowTitle": {
                    "type": "string"
                  },
                  "ephemeral": {
                    "type": "boolean"
                  },
                  "replayIntroductionOnLoad": {
                    "type": "boolean"
                  }
                }
              },
              "brokerProof": {
                "type": "string"
              },
              "locks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exampleId",
                  "locale",
                  "terminology",
                  "themeId",
                  "appearance"
                ],
                "properties": {
                  "exampleId": {
                    "type": "string"
                  },
                  "locale": {
                    "type": "string"
                  },
                  "terminology": {
                    "type": "string"
                  },
                  "themeId": {
                    "type": "string"
                  },
                  "appearance": {
                    "type": "string"
                  }
                }
              },
              "defaults": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exampleId"
                ],
                "properties": {
                  "exampleId": {
                    "type": "string"
                  }
                }
              },
              "hub": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "hubUrl",
                      "user",
                      "dataDir"
                    ],
                    "properties": {
                      "hubUrl": {
                        "type": "string"
                      },
                      "user": {
                        "type": "string"
                      },
                      "dataDir": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "plugin": {
                "type": "string"
              },
              "appId": {
                "type": "string"
              },
              "appRole": {
                "enum": [
                  "viewer",
                  "editor"
                ]
              },
              "appMode": {
                "type": "string"
              },
              "appExample": {
                "type": "string"
              },
              "brandId": {
                "type": "string"
              },
              "brand": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "windowTitle": {
                    "type": "string"
                  },
                  "ephemeral": {
                    "type": "boolean"
                  },
                  "replayIntroductionOnLoad": {
                    "type": "boolean"
                  }
                }
              },
              "locks": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "exampleId": {
                    "type": "string"
                  },
                  "locale": {
                    "type": "string"
                  },
                  "terminology": {
                    "type": "string"
                  },
                  "themeId": {
                    "type": "string"
                  },
                  "appearance": {
                    "type": "string"
                  }
                }
              },
              "defaults": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "exampleId": {
                    "type": "string"
                  }
                }
              },
              "hub": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hubUrl",
                  "user",
                  "dataDir"
                ],
                "properties": {
                  "hubUrl": {
                    "type": "string"
                  },
                  "user": {
                    "type": "string"
                  },
                  "dataDir": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "hash": {
            "type": "string"
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "output",
        "prerequisites",
        "consumers",
        "inputs",
        "dependencyOutput"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencyOutput": {
          "type": "string"
        }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "valueLength",
          "message"
        ],
        "properties": {
          "axis": {
            "enum": [
              "search",
              "hash",
              "plugin",
              "brand.windowTitle",
              "locks.locale"
            ]
          },
          "valueLength": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.wgpu.boot-cache-inputs/v1"
}
