{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/wgpu-boot-lifecycle",
  "title": "Browser Boot Progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "progress",
    "worker"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "worker": {
      "type": "object"
    }
  }
}
