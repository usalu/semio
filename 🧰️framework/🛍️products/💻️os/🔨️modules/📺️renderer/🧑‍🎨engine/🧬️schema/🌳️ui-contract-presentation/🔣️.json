{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.dev/schema/ui-contract-presentation.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "cases"],
  "properties": {
    "contractVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tree", "toggle", "expected"],
        "properties": {
          "id": { "enum": ["defaults", "compact-checkbox"] },
          "tree": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interactionDomain"],
            "properties": {
              "presentation": { "enum": ["standard", "compact"] },
              "interactionDomain": { "type": ["string", "null"] }
            }
          },
          "toggle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["on", "icon", "text"],
            "properties": {
              "appearance": { "enum": ["button", "checkbox"] },
              "on": { "type": "boolean" },
              "icon": { "type": "string" },
              "text": { "type": ["string", "null"] }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["treePresentation", "toggleAppearance"],
            "properties": {
              "treePresentation": { "enum": ["standard", "compact"] },
              "toggleAppearance": { "enum": ["button", "checkbox"] }
            }
          }
        }
      }
    }
  }
}
