{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.dev/schema/native-theme-invalidation.json",
  "title": "Native Theme Invalidation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "mediaQuery", "transitions"],
  "properties": {
    "contractVersion": { "const": 1 },
    "mediaQuery": { "const": "(prefers-color-scheme: dark)" },
    "transitions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "pendingReason", "schedulerReason", "expectedReasons", "reactDark"],
        "properties": {
          "from": { "enum": ["light", "dark"] },
          "to": { "enum": ["light", "dark"] },
          "pendingReason": { "enum": [null, "inputState", "paint"] },
          "schedulerReason": { "enum": [null, "inputState", "paint"] },
          "expectedReasons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["inputState", "paint", "theme"] }
          },
          "reactDark": { "type": "boolean" }
        }
      }
    }
  }
}
