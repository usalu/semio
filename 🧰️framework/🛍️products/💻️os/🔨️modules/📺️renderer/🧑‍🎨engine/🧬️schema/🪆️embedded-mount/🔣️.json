{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "roots",
    "expected"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "roots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "variant",
          "locale",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "enum": [
              "en",
              "de"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers",
        "canvases",
        "workerStoppedAfterFirstDispose",
        "remainingRoot",
        "allStoppedAfterFinalDispose",
        "retirementWaitsForWorker",
        "replacementRetiresPrevious",
        "crashedWorkerRetires",
        "descendantWorkerRetired",
        "lateWorkerSpawnIgnored"
      ],
      "properties": {
        "workers": {
          "const": 2
        },
        "canvases": {
          "const": 2
        },
        "workerStoppedAfterFirstDispose": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "boolean"
          }
        },
        "remainingRoot": {
          "type": "string",
          "minLength": 1
        },
        "allStoppedAfterFinalDispose": {
          "const": true
        },
        "retirementWaitsForWorker": {
          "const": true
        },
        "replacementRetiresPrevious": {
          "const": true
        },
        "crashedWorkerRetires": {
          "const": true
        },
        "descendantWorkerRetired": {
          "const": true
        },
        "lateWorkerSpawnIgnored": {
          "const": true
        }
      }
    }
  }
}
