{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.dev/schema/settings-theme-publication.json",
  "title": "Settings Theme Retained Publication Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "surfaceId", "requiresGuestRefresh", "workflow"],
  "properties": {
    "contractVersion": { "const": 1 },
    "surfaceId": { "const": "framework.settings.theme" },
    "requiresGuestRefresh": { "const": false },
    "workflow": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "arguments", "observations"],
        "properties": {
          "action": {
            "enum": ["setThemeId", "setThemeColor", "setThemeSaveLabel", "saveTheme", "applyImportedTheme", "resetThemeId", "deleteThemeId"]
          },
          "arguments": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controlId", "expectedState"],
              "properties": {
                "controlId": { "type": "string", "minLength": 1 },
                "expectedState": {
                  "type": "string",
                  "pattern": "^(select:|input:|button:(enabled|disabled)$|absent$)"
                }
              }
            }
          }
        }
      }
    }
  }
}
