{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/renderer/scene-pointer-cancellation-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "tiledMap", "cases"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "match", "zeroGeneration", "staleGeneration", "replacement", "afterCancel"],
      "properties": {
        "identity": {
          "const": ["surfaceId", "generation", "pointerId"]
        },
        "match": { "const": "all-fields" },
        "zeroGeneration": { "const": "invalid" },
        "staleGeneration": { "const": "ignore" },
        "replacement": { "const": "cancel-old-before-reuse" },
        "afterCancel": { "const": "next-down-accepted" }
      }
    },
    "tiledMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "cancel", "hoverLeave"],
      "properties": {
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windowId", "surfaceId", "peerSurfaceId"],
          "properties": {
            "windowId": { "type": "string", "minLength": 1 },
            "surfaceId": { "type": "string", "minLength": 1 },
            "peerSurfaceId": { "type": "string", "minLength": 1 }
          }
        },
        "cancel": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/tiledMapCancel" }
        },
        "hoverLeave": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior", "emptyTargets", "publications", "repeatPublications", "peerPublications", "gestureFanout"],
          "properties": {
            "prior": { "type": "string", "minLength": 1 },
            "emptyTargets": { "const": "[]" },
            "publications": { "const": 1 },
            "repeatPublications": { "const": 0 },
            "peerPublications": { "const": 0 },
            "gestureFanout": { "const": [] }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "tiledMapCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "button", "cameraPublications", "selectionPublications", "clearsDrag", "nextDown", "duplicateCancel", "outsideUp"],
      "properties": {
        "mode": { "enum": ["pan", "marquee", "none"] },
        "button": { "type": "integer", "minimum": 0, "maximum": 1 },
        "cameraPublications": { "type": "integer", "minimum": 0, "maximum": 1 },
        "selectionPublications": { "const": 0 },
        "clearsDrag": { "type": "boolean" },
        "nextDown": { "const": "accepted" },
        "duplicateCancel": { "const": "inert" },
        "outsideUp": { "const": "inert" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "gesture",
        "reactStatus",
        "terminal",
        "invokeNormalPointerUp",
        "retire",
        "preservePublished",
        "discardTransient",
        "publishOnCancel",
        "nextDown",
        "source"
      ],
      "properties": {
        "family": {
          "enum": ["nodeGraph", "board2d", "ink", "tiledMap", "paint2d", "textEditor"]
        },
        "gesture": { "type": "string", "minLength": 1 },
        "reactStatus": { "enum": ["missing", "contact-only", "reference"] },
        "terminal": { "enum": ["discard", "commit-navigation"] },
        "invokeNormalPointerUp": { "type": "boolean" },
        "retire": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capture", "queuedIntent", "inProgressIntent"],
          "properties": {
            "capture": { "const": true },
            "queuedIntent": { "const": true },
            "inProgressIntent": { "const": true }
          }
        },
        "preservePublished": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["selection", "camera"] }
        },
        "discardTransient": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "wire-preview",
              "node-drag-preview",
              "link-preview",
              "brush-preview",
              "stroke-preview",
              "marquee",
              "navigator-pan",
              "selection-drag-preview",
              "queued-mutation-terminal",
              "action-claim"
            ]
          }
        },
        "publishOnCancel": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["camera"] }
        },
        "nextDown": { "const": "accepted" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
