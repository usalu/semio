{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/renderer/wgpu/backbone-folder-door/schema.json",
  "title": "WGPU Backbone Folder Door",
  "description": "The browser wgpu shell's folder door over the dev host's backbone route: the requests the Rust shell sends through `semioWgpuHostIo` with the fetch the page makes for each, and the page's answer per HTTP outcome with what the shell reads from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "endpoint", "requests", "answers"],
  "definitions": {
    "Verb": { "type": "string", "enum": ["read", "write"] },
    "Uri": { "type": "string", "pattern": "^(folder|file)://.+$" },
    "Base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
    "Status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "Refusal": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "string", "minLength": 1 } } },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "verb", "uri", "documentId", "schema", "json", "fetch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "verb": { "$ref": "#/definitions/Verb" },
        "uri": { "$ref": "#/definitions/Uri" },
        "documentId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "schema": { "type": ["string", "null"], "minLength": 1 },
        "json": {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "verb", "uri", "documentId"],
          "properties": {
            "op": { "const": "backbone-folder" },
            "verb": { "$ref": "#/definitions/Verb" },
            "uri": { "$ref": "#/definitions/Uri" },
            "documentId": { "type": "string", "minLength": 1 },
            "schema": { "type": "string", "minLength": 1 }
          }
        },
        "fetch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "url", "body"],
          "properties": { "method": { "type": "string", "enum": ["GET", "PUT"] }, "url": { "type": "string", "pattern": "^/semio-backbone\\?" }, "body": { "type": "boolean" } }
        }
      }
    },
    "Answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "verb", "response", "page", "shell"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "verb": { "$ref": "#/definitions/Verb" },
        "response": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "$ref": "#/definitions/Status" }, "body": { "$ref": "#/definitions/Base64" } } },
            { "$ref": "#/definitions/Refusal" }
          ]
        },
        "page": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "$ref": "#/definitions/Status" }, "bodyBase64": { "$ref": "#/definitions/Base64" } } },
            { "$ref": "#/definitions/Refusal" }
          ]
        },
        "shell": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["bytes"], "properties": { "bytes": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Base64" }] } } },
            { "type": "object", "additionalProperties": false, "required": ["written"], "properties": { "written": { "const": true } } },
            { "$ref": "#/definitions/Refusal" }
          ]
        }
      }
    }
  },
  "properties": {
    "description": { "type": "string" },
    "endpoint": { "const": "/semio-backbone" },
    "requests": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Request" } },
    "answers": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Answer" } }
  }
}
