{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "axes", "builtins", "displayLabels", "transitions", "controls", "oracles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "axes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "labelKey", "options"],
        "properties": {
          "key": { "enum": ["labels", "labelTier", "drag", "chrome", "gumball", "tooltips", "hotkeys"] },
          "labelKey": { "type": "string", "pattern": "^settings\\.driver\\." },
          "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "builtins": {
      "type": "object",
      "required": ["default", "compact"],
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/definitions/driver" },
        "compact": { "$ref": "#/definitions/driver" }
      }
    },
    "displayLabels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "en", "de", "ownership"],
        "properties": {
          "id": { "enum": ["default", "compact", "custom.focus-flow"] },
          "en": { "type": "string", "minLength": 1 },
          "de": { "type": "string", "minLength": 1 },
          "ownership": { "enum": ["localized-built-in", "authored-custom"] }
        }
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit", "select", "save", "delete"],
      "properties": {
        "edit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected", "key", "value", "dirty", "liveValue", "persistedValue"],
          "properties": {
            "selected": { "type": "string" }, "key": { "type": "string" }, "value": { "type": "string" },
            "dirty": { "const": true }, "liveValue": { "type": "string" }, "persistedValue": { "type": "string" }
          }
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected", "dirty", "liveValue"],
          "properties": { "selected": { "type": "string" }, "dirty": { "const": false }, "liveValue": { "type": "string" } }
        },
        "save": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "id", "selected", "dirty", "saveLabel"],
          "properties": {
            "label": { "type": "string" }, "id": { "type": "string", "pattern": "^custom\\." }, "selected": { "type": "string" },
            "dirty": { "const": false }, "saveLabel": { "const": "" }
          }
        },
        "delete": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "selected", "dirty"],
          "properties": { "id": { "type": "string", "pattern": "^custom\\." }, "selected": { "const": "default" }, "dirty": { "const": false } }
        }
      }
    },
    "controls": { "type": "array", "minItems": 10, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "oracles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reactDriver", "reactPanel", "reactHost"],
      "properties": {
        "reactDriver": { "type": "string", "minLength": 1 },
        "reactPanel": { "type": "string", "minLength": 1 },
        "reactHost": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "labels", "labelTier", "drag", "chrome", "gumball", "tooltips", "hotkeys"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "labels": { "enum": ["full", "icons"] },
        "labelTier": { "enum": ["beginner", "normal"] },
        "drag": { "enum": ["handle", "surface"] },
        "chrome": { "enum": ["always", "hover"] },
        "gumball": { "enum": ["always", "hover"] },
        "tooltips": { "enum": ["full", "minimal", "none"] },
        "hotkeys": { "enum": ["inline", "tooltip", "none"] }
      }
    }
  }
}
