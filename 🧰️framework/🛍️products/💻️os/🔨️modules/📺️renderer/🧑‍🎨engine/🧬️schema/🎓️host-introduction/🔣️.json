{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hasIntroduction",
          "tutorialActive",
          "seenOnDevice",
          "replayOnLoad",
          "suppressed",
          "iframe",
          "expectedSuppressed",
          "expectedAutoStart",
          "id",
          "appId"
        ],
        "properties": {
          "hasIntroduction": {
            "type": "boolean"
          },
          "tutorialActive": {
            "type": "boolean"
          },
          "seenOnDevice": {
            "type": "boolean"
          },
          "replayOnLoad": {
            "type": "boolean"
          },
          "suppressed": {
            "type": "boolean"
          },
          "iframe": {
            "type": "boolean"
          },
          "expectedSuppressed": {
            "type": "boolean"
          },
          "expectedAutoStart": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "appId": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  }
}
