{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/framework/world3d-inline-surface-v1.json",
  "type": "object",
  "required": [
    "schema",
    "mesh",
    "expected",
    "contract",
    "pixelCases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "framework.world3d.inline-surface/v1"
