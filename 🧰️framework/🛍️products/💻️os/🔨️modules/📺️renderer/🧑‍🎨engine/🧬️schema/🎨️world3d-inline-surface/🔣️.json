        "positions",
        "normals",
        "indices",
        "attributes",
        "materials",
        "textures"
      ],
      "additionalProperties": false,
      "properties": {
        "positions": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "number"
          }
