{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/wgpu/wheel-application-point/v2.json",
  "title": "Owned Scroll Dispatch Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "$comment", "rule", "cases"],
  "properties": {
    "schema": { "const": "framework.wgpu.wheel-application-point/v2" },
    "$comment": { "type": "string", "minLength": 1 },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "producer", "consumer", "ticket"],
      "properties": {
        "id": { "const": "ownedScrollDispatch" },
        "statement": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "consumer": { "type": "string", "minLength": 1 },
        "ticket": { "type": "string", "minLength": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shift", "ctrl", "meta", "alt"],
      "properties": {
        "shift": { "type": "boolean" },
        "ctrl": { "type": "boolean" },
        "meta": { "type": "boolean" },
        "alt": { "type": "boolean" }
      }
    },
    "scroll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y", "deltaX", "deltaY", "modifiers"],
      "properties": {
        "kind": { "const": "scroll" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "deltaX": { "type": "number" },
        "deltaY": { "type": "number" },
        "modifiers": { "$ref": "#/$defs/modifiers" }
      }
    },
    "pointerMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y"],
      "properties": {
        "kind": { "const": "pointer-move" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "deltaX", "delta", "modifiers"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "deltaX": { "type": "number" },
        "delta": { "type": "number" },
        "modifiers": { "$ref": "#/$defs/modifiers" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "why", "events", "applications"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/scroll" },
              { "$ref": "#/$defs/pointerMove" }
            ]
          }
        },
        "applications": {
          "type": "array",
          "items": { "$ref": "#/$defs/application" }
        },
        "supersededApplication": { "$ref": "#/$defs/application" }
      }
    }
  }
}
