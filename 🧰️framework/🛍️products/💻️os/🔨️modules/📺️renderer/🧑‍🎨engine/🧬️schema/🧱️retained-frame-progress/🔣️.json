{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/framework/ui-retained-frame-progress-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sameSizeOriginMove", "sceneBackpressure", "publication"],
  "properties": {
    "schema": { "const": "framework.ui.retained-frame-progress/v1" },
    "sameSizeOriginMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "moved", "expectedAcceptedOrigin"],
      "properties": {
        "initial": { "$ref": "#/$defs/rect" },
        "moved": { "$ref": "#/$defs/rect" },
        "expectedAcceptedOrigin": { "$ref": "#/$defs/point" }
      }
    },
    "sceneBackpressure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalCompleted", "expectedProgress"],
      "properties": {
        "externalCompleted": { "const": [0, 0, 1] },
        "expectedProgress": { "const": ["changed", "stable", "changed"] }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draw", "hit", "origin"],
      "properties": {
        "draw": { "const": "acceptedOnly" },
        "hit": { "const": "acceptedOnly" },
        "origin": { "const": "singleAcceptedViewport" }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  }
}
