{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases", "workspace", "operationOwnership", "transport"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "projection", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "projection": { "$ref": "#/definitions/projection" },
          "expected": { "$ref": "#/definitions/summary" }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openerId", "route", "controls", "sections"],
      "properties": {
        "openerId": { "const": "framework.hub.signIn" },
        "route": { "const": "/hub" },
        "controls": {
          "type": "array",
          "minItems": 9,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sections": {
          "type": "array",
          "minItems": 3,
          "items": { "enum": ["signIn", "spaces", "invitations"] },
          "uniqueItems": true
        }
      }
    },
    "operationOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedGeneration", "completions"],
      "properties": {
        "selectedGeneration": { "type": "integer", "minimum": 1 },
        "completions": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "ownerGeneration", "accepted"],
            "properties": {
              "operation": { "enum": ["signInFailure", "signOut", "command", "authority", "members", "redemption"] },
              "ownerGeneration": { "type": "integer", "minimum": 1 },
              "accepted": { "type": "boolean" }
            }
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "documentKey", "publications", "expected"],
      "properties": {
        "capacity": { "const": 64 },
        "documentKey": { "type": "string", "minLength": 1, "maxLength": 512 },
        "publications": {
          "type": "array",
          "minItems": 3,
          "items": { "enum": ["connecting", "live", "close"] }
        },
        "expected": { "enum": ["connecting", "live", "close"] }
      }
    }
  },
  "definitions": {
    "session": {
      "description": "Whether this shell holds a hub session: none = no hub configured at all (purely local-first), signedOut = a hub to sign in to and no session, signedIn = a session credential is held.",
      "enum": ["none", "signedOut", "signedIn"]
    },
    "link": {
      "description": "What the shell's own session revalidation last learned about the hub link, independent of any document: still verifying a held session, reachable, or unreachable (a short shortage ridden out on a bounded backoff).",
      "enum": ["verifying", "reachable", "unreachable"]
    },
    "remote": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "detached" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "connecting" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "peerCount"],
          "properties": { "kind": { "const": "live" }, "peerCount": { "type": "integer", "minimum": 0, "maximum": 65535 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "retryInMs"],
          "properties": { "kind": { "const": "backoff" }, "retryInMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentKey", "remote"],
      "properties": {
        "documentKey": { "type": "string", "minLength": 1, "maxLength": 512 },
        "remote": { "$ref": "#/definitions/remote" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "link", "documents"],
      "properties": {
        "session": { "$ref": "#/definitions/session" },
        "link": { "$ref": "#/definitions/link" },
        "documents": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/document" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "peerCount", "documentCount"],
      "properties": {
        "state": { "enum": ["local", "signedOut", "live", "online", "connecting", "reconnecting"] },
        "peerCount": { "type": "integer", "minimum": 0 },
        "documentCount": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    }
  }
}
