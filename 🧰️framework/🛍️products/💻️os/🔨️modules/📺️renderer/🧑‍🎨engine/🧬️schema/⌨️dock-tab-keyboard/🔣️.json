{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/renderer/dock-tab-keyboard.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projection", "stacks", "cases", "stale"],
  "properties": {
    "schema": { "const": "semio.renderer.dock-tab-keyboard.v1" },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowId", "windowGeneration", "nodes"],
      "properties": {
        "windowId": { "type": "string", "minLength": 1 },
        "windowGeneration": { "type": "integer", "minimum": 1 },
        "nodes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "key", "role", "depth", "label", "live", "focusable", "tabbable", "actionable"],
            "properties": {
              "nodeId": { "type": "integer", "minimum": 1 },
              "key": { "type": "string", "minLength": 1 },
              "role": { "enum": ["tab", "tabpanel"] },
              "depth": { "const": 0 },
              "label": { "type": "string", "minLength": 1 },
              "live": { "const": "off" },
              "focusable": { "type": "boolean" },
              "tabbable": { "type": "boolean" },
              "actionable": { "type": "boolean" },
              "selected": { "type": "boolean" },
              "controls": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "stacks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "panel", "active", "tabs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "panel": { "type": "string", "minLength": 1 },
          "active": { "type": "string", "minLength": 1 },
          "tabs": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stack", "from", "key", "focus", "activate"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stack": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "key": { "enum": ["ArrowLeft", "ArrowRight", "Home", "End", "Enter", " "] },
          "focus": { "type": "string", "minLength": 1 },
          "activate": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "stale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "generation"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

