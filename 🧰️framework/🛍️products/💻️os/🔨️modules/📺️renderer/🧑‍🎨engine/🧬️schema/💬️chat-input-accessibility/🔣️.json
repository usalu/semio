{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.dev/schema/chat-input-accessibility.json",
  "title": "Chat Input Accessibility Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "cases"],
  "properties": {
    "contractVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "bridge", "accessibleName", "placeholder", "enabled", "enterAction"],
        "properties": {
          "locale": { "enum": ["en", "de"] },
          "bridge": { "enum": ["open", "closed"] },
          "accessibleName": { "type": "string", "minLength": 1 },
          "placeholder": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "enterAction": { "type": ["string", "null"], "enum": ["sendChatDraft", null] }
        }
      }
    }
  }
}
