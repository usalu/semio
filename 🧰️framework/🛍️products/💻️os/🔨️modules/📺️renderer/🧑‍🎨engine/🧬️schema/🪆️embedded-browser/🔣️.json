{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:renderer:embedded-browser:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "viewport",
    "roots",
    "introductionControl",
    "settingsControl",
    "phases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "deviceScaleFactor"
      ],
      "properties": {
        "width": {
          "const": 1600
        },
        "height": {
          "const": 1000
        },
        "deviceScaleFactor": {
          "const": 1
        }
      }
    },
    "roots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "$ref": "#/$defs/root",
          "properties": {
            "rootId": {
              "const": "shell-a"
            },
            "plugin": {
              "const": "puzzle3d"
            },
            "locale": {
              "const": "en"
            },
            "rect": {
              "const": [
                20,
                60,
                760,
                880
              ]
            },
            "suppressAutoIntroduction": {
              "const": true
            },
            "requiredPlugins": {
              "const": [
                "puzzle"
              ]
            }
          }
        },
        {
          "type": "object",
          "$ref": "#/$defs/root",
          "properties": {
            "rootId": {
              "const": "shell-b"
            },
            "plugin": {
              "const": "puzzle3d"
            },
            "locale": {
              "const": "de"
            },
            "rect": {
              "const": [
                820,
                60,
                760,
                880
              ]
            },
            "suppressAutoIntroduction": {
              "const": false
            },
            "requiredPlugins": {
              "const": [
                "puzzle",
                "stdio"
              ]
            }
          }
        }
      ],
      "items": false
    },
    "introductionControl": {
      "const": "ui.introduction.skip"
    },
    "settingsControl": {
      "const": "framework.settings"
    },
    "phases": {
      "const": [
        "boot",
        "release-a-introduction",
        "suppress-b-introduction",
        "suppress-a-introduction",
        "pointer-a",
        "keyboard-a",
        "pointer-b",
        "keyboard-b",
        "replace-a",
        "stale-retire-a",
        "retire-a",
        "retire-b",
        "iframe"
      ]
    }
  },
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "plugin",
        "locale",
        "rect",
        "suppressAutoIntroduction",
        "requiredPlugins"
      ],
      "properties": {
        "rootId": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "locale": {
          "enum": [
            "en",
            "de"
          ]
        },
        "suppressAutoIntroduction": {
          "type": "boolean"
        },
        "rect": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "requiredPlugins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
