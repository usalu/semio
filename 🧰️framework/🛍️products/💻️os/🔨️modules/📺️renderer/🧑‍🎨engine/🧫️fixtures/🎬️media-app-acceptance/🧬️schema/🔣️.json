{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugin",
    "example",
    "role",
    "mode",
    "cases",
    "capability",
    "reason"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugin": {
      "const": "stdio-media"
    },
    "example": {
      "const": "demo"
    },
    "role": {
      "const": "viewer"
    },
    "mode": {
      "const": "view"
    },
    "capability": {
      "const": "unsupported"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "app",
          "kind",
          "mediaType"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "app": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "audio",
              "video"
            ]
          },
          "mediaType": {
            "enum": [
              "audio/wav",
              "video/mp4"
            ]
          }
        }
      }
    }
  }
}
