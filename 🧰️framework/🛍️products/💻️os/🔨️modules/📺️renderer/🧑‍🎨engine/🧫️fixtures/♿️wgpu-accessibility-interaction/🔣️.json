{
  "schema": "semio.renderer.wgpu.accessibility-interaction.v1",
  "note": "A language-neutral, node-addressed accessibility interaction contract. Every event carries the stable window id, the retained window instance generation, the published node id, and the node key that must still identify that node. The renderer rejects an absent window, a retired generation, or an id/key mismatch before focus, activation, or value routing. No row contains pointer coordinates: assistive technology addresses the semantic node directly.",
  "limits": {
    "windowIdBytes": 512,
    "nodeKeyBytes": 512,
    "valueCodeUnits": 1024,
    "losslessItems": 64
  },
