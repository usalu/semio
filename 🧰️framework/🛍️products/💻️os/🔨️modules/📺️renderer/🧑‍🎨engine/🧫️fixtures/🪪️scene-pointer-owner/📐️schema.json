{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "surfaces",
    "press",
    "release",
    "expectedOwner",
    "cases",
    "captureCapacity",
    "moveDelta",
    "siblingInsertion",
    "sceneIntentPresentation",
    "barrierScope"
  ],
  "properties": {
    "siblingInsertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "receiver", "terminalReceivers", "events"],
      "properties": {
        "records": { "const": [[2], [2, 4], [2, 3, 4]] },
        "receiver": { "const": 4 },
        "terminalReceivers": { "const": 1 },
        "events": { "const": ["pointerdown", "pointermove", "pointerup"] }
      }
    },
    "sceneIntentPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "receiver", "unchangedUtilities", "changedUtilities", "admittedActions", "successorActions"],
      "properties": {
        "records": { "const": [[2, 4], [2, 3, 4]] },
        "receiver": { "const": 4 },
        "unchangedUtilities": { "const": ["text", "text"] },
        "changedUtilities": { "const": ["text", "pan"] },
        "admittedActions": { "const": 1 },
        "successorActions": { "const": [1, 0] }
      }
    },
    "barrierScope": {
      "const": [
        { "name": "participating-current", "sealed": true, "currentRevision": true, "blocks": true },
        { "name": "hidden-window", "sealed": false, "currentRevision": true, "blocks": false },
        { "name": "stale-revision", "sealed": true, "currentRevision": false, "blocks": false }
      ]
    },
    "version": {
      "const": 1
    },
    "surfaces": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "windowId",
          "surfaceId",
          "bounds"
        ],
        "properties": {
          "windowId": {
            "type": "string",
            "minLength": 1
          },
          "surfaceId": {
            "type": "string",
            "minLength": 1
          },
          "bounds": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "press": {
      "$ref": "#/$defs/point"
    },
    "release": {
      "$ref": "#/$defs/point"
    },
    "moveDelta": {
      "$ref": "#/$defs/point"
    },
    "expectedOwner": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps",
          "events",
          "menuOpen"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "press",
                "release",
                "move",
                "wheel",
                "chrome",
                "modal",
                "secondaryPress",
                "secondaryRelease",
                "cancel",
                "refresh",
                "replace",
                "foreignPress",
                "foreignRelease",
                "foreignCancel"
              ]
            }
          },
          "events": {
            "type": "array",
            "items": {
              "enum": [
                "pointerdown",
                "pointermove",
                "pointerup",
                "wheel"
              ]
            }
          },
          "menuOpen": {
            "type": "boolean"
          }
        }
      }
    },
    "captureCapacity": {
      "const": 16
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    }
  }
}
