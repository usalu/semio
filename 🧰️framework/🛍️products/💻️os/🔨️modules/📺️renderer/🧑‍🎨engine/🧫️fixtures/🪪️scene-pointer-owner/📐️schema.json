{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "surfaces",
    "press",
    "release",
    "expectedOwner",
    "cases",
    "captureCapacity",
    "moveDelta"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "surfaces": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "windowId",
          "surfaceId",
          "bounds"
        ],
        "properties": {
          "windowId": {
            "type": "string",
            "minLength": 1
          },
          "surfaceId": {
            "type": "string",
            "minLength": 1
          },
          "bounds": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "press": {
      "$ref": "#/$defs/point"
    },
    "release": {
      "$ref": "#/$defs/point"
    },
    "moveDelta": {
      "$ref": "#/$defs/point"
    },
    "expectedOwner": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps",
          "events",
          "menuOpen"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "press",
                "release",
                "move",
                "wheel",
                "chrome",
                "modal",
                "secondaryPress",
                "secondaryRelease",
                "cancel",
                "refresh",
                "replace",
                "foreignPress",
                "foreignRelease",
                "foreignCancel"
              ]
            }
          },
          "events": {
            "type": "array",
            "items": {
              "enum": [
                "pointerdown",
                "pointermove",
                "pointerup",
                "wheel"
              ]
            }
          },
          "menuOpen": {
            "type": "boolean"
          }
        }
      }
    },
    "captureCapacity": {
      "const": 16
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    }
  }
}
