{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WGPU directory HTTP deadline law",
  "type": "object",
  "required": ["timeoutMs", "request", "expected"],
  "properties": {
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
    "request": {
      "type": "object",
      "required": ["op", "method", "url"],
      "properties": {
        "op": { "const": "directory-http" },
        "method": { "const": "GET" },
        "url": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": ["aborted", "errorIncludes"],
      "properties": {
        "aborted": { "const": true },
        "errorIncludes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
