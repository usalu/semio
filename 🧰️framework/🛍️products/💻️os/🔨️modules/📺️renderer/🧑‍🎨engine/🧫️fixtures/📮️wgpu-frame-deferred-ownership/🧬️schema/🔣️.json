{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WGPU frame deferred ownership laws",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "dropAt", "currentReceiptSettlements", "remainingActions", "closeSteps", "readyReservations", "inFlightReservations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "dropAt": { "enum": ["queued", "running"] },
          "currentReceiptSettlements": { "const": 1 },
          "remainingActions": { "type": "integer", "minimum": 0 },
          "closeSteps": { "type": "integer", "minimum": 1 },
          "readyReservations": { "const": 0 },
          "inFlightReservations": { "const": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
