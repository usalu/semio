{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Icon Export Request",
  "type": "object",
  "required": [
    "assetUrl",
    "format",
    "camera",
    "width",
    "height"
  ],
  "properties": {
    "assetUrl": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "enum": [
        "png",
        "svg"
      ]
    },
    "camera": {
      "type": "object",
      "required": [
        "position",
        "target"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector"
        },
        "target": {
          "$ref": "#/$defs/vector"
        },
        "up": {
          "$ref": "#/$defs/vector"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fov": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "projection": {
          "enum": [
            "perspective",
            "orthographic"
          ]
        }
      }
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "shape": {
      "enum": [
        "rectangle",
        "ellipse"
      ]
    },
    "drawing": {
      "type": "object",
      "properties": {
        "background": {
          "type": "boolean",
          "default": true
        },
        "fill": {
          "type": "boolean",
          "default": true
        },
        "fillColor": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "description": "Flat fill color. Omit for the shaded asset material."
        },
        "fillOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "visibleLines": {
          "type": "boolean",
          "default": true
        },
        "hiddenLines": {
          "type": "boolean",
          "default": false
        },
        "visibleColor": {
          "type": "string",
          "default": "#000000",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "hiddenColor": {
          "type": "string",
          "default": "#808080",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "visibleWidth": {
          "type": "number",
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "hiddenWidth": {
          "type": "number",
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "lineEasing": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "Corner rounding radius in output pixels."
        },
        "mergeLines": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector"
        },
        "rotation": {
          "$ref": "#/$defs/quaternion"
        },
        "scale": {
          "$ref": "#/$defs/vector"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "vector": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    }
  }
}
