{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "samples"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "width",
          "height",
          "viewBox",
          "ellipse",
          "background"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "viewBox": {
            "anyOf": [
              {
                "$ref": "#/$defs/quad"
              },
              {
                "type": "null"
              }
            ]
          },
          "ellipse": {
            "$ref": "#/$defs/quad"
          },
          "background": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "alpha"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "alpha": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  },
  "$defs": {
    "quad": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    }
  }
}
