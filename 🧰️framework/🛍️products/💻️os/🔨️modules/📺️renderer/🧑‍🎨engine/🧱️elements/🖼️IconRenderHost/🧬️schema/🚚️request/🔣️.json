{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "transport"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "transport": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
