{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maximumPixelsPerStep",
    "cases"
  ],
  "properties": {
    "maximumPixelsPerStep": {
      "const": 1024
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "premultiplied",
          "straight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "premultiplied": {
            "$ref": "#/$defs/rgba"
          },
          "straight": {
            "$ref": "#/$defs/rgba"
          }
        }
      }
    }
  },
  "$defs": {
    "rgba": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
