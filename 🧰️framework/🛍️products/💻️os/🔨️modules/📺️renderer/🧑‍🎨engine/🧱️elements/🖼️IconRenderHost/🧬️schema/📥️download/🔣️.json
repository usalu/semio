{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Icon Download Cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "mime", "encoding", "value"],
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "mime": { "type": "string", "minLength": 1 },
          "encoding": { "enum": ["percent", "base64"] },
          "value": { "type": "string" }
        }
      }
    }
  }
}
