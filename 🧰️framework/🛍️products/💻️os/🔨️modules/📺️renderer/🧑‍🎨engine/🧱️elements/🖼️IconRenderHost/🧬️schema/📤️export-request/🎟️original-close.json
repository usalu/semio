{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "expected"],
  "properties": {
    "text": {"type": "string", "minLength": 1},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backingBytes", "deniedBytes", "copiedItems", "terminalDropBytes"],
      "properties": {
        "backingBytes": {"type": "integer", "minimum": 1},
        "deniedBytes": {"const": 0},
        "copiedItems": {"const": 1},
        "terminalDropBytes": {"const": 0}
      }
    }
  }
}
