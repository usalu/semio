{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph Timeline Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "viewport", "columns", "expected"],
  "properties": {
    "version": { "const": 1 },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkpointId", "timestamp", "labels", "authors", "description", "lane", "alternativeIds"],
        "properties": {
          "checkpointId": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "authors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "avatar": { "type": "string", "minLength": 1 }
              }
            }
          },
          "parentCheckpointId": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "lane": { "type": "integer", "minimum": 0 },
          "alternativeIds": { "type": "array", "items": { "type": "string" } },
          "mutationLevel": { "enum": ["info", "warning", "error", "fatal"] }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostPaddingPx", "rowHeightPx", "graphWidthPx", "graphColumnWidthPx", "labelTrackPx", "labelTrackTolerancePx", "labelTrackMaximumViewportFraction", "checkpointId", "laneNodeXPx", "authorLeftPx", "avatarSizePx", "avatarOverlapPx", "mutationLevel", "descriptionInert"],
      "properties": {
        "hostPaddingPx": { "type": "number", "minimum": 0 },
        "rowHeightPx": { "type": "number", "exclusiveMinimum": 0 },
        "graphWidthPx": { "type": "number", "exclusiveMinimum": 0 },
        "graphColumnWidthPx": { "type": "number", "exclusiveMinimum": 0 },
        "labelTrackPx": { "type": "number", "exclusiveMinimum": 0 },
        "labelTrackTolerancePx": { "type": "number", "minimum": 0 },
        "labelTrackMaximumViewportFraction": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "checkpointId": { "type": "string", "minLength": 1 },
        "laneNodeXPx": { "type": "number", "minimum": 0 },
        "authorLeftPx": { "type": "number", "minimum": 0 },
        "avatarSizePx": { "type": "number", "exclusiveMinimum": 0 },
        "avatarOverlapPx": { "type": "number", "minimum": 0 },
        "mutationLevel": { "enum": ["info", "warning", "error", "fatal"] },
        "descriptionInert": { "const": true }
      }
    }
  }
}
