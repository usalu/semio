{
  "version": 1,
  "target": {
    "plugin": "puzzle3d",
    "urls": {
      "react": "http://127.0.0.1:6313/?plugin=puzzle3d",
      "wgpu": "http://127.0.0.1:6213/?plugin=puzzle3d"
    },
    "viewport": {
      "width": 1600,
      "height": 1000
    },
    "minimumWindows": 2,
    "minimumStacks": 2,
    "tabsPerSelectedStack": 1,
    "dragThresholdPx": 6
  },
  "selectors": {
    "reactMode": "[data-slot=\"mode\"]",
    "reactStack": "[data-slot=\"mode-dock-stack\"][data-stack-path]",
    "reactBody": "[data-slot=\"mode-dock-stack-body\"]",
    "reactTab": "[data-slot=\"mode-dock-tab\"][data-window-id]",
    "reactHandle": "[data-slot=\"drag-handle\"]",
    "reactIndicator": "[data-slot=\"mode-dock-drop-indicator\"]",
    "wgpuTabPrefix": "dock.tab.",
    "wgpuHandleSuffix": ".drag"
  },
  "template": {
    "mime": "application/x-compose-window-template",
    "displayCategoryId": "framework.category.display",
    "rowSuffix": ".projection.parallel.orthographic",
    "selectionId": "orthographic",
    "semantic": {
      "projection": "orthographic",
      "direction": [
        0,
        0,
        1
      ],
      "up": [
        0,
        1,
        0
      ],
      "vectorTolerance": 0.12
    },
    "neutralPayload": {
      "windowKindId": "world",
      "templateId": "orthographic"
    }
  },
  "cases": [
    {
      "id": "split-left",
      "kind": "split",
      "side": "left",
      "expectedRelation": "source-left-of-target",
      "stackCountDelta": 0,
      "consequence": "The source tab becomes the active lone stack immediately left of the target while every window identity is preserved."
    },
    {
      "id": "split-right",
      "kind": "split",
      "side": "right",
      "expectedRelation": "source-right-of-target",
      "stackCountDelta": 0,
      "consequence": "The source tab becomes the active lone stack immediately right of the target while every window identity is preserved."
    },
    {
      "id": "split-top",
      "kind": "split",
      "side": "top",
      "expectedRelation": "source-above-target",
      "stackCountDelta": 0,
      "consequence": "The source tab becomes the active lone stack immediately above the target while every window identity is preserved."
    },
    {
      "id": "split-bottom",
      "kind": "split",
      "side": "bottom",
      "expectedRelation": "source-below-target",
      "stackCountDelta": 0,
      "consequence": "The source tab becomes the active lone stack immediately below the target while every window identity is preserved."
    },
    {
      "id": "tab-merge",
      "kind": "merge",
      "targetPosition": "after",
      "stackCountDelta": -1,
      "consequence": "The source and target share one stack in target-before-source order, the source is active, and no window identity is lost."
    },
    {
      "id": "tab-reorder",
      "kind": "reorder",
      "setup": "merge-after",
      "targetPosition": "before",
      "stackCountDelta": -1,
      "consequence": "After a physical merge setup, a second physical tab drag moves the source before the target without changing the window set or stack count."
    },
    {
      "id": "escape-cancel",
      "kind": "cancel",
      "mechanism": "Escape",
      "consequence": "Escape retires the promoted drag, restores the exact topology and body geometry, removes the preview, and the later physical pointer release commits nothing."
    },
    {
      "id": "template-configuration",
      "kind": "template",
      "targetPosition": "after",
      "windowCountDelta": 1,
      "consequence": "A physical Display-template transfer creates one tab and preserves the orthographic top-view configuration exposed by both camera APIs."
    }
  ],
  "widgets": {
    "version": 1,
    "renderers": [
      "react",
      "wgpu"
    ],
    "locales": [
      "en",
      "de"
    ],
    "ownerFields": [
      "controllerId",
      "appInstanceId",
      "parentDocumentId",
      "windowId"
    ],
    "selectors": {
      "reactDivider": "[data-slot=\"resizable-handle\"]",
      "reactCorner": "[data-slot=\"resizable-corner\"]",
      "reactFocus": "[data-slot=\"mode-dock-tab-focus\"]",
      "reactClose": "[data-slot=\"mode-dock-tab-close\"]",
      "wgpuDividerPrefix": "dock.split.",
      "wgpuCornerPrefix": "dock.corner.",
      "wgpuFocusSuffix": ".focus",
      "wgpuCloseSuffix": ".close"
    },
    "cases": [
      {
        "id": "divider-resize",
        "precondition": "two-adjacent-stacks",
        "input": {
          "kind": "pointer-drag",
          "deltaX": 80,
          "deltaY": 0
        },
        "expected": {
          "axis": "horizontal",
          "separatorDeltaPx": 80,
          "pixelTolerance": 2,
          "conservedAxisExtent": true,
          "preservedWindowIdentities": true,
          "preservedStackCount": true,
          "publishedInputMatchesPaint": true
        }
      },
      {
        "id": "maximize-restore",
        "precondition": "two-stacks-with-distinct-windows",
        "input": {
          "kind": "focus-action-twice",
          "activationCount": 2
        },
        "expected": {
          "maximizedVisibleStackCount": 1,
          "restoredOriginalGeometry": true,
          "preservedWindowIdentities": true,
          "restoredInputOwnership": true
        }
      },
      {
        "id": "close-active-tab",
        "precondition": "three-tab-stack-active-last",
        "input": {
          "kind": "close-active",
          "activationCount": 1
        },
        "expected": {
          "removedWindowCount": 1,
          "activeWindow": "first-remaining-in-layout-order",
          "retiredWindowHasNoAcceptedHits": true,
          "remainingBodyOwnerMatchesActiveWindow": true
        }
      },
      {
        "id": "close-background-tab",
        "precondition": "three-tab-stack-active-last",
        "input": {
          "kind": "close-first-background",
          "activationCount": 1
        },
        "expected": {
          "removedWindowCount": 1,
          "preservedActiveWindowIdentity": true,
          "retiredWindowHasNoAcceptedHits": true,
          "remainingBodyOwnerMatchesActiveWindow": true
        }
      },
      {
        "id": "close-last-window",
        "precondition": "single-window-single-stack",
        "input": {
          "kind": "close-active",
          "activationCount": 1
        },
        "expected": {
          "windowCount": 0,
          "rootKind": "stack",
          "activeWindow": null,
          "retiredWindowHasNoAcceptedHits": true,
          "noWindowOwnedCommandDispatch": true
        }
      },
      {
        "id": "reopen-window",
        "precondition": "closed-extra-orthographic-template-instance",
        "input": {
          "kind": "display-template-transfer",
          "activationCount": 1
        },
        "expected": {
          "newWindowCount": 1,
          "newWindowIdentityDiffersFromRetired": true,
          "bodyRendered": true,
          "bodyOwnerMatchesWindow": true,
          "acceptedInputOwnedByNewWindow": true
        }
      },
      {
        "id": "corner-resize",
        "precondition": "perpendicular-splits-with-aligned-cross-peers",
        "input": {
          "kind": "pointer-drag",
          "deltaX": 60,
          "deltaY": 40
        },
        "expected": {
          "mainSeparatorDeltaPx": 60,
          "allPeerCrossSeparatorDeltaPx": 40,
          "pixelTolerance": 2,
          "conservedBothAxisExtents": true,
          "preservedWindowIdentities": true,
          "preservedStackCount": true,
          "publishedInputMatchesPaint": true
        }
      }
    ],
    "localeStorage": {
      "key": "semio.os.config",
      "schema": "os.config.ui-preferences",
      "mutation": "setLocale"
    }
  }
}
