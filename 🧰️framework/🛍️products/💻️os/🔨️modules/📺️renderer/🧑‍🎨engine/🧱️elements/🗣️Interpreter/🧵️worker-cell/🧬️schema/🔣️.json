        "expected": [
          {
            "owner": "a",
            "state": "unadmitted"
          },
          {
            "owner": "a",
            "state": "ready",
            "locale": "de",
            "retained": [],
            "constructions": 1
          },
          {
            "owner": "a",
            "state": "ready",
            "locale": "de",
