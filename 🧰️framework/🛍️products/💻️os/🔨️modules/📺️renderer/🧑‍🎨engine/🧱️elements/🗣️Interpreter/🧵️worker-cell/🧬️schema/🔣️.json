              "window-1"
            ],
            "constructions": 1
          },
          {
            "owner": "a",
            "state": "ready",
            "locale": "en",
            "retained": [
              "window-1"
            ],
            "constructions": 1
          },
          {
            "owner": "a",
            "state": "ready",
            "locale": "en",
            "retained": [
              "window-1"
            ],
            "constructions": 1
          }
        ]
      },
      {
        "id": "test-thread-isolation",
        "operations": [
          {
            "owner": "a",
            "action": "admit",
            "locale": "en"
          },
          {
            "owner": "a",
