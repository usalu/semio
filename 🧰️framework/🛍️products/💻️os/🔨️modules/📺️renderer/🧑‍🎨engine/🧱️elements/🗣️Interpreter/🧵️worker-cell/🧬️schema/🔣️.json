            "locale": "de"
          },
          {
            "owner": "b",
            "action": "read"
          },
          {
            "owner": "a",
            "action": "read"
          }
        ],
        "expected": [
          {
            "owner": "a",
            "state": "ready",
            "locale": "en",
            "retained": [],
            "constructions": 1
          },
          {
            "owner": "a",
            "state": "ready",
            "locale": "en",
            "retained": [
              "a-tree"
            ],
            "constructions": 1
          },
          {
            "owner": "b",
            "state": "ready",
            "locale": "de",
            "retained": [],
            "constructions": 1
          },
          {
            "owner": "b",
            "state": "ready",
            "locale": "de",
            "retained": [],
            "constructions": 1
          },
          {
            "owner": "a",
            "state": "ready",
            "locale": "en",
            "retained": [
              "a-tree"
            ],
            "constructions": 1
          }
        ]
