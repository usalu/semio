    "properties": {
      "id": { "type": "string", "minLength": 1 }, "slot": { "enum": ["form", "status", "field", "control"] },
      "kind": { "enum": ["form", "status", "extension", "field", "input", "select", "button", "text", "slider"] },
      "children": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
