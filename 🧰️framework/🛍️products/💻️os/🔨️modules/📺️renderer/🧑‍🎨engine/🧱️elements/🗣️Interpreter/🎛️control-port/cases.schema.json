{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["surface", "revision", "cases"],
  "properties": {
    "surface": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "cases": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "state", "bindings", "trigger", "sent"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "enum": ["live", "replaced", "removed", "disabled"] },
          "bindings": { "type": "array", "items": { "enum": ["change", "commit", "activate"] } },
          "trigger": { "enum": ["change", "commit", "activate"] },
          "sent": { "type": "boolean" }
        }
      }
    }
  }
}
