    "expectedStrokes": [
      {"owner":"parent","rect":[0,0,20,1],"state":"active"},
      {"owner":"child","rect":[20,0,30,1],"state":"hover"},
      {"owner":"parent","rect":[50,0,50,1],"state":"active"}
    ]
  },
  {
    "name": "vertical siblings share the boundary without widening the hit geometry",
    "stroke": 1,
    "frames": [
      {"owner":"upper","rect":[0,0,40,20],"state":"active"},
