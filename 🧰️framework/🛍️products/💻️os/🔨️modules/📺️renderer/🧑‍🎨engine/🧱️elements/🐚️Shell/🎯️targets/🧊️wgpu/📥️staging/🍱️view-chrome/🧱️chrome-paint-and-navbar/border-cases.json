  {
    "name": "abutting sibling frames retain one hover seam and four detached edges",
    "stroke": 1,
    "frames": [
      {"owner":"active","rect":[0,0,40,20],"state":"active"},
      {"owner":"hover","rect":[40,0,40,20],"state":"hover"},
      {"owner":"detached","rect":[100,0,40,20],"state":"normal"}
