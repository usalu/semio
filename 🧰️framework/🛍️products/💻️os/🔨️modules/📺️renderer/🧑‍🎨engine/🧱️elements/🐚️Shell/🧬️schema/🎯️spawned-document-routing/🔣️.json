{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "spawned",
    "cases"
  ],
  "properties": {
    "host": {
      "$ref": "#/$defs/owner"
    },
    "spawned": {
      "$ref": "#/$defs/owner"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface",
          "controllerId",
          "ownerPath"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": [
              "string",
              "null"
            ]
          },
          "controllerId": {
            "type": "string",
            "minLength": 1
          },
          "ownerPath": {
            "enum": [
              "/host",
              "/spawned",
              null
            ]
          },
          "retired": {
            "type": "boolean"
          },
          "sharedController": {
            "type": "boolean"
          },
          "sharedApp": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "instanceId",
        "appId",
        "controllerId",
        "windowId"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "integer",
          "minimum": 1
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "controllerId": {
          "type": "string",
          "minLength": 1
        },
        "windowId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
