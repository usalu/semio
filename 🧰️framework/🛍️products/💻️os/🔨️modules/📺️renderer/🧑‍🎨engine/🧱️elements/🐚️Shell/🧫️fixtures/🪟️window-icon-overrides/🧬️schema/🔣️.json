{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "windowKindId", "kindIconId", "windowIds", "commands", "projectionFallback", "kindFallback", "retireReuse", "rejected"],
  "properties": {
    "version": { "const": 1 },
    "windowKindId": { "$ref": "#/$defs/identifier" },
    "kindIconId": { "$ref": "#/$defs/identifier" },
    "windowIds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "commands": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["windowId", "iconId", "expectedIconId"],
        "properties": {
          "windowId": { "$ref": "#/$defs/identifier" },
          "iconId": { "$ref": "#/$defs/identifier" },
          "expectedIconId": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "projectionFallback": { "$ref": "#/$defs/fallback" },
    "kindFallback": { "$ref": "#/$defs/fallback" },
    "retireReuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowId", "staleIconId", "expectedReusedIconId"],
      "properties": {
        "windowId": { "$ref": "#/$defs/identifier" },
        "staleIconId": { "$ref": "#/$defs/identifier" },
        "expectedReusedIconId": { "$ref": "#/$defs/identifier" }
      }
    },
    "rejected": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["windowId", "iconId"],
        "properties": {
          "windowId": { "type": "string", "maxLength": 256 },
          "iconId": { "type": "string", "maxLength": 256 }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowId", "templateId", "expectedIconId"],
      "properties": {
        "windowId": { "$ref": "#/$defs/identifier" },
        "templateId": { "type": ["string", "null"], "maxLength": 1024 },
        "expectedIconId": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
