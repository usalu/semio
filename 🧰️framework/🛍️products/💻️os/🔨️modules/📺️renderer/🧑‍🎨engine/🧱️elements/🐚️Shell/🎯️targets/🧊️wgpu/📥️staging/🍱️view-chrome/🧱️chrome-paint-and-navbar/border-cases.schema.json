{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Native Chrome Shared Border Cases",
  "type":"array",
  "items": {
    "type":"object",
    "required":["name","stroke","frames","expectedCounts","expectedStrokes"],
    "additionalProperties":false,
    "properties": {
      "name":{"type":"string"},
      "stroke":{"type":"number","exclusiveMinimum":0},
      "frames":{"type":"array","items":{"$ref":"#/$defs/frame"}},
      "expectedCounts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
      "expectedStrokes":{"type":"array","items":{"$ref":"#/$defs/frame"}}
    }
  },
  "$defs": {
    "frame": {
      "type":"object","required":["owner","rect","state"],"additionalProperties":false,
      "properties": {
        "owner":{"type":"string","minLength":1},
        "rect":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4},
        "state":{"enum":["normal","focus","active","waiting","loading","introduced","celebrated","hover"]}
      }
    }
  }
}
