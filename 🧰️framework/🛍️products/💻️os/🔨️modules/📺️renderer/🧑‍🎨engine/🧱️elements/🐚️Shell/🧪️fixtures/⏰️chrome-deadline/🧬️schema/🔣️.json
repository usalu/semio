{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/shell/chrome-deadline-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timing", "text", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tooltipDwellMs", "noticeDismissMs"],
      "properties": {
        "tooltipDwellMs": { "type": "number", "exclusiveMinimum": 0 },
        "noticeDismissMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tooltip", "notice"],
      "properties": {
        "tooltip": { "type": "string", "minLength": 1 },
        "notice": { "type": "string", "minLength": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "monotonicNowSeconds", "wallNowMs", "tooltipStartedMs", "noticeShownMs", "expectedDeadlineSeconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "monotonicNowSeconds": { "type": "number", "minimum": 0 },
          "wallNowMs": { "type": "number", "minimum": 0 },
          "tooltipStartedMs": { "type": ["number", "null"], "minimum": 0 },
          "noticeShownMs": { "type": ["number", "null"], "minimum": 0 },
          "expectedDeadlineSeconds": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    }
  }
}
