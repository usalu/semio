{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "windows",
    "maximized",
    "initialWeights",
    "cases",
    "localeRetitle",
    "ingressCases"
  ],
  "properties": {
    "windows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "maximized": {
      "type": "integer",
      "minimum": 0
    },
    "initialWeights": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "weights",
          "windows",
          "label",
          "maximized",
          "layoutLabel"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "enum": [
              "override",
              "default"
            ]
          },
          "weights": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "windows": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "string"
          },
          "maximized": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "layoutLabel": {
            "type": "string",
            "minLength": 1
          },
          "templateId": {
            "type": "string",
            "minLength": 1
          },
          "extraId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "localeRetitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraId",
        "kindId",
        "bakedTitle",
        "retainedTitle",
        "maximized",
        "resolvedTitle",
        "locale"
      ],
      "properties": {
        "extraId": {
          "type": "string",
          "minLength": 1
        },
        "kindId": {
          "type": "string",
          "minLength": 1
        },
        "bakedTitle": {
          "type": "string",
          "minLength": 1
        },
        "retainedTitle": { "type": "string" },
        "maximized": { "type": "integer", "minimum": 0 },
        "resolvedTitle": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ingressCases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stacks",
          "windows",
          "extras",
          "stackPaths",
          "templates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stacks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "windowKindId"
                ],
                "properties": {
                  "windowKindId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "instanceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "templateId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "windows": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extras": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stackPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "templates": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "previousStacks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "windowKindId"
                ],
                "properties": {
                  "windowKindId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "instanceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "templateId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
