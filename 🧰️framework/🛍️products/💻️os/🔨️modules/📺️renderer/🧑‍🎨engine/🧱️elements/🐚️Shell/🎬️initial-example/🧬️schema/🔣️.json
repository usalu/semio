{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event",
                "instance",
                "enabled",
                "ready",
                "starts"
              ],
              "properties": {
                "event": {
                  "enum": [
                    "render",
                    "settle",
                    "reject",
                    "complete",
                    "publish"
                  ]
                },
                "instance": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "ready": {
                  "type": "boolean"
                },
                "starts": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
