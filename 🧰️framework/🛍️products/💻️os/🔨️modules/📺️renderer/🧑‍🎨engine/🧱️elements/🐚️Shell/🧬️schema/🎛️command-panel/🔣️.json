{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locales",
    "commands",
    "zeroArgumentKeys",
    "expandKey",
    "singletonKey",
    "staged",
    "rowRole",
    "formActions",
    "formDefaultOpen"
  ],
  "properties": {
    "locales": {
      "const": [
        "en",
        "de"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "key",
          "category",
          "labels",
          "args"
        ],
        "properties": {
          "address": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "commandId"
                ],
                "properties": {
                  "owner": {
                    "const": "os"
                  },
                  "commandId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "commandId"
                ],
                "properties": {
                  "owner": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "plugin"
                    ],
                    "properties": {
                      "plugin": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "pluginId"
                        ],
                        "properties": {
                          "pluginId": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "commandId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "commandId"
                ],
                "properties": {
                  "owner": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "app"
                    ],
                    "properties": {
                      "app": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "pluginId",
                          "appId"
                        ],
                        "properties": {
                          "pluginId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "appId": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "commandId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "commandId"
                ],
                "properties": {
                  "owner": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode"
                    ],
                    "properties": {
                      "mode": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "pluginId",
                          "appId",
                          "modeId"
                        ],
                        "properties": {
                          "pluginId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "appId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "modeId": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "commandId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "labels",
                "required"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "en",
                    "de"
                  ],
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "de": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "zeroArgumentKeys": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expandKey": {
      "type": "string",
      "minLength": 1
    },
    "singletonKey": {
      "type": "string",
      "minLength": 1
    },
    "staged": {
      "type": "object",
      "required": [
        "themeId"
      ],
      "additionalProperties": false,
      "properties": {
        "themeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rowRole": {
      "const": "treeitem"
    },
    "formActions": {
      "const": [
        "execute",
        "reset"
      ]
    },
    "formDefaultOpen": {
      "const": false
    }
  }
}
