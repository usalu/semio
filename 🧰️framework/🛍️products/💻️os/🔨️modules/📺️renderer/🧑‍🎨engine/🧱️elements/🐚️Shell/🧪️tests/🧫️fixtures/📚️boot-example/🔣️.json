      "options": ["hexagonal-mushroom-column", "rectangle-extrude-volume", "sphere-cut-with-torus"],
      "defaultExampleId": "sphere-cut-with-torus",
      "expected": "rectangle-extrude-volume"
    },
    {
      "id": "an-active-id-the-dialect-does-not-author-falls-back",
