      "expected": { "cancellable": true, "cancelAction": "cancelPreviewEval" }
    },
    {
      "id": "a-cancellable-status-naming-no-action-offers-nothing",
      "statusJson": "{\"computing\":true,\"phase\":\"meshingFaces\",\"cancellable\":true,\"cancelAction\":\"\"}",
      "expected": { "cancellable": false, "cancelAction": "" }
    },
    {
      "id": "a-producer-that-cannot-be-stopped-offers-nothing",
      "statusJson": "{\"computing\":true,\"phase\":\"meshingFaces\",\"cancellable\":false,\"cancelAction\":\"cancelPreviewEval\"}",
      "expected": { "cancellable": false, "cancelAction": "cancelPreviewEval" }
    },
    {
      "id": "an-absent-cancellable-flag-offers-nothing",
      "statusJson": "{\"computing\":true,\"phase\":\"meshingFaces\",\"cancelAction\":\"cancelPreviewEval\"}",
      "expected": { "cancellable": false, "cancelAction": "cancelPreviewEval" }
    },
    {
      "id": "a-hostile-cancellable-type-offers-nothing",
      "statusJson": "{\"computing\":true,\"cancellable\":\"true\",\"cancelAction\":\"cancelPreviewEval\"}",
      "expected": { "cancellable": false, "cancelAction": "cancelPreviewEval" }
    },
    {
      "id": "malformed-json-degrades-to-the-neutral-status",
      "statusJson": "{not json",
      "expected": { "cancellable": false, "cancelAction": "" }
    },
    {
      "id": "a-non-object-status-degrades-to-the-neutral-status",
      "statusJson": "[1,2,3]",
      "expected": { "cancellable": false, "cancelAction": "" }
    },
    {
      "id": "an-empty-status-degrades-to-the-neutral-status",
      "statusJson": "",
      "expected": { "cancellable": false, "cancelAction": "" }
    },
    {
      "id": "no-status-at-all-offers-nothing",
      "statusJson": null,
      "expected": { "cancellable": false, "cancelAction": "" }
    }
  ],
  "surfaceControls": [
