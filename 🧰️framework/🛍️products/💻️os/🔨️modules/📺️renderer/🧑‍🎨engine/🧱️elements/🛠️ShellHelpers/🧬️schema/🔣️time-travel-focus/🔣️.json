{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/renderer/shell-helpers/time-travel-focus/schema.json",
  "title": "Time Travel Focus",
  "description": "Where keyboard focus goes on each edge of a history-edit session (ticket 26/09/30 NON-DESTRUCTIVE-HISTORY-EDITING, design §16, gap G13): per case the session before and after one `HistoryPatch.timeTravel` (`null` = no session) and the focus target the edge asks for (`null` = focus stays). Targets are the draft editor, the history body's Next problem button, the finalize prompt or one band control; `keys` names the history-body nodes the first two resolve to, `fallbacks` the band control taken when the target is not on screen within `settleMs`. Target-neutral: the React and the wgpu shell read the same corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "settleMs", "keys", "fallbacks", "cases"],
  "definitions": {
    "Session": {
      "oneOf": [{ "type": "null" }, { "$ref": "https://json.schemas.assets.semio-tech.com/framework/kernel/history-patch/schema.json#/definitions/HistoryTimeTravel" }]
    },
    "Control": { "type": "string", "enum": ["accept", "discard", "cancelReplay", "rerun", "finalize", "back", "exit"] },
    "Focus": {
      "oneOf": [{ "type": "null" }, { "type": "string", "enum": ["editor", "nextProblem", "dialog"] }, { "$ref": "#/definitions/Control" }]
    },
    "Key": { "type": "string", "pattern": "^framework\\.history\\.[A-Za-z.]+$" },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "previous", "next", "focus"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "previous": { "$ref": "#/definitions/Session" },
        "next": { "$ref": "#/definitions/Session" },
        "focus": { "$ref": "#/definitions/Focus" }
      }
    }
  },
  "properties": {
    "description": { "type": "string" },
    "settleMs": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editorInputs", "editorAccept", "nextProblem"],
      "properties": {
        "editorInputs": { "$ref": "#/definitions/Key" },
        "editorAccept": { "$ref": "#/definitions/Key" },
        "nextProblem": { "$ref": "#/definitions/Key" }
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editor", "nextProblem"],
      "properties": {
        "editor": { "$ref": "#/definitions/Control" },
        "nextProblem": { "$ref": "#/definitions/Control" }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Case" } }
  }
}
