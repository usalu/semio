{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "events", "ready"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "events": {
            "type": "array",
            "items": { "enum": ["begin", "publish", "invalidate", "retire", "replace-owner", "replace-plugin", "publish-old"] }
          },
          "ready": { "type": "boolean" }
        }
      }
    }
  }
}
