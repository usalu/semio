{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/renderer/operation-publication.fixture.json",
  "title": "OperationPublicationFixture",
  "description": "What a shell owes each guest publication that answers no host call: whether a host queues it, the dirty scope it refreshes with no further dispatch, and whether the person is told a notice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "note", "capacity", "historyBodyKey", "rows"],
  "$defs": {
    "scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["full", "none"] } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "partial" },
            "windowBodies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "panelBodies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "utilities": { "type": "boolean" },
            "tools": { "type": "boolean" },
            "engagements": { "type": "boolean" },
            "measures": { "type": "boolean" },
            "labels": { "type": "boolean" }
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed"],
      "properties": {
        "completed": { "type": "boolean" },
        "uiScope": { "$ref": "#/$defs/scope" },
        "historyPatch": { "type": "object", "required": ["cursor"], "properties": { "cursor": { "type": "integer", "minimum": 0 } } },
        "fault": { "type": "string", "minLength": 1 },
        "resync": { "const": true }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string", "minLength": 1 },
    "capacity": { "type": "integer", "minimum": 1 },
    "historyBodyKey": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "publication", "queued", "refresh", "told"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "publication": { "$ref": "#/$defs/publication" },
          "queued": { "type": "boolean" },
          "refresh": { "$ref": "#/$defs/scope" },
          "told": { "type": "boolean" }
        }
      }
    }
  }
}
