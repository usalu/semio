{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/renderer/automatic-checkin.fixture.json",
  "title": "AutomaticCheckinFixture",
  "description": "The states in which an automatic check-in waits, and editor-session timelines with the times at which a check-in is dispatched or deferred. A timeline starts with a document at rest (not loading, not attached).",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "note", "idleMs", "threshold", "waits", "timelines"],
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loading", "attached", "bound"],
      "properties": { "loading": { "type": "boolean" }, "attached": { "type": "boolean" }, "bound": { "type": "boolean" } }
    },
    "event": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": { "notify": { "type": "integer", "minimum": 0 }, "advance": { "type": "integer", "minimum": 1 }, "document": { "$ref": "#/$defs/document" } }
    },
    "times": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
  },
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string", "minLength": 1 },
    "idleMs": { "type": "integer", "minimum": 1 },
    "threshold": { "type": "integer", "minimum": 1 },
    "waits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "document", "waits"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "document": { "$ref": "#/$defs/document" }, "waits": { "type": "boolean" } }
      }
    },
    "timelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "events", "dispatched", "deferred"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } },
          "dispatched": { "$ref": "#/$defs/times" },
          "deferred": { "$ref": "#/$defs/times" }
        }
      }
    }
  }
}
