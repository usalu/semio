{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locales",
    "viewports",
    "fontSize",
    "lineHeight",
    "padding",
    "centerTolerance"
  ],
  "properties": {
    "locales": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "enum": [
              "en",
              "de"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "width",
          "height",
          "wraps"
        ],
        "properties": {
          "width": {
            "type": "number",
            "minimum": 1
          },
          "height": {
            "type": "number",
            "minimum": 1
          },
          "wraps": {
            "type": "boolean"
          }
        }
      }
    },
    "fontSize": {
      "type": "number",
      "minimum": 1
    },
    "lineHeight": {
      "type": "number",
      "minimum": 1
    },
    "padding": {
      "type": "number",
      "minimum": 0
    },
    "centerTolerance": {
      "type": "number",
      "minimum": 0
    }
  }
}
