{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/renderer/shell-helpers/time-travel-band/schema.json",
  "title": "Time Travel Band",
  "description": "What a shell shows and dispatches for one live history-edit session (`HistoryPatch.timeTravel`, ticket 26/09/30 NON-DESTRUCTIVE-HISTORY-EDITING): the band's lines per locale (`null` = the line is absent; `review` is the session's own review status and is never inferred from a missing report), its controls in order with the refusal key that disables one, the verb each dispatches (args carry the session generation), the default chord and `aria-keyshortcuts` of the three remappable controls, the window indicator's accessible name per locale, and the notice text and severity of every history-edit refusal code a shell names when it arrives without a severity of its own. Target-neutral: the React band and the wgpu band read the same corpus, and the node keys of the Rust-produced draft editor (`time_travel_editor_sections`) that a shell's focus moves to.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "controllerId",
    "axes",
    "chords",
    "cases",
    "refusals",
    "transitions",
    "editorKeys"
  ],
  "definitions": {
    "Line": {
      "type": [
        "string",
        "null"
      ]
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "target",
        "progress",
        "review",
        "outcome",
        "fault",
        "accepted"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/definitions/Line"
        },
        "progress": {
          "$ref": "#/definitions/Line"
        },
        "review": {
          "$ref": "#/definitions/Line"
        },
        "outcome": {
          "$ref": "#/definitions/Line"
        },
        "fault": {
          "$ref": "#/definitions/Line"
        },
        "accepted": {
          "$ref": "#/definitions/Line"
        }
      }
    },
    "Locales": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Control": {
      "type": "string",
      "enum": [
        "accept",
        "discard",
        "cancelReplay",
        "rerun",
        "finalize",
        "back",
        "exit"
      ]
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "session",
        "text",
        "controls",
        "indicator"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/kernel/history-patch/schema.json#/definitions/HistoryTimeTravel"
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "de"
          ],
          "properties": {
            "en": {
              "$ref": "#/definitions/Text"
            },
            "de": {
              "$ref": "#/definitions/Text"
            }
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control",
              "action",
              "disabledBy"
            ],
            "properties": {
              "control": {
                "$ref": "#/definitions/Control"
              },
              "action": {
                "type": "string",
                "pattern": "^historyEdit[A-Z][A-Za-z]+$"
              },
              "disabledBy": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^ui\\.timeTravel\\.refusal\\.[a-z]+$"
              }
            }
          }
        },
        "indicator": {
          "$ref": "#/definitions/Locales"
        }
      }
    },
    "Chord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlId",
        "keys",
        "aria"
      ],
      "properties": {
        "controlId": {
          "type": "string",
          "pattern": "^ui\\.timeTravel\\.(accept|discard|exit)$"
        },
        "keys": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^|[+,])escape($|[+,])"
          }
        },
        "aria": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "text",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(history|timeTravel)\\.[a-z-]+$"
        },
        "text": {
          "$ref": "#/definitions/Locales"
        },
        "severity": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/kernel/history-patch/schema.json#/definitions/Severity"
        }
      }
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "from",
        "to",
        "reveal",
        "focus"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "https://json.schemas.assets.semio-tech.com/framework/kernel/history-patch/schema.json#/definitions/HistoryTimeTravel"
                },
                {
                  "required": [
                    "blocking",
                    "acceptedCount"
                  ]
                }
              ]
            }
          ]
        },
        "to": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "https://json.schemas.assets.semio-tech.com/framework/kernel/history-patch/schema.json#/definitions/HistoryTimeTravel"
                },
                {
                  "required": [
                    "blocking",
                    "acceptedCount"
                  ]
                }
              ]
            }
          ]
        },
        "reveal": {
          "type": "boolean"
        },
        "focus": {
          "enum": [
            null,
            "editor",
            "band",
            "dialog"
          ]
        }
      }
    },
    "EditorKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "row"
      ],
      "description": "One editor control's node key and the key of the tree row holding it (`{control}.row`).",
      "properties": {
        "control": {
          "type": "string",
          "pattern": "^framework\\.history\\.editor\\.[A-Za-z0-9_.]+$"
        },
        "row": {
          "type": "string",
          "pattern": "^framework\\.history\\.editor\\.[A-Za-z0-9_.]+$"
        }
      }
    },
    "EditorInputKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer",
        "control",
        "row"
      ],
      "description": "The node keys of the input row editing `pointer` (a JSON pointer into the mutation's payload; object fields flatten into their own rows): `framework.history.editor.input` followed by the pointer with `.` for `/`.",
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9_]+)+$"
        },
        "control": {
          "type": "string",
          "pattern": "^framework\\.history\\.editor\\.[A-Za-z0-9_.]+$"
        },
        "row": {
          "type": "string",
          "pattern": "^framework\\.history\\.editor\\.[A-Za-z0-9_.]+$"
        }
      }
    }
  },
  "properties": {
    "description": {
      "type": "string"
    },
    "controllerId": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminology"
      ],
      "properties": {
        "terminology": {
          "type": "string",
          "enum": [
            "native",
            "reuse"
          ]
        }
      }
    },
    "chords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accept",
        "discard",
        "exit"
      ],
      "properties": {
        "accept": {
          "$ref": "#/definitions/Chord"
        },
        "discard": {
          "$ref": "#/definitions/Chord"
        },
        "exit": {
          "$ref": "#/definitions/Chord"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Case"
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Refusal"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Transition"
      }
    },
    "editorKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel",
        "accept",
        "inputs"
      ],
      "description": "The draft editor's node keys both the Rust producer and every shell's focus resolution agree on: the History panel tab the body is mounted in, Accept (the focus fallback without inputs) and the input rows.",
      "properties": {
        "panel": {
          "type": "string",
          "minLength": 1
        },
        "accept": {
          "$ref": "#/definitions/EditorKey"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/EditorInputKey"
          }
        }
      }
    }
  }
}
