{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window Instance Title Authority Across Locales",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "windowKind", "instances", "retainedViewport", "singleton", "transitions", "renames", "explicitBaseTitle", "owners", "projectionBranches", "retainedOrientations"],
  "properties": {
    "version": { "const": 1 },
    "windowKind": { "type": "string" },
    "explicitBaseTitle": { "type": "string" },
    "retainedOrientations": { "type": "array", "minItems": 2, "items": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "view"], "properties": { "type": { "const": "cardinal" }, "view": { "const": "front" } } },
      { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "free" } } }
    ] } },
    "projectionBranches": {
      "type": "array", "minItems": 4,
      "items": { "type": "object", "additionalProperties": false, "required": ["pressed", "effective", "title", "icon", "family"], "properties": { "pressed": { "type": "string" }, "effective": { "type": "string" }, "title": { "type": "string" }, "icon": { "type": "string" }, "family": { "enum": ["orthographic", "perspective"] } } }
    },
    "owners": {
      "type": "array", "minItems": 4,
      "items": { "type": "object", "additionalProperties": false, "required": ["pluginId", "appId", "instanceId"], "properties": { "pluginId": { "type": "string" }, "appId": { "type": "string" }, "instanceId": { "type": "integer", "minimum": 0 } } }
    },
    "renames": {
      "type": "array", "minItems": 2,
      "items": { "type": "object", "additionalProperties": false, "required": ["windowId", "title"], "properties": { "windowId": { "type": "string" }, "title": { "type": "string" } } }
    },
    "instances": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "initialProjection", "projectionTitle", "projectionIcon"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" },
          "projectionTitle": { "type": "string" }, "projectionIcon": { "type": "string" },
          "initialProjection": {
            "type": "object", "additionalProperties": false, "required": ["mode", "orientation"],
            "properties": {
              "mode": {
                "oneOf": [
                  { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "orthographic" } } },
                  { "type": "object", "additionalProperties": false, "required": ["kind", "fov"], "properties": { "kind": { "const": "threePoint" }, "fov": { "type": "number", "exclusiveMinimum": 0 } } }
                ]
              },
              "orientation": {
                "oneOf": [
                  { "type": "object", "additionalProperties": false, "required": ["type", "view"], "properties": { "type": { "const": "cardinal" }, "view": { "const": "top" } } },
                  { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "free" } } }
                ]
              }
            }
          }
        }
      }
    },
    "retainedViewport": {
      "type": "object", "additionalProperties": false,
      "required": ["windowId", "owner", "authoredTitle", "selectedTitle", "selectedIcon", "initialProjection", "selectedCamera"],
      "properties": {
        "windowId": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "authoredTitle": { "type": "string", "minLength": 1 },
        "selectedTitle": { "type": "string", "minLength": 1 },
        "selectedIcon": { "type": "string", "minLength": 1 },
        "initialProjection": {
          "type": "object", "additionalProperties": false, "required": ["mode", "orientation"],
          "properties": {
            "mode": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "orthographic" } } },
            "orientation": { "type": "object", "additionalProperties": false, "required": ["type", "view"], "properties": { "type": { "const": "cardinal" }, "view": { "const": "top" } } }
          }
        },
        "selectedCamera": {
          "type": "object", "additionalProperties": false,
          "required": ["position", "target", "zoom", "projection", "fov", "projectionSpec"],
          "properties": {
            "position": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "items": false, "minItems": 3, "maxItems": 3 },
            "target": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "items": false, "minItems": 3, "maxItems": 3 },
            "zoom": { "type": "number", "exclusiveMinimum": 0 },
            "projection": { "const": "orthographic" },
            "fov": { "type": "number", "exclusiveMinimum": 0 },
            "projectionSpec": {
              "type": "object", "additionalProperties": false, "required": ["mode", "orientation"],
              "properties": {
                "mode": { "type": "object", "additionalProperties": false, "required": ["kind", "variant"], "properties": { "kind": { "const": "axonometric" }, "variant": { "const": "isometric" } } },
                "orientation": { "type": "object", "additionalProperties": false, "required": ["type", "view"], "properties": { "type": { "const": "cardinal" }, "view": { "const": "top" } } }
              }
            }
          }
        }
      }
    },
    "singleton": {
      "type": "object", "additionalProperties": false, "required": ["id", "en", "de"],
      "properties": { "id": { "type": "string" }, "en": { "type": "string" }, "de": { "type": "string" } }
    },
    "transitions": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["locale", "titles"],
        "properties": {
          "locale": { "enum": ["en", "de"] },
          "titles": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
        }
      }
    }
  }
}
