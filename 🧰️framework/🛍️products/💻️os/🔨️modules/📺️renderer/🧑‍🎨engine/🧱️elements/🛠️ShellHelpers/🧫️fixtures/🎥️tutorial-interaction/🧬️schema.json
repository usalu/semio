{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.renderer.tutorial-interaction.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["capture", "observed", "playbackBefore", "snapshotSelection", "delta", "afterDelta", "clearDelta", "afterClear"],
  "properties": {
    "capture": { "$ref": "#/definitions/capture" },
    "observed": { "$ref": "https://semio.tech/schema/framework/interaction/component.json#/$defs/InteractionState" },
    "playbackBefore": { "$ref": "https://semio.tech/schema/framework/interaction/component.json#/$defs/InteractionState" },
    "snapshotSelection": { "$ref": "#/definitions/selection" },
    "delta": { "$ref": "#/definitions/change" },
    "afterDelta": { "$ref": "https://semio.tech/schema/framework/interaction/component.json#/$defs/InteractionState" },
    "clearDelta": { "$ref": "#/definitions/change" },
    "afterClear": { "$ref": "https://semio.tech/schema/framework/interaction/component.json#/$defs/InteractionState" }
  },
  "definitions": {
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "state"],
      "properties": {
        "identity": { "$ref": "#/definitions/identity" },
        "state": { "$ref": "#/definitions/localState" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appInstanceId", "generation", "revision", "documentRevision", "topologyRevision"],
      "properties": {
        "appInstanceId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "generation": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "documentRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "topologyRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "localState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "activeMode", "activeGranularity"],
      "properties": {
        "selection": { "$ref": "#/definitions/selection" },
        "activeMode": { "type": "object", "additionalProperties": { "$ref": "https://semio.tech/schema/framework/interaction/component.json#/$defs/SelectionMode" } },
        "activeGranularity": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": { "$ref": "https://semio.tech/schema/framework/interaction/component.json#/$defs/DomainSelection" }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "domainId", "granularity", "ids"],
      "properties": {
        "kind": { "const": "selection" },
        "domainId": { "type": "string", "minLength": 1 },
        "granularity": { "type": "string", "minLength": 1 },
        "ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
