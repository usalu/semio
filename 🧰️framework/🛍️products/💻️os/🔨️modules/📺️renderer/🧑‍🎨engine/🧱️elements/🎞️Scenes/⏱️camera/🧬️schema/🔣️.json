{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.dev/schema/scene-camera/storage/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "maximumEntries",
    "maximumIdentifierBytes",
    "rootGrant",
    "identityFields",
    "cases",
    "lifecycle",
    "refusal",
    "semanticRules"
  ],
  "properties": {
    "contract": {
      "const": "semio.scene-camera.storage.v1"
    },
    "maximumEntries": {
      "const": 256
    },
    "maximumIdentifierBytes": {
      "const": 256
    },
    "rootGrant": {
      "$ref": "https://semio.dev/schema/value/retained-clone/grant"
    },
    "identityFields": {
      "const": [
        "host",
        "surface",
        "ownerHost",
        "ownerWindow",
        "ownerSurface",
        "ownerExplicitKey"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "host",
          "surface",
          "owner",
          "packed",
          "deadlineMs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "owner": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "documentId",
                  "host",
                  "window",
                  "surface",
                  "windowGeneration",
                  "componentGeneration",
                  "kind",
                  "key",
                  "node"
                ],
                "properties": {
                  "documentId": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "host": {
                    "type": "string"
                  },
                  "window": {
                    "type": "string"
                  },
                  "surface": {
                    "type": "string"
                  },
                  "windowGeneration": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "componentGeneration": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "kind": {
                    "type": "string"
                  },
                  "key": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "explicit"
                        ],
                        "properties": {
                          "explicit": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "positional"
                        ],
                        "properties": {
                          "positional": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295
                            }
                          }
                        }
                      }
                    ]
                  },
                  "node": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "index",
                      "generation"
                    ],
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "generation": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  }
                }
              }
            ]
          },
          "packed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hex",
              "bytes",
              "ranges"
            ],
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})*$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "ranges": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "deadlineMs": {
            "type": "number"
          }
        }
      }
    },
    "lifecycle": {
      "const": [
        "admit-original-packed-body",
        "transfer-original-directory",
        "dispatch-or-restore-original-record",
        "release-original-packed-body",
        "release-original-directory"
      ]
    },
    "refusal": {
      "const": {
        "ownerUnchanged": true,
        "receipt": {
          "copiedItems": 0,
          "copiedBytes": 0,
          "retainedCapacityBytes": 0,
          "releasedBytes": 0
        }
      }
    },
    "semanticRules": {
      "const": {
        "replacement": "latest deadline for same host; original owner equality uses every component witness field",
        "future": "return same original record unless newer same-host record exists",
        "retired": "retain original body for paid release; do not restore retired component",
        "terminal": "body owners and original directory backing absent"
      }
    }
  }
}
