{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/world3d/gumball-live-protocol",
  "title": "Gumball Live Protocol",
  "description": "Event scripts of one World3d gumball gesture and the exact verb dispatch each event owes: the host side of the gumball tool protocol (local one-shot delta, live stream/commit/abort ticks). A case's `live`, `transformMode` and `targets` fill every `start` event, its `targets` every `release` event. `guest` is what an app consuming the dispatches must publish when the case's target ids are replaced by one movable node of its own document.",
  "type": "object",
  "required": ["why", "cases"],
  "additionalProperties": false,
  "properties": {
    "why": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "number3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "pose": {
      "type": "object",
      "required": ["position", "quaternion", "scale"],
      "additionalProperties": false,
      "properties": {
        "position": { "$ref": "#/$defs/number3" },
        "quaternion": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "scale": { "$ref": "#/$defs/number3" }
      }
    },
    "handle": { "enum": ["moveX", "moveY", "moveZ", "moveXY", "moveYZ", "moveXZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ", "scaleXY", "scaleYZ", "scaleXZ", "scaleUniform"] },
    "targets": {
      "type": "object",
      "required": ["mode", "ids"],
      "additionalProperties": false,
      "properties": { "mode": { "type": "string", "minLength": 1 }, "ids": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    },
    "event": {
      "oneOf": [
        { "type": "object", "required": ["kind", "handle", "pose"], "additionalProperties": false, "properties": { "kind": { "const": "start" }, "handle": { "$ref": "#/$defs/handle" }, "pose": { "$ref": "#/$defs/pose" } } },
        { "type": "object", "required": ["kind", "handle", "pose"], "additionalProperties": false, "properties": { "kind": { "const": "drag" }, "handle": { "$ref": "#/$defs/handle" }, "pose": { "$ref": "#/$defs/pose" } } },
        { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "const": "settled" } } },
        { "type": "object", "required": ["kind", "handle", "before", "after"], "additionalProperties": false, "properties": { "kind": { "const": "release" }, "handle": { "$ref": "#/$defs/handle" }, "before": { "$ref": "#/$defs/pose" }, "after": { "$ref": "#/$defs/pose" } } },
        { "type": "object", "required": ["kind", "reason"], "additionalProperties": false, "properties": { "kind": { "const": "cancel" }, "reason": { "enum": ["blur", "captureLost"] } } }
      ]
    },
    "dispatch": {
      "type": "object",
      "required": ["action", "args"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["translateSelection", "rotateSelection", "scaleSelection"] },
        "args": {
          "type": "object",
          "required": ["mode", "ids"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string" },
            "ids": { "type": "array", "items": { "type": "string" } },
            "dx": { "type": "number" }, "dy": { "type": "number" }, "dz": { "type": "number" },
            "ax": { "type": "number" }, "ay": { "type": "number" }, "az": { "type": "number" }, "angle": { "type": "number" },
            "sx": { "type": "number" }, "sy": { "type": "number" }, "sz": { "type": "number" },
            "phase": { "enum": ["stream", "commit", "abort"] },
            "reason": { "enum": ["blur", "captureLost"] }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["event", "dispatch"],
      "additionalProperties": false,
      "properties": {
        "event": { "$ref": "#/$defs/event" },
        "dispatch": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dispatch" }] },
        "skipped": { "enum": ["no-selection-ids", "no-delta"] }
      }
    },
    "case": {
      "type": "object",
      "required": ["name", "live", "transformMode", "targets", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "live": { "type": "boolean" },
        "transformMode": { "enum": ["move", "rotate", "scale", "transform"] },
        "targets": { "$ref": "#/$defs/targets" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "guest": {
          "type": "object",
          "required": ["edits", "offset"],
          "additionalProperties": false,
          "properties": { "edits": { "type": "integer", "minimum": 0 }, "offset": { "$ref": "#/$defs/number3" } }
        }
      }
    }
  }
}
