{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/world3d/gumball-selection",
  "title": "Gumball Selection Targets",
  "description": "Opaque gesture targets are captured separately from rendered instance IDs; an explicit empty target array disables a transform.",
  "type": "object",
  "properties": {
    "ids": {
      "$ref": "#/$defs/ids"
    },
    "gumballSelectionIds": {
      "$ref": "#/$defs/ids"
    },
    "selectionMode": {
      "type": "string"
    },
    "granularity": {
      "type": "string"
    },
    "componentIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "maxItems": 600000,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
