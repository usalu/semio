{
  "field": "meshesJson",
  "contract": {
    "identityKey": "the element TEXT of a mesh inside meshesJson",
    "fallbackIsAlwaysCorrect": true,
    "fallbackRebuildsEverything": true,
    "disposeOnRemove": true
  },
  "cases": [
    {
      "name": "a first parse retains nothing and builds every mesh",
      "previousMeshesJson": null,
      "meshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"b\",\"data\":{\"positions\":[1,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "expect": { "ids": ["a", "b"], "reusedIds": [], "built": 2 }
    },
    {
      "name": "an unchanged payload reuses every record",
      "previousMeshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"b\",\"data\":{\"positions\":[1,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "meshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"b\",\"data\":{\"positions\":[1,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "expect": { "ids": ["a", "b"], "reusedIds": ["a", "b"], "built": 0 }
    },
    {
      "name": "one moved mesh of three reuses the other two",
      "previousMeshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"b\",\"data\":{\"positions\":[1,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"c\",\"data\":{\"positions\":[2,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "meshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"b\",\"data\":{\"positions\":[9,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"c\",\"data\":{\"positions\":[2,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "expect": { "ids": ["a", "b", "c"], "reusedIds": ["a", "c"], "built": 1 }
    },
    {
      "name": "a removed mesh drops out and retires its visuals",
      "previousMeshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"b\",\"data\":{\"positions\":[1,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "meshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "expect": { "ids": ["a"], "reusedIds": ["a"], "built": 0 }
    },
    {
      "name": "one slider edit rebuilds only the branch downstream of the knob",
      "note": "The generation3d hex column publishes one mesh per previewing output channel. Moving `Column Height` changes the extrusion axis and the extruded solid and leaves the profile wire's content address alone, so the host must rebuild two buffers and keep the third — the delivery half of the guest's own tessellation cache.",
      "previousMeshesJson": "[{\"id\":\"eval-profile@wire#0\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"eval-extrusion-axis@vectorOut#0\",\"data\":{\"positions\":[0,0,6],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"eval-extrude@solid#0\",\"data\":{\"positions\":[0,0,6],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "meshesJson": "[{\"id\":\"eval-profile@wire#0\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"eval-extrusion-axis@vectorOut#0\",\"data\":{\"positions\":[0,0,7],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"eval-extrude@solid#0\",\"data\":{\"positions\":[0,0,7],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "expect": { "ids": ["eval-profile@wire#0", "eval-extrusion-axis@vectorOut#0", "eval-extrude@solid#0"], "reusedIds": ["eval-profile@wire#0"], "built": 2 }
    },
    {
      "name": "a mid-gesture payload that omits a still-computing branch takes it off screen",
      "note": "The host can only deliver what the payload carries: a guest that publishes nothing for a node whose extension request is still crossing retires that mesh and the geometry disappears until the answer lands. Measured on :6025 as three meshes falling to one for 1.4 s of a 2.7 s re-evaluation. The fix is the guest's painted evaluation, not a host rule — this case is the statement of what the host does with such a payload, so the guest half can never be reintroduced unnoticed.",
      "previousMeshesJson": "[{\"id\":\"eval-profile@wire#0\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"eval-extrusion-axis@vectorOut#0\",\"data\":{\"positions\":[0,0,6],\"normals\":[0,1,0],\"indices\":[0]}},{\"id\":\"eval-extrude@solid#0\",\"data\":{\"positions\":[0,0,6],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "meshesJson": "[{\"id\":\"eval-profile@wire#0\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "expect": { "ids": ["eval-profile@wire#0"], "reusedIds": ["eval-profile@wire#0"], "built": 0 }
    },
    {
      "name": "an empty payload retains nothing",
      "previousMeshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "meshesJson": "[]",
      "expect": { "ids": [], "reusedIds": [], "built": 0 }
    },
    {
      "name": "a malformed payload falls back to the whole-document parse",
      "previousMeshesJson": "[{\"id\":\"a\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "meshesJson": "not json",
      "expect": { "ids": [], "reusedIds": [], "built": 0 }
    },
    {
      "name": "a mesh whose text carries a bracket inside a string still splits",
      "previousMeshesJson": null,
      "meshesJson": "[{\"id\":\"a],[\",\"data\":{\"positions\":[0,0,0],\"normals\":[0,1,0],\"indices\":[0]}}]",
      "expect": { "ids": ["a],["], "reusedIds": [], "built": 1 }
    }
  ],
  "splitCases": [
    { "json": "[]", "elements": [] },
    { "json": "[1,2,3]", "elements": ["1", "2", "3"] },
    { "json": "[{\"a\":[1,2]},{\"b\":\"x,y\"}]", "elements": ["{\"a\":[1,2]}", "{\"b\":\"x,y\"}"] },
    { "json": "[\"a\\\"b\",\"c\"]", "elements": ["\"a\\\"b\"", "\"c\""] },
    { "json": "{\"a\":1}", "elements": null },
    { "json": "[1,]", "elements": null },
    { "json": "[1,2", "elements": null }
  ]
}
