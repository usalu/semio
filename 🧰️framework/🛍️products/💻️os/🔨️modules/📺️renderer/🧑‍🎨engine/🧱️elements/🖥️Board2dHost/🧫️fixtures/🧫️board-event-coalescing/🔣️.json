{
  "cases": [
    {
      "name": "an empty batch dispatches nothing",
      "rows": [],
      "expect": { "flushNow": false, "camera": null, "events": [] }
    },
    {
      "name": "live-preview frames, chrome and hover never dispatch",
      "rows": [
        { "name": "nodeMove", "payload": { "id": "node-a", "x": 10, "y": 20 } },
        { "name": "transformPreview", "payload": { "moves": [{ "id": "node-a", "x": 1, "y": 2 }] } },
        { "name": "hover", "payload": { "id": "node-a", "kind": null } },
        { "name": "preselect", "payload": { "ids": ["node-a"], "removedIds": [] } },
        { "name": "brushPreview", "payload": { "node": null, "edge": null } },
        { "name": "linkCompatibleNodes", "payload": { "source": "node-a:h0", "nodeIds": [] } },
        { "name": "linkTargetRing", "payload": { "source": "node-a:h0", "nodeId": null, "handleIds": [] } }
      ],
      "expect": { "flushNow": false, "camera": null, "events": [] }
    },
    {
      "name": "a pan is camera rows only: its latest camera leaves on the view lane, no board row, and it waits",
      "rows": [
        { "name": "camera", "payload": { "x": 1, "y": 1, "zoom": 1 } },
        { "name": "camera", "payload": { "x": 2, "y": 3, "zoom": 1.5 } }
      ],
      "expect": { "flushNow": false, "camera": { "x": 2, "y": 3, "zoom": 1.5 }, "events": [] }
    },
    {
      "name": "an untagged select flushes at once and the latest camera leaves beside it",
      "rows": [
        { "name": "camera", "payload": { "x": 1, "y": 1, "zoom": 1 } },
        { "name": "select", "payload": { "ids": ["node-a"], "exitHighlightIds": [] } },
        { "name": "camera", "payload": { "x": 4, "y": 4, "zoom": 2 } }
      ],
      "expect": {
        "flushNow": true,
        "camera": { "x": 4, "y": 4, "zoom": 2 },
        "events": [{ "name": "select", "payload": { "ids": ["node-a"], "exitHighlightIds": [] } }]
      }
    },
    {
      "name": "one drag is its select and its record in one batch, its frames dropped",
      "rows": [
        { "name": "select", "payload": { "ids": ["node-a", "node-b"], "exitHighlightIds": [], "gestureId": "gesture-1" } },
        { "name": "nodeMove", "payload": { "id": "node-a", "x": 80, "y": 40 } },
        { "name": "nodeMove", "payload": { "id": "node-b", "x": 100, "y": 40 } },
        { "name": "gesture", "payload": { "gestureId": "gesture-1", "kind": "drag", "targets": ["node-a", "node-b"], "dx": 80, "dy": 40, "proximity": [{ "source": "node-a:h0", "target": "node-c:h1" }] } }
      ],
      "expect": {
        "flushNow": true,
        "camera": null,
        "events": [
          { "name": "select", "payload": { "ids": ["node-a", "node-b"], "exitHighlightIds": [], "gestureId": "gesture-1" } },
          { "name": "gesture", "payload": { "gestureId": "gesture-1", "kind": "drag", "targets": ["node-a", "node-b"], "dx": 80, "dy": 40, "proximity": [{ "source": "node-a:h0", "target": "node-c:h1" }] } }
        ]
      }
    },
    {
      "name": "an open gesture's select waits for its record",
      "rows": [
        { "name": "select", "payload": { "ids": ["node-a"], "exitHighlightIds": [], "gestureId": "gesture-2" } },
        { "name": "nodeMove", "payload": { "id": "node-a", "x": 5, "y": 5 } }
      ],
      "expect": { "flushNow": false, "camera": null, "events": [{ "name": "select", "payload": { "ids": ["node-a"], "exitHighlightIds": [], "gestureId": "gesture-2" } }] }
    },
    {
      "name": "another gesture's record does not release an open gesture's select but flushes itself",
      "rows": [
        { "name": "select", "payload": { "ids": ["node-a"], "exitHighlightIds": [], "gestureId": "gesture-3" } },
        { "name": "gesture", "payload": { "gestureId": "gesture-4", "kind": "drag", "targets": ["region-1"], "dx": 8, "dy": 0, "proximity": [] } }
      ],
      "expect": {
        "flushNow": true,
        "camera": null,
        "events": [
          { "name": "select", "payload": { "ids": ["node-a"], "exitHighlightIds": [], "gestureId": "gesture-3" } },
          { "name": "gesture", "payload": { "gestureId": "gesture-4", "kind": "drag", "targets": ["region-1"], "dx": 8, "dy": 0, "proximity": [] } }
        ]
      }
    },
    {
      "name": "a rotate ring's preview frames collapse into its one record",
      "rows": [
        { "name": "transformPreview", "payload": { "moves": [{ "id": "node-a", "x": 3, "y": 4 }] } },
        { "name": "transformPreview", "payload": { "moves": [{ "id": "node-a", "x": 0, "y": 5 }] } },
        { "name": "gesture", "payload": { "gestureId": "gesture-5", "kind": "rotate", "targets": ["node-a"], "pivotX": 0, "pivotY": 0, "angle": 0.5, "proximity": [] } }
      ],
      "expect": {
        "flushNow": true,
        "camera": null,
        "events": [{ "name": "gesture", "payload": { "gestureId": "gesture-5", "kind": "rotate", "targets": ["node-a"], "pivotX": 0, "pivotY": 0, "angle": 0.5, "proximity": [] } }]
      }
    },
    {
      "name": "a scale record flushes like every gesture record",
      "rows": [{ "name": "gesture", "payload": { "gestureId": "gesture-6", "kind": "scale", "targets": ["node-a", "region-1"], "pivotX": 10, "pivotY": 10, "factor": 2, "proximity": [] } }],
      "expect": { "flushNow": true, "camera": null, "events": [{ "name": "gesture", "payload": { "gestureId": "gesture-6", "kind": "scale", "targets": ["node-a", "region-1"], "pivotX": 10, "pivotY": 10, "factor": 2, "proximity": [] } }] }
    },
    {
      "name": "a region grip drag stays one resize row behind its untagged select",
      "rows": [
        { "name": "select", "payload": { "ids": ["region-1"], "exitHighlightIds": [] } },
        { "name": "regionResize", "payload": { "id": "region-1", "x": 0, "y": 0, "width": 40, "height": 20 } }
      ],
      "expect": {
        "flushNow": true,
        "camera": null,
        "events": [
          { "name": "select", "payload": { "ids": ["region-1"], "exitHighlightIds": [] } },
          { "name": "regionResize", "payload": { "id": "region-1", "x": 0, "y": 0, "width": 40, "height": 20 } }
        ]
      }
    },
    {
      "name": "a link commit flushes on its edge and keeps its connect companion in order",
      "rows": [
        { "name": "edgeCreate", "payload": { "id": "edge-link-1", "source": "node-a:h0", "target": "node-b:h0" } },
        { "name": "proximityConnect", "payload": { "id": "edge-link-1", "source": "node-a:h0", "target": "node-b:h0" } }
      ],
      "expect": {
        "flushNow": true,
        "camera": null,
        "events": [
          { "name": "edgeCreate", "payload": { "id": "edge-link-1", "source": "node-a:h0", "target": "node-b:h0" } },
          { "name": "proximityConnect", "payload": { "id": "edge-link-1", "source": "node-a:h0", "target": "node-b:h0" } }
        ]
      }
    },
    {
      "name": "a companion row alone waits",
      "rows": [{ "name": "indirectConnect", "payload": { "id": "edge-link-2", "source": "node-a:h1", "target": "node-b:h1" } }],
      "expect": { "flushNow": false, "camera": null, "events": [{ "name": "indirectConnect", "payload": { "id": "edge-link-2", "source": "node-a:h1", "target": "node-b:h1" } }] }
    },
    {
      "name": "preselectCancel flushes",
      "rows": [{ "name": "preselectCancel", "payload": { "ids": ["node-a"] } }],
      "expect": { "flushNow": true, "camera": null, "events": [{ "name": "preselectCancel", "payload": { "ids": ["node-a"] } }] }
    },
    {
      "name": "brushCandidates flushes",
      "rows": [{ "name": "brushCandidates", "payload": { "sourceHandleId": "node-a:h0", "candidates": [], "index": 0, "suggestionsActive": false } }],
      "expect": { "flushNow": true, "camera": null, "events": [{ "name": "brushCandidates", "payload": { "sourceHandleId": "node-a:h0", "candidates": [], "index": 0, "suggestionsActive": false } }] }
    },
    {
      "name": "brushPlace flushes",
      "rows": [{ "name": "brushPlace", "payload": { "nodeId": "puzzle2d.brush.1", "edgeId": "puzzle2d.brush.edge.1", "nodeKind": "beam", "sourceHandleId": "node-a:h0", "targetHandleIndex": 0, "x": 1, "y": 2, "shape": "circle", "radius": 4, "handles": [] } }],
      "expect": { "flushNow": true, "camera": null, "events": [{ "name": "brushPlace", "payload": { "nodeId": "puzzle2d.brush.1", "edgeId": "puzzle2d.brush.edge.1", "nodeKind": "beam", "sourceHandleId": "node-a:h0", "targetHandleIndex": 0, "x": 1, "y": 2, "shape": "circle", "radius": 4, "handles": [] } }] }
    },
    {
      "name": "edgeDelete flushes",
      "rows": [{ "name": "edgeDelete", "payload": { "id": "edge-1" } }],
      "expect": { "flushNow": true, "camera": null, "events": [{ "name": "edgeDelete", "payload": { "id": "edge-1" } }] }
    },
    {
      "name": "nodeDelete flushes",
      "rows": [{ "name": "nodeDelete", "payload": { "id": "node-a" } }],
      "expect": { "flushNow": true, "camera": null, "events": [{ "name": "nodeDelete", "payload": { "id": "node-a" } }] }
    },
    {
      "name": "regionCreate flushes",
      "rows": [{ "name": "regionCreate", "payload": { "x": 0, "y": 0, "width": 16, "height": 16 } }],
      "expect": { "flushNow": true, "camera": null, "events": [{ "name": "regionCreate", "payload": { "x": 0, "y": 0, "width": 16, "height": 16 } }] }
    }
  ]
}
