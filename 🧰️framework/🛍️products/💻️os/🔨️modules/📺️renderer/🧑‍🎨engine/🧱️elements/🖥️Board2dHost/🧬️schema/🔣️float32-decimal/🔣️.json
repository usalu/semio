{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/renderer/board2d/float32-decimal.json",
  "title": "Board2dFloat32DecimalCorpus",
  "description": "✂️ Pointer-measured board values and the shortest decimal of their f32 value — the canonical form React's `board2dFloat32Decimal` gives pointer coordinates and the board engine's `board_pointer_offset` gives recorded drag offsets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "semio.renderer.board2d.float32-decimal.v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "expect"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "expect": { "type": "number" }
        }
      }
    }
  }
}
