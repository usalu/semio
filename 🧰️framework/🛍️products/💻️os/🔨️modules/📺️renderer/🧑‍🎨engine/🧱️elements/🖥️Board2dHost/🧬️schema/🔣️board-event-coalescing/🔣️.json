{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://framework/os/renderer/board2d-host/board-event-coalescing",
  "title": "Board event coalescing corpus",
  "description": "🧫️ Language-agnostic cases for the board event coalescer: one drained batch of engine rows in, the dispatched batch and the flush-now verdict out. The React `coalesceBoard2dEvents` and the wgpu `coalesce_owned_board_events` both replay every case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Case"
      }
    }
  },
  "definitions": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "rows",
        "expect"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Row"
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flushNow",
            "events"
          ],
          "properties": {
            "flushNow": {
              "type": "boolean"
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Row"
              }
            }
          }
        }
      }
    },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "payload"
      ],
      "properties": {
        "name": {
          "enum": [
            "camera",
            "nodeMove",
            "transformPreview",
            "gesture",
            "select",
            "preselect",
            "preselectCancel",
            "hover",
            "brushPreview",
            "brushCandidates",
            "brushPlace",
            "linkCompatibleNodes",
            "linkTargetRing",
            "edgeCreate",
            "edgeDelete",
            "nodeDelete",
            "indirectConnect",
            "proximityConnect",
            "regionCreate",
            "regionResize"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "gesture"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/GestureRecord"
              }
            }
          }
        }
      ]
    },
    "GestureRecord": {
      "description": "🎬️ One finished pointer gesture: a `drag` by `dx`/`dy`, a `rotate` by `angle` radians (counter-clockwise) about `pivotX`/`pivotY`, or a `scale` by `factor` about `pivotX`/`pivotY`.",
      "oneOf": [
        {
          "$ref": "#/definitions/DragRecord"
        },
        {
          "$ref": "#/definitions/RotateRecord"
        },
        {
          "$ref": "#/definitions/ScaleRecord"
        }
      ]
    },
    "DragRecord": {
      "description": "✋️ A drag of `targets` by one offset.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gestureId",
        "kind",
        "targets",
        "dx",
        "dy",
        "proximity"
      ],
      "properties": {
        "gestureId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "drag"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dx": {
          "type": "number"
        },
        "dy": {
          "type": "number"
        },
        "proximity": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProximityPair"
          }
        }
      }
    },
    "RotateRecord": {
      "description": "🔄️ A rotation of `targets` about one pivot.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gestureId",
        "kind",
        "targets",
        "pivotX",
        "pivotY",
        "angle",
        "proximity"
      ],
      "properties": {
        "gestureId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "rotate"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pivotX": {
          "type": "number"
        },
        "pivotY": {
          "type": "number"
        },
        "angle": {
          "type": "number"
        },
        "proximity": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProximityPair"
          }
        }
      }
    },
    "ScaleRecord": {
      "description": "🔍️ A scaling of `targets` about one pivot.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gestureId",
        "kind",
        "targets",
        "pivotX",
        "pivotY",
        "factor",
        "proximity"
      ],
      "properties": {
        "gestureId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "scale"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pivotX": {
          "type": "number"
        },
        "pivotY": {
          "type": "number"
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "proximity": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProximityPair"
          }
        }
      }
    },
    "ProximityPair": {
      "description": "🧲️ One handle pair the drop connects, source first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    }
  }
}
