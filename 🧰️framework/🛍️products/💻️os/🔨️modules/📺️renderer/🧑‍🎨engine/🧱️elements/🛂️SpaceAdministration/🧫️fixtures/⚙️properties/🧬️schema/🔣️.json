    "schema": {
      "const": "semio.shell.space-administration-properties-fixture.v1"
    },
    "spaceId": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
