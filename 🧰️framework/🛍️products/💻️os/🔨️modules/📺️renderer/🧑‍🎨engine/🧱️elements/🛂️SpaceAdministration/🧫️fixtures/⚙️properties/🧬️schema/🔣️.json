          "intent",
          "command"
        ],
        "properties": {
          "id": {
            "enum": [
              "rename",
              "unicode-name",
              "public",
              "private"
            ]
          },
          "intent": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "const": "rename-space"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "visibility"
                ],
                "properties": {
                  "kind": {
                    "const": "set-visibility"
                  },
                  "visibility": {
                    "enum": [
                      "public",
                      "private"
                    ]
                  }
                }
              }
            ]
          },
          "command": {
            "$ref": "https://semio.tech/schema/os/directory/component.json#/$defs/DirectoryCommand"
          }
        }
      }
    },
    "refused": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "capability-withdrawn",
          "member",
          "loading",
          "submitting",
          "receipt",
          "refreshing",
          "cancelled",
          "denied",
          "stale",
          "failed",
          "foreign-page"
        ]
      }
    },
    "invalidNames": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "retiredVerificationPhases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ready",
          "failed"
        ]
