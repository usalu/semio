    },
    "locales": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "name",
          "rename",
          "visibility",
          "applyVisibility",
          "public",
          "private"
