          "rename": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "type": "string",
            "minLength": 1
          },
          "applyVisibility": {
            "type": "string",
            "minLength": 1
          },
          "public": {
            "type": "string",
            "minLength": 1
          },
          "private": {
            "type": "string",
            "minLength": 1
          }
        }
