{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/shell/space-administration-properties-fixture-v1.json",
  "title": "Space Administration Properties Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spaceId",
    "cases",
    "refused",
    "invalidNames",
    "retiredVerificationPhases",
    "locales"
