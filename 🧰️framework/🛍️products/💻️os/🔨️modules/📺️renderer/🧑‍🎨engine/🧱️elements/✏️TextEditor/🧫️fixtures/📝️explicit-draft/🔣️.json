{
  "schema": "semio.framework.text-editor.explicit-draft.v1",
  "cases": [
    {
      "id": "source",
      "initial": "{\"title\":\"Alpha\"}",
      "draft": "{\"title\":\"Beta\"}",
      "settings": {
        "readOnly": false,
        "editAction": "replaceSnapshotSource",
        "editArgument": "value",
        "commit": "explicit",
        "applyLabel": "Apply",
        "discardLabel": "Discard",
        "conflictLabel": "The document changed."
        ,"applyingLabel": "Preparing draft"
        ,"cancelLabel": "Cancel"
        ,"failedLabel": "The draft could not be applied"
      },
      "expected": {
        "action": "replaceSnapshotSource",
        "args": {
          "value": "{\"title\":\"Beta\"}"
        }
      }
    },
    {
      "id": "long-scalar",
      "initial": "Alpha",
      "draft": "Beta",
      "settings": {
        "readOnly": false,
        "editAction": "setSnapshotValue",
        "editArgument": "value",
        "editArguments": {
          "path": "/description"
        },
        "commit": "explicit",
        "applyLabel": "Anwenden",
        "discardLabel": "Verwerfen",
        "conflictLabel": "Das Dokument wurde geändert."
        ,"applyingLabel": "Entwurf wird vorbereitet"
        ,"cancelLabel": "Abbrechen"
        ,"failedLabel": "Entwurf konnte nicht angewendet werden"
      },
      "expected": {
        "action": "setSnapshotValue",
        "args": {
          "path": "/description",
          "value": "Beta"
        }
      }
    }
  ],
