{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.framework.text-editor.explicit-draft.v1",
  "title": "Text Editor Explicit Draft Settings",
  "type": "object",
  "required": [
    "readOnly",
    "editAction",
    "editArgument",
    "commit",
    "publicationRevision",
    "applyLabel",
    "discardLabel",
    "conflictLabel",
    "applyingLabel",
    "cancelLabel",
    "failedLabel",
    "syntaxErrorLabel",
    "validationErrorLabel",
    "pathLabel",
    "lineLabel",
    "columnLabel"
  ],
  "properties": {
    "readOnly": {
      "const": false
    },
    "editAction": {
      "type": "string",
      "minLength": 1
    },
    "editArgument": {
      "type": "string",
      "minLength": 1
    },
    "editArguments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "commit": {
      "const": "explicit"
    },
    "publicationRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "applyLabel": {
      "type": "string",
      "minLength": 1
    },
    "discardLabel": {
      "type": "string",
      "minLength": 1
    },
    "conflictLabel": {
      "type": "string",
      "minLength": 1
    },
    "applyingLabel": {
      "type": "string",
      "minLength": 1
    },
    "cancelLabel": {
      "type": "string",
      "minLength": 1
    },
    "failedLabel": {
      "type": "string",
      "minLength": 1
    },
    "syntaxErrorLabel": {
      "type": "string",
      "minLength": 1
    },
    "validationErrorLabel": {
      "type": "string",
      "minLength": 1
    },
    "pathLabel": {
      "type": "string",
      "minLength": 1
    },
    "lineLabel": {
      "type": "string",
      "minLength": 1
    },
    "columnLabel": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
