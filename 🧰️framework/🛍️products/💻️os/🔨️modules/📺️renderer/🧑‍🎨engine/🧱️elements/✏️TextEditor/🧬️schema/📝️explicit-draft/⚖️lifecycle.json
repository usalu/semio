{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.framework.text-editor.explicit-draft.lifecycle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "otherSource",
    "base",
    "draft",
    "normalized",
    "newerDraft",
    "baseRevision",
    "ownRevision",
    "foreignRevision",
    "operation",
    "operationGeneration",
    "cancellation",
    "orders",
    "failures",
    "expected",
    "selectAllChords"
  ],
  "properties": {
    "schema": {
      "const": "semio.framework.text-editor.explicit-draft.lifecycle.v1"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "otherSource": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "type": "string",
      "minLength": 1
    },
    "normalized": {
      "type": "string",
      "minLength": 1
    },
    "newerDraft": {
      "type": "string",
      "minLength": 1
    },
    "baseRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "ownRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "foreignRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "operation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "operationGeneration": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "operationHex", "generationHex", "preservesDraft", "foreignOperationIgnored"],
      "properties": {
        "action": { "const": "cancelTypedOperation" },
        "operationHex": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "generationHex": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "preservesDraft": { "const": true },
        "foreignOperationIgnored": { "const": true }
      }
    },
    "orders": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "publication-first",
          "completion-first"
        ]
      }
    },
    "failures": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "refused",
          "superseded",
          "throw",
          "missing-receipt"
        ]
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foreignDirty",
        "foreignConflict",
        "ownDirty",
        "failureDirty",
        "failureFailed"
      ],
      "properties": {
        "foreignDirty": {
          "type": "boolean"
        },
        "foreignConflict": {
          "type": "boolean"
        },
        "ownDirty": {
          "type": "boolean"
        },
        "failureDirty": {
          "type": "boolean"
        },
        "failureFailed": {
          "type": "boolean"
        }
      }
    },
    "selectAllChords": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "metaKey",
          "ctrlKey"
        ],
        "properties": {
          "key": {
            "enum": [
              "a",
              "A"
            ]
          },
          "metaKey": {
            "type": "boolean"
          },
          "ctrlKey": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
