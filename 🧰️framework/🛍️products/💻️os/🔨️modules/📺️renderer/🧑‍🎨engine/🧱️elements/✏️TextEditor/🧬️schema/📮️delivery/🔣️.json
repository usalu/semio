{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Text Editor Delivery", "type": "object", "additionalProperties": false, "required": ["schema", "cases"], "properties": {"schema": {"const": "semio.renderer.text-editor-delivery/v1"}, "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "initial", "typed", "outcome", "expected", "readOnly"], "properties": {"id": {"type": "string", "minLength": 1}, "initial": {"type": "string"}, "typed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "outcome": {"enum": ["accepted", "dispatch-failed", "viewer-read-only"]}, "expected": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "items": {"type": "string"}}}, "readOnly": {"type": "boolean"}, "typedAfterNewOwner": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "Keys typed after the host re-rendered the editor with a new action owner (onAction identity) while the first delivery was still in flight: they must queue behind it in the SAME dispatcher, never overtake it or be overtaken by an older pending text."}}}}}}
