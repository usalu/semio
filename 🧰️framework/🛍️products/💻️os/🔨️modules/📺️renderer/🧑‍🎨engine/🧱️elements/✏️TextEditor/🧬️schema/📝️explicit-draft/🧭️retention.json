{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.framework.text-editor.explicit-draft.retention.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "replacementOwner", "initialSession", "openedDocument", "windowId", "draftScope", "base", "draft", "published", "baseRevision", "ownRevision", "operation", "limits", "expected"],
  "properties": {
    "schema": { "const": "semio.framework.text-editor.explicit-draft.retention.v1" },
    "owner": { "$ref": "#/$defs/owner" },
    "replacementOwner": { "$ref": "#/$defs/owner" },
    "initialSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "appId", "sessionInstanceId"],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1 },
        "appId": { "type": "string", "minLength": 1 },
        "sessionInstanceId": { "type": "integer", "minimum": 0 }
      }
    },
    "openedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeKey", "clientInstanceId"],
      "properties": {
        "runtimeKey": { "type": "string", "minLength": 1 },
        "clientInstanceId": { "type": "string", "minLength": 1 }
      }
    },
    "windowId": { "type": "string", "minLength": 1 },
    "draftScope": { "type": "string", "minLength": 1 },
    "base": { "type": "string" },
    "draft": { "type": "string" },
    "published": { "type": "string" },
    "baseRevision": { "$ref": "#/$defs/u64" },
    "ownRevision": { "$ref": "#/$defs/u64" },
    "operation": { "$ref": "#/$defs/u64" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owners", "draftsPerOwner"],
      "properties": {
        "owners": { "type": "integer", "minimum": 1 },
        "draftsPerOwner": { "type": "integer", "minimum": 1 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sameOwnerRetains", "replacementInherits", "retirementClears", "pendingSurvivesUnmount"],
      "properties": {
        "sameOwnerRetains": { "const": true },
        "replacementInherits": { "const": false },
        "retirementClears": { "const": true },
        "pendingSurvivesUnmount": { "const": true }
      }
    }
  },
  "$defs": {
    "u64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "appId", "sessionInstanceId", "runtimeKey", "clientInstanceId"],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1 },
        "appId": { "type": "string", "minLength": 1 },
        "sessionInstanceId": { "type": "integer", "minimum": 0 },
        "runtimeKey": { "type": "string", "minLength": 1 },
        "clientInstanceId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
