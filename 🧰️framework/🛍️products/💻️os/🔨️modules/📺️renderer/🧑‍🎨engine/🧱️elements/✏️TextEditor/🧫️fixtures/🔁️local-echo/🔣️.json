{
  "schema": "semio.renderer.text-editor-local-echo/v1",
  "description": "The text editor host's optimistic local echo. The host delivers its latest text and selection through ONE latest-wins channel, so the guest sees some of the local texts (`local`: a text sent as a `textEdit`) and never sees others (`typed`: a local change the channel superseded before sending it). While the editor types, its own text and caret are the newest state: a scene buffer equal to a pending sent text (acknowledging it and every older one) or to the last acknowledged text (the guest re-publishing a state it already echoed) applies neither its buffer nor its selection; any other buffer is an external change (undo, a collaborator, a formatter) whose text and selection are applied at once, dropping every pending send. `refuse` answers one sent text as refused (`reason`, default `dispatch-failed`): the text leaves the pending set, and when nothing is pending any more the host re-applies the guest's buffer (`resync`), so a keystroke the guest did not take is never shown as saved; a reason that says the window takes no edits (`undeclared-action`, `viewer-read-only`) turns the editor read-only, after which `local`/`typed` change nothing. `expect` is the host's text after the event, `pending` the sends still in flight, `readOnly` (when given) the editor's mode.",
  "cases": [
    {
      "id": "stale-echoes-of-in-flight-typing-never-revert-it",
      "initial": "RETURN",
      "events": [
        {
          "local": "RETURN n",
          "expect": "RETURN n",
          "pending": [
            "RETURN n"
          ]
        },
        {
          "local": "RETURN na",
          "expect": "RETURN na",
          "pending": [
            "RETURN n",
            "RETURN na"
          ]
        },
        {
          "echo": "RETURN n",
          "expect": "RETURN na",
          "pending": [
            "RETURN na"
          ]
        },
        {
          "local": "RETURN nam",
          "expect": "RETURN nam",
          "pending": [
            "RETURN na",
            "RETURN nam"
          ]
        },
        {
          "echo": "RETURN na",
          "expect": "RETURN nam",
          "pending": [
            "RETURN nam"
          ]
        },
        {
          "echo": "RETURN nam",
          "expect": "RETURN nam",
          "pending": []
        }
      ]
    },
    {
