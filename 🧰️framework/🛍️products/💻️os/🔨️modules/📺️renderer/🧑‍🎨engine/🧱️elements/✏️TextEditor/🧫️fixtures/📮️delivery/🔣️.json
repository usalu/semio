{
  "schema": "semio.renderer.text-editor-delivery/v1",
  "cases": [
    {
      "id": "typing-coalesces-until-edit-and-selection-settle",
      "initial": "a",
      "typed": [
        "b",
        "c",
        "d"
      ],
      "outcome": "accepted",
      "expected": [
        [
          "textEdit:ab"
        ],
        [
          "textEdit:ab",
          "textSelect:2:2",
          "textEdit:abcd"
        ],
        [
          "textEdit:ab",
          "textSelect:2:2",
          "textEdit:abcd",
          "textSelect:4:4"
        ]
      ],
      "readOnly": false
    },
    {
      "id": "refused-edit-does-not-send-its-selection",
      "initial": "a",
      "typed": [
        "b"
      ],
      "outcome": "dispatch-failed",
      "expected": [
        [
          "textEdit:ab"
        ],
        [
          "textEdit:ab"
        ],
        [
          "textEdit:ab"
        ]
      ],
      "readOnly": false
    },
    {
      "id": "viewer-refusal-switches-the-host-to-read-only",
      "initial": "a",
      "typed": [
        "b"
      ],
      "outcome": "viewer-read-only",
      "expected": [
        [
          "textEdit:ab"
        ],
        [
          "textEdit:ab"
        ],
        [
          "textEdit:ab"
        ]
      ],
      "readOnly": true
    },
    {
      "id": "a-new-action-owner-mid-flight-keeps-one-delivery-order",
      "initial": "a",
      "typed": [
        "b",
        "c"
      ],
      "typedAfterNewOwner": [
        "d"
      ],
      "outcome": "accepted",
      "expected": [
        [
          "textEdit:ab"
        ],
        [
          "textEdit:ab",
          "textSelect:2:2",
          "textEdit:abcd"
        ],
        [
          "textEdit:ab",
          "textSelect:2:2",
          "textEdit:abcd",
          "textSelect:4:4"
        ]
      ],
      "readOnly": false
    }
  ],
  "spliceCases": [
    {
      "id": "a-collaborator-run-folded-in-while-a-splice-is-in-flight",
      "note": "the editor types X (splice 1 in flight), then Y; the window publishes its text with splice 1 AND a collaborator's C folded in; when splice 1 settles the next splice goes out against what the editor shows NOW: it inserts Y only, never deleting C",
      "initial": "ab",
      "typedFirst": [
        "X"
      ],
      "typedWhileInFlight": [
        "Y"
      ],
      "published": {
        "buffer": "CabX",
        "applied": 1
      },
      "expected": [
        "textSplice:1:2::X:ab:",
        "textSplice:2:4::Y:CabX:"
      ],
      "finalText": "CabXY"
    }
  ]
}
