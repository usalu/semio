{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "cases"],
  "properties": {
    "code": { "const": "plugin-ui.intake-rejected" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "surfaceId", "phase", "failure", "rule", "node", "notice"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "surfaceId": { "type": "string", "pattern": "^[0-9]+:.+$" },
          "phase": { "type": "string", "minLength": 1 },
          "failure": { "type": ["string", "null"] },
          "rule": { "type": ["string", "null"] },
          "node": { "type": ["integer", "null"], "minimum": 0 },
          "notice": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "de"],
            "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
