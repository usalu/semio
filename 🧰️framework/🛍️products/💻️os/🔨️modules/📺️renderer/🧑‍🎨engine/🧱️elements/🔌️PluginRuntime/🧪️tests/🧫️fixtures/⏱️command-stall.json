{
  "schema": "semio.os.command-stall.cases/v1",
  "description": "One actor's command lane under the stall watch. `runs` are offered to the lane in order at time 0; each starts when the lane releases the previous one; `settlesAtMs` counts from that run's own start (null: never settles); `cancelAtMs` is the absolute time its stall is cancelled. `expect` lists, per absolute check time, the commands the watch reports as stalled and the runs that have finished (resolved / cancelled).",
  "boundMs": 5000,
  "cases": [
    {
      "id": "settles-before-the-bound",
      "runs": [
        {
          "command": "addNode",
          "settlesAtMs": 1000
        }
      ],
      "expect": [
        {
          "atMs": 999,
          "stalled": [],
          "resolved": [],
          "cancelled": []
        },
        {
          "atMs": 6000,
          "stalled": [],
          "resolved": [
            "addNode"
          ],
          "cancelled": []
        }
      ]
    },
    {
      "id": "slow-but-settles-after-the-bound",
      "runs": [
        {
          "command": "reorganize",
          "settlesAtMs": 7000
        }
      ],
      "expect": [
        {
          "atMs": 4999,
          "stalled": [],
          "resolved": [],
          "cancelled": []
        },
        {
          "atMs": 5000,
          "stalled": [
            "reorganize"
          ],
          "resolved": [],
          "cancelled": []
        },
        {
          "atMs": 7000,
          "stalled": [],
          "resolved": [
            "reorganize"
          ],
          "cancelled": []
        }
      ]
    },
    {
      "id": "never-settles-cancel-releases-the-lane",
      "runs": [
        {
          "command": "clearSelection",
          "settlesAtMs": null,
          "cancelAtMs": 6000
        },
        {
          "command": "undo",
          "settlesAtMs": 100
        }
      ],
      "expect": [
        {
          "atMs": 5000,
          "stalled": [
            "clearSelection"
          ],
          "resolved": [],
          "cancelled": []
        },
        {
          "atMs": 5999,
          "stalled": [
            "clearSelection"
          ],
          "resolved": [],
          "cancelled": []
        },
        {
          "atMs": 6000,
          "stalled": [],
          "resolved": [],
          "cancelled": [
            "clearSelection"
          ]
        },
        {
          "atMs": 6100,
          "stalled": [],
          "resolved": [
            "undo"
          ],
          "cancelled": [
            "clearSelection"
          ]
        }
      ]
    },
    {
      "id": "a-queued-command-is-not-stalled-while-it-waits",
      "runs": [
        {
          "command": "patchNodes",
          "settlesAtMs": 4000
        },
        {
          "command": "undo",
          "settlesAtMs": 4000
        }
      ],
      "expect": [
        {
          "atMs": 7999,
          "stalled": [],
          "resolved": [
            "patchNodes"
          ],
          "cancelled": []
        },
        {
          "atMs": 8000,
          "stalled": [],
          "resolved": [
            "patchNodes",
            "undo"
          ],
          "cancelled": []
        }
      ]
    }
  ],
  "labels": {
    "description": "Which program label a stall band names: a spawned window names its own app, the instance the active session runs on names the session app, any other instance names the program id (never a guessed first app).",
    "programId": "fem",
    "apps": [
      {
        "id": "fem2d",
        "breadcrumb": [
          "semio",
          "fem",
          "fem2d"
        ]
      },
      {
        "id": "fem3d",
        "breadcrumb": [
          "semio",
          "fem",
          "fem3d"
        ]
      }
    ],
    "cases": [
      {
        "id": "session-instance-names-its-app",
        "actorId": "fem#1",
        "spawned": null,
        "session": {
          "instanceId": 1,
          "appId": "fem3d"
        },
        "expect": "semio · fem · fem3d"
      },
      {
        "id": "spawned-window-names-its-app",
        "actorId": "fem#4",
        "spawned": {
          "instanceId": 4,
          "appId": "fem2d",
          "breadcrumb": [
            "semio",
            "fem",
            "fem2d",
            "2"
          ]
        },
        "session": {
          "instanceId": 1,
          "appId": "fem3d"
        },
        "expect": "semio · fem · fem2d · 2"
      },
      {
        "id": "unknown-instance-names-the-program",
        "actorId": "fem#9",
        "spawned": null,
        "session": {
          "instanceId": 1,
          "appId": "fem3d"
        },
        "expect": "fem"
      }
    ]
  }
}
