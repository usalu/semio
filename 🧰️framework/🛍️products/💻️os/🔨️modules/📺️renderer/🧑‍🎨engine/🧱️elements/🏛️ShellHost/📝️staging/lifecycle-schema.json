{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "closing",
    "cancel",
    "retirement",
    "openingRevision",
    "committedRelease",
    "lateLease"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requests",
          "queried"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requests": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "queried": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "closing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pending",
        "closeCalls"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "pending": {
          "const": true
        },
        "closeCalls": {
          "const": 1
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "queried",
        "results"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "queried": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "enum": [
              "cancelled"
            ]
          }
        }
      }
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "error",
        "firstFinished",
        "attempts",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "firstFinished": {
          "const": false
        },
        "attempts": {
          "const": 2
        },
        "result": {
          "const": "cancelled"
        }
      }
    },
    "openingRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial",
        "current",
        "generation"
      ],
      "properties": {
        "initial": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "current": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generation": {
          "const": "1"
        }
      }
    },
    "committedRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "firstFinished",
        "result",
        "closeCalls"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "firstFinished": {
          "const": false
        },
        "result": {
          "const": "executed"
        },
        "closeCalls": {
          "const": 2
        }
      }
    },
    "lateLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "firstAttempts",
        "finalAttempts"
      ],
      "properties": {
        "result": {
          "const": "cancelled"
        },
        "firstAttempts": {
          "const": 1
        },
        "finalAttempts": {
          "const": 2
        }
      }
    }
  }
}
