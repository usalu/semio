{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.shell.dialog-origin-fixture.v1"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "appId",
        "controllerId",
        "sessionInstanceId",
        "document"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "controllerId": {
          "type": "string",
          "minLength": 1
        },
        "sessionInstanceId": {
          "type": "integer",
          "minimum": 0
        },
        "document": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runtimeKey",
                "clientInstanceId",
                "scope"
              ],
              "properties": {
                "runtimeKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientInstanceId": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "spaceId",
                        "documentId"
                      ],
                      "properties": {
                        "spaceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "documentId": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "accepted",
          "patch"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "accepted": {
            "type": "boolean"
          },
          "patch": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "path",
                "value"
              ],
              "properties": {
                "op": {
                  "const": "replace"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {}
              }
            }
          }
        }
      }
    }
  }
}
