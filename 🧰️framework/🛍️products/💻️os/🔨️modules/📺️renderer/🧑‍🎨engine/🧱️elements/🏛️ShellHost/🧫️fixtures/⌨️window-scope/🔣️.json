  "reservedChords": {
    "note": "🛡️ Which chords the shell's own chrome keeps out of the app-keybinding loop. Only accelerator-carrying chords are reserved — the rule the wgpu shell's is_reserved_shell_chord already applies — so a bare key stays with the focused surface and a node-graph canvas keeps its bare arrows.",
    "collision": {
      "shellControlId": "ui.shell.mode.next",
      "chord": "mod+alt+arrowright",
      "alsoMintedFor": "toolRunStep"
    },
    "shellTable": {
      "ui.shell.mode.next": "mod+alt+arrowright",
      "ui.shell.mode.previous": "mod+alt+arrowleft",
      "ui.search.toggle": "mod+p",
      "ui.window.focus": "mod+shift+enter",
      "ui.shell.panelAnchor.topLeft": "ctrl+b,meta+b",
      "ui.introduction.next": "enter,arrowright",
      "ui.introduction.skip": "escape"
    },
    "overrides": {
      "ui.search.toggle": "mod+alt+s"
    },
    "expected": [
      "mod+alt+arrowright",
      "mod+alt+arrowleft",
      "mod+alt+s",
      "mod+shift+enter",
      "ctrl+b",
      "meta+b"
    ],
    "cases": [
      {
        "chord": "mod+alt+arrowright",
        "accelerator": true,
        "reserved": true,
        "why": "the navbar's mode step, which `toolRunStep` is minted on too — two owners, and the chrome wins"
      },
      {
        "chord": "mod+alt+arrowleft",
        "accelerator": true,
        "reserved": true,
        "why": "the navbar's previous-mode step"
      },
      {
        "chord": "mod+shift+enter",
        "accelerator": true,
        "reserved": true,
        "why": "window focus, which `toolRunFinalize` is minted on too"
      },
      {
        "chord": "arrowright",
        "accelerator": false,
        "reserved": false,
        "why": "a bare arrow belongs to the focused surface — the node graph owns it"
      },
      {
        "chord": "enter",
        "accelerator": false,
        "reserved": false,
        "why": "bare, so the introduction's own hotkey and an app surface can both live with it"
      },
      {
        "chord": "escape",
        "accelerator": false,
        "reserved": false,
        "why": "bare; the shell's own Escape handling runs before the binding loop"
      },
      {
        "chord": "mod+shift+g",
        "accelerator": true,
        "reserved": false,
        "why": "an app chord the shell table never names"
      },
      {
        "chord": "mod+p",
        "accelerator": true,
        "reserved": false,
        "why": "the DEFAULT search chord, overridden away by this fixture's user"
      },
      {
        "chord": "mod+alt+s",
        "accelerator": true,
        "reserved": true,
        "why": "the override the user chose instead"
      },
      {
        "chord": "ctrl+b",
        "accelerator": true,
        "reserved": true,
        "why": "one alternative of a comma-separated shell binding"
      },
      {
        "chord": "meta+b",
        "accelerator": true,
        "reserved": true,
        "why": "the other alternative of the same binding"
      }
    ]
  }
}
