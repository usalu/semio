    "generation3d": {
      "kinds": [
        {
          "id": "procedural-main",
          "actionIds": [
            "nodeGraphEdit",
            "nodeGraphViewport",
            "setLodMode",
            "selectNextNode",
            "selectPreviousNode",
            "selectUpstreamNode",
            "selectDownstreamNode",
            "activateSelection"
