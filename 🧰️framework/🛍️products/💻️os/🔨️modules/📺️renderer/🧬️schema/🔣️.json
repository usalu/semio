{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/renderer/component.json",
  "title": "Renderer",
  "description": "Renderer-owned presentation contracts: shell dialog/effect origin admission, tutorial drive and playback, document opening and instance admission, host identity bootstrap, extension invocation, mounted probe projection, and the runtime/graph/helper element contracts. Renderer elements (🧱️elements/*) and rendering targets (🎯️targets/*) are consumers; this module is the sole owner.",
  "$defs": {
    "World3dInstanceInteractionV1": {
      "type": "object",
      "required": [
        "id",
        "meshId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "meshId": {
          "type": "string",
          "minLength": 1
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        },
        "interactionGranularityId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ActorDocumentPortOwnerV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorId",
        "activationGeneration",
        "instanceId",
        "runtimeKey",
        "clientInstanceId",
        "scope"
      ],
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "activationGeneration": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "runtimeKey": {
          "type": "string",
          "minLength": 1
        },
        "clientInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShellScopeV1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ShellScopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "ShellRuntimeKeyV1": {
      "type": "string",
      "pattern": "^v1:[0-9]+:[0-9]+:",
      "maxLength": 1280
    },
    "ShellClientInstanceIdV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Sha256HexV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ShellDialogDocumentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeKey",
        "clientInstanceId",
        "scope"
      ],
      "properties": {
        "runtimeKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1280
        },
        "clientInstanceId": {
          "$ref": "#/$defs/ShellClientInstanceIdV1"
        },
        "scope": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ShellScopeV1"
            }
          ]
        }
      }
    },
    "ShellDialogOriginV1": {
      "description": "🗨️ The identity a modal dialog or shell effect was raised from. Two origins are the same origin only when every field is equal; a detached document or a reopened client instance is a different origin.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "appId",
        "controllerId",
        "sessionInstanceId",
        "document"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "appId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "controllerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sessionInstanceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "document": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ShellDialogDocumentV1"
            }
          ]
        }
      }
    },
    "DocumentOpeningStepV1": {
      "enum": [
        "socket",
        "attach",
        "close",
        "detach",
        "commit",
        "retire"
      ]
    },
    "DocumentOpeningAttachmentStepV1": {
      "enum": [
        "attach-a",
        "attached-a",
        "detach",
        "attach-b",
        "load",
        "bind",
        "load-a",
        "load-c",
        "bind-c"
      ]
    },
    "DocumentOpeningRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "schema"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "DocumentOpeningContextV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentSpaceId",
        "identity"
      ],
      "properties": {
        "currentSpaceId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "identity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hubBaseUrl"
              ],
              "properties": {
                "hubBaseUrl": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          ]
        },
        "dataDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "DocumentOpeningTargetV1": {
      "description": "📍️ The exact scope a document reference resolves to. A hub target always carries the requested surface and is persistedShared; a folder target never invents one and is persistedLocalOnly.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dataClass",
            "baseUrl",
            "spaceId",
            "requestedSurfaceId"
          ],
          "properties": {
            "kind": {
              "const": "hub"
            },
            "dataClass": {
              "const": "persistedShared"
            },
            "baseUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "spaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "requestedSurfaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dataClass",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "folder"
            },
            "dataClass": {
              "const": "persistedLocalOnly"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      ]
    },
    "DocumentOpeningErrorCodeV1": {
      "enum": [
        "opening.identity-required",
        "opening.surface-required"
      ]
    },
    "DocumentOpeningRequestStageV1": {
      "enum": [
        "open-plan",
        "manifest",
        "component",
        "descriptor",
        "socket-grants"
      ]
    },
    "TutorialRunEventV1": {
      "enum": [
        "resolve",
        "stop",
        "switch",
        "replace"
      ]
    },
    "TutorialDriveEventV1": {
      "enum": [
        "claimA",
        "claimB",
        "releaseA",
        "releaseB",
        "retire"
      ]
    },
    "HostAppAliasesV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landingAppId",
        "hostAppId"
      ],
      "properties": {
        "landingAppId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hostAppId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "HostAppV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "dialect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "role": {
          "enum": [
            "editor",
            "viewer"
          ]
        },
        "dialect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactKind"
          ],
          "properties": {
            "artifactKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "ArtifactBootstrapProgressV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "documentId",
        "receivedBytes",
        "totalBytes",
        "receivedChunks",
        "totalChunks"
      ],
      "properties": {
        "kind": {
          "const": "artifact-bootstrap-progress"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "receivedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "receivedChunks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "totalChunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "ArtifactBootstrapFailedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "documentId",
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "kind": {
          "const": "artifact-bootstrap-failed"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "code": {
          "enum": [
            "cancelled",
            "deadline-exceeded",
            "invalid-bootstrap",
            "transport-failure",
            "recovery-exhausted"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "ArtifactRebootstrapRequiredV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "documentId",
        "message",
        "retryable"
      ],
      "properties": {
        "kind": {
          "const": "artifact-rebootstrap-required"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "BootstrapStatusV1": {
      "description": "📥️ Every bootstrap status the shell renders. A progress notice is polite status; a failure or rebootstrap demand is an assertive alert.",
      "oneOf": [
        {
          "$ref": "#/$defs/ArtifactBootstrapProgressV1"
        },
        {
          "$ref": "#/$defs/ArtifactBootstrapFailedV1"
        },
        {
          "$ref": "#/$defs/ArtifactRebootstrapRequiredV1"
        }
      ]
    },
    "LocalizedNoticeTextV1": {
      "description": "🈯️ Notice copy carried per locale. English and German are both required — the shell has no default language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "ExtensionInvocationRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "request"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request": {
          "type": "object"
        }
      }
    },
    "ExtensionInvocationCompletionV1": {
      "description": "✅️ The single terminal completion an extension invocation publishes: the surface it settled on, the revision it advanced to, and the history patch it left.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "revision",
        "notification",
        "uiScope",
        "historyPatch"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "notification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "uiScope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "full",
                "partial"
              ]
            }
          }
        },
        "historyPatch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cursor",
            "upserts",
            "canUndo",
            "canRedo"
          ],
          "properties": {
            "cursor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "upserts": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object"
              }
            },
            "canUndo": {
              "type": "boolean"
            },
            "canRedo": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ExtensionCompletionRefusalV1": {
      "description": "⛔️ A completion the shell refuses to publish, with the exact reason it was refused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code"
      ],
      "properties": {
        "kind": {
          "enum": [
            "missing-lease",
            "missing-complete",
            "missing-guard",
            "foreign-request",
            "foreign-instance"
          ]
        },
        "code": {
          "enum": [
            "extension.completion-unavailable",
            "extension.completion-owner-mismatch"
          ]
        }
      }
    },
    "ExtensionInvocationMissV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "code"
      ],
      "properties": {
        "phase": {
          "enum": [
            "extension",
            "invoke"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "ExtensionInvocationFaultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "code",
        "severity",
        "message",
        "scope",
        "retryable"
      ],
      "properties": {
        "origin": {
          "enum": [
            "extension",
            "plugin",
            "host"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "scope": {
          "type": "object"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "MountedArtifactFrontierV1": {
      "description": "🌿 The exact scope-bound checkpoint frontier acknowledged by one mounted browser actor.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainHash"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "headEditOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "headEditId": {
          "type": "string",
          "maxLength": 256
        },
        "lastCommitSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chainHash": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "headEditOrdinal": {
              "const": 0
            },
            "headEditId": {
              "const": ""
            },
            "lastCommitSeq": {
              "const": 0
            },
            "chainHash": {
              "type": "array",
              "items": {
                "const": 0
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "headEditOrdinal": {
              "type": "integer",
              "minimum": 1
            },
            "headEditId": {
              "type": "string",
              "minLength": 1
            },
            "lastCommitSeq": {
              "type": "integer",
              "minimum": 1
            },
            "chainHash": {
              "type": "array",
              "contains": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "RendererPackageCatalogBrowserEntries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceRelativePath",
          "outputRelativePath",
          "inclusion"
        ],
        "properties": {
          "id": {
            "enum": [
              "frame-worker",
              "browser-boot",
              "renderer-boot"
            ]
          },
          "sourceRelativePath": {
            "$ref": "#/$defs/RendererPackageCatalogPath"
          },
          "outputRelativePath": {
            "$ref": "#/$defs/RendererPackageCatalogPath"
          },
          "inclusion": {
            "enum": [
              "tracked",
              "ignored"
            ]
          }
        }
      }
    },
    "RendererPackageCatalogPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:*?\"<>|\u0000-\u001f]+$"
    },
    "RendererPackageCatalogV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schemaVersion",
        "kind",
        "ownerPath",
        "packageRelativePath",
        "nodePackageRelativePath",
        "identity",
        "entryPaths",
        "artifacts"
      ],
      "properties": {
        "$schema": {
          "const": "https://json.schemas.assets.semio-tech.com/os/renderer/component.json#/$defs/RendererPackageCatalogV1"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "canonical-wgpu-package"
        },
        "ownerPath": {
          "$ref": "#/$defs/RendererPackageCatalogPath"
        },
        "packageRelativePath": {
          "const": "📦️packages/🦀️rust"
        },
        "nodePackageRelativePath": {
          "const": "📦️packages/🟦️typescript"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cargoPackageName",
            "nodePackageName",
            "nxProjectName"
          ],
          "properties": {
            "cargoPackageName": {
              "const": "semio-framework-os-renderer-wgpu"
            },
            "nodePackageName": {
              "const": "@semio-tech/framework-renderer-wgpu"
            },
            "nxProjectName": {
              "const": "@semio-tech/framework-renderer-wgpu"
            }
          }
        },
        "entryPaths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cargoLibrary",
            "cargoBinary",
            "cargoBuild",
            "nodeLibrary"
          ],
          "properties": {
            "cargoLibrary": {
              "$ref": "#/$defs/RendererPackageCatalogPath"
            },
            "cargoBinary": {
              "$ref": "#/$defs/RendererPackageCatalogPath"
            },
            "cargoBuild": {
              "const": "build.rs"
            },
            "nodeLibrary": {
              "$ref": "#/$defs/RendererPackageCatalogPath"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "relativePath",
              "targetRelativePath",
              "language",
              "role",
              "content"
            ],
            "properties": {
              "id": {
                "enum": [
                  "build-adapter",
                  "binary-adapter",
                  "typescript-adapter",
                  "renderer-registration"
                ]
              },
              "relativePath": {
                "$ref": "#/$defs/RendererPackageCatalogPath"
              },
              "targetRelativePath": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RendererPackageCatalogPath"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "language": {
                "enum": [
                  "rust",
                  "typescript"
                ]
              },
              "role": {
                "enum": [
                  "declaration",
                  "implementation"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "RendererResidentPolicyV1": {
      "allOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/resident/schema.json#/$defs/Resident"
        },
        {
          "const": {
            "bytes": 33554432,
            "slots": 262144,
            "owners": 262144,
            "control": {
              "bytes": 65536,
              "slots": 1024,
              "owners": 1024
            }
          }
        }
      ]
    },
    "TutorialInteractionCaptureCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "state"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/TutorialInteractionCaptureIdentity"
        },
        "state": {
          "$ref": "#/$defs/TutorialInteractionCaptureLocalState"
        }
      }
    },
    "TutorialInteractionCaptureIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appInstanceId",
        "generation",
        "revision",
        "documentRevision",
        "topologyRevision"
      ],
      "properties": {
        "appInstanceId": {
