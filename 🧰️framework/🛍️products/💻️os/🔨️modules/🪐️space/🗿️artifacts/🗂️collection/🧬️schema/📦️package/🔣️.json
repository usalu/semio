{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "os.collection.package-declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definition_version",
    "id",
    "artifact",
    "directory",
    "rust_package",
    "nx_project",
    "dependencies"
  ],
  "properties": {
    "definition_version": {
      "const": 1
    },
    "id": {
      "const": "os.collection"
    },
    "artifact": {
      "const": "collection"
    },
    "directory": {
      "const": "🗂️collection"
    },
    "rust_package": {
      "const": "semio-framework-artifact-space-collection"
    },
    "nx_project": {
      "const": "@semio-tech/framework-space-collection-rs"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 0
    }
  }
}
