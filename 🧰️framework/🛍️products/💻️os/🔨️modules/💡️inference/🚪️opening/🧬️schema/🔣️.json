            "spaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "documentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "outcome": {
          "enum": [
            "opened",
            "refused",
            "indeterminate"
          ]
        },
        "code": {
          "enum": [
            null,
            "inference.capacity",
            "inference.denied",
            "inference.invalid",
            "inference.lease-unverified",
            "inference.transport"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "const": "opened"
            },
            "code": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "refused"
            },
            "code": {
              "enum": [
                "inference.capacity",
                "inference.denied",
                "inference.invalid",
                "inference.lease-unverified"
              ]
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "indeterminate"
            },
            "code": {
              "const": "inference.transport"
            }
          }
        }
      ]
