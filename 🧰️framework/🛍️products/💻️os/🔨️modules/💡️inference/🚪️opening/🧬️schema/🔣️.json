{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/inference/opening/component.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "closed",
    "request",
    "opened",
    "refused",
    "authorityRefused",
    "indeterminate",
    "routes"
  ],
  "properties": {
    "closed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operationEpoch", "scope"],
      "properties": {
        "kind": { "const": "inference-port-closed" },
        "operationEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "scope": { "$ref": "#/properties/request/properties/scope" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operationEpoch",
        "scope"
      ],
      "properties": {
        "kind": {
          "const": "inference-open"
        },
        "operationEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spaceId",
            "documentId"
          ],
          "properties": {
            "spaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "documentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "opened": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operationEpoch",
        "scope",
        "outcome",
