      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inference-open",
          "inference-propose",
          "inference-poll",
          "inference-cancel",
          "inference-approve",
          "inference-close",
          "inference-history-undo"
        ]
