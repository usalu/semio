{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "nodes",
    "expected",
    "slices",
    "cancelledValues",
    "resumeComputes",
    "caller",
    "turnItems",
    "minimumComputeSteps",
    "cache"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "weight",
          "parents"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "weight": {
            "type": "integer"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "slices": {
      "const": 3
    },
    "cancelledValues": {
      "const": {
        "root": 1
      }
    },
    "resumeComputes": {
      "const": 4
    },
    "caller": {
      "const": {
        "operation": 971,
        "generation": 19,
        "clockUs": 1,
        "deadlineUs": 1000000,
        "fuel": 65536,
        "stock": [
          32768,
          1048576,
          16777216,
          16777216,
          64
        ]
      }
    },
    "turnItems": {
      "const": [
        1,
        2,
        3,
        12
      ]
    },
    "minimumComputeSteps": {
      "const": 12
    },
    "cache": {
      "type": "object",
      "required": ["budgetBytes", "boundedBudgetBytes", "edit", "edited", "initialFingerprints", "editedFingerprints", "runs"],
      "properties": {
        "budgetBytes": { "type": "integer", "minimum": 1 },
        "boundedBudgetBytes": { "type": "integer", "minimum": 1 },
        "edit": {
          "type": "object",
          "required": ["key", "weight"],
          "properties": { "key": { "type": "string" }, "weight": { "type": "integer" } },
          "additionalProperties": false
        },
        "edited": { "type": "object", "additionalProperties": { "type": "integer" } },
        "initialFingerprints": { "$ref": "#/definitions/fingerprints" },
        "editedFingerprints": { "$ref": "#/definitions/fingerprints" },
        "runs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["computed", "hits"],
            "properties": {
              "computed": { "type": "integer", "minimum": 0 },
              "hits": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "fingerprints": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
