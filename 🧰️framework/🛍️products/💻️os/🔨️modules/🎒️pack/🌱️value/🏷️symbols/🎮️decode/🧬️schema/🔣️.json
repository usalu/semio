{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.semio.tech/pack/retained-inline-symbols/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "maximumTurnBytes",
    "maximumSymbols",
    "maximumSymbolBytes",
    "constructorBytes",
    "valid",
    "invalid",
    "large"
  ],
  "properties": {
    "schema": {
      "const": "pack.retained-inline-symbols/v1"
    },
    "maximumTurnBytes": {
      "const": 4096
    },
    "maximumSymbols": {
      "const": 2048
    },
    "maximumSymbolBytes": {
      "const": 262144
    },
    "constructorBytes": {
      "const": 0
    },
    "large": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "repetitions",
        "bytes",
        "emptySymbols"
      ],
      "properties": {
        "word": {
          "const": "🧬\u0000é"
        },
        "repetitions": {
          "const": 20000
        },
        "bytes": {
          "const": 140000
        },
        "emptySymbols": {
          "const": 2048
        }
      }
    },
    "valid": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hex",
          "symbols",
          "prefixBytes",
          "sourceOffset"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prefixBytes": {
            "type": "integer",
            "minimum": 1
          },
          "sourceOffset": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "invalid": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hex",
          "refusal"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "refusal": {
            "enum": [
              "incomplete",
              "noncanonical",
              "utf8",
              "symbol-count",
              "symbol-length"
            ]
          }
        }
      }
    }
  }
}
