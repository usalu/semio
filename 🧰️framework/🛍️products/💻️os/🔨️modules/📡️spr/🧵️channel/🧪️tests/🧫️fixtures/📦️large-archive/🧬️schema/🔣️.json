{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generator", "former", "ceiling", "cases"],
  "properties": {
    "version": {"const": 1},
    "generator": {"const": "splitmix64-little-endian"},
    "former": {"type": "integer", "minimum": 1},
    "ceiling": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "packSeed", "packBytes", "sprSeed", "sprBytes", "archiveBytes", "fnv1a64", "sha256", "outcome"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "packSeed": {"type": "string", "pattern": "^[0-9]{1,20}$"},
          "packBytes": {"type": "integer", "minimum": 1},
          "sprSeed": {"type": "string", "pattern": "^[0-9]{1,20}$"},
          "sprBytes": {"type": "integer", "minimum": 1},
          "archiveBytes": {"type": "integer", "minimum": 1},
          "fnv1a64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outcome": {"enum": ["accepted", "refused"]}
        }
      }
    }
  }
}
