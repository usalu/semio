{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://framework/document-archive-load-host/v1",
  "title": "Document Archive Load Host Law",
  "description": "Scripted guest answers for the host half of the stepped, ACK-owned whole-document load: per case, the exact commands the host sends, the answer each one gets, and the outcome. Sequences start at firstSequence and grow by one per sent command; the admission's own sequence is the operation every later command names. A case the guest admitted itself (admittedByGuest) starts admitted under firstSequence and sends its first command under firstSequence + 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "law", "firstSequence", "cases"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "law": { "type": "string", "minLength": 1 },
    "firstSequence": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "fault": { "type": "string", "minLength": 1, "maxLength": 128, "description": "The guest's fault, carried as these UTF-8 bytes." },
    "count": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "cancel": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["beforeStep"], "properties": { "beforeStep": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["whileStepInFlight"], "properties": { "whileStepInFlight": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "answer": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "done" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "fault"], "properties": { "kind": { "const": "error" }, "fault": { "$ref": "#/$defs/fault" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "state", "completed", "total"],
          "properties": {
            "kind": { "enum": ["status", "foreignStatus"] },
            "state": { "enum": ["pending", "running", "ready", "cancelled", "fault"] },
            "completed": { "$ref": "#/$defs/count" },
            "total": { "$ref": "#/$defs/count" },
            "fault": { "$ref": "#/$defs/fault" }
          }
        }
      ]
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sends", "answer"],
      "properties": {
        "sends": { "enum": ["loadDocumentArchive", "pollDocumentArchiveLoad", "cancelDocumentArchiveLoad", "acknowledgeDocumentArchiveLoad"] },
        "answer": { "$ref": "#/$defs/answer" }
      }
    },
    "outcome": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["ready", "cancelled", "unanswered"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "fault"], "properties": { "kind": { "enum": ["fault", "refused"] }, "fault": { "$ref": "#/$defs/fault" } } }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cancel", "exchanges", "outcome"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "admittedByGuest": { "type": "boolean", "description": "The guest admitted the load itself under the host command sequence firstSequence (the media import of a whole document of the app's own schema answers its pending status), so the host drives it from its first poll." },
        "cancel": { "$ref": "#/$defs/cancel" },
        "exchanges": { "type": "array", "items": { "$ref": "#/$defs/exchange" } },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    }
  }
}
