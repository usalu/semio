{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/spr/command/component.json",
  "title": "Spr Command Contracts",
  "$defs": {
    "MutationInvertibility": {
      "enum": [
        "self",
        "explicit-mutation",
        "plan",
        "non-invertible"
      ]
    },
    "MutationDiffParticipation": {
      "enum": [
        "detect",
        "apply-only",
        "plan",
        "none"
      ]
    },
    "MutationOutcomeClass": {
      "enum": [
        "applied",
        "info",
        "warning",
        "error",
        "fatal"
      ]
    },
    "MutationComposition": {
      "enum": [
        "atomic",
        "composite"
      ]
    },
    "MutationLanguageSurface": {
      "enum": [
        "rust",
        "typescript",
        "graphql",
        "protobuf",
        "json-schema",
        "text",
        "binary"
      ]
    },
    "MutationLeafDescriptor": {
      "title": "Neutral Mutation Leaf Descriptor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "owner",
        "semanticKind",
        "displayName",
        "emoji",
        "aggregateVariant",
        "payloadSchema",
        "textOpcode",
        "binaryTag",
        "invertibility",
        "diffParticipation",
        "outcomeClasses",
        "composition",
        "requiredLanguageSurfaces"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "semanticKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "emoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "aggregateVariant": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "payloadSchema": {
          "type": "string",
          "minLength": 1
        },
        "textOpcode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "binaryTag": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "invertibility": {
          "$ref": "#/$defs/MutationInvertibility"
        },
        "diffParticipation": {
          "$ref": "#/$defs/MutationDiffParticipation"
        },
        "outcomeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/MutationOutcomeClass"
          }
        },
        "composition": {
          "$ref": "#/$defs/MutationComposition"
        },
        "requiredLanguageSurfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/MutationLanguageSurface"
          }
        }
      }
    },
    "MutationLawsI64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "MutationLawsU8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "MutationLawsCounterV1": {
      "title": "Mutation Laws Counter",
      "$ref": "#/$defs/MutationLawsI64"
    },
    "MutationLawsCounterDiffV1": {
      "type": "object",
      "required": [
        "deltas"
      ],
      "properties": {
        "deltas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MutationLawsI64"
          }
        }
      },
      "additionalProperties": false
    },
    "VerbVocabularyV1": {
      "title": "Mutation Verb Vocabulary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verb",
              "record"
            ],
            "properties": {
              "verb": {
                "type": "string",
                "minLength": 1
              },
              "record": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "MutationLeafDescriptorVectorsV1": {
      "title": "Mutation Leaf Descriptor Vectors",
      "type": "object",
      "required": [
        "schemaVersion",
        "descriptor",
        "enumWireValues",
        "binaryTagVectors",
        "ownerBoundaryVectors",
        "rosterVectors"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "descriptor": {
          "$ref": "#/$defs/MutationLeafDescriptor"
        },
        "enumWireValues": {
          "type": "object",
          "required": [
            "invertibility",
            "diffParticipation",
            "outcomeClasses",
            "composition",
            "requiredLanguageSurfaces"
          ],
          "properties": {
            "invertibility": {
              "type": "array",
              "items": {
                "enum": [
                  "self",
                  "explicit-mutation",
                  "plan",
                  "non-invertible"
                ]
              }
            },
            "diffParticipation": {
              "type": "array",
              "items": {
                "enum": [
                  "detect",
                  "apply-only",
                  "plan",
                  "none"
                ]
              }
            },
            "outcomeClasses": {
              "type": "array",
              "items": {
                "enum": [
                  "applied",
                  "info",
                  "warning",
                  "error",
                  "fatal"
                ]
              }
            },
            "composition": {
              "type": "array",
              "items": {
                "enum": [
                  "atomic",
                  "composite"
                ]
              }
            },
            "requiredLanguageSurfaces": {
              "type": "array",
              "items": {
                "enum": [
                  "rust",
                  "typescript",
                  "graphql",
                  "protobuf",
                  "json-schema",
                  "text",
                  "binary"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "binaryTagVectors": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "name",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "missing": {
                "const": true
              },
              "expected": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "ownerBoundaryVectors": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "name",
              "owner",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string"
              },
              "expected": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "rosterVectors": {
          "type": "array",
          "minItems": 20,
          "items": {
            "type": "object",
            "required": [
              "name",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "boolean"
              },
              "field": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
