{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/spr/command/component.json",
  "title": "Spr Command Contracts",
  "$defs": {
    "MutationInvertibility": {
      "enum": [
        "self",
        "explicit-mutation",
        "plan",
        "non-invertible"
      ]
    },
    "MutationDiffParticipation": {
      "enum": [
        "detect",
        "apply-only",
        "plan",
        "none"
      ]
    },
    "MutationOutcomeClass": {
      "description": "🎯️ The protocol outcome class a direct mutation can reach — the same vocabulary as the repository test protocol's `MutationOutcomeClass`, carried verbatim by bridges and manifests.",
      "enum": [
        "applied",
        "no-op",
        "empty",
        "disjoint",
        "rejected"
      ]
    },
    "MutationComposition": {
      "enum": [
        "atomic",
        "composite"
      ]
    },
    "MutationLanguageSurface": {
      "enum": [
        "rust",
        "typescript",
        "graphql",
        "protobuf",
        "json-schema",
        "text",
        "binary"
      ]
    },
    "MutationLeafDescriptor": {
      "title": "Neutral Mutation Leaf Descriptor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "owner",
        "semanticKind",
        "displayName",
        "emoji",
        "aggregateVariant",
        "payloadSchema",
        "textOpcode",
        "binaryTag",
        "invertibility",
        "diffParticipation",
        "outcomeClasses",
        "composition",
        "requiredLanguageSurfaces"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "semanticKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "emoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "aggregateVariant": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "payloadSchema": {
          "type": "string",
          "minLength": 1
        },
        "textOpcode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "binaryTag": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "invertibility": {
          "$ref": "#/$defs/MutationInvertibility"
        },
        "diffParticipation": {
          "$ref": "#/$defs/MutationDiffParticipation"
        },
        "outcomeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/MutationOutcomeClass"
          }
        },
        "composition": {
          "$ref": "#/$defs/MutationComposition"
        },
        "requiredLanguageSurfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/MutationLanguageSurface"
          }
        },
        "editable": {
          "description": "Whether the history editor may edit this leaf's inputs. Absent or true: the leaf is editable and shows at least one input. False declares it withdraw-only (design §22.20): #[derive(MutationLeaf)] answers input_schema() == None, no gate judges its inputs, and its history row offers Withdraw only.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "MutationLawsI64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "MutationLawsU8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "MutationLawsCounterV1": {
      "title": "Mutation Laws Counter",
      "$ref": "#/$defs/MutationLawsI64"
    },
    "MutationLawsCounterDiffV1": {
      "type": "object",
      "required": [
        "deltas"
      ],
      "properties": {
        "deltas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MutationLawsI64"
          }
        }
      },
      "additionalProperties": false
    },
    "ApprovedMutationVerbV1": {
      "description": "🎨️ Closed imperative action ontology for concrete mutation semantics.",
      "type": "string",
      "enum": [
        "add",
        "append",
        "apply",
        "bind",
        "change",
        "clear",
        "commit",
        "connect",
        "create",
        "delete",
        "discard",
        "disconnect",
        "drag",
        "duplicate",
        "edit",
        "extract",
        "finish",
        "fix",
        "flatten",
        "group",
        "inline",
        "insert",
        "merge",
        "move",
        "paint",
        "remove",
        "rename",
        "reorder",
        "replace",
        "resize",
        "restore",
        "rotate",
        "scale",
        "seal",
        "set",
        "split",
        "stage",
        "start",
        "switch",
        "toggle",
        "unbind",
        "unflatten",
        "ungroup",
        "update",
        "verify"
      ]
    },
