{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.history.original-conflict-receiving.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant",
    "limits",
    "control",
    "source",
    "priorEditIds",
    "conflicts"
  ],
  "properties": {
    "grant": {
      "const": {
        "items": 1,
        "copyBytes": 2,
        "capacityBytes": 65536,
        "releaseBytes": 262144,
        "depth": 64
      }
    },
    "limits": {
      "const": {
        "fileBytes": 67108864,
        "frameBodyBytes": 1048576,
        "records": 8192,
        "maximumFields": 128,
        "maximumTextBytes": 1048576,
        "maximumBinaryBytes": 1048576,
        "maximumJsonBytes": 1048576,
        "maximumJsonAllocationBytes": 8388608,
        "maximumJsonItems": 65536,
        "maximumJsonDepth": 64
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumAllocationBytes"
      ],
      "properties": {
        "maximumAllocationBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "const": {
        "operation": 43,
        "generation": 7,
        "pageBytes": 3,
        "prefixHex": "aa",
        "suffixHex": "bb"
      }
    },
    "priorEditIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wireHex",
          "expected"
        ],
        "properties": {
          "wireHex": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{2})+$"
          },
          "expected": {
            "type": "object"
          }
        }
      }
    }
  }
}
