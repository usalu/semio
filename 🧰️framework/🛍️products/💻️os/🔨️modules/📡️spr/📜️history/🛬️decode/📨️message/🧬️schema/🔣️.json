{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant",
    "messages"
  ],
  "properties": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "copyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "wireHex",
          "level",
          "code",
          "message",
          "target",
          "opIndex"
        ],
        "properties": {
          "wireHex": {
            "type": "string",
            "pattern": "^[a-f0-9]+$"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "target": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "opIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
