{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Paged History Edit Custody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant",
    "limits",
    "source",
    "priorEditIds",
    "edits",
    "control"
  ],
  "properties": {
    "grant": {
      "const": {
        "items": 1,
        "copyBytes": 2,
        "capacityBytes": 65536,
        "releaseBytes": 262144,
        "depth": 64
      }
    },
    "limits": {
      "const": {
        "fileBytes": 67108864,
        "frameBodyBytes": 1048576,
        "records": 8192,
        "maximumFields": 128,
        "maximumTextBytes": 1048576,
        "maximumBinaryBytes": 1048576,
        "maximumJsonBytes": 1048576,
        "maximumJsonAllocationBytes": 8388608,
        "maximumJsonItems": 65536,
        "maximumJsonDepth": 64
      }
    },
    "source": {
      "const": {
        "operation": 43,
        "generation": 7,
        "pageBytes": 3,
        "prefixHex": "aa",
        "suffixHex": "bb"
      }
    },
    "priorEditIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edits": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wireHex",
          "expected"
        ],
        "properties": {
          "wireHex": {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          },
          "expected": {
            "type": "object",
            "required": [
              "id",
              "startedAt",
              "actor",
              "finishedAt",
              "lane",
              "verb",
              "line",
              "ops",
              "inverse",
              "meta"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "actor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "finishedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lane": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verb": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "binaryHex"
                  ],
                  "properties": {
                    "text": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "binaryHex": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "inverse": {
                "type": "array"
              },
              "meta": {
                "type": [
                  "array",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumAllocationBytes"
      ],
      "properties": {
        "maximumAllocationBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
