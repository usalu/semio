{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.history.original-retained-deflate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture",
    "maximumAllocationBytes",
    "maximumFrameBytes",
    "grant",
    "cuts",
    "maximumTurns",
    "expected"
  ],
  "properties": {
    "fixture": {
      "const": "deflate-committed"
    },
    "maximumAllocationBytes": {
      "const": 8388608
    },
    "maximumFrameBytes": {
      "const": 1048576
    },
    "grant": {
      "const": {
        "maximumItems": 1,
        "maximumCopyBytes": 2,
        "maximumCapacityBytes": 65536,
        "maximumReleaseBytes": 262144,
        "maximumDepth": 64
      }
    },
    "cuts": {
      "const": [
        0,
        1,
        5,
        9
      ]
    },
    "maximumTurns": {
      "const": 2097152
    },
    "expected": {
      "const": {
        "sameSource": true,
        "sameControl": true,
        "pagedOutput": true,
        "noGather": true,
        "paidWindow": true,
        "paidPartial": true,
        "exactLength": true,
        "noTrailing": true,
        "metadataStackClose": true
      }
    }
  }
}
