{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.history.original-file-receiving.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant",
    "limits",
    "control",
    "source",
    "headerHex",
    "records",
    "expected",
    "nativeTrials"
  ],
  "properties": {
    "grant": {
      "const": {
        "items": 1,
        "copyBytes": 2,
        "capacityBytes": 65536,
        "releaseBytes": 262144,
        "depth": 64
      }
    },
    "limits": {
      "const": {
        "fileBytes": 67108864,
        "frameBodyBytes": 1048576,
        "records": 8192,
        "maximumFields": 128,
        "maximumTextBytes": 1048576,
        "maximumBinaryBytes": 1048576,
        "maximumJsonBytes": 1048576,
        "maximumJsonAllocationBytes": 8388608,
        "maximumJsonItems": 65536,
        "maximumJsonDepth": 64
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumAllocationBytes"
      ],
      "properties": {
        "maximumAllocationBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "const": {
        "operation": 43,
        "generation": 7,
        "pageBytes": 3,
        "prefixHex": "aa",
        "suffixHex": "bb"
      }
    },
    "headerHex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "flags",
          "payloadHex"
        ],
        "properties": {
          "kind": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "flags": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "payloadHex": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{2})*$"
          }
        }
      }
    },
    "expected": {
      "type": "object"
    },
    "nativeTrials": {
      "const": {
        "cases": [
          {
            "kind": "complete",
            "accept": true
          },
          {
            "kind": "duplicate-edit",
            "accept": false
          },
          {
            "kind": "malformed-transition",
            "accept": false
          },
          {
            "kind": "replace-viewer-composition",
            "accept": true
          }
        ],
        "cancelAt": [
          0,
          1,
          7,
          17,
          97,
          100000
        ],
        "transition": {
          "id": "tr1",
          "actor": "owner",
          "hlt": [
            1,
            2,
            3
          ],
          "canonicalPayloadCase": "revert-one",
          "malformedPayloadCase": "trailing-bytes"
        },
        "conflictSource": "semio.history.original-conflict-receiving.v1"
      }
    }
  }
}
