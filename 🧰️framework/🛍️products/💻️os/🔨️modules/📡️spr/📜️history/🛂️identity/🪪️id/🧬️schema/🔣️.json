{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/spr/history/identity/id/component.json",
  "title": "Spr History Id Cursor Contracts",
  "$defs": {
    "HistoryIdCursorV1": {
      "title": "Member History Id Cursor Vectors",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "limits",
        "cases",
        "completion"
      ],
      "properties": {
        "schema": {
          "const": "semio.member.history-id-cursor/v1"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identityBytes",
            "dictionaryEntries"
          ],
          "properties": {
            "identityBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "dictionaryEntries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        },
        "completion": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "case",
              "wireBytes",
              "dictionaryBytes",
              "cancelled",
              "complete"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "case": {
                "enum": [
                  "raw",
                  "dictionary",
                  "prefix-uuid"
                ]
              },
              "wireBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18
              },
              "dictionaryBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 11
              },
              "cancelled": {
                "type": "boolean"
              },
              "complete": {
                "type": "boolean"
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "wire",
              "dictionary",
              "expected",
              "error"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "wire": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{2})+$",
                "maxLength": 1024
              },
              "dictionary": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "resolvedIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8191
              },
              "expected": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "error": {
                "enum": [
                  null,
                  "identity",
                  "malformed",
                  "capacity",
                  "state"
                ]
              }
            }
          }
        }
      }
    }
  }
}
