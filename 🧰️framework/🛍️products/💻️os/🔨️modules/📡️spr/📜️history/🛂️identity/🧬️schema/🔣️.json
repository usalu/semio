{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/spr/history/identity/component.json",
  "title": "Spr History Identity Contracts",
  "$defs": {
    "HistoryIdentityText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "HistoryIdentityHex": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{2})+$",
      "maxLength": 4096
    },
    "HistoryIdentityTriple": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/HistoryIdentityText"
      }
    }
  }
}
