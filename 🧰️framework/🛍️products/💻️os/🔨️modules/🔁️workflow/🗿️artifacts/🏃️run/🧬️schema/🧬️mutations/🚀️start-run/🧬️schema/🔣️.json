{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/workflow/artifacts/run/mutation/start-run/schema.json",
  "title": "StartRun",
  "type": "object",
  "$defs": {
    "Payload": {
      "type": "object",
      "required": [
        "workflowRef",
        "workflowCheckpointId",
        "inputCollectionRef",
        "inputSnapshotId",
        "parameterValues",
        "outputCollectionRef",
        "trigger"
      ],
      "properties": {
        "workflowRef": {
          "type": "string"
        },
        "workflowCheckpointId": {
          "type": "string"
        },
        "inputCollectionRef": {
          "type": "string"
        },
        "inputSnapshotId": {
          "type": "string"
        },
        "parameterValues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameterId",
              "value"
            ],
            "properties": {
              "parameterId": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "outputCollectionRef": {
          "type": "string"
        },
        "trigger": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "actor"
              ],
              "properties": {
                "kind": {
                  "const": "manual"
                },
                "actor": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "automationRef",
                "eventFingerprint"
              ],
              "properties": {
                "kind": {
                  "const": "automation"
                },
                "automationRef": {
                  "type": "string"
                },
                "eventFingerprint": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/Payload"
    }
  ],
  "propertyNames": {
    "enum": [
      "inputCollectionRef",
      "inputSnapshotId",
      "outputCollectionRef",
      "parameterValues",
      "trigger",
      "workflowCheckpointId",
      "workflowRef"
    ]
  }
}
