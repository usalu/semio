{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/os/workflow/run/mutation/seal-run/schema.json",
  "title": "SealRun",
  "type": "object",
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "canceled"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/payload"
    }
  ],
  "propertyNames": {
    "enum": [
      "status"
    ]
  }
}
