{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/workflow/artifacts/run/mutation/set-run-seal/schema.json",
  "title": "SetRunSeal",
  "propertyNames": {
    "enum": [
      "operation",
      "finishedAt",
      "sealed",
      "status"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "sealed",
    "status"
  ],
  "properties": {
    "operation": {
      "const": "setRunSeal"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "canceled"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Run status",
          "de": "Laufstatus"
        },
        "options": {
          "pending": {
            "en": "Pending",
            "de": "Ausstehend"
          },
          "running": {
            "en": "Running",
            "de": "Läuft"
          },
          "succeeded": {
            "en": "Succeeded",
            "de": "Erfolgreich"
          },
          "failed": {
            "en": "Failed",
            "de": "Fehlgeschlagen"
          },
          "canceled": {
            "en": "Canceled",
            "de": "Abgebrochen"
          }
        },
        "group": "state",
        "order": 10
      }
    },
    "sealed": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Sealed",
          "de": "Versiegelt"
        },
        "group": "state",
        "order": 5
      }
    },
    "finishedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Finished at",
          "de": "Beendet um"
        },
        "group": "state",
        "order": 20
      }
    }
  }
}
