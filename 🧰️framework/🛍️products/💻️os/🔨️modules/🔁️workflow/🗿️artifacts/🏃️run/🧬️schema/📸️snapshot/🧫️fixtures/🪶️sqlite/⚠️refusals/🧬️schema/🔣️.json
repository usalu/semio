{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.workflow.run.sqlite.intrinsic-refusals.v1.schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "kind",
    "cases"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "semio.workflow.run.sqlite.intrinsic-refusals.v1"
    },
    "kind": {
      "type": "string",
      "const": "invalidValue"
    },
    "cases": {
      "type": "array",
      "const": [
        {
          "path": [
            "sealed"
          ],
          "value": "yes"
        },
        {
          "path": [
            "status"
          ],
          "value": "undeclared"
        },
        {
          "path": [
            "nodeRecords",
            0,
            "status"
          ],
          "value": "undeclared"
        },
        {
          "path": [
            "trigger",
            "kind"
          ],
          "value": "undeclared"
        },
        {
          "path": [
            "undeclaredRoot"
          ],
          "value": true
        },
        {
          "path": [
            "parameterValues"
          ],
          "value": {}
        },
        {
          "path": [
            "trigger"
          ],
          "value": null
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value"
        ],
        "properties": {
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          },
          "value": {}
        }
      }
    }
  }
}
