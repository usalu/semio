{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/workflow/artifacts/run/mutation/finish-run-node/schema.json",
  "title": "FinishRunNode",
  "type": "object",
  "$defs": {
    "Fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portId",
        "fingerprint"
      ],
      "properties": {
        "portId": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      }
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portId",
        "artifactId",
        "path"
      ],
      "properties": {
        "portId": {
          "type": "string"
        },
        "artifactId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "Payload": {
      "type": "object",
      "required": [
        "nodeRecord"
      ],
      "properties": {
        "nodeRecord": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeId",
            "status",
            "documentFingerprint",
            "configFingerprint",
            "inputFingerprints",
            "outputFingerprints",
            "outputs",
            "durationMs"
          ],
          "properties": {
            "nodeId": {
              "type": "string"
            },
            "status": {
              "enum": [
                "computed",
                "cacheHit",
                "failed"
              ]
            },
            "documentFingerprint": {
              "type": "string"
            },
            "configFingerprint": {
              "type": "string"
            },
            "inputFingerprints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Fingerprint"
              }
            },
            "outputFingerprints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Fingerprint"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Output"
              }
            },
            "durationMs": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/Payload"
    }
  ],
  "propertyNames": {
    "enum": [
      "nodeRecord"
    ]
  }
}
