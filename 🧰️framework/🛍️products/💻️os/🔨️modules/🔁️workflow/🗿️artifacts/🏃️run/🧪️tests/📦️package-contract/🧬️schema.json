{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package",
    "libPath",
    "cases"
  ],
  "properties": {
    "package": {
      "const": "semio-framework-artifact-workflow-run"
    },
    "libPath": {
      "const": "../../🦀️.rs"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "operations",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "operation"
              ],
              "properties": {
                "operation": {
                  "enum": [
                    "startRun",
                    "startRunNode",
                    "finishRunNode",
                    "appendRunLog",
                    "sealRun"
                  ]
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "status",
              "sealed",
              "logs",
              "rejections"
            ],
            "properties": {
              "schema": {
                "const": "os.run"
              },
              "status": {
                "enum": [
                  "pending",
                  "running",
                  "succeeded",
                  "failed",
                  "canceled"
                ]
              },
              "sealed": {
                "type": "boolean"
              },
              "logs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rejections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
