{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/workflow/artifacts/workflow/mutation/set-node-ports/schema.json",
  "title": "SetNodePorts",
  "description": "The `set-node-ports` mutation record — the input ports and height of a set of workflow nodes in one row: the exact undo of an `update-node-ports` resync.",
  "type": "object",
  "properties": {
    "operation": {
      "const": "setNodePorts"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "x-semio-ui": {
              "widget": "reference",
              "role": "target",
              "label": {
                "en": "Node",
                "de": "Knoten"
              },
              "description": {
                "en": "The workflow node whose input ports are installed.",
                "de": "Der Arbeitsablaufknoten, dessen Eingangsanschlüsse gesetzt werden."
              },
              "ref": {
                "kind": "node"
              },
              "order": 10
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "https://json.schemas.assets.semio-tech.com/os/workflow/artifacts/workflow/mutation/add-node/schema.json#/$defs/WorkflowMediaPort"
            },
            "x-semio-ui": {
              "role": "value",
              "label": {
                "en": "Input ports",
                "de": "Eingangsanschlüsse"
              },
              "order": 20
            }
          },
          "height": {
            "type": "number",
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "Height",
                "de": "Höhe"
              },
              "step": 1,
              "precision": 2,
              "order": 30
            }
          }
        },
        "required": [
          "nodeId",
          "inputs",
          "height"
        ],
        "additionalProperties": false
      },
      "x-semio-ui": {
        "label": {
          "en": "Node ports",
          "de": "Knotenanschlüsse"
        },
        "description": {
          "en": "One port row per workflow node; each node at most once.",
          "de": "Eine Anschlusszeile pro Arbeitsablaufknoten; jeder Knoten höchstens einmal."
        },
        "group": "target",
        "order": 10
      }
    }
  },
  "required": [
    "operation",
    "nodes"
  ],
  "additionalProperties": false,
  "x-semio-invariant": [
    {
      "id": "unique-node-ids",
      "description": {
        "en": "Every row names a different workflow node.",
        "de": "Jede Zeile nennt einen anderen Arbeitsablaufknoten."
      }
    }
  ]
}
