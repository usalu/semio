{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemas",
    "invalid"
  ],
  "properties": {
    "contractId": {
      "const": "workflow-intrinsic-wire"
    },
    "schemas": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "invalid": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          {
            "kind": "intrinsic",
            "format_kind": "binary"
          },
          {
            "kind": "intrinsic",
            "schema": "x",
            "format_kind": "y"
          },
          {
            "kind": "intrinsic"
          }
        ]
      }
    }
  }
}
