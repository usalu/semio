{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:framework:world3d:analytic-component-picking",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh",
    "camera",
    "cases"
  ],
  "properties": {
    "mesh": {
      "type": "object"
    },
    "camera": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance",
          "handle",
          "revision",
          "label",
          "group",
          "expected"
        ],
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1
          },
          "handle": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "label": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "group": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
