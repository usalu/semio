{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact Asset Request Cancellation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requests",
    "stages",
    "expected"
  ],
  "properties": {
    "requests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stages": {
      "const": [
        "queued",
        "fetching"
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelled",
        "replacementCancelled",
        "duplicateCancelAccepted",
        "staleCancelAccepted"
      ],
      "properties": {
        "cancelled": {
          "const": [
            true,
            false
          ]
        },
        "replacementCancelled": {
          "const": false
        },
        "duplicateCancelAccepted": {
          "const": true
        },
        "staleCancelAccepted": {
          "const": false
        }
      }
    }
  }
}
