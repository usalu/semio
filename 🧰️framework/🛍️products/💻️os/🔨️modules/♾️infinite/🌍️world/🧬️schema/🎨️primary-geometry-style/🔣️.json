{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "geometry",
    "states"
  ],
  "properties": {
    "geometry": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "point",
          "wire",
          "edgeOnlyWire"
        ]
      }
    },
    "states": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "selected",
          "hovered",
          "line"
        ],
        "properties": {
          "name": {
            "enum": [
              "neutral",
              "hovered",
              "selected",
              "selected-hovered"
            ]
          },
          "selected": {
            "type": "boolean"
          },
          "hovered": {
            "type": "boolean"
          },
          "line": {
            "enum": [
              "var(--border-normal-color)",
              "var(--border-emphasized-color)",
              "var(--color-primary)"
            ]
          }
        }
      }
    }
  }
}
