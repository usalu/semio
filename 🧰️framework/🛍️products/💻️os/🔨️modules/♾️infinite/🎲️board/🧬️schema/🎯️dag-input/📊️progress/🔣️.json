{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "board.dag.computing-progress",
  "type": "object",
  "required": [
    "active",
    "stale"
  ],
  "additionalProperties": false,
  "properties": {
    "active": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
