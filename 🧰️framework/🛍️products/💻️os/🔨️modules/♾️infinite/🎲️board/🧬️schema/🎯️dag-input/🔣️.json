{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://board/dag-input/v1",
  "title": "DAG Selection Channel And Evaluation Input",
  "definitions": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "handles"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/channel"
      }
    },
    "statuses": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "queued"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "computing"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "message"
            ],
            "properties": {
              "status": {
                "const": "error"
              },
              "message": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "ports"
            ],
            "properties": {
              "status": {
                "const": "blocked"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "selectionDomain": {
      "enum": [
        "nodes",
        "edges"
      ]
    },
    "channelDirection": {
      "enum": [
        "in",
        "out"
      ]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widgetId",
        "port",
        "direction"
      ],
      "properties": {
        "widgetId": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "$ref": "#/definitions/channelDirection"
        }
      }
    },
    "wireRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sourceTypes",
        "target",
        "targetTypes"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "targetTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "refusal"
      ],
      "properties": {
        "channel": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/channel"
            }
          ]
        },
        "refusal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/wireRefusal"
            }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/selection"
    },
    {
      "$ref": "#/definitions/channels"
    },
    {
      "$ref": "#/definitions/statuses"
    },
    {
      "$ref": "#/definitions/hover"
    }
  ]
}
