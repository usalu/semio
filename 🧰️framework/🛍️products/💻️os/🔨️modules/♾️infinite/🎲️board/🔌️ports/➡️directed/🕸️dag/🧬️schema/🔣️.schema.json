{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.dag.slider-overlay.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases",
    "keyboard"
  ],
  "properties": {
    "schema": {
      "const": "semio.dag.slider-overlay.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "scopeId",
          "row"
        ],
        "properties": {
          "locale": {
            "enum": [
              "en",
              "de"
            ]
          },
          "scopeId": {
            "type": "string",
            "minLength": 1
          },
          "row": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "widgetId",
              "label",
              "value",
              "min",
              "max",
              "step",
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "widgetId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "value": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "keyboard": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "expected"
        ],
        "properties": {
          "key": {
            "enum": [
              "ArrowRight",
              "ArrowLeft",
              "Home",
              "End"
            ]
          },
          "expected": {
            "type": "number"
          }
        }
      }
    }
  }
}
