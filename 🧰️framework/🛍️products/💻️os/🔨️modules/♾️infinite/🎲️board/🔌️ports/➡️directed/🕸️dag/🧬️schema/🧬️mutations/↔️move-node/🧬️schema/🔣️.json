{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/payload"
    }
  ],
  "unevaluatedProperties": false
}
