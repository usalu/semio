{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Board ➡️directed Descriptor Model",
  "$defs": {
    "EdgeDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "edgeKind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceTip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetTip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "userData": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "locked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "additionalProperties": true
    },
    "WireDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "wireKind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "endX": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "endY": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "userData": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "locked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source"
      ],
      "additionalProperties": true
    },
    "RegionDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hidden": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "locked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "SceneDescriptor": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeDescriptor"
          }
        },
        "handles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HandleDescriptor"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EdgeDescriptor"
          }
        },
        "wires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireDescriptor"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegionDescriptor"
          }
        },
        "selectionExitHighlightIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/String"
          }
        }
      },
      "required": [
        "nodes",
        "handles",
        "edges"
      ],
      "additionalProperties": true
    },
    "BoardSnapshot": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "targetRegions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "meta": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "nodes",
        "edges"
      ],
      "additionalProperties": true
    },
    "CameraDescriptor": {
      "$ref": "../../../%F0%9F%A7%AC%EF%B8%8Fschema/%F0%9F%94%A3%EF%B8%8F.json#/$defs/CameraDescriptor"
    },
    "NodeDescriptor": {
      "$ref": "../../../%F0%9F%A7%AC%EF%B8%8Fschema/%F0%9F%94%A3%EF%B8%8F.json#/$defs/NodeDescriptor"
    },
    "HandleDescriptor": {
      "$ref": "../../%F0%9F%A7%AC%EF%B8%8Fschema/%F0%9F%94%A3%EF%B8%8F.json#/$defs/HandleDescriptor"
    }
  },
  "$ref": "#/$defs/BoardSnapshot"
}
