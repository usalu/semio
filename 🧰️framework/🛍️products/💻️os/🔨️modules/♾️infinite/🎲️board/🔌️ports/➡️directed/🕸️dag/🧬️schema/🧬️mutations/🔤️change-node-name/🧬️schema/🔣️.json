{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "id",
        "newName"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "newName": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/payload"
    }
  ],
  "unevaluatedProperties": false
}
