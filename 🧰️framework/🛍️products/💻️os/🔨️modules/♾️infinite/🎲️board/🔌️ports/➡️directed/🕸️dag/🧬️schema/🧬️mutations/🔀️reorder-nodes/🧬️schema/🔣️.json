{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/payload"
    }
  ],
  "unevaluatedProperties": false
}
