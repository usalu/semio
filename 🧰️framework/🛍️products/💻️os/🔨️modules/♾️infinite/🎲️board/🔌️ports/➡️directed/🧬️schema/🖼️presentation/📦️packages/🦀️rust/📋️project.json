{
  "name": "semio-framework-os-infinite-directed-presentation",
  "projectType": "library",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "language:cargo"
  ],
  "targets": {
    "test-source": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "command": "repo ./📜️script.ts test-source",
        "forwardAllArgs": true
      }
    },
    "test-native": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "command": "repo ./📜️script.ts test-native",
        "forwardAllArgs": true
      }
    }
  }
}
