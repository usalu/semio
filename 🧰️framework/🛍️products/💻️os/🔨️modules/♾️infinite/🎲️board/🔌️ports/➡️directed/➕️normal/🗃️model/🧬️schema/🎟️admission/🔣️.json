{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "physicalOperation",
    "physicalGeneration",
    "semanticSerial",
    "semanticGeneration",
    "seed",
    "pageItems",
    "scratchDescriptorPages",
    "snapshotDescriptorPages",
    "descriptorPointerWords",
    "originalReceiptCount",
    "deniedAxes",
    "candidateRetainedAfterReceiptRefusal"
  ],
  "additionalProperties": false,
  "properties": {
    "physicalOperation": {
      "type": "integer",
      "minimum": 0
    },
    "physicalGeneration": {
      "type": "integer",
      "minimum": 0
    },
    "semanticSerial": {
      "type": "integer",
      "minimum": 0
    },
    "semanticGeneration": {
      "type": "integer",
      "minimum": 0
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "pageItems": {
      "type": "integer",
      "minimum": 0
    },
    "scratchDescriptorPages": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "snapshotDescriptorPages": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "descriptorPointerWords": {
      "type": "integer",
      "minimum": 0
    },
    "originalReceiptCount": {
      "type": "integer",
      "minimum": 0
    },
    "deniedAxes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "candidateRetainedAfterReceiptRefusal": {
      "const": true
    }
  }
}
