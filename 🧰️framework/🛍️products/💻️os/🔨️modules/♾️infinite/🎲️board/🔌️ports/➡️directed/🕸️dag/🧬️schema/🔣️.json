{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dag Snapshot",
  "description": "Known fields and input defaults of DagSnapshot and its intrinsic values. Owner serde ignores unknown nested fields. DagNodeKind.Select.selected is u64. AppInstance uses appIcon independently of the common DagNodeSpec icon.",
  "$ref": "#/$defs/DagSnapshot",
  "$defs": {
    "U64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "PropertyValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertyValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PropertyValue"
          }
        }
      ]
    },
    "PropertyBag": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PropertyValue"
      }
    },
    "IoPortSpec": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "abbreviation": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "$ref": "#/$defs/PropertyValue"
        },
        "value": {
          "$ref": "#/$defs/PropertyValue"
        },
        "connected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "resourceKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "cardinality": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "semicircle",
            "triangle"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "resolved": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "DagMedia": {
      "type": "object",
      "required": [
        "kind",
        "src"
      ],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "svg",
            "pdf",
            "video"
          ]
        },
        "src": {
          "type": "string"
        }
      }
    },
    "DagPreviewContent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "variant"
          ],
          "properties": {
            "variant": {
              "const": "empty"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "variant",
            "text"
          ],
          "properties": {
            "variant": {
              "const": "scalar"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "variant",
            "src"
          ],
          "properties": {
            "variant": {
              "const": "image"
            },
            "src": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "variant",
            "json"
          ],
          "properties": {
            "variant": {
              "const": "tree"
            },
            "json": {
              "$ref": "#/$defs/PropertyValue"
            }
          }
        }
      ]
    },
    "DagNodeKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "inputs",
            "outputs"
          ],
          "properties": {
            "kind": {
              "const": "computation"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IoPortSpec"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IoPortSpec"
              }
            },
            "variadic_inputs": {
              "type": "boolean"
            },
            "variadic_outputs": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "min",
            "max",
            "step",
            "value",
            "output"
          ],
          "properties": {
            "kind": {
              "const": "slider"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number"
            },
            "value": {
              "type": "number"
            },
            "output": {
              "$ref": "#/$defs/IoPortSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "options",
            "output"
          ],
          "properties": {
            "kind": {
              "const": "select"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "selected": {
              "$ref": "#/$defs/U64"
            },
            "output": {
              "$ref": "#/$defs/IoPortSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "input"
          ],
          "properties": {
            "kind": {
              "const": "screen"
            },
            "media": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DagMedia"
                },
                {
                  "type": "null"
                }
              ]
            },
            "input": {
              "$ref": "#/$defs/IoPortSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "output"
          ],
          "properties": {
            "kind": {
              "const": "note"
            },
            "text": {
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/IoPortSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "output"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "src": {
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/IoPortSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "input"
          ],
          "properties": {
            "kind": {
              "const": "preview"
            },
            "content": {
              "$ref": "#/$defs/DagPreviewContent"
            },
            "expanded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "input": {
              "$ref": "#/$defs/IoPortSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "label",
            "input"
          ],
          "properties": {
            "kind": {
              "const": "action"
            },
            "label": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/IoPortSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "label",
            "format",
            "input"
          ],
          "properties": {
            "kind": {
              "const": "export"
            },
            "label": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/IoPortSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "inputs",
            "outputs"
          ],
          "properties": {
            "kind": {
              "const": "cluster"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IoPortSpec"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IoPortSpec"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "instanceId",
            "pluginId",
            "appId",
            "inputs",
            "outputs"
          ],
          "properties": {
            "kind": {
              "const": "appInstance"
            },
            "instanceId": {
              "type": "string"
            },
            "pluginId": {
              "type": "string"
            },
            "appId": {
              "type": "string"
            },
            "appIcon": {
              "type": "string"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IoPortSpec"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IoPortSpec"
              }
            }
          }
        }
      ]
    },
    "DagNodeSpec": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "abbreviation": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "operatorKind": {
              "type": [
                "string",
                "null"
              ]
            },
            "properties": {
              "$ref": "#/$defs/PropertyBag"
            }
          }
        },
        {
          "$ref": "#/$defs/DagNodeKind"
        }
      ]
    },
    "EdgeRouteStyle": {
      "enum": [
        "bezier",
        "sharpSz"
      ]
    },
    "DagFixtureEdge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "routeStyle": {
          "$ref": "#/$defs/EdgeRouteStyle"
        },
        "properties": {
          "$ref": "#/$defs/PropertyBag"
        }
      }
    },
    "DagSnapshot": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DagNodeSpec"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DagFixtureEdge"
          }
        }
      }
    }
  }
}
