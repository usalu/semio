{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Board 🔌️ports Descriptor Model",
  "$defs": {
    "HandleDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "angle": {
          "type": "number"
        },
        "radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "handleKind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "iconKind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "userData": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "locked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "nodeId",
        "angle"
      ],
      "additionalProperties": true
    },
    "CameraDescriptor": {
      "$ref": "../../%F0%9F%A7%AC%EF%B8%8Fschema/%F0%9F%94%A3%EF%B8%8F.json#/$defs/CameraDescriptor"
    },
    "NodeDescriptor": {
      "$ref": "../../%F0%9F%A7%AC%EF%B8%8Fschema/%F0%9F%94%A3%EF%B8%8F.json#/$defs/NodeDescriptor"
    }
  },
  "$ref": "#/$defs/HandleDescriptor"
}
