{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/infinite/artifacts/dag/host-kind-admission.json",
  "title": "DAG Host Snapshot Kind Admission",
  "type": "object",
  "required": [
    "schema",
    "camera",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "camera": {
      "type": "object",
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "computation",
              "slider",
              "select",
              "screen",
              "note",
              "image",
              "preview",
              "action",
              "export",
              "cluster",
              "appInstance"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "inputs",
              "outputs"
            ],
            "properties": {
              "kind": {
                "const": "computation"
              },
              "inputs": {
                "type": "array"
              },
              "outputs": {
                "type": "array"
              }
            }
          },
          {
            "required": [
              "min",
              "max",
              "step",
              "value",
              "output"
            ],
            "properties": {
              "kind": {
                "const": "slider"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "value": {
                "type": "number"
              },
              "output": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "options",
              "output"
            ],
            "properties": {
              "kind": {
                "const": "select"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "output": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "input"
            ],
            "properties": {
              "kind": {
                "const": "screen"
              },
              "input": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "text",
              "output"
            ],
            "properties": {
              "kind": {
                "const": "note"
              },
              "text": {
                "type": "string"
              },
              "output": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "output"
            ],
            "properties": {
              "kind": {
                "const": "image"
              },
              "output": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "input"
            ],
            "properties": {
              "kind": {
                "const": "preview"
              },
              "input": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "label",
              "input"
            ],
            "properties": {
              "kind": {
                "const": "action"
              },
              "label": {
                "type": "string"
              },
              "input": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "label",
              "format",
              "input"
            ],
            "properties": {
              "kind": {
                "const": "export"
              },
              "label": {
                "type": "string"
              },
              "format": {
                "type": "string"
              },
              "input": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "inputs",
              "outputs"
            ],
            "properties": {
              "kind": {
                "const": "cluster"
              },
              "inputs": {
                "type": "array"
              },
              "outputs": {
                "type": "array"
              }
            }
          },
          {
            "required": [
              "instanceId",
              "pluginId",
              "appId",
              "inputs",
              "outputs"
            ],
            "properties": {
              "kind": {
                "const": "appInstance"
              },
              "instanceId": {
                "type": "string"
              },
              "pluginId": {
                "type": "string"
              },
              "appId": {
                "type": "string"
              },
              "inputs": {
                "type": "array"
              },
              "outputs": {
                "type": "array"
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array"
    }
  }
}
