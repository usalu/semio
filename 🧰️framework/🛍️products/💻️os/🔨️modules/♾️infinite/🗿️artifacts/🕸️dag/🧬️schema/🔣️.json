{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/infinite/artifacts/dag/schema.json",
  "title": "Dag Artifact",
  "$defs": {
    "PackageContractSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "nodes",
        "edges"
      ],
      "properties": {
        "schema": {
          "const": "dag.hostDocument"
        },
        "nodes": {
          "type": "array"
        },
        "edges": {
          "type": "array"
        }
      }
    }
  }
}
