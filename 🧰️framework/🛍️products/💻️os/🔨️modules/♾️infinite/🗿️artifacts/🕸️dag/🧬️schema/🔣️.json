{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/infinite/artifacts/dag/schema.json",
  "title": "Dag Artifact",
  "$defs": {
    "PackageContractCases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/PackageContractCase" }
        }
      }
    },
    "PackageContractCase": {
      "type": "object",
      "required": ["id", "snapshot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "snapshot": { "$ref": "#/$defs/PackageContractSnapshot" }
      }
    },
    "PackageContractSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "nodes", "edges"],
      "properties": {
        "schema": { "const": "dag.fixture" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" }
      }
    }
  }
}
