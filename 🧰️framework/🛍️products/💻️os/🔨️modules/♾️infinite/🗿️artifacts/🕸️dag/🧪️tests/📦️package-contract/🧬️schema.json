{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "snapshot"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "snapshot": {
            "type": "object",
            "required": [
              "schema",
              "nodes",
              "edges"
            ],
            "additionalProperties": false,
            "properties": {
              "schema": {
                "const": "dag.fixture"
              },
              "nodes": {
                "type": "array"
              },
              "edges": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  }
}
