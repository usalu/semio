{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/infinite/artifacts/dag/vcs/mutation/reorder-nodes/schema.json",
  "title": "ReorderNodes",
  "propertyNames": {
    "enum": [
      "operation",
      "moves"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "moves"
  ],
  "properties": {
    "operation": {
      "const": "reorderNodes"
    },
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "to": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Node moves",
          "de": "Knotenverschiebungen"
        },
        "description": {
          "en": "Each step places one node at a z-stack position, counted in the order left by the steps before it.",
          "de": "Jeder Schritt setzt einen Knoten an eine Position im Z-Stapel, gezählt in der Reihenfolge nach den vorigen Schritten."
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
