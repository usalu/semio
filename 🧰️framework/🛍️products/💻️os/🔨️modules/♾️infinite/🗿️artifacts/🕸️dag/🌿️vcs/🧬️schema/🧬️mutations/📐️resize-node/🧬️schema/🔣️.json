{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/os/infinite/dag/vcs/mutation/resize-node/schema.json",
  "title": "ResizeNode",
  "type": "object",
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "id",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/payload"
    }
  ],
  "propertyNames": {
    "enum": [
      "height",
      "id",
      "width"
    ]
  }
}
