{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/infinite/artifacts/dag/vcs/mutation/move-node/schema.json",
  "title": "MoveNode",
  "propertyNames": {
    "enum": [
      "operation",
      "id",
      "x",
      "y"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "id",
    "x",
    "y"
  ],
  "properties": {
    "operation": {
