        "label": {
          "en": "X",
          "de": "X"
        },
        "step": 1,
        "precision": 2,
        "group": "position",
        "order": 20
      }
    },
    "y": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Y",
          "de": "Y"
        },
        "step": 1,
        "precision": 2,
        "group": "position",
        "order": 30
      }
    }
