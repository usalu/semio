{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/os/infinite/dag/vcs/mutation/move-node/schema.json",
  "title": "MoveNode",
  "type": "object",
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/payload"
    }
  ],
  "propertyNames": {
    "enum": [
      "id",
      "x",
      "y"
    ]
  }
}
