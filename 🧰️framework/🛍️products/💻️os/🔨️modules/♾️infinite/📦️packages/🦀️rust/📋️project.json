{
  "name": "semio-framework-os-infinite",
  "projectType": "library",
  "tags": [
    "language:cargo"
  ],
  "targets": {
    "build": {
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "options": {
        "cwd": ".",
        "command": "bun \"🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/📜️script.ts\" native cargo build --manifest \"🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/📦️packages/🦀️rust/Cargo.toml\""
      }
    },
    "check": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "cwd": ".",
        "command": "bun \"🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/📜️script.ts\" native cargo check --manifest \"🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/📦️packages/🦀️rust/Cargo.toml\""
      }
    },
    "test": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "cwd": ".",
        "command": "bun \"🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/📜️script.ts\" native cargo test --manifest \"🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/📦️packages/🦀️rust/Cargo.toml\""
      }
    },
    "fonts": {
      "cache": true,
      "inputs": [
        "{projectRoot}/📜️script.ts",
        "{projectRoot}/../../🖼️canvas/🔤️fonts/🟦️.ts",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "dependsOn": [
        "semio-framework-os-font-assets:build"
      ],
      "outputs": [
        "{projectRoot}/dist/fonts"
      ],
      "options": {
        "command": "bun ./📜️script.ts fonts"
      }
    },
    "test-wgpu-world-terrain": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "command": "bun ./📜️script.ts test-wgpu-world-terrain",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "cwd": ".",
        "command": "bun \"🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/📜️script.ts\" native cargo test --manifest \"🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/📦️packages/🦀️rust/Cargo.toml\""
      }
    },
    "test-long": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "cwd": ".",
        "command": "bun \"🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/📜️script.ts\" native cargo test --manifest \"🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/📦️packages/🦀️rust/Cargo.toml\""
      }
    },
    "test-exhaustive": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "cwd": ".",
        "command": "bun \"🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/📜️script.ts\" native cargo test --manifest \"🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/📦️packages/🦀️rust/Cargo.toml\""
      }
    }
  },
  "namedInputs": {
    "nativeAssets": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🔣️icons/**/*.svg",
      "!{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🔣️icons/🤖️generated/**/*.svg",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🌱️metabolism/🔣️icons/**/*.svg",
      "!{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🌱️metabolism/🔣️icons/🤖️generated/**/*.svg",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🔣️icons/🤖️generated/🔣️shortcodes.json"
    ],
    "default": [
      "nativeAssets"
    ],
    "nativeSources": [
      "nativeAssets"
    ],
    "nativeTestSources": [
      "nativeAssets"
    ]
  }
}
