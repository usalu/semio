{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "complete",
    "canonicalPayload"
  ],
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "canonicalPayload": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "if": {
    "properties": {
      "complete": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "canonicalPayload": {
        "type": "array"
      }
    }
  }
}
