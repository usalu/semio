{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "neuronId",
    "operatorId",
    "inputJson"
  ],
  "properties": {
    "neuronId": {
      "type": "string",
      "minLength": 1
    },
    "operatorId": {
      "type": "string",
      "minLength": 1
    },
    "inputJson": {
      "type": "string"
    },
    "dependencyJson": {
      "type": "string"
    },
    "operatorVersion": {
      "type": "string"
    },
    "cancellationId": {
      "type": "string"
    },
    "nodeHash": {
      "type": "integer",
      "minimum": 0
    },
    "roundUnits": {
      "type": "integer",
      "minimum": 0,
      "description": "Work units before a progress answer. An omitted or zero value uses the standard round of 256 units. Explicit values are capped at 4096 units. Either limit can end early after two seconds of recorded evaluation time. Every poll remains subject to the caller's grants and deadlines."
    },
    "resume": {
      "type": "boolean"
    },
    "externalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neuronId",
        "extensionId",
        "operatorId",
        "nodeHash",
        "outputJson"
      ],
      "properties": {
        "neuronId": {
          "type": "string",
          "minLength": 1
        },
        "extensionId": {
          "type": "string",
          "minLength": 1
        },
        "operatorId": {
          "type": "string",
          "minLength": 1
        },
        "outputJson": {
          "type": "string"
        },
        "nodeHash": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "windowId": {
      "type": "string"
    },
    "windowKindId": {
      "type": "string"
    },
    "extensionId": {
      "type": "string"
    }
  }
}
