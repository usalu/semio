{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "neuronId",
    "operatorId",
    "inputJson"
  ],
  "properties": {
    "neuronId": {
      "type": "string",
      "minLength": 1
    },
    "operatorId": {
      "type": "string",
      "minLength": 1
    },
    "inputJson": {
      "type": "string"
    },
    "dependencyJson": {
      "type": "string"
    },
    "operatorVersion": {
      "type": "string"
    },
    "cancellationId": {
      "type": "string"
    },
    "nodeHash": {
      "type": "integer",
      "minimum": 0
    },
    "roundUnits": {
      "type": "integer",
      "minimum": 0
    },
    "resume": {
      "type": "boolean"
    },
    "externalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neuronId",
        "extensionId",
        "operatorId",
        "nodeHash",
        "outputJson"
      ],
      "properties": {
        "neuronId": {
          "type": "string",
          "minLength": 1
        },
        "extensionId": {
          "type": "string",
          "minLength": 1
        },
        "operatorId": {
          "type": "string",
          "minLength": 1
        },
        "outputJson": {
          "type": "string"
        },
        "nodeHash": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "windowId": {
      "type": "string"
    },
    "windowKindId": {
      "type": "string"
    },
    "extensionId": {
      "type": "string"
    }
  }
}
