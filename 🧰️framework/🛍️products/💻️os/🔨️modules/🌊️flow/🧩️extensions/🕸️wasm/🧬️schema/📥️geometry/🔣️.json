{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "policy",
    "dependencies",
    "cancellationId",
    "validity",
    "quality",
    "copyPolicies"
  ],
  "properties": {
    "source": {
      "type": "object"
    },
    "policy": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "array",
        "items": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "cancellationId": {
      "type": "string",
      "minLength": 1
    },
    "validity": {
      "const": "valid"
    },
    "quality": {
      "const": "PolygonMesh"
    },
    "copyPolicies": {
      "const": [
        1,
        3,
        64
      ]
    }
  }
}
