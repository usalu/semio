{
  "name": "semio-framework-os-flow",
  "projectType": "library",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/⚖️typed-input-law/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🌊️flow/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🌊️flow/🗃️operators/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "language:cargo"
  ],
  "targets": {
    "test-extension-registry": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "command": "repo ./📜️script.ts test-extension-registry",
        "forwardAllArgs": true
      }
    },
    "test-form-producer": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "command": "repo ./📜️script.ts test-form-producer",
        "forwardAllArgs": true
      }
    },
    "test-form-source": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "command": "repo ./📜️script.ts test-form-source",
        "forwardAllArgs": true
      }
    }
  }
}
