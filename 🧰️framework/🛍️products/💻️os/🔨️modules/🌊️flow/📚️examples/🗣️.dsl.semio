semio flow.flow.dsl v1
schema=flow.fixture
camera {
  x=0 y=0 zoom=1
}
widgets {
  input-slider id=slider label=Number value=3 min=0 max=10 step=0.1
  neuron id=add neuron-kind=math.add input-ports=[ ] output-ports=[ ] preview=true
  output-preview id=preview expanded=[ ]
}
synapses [id:TEXT link:WIRE] {
  s1 slider@number->add@a
  s2 add@sum->preview
}
layout={ }
