{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.flow.typed-copy.corpus.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceFixture",
    "allocationAdmission",
    "grants",
    "cases",
    "cancelAfter",
    "expected",
    "factoryCustody"
  ],
  "properties": {
    "schema": {
      "const": "semio.flow.typed-copy.v1"
    },
    "sourceFixture": {
      "const": "../../🧫️fixtures/🔣️.json"
    },
    "allocationAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "singleBytes",
        "totalBytes",
        "reservationCopiesBytes"
      ],
      "properties": {
        "singleBytes": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "reservationCopiesBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "index",
          "pointer"
        ],
        "properties": {
          "kind": {
            "enum": [
              "widget",
              "synapse",
              "hostSnapshot"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "pointer": {
            "type": "string"
          }
        }
      }
    },
    "cancelAfter": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameSourceAllocation",
        "sourceMutation",
        "invalidIndexPreservesOwner",
        "framesBeforeRoot",
        "unchangedMapAllocationShared",
        "finalRootDrops",
        "unclosedDropPreservesRoot"
      ],
      "properties": {
        "sameSourceAllocation": {
          "type": "boolean"
        },
        "sourceMutation": {
          "type": "boolean"
        },
        "invalidIndexPreservesOwner": {
          "type": "boolean"
        },
        "framesBeforeRoot": {
          "type": "boolean"
        },
        "unchangedMapAllocationShared": {
          "type": "boolean"
        },
        "finalRootDrops": {
          "type": "integer",
          "minimum": 0
        },
        "unclosedDropPreservesRoot": {
          "type": "boolean"
        }
      }
    },
    "factoryCustody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyGrants",
        "handoffCapacityBytes",
        "handoffReleaseBytes",
        "sameOriginalSource",
        "refusalCapacityBytes",
        "refusalReleaseBytes",
        "terminalDropBytes",
        "partialTicketPreserved",
        "refusedOriginalPreserved",
        "actualFailedReceiptPreserved"
      ],
      "properties": {
        "copyGrants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "handoffCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "handoffReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sameOriginalSource": {
          "type": "boolean"
        },
        "refusalCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "refusalReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "terminalDropBytes": {
          "type": "integer",
          "minimum": 0
        },
        "partialTicketPreserved": {
          "type": "boolean"
        },
        "refusedOriginalPreserved": {
          "type": "boolean"
        },
        "actualFailedReceiptPreserved": {
          "type": "boolean"
        }
      }
    }
  }
}
