{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/flow/artifacts/flow/retained/component.json",
  "title": "Flow Retained Contracts",
  "$defs": {
    "FlowCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        }
      }
    },
    "FlowLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "FlowDictionary": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/FlowDictionary"
          }
        ]
      }
    },
    "FlowRetirementV1": {
      "title": "Flow Retained Retirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "grants",
        "physicalRetirement",
        "fixture",
        "expected"
      ],
      "properties": {
        "schema": {
          "const": "semio.flow.retirement.v1"
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "minItems": 3,
          "maxItems": 3
        },
        "physicalRetirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directOwners",
            "nestedOwners",
            "oversizedMinimumBytes",
            "subexactMaximumBytes",
            "multiRootIngress",
            "laws"
          ],
          "properties": {
            "directOwners": {
              "const": [
                "bytes",
                "strings",
                "widgets",
                "specs",
                "neurons",
                "synapses",
                "previews",
                "layout"
              ]
            },
            "nestedOwners": {
              "const": [
                "orderedSet",
                "orderedLayoutMap",
                "orderedNodeMap",
                "dynamicDictionary",
                "dynamicValue",
                "frontierMetadata",
                "frontierPayload"
              ]
            },
            "oversizedMinimumBytes": {
              "type": "integer",
              "minimum": 4097
            },
            "subexactMaximumBytes": {
              "const": 4096
            },
            "multiRootIngress": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "firstCapacityBytes",
                "secondCapacityBytes",
                "ownerCount",
                "laws"
              ],
              "properties": {
                "firstCapacityBytes": {
                  "type": "integer",
                  "minimum": 4097
                },
                "secondCapacityBytes": {
                  "type": "integer",
                  "minimum": 4097
                },
                "ownerCount": {
                  "const": 2
                },
                "laws": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "missingAdmissionReturnsOwner",
                    "subexactAdmissionUnchanged",
                    "preflightBeforeMovement",
                    "retryTransfersOnce",
                    "explicitCloseReleasesAll"
                  ],
                  "properties": {
                    "missingAdmissionReturnsOwner": { "const": true },
                    "subexactAdmissionUnchanged": { "const": true },
                    "preflightBeforeMovement": { "const": true },
                    "retryTransfersOnce": { "const": true },
                    "explicitCloseReleasesAll": { "const": true }
                  }
                }
              }
            },
            "laws": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "checkedCapacityBytes",
                "childrenBeforeBacking",
                "zeroGrantUnchanged",
                "subexactGrantUnchanged",
                "exactCapacityReleasedOnce",
                "frontierReleasedLast",
                "terminalLedgerZero",
                "coldUsesDemand"
              ],
              "properties": {
                "checkedCapacityBytes": { "const": true },
                "childrenBeforeBacking": { "const": true },
                "zeroGrantUnchanged": { "const": true },
                "subexactGrantUnchanged": { "const": true },
                "exactCapacityReleasedOnce": { "const": true },
                "frontierReleasedLast": { "const": true },
                "terminalLedgerZero": { "const": true },
                "coldUsesDemand": { "const": true }
              }
            }
          }
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "camera",
            "widgets",
            "synapses",
            "layout"
          ],
          "properties": {
            "schema": {
              "const": "flow.fixture"
            },
            "camera": {
              "$ref": "#/$defs/FlowCamera"
            },
            "widgets": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "label",
                      "value",
                      "min",
                      "max",
                      "step"
                    ],
                    "properties": {
                      "kind": {
                        "const": "inputSlider"
                      },
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "number"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "step": {
                        "type": "number"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "preview",
                      "expanded"
                    ],
                    "properties": {
                      "kind": {
                        "const": "outputPreview"
                      },
                      "id": {
                        "type": "string"
                      },
                      "preview": {
                        "$ref": "#/$defs/FlowDictionary"
                      },
                      "expanded": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "name",
                      "tree",
                      "flow"
                    ],
                    "properties": {
                      "kind": {
                        "const": "cluster"
                      },
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "tree": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "neurons",
                          "synapses"
                        ],
                        "properties": {
                          "neurons": {
                            "type": "array",
                            "maxItems": 0
                          },
                          "synapses": {
                            "type": "array",
                            "maxItems": 0
                          }
                        }
                      },
                      "flow": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "camera",
                          "nodes",
                          "previews"
                        ],
                        "properties": {
                          "camera": {
                            "$ref": "#/$defs/FlowCamera"
                          },
                          "nodes": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "layout",
                                "chrome"
                              ],
                              "properties": {
                                "layout": {
                                  "$ref": "#/$defs/FlowLayout"
                                },
                                "chrome": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "kind",
                                    "label",
                                    "value",
                                    "min",
                                    "max",
                                    "step"
                                  ],
                                  "properties": {
                                    "kind": {
                                      "const": "slider"
                                    },
                                    "label": {
                                      "type": "string"
                                    },
                                    "value": {
                                      "type": "number"
                                    },
                                    "min": {
                                      "type": "number"
                                    },
                                    "max": {
                                      "type": "number"
                                    },
                                    "step": {
                                      "type": "number"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "previews": {
                            "type": "array",
                            "maxItems": 0
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "synapses": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "from",
                  "to",
                  "fromPort",
                  "toPort"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "fromPort": {
                    "type": "string"
                  },
                  "toPort": {
                    "type": "string"
                  }
                }
              }
            },
            "layout": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/FlowLayout"
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "releasedBytes",
            "terminalEmpty"
          ],
          "properties": {
            "releasedBytes": {
              "type": "integer",
              "minimum": 4097
            },
            "terminalEmpty": {
              "const": true
            }
          }
        }
      }
    }
  }
}
