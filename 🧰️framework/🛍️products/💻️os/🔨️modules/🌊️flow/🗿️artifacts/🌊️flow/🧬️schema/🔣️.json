{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/flow/artifacts/flow/component.json",
  "title": "Flow Artifact Contracts",
  "$defs": {
    "FlowPackageContractCasesV1": {
      "title": "Flow Package Contract Cases",
      "type": "object",
      "required": [
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "snapshot"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "snapshot": {
                "type": "object",
                "required": [
                  "schema",
                  "camera",
                  "widgets",
                  "synapses",
                  "layout"
                ],
                "additionalProperties": false,
                "properties": {
                  "schema": {
                    "const": "flow.fixture"
                  },
                  "camera": {
                    "type": "object",
                    "required": [
                      "x",
                      "y",
                      "zoom"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "zoom": {
                        "type": "number"
                      }
                    }
                  },
                  "widgets": {
                    "type": "array"
                  },
                  "synapses": {
                    "type": "array"
                  },
                  "layout": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
