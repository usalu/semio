{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/flow/artifacts/flow/component.json",
  "title": "Flow Artifact Contracts",
  "$defs": {
    "FlowInputSliderDescriptorV1": {
      "type": "object",
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "const": "inputSlider"
        },
        "label": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "step": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
