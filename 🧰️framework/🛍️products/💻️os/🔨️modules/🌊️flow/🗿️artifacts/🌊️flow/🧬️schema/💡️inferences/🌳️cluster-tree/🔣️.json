{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/flow/cluster-tree-property.json",
  "title": "Cluster Tree Property",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "neurons",
    "synapses"
  ],
  "properties": {
    "neurons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Neuron"
      }
    },
    "synapses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Synapse"
      }
    }
  },
  "$defs": {
    "Tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neurons",
        "synapses"
      ],
      "properties": {
        "neurons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Neuron"
          }
        },
        "synapses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Synapse"
          }
        }
      }
    },
    "Neuron": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "params",
        "tree"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entry"
          }
        },
        "tree": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tree"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Synapse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "fromPort",
        "toPort"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "fromPort": {
          "type": "string"
        },
        "toPort": {
          "type": "string"
        }
      }
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      }
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "decimal"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "dictionary"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Entry"
              }
            }
          }
        }
      ]
    }
  }
}
