{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json",
  "title": "FlowFixture Intrinsic Wire Schema",
  "description": "Source-owned serde domain shapes. Intrinsic unknown fields and default omission follow current artifact/neural serde; direct operation wrappers are strict. No runtime detector coverage is asserted.",
  "$ref": "#/$defs/Fixture",
  "$defs": {
    "Index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "Synapse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "fromPort": {
          "type": "string"
        },
        "toPort": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ]
    },
    "LayoutEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/definitions/layout"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "Widget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "neuron"
            },
            "id": {
              "type": "string"
            },
            "neuronKind": {
              "type": "string"
            },
            "params": {
              "$ref": "#/definitions/dictionary"
            },
            "input_ports": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_ports": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "preview": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "neuronKind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "inputSlider"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "id",
            "label"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "inputNote"
            },
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "inputImage"
            },
            "id": {
              "type": "string"
            },
            "src": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "variable"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "outputPreview"
            },
            "id": {
              "type": "string"
            },
            "preview": {
              "$ref": "#/definitions/dictionary"
            },
            "expanded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "outputAction"
            },
            "id": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "outputExport"
            },
            "id": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cluster"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "tree": {
              "$ref": "#/definitions/tree"
            },
            "flow": {
              "$ref": "#/definitions/flowUi"
            }
          },
          "required": [
            "kind",
            "id",
            "tree"
          ]
        }
      ]
    },
    "Fixture": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "camera": {
          "$ref": "#/definitions/camera"
        },
        "widgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Widget"
          }
        },
        "synapses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Synapse"
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/layout"
          }
        }
      },
      "required": [
        "schema",
        "camera",
        "widgets",
        "synapses"
      ]
    }
  },
  "definitions": {
    "layout": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "zoom"
      ]
    },
    "neuralValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/neuralValue"
          }
        }
      ]
    },
    "dictionary": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/neuralValue"
      }
    },
    "neuron": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "$ref": "#/definitions/dictionary"
        },
        "tree": {
          "anyOf": [
            {
              "$ref": "#/definitions/tree"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "tree": {
      "type": "object",
      "properties": {
        "neurons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/neuron"
          }
        },
        "synapses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Synapse"
          }
        }
      },
      "required": [
        "neurons",
        "synapses"
      ]
    },
    "channel": {
      "type": "object",
      "properties": {
        "neuron": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        }
      },
      "required": [
        "neuron",
        "channel"
      ]
    },
    "preview": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/definitions/channel"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string"
        },
        "preview": {
          "$ref": "#/definitions/dictionary"
        },
        "expanded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/definitions/layout"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "mode"
      ]
    },
    "nodeGui": {
      "type": "object",
      "properties": {
        "layout": {
          "$ref": "#/definitions/layout"
        },
        "chrome": {
          "$ref": "#/definitions/chrome"
        }
      },
      "required": [
        "layout",
        "chrome"
      ]
    },
    "flowUi": {
      "type": "object",
      "properties": {
        "camera": {
          "$ref": "#/definitions/camera"
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/nodeGui"
          }
        },
        "previews": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/preview"
          }
        }
      },
      "required": [
        "camera",
        "nodes"
      ]
    },
    "chrome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "plain"
            },
            "preview": {
              "type": "boolean"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "slider"
            },
            "label": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "label",
            "min",
            "max",
            "step"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "note"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "image"
            },
            "src": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "variable"
            },
            "name": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "schema"
          ]
        }
      ]
    }
  }
}
