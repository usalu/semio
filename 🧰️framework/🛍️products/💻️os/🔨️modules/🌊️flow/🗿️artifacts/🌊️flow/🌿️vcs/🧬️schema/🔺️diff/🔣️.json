{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/diff.json",
  "title": "Ordered Flow Structural Diff",
  "$ref": "#/$defs/Diff",
  "$defs": {
    "Diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deltas"
      ],
      "properties": {
        "deltas": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/delta"
          }
        }
      }
    }
  },
  "definitions": {
    "identities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "widgetCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "replaced"
      ],
      "properties": {
        "removed": {
          "$ref": "#/definitions/identities"
        },
        "inserted": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json#/$defs/Index"
              },
              {
                "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json#/$defs/Widget"
              }
            ],
            "additionalItems": false
          }
        },
        "replaced": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "string"
              },
              {
                "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json#/$defs/Widget"
              }
            ],
            "additionalItems": false
          }
        }
      }
    },
    "synapseCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "replaced"
      ],
      "properties": {
        "removed": {
          "$ref": "#/definitions/identities"
        },
        "inserted": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json#/$defs/Index"
              },
              {
                "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json#/$defs/Synapse"
              }
            ],
            "additionalItems": false
          }
        },
        "replaced": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "string"
              },
              {
                "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json#/$defs/Synapse"
              }
            ],
            "additionalItems": false
          }
        }
      }
    },
    "delta": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delta",
            "value"
          ],
          "properties": {
            "delta": {
              "const": "widgets"
            },
            "value": {
              "$ref": "#/definitions/widgetCollection"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delta",
            "value"
          ],
          "properties": {
            "delta": {
              "const": "synapses"
            },
            "value": {
              "$ref": "#/definitions/synapseCollection"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delta",
            "value"
          ],
          "properties": {
            "delta": {
              "const": "layout"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json#/$defs/LayoutEntry"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delta",
            "value"
          ],
          "properties": {
            "delta": {
              "const": "fixture"
            },
            "value": {
              "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json"
            }
          }
        }
      ]
    }
  }
}
