{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/diff-ownership-tests.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base",
    "cases"
  ],
  "properties": {
    "base": {
      "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/snapshot.json"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "diff"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "diff": {
            "$ref": "https://semio.tech/schema/os/flow/artifacts/flow/vcs/diff.json"
          },
          "expectedWidgetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedSynapseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedLayoutIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "errorCode": {
            "enum": [
              "mutation.apply.missing-target",
              "mutation.apply.duplicate-target",
              "mutation.apply.index-range"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "expectedWidgetIds",
              "expectedSynapseIds",
              "expectedLayoutIds"
            ],
            "not": {
              "required": [
                "errorCode"
              ]
            }
          },
          {
            "required": [
              "errorCode"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "expectedWidgetIds"
                  ]
                },
                {
                  "required": [
                    "expectedSynapseIds"
                  ]
                },
                {
                  "required": [
                    "expectedLayoutIds"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
}
