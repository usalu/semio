{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/flow/artifacts/flow/parameter/component.json",
  "title": "Flow Graph Parameter Contracts",
  "$defs": {
    "GraphParameterBound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "min",
        "max",
        "step"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        }
      }
    },
    "GraphParameterV1": {
      "title": "Flow Graph Parameter Interaction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cases",
        "action",
        "expected"
      ],
      "properties": {
        "schema": {
          "const": "semio.flow.graph-parameter.v1"
        },
        "action": {
          "const": "setGraphParameter"
        },
        "cases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "app",
              "controllerId",
              "surfaceId",
              "widgetId",
              "label",
              "before",
              "request",
              "after"
            ],
            "properties": {
              "app": {
                "enum": [
                  "flow",
                  "generation2d",
                  "generation3d"
                ]
              },
              "controllerId": {
                "type": "string",
                "minLength": 1
              },
              "surfaceId": {
                "type": "string",
                "minLength": 1
              },
              "widgetId": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "$ref": "#/$defs/GraphParameterBound"
              },
              "request": {
                "type": "number"
              },
              "after": {
                "$ref": "#/$defs/GraphParameterBound"
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentJsonReads",
            "wholeFixtureActions",
            "gestureEndActions",
            "commitTimerMs"
          ],
          "properties": {
            "documentJsonReads": {
              "type": "integer",
              "minimum": 0,
              "maximum": 0
            },
            "wholeFixtureActions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 0
            },
            "gestureEndActions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 0
            },
            "commitTimerMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 0
            }
          }
        }
      }
    },
    "GraphParameterCommand": {
      "description": "🎚️ The `setGraphParameter` command a slider gesture dispatches: exactly one widget, one numeric value, and optionally the surface it was raised on. No document or fixture payload may ride along.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widgetId",
        "value"
      ],
      "properties": {
        "widgetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": "number"
        },
        "surfaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
