{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/flow/artifacts/flow/parameter/component.json",
  "title": "Flow Graph Parameter Contracts",
  "$defs": {
    "GraphParameterBound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "min",
        "max",
        "step"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        }
      }
    },
    "GraphParameterCommand": {
      "description": "🎚️ The `nodeGraphEdit` command a slider gesture dispatches: exactly one widget, one numeric value, and optionally the surface it was raised on. No document or fixture payload may ride along.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widgetId",
        "value"
      ],
      "properties": {
        "widgetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": "number"
        },
        "surfaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "$ref": "#/$defs/GraphParameterBound"
}
