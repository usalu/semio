{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows",
    "constructRegistry"
  ],
  "properties": {
    "constructRegistry": {
      "const": false
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "expected"
        ],
        "properties": {
          "state": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "generation"
                ],
                "properties": {
                  "generation": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "expected": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
