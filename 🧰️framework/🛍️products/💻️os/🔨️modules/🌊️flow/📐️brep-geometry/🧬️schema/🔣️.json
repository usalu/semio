{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/flow/brep-invoke/verbs.json",
  "title": "Brep Invoke Verbs",
  "description": "🌉️ Every verb the flow brep bridge `brep_invoke(method, argsJson)` dispatches: its wire method, the `BrepKernel` operation it wraps, its arguments in read order (an argument with a `default` is optional), its result shape and its en/de terminology. The dispatcher (`📐️brep-geometry/🦀️.rs`) and every caller (`✏️s/🔨️modules/🌐️spatial-kernel/⚙️engine/🧠️semio/🟦️.ts`) are held to this catalog by laws.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "verbs"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "semio.flow.brep-invoke.verbs/v1" },
    "verbs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verb" } }
  },
  "$defs": {
    "verb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "kernelOperation", "args", "result", "label"],
      "properties": {
        "method": { "type": "string", "pattern": "^[a-z][A-Za-z]*$" },
        "kernelOperation": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/argument" } },
        "result": { "enum": ["handle", "handles", "number", "vec3", "string", "mesh", "topology", "unit"] },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z]*$" },
        "type": { "enum": ["handle", "handles", "vec3", "points", "number", "integer", "boolean", "string"] },
        "default": { "anyOf": [{ "type": "number" }, { "type": "boolean" }] }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    }
  }
}
