{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.flow.graph-parameter.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases",
    "action",
    "expected"
  ],
  "definitions": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widgetId", "value"],
      "properties": {
        "widgetId": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "surfaceId": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "semio.flow.graph-parameter.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app",
          "controllerId",
          "surfaceId",
          "widgetId",
          "label",
          "before",
          "request",
          "after"
        ],
        "properties": {
          "app": {
            "enum": [
              "flow",
              "generation2d",
              "generation3d"
            ]
          },
          "controllerId": {
            "type": "string",
            "minLength": 1
          },
          "surfaceId": {
            "type": "string",
            "minLength": 1
          },
          "widgetId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "min",
              "max",
              "step"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              }
            }
          },
          "request": {
            "type": "number"
          },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "min",
              "max",
              "step"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "action": {
      "const": "setGraphParameter"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentJsonReads",
        "wholeFixtureActions",
        "gestureEndActions",
        "commitTimerMs"
      ],
      "properties": {
        "documentJsonReads": {
          "const": 0
        },
        "wholeFixtureActions": {
          "const": 0
        },
        "gestureEndActions": {
          "const": 0
        },
        "commitTimerMs": {
          "const": 0
        }
      }
    }
  }
}
