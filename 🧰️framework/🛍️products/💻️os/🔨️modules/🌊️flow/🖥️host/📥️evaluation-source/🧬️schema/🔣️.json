{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:flow:original-evaluation-source:corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "widgets",
          "synapses",
          "kindInfos",
          "expectedIds",
          "expectedPorts",
          "expectedClusters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "widgets": {
            "type": "array",
            "items": {
              "$ref": "https://json.schemas.assets.semio-tech.com/os/flow/artifacts/flow/retained/component.json#/$defs/Widget"
            }
          },
          "synapses": {
            "type": "array",
            "items": {
              "$ref": "https://json.schemas.assets.semio-tech.com/os/flow/artifacts/flow/retained/component.json#/$defs/Synapse"
            }
          },
          "kindInfos": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inputs",
                "outputs"
              ],
              "properties": {
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "expectedIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedPorts": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            }
          },
          "expectedClusters": {
            "type": "object",
            "additionalProperties": {
              "$ref": "https://json.schemas.assets.semio-tech.com/os/flow/artifacts/flow/retained/component.json#/$defs/Tree"
            }
          }
        }
      }
    }
  }
}
