{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "flow.original-evaluation-pipeline.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "remaining",
          "pending",
          "unfinished"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unfinished": {
            "type": "boolean"
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "neuronId",
                "extensionId",
                "operatorId",
                "nodeHash",
                "inputJson"
              ],
              "properties": {
                "neuronId": {
                  "type": "string"
                },
                "extensionId": {
                  "type": "string"
                },
                "operatorId": {
                  "type": "string"
                },
                "nodeHash": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inputJson": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
