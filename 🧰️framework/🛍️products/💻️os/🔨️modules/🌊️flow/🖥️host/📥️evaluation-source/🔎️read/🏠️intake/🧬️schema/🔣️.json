{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Flow Tick Intake Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "originalSourceRequired",
    "revisionRequired",
    "originRequired",
    "cloneBodies",
    "phases",
    "denials",
    "rejections",
    "copiesFullSnapshot",
    "normalHostOnly",
    "browserGeometryAuthority",
    "sourceHeldOnDenial",
    "sourceHeldThroughCancelClose",
    "receiptDebitedOnce",
    "terminalDrop",
    "closeStates",
    "completeRequiresEmpty"
  ],
  "properties": {
    "originalSourceRequired": {
      "const": true
    },
    "revisionRequired": {
      "const": true
    },
    "originRequired": {
      "const": true
    },
    "cloneBodies": {
      "const": [
        1,
        3,
        64
      ]
    },
    "phases": {
      "const": [
        "source",
        "snapshot",
        "snapshot-close",
        "catalogue",
        "baseline",
        "host",
        "transfer"
      ]
    },
    "denials": {
      "const": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ]
    },
    "rejections": {
      "const": [
        "source-owner",
        "revision",
        "operation",
        "generation",
        "catalogue"
      ]
    },
    "copiesFullSnapshot": {
      "const": true
    },
    "normalHostOnly": {
      "const": true
    },
    "browserGeometryAuthority": {
      "const": "existing-inference-broker"
    },
    "sourceHeldOnDenial": {
      "const": true
    },
    "sourceHeldThroughCancelClose": {
      "const": true
    },
    "receiptDebitedOnce": {
      "const": true
    },
    "terminalDrop": {
      "const": 0
    },
    "closeStates": {
      "const": [
        "snapshot",
        "snapshot-close",
        "origin",
        "empty"
      ]
    },
    "completeRequiresEmpty": {
      "const": true
    }
  }
}
