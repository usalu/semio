{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Preview Tessellation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handle",
    "tolerance",
    "nodeHash",
    "windowId",
    "windowKindId"
  ],
  "properties": {
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nodeHash": {
      "type": "integer",
      "minimum": 0
    },
    "windowId": {
      "type": "string",
      "minLength": 1
    },
    "windowKindId": {
      "type": "string",
      "minLength": 1
    }
  }
}
