          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "pointer": {
            "type": "string"
          }
        }
      }
    },
    "cancelAfter": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
