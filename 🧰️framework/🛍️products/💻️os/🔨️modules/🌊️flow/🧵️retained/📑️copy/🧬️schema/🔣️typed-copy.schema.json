    },
    "grants": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4096
      },
      "minItems": 3,
      "maxItems": 3
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "index",
          "pointer"
