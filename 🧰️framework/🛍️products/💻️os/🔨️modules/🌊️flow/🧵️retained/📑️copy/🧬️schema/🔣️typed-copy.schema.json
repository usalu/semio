          "const": true
        },
        "sourceMutation": {
          "const": false
        },
        "invalidIndexPreservesOwner": {
          "const": true
        },
        "framesBeforeRoot": {
          "const": true
        },
        "unchangedMapAllocationShared": {
          "const": true
        },
        "finalRootDrops": {
