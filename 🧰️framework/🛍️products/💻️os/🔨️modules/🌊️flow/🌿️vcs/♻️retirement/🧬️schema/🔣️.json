{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "flow.original-vcs-closure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "text",
    "repeat",
    "utf8Bytes",
    "copyGrants",
    "maximumTurns",
    "actionVariants",
    "expected",
    "closeAdmissionCases",
    "closeReceiptCases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "text": {
      "type": "string"
    },
    "repeat": {
      "type": "integer",
      "minimum": 0
    },
    "utf8Bytes": {
      "type": "integer",
      "minimum": 0
    },
    "copyGrants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "maximumTurns": {
      "type": "integer",
      "minimum": 0
    },
    "actionVariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSignalBirthBytes",
        "sourceSignalReleaseBytes",
        "refusalBirthBytes",
        "refusalReleaseBytes",
        "sameOriginalSource",
        "wholeOriginalExtentRequired",
        "terminalDropBytes",
        "domainRungsPerTurn"
      ],
      "properties": {
        "sourceSignalBirthBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSignalReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "refusalBirthBytes": {
          "type": "integer",
          "minimum": 0
        },
        "refusalReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sameOriginalSource": {
          "type": "boolean"
        },
        "wholeOriginalExtentRequired": {
          "type": "boolean"
        },
        "terminalDropBytes": {
          "type": "integer",
          "minimum": 0
        },
        "domainRungsPerTurn": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "closeAdmissionCases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "grant",
          "demands",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "grant": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maximumItems",
              "maximumCopyBytes",
              "maximumCapacityBytes",
              "maximumReleaseBytes",
              "maximumDepth"
            ],
            "properties": {
              "maximumItems": {
                "type": "integer",
                "minimum": 0
              },
              "maximumCopyBytes": {
                "type": "integer",
                "minimum": 0
              },
              "maximumCapacityBytes": {
                "type": "integer",
                "minimum": 0
              },
              "maximumReleaseBytes": {
                "type": "integer",
                "minimum": 0
              },
              "maximumDepth": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "demands": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "copyBytes",
              "capacityBytes",
              "releaseBytes",
              "depth"
            ],
            "properties": {
              "copyBytes": {
                "type": "integer",
                "minimum": 0
              },
              "capacityBytes": {
                "type": "integer",
                "minimum": 0
              },
              "releaseBytes": {
                "type": "integer",
                "minimum": 0
              },
              "depth": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "expected": {
            "enum": [
              "accepted",
              "deferred",
              "refused_depth"
            ]
          }
        }
      }
    },
    "closeReceiptCases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "grant",
          "progress",
          "complete",
          "terminal",
          "refused"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "grant": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maximumItems",
              "maximumCopyBytes",
              "maximumCapacityBytes",
              "maximumReleaseBytes",
              "maximumDepth"
            ],
            "properties": {
              "maximumItems": {
                "type": "integer",
                "minimum": 0
              },
              "maximumCopyBytes": {
                "type": "integer",
                "minimum": 0
              },
              "maximumCapacityBytes": {
                "type": "integer",
                "minimum": 0
              },
              "maximumReleaseBytes": {
                "type": "integer",
                "minimum": 0
              },
              "maximumDepth": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "copiedItems",
              "copiedBytes",
              "retainedCapacityBytes",
              "releasedBytes"
            ],
            "properties": {
              "copiedItems": {
                "type": "integer",
                "minimum": 0
              },
              "copiedBytes": {
                "type": "integer",
                "minimum": 0
              },
              "retainedCapacityBytes": {
                "type": "integer",
                "minimum": 0
              },
              "releasedBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "complete": {
            "type": "boolean"
          },
          "terminal": {
            "type": "boolean"
          },
          "refused": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
