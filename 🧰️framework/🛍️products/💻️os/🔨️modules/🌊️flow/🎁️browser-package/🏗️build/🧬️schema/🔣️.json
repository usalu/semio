{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "evaluationOwners"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "evaluationOwners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semio-plugin-extension", "semio-plugin-ownership"],
      "properties": {
        "semio-plugin-extension": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 2,
          "uniqueItems": true
        },
        "semio-plugin-ownership": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entry",
          "target",
          "generated",
          "refused"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "enum": [
              "producer",
              "consumer"
            ]
          },
          "target": {
            "enum": [
              "wasm",
              "declarations"
            ]
          },
          "generated": {
            "type": "boolean"
          },
          "refused": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
