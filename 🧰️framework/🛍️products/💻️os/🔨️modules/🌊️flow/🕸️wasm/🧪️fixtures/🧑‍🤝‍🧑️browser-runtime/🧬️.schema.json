{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flow Browser Runtime Lifetime",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sessions", "initialSessions", "openRequestIds", "afterCloseA", "receipt", "duplicateRuntime", "duplicateClose", "lateOpen", "openFailure", "backpressure", "mountedHosts", "runtimeClose"],
  "properties": {
    "schema": { "const": "semio.flow.browser-runtime-lifetime/v1" },
    "sessions": { "const": ["A", "B"] },
    "initialSessions": { "const": 0 },
    "openRequestIds": { "const": ["1", "2"] },
    "afterCloseA": { "const": { "retired": ["A"], "live": ["B"], "globalCloseCalls": 0, "siblingCommand": "completed" } },
    "receipt": { "const": { "event": 2657, "body": ["slot:u32", "generation:u32"], "origin": "open-request", "completion": "exact-acknowledged-terminal" } },
    "duplicateRuntime": { "const": "rejected-before-frame" },
    "duplicateClose": { "const": "same-promise" },
    "lateOpen": { "const": "exact-session-retired" },
    "openFailure": {
      "const": {
        "verifiedRejection": { "nativeSession": "absent", "entry": "released" },
        "uncertainTransport": { "entry": "retained-until-host-terminal", "globalCloseCalls": 1, "terminal": true }
      }
    },
    "backpressure": { "const": { "closeControlRejections": 3, "receiptAckRejections": 2, "eventSlotCollision": "retained-pending-publication" } },
    "mountedHosts": {
      "const": {
        "sharedRuntime": true,
        "afterUnmountA": { "closedSlots": [1], "liveSlot": 2, "command": 2610, "globalCloseCalls": 0 },
        "afterUnmountB": { "closedSlots": [1, 2], "globalCloseCalls": 0 },
        "lateUnmount": { "heldOpenSlot": 1, "liveSlot": 2, "closedSlots": [1], "command": 2610 }
      }
    },
    "runtimeClose": { "const": { "globalCloseCalls": 1, "newOpens": "rejected", "terminal": true } }
  }
}
