{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operationMethods", "excluded", "samples", "result", "canvasMethods"],
  "properties": {
    "version": { "const": 1 },
    "operationMethods": { "const": 108 },
    "excluded": { "const": ["open", "attachSurface", "renderFrame"] },
    "result": { "const": "FlowTask<unknown>" },
    "canvasMethods": { "const": ["attachCanvas", "renderCanvas"] },
    "samples": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "parameters"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "parameters": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
