{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operationMethods",
    "excluded",
    "samples",
    "result",
    "canvasMethods",
    "package"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "operationMethods": {
      "const": 105
    },
    "excluded": {
      "const": [
        "open",
        "attachSurface",
        "renderFrame"
      ]
    },
    "result": {
      "const": "FlowTask<unknown>"
    },
    "canvasMethods": {
      "const": [
        "attachCanvas",
        "renderCanvas"
      ]
    },
    "samples": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "parameters"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "package": {
      "const": {
        "name": "@semio-tech/flow-core",
        "files": [
          "flow_core_bg.wasm",
          "flow_core.js",
          "flow_core.d.ts",
          "flow_core_bg.wasm.d.ts",
          "🌐️flow-browser.js",
          "🖥️flow-host.js",
          "📝️flow-browser.d.ts"
        ],
        "exports": {
          ".": {
            "types": "./flow_core.d.ts",
            "import": "./flow_core.js"
          },
          "./🌐️flow-browser.js": {
            "types": "./📝️flow-browser.d.ts",
            "import": "./🌐️flow-browser.js"
          },
          "./🖥️flow-host.js": "./🖥️flow-host.js"
        }
      }
    }
  }
}
