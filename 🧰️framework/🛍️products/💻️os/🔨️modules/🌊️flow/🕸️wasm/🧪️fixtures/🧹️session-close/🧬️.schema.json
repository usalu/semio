{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retained Flow Session Close",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "browser", "close", "ordering", "rejectedPolls", "duplicateClose", "staleClose"],
  "properties": {
    "schema": { "const": "semio.flow.retained-session-close/v1" },
    "browser": { "const": { "requestBurst": 32, "terminalBeforeClose": false, "terminalAfterClose": true, "terminalOnClosingPoll": true, "yieldsToEvents": true, "pendingClosePolls": 4 } },
    "close": { "const": { "domainSteps": 3, "maximumTurns": 4096, "byteCredits": [1, 64, 4096], "retainedBeforePoll": 1, "retainedAfterTerminal": 0 } },
    "ordering": { "const": ["session-closed", "operation-retired", "domain-close-started", "domain-retired", "session-released"] },
    "rejectedPolls": { "const": ["zero-credit", "interrupted", "expired"] },
    "duplicateClose": { "const": "closed" },
    "staleClose": { "const": "rejected" }
  }
}
