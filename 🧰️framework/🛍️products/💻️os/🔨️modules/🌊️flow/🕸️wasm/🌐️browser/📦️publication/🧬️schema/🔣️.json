{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "namespace": "flow",
        "sourceOwner": "🧰️framework/🛍️products/💻️os/🔨️modules/🌊️flow/📦️packages/🦀️rust",
        "packageName": "@semio-tech/flow-core",
        "nativeFiles": [
          "flow_core_bg.wasm",
          "flow_core.js",
          "flow_core.d.ts",
          "flow_core_bg.wasm.d.ts"
        ],
        "browser": "🌐️browser/🟨️.js",
        "host": "🖥️host/🟨️.js",
        "declaration": "🌐️browser/🟦️.d.ts"
      }
    },
    "DeliveryIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "command"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "command": {
          "enum": [
            "build",
            "serve"
          ]
        }
      }
    },
    "ManifestIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "snippets"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snippets": {
          "type": "array",
          "maxItems": 16376,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^snippets/",
            "not": {
              "anyOf": [
                {
                  "pattern": "[\\\\:\\u0000-\\u001f]"
                },
                {
                  "pattern": "(?:^|/)\\.\\.?(?:/|$)"
                },
                {
                  "pattern": "//"
                }
              ]
            }
          }
        }
      }
    }
  }
}
