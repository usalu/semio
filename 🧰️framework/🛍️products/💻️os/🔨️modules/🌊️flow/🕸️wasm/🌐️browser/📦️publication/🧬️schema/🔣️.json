  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "namespace": "flow",
        "sourceOwner": "🧰️framework/🛍️products/💻️os/🔨️modules/🌊️flow/📦️packages/🦀️rust",
        "packageName": "@semio-tech/flow-core",
        "nativeFiles": [
          "flow_core_bg.wasm",
