{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/flow/wasm/component.json",
  "title": "Flow Wasm Bridge Contracts",
  "$defs": {
    "FlowSessionSlot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "FlowOperationCode": {
      "type": "integer",
      "minimum": 2500,
      "maximum": 2610
    },
    "FlowPackageExportEntry": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\./.+$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "types",
            "import"
          ],
          "properties": {
            "types": {
              "type": "string",
              "pattern": "^\\./.+$"
            },
            "import": {
              "type": "string",
              "pattern": "^\\./.+$"
            }
          }
        }
      ]
    },
    "FlowEditorBrowserAbiV1": {
      "title": "Flow Editor Browser ABI",
      "type": "object",
      "required": [
        "version",
        "operations",
        "arguments",
        "events",
        "limits",
        "identities",
        "framing",
        "surfaceProtocol"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operations": {
          "type": "object",
          "minProperties": 109,
          "maxProperties": 109,
          "additionalProperties": {
            "type": "integer",
            "minimum": 2500,
            "maximum": 2610
          }
        },
        "events": {
          "type": "object",
          "minProperties": 8,
          "maxProperties": 8,
          "additionalProperties": {
            "type": "integer",
            "minimum": 2650,
            "maximum": 2657
          }
        },
        "limits": {
          "type": "object"
        },
        "identities": {
          "type": "object"
        },
        "framing": {
          "type": "object"
        },
        "surfaceProtocol": {
          "const": "semio://framework.webgpu-surface-port/v1"
        },
        "arguments": {
          "type": "object",
          "minProperties": 109,
          "maxProperties": 109,
          "additionalProperties": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "utf8",
                    "optional-utf8",
                    "f64",
                    "u64",
                    "u32",
                    "u8",
                    "bool",
                    "bytes"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/FlowEditorBrowserAbiV1"
}
