{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/flow/wasm/component.json",
  "title": "Flow Wasm Bridge Contracts",
  "$defs": {
    "FlowSessionSlot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "FlowOperationCode": {
      "type": "integer",
      "minimum": 2500,
      "maximum": 2610
    },
    "FlowPackageExportEntry": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\./.+$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "types",
            "import"
          ],
          "properties": {
            "types": {
              "type": "string",
              "pattern": "^\\./.+$"
            },
            "import": {
              "type": "string",
              "pattern": "^\\./.+$"
            }
          }
        }
      ]
    },
    "FlowEditorBrowserAbiV1": {
      "title": "Flow Editor Browser ABI",
      "type": "object",
      "required": [
        "version",
        "operations",
        "arguments",
        "events",
        "limits",
        "identities",
        "framing",
        "surfaceProtocol"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operations": {
          "type": "object",
          "minProperties": 108,
          "maxProperties": 108,
          "additionalProperties": {
            "type": "integer",
            "minimum": 2500,
            "maximum": 2610
          }
        },
        "events": {
          "type": "object",
          "minProperties": 8,
          "maxProperties": 8,
          "additionalProperties": {
            "type": "integer",
            "minimum": 2650,
            "maximum": 2657
          }
        },
        "limits": {
          "type": "object"
        },
        "identities": {
          "type": "object"
        },
        "framing": {
          "type": "object"
        },
        "surfaceProtocol": {
          "const": "semio://framework.webgpu-surface-port/v1"
        },
        "arguments": {
          "type": "object",
          "minProperties": 108,
          "maxProperties": 108,
          "additionalProperties": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "utf8",
                    "optional-utf8",
                    "f64",
                    "u64",
                    "u32",
                    "u8",
                    "bool",
                    "bytes"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "FlowBrowserStartupV1": {
      "title": "Flow Browser Startup Admission",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cases",
        "clock"
      ],
      "properties": {
        "schema": {
          "const": "semio.flow.browser-startup/v1"
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "minimumSamples",
            "strictlyMonotonic"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "minimumSamples": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1024
            },
            "strictlyMonotonic": {
              "type": "boolean"
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "initializer",
              "imports",
              "accepted"
            ],
            "properties": {
              "source": {
                "enum": [
                  "exports",
                  "bytes"
                ]
              },
              "initializer": {
                "enum": [
                  "forbidden",
                  "generated",
                  "custom"
                ]
              },
              "imports": {
                "enum": [
                  "empty",
                  "foreign"
                ]
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "FlowRetainedSessionCloseV1": {
      "title": "Retained Flow Session Close",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "browser",
        "close",
        "ordering",
        "rejectedPolls",
        "duplicateClose",
        "staleClose"
      ],
      "properties": {
        "schema": {
          "const": "semio.flow.retained-session-close/v1"
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestBurst",
            "terminalBeforeClose",
            "terminalAfterClose",
            "terminalOnClosingPoll",
            "yieldsToEvents",
            "pendingClosePolls"
          ],
          "properties": {
            "requestBurst": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "terminalBeforeClose": {
              "type": "boolean",
              "const": false
            },
            "terminalAfterClose": {
              "type": "boolean",
              "const": true
            },
            "terminalOnClosingPoll": {
              "type": "boolean",
              "const": true
            },
            "yieldsToEvents": {
              "type": "boolean",
              "const": true
            },
            "pendingClosePolls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            }
          }
        },
        "close": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domainSteps",
            "maximumTurns",
            "byteCredits",
            "retainedBeforePoll",
            "retainedAfterTerminal"
          ],
          "properties": {
            "domainSteps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "maximumTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "byteCredits": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              }
            },
            "retainedBeforePoll": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "retainedAfterTerminal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 0
            }
          }
        },
        "ordering": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "session-closed",
              "operation-retired",
              "domain-close-started",
              "domain-retired",
              "session-released"
            ]
          }
        },
        "rejectedPolls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "zero-credit",
              "interrupted",
              "expired",
              "cancelled"
            ]
          }
        },
        "duplicateClose": {
          "enum": [
            "closed",
            "rejected"
          ]
        },
        "staleClose": {
          "enum": [
            "closed",
            "rejected"
          ]
        }
      }
    },
    "FlowBrowserRuntimeLifetimeV1": {
      "title": "Flow Browser Runtime Lifetime",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sessions",
        "initialSessions",
        "openRequestIds",
        "afterCloseA",
        "receipt",
        "duplicateRuntime",
        "duplicateClose",
        "lateOpen",
        "openFailure",
        "backpressure",
        "mountedHosts",
        "runtimeClose"
      ],
      "properties": {
        "schema": {
          "const": "semio.flow.browser-runtime-lifetime/v1"
        },
        "sessions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initialSessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "openRequestIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "afterCloseA": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retired",
            "live",
            "globalCloseCalls",
            "siblingCommand"
          ],
          "properties": {
            "retired": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "live": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "globalCloseCalls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 0
            },
            "siblingCommand": {
              "enum": [
                "completed",
                "rejected"
              ]
            }
          }
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "body",
            "origin",
            "completion"
          ],
          "properties": {
            "event": {
              "type": "integer",
              "minimum": 2650,
              "maximum": 2657
            },
            "body": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z]*:(u8|u32|u64|f64)$"
              }
            },
            "origin": {
              "enum": [
                "open-request",
                "close-request"
              ]
            },
            "completion": {
              "const": "exact-acknowledged-terminal"
            }
          }
        },
        "duplicateRuntime": {
          "enum": [
            "rejected-before-frame",
            "admitted"
          ]
        },
        "duplicateClose": {
          "enum": [
            "same-promise",
            "new-promise"
          ]
        },
        "lateOpen": {
          "enum": [
            "exact-session-retired",
            "admitted"
          ]
        },
        "openFailure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifiedRejection",
            "uncertainTransport"
          ],
          "properties": {
            "verifiedRejection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nativeSession",
                "entry"
              ],
              "properties": {
                "nativeSession": {
                  "enum": [
                    "absent",
                    "present"
                  ]
                },
                "entry": {
                  "enum": [
                    "released",
                    "retained-until-host-terminal"
                  ]
                }
              }
            },
            "uncertainTransport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry",
                "globalCloseCalls",
                "terminal"
              ],
              "properties": {
                "entry": {
                  "enum": [
                    "released",
                    "retained-until-host-terminal"
                  ]
                },
                "globalCloseCalls": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1
                },
                "terminal": {
                  "type": "boolean",
                  "const": true
                }
              }
            }
          }
        },
        "backpressure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "closeControlRejections",
            "receiptAckRejections",
            "eventSlotCollision"
          ],
          "properties": {
            "closeControlRejections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "receiptAckRejections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "eventSlotCollision": {
              "enum": [
                "retained-pending-publication",
                "dropped"
              ]
            }
          }
        },
        "mountedHosts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sharedRuntime",
            "afterUnmountA",
            "afterUnmountB",
            "lateUnmount"
          ],
          "properties": {
            "sharedRuntime": {
              "type": "boolean"
            },
            "afterUnmountA": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "closedSlots",
                "liveSlot",
                "command",
                "globalCloseCalls"
              ],
              "properties": {
                "closedSlots": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/FlowSessionSlot"
                  }
                },
                "liveSlot": {
                  "$ref": "#/$defs/FlowSessionSlot"
                },
                "command": {
                  "$ref": "#/$defs/FlowOperationCode"
                },
                "globalCloseCalls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 0
                }
              }
            },
            "afterUnmountB": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "closedSlots",
                "globalCloseCalls"
              ],
              "properties": {
                "closedSlots": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/FlowSessionSlot"
                  }
                },
                "globalCloseCalls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 0
                }
              }
            },
            "lateUnmount": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heldOpenSlot",
                "liveSlot",
                "closedSlots",
                "command"
              ],
              "properties": {
                "heldOpenSlot": {
                  "$ref": "#/$defs/FlowSessionSlot"
                },
                "liveSlot": {
                  "$ref": "#/$defs/FlowSessionSlot"
                },
                "closedSlots": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/FlowSessionSlot"
                  }
                },
                "command": {
                  "$ref": "#/$defs/FlowOperationCode"
                }
              }
            }
          }
        },
        "runtimeClose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "globalCloseCalls",
            "newOpens",
            "terminal"
          ],
          "properties": {
            "globalCloseCalls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "newOpens": {
              "enum": [
                "rejected",
                "admitted"
              ]
            },
            "terminal": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    },
    "FlowBrowserTypesV1": {
      "title": "Flow Browser Declaration Surface",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operationMethods",
        "excluded",
        "samples",
        "result",
        "canvasMethods",
        "package"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "operationMethods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 108
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "type": "string",
          "pattern": "^FlowTask<.+>$"
        },
        "canvasMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "samples": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "files",
            "exports"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exports": {
              "type": "object",
              "minProperties": 1,
              "required": [
                "."
              ],
              "properties": {
                ".": {
                  "$ref": "#/$defs/FlowPackageExportEntry"
                }
              },
              "additionalProperties": {
                "$ref": "#/$defs/FlowPackageExportEntry"
              }
            }
          }
        }
      }
    }
  }
}
