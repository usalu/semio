{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/os/semio/emission-refusal",
  "type": "array",
  "minItems": 9,
  "maxItems": 9,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "operation",
      "id",
      "component",
      "version",
      "body",
      "maximumBytes",
      "accept",
      "expected"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "operation": {
        "enum": [
          "prefix",
          "binary",
          "text"
        ]
      },
      "id": {
        "type": "string"
      },
      "component": {
        "enum": [
          "pack",
          "dsl"
        ]
      },
      "version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      },
      "body": {
        "type": "string"
      },
      "maximumBytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4096
      },
      "accept": {
        "type": "boolean"
      },
      "expected": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "message"
            ],
            "properties": {
              "kind": {
                "$ref": "https://semio.tech/schema/value/refusal#/$defs/kind"
              },
              "message": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hex",
              "prefixBytes"
            ],
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              },
              "prefixBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              }
            }
          }
        ]
      }
    }
  }
}