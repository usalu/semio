{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "bodyBytes",
    "textBody",
    "retained"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "bodyBytes": {
      "type": "integer",
      "minimum": 0
    },
    "retained": {
      "type": "object", "additionalProperties": false,
      "required": ["budgets", "textRepeats", "retirementBytes", "sourceReleases"],
      "properties": {
        "budgets": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "textRepeats": { "type": "integer", "minimum": 1 },
        "retirementBytes": { "type": "integer", "minimum": 1 },
        "sourceReleases": { "const": 1 }
      }
    },
    "textBody": {
      "type": "string"
    }
  }
}
