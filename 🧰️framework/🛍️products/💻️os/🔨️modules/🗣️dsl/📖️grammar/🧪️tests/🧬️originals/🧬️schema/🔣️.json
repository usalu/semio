{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.semio.tech/os/dsl/grammar/original-corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inputs",
    "shippedGrammarLawInputs"
  ],
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 503,
      "maxItems": 503,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "source"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "shippedGrammarLawInputs": {
      "type": "array",
      "minItems": 503,
      "maxItems": 503,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "uses"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
