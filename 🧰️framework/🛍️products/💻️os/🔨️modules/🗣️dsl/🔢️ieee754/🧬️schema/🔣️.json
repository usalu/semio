{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "title":"Exact IEEE Snapshot Payload Corpus",
 "type":"object","additionalProperties":false,
 "required":["binary64Bits","binary32Bits","binary64NanPrefix","binary32NanPrefix","invalid64","invalid32"],
 "properties":{
  "binary64Bits":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-f]{16}$"}},
  "binary32Bits":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-f]{8}$"}},
  "binary64NanPrefix":{"const":"nan64_"},"binary32NanPrefix":{"const":"nan32_"},
  "invalid64":{"type":"array","items":{"type":"string"}},"invalid32":{"type":"array","items":{"type":"string"}}
 }
}
