{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/dsl/fixture-sweep/component.json",
  "title": "Dsl Fixture Sweep Contracts",
  "$defs": {
    "DslFixtureSweepExtractionV1": {
      "title": "Dsl Fixture Sweep Extraction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "package",
        "target",
        "targetPath",
        "moduleSha256",
        "mounts",
        "laws",
        "workspaceDependencies",
        "pathDependencies",
        "kernelDependencies",
        "cases"
      ],
      "properties": {
        "schema": {
          "const": "semio.test.dsl-fixture-sweep-extraction/v1"
        },
        "package": {
          "const": "semio-framework-os-dsl-fixture-sweep"
        },
        "target": {
          "const": "fixture_sweep"
        },
        "targetPath": {
          "const": "🧰️framework/🛍️products/💻️os/🔨️modules/🗣️dsl/🧹️fixture-sweep/🧪️tests/🧹️fixture-sweep/🦀️.rs"
        },
        "moduleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mounts": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "path": { "type": "string", "pattern": "^\\.\\./.+/🦀️\\.rs$" }
            }
          }
        },
        "laws": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+::[a-z0-9_]+$"
          }
        },
        "workspaceDependencies": {
          "type": "array",
          "minItems": 53,
          "maxItems": 53,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^semio-[a-z0-9-]+$"
          }
        },
        "pathDependencies": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "package", "path", "features", "defaultFeatures"],
            "properties": {
              "alias": { "type": "string", "minLength": 1 },
              "package": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "features": { "type": "array", "items": { "type": "string" } },
              "defaultFeatures": { "type": "boolean" }
            }
          }
        },
        "kernelDependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cases": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  }
}
