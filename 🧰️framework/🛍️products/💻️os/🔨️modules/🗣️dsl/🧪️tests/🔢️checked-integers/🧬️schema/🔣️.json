{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checked DSL Integer Codec Vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "integers", "indices", "ordinals"],
  "properties": {
    "version": { "const": 1 },
    "integers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "decimal", "accepted32", "accepted64"],
        "properties": {
          "type": { "enum": ["i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize"] },
          "decimal": { "$ref": "#/$defs/decimal" },
          "accepted32": { "type": "boolean" },
          "accepted64": { "type": "boolean" }
        }
      }
    },
    "indices": { "$ref": "#/$defs/unsignedCases" },
    "ordinals": { "$ref": "#/$defs/unsignedCases" }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" },
    "unsignedCases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decimal", "accepted"],
        "properties": {
          "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
