{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.native-schema-producer/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fields", "copy", "frontier", "maximumBytes", "tinyMaximumBytes", "recursiveDepth"],
  "properties": {
    "schema": {"const": "semio.native-schema-producer/v1"},
    "fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "key", "shape", "optional"], "properties": {"id": {"type": "integer", "minimum": 0, "maximum": 65535}, "key": {"type": "string"}, "shape": {"enum": ["text", "uint", "record", "bytes"]}, "optional": {"type": "boolean"}}}},
    "copy": {"type": "object", "additionalProperties": false, "required": ["seed", "repeatCount", "cancelAt"], "properties": {"seed": {"type": "string"}, "repeatCount": {"type": "integer", "minimum": 1}, "cancelAt": {"type": "integer", "minimum": 1}}},
    "frontier": {"type": "object", "additionalProperties": false, "required": ["fieldCount", "cancelAt"], "properties": {"fieldCount": {"type": "integer", "minimum": 1, "maximum": 65535}, "cancelAt": {"type": "integer", "minimum": 1}}},
    "maximumBytes": {"type": "integer", "minimum": 1},
    "tinyMaximumBytes": {"type": "integer", "minimum": 1},
    "recursiveDepth": {"type": "integer", "minimum": 1, "maximum": 64}
  }
}
