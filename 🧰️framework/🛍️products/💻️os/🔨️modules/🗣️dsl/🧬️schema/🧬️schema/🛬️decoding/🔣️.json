{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "signed",
    "unsigned",
    "floatWord",
    "text",
    "octets",
    "formulaValue",
    "wires"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "signed": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "unsigned": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "floatWord": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "text": {
      "type": "string"
    },
    "octets": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "formulaValue": {
      "type": "number"
    },
    "wires": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "from",
          "to",
          "directed",
          "labelId",
          "labelKind"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          },
          "directed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "labelId": {
            "type": [
              "string",
              "null"
            ]
          },
          "labelKind": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
