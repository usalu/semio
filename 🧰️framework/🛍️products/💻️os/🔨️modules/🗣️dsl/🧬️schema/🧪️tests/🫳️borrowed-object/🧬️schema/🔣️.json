{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Borrowed Object Ordering Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["depth", "payloadBytes", "allocationMultiplier", "unsigned", "binary64Bits"],
  "properties": {
    "depth": {"type": "integer", "minimum": 1},
    "payloadBytes": {"type": "integer", "minimum": 1},
    "allocationMultiplier": {"type": "integer", "minimum": 1},
    "unsigned": {"type": "string", "pattern": "^[0-9]+$"},
    "binary64Bits": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
  }
}
