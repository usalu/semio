{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/dsl/derive/component.json",
  "title": "Dsl Derive Contracts",
  "$defs": {
    "MutationTimestampClock": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "counter",
            "physicalMs"
          ],
          "properties": {
            "counter": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "physicalMs": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        }
      ]
    },
    "MandatoryMutationDescriptorFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptorsHasInitializer",
        "descriptorHasDefaultBody",
        "sentinelPresent"
      ],
      "properties": {
        "descriptorsHasInitializer": {
          "type": "boolean"
        },
        "descriptorHasDefaultBody": {
          "type": "boolean"
        },
        "sentinelPresent": {
          "type": "boolean"
        }
      }
    },
    "MandatoryMutationDescriptorExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "violations"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "descriptors-has-initializer",
              "descriptor-has-default-body",
              "undeclared-sentinel-present"
            ]
          }
        }
      }
    },
    "MutationAuthoritySegment": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)(?![cC][oO][mM][pP][oO][sS][eE]$)[^/\\\\:*?{}\\u0000-\\u001f\\u2028\\u2029]+$"
    },
    "MutationSourceAuthorityProjectionV1": {
      "title": "Mutation Source Authority Projection",
      "description": "The taxonomy facts the mutation derive macros read at compile time, generated from \ud83d\udd23\ufe0ftaxonomy.json so only a change to these facts invalidates a deriving crate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceFilename",
        "descriptorFilename",
        "mutationCollection",
        "mutationPayloadFacet",
        "mutationDomainOwners",
        "mutationAggregateSources"
      ],
      "properties": {
        "schema": {
          "const": "semio.dsl.mutation-source-authority/v1"
        },
        "sourceFilename": {
          "$ref": "#/$defs/MutationAuthoritySegment"
        },
        "descriptorFilename": {
          "$ref": "#/$defs/MutationAuthoritySegment"
        },
        "mutationCollection": {
          "$ref": "#/$defs/MutationAuthoritySegment"
        },
        "mutationPayloadFacet": {
          "$ref": "#/$defs/MutationAuthoritySegment"
        },
        "mutationDomainOwners": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              }
            }
          }
        },
        "mutationAggregateSources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "DiffRepresentations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "representations"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "representations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "contract",
              "generator",
              "methods",
              "forbidden"
            ],
            "properties": {
              "name": {
                "enum": [
                  "text",
                  "binary"
                ]
              },
              "contract": {
                "enum": [
                  "DiffText",
                  "DiffBinary"
                ]
              },
              "generator": {
                "enum": [
                  "diff_text_tokens",
                  "diff_binary_tokens"
                ]
              },
              "methods": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/MutationSourceAuthorityProjectionV1"
}
