{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/dsl/derive/component.json",
  "title": "Dsl Derive Contracts",
  "$defs": {
    "MutationTimestampClock": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "counter",
            "physicalMs"
          ],
          "properties": {
            "counter": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "physicalMs": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        }
      ]
    },
    "MutationTimestampV1": {
      "title": "Mutation Timestamp Delegation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "delegations",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "delegations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "derive",
              "source",
              "target",
              "method"
            ],
            "properties": {
              "derive": {
                "enum": [
                  "Mutations",
                  "CompositeMutation"
                ]
              },
              "source": {
                "enum": [
                  "MutationKind",
                  "CompositeMutationKind"
                ]
              },
              "target": {
                "enum": [
                  "Mutation",
                  "MutationKind"
                ]
              },
              "method": {
                "const": "timestamp"
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "authored",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "authored": {
                "$ref": "#/$defs/MutationTimestampClock"
              },
              "expected": {
                "$ref": "#/$defs/MutationTimestampClock"
              }
            }
          }
        }
      }
    },
    "MandatoryMutationDescriptorFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptorsHasInitializer",
        "descriptorHasDefaultBody",
        "sentinelPresent"
      ],
      "properties": {
        "descriptorsHasInitializer": {
          "type": "boolean"
        },
        "descriptorHasDefaultBody": {
          "type": "boolean"
        },
        "sentinelPresent": {
          "type": "boolean"
        }
      }
    },
    "MandatoryMutationDescriptorExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "violations"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "descriptors-has-initializer",
              "descriptor-has-default-body",
              "undeclared-sentinel-present"
            ]
          }
        }
      }
    },
    "MandatoryMutationDescriptorCase": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "subject",
            "category",
            "facts",
            "expected"
          ],
          "properties": {
            "id": {
              "const": "required-items-accepted"
            },
            "subject": {
              "const": "mutation-trait-facts"
            },
            "category": {
              "const": "required-associated-items"
            },
            "facts": {
              "const": {
                "descriptorsHasInitializer": false,
                "descriptorHasDefaultBody": false,
                "sentinelPresent": false
              }
            },
            "expected": {
              "const": {
                "accepted": true,
                "violations": []
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "subject",
            "category",
            "facts",
            "expected"
          ],
          "properties": {
            "id": {
              "const": "descriptors-default-rejected"
            },
            "subject": {
              "const": "mutation-trait-facts"
            },
            "category": {
              "const": "descriptor-constant-default"
            },
            "facts": {
              "const": {
                "descriptorsHasInitializer": true,
                "descriptorHasDefaultBody": false,
                "sentinelPresent": false
              }
            },
            "expected": {
              "const": {
                "accepted": false,
                "violations": [
                  "descriptors-has-initializer"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "subject",
            "category",
            "facts",
            "expected"
          ],
          "properties": {
            "id": {
              "const": "descriptor-default-rejected"
            },
            "subject": {
              "const": "mutation-trait-facts"
            },
            "category": {
              "const": "descriptor-method-default"
            },
            "facts": {
              "const": {
                "descriptorsHasInitializer": false,
                "descriptorHasDefaultBody": true,
                "sentinelPresent": false
              }
            },
            "expected": {
              "const": {
                "accepted": false,
                "violations": [
                  "descriptor-has-default-body"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "subject",
            "category",
            "facts",
            "expected"
          ],
          "properties": {
            "id": {
              "const": "sentinel-rejected"
            },
            "subject": {
              "const": "mutation-trait-facts"
            },
            "category": {
              "const": "undeclared-sentinel"
            },
            "facts": {
              "const": {
                "descriptorsHasInitializer": false,
                "descriptorHasDefaultBody": false,
                "sentinelPresent": true
              }
            },
            "expected": {
              "const": {
                "accepted": false,
                "violations": [
                  "undeclared-sentinel-present"
                ]
              }
            }
          }
        }
      ]
    },
    "MandatoryMutationDescriptorFactsV1": {
      "title": "Mandatory Mutation Descriptor Facts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/MandatoryMutationDescriptorCase"
          }
        }
      }
    },
    "MacroExportsV1": {
      "title": "Dsl Derive Macro Exports",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "facadeExports",
        "registeredDerives",
        "traitOnly"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "facadeExports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          }
        },
        "registeredDerives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          }
        },
        "traitOnly": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          }
        }
      }
    },
    "MandatoryMutationsV1": {
      "title": "Mandatory Mutations Compiler Cases",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "source",
              "accepted"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              },
              "leaves": {
                "type": "integer",
                "minimum": 1
              },
              "generic": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "MutationLeafDeriveV1": {
      "title": "Mutation Leaf Derive Attributes",
      "type": "object",
      "required": [
        "schemaVersion",
        "attributes",
        "compilerCases"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "attribute",
              "accepted"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "attribute": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              },
              "diagnostic": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "compilerCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "accepted"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              },
              "diagnostic": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "MutationAggregateSourceAuthorityV1": {
      "title": "Mutation Aggregate Source Authority",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "accepted"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              },
              "diagnostic": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "MutationLeafJsonV1": {
      "title": "Mutation Leaf Json Payloads",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authorityOwner",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "authorityOwner": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "raw",
              "schemaAccepted",
              "parserAccepted",
              "diagnostic"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "raw": {
                "type": "string",
                "minLength": 2
              },
              "schemaAccepted": {
                "type": "boolean"
              },
              "parserAccepted": {
                "type": "boolean"
              },
              "diagnostic": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "MutationSourceAuthorityV1": {
      "title": "Mutation Source Authority Layout",
      "type": "object",
      "required": [
        "schemaVersion",
        "descriptor",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "descriptor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "owner",
            "semanticKind",
            "displayName",
            "emoji",
            "aggregateVariant",
            "payloadSchema",
            "textOpcode",
            "binaryTag",
            "invertibility",
            "diffParticipation",
            "outcomeClasses",
            "composition",
            "requiredLanguageSurfaces"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "owner": {
              "type": "string"
            },
            "semanticKind": {
              "const": "insert-page"
            },
            "displayName": {
              "const": "Insert Page"
            },
            "emoji": {
              "const": "➕️"
            },
            "aggregateVariant": {
              "const": "InsertPage"
            },
            "payloadSchema": {
              "const": "🦀️.rs#InsertPage"
            },
            "textOpcode": {
              "type": "null"
            },
            "binaryTag": {
              "type": "null"
            },
            "invertibility": {
              "const": "explicit-mutation"
            },
            "diffParticipation": {
              "const": "apply-only"
            },
            "outcomeClasses": {
              "const": [
                "applied"
              ]
            },
            "composition": {
              "const": "atomic"
            },
            "requiredLanguageSurfaces": {
              "const": [
                "rust"
              ]
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 17,
          "items": {
            "type": "object",
            "required": [
              "name",
              "accepted"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "accepted": {
                "type": "boolean"
              },
              "relativeSource": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "MutationSourceAuthorityDomainsV1": {
      "title": "Mutation Source Authority Domains",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mutationRoot",
        "domains",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "mutationRoot": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "owner",
              "source",
              "semanticKind",
              "accepted"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "semanticKind": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              },
              "fault": {
                "enum": [
                  "duplicate-identity",
                  "symlink-domain",
                  "empty-registry",
                  "wrong-registry-root"
                ]
              }
            }
          }
        }
      }
    }
  }
}
