{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/dsl/derive/component.json",
  "title": "Dsl Derive Contracts",
  "$defs": {
    "MutationTimestampClock": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "counter",
            "physicalMs"
          ],
          "properties": {
            "counter": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "physicalMs": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        }
      ]
    },
    "MutationAuthoritySegment": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)(?![cC][oO][mM][pP][oO][sS][eE]$)[^/\\\\:*?{}\\u0000-\\u001f\\u2028\\u2029]+$"
    },
    "MutationSourceAuthorityProjectionV1": {
      "title": "Mutation Source Authority Projection",
      "description": "The taxonomy facts the mutation derive macros read at compile time, generated from 🔣️taxonomy.json so only a change to these facts invalidates a deriving crate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceFilename",
        "descriptorFilename",
        "mutationCollection",
        "mutationPayloadFacet",
        "mutationDomainOwners",
        "mutationAggregateSources"
      ],
      "properties": {
        "schema": {
          "const": "semio.dsl.mutation-source-authority/v1"
        },
        "sourceFilename": {
          "$ref": "#/$defs/MutationAuthoritySegment"
        },
        "descriptorFilename": {
          "$ref": "#/$defs/MutationAuthoritySegment"
        },
        "mutationCollection": {
          "$ref": "#/$defs/MutationAuthoritySegment"
        },
        "mutationPayloadFacet": {
          "$ref": "#/$defs/MutationAuthoritySegment"
        },
        "mutationDomainOwners": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              }
            }
          }
        },
        "mutationAggregateSources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "MutationSchemaDocumentIndexV1": {
      "title": "Mutation Schema Document Index",
      "description": "The generated $id index a MutationLeaf derive reads instead of walking directories, so rustc tracks one file and a new schema document changes that file.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "roots"
      ],
      "properties": {
        "schema": {
          "const": "semio.dsl.mutation-schema-document-index/v1"
        },
        "roots": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "MutationWorkspaceSourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRoot"
      ],
      "properties": {
        "workspaceRoot": {
          "type": "string",
          "pattern": "^\\.\\.(?:/\\.\\.)*$"
        }
      },
      "description": "An explicit source authority delegation names only an exact ancestor directory containing the genuine workspace package/project pair. The original mutation authority projection and no-follow ownership checks remain authoritative."
    }
  },
  "$ref": "#/$defs/MutationSourceAuthorityProjectionV1"
}
