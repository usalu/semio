{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "facadeExports",
    "registeredDerives",
    "traitOnly"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "facadeExports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "registeredDerives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "traitOnly": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    }
  }
}
