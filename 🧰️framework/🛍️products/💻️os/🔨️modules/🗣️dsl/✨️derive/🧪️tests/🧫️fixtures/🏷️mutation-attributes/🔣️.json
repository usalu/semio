{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "required-retained-leaves",
      "attribute": "#[mutations(snapshot = Snapshot, diff = Diff, schema = \"page.schema\", retained)]",
      "accepted": true
    },
    {
      "name": "duplicate-retained",
      "attribute": "#[mutations(snapshot = Snapshot, diff = Diff, schema = \"page.schema\", retained, retained)]",
      "accepted": false,
      "diagnostic": "duplicate mutations retained"
    },
    {
      "name": "valid-mutations",
      "attribute": "#[mutations(snapshot = Snapshot, diff = Diff, schema = \"page.schema\")]",
      "accepted": true
    },
    {
      "name": "unknown-behavior",
      "attribute": "#[mutations(behavior = Apply)]",
      "accepted": false,
      "diagnostic": "unsupported mutations attribute"
    },
    {
      "name": "duplicate-snapshot",
      "attribute": "#[mutations(snapshot = A, snapshot = B, diff = D, schema = \"x\")]",
      "accepted": false,
      "diagnostic": "duplicate mutations snapshot"
    },
    {
      "name": "duplicate-diff",
      "attribute": "#[mutations(snapshot = A, diff = B, diff = C, schema = \"x\")]",
      "accepted": false,
      "diagnostic": "duplicate mutations diff"
    },
    {
      "name": "duplicate-schema",
      "attribute": "#[mutations(snapshot = A, diff = D, schema = \"x\", schema = \"y\")]",
      "accepted": false,
      "diagnostic": "duplicate mutations schema"
    },
    {
      "name": "repeated-container",
      "attribute": "#[mutations(snapshot = A, diff = D, schema = \"x\")] #[mutations(snapshot = B)]",
      "accepted": false,
      "diagnostic": "duplicate mutations snapshot"
    },
    {
      "name": "malformed-value",
      "attribute": "#[mutations(snapshot, diff = D, schema = \"x\")]",
      "accepted": false,
      "diagnostic": "expected `=`"
    },
    {
      "name": "valid-retire-cold",
      "attribute": "#[mutations(snapshot = Snapshot, diff = Diff, schema = \"page.schema\", retire_cold = crate::retire_mutation)]",
      "accepted": true
    },
    {
      "name": "duplicate-retire-cold",
      "attribute": "#[mutations(snapshot = A, diff = D, schema = \"x\", retire_cold = a, retire_cold = b)]",
      "accepted": false,
      "diagnostic": "duplicate mutations retire_cold"
    },
    {
      "name": "valid-composite",
      "attribute": "#[composite(snapshot = Snapshot, op = Operation)]",
      "accepted": true
    },
    {
      "name": "unknown-composite",
      "attribute": "#[composite(behavior = Apply)]",
      "accepted": false,
      "diagnostic": "unsupported composite attribute"
    },
    {
      "name": "duplicate-op",
      "attribute": "#[composite(snapshot = A, op = B, op = C)]",
      "accepted": false,
      "diagnostic": "duplicate composite op"
    },
    {
      "name": "explicit-wire-reference",
      "attribute": "#[mutations(snapshot = NativeSnapshot, diff = NativeDiff, reference = WireSnapshot, reference_diff = WireDiff, schema = \"page.schema\")]",
      "accepted": true
    },
    {
      "name": "missing-reference-diff",
      "attribute": "#[mutations(reference = WireSnapshot)]",
      "accepted": false,
      "diagnostic": "must be supplied together"
    },
    {
      "name": "missing-reference",
      "attribute": "#[mutations(reference_diff = WireDiff)]",
      "accepted": false,
      "diagnostic": "must be supplied together"
    },
    {
      "name": "duplicate-reference",
      "attribute": "#[mutations(reference = A, reference = B)]",
      "accepted": false,
      "diagnostic": "duplicate mutations reference"
    },
    {
      "name": "duplicate-reference-diff",
      "attribute": "#[mutations(reference_diff = A, reference_diff = B)]",
      "accepted": false,
      "diagnostic": "duplicate mutations reference_diff"
    },
    {
      "name": "explicit-composite-reference",
      "attribute": "#[composite(snapshot = NativeSnapshot, op = Operation, reference = WireSnapshot)]",
      "accepted": true
    },
    {
      "name": "duplicate-composite-reference",
      "attribute": "#[composite(reference = A, reference = B)]",
      "accepted": false,
      "diagnostic": "duplicate composite reference"
    }
  ]
}
