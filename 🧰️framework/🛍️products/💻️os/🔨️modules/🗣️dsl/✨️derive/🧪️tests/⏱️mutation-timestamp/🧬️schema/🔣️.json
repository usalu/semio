{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "delegations", "cases"],
  "definitions": {
    "clock": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["counter", "physicalMs"], "properties": { "counter": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }, "physicalMs": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" } } }] }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "delegations": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["derive", "source", "target", "method"], "properties": { "derive": { "enum": ["Mutations", "CompositeMutation"] }, "source": { "enum": ["MutationKind", "CompositeMutationKind"] }, "target": { "enum": ["Mutation", "MutationKind"] }, "method": { "const": "timestamp" } } } },
    "cases": { "type": "array", "minItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["name", "authored", "expected"], "properties": { "name": { "type": "string", "minLength": 1 }, "authored": { "$ref": "#/definitions/clock" }, "expected": { "$ref": "#/definitions/clock" } } } }
  }
}
