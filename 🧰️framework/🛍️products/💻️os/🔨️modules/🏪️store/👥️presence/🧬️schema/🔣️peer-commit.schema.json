{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["maximumItems", "maximumBytes", "candidate", "winner", "cases"],
  "properties": {
    "maximumItems": { "const": 1 },
    "maximumBytes": { "const": 4096 },
    "candidate": { "const": { "actor": "candidate", "value": 47 } },
    "winner": { "const": { "actor": "winner", "value": 31 } },
    "cases": { "const": [
      { "name": "foreign-factory", "sameStore": false, "sameFactory": false, "stale": false, "accepted": false, "expectedSnapshots": 3 },
      { "name": "same-factory-different-store", "sameStore": false, "sameFactory": true, "stale": false, "accepted": false, "expectedSnapshots": 3 },
      { "name": "stale-concurrent-candidate", "sameStore": true, "sameFactory": true, "stale": true, "accepted": false, "expectedSnapshots": 4 },
      { "name": "fresh-successful-handoff", "sameStore": true, "sameFactory": true, "stale": false, "accepted": true, "expectedSnapshots": 3 }
    ] }
  }
}
