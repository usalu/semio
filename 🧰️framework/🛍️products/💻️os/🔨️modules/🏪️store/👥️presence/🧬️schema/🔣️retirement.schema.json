{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presence Store Retirement Laws",
  "type": "object",
  "additionalProperties": false,
  "required": ["maximumItems", "maximumBytes", "cases", "overlap", "localCapture", "readerReturn"],
  "properties": {
    "maximumItems": { "const": 1 },
    "maximumBytes": { "const": 4096 },
    "cases": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["name", "local", "peers", "sharedReaders", "expectedSnapshots", "expectedActorBytes"], "properties": { "name": { "type": "string" }, "local": { "type": "integer" }, "peers": { "type": "array", "items": { "$ref": "#/definitions/peer" } }, "sharedReaders": { "type": "boolean" }, "expectedSnapshots": { "type": "integer", "minimum": 1 }, "expectedActorBytes": { "type": "integer", "minimum": 0 } } } },
    "overlap": { "type": "object", "additionalProperties": false, "required": ["first", "second", "capturedFirstReader", "workers", "expectedPeerSnapshots", "expectedActorBytes", "storeRemainsOpen"], "properties": { "first": { "type": "array", "items": { "$ref": "#/definitions/peer" } }, "second": { "type": "array", "items": { "$ref": "#/definitions/peer" } }, "capturedFirstReader": { "const": true }, "workers": { "const": 2 }, "expectedPeerSnapshots": { "const": 2 }, "expectedActorBytes": { "const": 8 }, "storeRemainsOpen": { "const": true } } },
    "localCapture": { "type": "object", "additionalProperties": false, "required": ["value", "cancelBeforeStoreClose", "expectedWorkerTerminal", "expectedValueWhileOpen", "expectedFinalSnapshots"], "properties": { "value": { "const": 23 }, "cancelBeforeStoreClose": { "const": true }, "expectedWorkerTerminal": { "const": true }, "expectedValueWhileOpen": { "const": 23 }, "expectedFinalSnapshots": { "const": 1 } } },
    "readerReturn": { "const": {
      "text": "aä🧵",
      "variants": ["typed-drop", "erased-drop", "explicit-return", "witness-return"],
      "eventOrder": ["reader-alias-released", "return-published", "registry-owner-taken", "final-owner-retired"],
      "returnedAtAliasBarrier": false, "uniqueAfterReturn": true,
      "contendedTransferPreservesUnreturned": true, "transferPublishesReturn": false, "workers": 2
    } }
  },
  "definitions": { "peer": { "type": "object", "additionalProperties": false, "required": ["actor", "value"], "properties": { "actor": { "type": "string", "minLength": 1 }, "value": { "type": "integer" } } } }
}
