{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/store/presence/component.json",
  "title": "Store Presence",
  "description": "Presence-owned contracts: peer commit and admission records, presence retirement, and the exact document-scoped runtime keys and surface routes presence is projected through. Renderer elements and the backbone worker are consumers.",
  "$defs": {
    "I32": {
      "description": "🔢️ The signed 32-bit value a presence retirement peer carries. Presence retirement mutation leaves reference this export instead of restating the bounds.",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "PresenceRetirementPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "value"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "PresenceScopeV1": {
      "description": "📍️ The exact (space, document) pair a presence session is scoped to. Two sessions on the same document in different spaces are different scopes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "PresenceRuntimeKeyV1": {
      "description": "🔑️ The runtime key a presence scope derives to: `v1:<spaceId utf8 bytes>:<documentId utf8 bytes>:<spaceId><documentId>`. The byte lengths make the concatenation unambiguous.",
      "type": "string",
      "pattern": "^v1:[0-9]+:[0-9]+:",
      "maxLength": 1280
    },
    "PresenceActorRouteV1": {
      "description": "📡️ The actor URI a scoped presence session is routed through. Always `actor://` plus the scope's runtime key.",
      "type": "string",
      "pattern": "^actor://v1:[0-9]+:[0-9]+:",
      "maxLength": 1288
    },
    "PresenceSurfaceRoleV1": {
      "enum": [
        "owner",
        "member",
        "viewer"
      ]
    },
    "PresencePeerV1": {
      "description": "👥️ One peer projected into a scoped presence surface. `views` is empty until the peer publishes a view; `surface` must equal the verified surface the peer was admitted on.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "userId",
        "label",
        "role",
        "connectedAtMs",
        "color",
        "surface",
        "views"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "$ref": "#/$defs/PresenceSurfaceRoleV1"
        },
        "connectedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "views": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "ScopedPresenceBindingV1": {
      "description": "👥️ One scoped presence binding: the scope, the runtime key it derives to, the surface it is verified on, and the peer projected there.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "runtimeKey",
        "surface",
        "peer"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/PresenceScopeV1"
        },
        "runtimeKey": {
          "$ref": "#/$defs/PresenceRuntimeKeyV1"
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "peer": {
          "$ref": "#/$defs/PresencePeerV1"
        }
      }
    },
    "ScopedPresenceRejectionV1": {
      "description": "⛔️ Every reason a presence message is refused. A message that names no scope or surface, or names a different one than the session was admitted on, is dropped rather than projected.",
      "enum": [
        "missing-scope",
        "mismatched-scope",
        "missing-surface",
        "mismatched-surface"
      ]
    },
    "OriginalPublicationLaw": {
      "type": "object",
      "required": [
        "peer",
        "grant",
        "prebirthRefusals",
        "zeroSemanticCopyAccepted"
      ],
      "properties": {
        "peer": {
          "$ref": "#/$defs/PresenceRetirementPeer"
        },
        "grant": {
          "type": "object",
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 1
            },
            "maximumCopyBytes": {
              "const": 0
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "prebirthRefusals": {
          "type": "array",
          "items": {
            "enum": [
              "items",
              "capacity",
              "depth",
              "nativeCancellation"
            ]
          }
        },
        "zeroSemanticCopyAccepted": {
          "const": true
        }
      }
    }
  }
}
