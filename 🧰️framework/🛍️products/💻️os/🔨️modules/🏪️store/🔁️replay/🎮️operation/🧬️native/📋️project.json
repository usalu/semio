{
  "name": "@semio-tech/framework-store-native-semantic",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🏪️store/**/*"
    ]
  },
  "tags": [
    "framework",
    "store"
  ],
  "targets": {
    "verify-source": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "reads"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🏪️store/🔁️replay/🎮️operation/🧬️native",
        "command": "repo ./📜️script.ts verify source"
      }
    },
    "verify-native": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "reads"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🏪️store/🔁️replay/🎮️operation/🧬️native",
        "command": "repo ./📜️script.ts verify native"
      }
    }
  }
}
