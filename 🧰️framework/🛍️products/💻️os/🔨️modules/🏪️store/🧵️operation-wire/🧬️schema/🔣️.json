{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copyBytes",
    "workItems",
    "grants",
    "cancelStops",
    "cases",
    "encodings",
    "textCases"
  ],
  "properties": {
    "copyBytes": {
      "const": 64
    },
    "workItems": {
      "const": 1
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 256
      }
    },
    "cancelStops": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "header",
          "body"
        ],
        "properties": {
          "header": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "body": {}
        }
      }
    },
    "encodings": {
      "const": [
        "json",
        "jsonHex"
      ]
    },
    "textCases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "header",
          "node"
        ],
        "properties": {
          "header": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "node": {
            "$ref": "#/$defs/TextNode"
          }
        }
      }
    }
  },
  "$defs": {
    "TextNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "enum": [
                "bytes",
                "hex",
                "scalar"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "open",
            "separator",
            "close",
            "children"
          ],
          "properties": {
            "kind": {
              "const": "sequence"
            },
            "open": {
              "type": "string",
              "maxLength": 32
            },
            "separator": {
              "type": "string",
              "maxLength": 32
            },
            "close": {
              "type": "string",
              "maxLength": 32
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TextNode"
              }
            }
          }
        }
      ]
    }
  }
}
