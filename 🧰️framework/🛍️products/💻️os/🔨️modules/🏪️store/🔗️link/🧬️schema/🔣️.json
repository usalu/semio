{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/store/link.json",
  "title": "ArtifactLink",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "pin",
    "role"
  ],
  "properties": {
    "target": {
      "$ref": "https://semio.tech/schema/framework/io/schema.json#/$defs/ArtifactRef"
    },
    "pin": {
      "$ref": "#/$defs/LinkPin"
    },
    "role": {
      "type": "string"
    }
  },
  "$defs": {
    "LinkPin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "head"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "checkpoint"
            },
            "id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blob"
          ],
          "properties": {
            "kind": {
              "const": "snapshot"
            },
            "blob": {
              "$ref": "https://semio.tech/schema/os/store/blob.json"
            }
          }
        }
      ]
    }
  }
}
