{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "sourceBoundary",
    "valid",
    "invalid",
    "workspace"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "const": "semio-framework-os-store-link-schema"
    },
    "sourceBoundary": {
      "const": {
        "maxSourceBytes": 65536,
        "maxSourceFiles": 8,
        "maxActiveLines": 1000
      }
    },
    "valid": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object"
      }
    },
    "invalid": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object"
      }
    },
    "workspace": {
      "const": "repository"
    }
  }
}
