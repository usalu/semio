{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/store/worker/cold-pair-loading.json",
  "title": "Cold pair loading corpus",
  "description": "The host turns of a cold-pair transfer while the guest's whole-document load runs: `cases` are the last page's turns answering loading, `backpressure` the page sends a guest refuses while an older pair of the same lifetime settles; each lists the guest answers in turn order, the wait policy (corpus default, optionally overridden per case), the wall time every guest turn takes on a fake clock (`turnMs`), and what the host settles on, including every pause it took (`sleeps`).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy",
    "cursor",
    "cases",
    "backpressure"
  ],
  "properties": {
    "schema": {
      "const": "semio.os.store.worker.cold-pair-loading.v1"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadlineMs",
        "maximumTurns",
        "eagerTurns",
        "backoffMs",
        "maximumBackoffMs"
      ],
      "properties": {
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Wall budget of one wait, from the first answer."
        },
        "maximumTurns": {
          "type": "integer",
          "minimum": 1,
          "description": "Secondary cap on wait turns (loading polls or backpressure resends)."
        },
        "eagerTurns": {
          "type": "integer",
          "minimum": 0,
          "description": "Wait turns that follow each other without a pause."
        },
        "backoffMs": {
          "type": "integer",
          "minimum": 1,
          "description": "First pause after the eager turns; doubles per turn."
        },
        "maximumBackoffMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Cap of the pause."
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferGeneration",
        "pageIndex",
        "pageCount"
      ],
      "properties": {
        "transferGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "pageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "answers",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "deadlineMs": {
                "type": "integer",
                "minimum": 1
              },
              "maximumTurns": {
                "type": "integer",
                "minimum": 1
              },
              "eagerTurns": {
                "type": "integer",
                "minimum": 0
              },
              "backoffMs": {
                "type": "integer",
                "minimum": 1
              },
              "maximumBackoffMs": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "turnMs": {
            "type": "integer",
            "minimum": 0
          },
          "answers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "loading",
                "loading-other-page",
                "loading-other-transfer",
                "applied",
                "fault",
                "cancel"
              ]
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "polls",
              "released",
              "sleeps"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "settled",
                  "refused"
                ]
              },
              "kind": {
                "enum": [
                  "applied",
                  "fault"
                ]
              },
              "error": {
                "type": "string",
                "minLength": 1
              },
              "polls": {
                "type": "integer",
                "minimum": 0
              },
              "released": {
                "type": "integer",
                "minimum": 0
              },
              "sleeps": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "backpressure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "answers",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "deadlineMs": {
                "type": "integer",
                "minimum": 1
              },
              "maximumTurns": {
                "type": "integer",
                "minimum": 1
              },
              "eagerTurns": {
                "type": "integer",
                "minimum": 0
              },
              "backoffMs": {
                "type": "integer",
                "minimum": 1
              },
              "maximumBackoffMs": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "turnMs": {
            "type": "integer",
            "minimum": 0
          },
          "answers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "accepted",
                "backpressure-older",
                "backpressure-foreign",
                "loading"
              ]
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "sends",
              "polls",
              "released",
              "sleeps"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "settled",
                  "refused"
                ]
              },
              "kind": {
                "enum": [
                  "pageAccepted",
                  "loading"
                ]
              },
              "error": {
                "type": "string",
                "minLength": 1
              },
              "sends": {
                "type": "integer",
                "minimum": 1
              },
              "polls": {
                "type": "integer",
                "minimum": 0
              },
              "released": {
                "type": "integer",
                "minimum": 0
              },
              "sleeps": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
