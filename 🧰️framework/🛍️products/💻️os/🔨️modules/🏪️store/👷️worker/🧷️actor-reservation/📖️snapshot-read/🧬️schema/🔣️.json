{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "port",
    "mediaType",
    "maximumBytes",
    "maximumChunkBytes",
    "maximumTurns"
  ],
  "properties": {
    "port": {
      "const": "semio.snapshot.pack"
    },
    "mediaType": {
      "const": "application/vnd.semio.pack"
    },
    "maximumBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "maximumChunkBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "maximumTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  }
}
