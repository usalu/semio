{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/store/worker/browser-actor-visible-surfaces.json",
  "$ref": "#/definitions/BrowserActorVisiblePolicyV1",
  "definitions": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "bodyKey",
        "static"
      ],
      "properties": {
        "key": {
          "enum": [
            "engagements",
            "measures",
            "tools",
            "catalogue"
          ]
        },
        "bodyKey": {
          "type": "string",
          "pattern": "^framework\\.section\\.[a-z]+$"
        },
        "static": {
          "type": "boolean"
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows",
        "staticSections"
      ],
      "properties": {
        "windows": {
          "type": "boolean"
        },
        "staticSections": {
          "type": "boolean"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "bodyKey"
      ],
      "properties": {
        "key": {
          "$ref": "#/definitions/key"
        },
        "bodyKey": {
          "$ref": "#/definitions/key"
        }
      }
    },
    "BrowserActorVisiblePolicyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections",
        "turns"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/section"
          }
        },
        "turns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mount",
            "repaint",
            "refresh"
          ],
          "properties": {
            "mount": {
              "$ref": "#/definitions/turn"
            },
            "repaint": {
              "$ref": "#/definitions/turn"
            },
            "refresh": {
              "$ref": "#/definitions/turn"
            }
          }
        }
      }
    }
  }
}
