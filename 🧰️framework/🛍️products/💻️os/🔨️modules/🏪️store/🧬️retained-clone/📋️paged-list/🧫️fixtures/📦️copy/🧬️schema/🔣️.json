{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained Paged List Copy Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["maximumEntries", "entryCount", "valuePrefix", "grant", "cancellationAfterEntries", "expected"],
  "properties": {
    "maximumEntries": { "type": "integer", "const": 1024 },
    "entryCount": { "type": "integer", "const": 513 },
    "valuePrefix": { "type": "string", "minLength": 1 },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumItems", "maximumCopyBytes", "maximumCapacityBytes", "maximumDepth"],
      "properties": {
        "maximumItems": { "type": "integer", "const": 5 },
        "maximumCopyBytes": { "type": "integer", "const": 32 },
        "maximumCapacityBytes": { "type": "integer", "const": 4096 },
        "maximumDepth": { "type": "integer", "const": 64 }
      }
    },
    "cancellationAfterEntries": { "type": "integer", "const": 173 },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered", "sourcePreserved", "copyRequiresMultipleTurns", "closeRequiresMultipleTurns", "terminalEmpty"],
      "properties": {
        "ordered": { "const": true },
        "sourcePreserved": { "const": true },
        "copyRequiresMultipleTurns": { "const": true },
        "closeRequiresMultipleTurns": { "const": true },
        "terminalEmpty": { "const": true }
      }
    }
  }
}
