{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained Ordered Map Paging Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["pageCapacity", "entryCount", "keyPrefix", "valuePrefix", "longKeyByteLength", "comparisonGrant", "progressChannels", "repeatedGrowth", "immutableLookup", "operations"],
  "properties": {
    "pageCapacity": { "type": "integer", "const": 16 },
    "entryCount": { "type": "integer", "minimum": 65 },
    "keyPrefix": { "type": "string", "minLength": 1 },
    "valuePrefix": { "type": "string", "minLength": 1 },
    "longKeyByteLength": { "type": "integer", "minimum": 65536 },
    "comparisonGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumItems", "maximumBytes"],
      "properties": {
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "progressChannels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparisonOnly", "capacityOnly", "minimumMovedItems"],
      "properties": {
        "comparisonOnly": { "const": true },
        "capacityOnly": { "const": true },
        "minimumMovedItems": { "type": "integer", "minimum": 1 }
      }
    },
    "repeatedGrowth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryCount", "insertions", "keyPrefix", "valuePrefix", "expectedEntryCount"],
      "properties": {
        "entryCount": { "type": "integer", "const": 32 },
        "insertions": { "type": "integer", "const": 17 },
        "keyPrefix": { "type": "string", "minLength": 1 },
        "valuePrefix": { "type": "string", "minLength": 1 },
        "expectedEntryCount": { "type": "integer", "const": 49 }
      }
    },
    "immutableLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedTarget", "externalAfterCapture", "expectedOrdinal"],
      "properties": {
        "capturedTarget": { "type": "string", "minLength": 1 },
        "externalAfterCapture": { "type": "string", "minLength": 1 },
        "expectedOrdinal": { "type": "integer", "minimum": 0 }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "key", "expected"],
            "properties": {
              "kind": { "const": "lookup" },
              "key": { "$ref": "#/$defs/key" },
              "expected": { "$ref": "#/$defs/expected" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "key", "value", "expected"],
            "properties": {
              "kind": { "enum": ["insert", "duplicate"] },
              "key": { "$ref": "#/$defs/key" },
              "value": { "type": "string" },
              "expected": { "$ref": "#/$defs/expected" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "minLength": 1 },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["found", "ordinal", "entryCount"],
      "properties": {
        "found": { "type": "boolean" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "entryCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
