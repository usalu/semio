{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.os.store.space-history.sqlite.explicit-registration.v1",
  "$defs": {
    "before": {
      "const": {
        "export": "UnsupportedOwner",
        "import": "UnsupportedOwner"
      }
    },
    "after": {
      "const": {
        "export": "completeSnapshot",
        "import": "completeSnapshot",
        "metadata": "sameOwnerAndEncoding"
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "opening",
        "encoding",
        "envelopeDialect",
        "before",
        "after",
        "routeHops"
      ],
      "properties": {
        "id": {
          "enum": [
            "create-binary",
            "create-text",
            "reload-binary",
            "reload-text",
            "retained-binary",
            "retained-text"
          ]
        },
        "opening": {
          "enum": [
            "create",
            "reload",
            "retained"
          ]
        },
        "encoding": {
          "enum": [
            "binary",
            "text"
          ]
        },
        "envelopeDialect": {
          "enum": [
            null,
            "os.space.history@1/*"
          ]
        },
        "before": {
          "$ref": "#/$defs/before"
        },
        "after": {
          "$ref": "#/$defs/after"
        },
        "routeHops": {
          "const": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "id": {
              "const": "create-binary"
            },
            "opening": {
              "const": "create"
            },
            "encoding": {
              "const": "binary"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "create-text"
            },
            "opening": {
              "const": "create"
            },
            "encoding": {
              "const": "text"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "reload-binary"
            },
            "opening": {
              "const": "reload"
            },
            "encoding": {
              "const": "binary"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "reload-text"
            },
            "opening": {
              "const": "reload"
            },
            "encoding": {
              "const": "text"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "retained-binary"
            },
            "opening": {
              "const": "retained"
            },
            "encoding": {
              "const": "binary"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "retained-text"
            },
            "opening": {
              "const": "retained"
            },
            "encoding": {
              "const": "text"
            }
          }
        }
      ],
      "if": {
        "properties": {
          "opening": {
            "const": "retained"
          }
        }
      },
      "then": {
        "properties": {
          "envelopeDialect": {
            "const": "os.space.history@1/*"
          }
        }
      },
      "else": {
        "properties": {
          "envelopeDialect": {
            "const": null
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "coordinate",
    "registrationFunction",
    "nativeLaw",
    "isolationVariable",
    "cases"
  ],
  "properties": {
    "owner": {
      "const": "os.space.history"
    },
    "coordinate": {
      "const": "os.space.history@1/*"
    },
    "registrationFunction": {
      "const": "space_history_sqlite::register_sqlite_snapshot"
    },
    "nativeLaw": {
      "const": "sqlite_snapshot_framework_space_history_explicit_owner_registration_after_create_reload_and_retained"
    },
    "isolationVariable": {
      "const": "SEMIO_SQLITE_HISTORY_REGISTRATION_CASE"
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  }
}
