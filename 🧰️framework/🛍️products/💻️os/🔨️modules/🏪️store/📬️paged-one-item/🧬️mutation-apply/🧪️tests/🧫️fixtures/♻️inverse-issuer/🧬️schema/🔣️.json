{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "inverseRows",
          "expectedIssuerCalls"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "inverseRows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "expectedIssuerCalls": {
            "type": "integer",
            "minimum": 2,
            "maximum": 65
          }
        }
      }
    }
  }
}
