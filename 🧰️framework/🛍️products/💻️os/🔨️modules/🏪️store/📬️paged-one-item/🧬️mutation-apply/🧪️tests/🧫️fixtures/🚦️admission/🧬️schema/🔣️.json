{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["base", "diff", "cases"],
  "additionalProperties": false,
  "properties": {
    "base": {"type":"integer"},
    "diff": {"type":"integer", "not":{"const":0}},
    "cases": {
      "type":"array", "minItems":4, "maxItems":4,
      "items": {
        "type":"object", "additionalProperties":false,
        "required":["level","code","message","target","opIndex","applied","post","applyCalls","inverseCalls"],
        "properties": {
          "level":{"enum":["info","warning","error","fatal"]},
          "code":{"type":"string"}, "message":{"type":"string"},
          "target":{"type":"array","items":{"type":"string"}},
          "opIndex":{"type":"integer","minimum":0},
          "applied":{"type":"boolean"}, "post":{"type":"integer"},
          "applyCalls":{"type":"integer","minimum":0,"maximum":1},
          "inverseCalls":{"type":"integer","minimum":0,"maximum":1}
        }
      }
    }
  }
}
