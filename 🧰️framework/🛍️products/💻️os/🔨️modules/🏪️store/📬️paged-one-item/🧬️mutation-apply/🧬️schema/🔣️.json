{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Structural document mutation cases: post is the node [id, text] list after the mutation, inverse is the ordered row list that restores the base when applied sequentially.",
  "type": "object",
  "required": ["maximumTurns", "cancelAt", "base", "cases"],
  "additionalProperties": false,
  "properties": {
    "maximumTurns": { "type": "integer", "minimum": 1 },
    "cancelAt": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "base": { "$ref": "#/definitions/document" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mutation", "post", "inverse"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "mutation": { "$ref": "#/definitions/mutation" },
          "post": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } },
          "inverse": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/mutation" } }
        }
      }
    }
  },
  "definitions": {
    "document": {
      "type": "object",
      "required": ["title", "nodes"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "text"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "text": { "type": "string" } } } }
      }
    },
    "mutation": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["insert", "remove", "set-text", "remove-range"] } }
    }
  }
}
