{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "base", "mutation", "cases"],
  "properties": {
    "version": {"const": 1},
    "base": {"type": "object", "required": ["title", "nodes"], "properties": {"title": {"type": "string"}, "nodes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false},
    "mutation": {"type": "object", "required": ["kind", "index", "text"], "properties": {"kind": {"const": "set-text"}, "index": {"const": 0}, "text": {"type": "string"}}, "additionalProperties": false},
    "cases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["boundary", "inverseRows", "issuerCalls", "postText"], "properties": {"boundary": {"enum": ["decision", "inverse"]}, "inverseRows": {"enum": [0, 1]}, "issuerCalls": {"enum": [0, 1]}, "postText": {"type": "string"}}, "additionalProperties": false}}
  }
}
