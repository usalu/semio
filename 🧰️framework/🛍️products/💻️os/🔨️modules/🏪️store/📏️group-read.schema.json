{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maximumItems", "maximumBytes", "old", "prepared", "cases"],
  "properties": {
    "schema": { "const": "artifact-group-read-visibility/v1" },
    "maximumItems": { "const": 1 },
    "maximumBytes": { "const": 4096 },
    "old": { "$ref": "#/definitions/root" },
    "prepared": { "$ref": "#/definitions/root" },
    "cases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "capture", "decision", "fresh", "captured", "oldLeaseCurrent", "preparedLeaseCurrent"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capture": { "enum": ["pending", "committed"] },
          "decision": { "enum": ["pending", "committed", "aborted"] },
          "fresh": { "enum": ["old", "prepared"] },
          "captured": { "enum": ["old", "prepared"] },
          "oldLeaseCurrent": { "type": "boolean" },
          "preparedLeaseCurrent": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot", "generation", "revisionByte", "appliedEditIds", "history"],
      "properties": {
        "snapshot": { "type": "integer" },
        "generation": { "type": "integer", "minimum": 0 },
        "revisionByte": { "type": "integer", "minimum": 0, "maximum": 255 },
        "appliedEditIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "history": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
