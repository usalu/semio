{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "firstName",
    "secondName",
    "firstHead",
    "secondHead",
    "inactiveReplacement",
    "scopes",
    "expectedTransitions"
  ],
  "additionalProperties": false,
  "properties": {
    "firstName": {
      "type": "string",
      "minLength": 1
    },
    "secondName": {
      "type": "string",
      "minLength": 1
    },
    "firstHead": {
      "type": "number"
    },
    "secondHead": {
      "type": "number"
    },
    "inactiveReplacement": {
      "type": "number"
    },
    "scopes": {
      "type": "array",
      "items": {
        "enum": [
          "trunk",
          "firstAlternative"
        ]
      }
    },
    "expectedTransitions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
