{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/store/canonical-edit/schema.json",
  "title": "Store Canonical Edit",
  "$defs": {
    "CanonicalEditOrigin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "owner"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pluginId",
            "mutationId",
            "payloadHash"
          ],
          "properties": {
            "kind": {
              "const": "contributed"
            },
            "pluginId": {
              "type": "string"
            },
            "mutationId": {
              "type": "string"
            },
            "payloadHash": {
              "type": "array",
              "minItems": 32,
              "maxItems": 32,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "initiator"
          ],
          "properties": {
            "kind": {
              "const": "transaction"
            },
            "initiator": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactId",
                "artifactKind",
                "dialect"
              ],
              "properties": {
                "artifactId": {
                  "type": "string"
                },
                "artifactKind": {
                  "type": "string"
                },
                "dialect": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "CanonicalEditDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "CanonicalEditMutationMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_id",
        "dependencies",
        "base_version",
        "author_id",
        "timestamp",
        "undo_policy",
        "label",
        "group_id"
      ],
      "properties": {
        "mutation_id": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "author_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "physical_ms",
            "logical"
          ],
          "properties": {
            "actor": {
              "type": "integer",
              "minimum": 0
            },
            "physical_ms": {
              "type": "integer",
              "minimum": 0
            },
            "logical": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "undo_policy": {
          "enum": [
            "ExactBaseOnly",
            "TransformAgainstConcurrent",
            "SemanticUndo",
            "CompensatingAction"
          ]
        },
        "label": {
          "type": "string"
        },
        "group_id": {
          "type": "string"
        }
      }
    }
  }
}
