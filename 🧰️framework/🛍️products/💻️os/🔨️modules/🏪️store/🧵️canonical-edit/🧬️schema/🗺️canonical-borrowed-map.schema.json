{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.store.canonical-borrowed-map.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grants",
    "longKeyBytes",
    "edit",
    "expectedJson",
    "expectedDigest",
    "lifetime",
    "hostile"
  ],
  "properties": {
    "schema": {
      "const": "semio.store.canonical-borrowed-map.v1"
    },
    "grants": {
      "type": "array",
      "items": {
        "enum": [
          0,
          1,
          7,
          256,
          4096
        ]
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "longKeyBytes": {
      "type": "integer",
      "minimum": 4097
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "forwards",
        "inverse",
        "mutationMeta",
        "description",
        "sequenceNumber",
        "startedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "forwards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/mutation"
          }
        },
        "inverse": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/mutation"
          }
        },
        "mutationMeta": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/meta"
          }
        },
        "description": {
          "type": "string"
        },
        "sequenceNumber": {
          "type": "integer"
        },
        "startedAt": {
          "type": "string"
        }
      }
    },
    "expectedJson": {
      "type": "string"
    },
    "expectedDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelBeforeRootDrop",
        "liveRootDrops",
        "iteratorDropsBeforeRoot"
      ],
      "properties": {
        "cancelBeforeRootDrop": {
          "const": true
        },
        "liveRootDrops": {
          "const": 1
        },
        "iteratorDropsBeforeRoot": {
          "const": true
        }
      }
    },
    "hostile": {
      "type": "array",
      "items": {
        "enum": [
          "rebound-root",
          "stale-generation",
          "forged-prefix",
          "source-without-sync",
          "iterator-after-root-drop"
        ]
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    }
  },
  "definitions": {
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/value"
          }
        }
      ]
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ReplaceMap"
      ],
      "properties": {
        "ReplaceMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "map"
          ],
          "properties": {
            "map": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/value"
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_id",
        "dependencies",
        "base_version",
        "author_id",
        "timestamp",
        "undo_policy",
        "label",
        "group_id"
      ],
      "properties": {
        "mutation_id": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "author_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "physical_ms",
            "logical"
          ],
          "properties": {
            "actor": {
              "type": "integer",
              "minimum": 0
            },
            "physical_ms": {
              "type": "integer",
              "minimum": 0
            },
            "logical": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "undo_policy": {
          "enum": [
            "ExactBaseOnly",
            "TransformAgainstConcurrent",
            "SemanticUndo",
            "CompensatingAction"
          ]
        },
        "label": {
          "type": "string"
        },
        "group_id": {
          "type": "string"
        }
      }
    }
  }
}
