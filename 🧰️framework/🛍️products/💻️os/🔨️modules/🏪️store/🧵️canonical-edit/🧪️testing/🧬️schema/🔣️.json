{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/testing/store/canonical-edit/model.json",
  "title": "Canonical Edit Synthetic Mutation Models",
  "$defs": {
    "CanonicalEditSealerEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "forwards",
        "inverse",
        "mutationMeta",
        "sequenceNumber",
        "startedAt",
        "line"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "forwards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CanonicalEditReplaceMutation"
          }
        },
        "inverse": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalEditReplaceMutation"
          }
        },
        "mutationMeta": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/os/store/canonical-edit/schema.json#/$defs/CanonicalEditMutationMeta"
          }
        },
        "sequenceNumber": {
          "type": "integer"
        },
        "startedAt": {
          "type": "string"
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CanonicalEditReplaceMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Replace"
      ],
      "properties": {
        "Replace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "nested",
            "enabled",
            "amount"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "nested": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enabled": {
              "type": "boolean"
            },
            "amount": {
              "type": "integer"
            }
          }
        }
      }
    },
    "CanonicalBorrowedMapEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "forwards",
        "inverse",
        "mutationMeta",
        "sequenceNumber",
        "startedAt",
        "line"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "forwards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CanonicalBorrowedMapMutation"
          }
        },
        "inverse": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CanonicalBorrowedMapMutation"
          }
        },
        "mutationMeta": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/os/store/canonical-edit/schema.json#/$defs/CanonicalEditMutationMeta"
          }
        },
        "sequenceNumber": {
          "type": "integer"
        },
        "startedAt": {
          "type": "string"
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CanonicalBorrowedMapMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ReplaceMap"
      ],
      "properties": {
        "ReplaceMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "map"
          ],
          "properties": {
            "map": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/CanonicalBorrowedValue"
              }
            }
          }
        }
      }
    },
    "CanonicalBorrowedValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalBorrowedValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CanonicalBorrowedValue"
          }
        }
      ]
    }
  }
}
