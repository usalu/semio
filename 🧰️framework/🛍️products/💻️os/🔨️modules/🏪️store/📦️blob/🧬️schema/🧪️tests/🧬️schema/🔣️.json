{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "sourceBoundary",
    "cases",
    "workspace"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "const": "semio-framework-os-store-blob-identity"
    },
    "sourceBoundary": {
      "const": {
        "maxSourceBytes": 32768,
        "maxSourceFiles": 4,
        "maxActiveLines": 400
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "json",
          "accepted"
        ],
        "properties": {
          "json": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "workspace": {
      "const": "repository"
    }
  }
}
