{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 3,
  "maxItems": 16,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "base",
      "operations",
      "expected",
      "coldClones",
      "ownedClones",
      "terminalOwners"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "base": {
        "type": "integer"
      },
      "operations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "fault"
          ],
          "properties": {
            "value": {
              "type": "integer"
            },
            "fault": {
              "enum": [
                "none",
                "message",
                "apply"
              ]
            }
          }
        }
      },
      "expected": {
        "type": "integer"
      },
      "coldClones": {
        "type": "integer",
        "minimum": 0
      },
      "ownedClones": {
        "const": 0
      },
      "terminalOwners": {
        "enum": [
          2,
          3
        ]
      }
    }
  }
}
