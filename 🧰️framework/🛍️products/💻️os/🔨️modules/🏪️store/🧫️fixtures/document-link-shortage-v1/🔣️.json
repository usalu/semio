{
  "schema": "semio.store.document-link-shortage/v1",
  "policy": {
    "reconnectMinMs": 500,
    "reconnectMaxMs": 30000,
    "shortageBoundMs": 60000
  },
  "accessRefusedStatuses": [
    401,
    403,
    404,
    410
  ],
  "texts": {
    "reconnecting": {
      "en": "Connection lost. Your edits are kept and sent when the hub is reachable again.",
      "de": "Verbindung unterbrochen. Ihre Änderungen bleiben erhalten und werden gesendet, sobald der Hub wieder erreichbar ist."
    },
    "link-expired": {
      "en": "The connection was lost for too long. Reconnect to keep editing this document.",
      "de": "Die Verbindung war zu lange unterbrochen. Verbinden Sie sich erneut, um dieses Dokument weiter zu bearbeiten."
    },
    "access-revoked": {
      "en": "Your access to this document was removed.",
      "de": "Ihr Zugriff auf dieses Dokument wurde entfernt."
    }
  },
  "vectors": [
    {
      "id": "a-short-shortage-resumes-in-place",
      "openedAtMs": 0,
      "steps": [
        {
          "event": {
            "kind": "restored",
            "nowMs": 200
          },
          "expect": {
            "state": {
              "kind": "linked"
            },
            "status": "linked",
            "admitsLocalEdits": true
          }
        },
        {
          "event": {
            "kind": "failed",
            "nowMs": 10000
          },
          "expect": {
            "state": {
              "kind": "unlinked",
              "sinceMs": 10000,
              "backoffMs": 500,
              "retryAtMs": 10500
            },
            "status": "reconnecting",
            "admitsLocalEdits": true,
            "expiresAtMs": 70000
          }
        },
