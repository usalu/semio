{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/store/fixtures/schema.json",
  "title": "Store Demo Fixtures",
  "$ref": "#/$defs/DemoSnapshot",
  "$defs": {
    "I32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "NullableI32": {
      "anyOf": [
        {
          "$ref": "#/$defs/I32"
        },
        {
          "type": "null"
        }
      ]
    },
    "U64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709552000
    },
    "DemoFieldChange": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/NullableI32"
        }
      }
    },
    "DemoDiff": {
      "type": "object",
      "properties": {
        "n": {
          "anyOf": [
            {
              "$ref": "#/$defs/DemoFieldChange"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DemoSnapshot": {
      "type": "object",
      "properties": {
        "n": {
          "$ref": "#/$defs/NullableI32"
        }
      },
      "additionalProperties": true
    }
  }
}
