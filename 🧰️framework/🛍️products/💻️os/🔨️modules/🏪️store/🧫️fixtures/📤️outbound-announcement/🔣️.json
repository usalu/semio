{
  "schema": "semio.store.outbound-announcement/v1",
  "vectors": [
    {
      "id": "every-gesture-is-its-own-edit-and-announces-exactly-its-operations",
      "steps": [
        { "gesture": { "items": 1 }, "expect": { "announcedOperations": 1, "announcedTransitions": 0, "edits": 1, "tailOperations": 1, "observed": null } },
        { "gesture": { "items": 1 }, "expect": { "announcedOperations": 1, "announcedTransitions": 0, "edits": 2, "tailOperations": 1, "observed": null } },
        { "gesture": { "items": 2 }, "expect": { "announcedOperations": 2, "announcedTransitions": 0, "edits": 3, "tailOperations": 2, "observed": null } },
        { "gesture": { "items": 3 }, "expect": { "announcedOperations": 3, "announcedTransitions": 0, "edits": 4, "tailOperations": 3, "observed": null } }
      ]
    },
    {
      "id": "after-an-undo-the-next-gesture-starts-a-new-edit",
      "steps": [
        { "gesture": { "items": 1 }, "expect": { "announcedOperations": 1, "announcedTransitions": 0, "edits": 1, "tailOperations": 1, "observed": null } },
        { "gesture": { "items": 2 }, "expect": { "announcedOperations": 2, "announcedTransitions": 0, "edits": 2, "tailOperations": 2, "observed": null } },
        { "undo": true, "expect": { "announcedOperations": 0, "announcedTransitions": 1, "edits": 2, "tailOperations": 1, "observed": null } },
        { "gesture": { "items": 1 }, "expect": { "announcedOperations": 1, "announcedTransitions": 0, "edits": 3, "tailOperations": 1, "observed": null } }
      ]
    },
    {
      "id": "every-announced-operation-names-the-newest-foreign-operation-its-author-had-applied",
      "steps": [
        { "gesture": { "items": 1 }, "expect": { "announcedOperations": 1, "announcedTransitions": 0, "edits": 1, "tailOperations": 1, "observed": null } },
        { "remote": { "id": "peer-1", "observed": null }, "expect": { "announcedOperations": 0, "announcedTransitions": 0, "edits": 2, "tailOperations": 1, "observed": null } },
        { "gesture": { "items": 2 }, "expect": { "announcedOperations": 2, "announcedTransitions": 0, "edits": 3, "tailOperations": 2, "observed": "peer-1" } },
        { "gesture": { "items": 1 }, "expect": { "announcedOperations": 1, "announcedTransitions": 0, "edits": 4, "tailOperations": 1, "observed": "peer-1" } },
        { "remote": { "id": "peer-2", "observed": "an-operation-this-replica-never-saw" }, "expect": { "announcedOperations": 0, "announcedTransitions": 0, "edits": 5, "tailOperations": 1, "observed": null } },
        { "gesture": { "items": 1 }, "expect": { "announcedOperations": 1, "announcedTransitions": 0, "edits": 6, "tailOperations": 1, "observed": "peer-2" } }
      ]
    }
  ]
}
