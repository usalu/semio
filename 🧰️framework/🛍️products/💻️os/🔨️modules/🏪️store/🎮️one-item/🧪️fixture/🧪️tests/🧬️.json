{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reported",
          "paid"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reported": {
            "type": "integer",
            "minimum": 0
          },
          "paid": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
