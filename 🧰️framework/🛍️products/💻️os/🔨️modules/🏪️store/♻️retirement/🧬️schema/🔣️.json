{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/store/retirement/schema.json",
  "title": "Store Retirement",
  "$ref": "#/$defs/OwnedRetirement",
  "$defs": {
    "OwnedRetirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cases",
        "budgets",
        "hostile"
      ],
      "properties": {
        "schema": {
          "const": "semio.artifact.owned-retirement/v1"
        },
        "cases": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "value",
              "bytes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "string",
                  "strings",
                  "optionalString",
                  "pair",
                  "stringMap",
                  "value"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "object"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "budgets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "items",
              "bytes"
            ],
            "properties": {
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "hostile": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
