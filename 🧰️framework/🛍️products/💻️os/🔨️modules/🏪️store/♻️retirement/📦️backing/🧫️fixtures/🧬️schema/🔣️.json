{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maximumItems",
    "maximumAdmissionBytes",
    "retainedSlots",
    "deniedReleaseBytes",
    "exactReceipt",
    "emptyVectorExtents",
    "undergrantOffset",
    "registryFinalDropBytes",
    "registryLockStates",
    "registryExternalAliases",
    "catalogTerminalDropBytes"
  ],
  "properties": {
    "maximumItems": {
      "const": 1
    },
    "maximumAdmissionBytes": {
      "const": 262144
    },
    "retainedSlots": {
      "const": 1024
    },
    "deniedReleaseBytes": {
      "const": 0
    },
    "exactReceipt": {
      "const": true
    },
    "emptyVectorExtents": {
      "const": [
        8194,
        16384,
        65536
      ]
    },
    "undergrantOffset": {
      "const": 1
    },
    "registryFinalDropBytes": {
      "const": 0
    },
    "registryLockStates": {
      "const": [
        "available",
        "busy",
        "poisoned"
      ]
    },
    "registryExternalAliases": {
      "const": 1
    },
    "catalogTerminalDropBytes": {
      "const": 0
    }
  }
}
