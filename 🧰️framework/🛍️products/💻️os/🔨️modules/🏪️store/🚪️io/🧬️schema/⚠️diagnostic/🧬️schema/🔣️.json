{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Owned Schema Close Diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "offset",
    "line",
    "column",
    "path",
    "refusalKind",
    "retainedProgress"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "line": {
      "type": "integer",
      "minimum": 0
    },
    "column": {
      "type": "integer",
      "minimum": 0
    },
    "path": {
      "type": "string",
      "pattern": "^\\$",
      "maxLength": 256
    },
    "refusalKind": {
      "enum": [
        "invalidValue",
        "canceled",
        "ownershipLimit",
        "allocationFailed",
        "workLimit",
        "depthLimit",
        "unsupportedOwner",
        "invariantViolated"
      ]
    },
    "retainedProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copiedItems",
        "copiedBytes",
        "retainedCapacityBytes",
        "releasedBytes"
      ],
      "properties": {
        "copiedItems": {
          "type": "integer",
          "minimum": 0
        },
        "copiedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "retainedCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "releasedBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
