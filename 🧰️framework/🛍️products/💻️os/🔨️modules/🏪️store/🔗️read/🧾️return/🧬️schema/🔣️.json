{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "parallelShares"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "otherAliases",
          "dropOtherBeforeRelease",
          "expectLastCustody"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "otherAliases": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "dropOtherBeforeRelease": {
            "type": "boolean"
          },
          "expectLastCustody": {
            "type": "boolean"
          }
        }
      }
    },
    "parallelShares": {
      "const": 2
    }
  }
}
