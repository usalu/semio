{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "os/store/original-genesis-factory/schema.json",
  "title": "Original Store Genesis Factory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "producer",
    "result",
    "absence",
    "reset"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "const": "original-owned-typed-baseline"
    },
    "producer": {
      "const": "selected-child-genesis-publication-and-owner-factories"
    },
    "result": {
      "const": "actual-owned-typed-store"
    },
    "absence": {
      "const": "retire-original-baseline-and-refuse-history-seed"
    },
    "reset": {
      "const": "same-child-original-genesis-envelope"
    }
  }
}
