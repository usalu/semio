{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/store/schema.json",
  "title": "Store",
  "$defs": {
    "GroupReadRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "generation",
        "revisionByte",
        "appliedEditIds",
        "history"
      ],
      "properties": {
        "snapshot": {
          "type": "integer"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "revisionByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "appliedEditIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "GroupCursorVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "maximumItems",
        "maximumBytes",
        "before",
        "after",
        "laws"
      ],
      "properties": {
        "schema": {
          "const": "artifact-group-cursor-visibility/v1"
        },
        "maximumItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        },
        "before": {
          "$ref": "#/$defs/GroupCursor"
        },
        "after": {
          "$ref": "#/$defs/GroupCursor"
        },
        "laws": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "GroupCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appliedEditIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redoEditIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checkpointId": {
          "type": "string"
        }
      }
    },
    "HistoryOperationPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit",
        "op"
      ],
      "properties": {
        "edit": {
          "type": "integer",
          "minimum": 0
        },
        "op": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
