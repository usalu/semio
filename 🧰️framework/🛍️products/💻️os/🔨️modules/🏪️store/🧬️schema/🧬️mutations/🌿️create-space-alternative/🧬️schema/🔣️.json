{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/store/mutation/create-space-alternative/schema.json",
  "title": "CreateSpaceAlternative",
  "type": "object",
