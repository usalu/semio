{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/store/mutation/create-space-alternative/schema.json",
  "title": "CreateSpaceAlternative",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alternative"
  ],
  "properties": {
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "checkpointIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "checkpointIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
