{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/store/mutation/commit-space-checkpoint/schema.json",
  "title": "CommitSpaceCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint"
  ],
  "properties": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "authors",
        "timestamp",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Parent checkpoint",
              "de": "Vorgänger-Checkpoint"
            },
            "ref": {
              "kind": "checkpoint"
            },
            "group": "target",
            "order": 20
          }
        },
        "message": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Message",
              "de": "Nachricht"
            },
            "group": "metadata",
            "order": 30
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Author ID",
                    "de": "Autoren-ID"
                  }
                }
              },
              "name": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Name",
                    "de": "Name"
                  }
                }
              },
              "avatar": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Avatar",
                    "de": "Avatar"
                  },
                  "description": {
                    "en": "Avatar image URL; absent when none.",
                    "de": "URL des Avatarbilds; fehlt, wenn keins."
                  }
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Authors",
              "de": "Autoren"
            },
            "group": "record",
            "order": 40
          }
        },
        "timestamp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "physical_ms",
            "logical"
          ],
          "properties": {
            "actor": {
              "type": "integer",
              "minimum": 0,
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Actor",
                  "de": "Akteur"
                },
                "step": 1,
                "precision": 0,
                "group": "clock",
                "order": 10
              }
            },
            "physical_ms": {
              "type": "integer",
              "minimum": 0,
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Physical time",
                  "de": "Physikalische Zeit"
                },
                "unit": "ms",
                "step": 1,
                "precision": 0,
                "group": "clock",
                "order": 20
              }
            },
            "logical": {
              "type": "integer",
              "minimum": 0,
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Logical counter",
                  "de": "Logischer Zähler"
                },
                "step": 1,
                "precision": 0,
                "group": "clock",
                "order": 30
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Timestamp",
              "de": "Zeitstempel"
            },
            "group": "record",
            "order": 50
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentId",
              "checkpointId",
              "alternativeId"
            ],
            "properties": {
              "documentId": {
                "type": "string",
                "minLength": 1,
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Document",
                    "de": "Dokument"
                  },
                  "group": "identity",
                  "order": 10
                }
              },
              "checkpointId": {
                "type": "string",
                "minLength": 1,
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Checkpoint",
                    "de": "Checkpoint"
                  },
                  "group": "identity",
                  "order": 20
                }
              },
              "alternativeId": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Alternative",
                    "de": "Alternative"
                  },
                  "group": "identity",
                  "order": 30
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Members",
              "de": "Mitglieder"
            },
            "group": "record",
            "order": 60
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Checkpoint",
          "de": "Checkpoint"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
