{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/store/supersede-replay",
  "title": "Supersede replay corpus",
  "description": "Language-agnostic history-editing cases over the store's demo mutation family: an initial snapshot, the recorded edits, the supersessions laid over them, and the Report-mode replay every implementation must reproduce — the reached state, one outcome per recorded operation in applied order, and whether the report blocks finalizing (any error or fatal).",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "family": { "const": "demo" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/case" } }
  },
  "definitions": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n"],
      "properties": { "n": { "type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647 } }
    },
    "operation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["operation", "n"], "properties": { "operation": { "const": "setN" }, "n": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } } },
        { "type": "object", "additionalProperties": false, "required": ["operation", "delta"], "properties": { "operation": { "const": "addN" }, "delta": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } } },
        { "type": "object", "additionalProperties": false, "required": ["operation"], "properties": { "operation": { "const": "deleteN" } } },
        { "type": "object", "additionalProperties": false, "required": ["operation"], "properties": { "operation": { "const": "restoreN" }, "n": { "type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647 } } }
      ]
    },
    "invalidInput": {
      "description": "A replacement input breaking the supersede law (a foreign schema, bytes that are no canonical operation of the document): every implementation folds its target as a no-op with one fatal mutation.invariant message.",
      "type": "object",
      "additionalProperties": false,
      "required": ["invalid"],
      "properties": {
        "invalid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "payloadHex"],
          "properties": { "schema": { "type": "string", "minLength": 1 }, "payloadHex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" } }
        }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit", "op", "replacement"],
      "properties": {
        "edit": { "type": "integer", "minimum": 0 },
        "op": { "type": "integer", "minimum": 0 },
        "replacement": { "oneOf": [{ "const": "withdrawn" }, { "$ref": "#/definitions/operation" }, { "$ref": "#/definitions/invalidInput" }] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit", "op", "worst", "codes", "superseded", "withdrawn"],
      "properties": {
        "edit": { "type": "integer", "minimum": 0 },
        "op": { "type": "integer", "minimum": 0 },
        "worst": { "enum": [null, "info", "warning", "error", "fatal"] },
        "codes": { "type": "array", "items": { "enum": ["mutation.target-missing", "mutation.target-referenced", "mutation.target-mismatch", "mutation.no-op", "mutation.partial", "mutation.clamped", "mutation.duplicate-id", "mutation.invariant", "mutation.cascade"] } },
        "superseded": { "type": "boolean" },
        "withdrawn": { "type": "boolean" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "initial", "edits", "supersessions", "expected"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "initial": { "$ref": "#/definitions/snapshot" },
        "edits": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/operation" } } },
        "supersessions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/supersession" } },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "outcomes", "blocksFinalize"],
          "properties": {
            "state": { "$ref": "#/definitions/snapshot" },
            "outcomes": { "type": "array", "items": { "$ref": "#/definitions/outcome" } },
            "blocksFinalize": { "type": "boolean" }
          }
        }
      }
    }
  }
}
