{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "complete",
    "fault",
    "copyBytes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "complete": {
      "const": "semantic-absence"
    },
    "fault": {
      "const": "original-retained-builder"
    },
    "copyBytes": {
      "const": 0
    }
  }
}
