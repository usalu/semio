{
  "schema": "semio.os.persistence-data-class/v1",
  "cases": [
    {
      "id": "folder-local",
      "binding": {
        "kind": "folder",
        "dataClass": "persistedLocalOnly",
        "path": "/tmp/spaces/demo"
      },
      "expectedDataClass": "persistedLocalOnly",
      "allowsShare": false,
      "allowsCollaboration": false,
      "durable": true
    },
    {
      "id": "hub-shared",
      "binding": {
        "kind": "hub",
        "dataClass": "persistedShared",
        "baseUrl": "http://hub.test",
        "spaceId": "space-1"
      },
      "expectedDataClass": "persistedShared",
      "allowsShare": true,
      "allowsCollaboration": true,
      "durable": true
    },
    {
      "id": "ephemeral-studio",
      "binding": {
        "kind": "ephemeral",
        "dataClass": "ephemeralLocalOnly"
      },
      "expectedDataClass": "ephemeralLocalOnly",
      "allowsShare": false,
      "allowsCollaboration": false,
      "durable": false,
      "promoteCommand": "promote-to-hub-space",
      "persistCommand": "persist-locally"
    },
    {
      "id": "preview-lane",
      "binding": {
        "kind": "ephemeral",
        "dataClass": "ephemeralShared",
        "lane": "preview"
      },
      "wireLane": {
        "lane": "preview",
        "dataClass": "ephemeralShared"
      },
      "expectedDataClass": "ephemeralShared",
      "allowsShare": false,
      "allowsCollaboration": false,
      "durable": false
    },
    {
      "id": "presence-lane",
      "binding": {
        "kind": "ephemeral",
        "dataClass": "ephemeralShared",
        "lane": "presence"
      },
      "wireLane": {
        "lane": "presence",
        "dataClass": "ephemeralShared"
      },
      "expectedDataClass": "ephemeralShared",
      "allowsShare": false,
      "allowsCollaboration": false,
      "durable": false
    }
  ],
  "homeUnion": {
    "hubSpace": {
      "origin": "hub",
      "dataClass": "persistedShared",
      "membersFromDirectory": true
    },
    "localCatalogSpace": {
      "origin": "local",
      "dataClass": "persistedLocalOnly",
      "membersFromDirectory": false
    },
    "ephemeralStudio": {
      "origin": "local",
      "dataClass": "ephemeralLocalOnly",
      "membersFromDirectory": false,
      "backbone": null
    }
  },
  "bindingSets": [
    {
      "id": "unbound",
      "members": [],
      "expected": "ephemeralLocalOnly"
    },
    {
      "id": "folder-only",
      "members": [
        "folder-local"
      ],
      "expected": "persistedLocalOnly"
    },
    {
      "id": "hub-only",
      "members": [
        "hub-shared"
      ],
      "expected": "persistedShared"
    },
    {
      "id": "folder-then-hub",
      "members": [
        "folder-local",
        "hub-shared"
      ],
      "expected": "persistedShared"
    },
    {
      "id": "hub-then-folder",
      "members": [
        "hub-shared",
        "folder-local"
      ],
      "expected": "persistedShared"
    },
    {
      "id": "repeated-folder",
      "members": [
        "folder-local",
        "folder-local"
      ],
      "expected": "persistedLocalOnly"
    },
    {
      "id": "repeated-hub",
      "members": [
        "hub-shared",
        "folder-local",
        "hub-shared"
      ],
      "expected": "persistedShared"
    }
  ],
  "classificationPrecedence": [
    "persistedShared",
    "persistedLocalOnly",
    "ephemeralShared",
    "ephemeralLocalOnly"
  ],
  "ephemeralBindingSets": [
    {
      "id": "local-history-plus-shared-preview",
      "members": [
        "folder-local",
        "preview-lane"
      ],
      "expected": "persistedLocalOnly"
    },
    {
      "id": "preview-plus-local-history",
      "members": [
        "preview-lane",
        "folder-local"
      ],
      "expected": "persistedLocalOnly"
    },
    {
      "id": "local-draft-plus-shared-presence",
      "members": [
        "ephemeral-studio",
        "presence-lane"
      ],
      "expected": "ephemeralShared"
    },
    {
      "id": "shared-history-plus-preview",
      "members": [
        "preview-lane",
        "hub-shared"
      ],
      "expected": "persistedShared"
    }
  ]
}
