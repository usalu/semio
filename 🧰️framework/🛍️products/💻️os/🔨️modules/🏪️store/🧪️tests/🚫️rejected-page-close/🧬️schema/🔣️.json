{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semio:store:tests:rejected-page-close",
  "title": "Rejected Page Close Grant Laws",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "pageBytes",
    "inputState",
    "fieldOwner",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "pageBytes": {
      "const": 4096
    },
    "inputState": {
      "const": "unstarted-record"
    },
    "fieldOwner": {
      "$ref": "#/$defs/fieldOwner"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumBytes"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "suffix"
      ],
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "suffix": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "releasedItems",
        "releasedBytes",
        "remainingPages",
        "remainingBytes",
        "recordPresent",
        "terminal"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pending",
            "complete"
          ]
        },
        "releasedItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "releasedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "remainingPages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "remainingBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12288
        },
        "recordPresent": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant",
        "expected"
      ],
      "properties": {
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "expected": {
          "$ref": "#/$defs/step"
        }
      }
    },
    "fieldOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenId",
        "payload",
        "closeGrant",
        "expected"
      ],
      "properties": {
        "tokenId": {
          "$ref": "#/$defs/integer"
        },
        "payload": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "closeGrant": {
          "$ref": "#/$defs/grant"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokenDrops",
            "fieldDrops",
            "registeredCloseCalls",
            "unadmittedCloseCalls",
            "acceptCalls",
            "finishCalls"
          ],
          "properties": {
            "tokenDrops": {
              "const": 1
            },
            "fieldDrops": {
              "const": 1
            },
            "registeredCloseCalls": {
              "const": 1
            },
            "unadmittedCloseCalls": {
              "const": 2
            },
            "acceptCalls": {
              "const": 0
            },
            "finishCalls": {
              "const": 0
            }
          }
        }
      }
    },
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pages",
        "expectedDocument",
        "closes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        "expectedDocument": {
          "$ref": "#/$defs/json"
        },
        "closes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/close"
          }
        }
      }
    }
  }
}
