{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases", "metadataAdmission", "erasedDispatch"],
  "properties": {
    "schema": {"const": "semio.framework.sqlite-native-decoding-admission/v1"},
    "erasedDispatch": {
      "type": "object", "additionalProperties": false,
      "required": ["bufferBytes", "cancelAt", "ordinaryCalls", "controlledCalls"],
      "properties": {"bufferBytes": {"type": "integer", "minimum": 1}, "cancelAt": {"type": "integer", "minimum": 1}, "ordinaryCalls": {"const": 0}, "controlledCalls": {"const": 1}}
    },
    "metadataAdmission": {
      "type": "object", "additionalProperties": false,
      "required": ["domainRows", "fileRows"],
      "properties": {"domainRows": {"type": "integer", "minimum": 0}, "fileRows": {"type": "integer", "minimum": 1}}
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "bufferBytes", "emptyBuffers", "maximumBytes", "decoded"],
        "properties": {
          "id": {"type": "string"},
          "bufferBytes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "emptyBuffers": {"type": "integer", "minimum": 0},
          "maximumBytes": {"type": "integer", "minimum": 0},
          "decoded": {"type": "boolean"}
        }
      }
    }
  }
}
