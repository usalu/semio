{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://framework/os/snapshot/decode/ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "neutralSource",
    "retiredMount",
    "retainedModules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "neutralSource": {
      "type": "string",
      "minLength": 1
    },
    "retiredMount": {
      "type": "string",
      "minLength": 1
    },
    "retainedModules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
