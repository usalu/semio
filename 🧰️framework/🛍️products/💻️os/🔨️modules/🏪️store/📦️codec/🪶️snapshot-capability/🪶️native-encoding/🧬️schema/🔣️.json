{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases",
    "interiorEncoding",
    "typedProjection",
    "physicalText",
    "physicalLiteralTexts",
    "physicalBytes",
    "exactEncodingAdmission"
  ],
  "properties": {
    "exactEncodingAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputBytes", "estimateMultiplier", "maximumBytes", "maximumFileBytes"],
      "properties": {
        "outputBytes": {"type": "integer", "minimum": 1},
        "estimateMultiplier": {"type": "integer", "minimum": 2},
        "maximumBytes": {"type": "integer", "minimum": 1},
        "maximumFileBytes": {"type": "integer", "minimum": 1}
      }
    },
    "schema": {
      "const": "semio.framework.sqlite-native-encoding-admission/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "guarded",
          "outputBytes",
          "maximumBytes",
          "cancelEncoding",
          "encoded",
          "controlled"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "guarded": {
            "type": "boolean"
          },
          "outputBytes": {
            "type": "integer",
            "minimum": 0
          },
          "maximumBytes": {
            "type": "integer",
            "minimum": 1
          },
          "cancelEncoding": {
            "type": "boolean"
          },
          "encoded": {
            "type": "boolean"
          },
          "controlled": {
            "type": "boolean"
          }
        }
      }
    },
    "interiorEncoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputBytes",
        "maximumBytes",
        "cancelAt",
        "expectedCanceled"
      ],
      "properties": {
        "outputBytes": {
          "type": "integer",
          "minimum": 131072
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        },
        "cancelAt": {
          "type": "integer",
          "minimum": 1
        },
        "expectedCanceled": {
          "const": true
        }
      }
    },
    "typedProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "cancelAt",
        "maximumBytes"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 512
        },
        "cancelAt": {
          "type": "integer",
          "minimum": 256
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "physicalLiteralTexts": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "string"
      }
    },
    "physicalBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "maximumBytes",
        "cancelAt"
      ],
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 131072
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        },
        "cancelAt": {
          "type": "integer",
          "minimum": 65536
        }
      }
    },
    "physicalText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "repeatCount",
        "maximumBytes",
        "cancelAt",
        "maximumFileBytes"
      ],
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "repeatCount": {
          "type": "integer",
          "minimum": 16384
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        },
        "cancelAt": {
          "type": "integer",
          "minimum": 65536
        },
        "maximumFileBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
