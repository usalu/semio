{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema",
    "extension",
    "slots",
    "snapshots",
    "invariants"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "schema": {
      "const": "test.native-codec-send/v1"
    },
    "extension": {
      "const": "demo.doc"
    },
    "slots": {
      "const": [
        {
          "name": "compile_dsl",
          "consumer": "FolderEndpoint::read",
          "send": true
        },
        {
          "name": "print_mirror",
          "consumer": "FolderEndpoint::write",
          "send": true
        }
      ]
    },
    "snapshots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n"
        ],
        "properties": {
          "n": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        }
      }
    },
    "invariants": {
      "const": {
        "actorTurnSend": true,
        "localExecutorFallback": false,
        "newWorkerPool": false,
        "boundedSerializationClaim": false
      }
    }
  }
}
