{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "maximumItems", "maximumBytes", "before", "after", "laws"],
  "properties": {
    "schema": { "const": "artifact-group-cursor-visibility/v1" },
    "maximumItems": { "const": 1 },
    "maximumBytes": { "const": 4096 },
    "before": { "$ref": "#/definitions/cursor" },
    "after": { "$ref": "#/definitions/cursor" },
    "laws": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } }
  },
  "definitions": {
    "cursor": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "appliedEditIds": { "type": "array", "items": { "type": "string" } },
        "redoEditIds": { "type": "array", "items": { "type": "string" } },
        "checkpointId": { "type": "string" }
      }
    }
  }
}
