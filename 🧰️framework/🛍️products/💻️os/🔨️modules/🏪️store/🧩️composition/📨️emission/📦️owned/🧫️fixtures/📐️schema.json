{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "values",
    "expectedAfter",
    "transport",
    "wrongType",
    "metadata",
    "grant",
    "required",
    "census",
    "copyDemand"
  ],
  "properties": {
    "copyDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowCounts", "minimumCopyBytes", "zeroCopyReleasesBytes"],
      "properties": {
        "rowCounts": {"const": [0, 1, 65, 257]},
        "minimumCopyBytes": {"const": 4},
        "zeroCopyReleasesBytes": {"const": 0}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply",
        "preview",
        "applyingRequestsWireCodec"
      ],
      "properties": {
        "apply": {
          "const": "typed"
        },
        "preview": {
          "const": "wire"
        },
        "applyingRequestsWireCodec": {
          "const": false
        }
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 3
    },
    "expectedAfter": {
      "type": "integer"
    },
    "wrongType": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "groupId"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "const": 1
        },
        "maximumCopyBytes": {
          "const": 64
        },
        "maximumCapacityBytes": {
          "const": 4096
        },
        "maximumReleaseBytes": {
          "const": 4096
        },
        "maximumDepth": {
          "const": 64
        }
      }
    },
    "required": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrongTypePreservesSource",
        "stalePreservesPointerAndOrder",
        "zeroCapacityRetainsSource",
        "zeroReleaseRetainsPhysicalOwner",
        "terminalReleasesEachAllocationOnce"
      ],
      "properties": {
        "wrongTypePreservesSource": {
          "const": true
        },
        "stalePreservesPointerAndOrder": {
          "const": true
        },
        "zeroCapacityRetainsSource": {
          "const": true
        },
        "zeroReleaseRetainsPhysicalOwner": {
          "const": true
        },
        "terminalReleasesEachAllocationOnce": {
          "const": true
        }
      }
    },
    "census": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowCounts",
        "maximumPreflightsPerTurn",
        "maximumCloseBytes"
      ],
      "properties": {
        "rowCounts": {
          "const": [
            1,
            3,
            257
          ]
        },
        "maximumPreflightsPerTurn": {
          "const": 1
        },
        "maximumCloseBytes": {
          "const": 262144
        }
      }
    }
  }
}
