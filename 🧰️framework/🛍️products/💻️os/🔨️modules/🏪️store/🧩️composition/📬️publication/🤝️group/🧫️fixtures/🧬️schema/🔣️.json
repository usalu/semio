{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maximumItems", "maximumBytes", "decisionRequestedBytes", "decisionReleasedBytes", "cases"],
  "properties": {
    "schema": { "const": "semio.member.group-publication/v1" },
    "maximumItems": { "const": 1 },
    "maximumBytes": { "const": 16384 },
    "decisionRequestedBytes": { "const": 0 },
    "decisionReleasedBytes": { "const": 0 },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "historyEntries", "before", "after"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "historyEntries": { "type": "integer", "minimum": 0, "maximum": 257 },
          "before": { "$ref": "#/definitions/values" },
          "after": { "$ref": "#/definitions/values" }
        }
      }
    }
  },
  "definitions": {
    "values": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 0 } }
  }
}
