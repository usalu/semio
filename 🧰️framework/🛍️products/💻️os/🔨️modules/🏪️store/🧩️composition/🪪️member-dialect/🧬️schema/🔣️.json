{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/store/composition/member-dialect/schema.json",
  "title": "Store Closed Member Dialect Admission",
  "$defs": {
    "Slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "many"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "many": {
          "type": "boolean"
        }
      }
    },
    "ProjectedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "childId",
        "artifactId",
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "slot": {
          "type": "string"
        },
        "childId": {
          "type": "string"
        },
        "artifactId": {
          "type": "string"
        },
        "artifactKind": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "subset": {
          "type": "string"
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent",
        "slot",
        "child"
      ],
      "properties": {
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "child": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentId",
        "parentDialect",
        "slot",
        "childId"
      ],
      "properties": {
        "parentId": {
          "type": "string"
        },
        "parentDialect": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        },
        "childId": {
          "type": "string"
        }
      }
    },
    "Dialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "type": "string",
          "minLength": 1
        },
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "subset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "schema",
        "dialect"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "dialect": {
          "$ref": "#/$defs/Dialect"
        }
      }
    },
    "Persisted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "dialect"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "dialect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dialect"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
