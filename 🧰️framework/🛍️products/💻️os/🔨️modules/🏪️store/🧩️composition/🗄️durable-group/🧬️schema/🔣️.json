{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/store/composition/durable-group/schema.json",
  "title": "Store Durable Owned Group",
  "$defs": {
    "DurableOwnedGroupLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participants",
        "eventBytes",
        "recoveryPackBytes",
        "structuralIdentityBytes",
        "identityBytes",
        "walSegmentBytes",
        "walFramingReserveBytes"
      ],
      "properties": {
        "participants": {
          "type": "integer",
          "minimum": 1
        },
        "eventBytes": {
          "type": "integer",
          "minimum": 1
        },
        "recoveryPackBytes": {
          "type": "integer",
          "minimum": 1
        },
        "structuralIdentityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "identityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "walSegmentBytes": {
          "type": "integer",
          "minimum": 1
        },
        "walFramingReserveBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DurableOwnedGroupSchemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "anchor",
        "parent",
        "drawing",
        "value"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "drawing": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "DurableOwnedGroupAdmission": {
      "enum": [
        "admit",
        "reject"
      ]
    },
    "DurableOwnedGroupHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DurableOwnedGroupHex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})+$"
    },
    "DurableOwnedGroupDialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "standard": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "DurableOwnedGroupReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "dialect"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dialect": {
          "$ref": "#/$defs/DurableOwnedGroupDialect"
        }
      }
    },
    "DurableOwnedGroupOwner": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "parent",
        "slot",
        "childId"
      ],
      "properties": {
        "parent": {
          "$ref": "#/$defs/DurableOwnedGroupReference"
        },
        "slot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "childId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "DurableOwnedGroupAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "parent",
        "shape"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parent": {
          "$ref": "#/$defs/DurableOwnedGroupReference"
        },
        "shape": {
          "const": "parent-drawing-value"
        }
      }
    }
  }
}
