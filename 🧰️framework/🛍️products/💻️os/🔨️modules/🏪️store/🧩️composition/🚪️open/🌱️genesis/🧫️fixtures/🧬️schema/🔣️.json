{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "maximumCopyBytes",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "member-genesis-envelope.v1"
    },
    "maximumCopyBytes": {
      "const": 64
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "schema",
          "expected",
          "owner",
          "initialPackHex",
          "packRepeats",
          "expectedSha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "dialect"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "dialect": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_kind",
                  "standard",
                  "subset"
                ],
                "properties": {
                  "artifact_kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "standard": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subset": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent",
              "slot",
              "child_id"
            ],
            "properties": {
              "parent": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "dialect"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dialect": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "artifact_kind",
                      "standard",
                      "subset"
                    ],
                    "properties": {
                      "artifact_kind": {
                        "type": "string",
                        "minLength": 1
                      },
                      "standard": {
                        "type": "string",
                        "minLength": 1
                      },
                      "subset": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "child_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "initialPackHex": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})+$"
          },
          "packRepeats": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16385
          },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
