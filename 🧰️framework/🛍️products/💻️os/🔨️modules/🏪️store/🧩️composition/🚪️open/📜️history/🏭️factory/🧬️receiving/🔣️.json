    "boxedShell": {
      "const": {
        "paidItems": 1,
        "copiedBytes": 0,
        "terminalDropBytes": 0,
        "originalContext": true,
        "separateChildClose": true
      }
    },
    "sourceReceiving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cuts",
        "originalPageBytes",
        "reservationDebits",
        "receiptDebits",
        "sameControlReceipt",
        "sameRecipient",
        "actualCallerPorts",
        "paidCancelledClose",
        "typedFaultCustody",
        "terminalDropBytes"
      ],
      "properties": {
        "cuts": {
          "const": [
            0,
            1,
            5,
            64,
            65536
          ]
        },
        "originalPageBytes": {
          "const": 4096
        },
        "reservationDebits": {
          "const": 0
        },
        "receiptDebits": {
          "const": 1
        },
        "sameControlReceipt": {
          "const": true
        },
        "sameRecipient": {
          "const": true
        },
        "actualCallerPorts": {
          "const": true
        },
        "paidCancelledClose": {
          "const": true
        },
        "typedFaultCustody": {
          "const": true
        },
        "terminalDropBytes": {
          "const": 0
        }
      }
