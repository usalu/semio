      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileBytes",
        "frameBodyBytes",
        "records",
        "maximumFields",
        "maximumTextBytes",
        "maximumBinaryBytes",
        "maximumJsonBytes",
        "maximumJsonAllocationBytes",
        "maximumJsonItems",
        "maximumJsonDepth"
      ],
      "properties": {
        "fileBytes": {
          "const": 67108864
        },
        "frameBodyBytes": {
          "const": 1048576
        },
        "records": {
          "const": 8192
        },
        "maximumFields": {
          "const": 128
        },
        "maximumTextBytes": {
          "const": 1048576
        },
        "maximumBinaryBytes": {
          "const": 1048576
        },
        "maximumJsonBytes": {
          "const": 1048576
        },
        "maximumJsonAllocationBytes": {
          "const": 8388608
