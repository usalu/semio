{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.member.original-history-receiving.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "historyLimits",
    "maximumHistoryAllocationBytes",
    "expected",
    "caller"
  ],
  "properties": {
