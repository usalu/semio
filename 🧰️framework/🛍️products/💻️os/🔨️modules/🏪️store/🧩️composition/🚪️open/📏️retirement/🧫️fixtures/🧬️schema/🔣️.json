{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maximumAdmissionBytes", "cases"],
  "properties": {
    "schema": { "const": "semio.member-open.physical-retirement/v1" },
    "maximumAdmissionBytes": { "const": 262144 },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "capacityBytes"],
        "properties": {
          "id": { "enum": ["ascii-spare-capacity", "unicode-spare-capacity", "empty-retained-capacity"] },
          "text": { "type": "string", "maxLength": 256 },
          "capacityBytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
        }
      }
    }
  }
}
