{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "limits", "cases", "framing", "retention"],
  "properties": {
    "schema": {"const": "semio.member.open-operation/v1"},
    "limits": {"const": {"pageBytes": 4096, "maximumPages": 4096, "identityBytes": 256}},
    "retention": {"type": "array", "minItems": 6, "maxItems": 6, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "snapshots", "mutations", "cancelled"],
      "properties": {
        "id": {"type":"string","minLength":1},
        "stage": {"enum":["input", "snapshot", "forward", "inverse", "envelope", "initialization"]},
        "snapshots": {"type":"integer","minimum":0,"maximum":2},
        "mutations": {"type":"integer","minimum":0,"maximum":2},
        "cancelled": {"type":"boolean"}
      }
    }},
    "framing": {"type": "array", "minItems": 8, "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "bytes", "snapshot", "history", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "bytes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "snapshot": {"type": ["array", "null"], "prefixItems": [{"type":"integer","minimum":0},{"type":"integer","minimum":1}], "items": false, "minItems": 2, "maxItems": 2},
        "history": {"type": ["array", "null"], "prefixItems": [{"type":"integer","minimum":0},{"type":"integer","minimum":1}], "items": false, "minItems": 2, "maxItems": 2},
        "reason": {"enum": [null, "malformed"]}
      }
    }},
    "cases": {"type": "array", "minItems": 10, "maxItems": 10, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sealed", "bytes", "expiresAtUs", "nowUs", "artifactId", "ownerChildId", "admitted", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "sealed": {"type": "boolean"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "expiresAtUs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "nowUs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "artifactId": {"type": "string"}, "ownerChildId": {"type": ["string", "null"]},
        "admitted": {"type": "boolean"},
        "reason": {"enum": [null, "unsealed", "empty", "expired", "identity", "owner"]}
      }
    }}
  }
}
