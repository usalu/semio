{
  "$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "additionalProperties": false,
  "required": ["page", "snapshotOpen", "disposer", "factories", "cases"],
  "properties": {
    "page": { "const": 4096 }, "snapshotOpen": { "type": "integer", "minimum": 0 }, "disposer": { "type": "integer", "minimum": 0 },
    "factories": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["arc", "ticket"], "properties": { "arc": { "type": "integer", "minimum": 0 }, "ticket": { "type": "integer", "minimum": 0 } } } },
    "cases": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["id", "items", "bytes", "born"], "properties": { "id": { "type": "string" }, "items": { "enum": [0, 1] }, "bytes": { "enum": ["exact", "one-below"] }, "born": { "type": "boolean" } } } }
  }
}
