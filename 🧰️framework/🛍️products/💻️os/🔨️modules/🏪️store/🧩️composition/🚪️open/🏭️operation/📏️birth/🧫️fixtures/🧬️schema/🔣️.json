{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "historyPageBytes",
    "maximumAdmissionBytes",
    "cases",
    "denied"
  ],
  "properties": {
    "schema": {
      "const": "semio.member.open-birth/v1"
    },
    "historyPageBytes": {
      "const": 4096
    },
    "maximumAdmissionBytes": {
      "const": 262144
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifactId",
          "actor",
          "dialect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "dialect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_kind",
              "standard",
              "subset"
            ],
            "properties": {
              "artifact_kind": {
                "const": "s.test.member"
              },
              "standard": {
                "const": "v1"
              },
              "subset": {
                "enum": [
                  "first",
                  "second"
                ]
              }
            }
          }
        }
      }
    },
    "denied": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maximumItems",
          "belowBirth"
        ],
        "properties": {
          "maximumItems": {
            "enum": [
              0,
              1
            ]
          },
          "belowBirth": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
