{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.os.store.assembly-lifetime/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "scenarios"
  ],
  "properties": {
    "contract": {
      "const": "semio.framework.os.store.assembly-lifetime/v1"
    },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "baselineAccepted",
          "accepted",
          "diagnostic"
        ],
        "properties": {
          "id": {
            "enum": [
              "explicit-release",
              "implicit-scope",
              "escaping-return",
              "valid-order"
            ]
          },
          "baselineAccepted": {
            "const": true
          },
          "accepted": {
            "type": "boolean"
          },
          "diagnostic": {
            "enum": [
              "E0505",
              "E0597",
              "E0515",
              null
            ]
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "explicit-release"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "implicit-scope"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "escaping-return"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "valid-order"
              }
            }
          }
        }
      ]
    }
  }
}
