{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/directory/local-session/broker/schema.json",
  "$defs": {
    "LocalSessionRequestIdV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "LocalSessionDigestV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "LocalSessionProfileIdV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "LocalSessionBrokerRecordV1": {
      "description": "🎫️ The local session broker record the owner of a loopback development hub writes 0600 into its data root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "hubOrigin",
        "runId",
        "port",
        "secret",
        "profiles"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-session-broker/v1"
        },
        "hubOrigin": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}$"
        },
        "runId": {
          "$ref": "#/$defs/LocalSessionRequestIdV1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "secret": {
          "$ref": "#/$defs/LocalSessionDigestV1"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/LocalSessionProfileIdV1"
          }
        }
      }
    },
    "LocalSessionRequestV1": {
      "description": "🎫️ One loopback request for a fresh react-relay session of a declared local profile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-session-request/v1"
        },
        "profileId": {
          "$ref": "#/$defs/LocalSessionProfileIdV1"
        }
      }
    },
    "LocalSessionV1": {
      "description": "🎫️ One issued development session: the react-relay capability and the user it resolves to.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "token",
        "userId"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-session/v1"
        },
        "profileId": {
          "$ref": "#/$defs/LocalSessionProfileIdV1"
        },
        "token": {
          "type": "string",
          "pattern": "^session\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
