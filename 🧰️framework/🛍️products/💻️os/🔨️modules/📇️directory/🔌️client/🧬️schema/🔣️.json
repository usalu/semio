{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.os.document-http-port/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "serviceId",
    "operations"
  ],
  "properties": {
    "schema": {
      "const": "semio.os.document-http-port/v1"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "serviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "method",
          "route",
          "sendBody",
          "requestMaxBytes",
          "responseMaxBytes",
          "inputSchema",
          "outputSchema"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "route": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "sendBody": {
            "type": "boolean"
          },
          "cursorField": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "requestMaxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "responseMaxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "inputSchema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "outputSchema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        }
      }
    }
  }
}
