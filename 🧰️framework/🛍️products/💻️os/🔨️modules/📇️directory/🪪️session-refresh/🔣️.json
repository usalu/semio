{
  "schema": "semio.directory.session-refresh-fixtures.v1",
  "intervalMs": 5000,
  "proofTtlMs": 15000,
  "success": [
    "initial",
    "same-authority",
    "replacement"
  ],
  "refusals": [
    "http-401",
    "http-428",
    "non-200",
    "invalid-body",
    "expired",
    "transport"
  ],
  "cancellation": [
    "before-request",
    "during-request",
    "during-delay"
  ],
  "maximumConcurrentRequests": 1,
  "actionAdmission": [
    { "id": "missing", "accepted": false },
    { "id": "same", "accepted": true },
    { "id": "different-binding", "accepted": false },
    { "id": "different-generation", "accepted": false },
    { "id": "expired", "accepted": false }
  ],
  "unavailableRetries": 0,
  "presentation": {
    "locales": ["en", "de"],
    "states": [
      { "kind": "pending", "role": "status", "live": "polite", "cancellable": true },
      { "kind": "unavailable", "role": "alert", "live": "assertive", "cancellable": false }
    ],
    "text": {
      "en": {
        "pending": "Verifying shared access…",
        "cancel": "Cancel shared access",
        "unavailable": "Shared access is unavailable. Open a fresh authorized session from the secure launcher."
      },
      "de": {
        "pending": "Gemeinsamen Zugriff prüfen…",
        "cancel": "Prüfung abbrechen",
        "unavailable": "Der gemeinsame Zugriff ist nicht verfügbar. Öffne über den sicheren Starter eine neu autorisierte Sitzung."
      }
    }
  }
}
