{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://hub/checkpoint-publication-command/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "correlationId", "descriptorDigestV1", "expectedDocumentFrontier", "expectedCurrent", "baselineFrontier", "pack", "spr"],
  "properties": {
    "schema": { "const": "semio.hub.checkpoint-publication-command/v1" },
    "correlationId": { "$ref": "#/$defs/correlation" },
    "descriptorDigestV1": { "$ref": "#/$defs/hash" },
    "expectedDocumentFrontier": { "$ref": "#/$defs/documentFrontier" },
    "expectedCurrent": { "$ref": "#/$defs/current" },
    "baselineFrontier": { "$ref": "#/$defs/artifactFrontier" },
    "pack": { "$ref": "#/$defs/blob" },
    "spr": { "$ref": "#/$defs/blob" }
  },
  "$defs": {
    "safe": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveSafe": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "hash": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
    "correlation": { "type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
    "documentFrontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSeq", "commitSeq", "epoch"],
      "properties": {
        "headSeq": { "$ref": "#/$defs/safe" },
        "commitSeq": { "$ref": "#/$defs/safe" },
        "epoch": { "$ref": "#/$defs/safe" }
      }
    },
    "artifactFrontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainSha256"],
      "properties": {
        "documentId": { "$ref": "#/$defs/text" },
        "headEditOrdinal": { "$ref": "#/$defs/positiveSafe" },
        "headEditId": { "$ref": "#/$defs/text" },
        "lastCommitSeq": { "$ref": "#/$defs/positiveSafe" },
        "chainSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "current": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "checkpointId"],
          "properties": { "state": { "const": "genesis" }, "checkpointId": { "$ref": "#/$defs/hash" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "checkpointId", "baselineFrontier"],
          "properties": {
            "state": { "const": "active" },
            "checkpointId": { "$ref": "#/$defs/hash" },
            "baselineFrontier": { "$ref": "#/$defs/artifactFrontier" }
          }
        }
      ]
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byteLength"],
      "properties": {
        "sha256": { "$ref": "#/$defs/hash" },
        "byteLength": { "$ref": "#/$defs/positiveSafe" }
      }
    }
  }
}
