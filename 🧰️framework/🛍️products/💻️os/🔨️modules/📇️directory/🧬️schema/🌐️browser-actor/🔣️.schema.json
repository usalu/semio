{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/os/document-browser-actor-v1.json",
  "title": "Document Browser Actor Identity",
  "$ref": "#/$defs/plan",
  "$defs": {
    "digest": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
    "interfaces": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": { "enum": [
        "semio:framework/host-async@1.0.0", "semio:framework/pure@1.0.0",
        "wasi:cli/environment@0.2.0", "wasi:cli/exit@0.2.0",
        "wasi:cli/stderr@0.2.0", "wasi:cli/stdin@0.2.0", "wasi:cli/stdout@0.2.0",
        "wasi:cli/terminal-input@0.2.0", "wasi:cli/terminal-output@0.2.0",
        "wasi:cli/terminal-stderr@0.2.0", "wasi:cli/terminal-stdin@0.2.0", "wasi:cli/terminal-stdout@0.2.0",
        "wasi:clocks/monotonic-clock@0.2.0", "wasi:io/error@0.2.0", "wasi:io/poll@0.2.0", "wasi:io/streams@0.2.0"
      ] }
    },
    "none": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"], "properties": { "kind": { "const": "none" } }
    },
    "identity": {
      "type": "object",
      "required": ["kind", "schema", "codegenPolicy", "sha256", "sourceComponentSha256", "sourceDescriptorByteSha256", "policySha256", "importInterfaces"],
      "properties": {
        "kind": { "const": "closed-browser-actor" },
        "schema": { "const": "semio.os.closed-browser-actor.v1" },
        "codegenPolicy": { "const": "semio.os.browser-jco-1.27.0-jspi.v1" },
        "sha256": { "$ref": "#/$defs/digest" },
        "sourceComponentSha256": { "$ref": "#/$defs/digest" },
        "sourceDescriptorByteSha256": { "$ref": "#/$defs/digest" },
        "policySha256": { "$ref": "#/$defs/digest" },
        "importInterfaces": { "$ref": "#/$defs/interfaces" }
      }
    },
    "plan": {
      "oneOf": [ { "$ref": "#/$defs/none" }, { "type": "object", "$ref": "#/$defs/identity", "unevaluatedProperties": false } ]
    },
    "lease": {
      "oneOf": [ { "$ref": "#/$defs/none" }, {
        "type": "object", "$ref": "#/$defs/identity", "unevaluatedProperties": false,
        "required": ["byteLength"], "properties": { "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 } }
      } ]
    }
  }
}
