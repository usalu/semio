{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Captured Snapshot Source Laws",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "cases"],
  "properties": {
    "contract": {"const": "semio.original.captured-snapshot-source/v1"},
    "cases": {"type": "array", "minItems": 4, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "bytes", "expected"],
      "properties": {"id": {"type": "string"}, "bytes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}}, "expected": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}}}
    }}
  }
}
