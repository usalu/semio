{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://vcs/genesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot",
    "digest"
  ],
  "properties": {
    "snapshot": {},
    "digest": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
