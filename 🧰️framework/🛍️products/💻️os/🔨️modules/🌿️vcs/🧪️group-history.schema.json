{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maximumItems", "members", "ordered", "laws"],
  "properties": {
    "schema": { "const": "artifact-group-history-visibility/v1" },
    "maximumItems": { "const": 1 },
    "members": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "before", "after"],
        "properties": {
          "id": { "enum": ["a", "b"] },
          "before": { "type": "array", "items": { "type": "integer" } },
          "after": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "ordered": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "object", "additionalProperties": false, "required": ["member", "value"], "properties": { "member": { "enum": ["a", "b"] }, "value": { "type": "integer" } } }
    },
    "laws": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } }
  }
}
