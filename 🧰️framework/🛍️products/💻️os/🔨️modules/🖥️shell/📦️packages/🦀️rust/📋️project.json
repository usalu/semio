{
  "name": "@semio-tech/framework-os-shell-rs",
  "$schema": "../../../../../🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/📦️packages/🦀️rust",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/**/*.rs",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/🧬️schema/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/🧪️tests/🧫️fixtures/**/*",
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "schemaModule": ["{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/🧬️schema/**/*", "{projectRoot}/Cargo.toml", "{projectRoot}/🦀️.rs", "{projectRoot}/📜️script.ts"],
    "renderedMirror": ["{workspaceRoot}/🧰️framework/🔨️modules/🐚️shell/🤖️generated/**/*"],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "check": {
      "cache": true,
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts check"
      }
    },
    "test": {
      "cache": true,
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test"
      }
    },
    "typegen": {
      "metadata": {
        "semio": {
          "sourceInputObservation": "freshness"
        }
      },
      "cache": true,
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts typegen"
      },
      "inputs": ["schemaModule"],
      "outputs": ["{workspaceRoot}/🧰️framework/🔨️modules/🐚️shell/🤖️generated"]
    },
    "schema-check": {
      "cache": true,
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts schema-check"
      },
      "inputs": [
        "default",
        "^default",
        "reads",
        "cargoToolchain",
        "schemaModule",
        "renderedMirror"
      ],
      "outputs": []
    },
    "preview-generated": {
      "cache": true,
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🖥️shell/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts preview-generated"
      },
      "outputs": []
    }
  }
}
