{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/neural/engine/evaluation/corpus.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copyBytes",
    "cases"
  ],
  "properties": {
    "copyBytes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          1,
          3,
          64
        ]
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nodes",
          "edges",
          "seeds",
          "expectedInputs",
          "expectedOutputs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "params"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "https://json.schemas.assets.semio-tech.com/framework/os/neural/engine/schema.json#/$defs/Value"
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            }
          },
          "seeds": {
            "type": "object",
            "additionalProperties": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/os/neural/engine/schema.json#/$defs/Value"
            }
          },
          "expectedInputs": {
            "type": "object",
            "additionalProperties": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/os/neural/engine/schema.json#/$defs/Value"
            }
          },
          "expectedOutputs": {
            "type": "object",
            "additionalProperties": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/os/neural/engine/schema.json#/$defs/Value"
            }
          }
        }
      }
    }
  }
}
