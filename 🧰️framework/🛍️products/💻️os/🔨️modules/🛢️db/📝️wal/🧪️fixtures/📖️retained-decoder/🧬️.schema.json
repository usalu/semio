{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "varints"],
  "properties": {
    "schema": { "const": "semio.db.wal.retained-decoder/v1" },
    "varints": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "hex", "value", "consumed"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){0,11}$" },
          "value": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]{0,19})$" },
          "consumed": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 }
        }
      }
    }
  }
}
