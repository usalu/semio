{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/db/wal/fail-stop-v1.json",
  "title": "WAL Fail-Stop Corpus V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases", "expectedSecondError"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fault", "expectedError", "expectedPhysicalSuffix"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fault": { "enum": ["shortAppend", "appendError", "syncError", "successorAppendError"] },
          "keepBytes": { "type": "integer", "minimum": 1 },
          "expectedError": { "enum": ["Corrupt", "Io"] },
          "expectedPhysicalSuffix": { "enum": ["torn", "absent", "complete"] }
        }
      }
    },
    "expectedSecondError": { "const": "Closed" }
  }
}
