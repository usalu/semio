{
  "schemaVersion": 1,
  "owner": "semio-framework-os-kernel-db",
  "definingErrorOwner": "semio-framework-pack-error",
  "rule": {
    "typedCause": "Pack",
    "preserveKind": true,
    "preserveOriginalMessageAllocation": true,
    "messageClassification": false
  },
  "cases": [
    {
      "id": "InvalidValue",
      "source": "ValueRefusal",
      "kind": "InvalidValue",
      "message": "refusal-0",
      "path": [
        "scope",
        "items"
      ]
    },
    {
      "id": "Canceled",
      "source": "ValueRefusal",
      "kind": "Canceled",
      "message": "refusal-1",
      "path": [
        "scope",
        "items"
      ]
    },
    {
      "id": "OwnershipLimit",
      "source": "ValueRefusal",
      "kind": "OwnershipLimit",
      "message": "refusal-2",
      "path": [
        "scope",
        "items"
      ]
    },
    {
      "id": "AllocationFailed",
      "source": "ValueRefusal",
      "kind": "AllocationFailed",
      "message": "refusal-3",
      "path": [
        "scope",
        "items"
      ]
    },
    {
      "id": "WorkLimit",
      "source": "ValueRefusal",
      "kind": "WorkLimit",
      "message": "refusal-4",
      "path": [
        "scope",
        "items"
      ]
    },
    {
      "id": "DepthLimit",
      "source": "ValueRefusal",
      "kind": "DepthLimit",
      "message": "refusal-5",
      "path": [
        "scope",
        "items"
      ]
    },
    {
      "id": "UnsupportedOwner",
      "source": "ValueRefusal",
      "kind": "UnsupportedOwner",
      "message": "refusal-6",
      "path": [
        "scope",
        "items"
      ]
    },
    {
      "id": "InvariantViolated",
      "source": "ValueRefusal",
      "kind": "InvariantViolated",
      "message": "refusal-7",
      "path": [
        "scope",
        "items"
      ]
    },
    {
      "id": "magic",
      "source": "BadMagic",
      "kind": "InvalidValue"
    },
    {
      "id": "truncated",
      "source": "Truncated",
      "kind": "InvalidValue",
      "offset": 42
    },
    {
      "id": "limit",
      "source": "LimitExceeded",
      "kind": "OwnershipLimit",
      "limit": "too big"
    }
  ],
  "transport": [
    {
      "retry": "Never",
      "transient": false
    },
    {
      "retry": "Transient",
      "transient": true
    }
  ],
  "retirement": { "parentReleasePolicy": "DB_IO_PAGE_BYTES", "deniedExtraBytes": 1, "deniedNewBytes": 0, "deniedReleasedBytes": 0, "preserveOriginal": true },
  "sink": {
    "message": "disk full",
    "preserveOriginalMessageAllocation": true
  }
}
