{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/db/durable-group-journal-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "record", "limits", "lifecycle", "cases", "committedDecisionWitnessCases", "committedRecovery", "nonClaims"],
  "properties": {
    "version": { "const": 1 },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "durability", "document", "decisionSha256", "anchorSha256"],
      "properties": {
        "kind": { "const": "event" },
        "durability": { "const": "fsync" },
        "document": { "type": "string", "minLength": 1, "maxLength": 256 },
        "decisionSha256": { "$ref": "#/$defs/hash" },
        "anchorSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeEventBytes", "walSegmentBytes", "successorHeaderBytes", "storeMaximumTransactionBytes", "storeMaximumSegmentBytes", "maximumEventBytes"],
      "properties": {
        "storeEventBytes": { "const": 491520 },
        "walSegmentBytes": { "const": 507904 },
        "successorHeaderBytes": { "type": "integer", "minimum": 1 },
        "storeMaximumTransactionBytes": { "type": "integer", "minimum": 1 },
        "storeMaximumSegmentBytes": { "type": "integer", "minimum": 1 },
        "maximumEventBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "lifecycle": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["not-submitted", "awaiting", "rejected", "failed", "absent", "committed", "empty"] }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected", "mailboxTransfers", "walTransactions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expected": { "enum": ["committed", "absent", "rejected", "uncertain"] },
          "mailboxTransfers": { "type": "integer", "minimum": 0, "maximum": 1 },
          "walTransactions": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "committedDecisionWitnessCases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recordKinds", "transaction", "replayDocument", "expected"],
        "properties": {
          "id": { "enum": ["one-event", "ordinary-command", "event-plus-command", "two-events", "foreign-document", "aborted-event"] },
          "recordKinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "enum": ["event", "command"] }
          },
          "transaction": { "enum": ["committed", "aborted"] },
          "replayDocument": { "enum": ["matching", "foreign"] },
          "expected": { "enum": ["witness", "ignored", "rejected"] }
        }
      }
    },
    "committedRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "cases"],
      "properties": {
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consumer", "recordEscape", "receiptSource", "cancelAfterCommit", "errorSurface", "terminalHandoff"],
          "properties": {
            "consumer": { "const": "db-wal-witness" },
            "recordEscape": { "const": false },
            "receiptSource": { "const": "derived" },
            "cancelAfterCommit": { "const": false },
            "errorSurface": { "const": "retaining-fault" },
            "terminalHandoff": { "const": "stores-and-ack-once" }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "frontier", "expected", "mutations", "returnedStoreOwners"],
            "properties": {
              "id": { "enum": ["pre-mutation-frontier-rejection", "all-base", "all-post", "mixed-frontier"] },
              "frontier": { "enum": ["foreign", "base", "post", "mixed"] },
              "expected": { "enum": ["fault", "complete", "already-applied"] },
              "mutations": { "type": "integer", "minimum": 0, "maximum": 3 },
              "returnedStoreOwners": { "const": 3 }
            }
          }
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["production-recovery-consumer", "inference-witness", "hub-approval"] }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
