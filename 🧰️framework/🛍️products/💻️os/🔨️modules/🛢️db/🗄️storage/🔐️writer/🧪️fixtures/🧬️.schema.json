{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "capacity", "mutations", "cases", "filesystem", "resultRetirement", "guardRetirement", "backendPressure", "fairRetirement", "maintenanceFairness", "releaseSignal", "controllerBinding", "replication", "controllerFaults"],
  "properties": {
    "schema": { "const": "semio.db.wal-writer-authority/v1" },
    "capacity": { "const": 32 },
    "controllerFaults": { "type": "object", "additionalProperties": false, "required": ["coalesced", "outerPanic"], "properties": { "coalesced": { "const": ["fault-retained", "healthy-terminal", "fault-retry-terminal"] }, "outerPanic": { "const": { "requestedOwners": 2, "executorTurns": 1, "wakesPerOwner": 1, "guardsRetained": true } } } },
    "replication": { "type": "object", "additionalProperties": false, "required": ["occupiedFollower", "inventoryAfterConflict", "releaseAfter", "snapshotTransfer"], "properties": { "occupiedFollower": { "const": "conflict" }, "inventoryAfterConflict": { "const": [] }, "releaseAfter": { "const": ["tail", "up-to-date", "snapshot", "leader-corrupt"] }, "snapshotTransfer": { "type": "object", "additionalProperties": false, "required": ["pattern", "repetitions", "bytes", "owners", "sameOperation"], "properties": { "pattern": { "const": [0, 1, 127, 128, 254, 255] }, "repetitions": { "const": 6000 }, "bytes": { "const": 36000 }, "owners": { "const": ["source-result", "independent-input", "source-terminal", "destination-write", "destination-terminal"] }, "sameOperation": { "const": false } } } } },
    "controllerBinding": {
      "type": "object", "additionalProperties": false, "required": ["operation", "contender", "fenceBeforeCallback", "pinnedResume", "tasksAddedOnRelease", "wakesAtTerminal", "guardFactoryCallsOnConflict", "faultRetryPreservesKey", "maximumStaticBytes"],
      "properties": { "operation": { "const": 7 }, "contender": { "const": 8 }, "fenceBeforeCallback": { "const": "closed" }, "pinnedResume": { "const": "ok" }, "tasksAddedOnRelease": { "const": 0 }, "wakesAtTerminal": { "const": 1 }, "guardFactoryCallsOnConflict": { "const": 0 }, "faultRetryPreservesKey": { "const": true }, "maximumStaticBytes": { "const": 4194304 } }
    },
    "releaseSignal": {
      "type": "object", "additionalProperties": false, "required": ["firstEpoch", "writers", "staleRequestAccepted", "oldWaitSurvivesReuse", "requestCompletesRelease", "maximumEpoch"],
      "properties": { "firstEpoch": { "const": "0" }, "writers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["backendGeneration", "writerGeneration", "terminalEpoch"], "properties": { "backendGeneration": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }, "writerGeneration": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }, "terminalEpoch": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" } } } }, "staleRequestAccepted": { "const": false }, "oldWaitSurvivesReuse": { "const": true }, "requestCompletesRelease": { "const": false }, "maximumEpoch": { "const": "18446744073709551615" } }
    },
    "maintenanceFairness": {
      "type": "object", "additionalProperties": false, "required": ["classes", "continuouslyReady", "firstClassFaults"],
      "properties": { "classes": { "const": ["lost-owner", "page", "platform", "retry", "rejected-backend", "backend-close", "task-close"] }, "continuouslyReady": { "type": "array", "minItems": 14, "maxItems": 14, "items": { "type": "integer", "minimum": 0, "maximum": 6 } }, "firstClassFaults": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "integer", "minimum": 0, "maximum": 6 } } }
    },
    "backendPressure": {
      "type": "object", "additionalProperties": false, "required": ["capacity", "retainedWhenFull", "terminalAfterCapacityReturns"],
      "properties": { "capacity": { "const": 64 }, "retainedWhenFull": { "const": true }, "terminalAfterCapacityReturns": { "const": true } }
    },
    "fairRetirement": {
      "type": "object", "additionalProperties": false, "required": ["pinnedSlot", "releasingSlot", "maximumOpportunities", "pinnedRetained", "releasingRetired"],
      "properties": { "pinnedSlot": { "const": 0 }, "releasingSlot": { "const": 1 }, "maximumOpportunities": { "const": 32 }, "pinnedRetained": { "const": true }, "releasingRetired": { "const": true } }
    },
    "resultRetirement": {
      "type": "object", "additionalProperties": false, "required": ["pages", "terminal"],
      "properties": { "pages": { "const": 2 }, "terminal": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "boolean" } } }
    },
    "guardRetirement": {
      "type": "object", "additionalProperties": false, "required": ["operation", "contender", "stages", "terminal"],
      "properties": {
        "operation": { "const": 7 }, "contender": { "const": 8 },
        "stages": { "const": ["pending-operation", "unlock-error", "unlock-progress", "terminal"] },
        "terminal": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "boolean" } }
      }
    },
    "mutations": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["create", "append", "sync", "seal", "truncate", "delete"] } },
    "cases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "firstGeneration", "steps"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "firstGeneration": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "steps": {
            "type": "array", "minItems": 1, "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["action", "owner", "document", "backend", "expected"],
              "properties": {
                "action": { "enum": ["acquire", "validate", "release"] }, "owner": { "enum": ["a", "b"] },
                "document": { "enum": ["one", "two"] }, "backend": { "enum": [0, 1] },
                "expected": { "enum": ["ok", "conflict", "fenced", "exhausted"] }
              }
            }
          }
        }
      }
    },
    "filesystem": {
      "type": "object", "additionalProperties": false,
      "required": ["sidecar", "independentInstancesConflict", "independentProcessesConflict", "reacquireAfterClose", "unlinkOnClose"],
      "properties": { "sidecar": { "const": ".writer.lock" }, "independentInstancesConflict": { "const": true }, "independentProcessesConflict": { "const": true }, "reacquireAfterClose": { "const": true }, "unlinkOnClose": { "const": false } }
    }
  }
}
