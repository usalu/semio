{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.dev/schema/os/db/document-mount/pool-use/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pool",
          "database",
          "authority",
          "externalUses",
          "databaseActivities",
          "expectedShutdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pool": {
            "enum": [
              "open",
              "stopped"
            ]
          },
          "database": {
            "enum": [
              "absent",
              "open",
              "opening-non-runnable",
              "terminal"
            ]
          },
          "authority": {
            "enum": [
              "empty",
              "ready"
            ]
          },
          "externalUses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "databaseActivities": {
            "enum": [
              "open",
              "closed",
              "blocked"
            ]
          },
          "expectedShutdown": {
            "enum": [
              "busy-1",
              "stopped"
            ]
          }
        }
      }
    }
  }
}
