{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/db/engine/component.json",
  "title": "OS Database Engine Contracts",
  "$defs": {
    "DocumentMountV1": {
      "title": "Document Mount Ownership V1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "capacity", "states", "driver", "driverCases", "cases"],
      "properties": {
        "schema": { "const": "semio.framework.os.db.document-mount/v1" },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["waitersPerDocument", "ownerFuturesPerDocument"],
          "properties": {
            "waitersPerDocument": { "type": "integer", "minimum": 1 },
            "ownerFuturesPerDocument": { "const": 1 }
          }
        },
        "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["vacant", "opening", "ready"] } },
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["states", "maximumQueuedPollers", "resumeRequestsCoalesce"],
          "properties": {
            "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["idle", "queued", "polling", "non-runnable", "terminal"] } },
            "maximumQueuedPollers": { "const": 1 },
            "resumeRequestsCoalesce": { "const": true }
          }
        },
        "driverCases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "steps", "expected"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "steps": { "type": "array", "minItems": 2, "items": { "enum": ["request", "request-resume", "poll-start", "poll-pending", "cleanup-fault", "cleanup-resume", "hard-submit-rejected", "complete"] } },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "maximumQueuedPollers", "cleanupResumes"],
                "properties": {
                  "state": { "enum": ["idle", "queued", "polling", "non-runnable", "terminal"] },
                  "maximumQueuedPollers": { "const": 1 },
                  "cleanupResumes": { "type": "integer", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "steps", "expected"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "steps": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "generation"],
                  "properties": {
                    "action": { "enum": ["install", "join", "cancel-waiter", "catalog-published", "emit-begin", "emit-complete", "fill-waiters", "reject-over-capacity", "release-slot", "shutdown-interrupted", "close-fault", "resume-cleanup", "explicit-retirement-retry", "close-terminal", "prepare-fanout", "unlock-registry", "wake-waiter", "owner-poll-active", "request-drive", "owner-poll-release", "ready", "retry"] },
                    "generation": { "type": "string", "pattern": "^[1-9][0-9]*$" }
                  }
                }
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": ["owners", "actors", "events", "waitersReleased", "terminalBeforeFanout"],
                "properties": {
                  "owners": { "const": 1 },
                  "actors": { "type": "integer", "minimum": 0, "maximum": 1 },
                  "events": { "type": "integer", "minimum": 0, "maximum": 1 },
                  "waitersReleased": { "type": "integer", "minimum": 0 },
                  "terminalBeforeFanout": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "CatalogReadOwnershipV1": {
      "title": "Catalog Read Ownership V1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "root", "transfers", "completion", "recovery"],
      "properties": {
        "schema": { "const": "semio.db.catalog-read-ownership/v1" },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "epoch", "key"],
          "properties": {
            "bytes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
            "epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "transfers": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "phase", "closeBlocked", "admissionRetained", "storageRetained", "submissionsWhileActive", "finalEmpty"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "phase": { "enum": ["Handoff", "RetainWork", "Poll"] },
              "closeBlocked": { "const": true },
              "admissionRetained": { "const": true },
              "storageRetained": { "const": true },
              "submissionsWhileActive": { "const": 0 },
              "finalEmpty": { "const": true }
            }
          }
        },
        "completion": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "publication", "outcome", "admissionDuringPublication", "retirementSubmissions", "lateSubmissions", "terminalEmpty"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "publication": { "enum": ["synchronous", "before-wake", "after-finalizer-check", "refused-finalizer"] },
              "outcome": { "enum": ["pages", "backend-fault"] },
              "admissionDuringPublication": { "type": "boolean" },
              "retirementSubmissions": { "type": "integer", "minimum": 0, "maximum": 1 },
              "lateSubmissions": { "const": 0 },
              "terminalEmpty": { "const": true }
            }
          }
        },
        "recovery": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path", "outcome", "staleRetrySubmissions", "checkoutBlocksRetirement", "terminalEmpty"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "enum": ["retry", "terminal-completion", "terminal-result", "spent-work"] },
              "outcome": { "enum": ["pages", "backend-fault"] },
              "staleRetrySubmissions": { "const": 0 },
              "checkoutBlocksRetirement": { "type": "boolean" },
              "terminalEmpty": { "const": true }
            }
          }
        }
      }
    },
    "HistoryCompletionV1": {
      "title": "History Completion V1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "document", "operations", "publication"],
      "properties": {
        "schema": { "const": "semio.db.history-completion/v1" },
        "document": { "type": "string", "minLength": 1 },
        "operations": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "publication": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "publication", "outcome", "firstReady", "wakes", "waiterEmpty", "exactResult", "admissionReleased", "registryEmpty", "wakeLockReleased"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "publication": { "enum": ["before-poll", "before-registration", "after-pending"] },
              "outcome": { "enum": ["success", "cancelled"] },
              "firstReady": { "type": "boolean" },
              "wakes": { "type": "integer", "minimum": 0, "maximum": 1 },
              "waiterEmpty": { "const": true },
              "exactResult": { "const": true },
              "admissionReleased": { "const": true },
              "registryEmpty": { "const": true },
              "wakeLockReleased": { "const": true }
            }
          }
        }
      }
    },
    "CapabilityCompletionV1": {
      "title": "Capability Completion V1",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "publication", "retirement", "driveOwnership", "leaseCompletion"],
      "properties": {
        "format": { "const": "semio.db.capability-completion/v1" },
        "publication": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "publication", "outcome", "firstReady", "wakes"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "publication": { "enum": ["before-poll", "before-registration", "after-pending"] },
              "outcome": { "enum": ["success", "fault"] },
              "firstReady": { "type": "boolean" },
              "wakes": { "type": "integer", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "retirement": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "outcome", "terminalBeforePublisherWake", "wakes"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["success", "fault"] },
              "terminalBeforePublisherWake": { "type": "boolean" },
              "wakes": { "const": 0 }
            }
          }
        },
        "driveOwnership": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "phase", "closeBlocked", "admissionRetained", "storageRetained", "finalReleases"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "phase": { "enum": ["Handoff", "RetainWork", "Poll"] },
              "closeBlocked": { "const": true },
              "admissionRetained": { "const": true },
              "storageRetained": { "const": true },
              "finalReleases": { "const": 1 }
            }
          }
        },
        "leaseCompletion": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "publication", "admissionDuringPublication", "lateSubmissions", "retirementSubmissions"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "publication": { "enum": ["synchronous", "active-publisher", "after-finalizer-check", "after-finalizer-check-refused"] },
              "admissionDuringPublication": { "type": "boolean" },
              "lateSubmissions": { "const": 0 },
              "retirementSubmissions": { "type": "integer", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "ShutdownV1": {
      "title": "Engine Shutdown V1",
      "type": "object",
      "additionalProperties": false,
      "required": ["phases", "maximumAuthorityStepsPerTurn", "cases"],
      "properties": {
        "phases": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["authority", "versionGraph", "emit", "complete"] } },
        "maximumAuthorityStepsPerTurn": { "const": 1 },
        "cases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "initial", "trace", "expected"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "initial": {
                "type": "object",
                "additionalProperties": false,
                "required": ["authorityOwners", "externalAuthorityOwners", "graphStores"],
                "properties": {
                  "authorityOwners": { "type": "integer", "minimum": 0, "maximum": 1 },
                  "externalAuthorityOwners": { "type": "integer", "minimum": 0, "maximum": 1 },
                  "graphStores": { "type": "integer", "minimum": 0, "maximum": 1 }
                }
              },
              "trace": { "type": "array", "minItems": 1, "items": { "enum": ["advance", "cancel", "retry", "inject-close-error", "release-shared-owner"] } },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": ["terminal", "authorityRetained", "graphRetained", "emitCount"],
                "properties": {
                  "terminal": { "type": "boolean" },
                  "authorityRetained": { "type": "boolean" },
                  "graphRetained": { "type": "boolean" },
                  "emitCount": { "type": "integer", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
