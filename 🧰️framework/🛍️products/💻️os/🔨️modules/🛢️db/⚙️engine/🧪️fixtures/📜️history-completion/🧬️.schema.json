{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "document",
    "operations",
    "publication"
  ],
  "properties": {
    "schema": {
      "const": "semio.db.history-completion/v1"
    },
    "document": {
      "const": "history-completion"
    },
    "operations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "enum": [
          "history-completion-1",
          "history-completion-2"
        ]
      },
      "uniqueItems": true
    },
    "publication": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "publication",
          "outcome",
          "firstReady",
          "wakes",
          "waiterEmpty",
          "exactResult",
          "admissionReleased",
          "registryEmpty",
          "wakeLockReleased"
        ],
        "properties": {
          "name": {
            "enum": [
              "before-poll-success",
              "before-poll-cancelled",
              "before-registration-success",
              "before-registration-cancelled",
              "after-pending-success",
              "after-pending-cancelled"
            ]
          },
          "publication": {
            "enum": [
              "before-poll",
              "before-registration",
              "after-pending"
            ]
          },
          "outcome": {
            "enum": [
              "success",
              "cancelled"
            ]
          },
          "firstReady": {
            "type": "boolean"
          },
          "wakes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "waiterEmpty": {
            "const": true
          },
          "exactResult": {
            "const": true
          },
          "admissionReleased": {
            "const": true
          },
          "registryEmpty": {
            "const": true
          },
          "wakeLockReleased": {
            "const": true
          }
        }
      }
    }
  }
}
