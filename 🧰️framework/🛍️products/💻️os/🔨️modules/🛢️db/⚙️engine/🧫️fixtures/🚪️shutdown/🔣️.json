{
  "phases": ["authority", "emit", "complete"],
  "maximumAuthorityStepsPerTurn": 1,
  "cases": [
    {
      "name": "cancelled authority close retains exact owner for retry",
      "initial": { "authorityOwners": 1, "externalAuthorityOwners": 0 },
      "trace": ["advance", "cancel", "retry", "advance", "advance", "advance"],
      "expected": { "terminal": true, "authorityRetained": true, "emitCount": 1 }
    },
    {
      "name": "cancel before the first step retains the whole authority for the retry",
      "initial": { "authorityOwners": 1, "externalAuthorityOwners": 0 },
      "trace": ["cancel", "retry", "advance", "advance", "advance", "advance"],
      "expected": { "terminal": true, "authorityRetained": true, "emitCount": 1 }
    },
    {
      "name": "shared authority blocks without draining caller owner",
      "initial": { "authorityOwners": 1, "externalAuthorityOwners": 1 },
      "trace": ["advance", "release-shared-owner", "retry", "advance", "advance", "advance", "advance"],
      "expected": { "terminal": true, "authorityRetained": true, "emitCount": 1 }
    },
    {
      "name": "terminal acknowledgement emits exactly once",
      "initial": { "authorityOwners": 0, "externalAuthorityOwners": 0 },
      "trace": ["advance", "advance", "retry"],
      "expected": { "terminal": true, "authorityRetained": false, "emitCount": 1 }
    }
  ]
}
