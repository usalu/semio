{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "callerGrant",
    "laws",
    "scope",
    "metadataTurn",
    "nativeIoDenials"
  ],
  "properties": {
    "contract": {
      "const": "semio.services.compute-retained.v1"
    },
    "callerGrant": {
      "$ref": "https://semio.dev/schema/value/retained-clone/grant"
    },
    "laws": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object"
      }
    },
    "scope": {
      "type": "string"
    },
    "metadataTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant",
        "receipt"
      ],
      "properties": {
        "grant": {
          "$ref": "https://semio.dev/schema/value/retained-clone/grant"
        },
        "receipt": {
          "$ref": "https://semio.dev/schema/value/retained-clone/progress"
        }
      }
    },
    "nativeIoDenials": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "refusal"
        ],
        "properties": {
          "axis": {
            "enum": [
              "items",
              "release",
              "depth"
            ]
          },
          "refusal": {
            "enum": [
              "WorkLimit",
              "OwnershipLimit",
              "DepthLimit"
            ]
          }
        }
      }
    }
  }
}
