{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Compute Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "generation",
    "grant",
    "recipient",
    "completion"
  ],
  "properties": {
    "operation": {
      "type": "integer",
      "minimum": 0
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "grant": {
      "$ref": "semio:retained-grant"
    },
    "completion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "generation"
          ],
          "properties": {
            "operation": {
              "type": "integer",
              "minimum": 0
            },
            "generation": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "generation",
        "progress",
        "remaining"
      ],
      "properties": {
        "operation": {
          "type": "integer",
          "minimum": 0
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "progress": {
          "$ref": "semio:retained-progress"
        },
        "remaining": {
          "$ref": "semio:retained-grant"
        }
      }
    }
  }
}
