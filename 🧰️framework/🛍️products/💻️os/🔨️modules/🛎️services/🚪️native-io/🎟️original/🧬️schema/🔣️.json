{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "owners",
    "denials",
    "expected",
    "extensions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fuel",
        "grant",
        "stepFuel",
        "maximumStepMicroseconds"
      ],
      "properties": {
        "fuel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumCopyBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "stepFuel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximumStepMicroseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "capacity"
        ],
        "properties": {
          "kind": {
            "enum": [
              "started-request-path",
              "filtered-scan-path",
              "missing-modified-path",
              "fault-error-text"
            ]
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        }
      }
    },
    "denials": {
      "type": "array",
      "items": {
        "enum": [
          "items",
          "release",
          "depth"
        ]
      },
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deniedBytes",
        "releasedBytes",
        "sameSource",
        "quoteDoesNotGrant"
      ],
      "properties": {
        "deniedBytes": {
          "const": 0
        },
        "releasedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sameSource": {
          "const": true
        },
        "quoteDoesNotGrant": {
          "const": true
        }
      }
    },
    "extensions": {
      "minItems": 3,
      "items": {
        "required": [
          "ownership",
          "capacity",
          "releasedBytes",
          "releaseGranted",
          "admitted"
        ],
        "properties": {
          "capacity": {
            "minimum": 0,
            "type": "integer"
          },
          "admitted": {
            "type": "boolean"
          },
          "releaseGranted": {
            "minimum": 0,
            "type": "integer"
          },
          "ownership": {
            "enum": [
              "borrowed",
              "owned"
            ]
          },
          "releasedBytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "type": "array"
    }
  }
}