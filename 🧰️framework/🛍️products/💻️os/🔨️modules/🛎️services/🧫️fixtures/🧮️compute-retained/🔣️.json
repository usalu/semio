{
  "contract": "semio.services.compute-retained.v1",
  "callerGrant": {
    "maximumItems": 4096,
    "maximumCopyBytes": 16777216,
    "maximumCapacityBytes": 16777216,
    "maximumReleaseBytes": 16777216,
    "maximumDepth": 64
  },
  "laws": [
    {
      "name": "normal",
      "sameGrant": true,
      "deadlineChanged": false
    },
    {
      "name": "cancel",
      "sameGrant": true,
      "retainsOriginalOnNoProgress": true
    },
    {
      "name": "rejected",
      "sameGrant": true,
      "retainsOriginalOnRefusal": true
    },
    {
      "name": "router-handoff",
      "sameGrant": true,
      "noDemandDerivedAuthority": true
    }
  ],
  "scope": "per-transition; cumulative receipt is observation, not replenished operation authority",
  "nativeIoDenials": [
    {
      "axis": "items",
      "refusal": "WorkLimit"
    },
    {
      "axis": "release",
      "refusal": "OwnershipLimit"
    },
    {
      "axis": "depth",
      "refusal": "DepthLimit"
    }
  ]
}
