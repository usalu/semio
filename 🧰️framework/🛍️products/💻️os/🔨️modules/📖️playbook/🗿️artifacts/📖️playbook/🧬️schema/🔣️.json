{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/playbook/artifacts/playbook/component.json",
  "title": "Playbook Artifact Contracts",
  "$defs": {
    "PackageContractV1": {
      "title": "Playbook Package Contract V1",
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "document", "expectedBlockOrder"],
      "properties": {
        "package": { "const": "semio-framework-artifact-playbook-playbook" },
        "document": {
          "type": "object",
          "required": ["schema", "id", "version", "steps"],
          "properties": {
            "schema": { "const": "playbook.program" },
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "title", "blocks"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "blocks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "label", "kind"],
                      "properties": {
                        "id": { "type": "string", "minLength": 1 },
                        "label": { "type": "string", "minLength": 1 },
                        "kind": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "expectedBlockOrder": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
