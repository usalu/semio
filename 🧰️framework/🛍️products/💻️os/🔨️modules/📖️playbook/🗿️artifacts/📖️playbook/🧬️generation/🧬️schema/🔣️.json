{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/playbook/artifacts/playbook/generation/component.json",
  "title": "Playbook Generation Contracts",
  "$defs": {
    "GenerationRootV1": {
      "title": "Generation Play Root V1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "grants", "generation", "expected"],
      "properties": {
        "schema": { "const": "semio.playbook.generation-root.v1" },
        "grants": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 4096 } },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generations", "selectedGenerationId", "previewText"],
          "properties": {
            "generations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "values"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "values": { "type": "object", "additionalProperties": { "$ref": "#/$defs/GenerationValueV1" } }
                }
              }
            },
            "selectedGenerationId": { "type": "string", "minLength": 1 },
            "previewText": { "type": "string" }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sharesAllocation", "cloneCount", "retirementRootDrops", "liveDropRejected", "unwindDoesNotRecurse", "zeroGrantPreservesOwner"],
          "properties": {
            "sharesAllocation": { "const": true },
            "cloneCount": { "type": "integer", "minimum": 0 },
            "retirementRootDrops": { "const": 1 },
            "liveDropRejected": { "const": true },
            "unwindDoesNotRecurse": { "const": true },
            "zeroGrantPreservesOwner": { "const": true }
          }
        }
      }
    },
    "GenerationValueV1": {
      "title": "Generation Value V1",
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/GenerationValueV1" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/GenerationValueV1" } }
      ]
    }
  }
}
