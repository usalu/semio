{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/os/native-ui-patch-marshalling-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "expectedInstance", "maximumWireBytes", "operationKinds", "componentCases", "cases"],
  "properties": {
    "schema": { "const": "semio.os.native-ui-patch-marshalling.v1" },
    "expectedInstance": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "maximumWireBytes": { "const": 2097152 },
    "operationKinds": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": { "enum": ["upsert", "setComponent", "setLayout", "setActivity", "setChildren", "setStyle", "setAccessibility", "setBindings", "setMenu", "remove", "setRoot"] }
    },
    "componentCases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "config", "first", "second", "root", "channel"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile"],
            "properties": {
              "profile": { "const": "ui" },
              "uiImportSink": { "type": "boolean" },
              "uiReturnWithImport": { "type": "boolean" },
              "uiMalformedFirst": { "type": "boolean" }
            }
          },
          "first": { "enum": ["accepted", "rejected"] },
          "second": { "enum": ["accepted", "rejected"] },
          "root": { "type": ["integer", "null"], "minimum": 1 },
          "channel": { "enum": ["emitted", "returned", "both"] }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "emitted", "returned", "receipt", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "emitted": { "type": "integer", "minimum": 0, "maximum": 2 },
          "returned": { "type": "integer", "minimum": 0, "maximum": 2 },
          "receipt": { "type": "boolean" },
          "expected": { "enum": ["accepted", "rejected"] }
        }
      }
    }
  }
}
