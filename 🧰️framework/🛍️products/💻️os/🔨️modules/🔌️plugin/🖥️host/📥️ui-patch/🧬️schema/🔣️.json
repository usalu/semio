{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/host/ui-patch/component.json",
  "title": "Semio OS Plugin Host Ui Patch",
  "$defs": {
    "UiPatchOperationKind": {
      "enum": [
        "upsert",
        "setComponent",
        "setLayout",
        "setActivity",
        "setChildren",
        "setStyle",
        "setAccessibility",
        "setBindings",
        "setMenu",
        "remove",
        "setRoot"
      ]
    },
    "UiPatchVerdict": {
      "enum": [
        "accepted",
        "rejected"
      ]
    }
  },
  "$ref": "#/$defs/UiPatchOperationKind"
}
