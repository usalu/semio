{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio-tech.com/schema/plugin-host/relay-lifecycle-v1.json",
  "title": "Plugin Host Relay Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capacities", "ingressCases", "traces"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "capacities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mountedRelaySlots", "replaySeedSlots", "replayRefusalSlots", "pageBytes"],
      "properties": {
        "mountedRelaySlots": { "const": 16 },
        "replaySeedSlots": { "const": 256 },
        "replayRefusalSlots": { "const": 512 },
        "pageBytes": { "const": 4096 }
      }
    },
    "ingressCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["🪪️id", "frames", "expectedActors", "maxFramesPerDrive"],
        "properties": {
          "🪪️id": { "type": "string", "minLength": 1 },
          "frames": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor", "lane", "sequence", "fuel"],
              "properties": {
                "actor": { "type": "integer", "minimum": 1 },
                "lane": { "enum": ["interactive", "user-visible", "background", "maintenance"] },
                "sequence": { "type": "integer", "minimum": 1 },
                "fuel": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "expectedActors": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 1 } },
          "maxFramesPerDrive": { "const": 1 }
        }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["🪪️id", "machine", "generation", "initial", "events", "expected", "accounting"],
        "properties": {
          "🪪️id": { "type": "string", "minLength": 1 },
          "machine": { "enum": ["replay", "relay"] },
          "generation": { "type": "integer", "minimum": 1 },
          "initial": { "type": "string", "minLength": 1 },
          "events": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "firstReason", "cancelAdmissions", "releaseOpportunities", "callerOutput"],
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "firstReason": { "type": ["string", "null"] },
              "cancelAdmissions": { "type": "integer", "minimum": 0 },
              "releaseOpportunities": { "type": "integer", "minimum": 0 },
              "callerOutput": { "type": ["string", "null"] }
            }
          },
          "accounting": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seedPagesBefore", "seedPagesAfter", "abiBytesBefore", "abiBytesAfter"],
            "properties": {
              "seedPagesBefore": { "type": "integer", "minimum": 0 },
              "seedPagesAfter": { "type": "integer", "minimum": 0 },
              "abiBytesBefore": { "type": "integer", "minimum": 0 },
              "abiBytesAfter": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
