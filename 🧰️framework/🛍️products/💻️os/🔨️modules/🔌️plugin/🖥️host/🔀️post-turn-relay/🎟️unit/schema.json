{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Unit Donor Custody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "wire",
    "wireBytes",
    "maximumSlices",
    "foreignSourceMayClose",
    "cancelledSourceMayRetire",
    "jobSource"
  ],
  "properties": {
    "value": {
      "type": "string"
    },
    "wire": {
      "type": "string"
    },
    "wireBytes": {
      "type": "integer",
      "minimum": 0
    },
    "maximumSlices": {
      "type": "integer",
      "minimum": 1
    },
    "foreignSourceMayClose": {
      "const": false
    },
    "cancelledSourceMayRetire": {
      "const": true
    },
    "jobSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "kind",
        "input",
        "checkpoint"
      ],
      "properties": {
        "job": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "checkpoint": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
