{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bytes",
    "pages",
    "expectedHex",
    "denied",
    "maximumPayloadBytes",
    "fault"
  ],
  "properties": {
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "bytes"
        ],
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      }
    },
    "expectedHex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "denied": {
      "type": "object",
      "required": [
        "copyBytes",
        "releaseBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "copyBytes": {
          "const": 0
        },
        "releaseBytes": {
          "const": 0
        }
      }
    },
    "maximumPayloadBytes": {
      "type": "integer",
      "minimum": 1
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "receipt",
        "settlement",
        "expectedCauses"
      ],
      "properties": {
        "primary": {
          "const": "invalid-value"
        },
        "receipt": {
          "const": "invariant-violated"
        },
        "settlement": {
          "const": "work-limit"
        },
        "expectedCauses": {
          "const": 3
        }
      }
    }
  }
}
