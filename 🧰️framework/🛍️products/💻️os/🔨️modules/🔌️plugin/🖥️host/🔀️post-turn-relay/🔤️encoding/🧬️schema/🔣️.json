{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "expected",
    "maximumSlices",
    "resumeCapacityBytes",
    "budget",
    "expectedBudget"
  ],
  "properties": {
    "value": {
      "type": "object",
      "required": [
        "bytes",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "expected": {
      "type": "string"
    },
    "maximumSlices": {
      "type": "integer",
      "minimum": 1
    },
    "resumeCapacityBytes": {
      "const": 0
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "retainedPolicy",
        "fuel",
        "deadlineUs",
        "cancelled"
      ],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "generation",
            "epoch",
            "work",
            "grant"
          ],
          "properties": {
            "operation": {
              "type": "integer",
              "minimum": 0
            },
            "generation": {
              "type": "integer",
              "minimum": 0
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "work": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clockBinding",
                "absoluteDeadlineUs",
                "fuel"
              ],
              "properties": {
                "clockBinding": {
                  "type": "integer",
                  "minimum": 0
                },
                "absoluteDeadlineUs": {
                  "type": "integer",
                  "minimum": 0
                },
                "fuel": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "grant": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maximumItems",
                "maximumCopyBytes",
                "maximumCapacityBytes",
                "maximumReleaseBytes",
                "maximumDepth"
              ],
              "properties": {
                "maximumItems": {
                  "type": "integer",
                  "minimum": 0
                },
                "maximumCopyBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "maximumCapacityBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "maximumReleaseBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "maximumDepth": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "retainedPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 0
            },
            "maximumCopyBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "fuel": {
          "type": "integer",
          "minimum": 0
        },
        "deadlineUs": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "boolean"
        }
      }
    },
    "expectedBudget": {
      "type": "string"
    }
  }
}
