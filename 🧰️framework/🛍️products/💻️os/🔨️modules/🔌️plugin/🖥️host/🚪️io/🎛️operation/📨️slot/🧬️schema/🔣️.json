{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/host/io/operation/slot/schema.json",
  "title": "Original Guest Operation Request",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "begin"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "completed",
        "total",
        "owned"
      ],
      "properties": {
        "kind": {
          "const": "progress"
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "owned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bytes",
        "owned",
        "next",
        "maximum"
      ],
      "properties": {
        "kind": {
          "const": "allocation"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "owned": {
          "type": "integer",
          "minimum": 0
        },
        "next": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "allocation",
        "count"
      ],
      "properties": {
        "kind": {
          "const": "reserve-return"
        },
        "allocation": {
          "enum": [
            "bytes",
            "string-bytes",
            "u64-list",
            "ui-patch-list",
            "patch-op-list",
            "effect-list",
            "presence-update-list",
            "string-pair-list"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "owned"
      ],
      "properties": {
        "kind": {
          "const": "finish"
        },
        "owned": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  ]
}
