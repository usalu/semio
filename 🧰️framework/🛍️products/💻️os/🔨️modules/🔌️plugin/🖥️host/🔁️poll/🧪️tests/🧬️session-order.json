{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "order",
    "requiredBefore",
    "escrowExtents"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "escrowExtents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bytes", "rows"],
        "additionalProperties": false,
        "properties": {
          "bytes": { "type": "integer", "minimum": 0 },
          "rows": { "type": ["integer", "null"], "minimum": 0, "maximum": 32 }
        }
      }
    },
    "order": {
      "const": [
        "aggregateOrigins",
        "aggregatePurposes",
        "validateOriginScopes",
        "redeemBootstrapTransition",
        "applyIssuerLedger",
        "commitJournal"
      ]
    },
    "requiredBefore": {
      "const": [
        [
          "aggregateOrigins",
          "aggregatePurposes"
        ],
        [
          "aggregatePurposes",
          "validateOriginScopes"
        ],
        [
          "validateOriginScopes",
          "applyIssuerLedger"
        ],
        [
          "redeemBootstrapTransition",
          "applyIssuerLedger"
        ],
        [
          "applyIssuerLedger",
          "commitJournal"
        ]
      ]
    }
  }
}
