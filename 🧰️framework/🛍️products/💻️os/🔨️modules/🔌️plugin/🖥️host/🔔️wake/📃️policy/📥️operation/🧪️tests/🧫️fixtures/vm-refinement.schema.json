{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "issued", "observed", "performed", "redeemed", "expected"],
    "additionalProperties": false,
    "properties": {
      "name": { "type": "string" },
      "issued": { "$ref": "#/definitions/work" },
      "observed": { "$ref": "#/definitions/work" },
      "performed": { "$ref": "#/definitions/work" },
      "redeemed": { "$ref": "#/definitions/work" },
      "expected": { "anyOf": [{ "$ref": "#/definitions/work" }, { "type": "null" }] }
    }
  },
  "definitions": {
    "work": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
