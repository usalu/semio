{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total",
    "cleanup",
    "transit",
    "hold",
    "cases",
    "purposes"
  ],
  "properties": {
    "total": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cleanup": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "transit": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "hold": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "observed",
          "forfeited",
          "held",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "observed": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "forfeited": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "held": {
            "type": "boolean"
          },
          "expected": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "purposes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic",
        "infrastructure",
        "cases"
      ],
      "properties": {
        "semantic": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "infrastructure": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose",
              "semanticSpent",
              "infrastructureSpent",
              "expectedHeader",
              "expectedScope"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "purpose": {
                "enum": [
                  "semantic",
                  "infrastructure"
                ]
              },
              "semanticSpent": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "infrastructureSpent": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "expectedHeader": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "expectedScope": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
