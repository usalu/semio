{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items", "bytes", "traces", "ownership"],
  "properties": {
    "version": { "const": 1 },
    "items": { "const": 256 },
    "bytes": { "const": 16777216 },
    "traces": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "queued", "retry", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "queued": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[AB][12]$" } },
          "retry": { "const": "A1" },
          "expected": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[AB][12]$" } }
        }
      }
    },
    "ownership": {
      "type": "object", "additionalProperties": false,
      "required": ["sameRegistration", "sameBudget", "sameBytes", "cancelRevokes", "replacementRefused"],
      "properties": {
        "sameRegistration": { "const": true }, "sameBudget": { "const": true }, "sameBytes": { "const": true }, "cancelRevokes": { "const": true }, "replacementRefused": { "const": true }
      }
    }
  }
}
