        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scheduledFuel": {
      "type": "integer",
