{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "actorRetained", "instantiations", "drops", "admitted"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "enum": ["record", "quarantine", "shard", "instantiate", "register", "complete"] },
          "actorRetained": { "type": "boolean" },
          "instantiations": { "type": "integer", "minimum": 0, "maximum": 1 },
          "drops": { "type": "integer", "minimum": 0, "maximum": 1 },
          "admitted": { "type": "boolean" }
        }
      }
    }
  }
}
