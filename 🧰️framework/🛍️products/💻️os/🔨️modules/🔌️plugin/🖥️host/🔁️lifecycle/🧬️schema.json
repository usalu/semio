{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "code", "maximumFaultBytes", "cases"],
  "properties": {
    "version": {
      "const": 1
    },
    "code": {
      "const": "plugin.reactor-turn-deadline"
    },
    "maximumFaultBytes": {
      "const": 65536
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "retryable", "events", "eligible"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "events": {
            "type": "array",
            "items": {
              "enum": ["open", "close", "ack", "wake", "page"]
            }
          },
          "eligible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
