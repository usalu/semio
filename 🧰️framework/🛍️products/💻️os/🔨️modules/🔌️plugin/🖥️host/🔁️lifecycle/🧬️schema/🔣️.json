{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/host/lifecycle/component.json",
  "title": "Semio OS Plugin Host Lifecycle",
  "$defs": {
    "ReactorFaultCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
    },
    "ReactorLifecycleEvent": {
      "enum": [
        "open",
        "close",
        "ack",
        "wake",
        "page"
      ]
    }
  },
  "$ref": "#/$defs/ReactorFaultCode"
}
