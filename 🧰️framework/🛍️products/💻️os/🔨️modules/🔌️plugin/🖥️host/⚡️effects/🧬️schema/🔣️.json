{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources",
    "grant",
    "expectedDropReleaseBytes",
    "wrapper",
    "recordingLeases",
    "driveGrant",
    "identityPolicy"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "capacity"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "const": 1
        },
        "maximumCopyBytes": {
          "const": 65536
        },
        "maximumCapacityBytes": {
          "const": 0
        },
        "maximumReleaseBytes": {
          "const": 1048576
        },
        "maximumDepth": {
          "const": 8
        }
      }
    },
    "expectedDropReleaseBytes": {
      "const": 0
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separateTerminalFrame",
        "normalFactoryBirthQualified",
        "maximumTurns"
      ],
      "properties": {
        "separateTerminalFrame": {
          "const": true
        },
        "normalFactoryBirthQualified": {
          "const": false
        },
        "maximumTurns": {
          "const": 16
        }
      }
    },
    "recordingLeases": {
      "const": [
        "unique",
        "alias",
        "weak"
      ]
    },
    "driveGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "const": 1
        },
        "maximumCopyBytes": {
          "const": 65536
        },
        "maximumCapacityBytes": {
          "const": 65536
        },
        "maximumReleaseBytes": {
          "const": 1048576
        },
        "maximumDepth": {
          "const": 64
        }
      }
    },
    "identityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumBytes",
        "grant"
      ],
      "properties": {
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 0
            },
            "maximumCopyBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
