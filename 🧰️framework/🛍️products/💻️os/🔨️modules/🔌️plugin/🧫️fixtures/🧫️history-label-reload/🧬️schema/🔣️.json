{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/plugin/history-label-reload.fixture.json",
  "title": "PluginHistoryLabelReloadFixture",
  "description": "History row labels over the authoring verb, the app's description and the leaf labels of the edit's operations: the app's declared verbs with their labels, and per command the verb it dispatches under, its description, its operations' leaf labels and the row label every replica and every reload shows in English and German.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "note", "registry", "cases"],
  "$defs": {
    "label": {
      "description": "One label in English and German.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
    },
    "verb": {
      "description": "A locale-neutral action or command id, never display text.",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string", "minLength": 1 },
    "registry": {
      "description": "The verbs the app declares, with their registry labels.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verb", "label"],
        "properties": { "verb": { "$ref": "#/$defs/verb" }, "label": { "$ref": "#/$defs/label" } }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "verb", "description", "leaves", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": {
            "description": "The command the fixture app dispatches.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": { "kind": { "enum": ["rename", "retitle", "reset", "count", "pair"] }, "value": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } }
          },
          "verb": { "$ref": "#/$defs/verb" },
          "description": { "description": "The app's description of the edit, or null.", "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "leaves": { "description": "The leaf label of each operation the command emits, in order.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/label" } },
          "expected": { "$ref": "#/$defs/label" }
        }
      }
    }
  }
}
