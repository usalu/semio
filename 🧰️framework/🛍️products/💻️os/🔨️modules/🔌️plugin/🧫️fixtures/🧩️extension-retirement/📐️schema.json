{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allocationAdmission",
    "actorAllocation",
    "dropBoundary",
    "resource",
    "capability",
    "request",
    "zeroGrants",
    "grant",
    "handlerGrant",
    "replacementSlots",
    "faults",
    "resourceBytes",
    "metadata",
    "lifecycle",
    "controls",
    "nonClosingChanges"
  ],
  "properties": {
    "actorAllocation": {
      "type": "object", "additionalProperties": false,
      "required": ["smallBytes", "stringBytes", "adequateBytes"],
      "properties": {
        "smallBytes": { "const": 65536 },
        "stringBytes": { "const": 131072 },
        "adequateBytes": { "const": 2097152 }
      }
    },
    "allocationAdmission": {
      "type": "object", "additionalProperties": false,
      "required": ["tinyBytes", "vectorCapacity", "podWidth", "stringCapacity", "ownerPaddingBytes"],
      "properties": {
        "tinyBytes": { "const": 1 },
        "vectorCapacity": { "const": 257 },
        "podWidth": { "const": 8 },
        "stringCapacity": { "const": 1024 },
        "ownerPaddingBytes": { "const": 4096 }
      }
    },
    "dropBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["liveOwnerDrops", "terminalOwnerDrops", "fault"],
      "properties": {
        "liveOwnerDrops": { "const": 0 },
        "terminalOwnerDrops": { "const": 1 },
        "fault": { "const": "extension bundle requires terminal-empty retirement before drop" }
      }
    },
    "resource": {
      "type": "string"
    },
    "resourceBytes": {
      "type": "integer",
      "minimum": 1
    },
    "capability": {
      "type": "string"
    },
    "request": {
      "type": "string"
    },
    "zeroGrants": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/grant"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "grant": {
      "$ref": "#/definitions/grant"
    },
    "handlerGrant": {
      "$ref": "#/definitions/grant"
    },
    "replacementSlots": {
      "const": 1
    },
    "faults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sealed",
        "exceeded",
        "falseComplete"
      ],
      "properties": {
        "sealed": {
          "const": "extension.closing"
        },
        "exceeded": {
          "const": "extension.close-budget"
        },
        "falseComplete": {
          "const": "extension.close-live-owner"
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "lifecycle": {
      "const": [
        "open",
        "sealed",
        "paused",
        "retiring",
        "terminal"
      ]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancel",
        "resume"
      ],
      "properties": {
        "cancel": {
          "const": "extension.close.cancel"
        },
        "resume": {
          "const": "extension.close.resume"
        }
      }
    },
    "nonClosingChanges": {
      "const": [
        "granted",
        "narrowed",
        "revoked",
        "quotaChanged"
      ]
    }
  },
  "definitions": {
    "grant": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
