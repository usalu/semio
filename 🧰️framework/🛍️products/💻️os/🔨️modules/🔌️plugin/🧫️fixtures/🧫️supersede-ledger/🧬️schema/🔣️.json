{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/plugin/supersede-ledger.fixture.json",
  "title": "PluginSupersedeLedgerFixture",
  "description": "The classification of a document's `Supersede` history transitions (ticket 26/09/30/NON-DESTRUCTIVE-HISTORY-EDITING design §2: history edits are history, the undo of a finalize is a new Supersede carrying the previous effective input, its redo re-authors the edit). Each case lists original inputs and transitions (fold order is `(at, id)`); the Rust `SupersedeLedger` and its TypeScript twin must reach the expected roles, the history edits in effect for the final alternative, which rows read as applied, every history edit each author may undo with the restore it authors, and each author's next redo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "note", "cases"],
  "$defs": {
    "input": { "description": "An input replacement: its payload text, or null for a withdrawal.", "type": ["string", "null"] },
    "supersededInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "input"],
      "properties": { "target": { "type": "string", "minLength": 1 }, "input": { "$ref": "#/$defs/input" } }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "at", "scope", "inputs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "at": { "type": "integer", "minimum": 0 },
        "scope": { "type": ["string", "null"] },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/supersededInput" } }
      }
    },
    "role": { "enum": ["edit", "undo", "redo"] },
    "authored": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "inputs"],
      "properties": { "scope": { "type": ["string", "null"] }, "inputs": { "type": "array", "items": { "$ref": "#/$defs/supersededInput" } } }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "finalAlternative", "originals", "transitions", "records", "applied", "rowsApplied", "undo", "redo"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "finalAlternative": { "type": ["string", "null"] },
        "originals": { "type": "object", "additionalProperties": { "type": "string" } },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "entry"],
            "properties": { "id": { "type": "string" }, "role": { "$ref": "#/$defs/role" }, "entry": { "type": "string" } }
          }
        },
        "applied": { "type": "array", "items": { "type": "string" } },
        "rowsApplied": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "undo": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor", "entry", "restore"],
            "properties": { "actor": { "type": "string" }, "entry": { "type": "string" }, "restore": { "$ref": "#/$defs/authored" } }
          }
        },
        "redo": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["entry", "undo", "redo"],
                "properties": { "entry": { "type": "string" }, "undo": { "type": "string" }, "redo": { "$ref": "#/$defs/authored" } }
              }
            ]
          }
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  }
}
