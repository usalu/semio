{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/plugin/time-travel.fixture.json",
  "title": "PluginTimeTravelFixture",
  "description": "History-edit scenarios over a seeded four-edit toy document: the verbs each scenario dispatches, the session status it ends in (absent = inactive), the body the renderer reads, and the mutations it leaves pending, superseded or withdrawn. The Rust plugin runtime runs every scenario live; the TypeScript oracle runs the same steps through the independent time-travel reducer twin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "note", "actor", "seed", "committedBody", "scenarios", "refusals"],
  "$defs": {
    "seedOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": { "kind": { "enum": ["setCount", "setLabel", "setSlotChildren"] }, "value": {} }
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "begin": { "type": "integer", "minimum": 0 },
        "input": { "type": "object", "additionalProperties": false, "required": ["path", "value"], "properties": { "path": { "type": "string", "pattern": "^/" }, "value": {} } },
        "withdraw": { "type": "null" },
        "accept": { "type": "null" },
        "discard": { "type": "null" },
        "replay": { "enum": ["clean", "fatal"] },
        "finalize": { "type": "null" },
        "commit": { "type": "object", "additionalProperties": false, "properties": { "choice": { "const": "overwrite" }, "name": { "type": "string", "minLength": 1 } } },
        "exit": { "type": "null" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "blocking", "acceptedCount"],
      "properties": {
        "stage": { "enum": ["editing", "replaying", "reviewing", "choosing", "finalizing"] },
        "blocking": { "type": "boolean" },
        "acceptedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
  },
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "seed": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/seedOp" } },
    "committedBody": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps", "status", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
          "status": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/status" }] },
          "body": { "type": "string" },
          "finalizeRefusal": { "oneOf": [{ "type": "null" }, { "enum": ["timeTravel.illegal", "timeTravel.blocked", "timeTravel.empty"] }] },
          "pending": { "$ref": "#/$defs/indices" },
          "superseded": { "$ref": "#/$defs/indices" },
          "withdrawn": { "$ref": "#/$defs/indices" },
          "alternative": { "type": "string" }
        }
      }
    },
    "refusals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen", "frozenVerbs", "stale", "invalidInput", "invalidInputValue", "schemaUnavailable"],
      "properties": {
        "frozen": { "const": "timeTravel.frozen" },
        "frozenVerbs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "stale": { "const": "timeTravel.stale" },
        "invalidInput": { "const": "timeTravel.invalid-input" },
        "schemaUnavailable": { "const": "timeTravel.schema-unavailable" },
        "invalidInputValue": {}
      }
    }
  }
}
