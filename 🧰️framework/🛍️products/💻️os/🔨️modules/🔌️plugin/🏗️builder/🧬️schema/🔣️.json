{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/builder/component.json",
  "title": "Semio OS Plugin Builder",
  "$defs": {
    "BuilderArtifactKind": {
      "type": "string",
      "pattern": "^s\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "BuilderContractId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*/v[0-9]+$"
    },
    "BuilderPackageId": {
      "type": "string",
      "pattern": "^semio:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "BuilderPluginId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "$ref": "#/$defs/BuilderArtifactKind"
}
