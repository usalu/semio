{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/plugin/builder/dependency-contribution/keyword-tests.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "delta",
      "text"
    ],
    "properties": {
      "delta": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "text": {
        "type": "string",
        "pattern": "^add-value delta=-?(0|[1-9][0-9]*)$"
      }
    }
  }
}
