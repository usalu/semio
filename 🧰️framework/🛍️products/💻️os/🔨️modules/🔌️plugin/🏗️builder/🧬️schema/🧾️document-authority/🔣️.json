{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["pluginId", "ownerPluginId", "scope", "dependencies"],
  "properties": {
    "pluginId": { "type": "string", "minLength": 1 },
    "ownerPluginId": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
