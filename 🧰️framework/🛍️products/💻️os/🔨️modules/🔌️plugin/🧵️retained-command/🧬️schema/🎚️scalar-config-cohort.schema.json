{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.tool-job.scalar-config-cohort.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "textMaximumBytes",
    "grantBytes",
    "owners",
    "sources",
    "mutations"
  ],
  "properties": {
    "schema": {
      "const": "semio.tool-job.scalar-config-cohort.v1"
    },
    "textMaximumBytes": {
      "const": 128
    },
    "grantBytes": {
      "const": 4096
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owners": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/owner"
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/definitions/mutation"
      }
    }
  },
  "definitions": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "disposition",
        "lanes",
        "blocker"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "Migrated",
            "BatchOnlyPendingRewrite",
            "ForbiddenFromUi"
          ]
        },
        "lanes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Config",
              "HostOnly"
            ]
          }
        },
        "blocker": {
          "type": "string"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "prefix",
        "routes"
      ],
      "properties": {
        "id": {
          "enum": [
            "fem2d",
            "generation2d",
            "layout"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Z0-9]+$"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/route"
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "base",
        "changes",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "enum": [
            "fem2d",
            "generation2d",
            "layout"
          ]
        },
        "base": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/value"
          }
        },
        "changes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/value"
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/value"
          }
        }
      }
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    }
  }
}
