{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/retained-command/component.json",
  "title": "Semio OS Plugin Retained Command",
  "$defs": {
    "ArtifactCommandCheckpointWorkState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "array",
              "maxItems": 465,
              "items": {
                "$ref": "#/$defs/RetainedCommandByte"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "fill",
            "length"
          ],
          "additionalProperties": false,
          "properties": {
            "fill": {
              "$ref": "#/$defs/RetainedCommandByte"
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 465
            }
          }
        }
      ]
    },
    "RetainedCommandByte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "RetainedCommandContractId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*[./]v[0-9]+$"
    },
    "RetainedCommandCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ScalarConfigValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    "ToolControllerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ToolLatestWinsScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance",
        "document",
        "controller",
        "tool",
        "target"
      ],
      "properties": {
        "instance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "$ref": "#/$defs/ToolControllerId"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ToolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ArtifactToolPublicationLane": {
      "$comment": "Canonical retained-command publication lanes, one PascalCase member per ArtifactToolPublicationLane runtime variant. Owners narrow this closed vocabulary with const or enum.",
      "enum": [
        "HostOnly",
        "Artifact",
        "Config",
        "Draft",
        "Presence",
        "Transient",
        "WindowConfig",
        "WindowTransient",
        "Child",
        "Interaction"
      ]
    },
    "InteractiveJobClassification": {
      "$comment": "Canonical retained-command proof classifications, one PascalCase member per InteractiveJobClassification runtime variant.",
      "enum": [
        "Unclassified",
        "Migrated",
        "BatchOnlyPendingRewrite",
        "ForbiddenFromUi",
        "Deleted"
      ]
    },
    "RetainedCommandAdmissionOutcome": {
      "$comment": "Admission outcomes that are decisions rather than InteractiveJobClassification variants.",
      "enum": [
        "FailClosed"
      ]
    },
    "RetainedCommandAdmission": {
      "oneOf": [
        {
          "$ref": "#/$defs/InteractiveJobClassification"
        },
        {
          "$ref": "#/$defs/RetainedCommandAdmissionOutcome"
        }
      ]
    },
    "RetainedCommandExecution": {
      "enum": [
        "bounded-first-step",
        "bounded",
        "batch",
        "resumable"
      ]
    },
    "RetainedCommandByteBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawBytes",
        "checkpointBytes",
        "configValueBytes",
        "configBaseBytes",
        "commandStepBytes",
        "storeStepBytes",
        "workItems",
        "preparationPhases"
      ],
      "properties": {
        "rawBytes": {
          "type": "integer",
          "minimum": 0
        },
        "checkpointBytes": {
          "type": "integer",
          "minimum": 0
        },
        "configValueBytes": {
          "type": "integer",
          "minimum": 0
        },
        "configBaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "commandStepBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storeStepBytes": {
          "type": "integer",
          "minimum": 0
        },
        "workItems": {
          "type": "integer",
          "minimum": 0
        },
        "preparationPhases": {
          "type": "integer",
          "minimum": 0
        },
        "artifactStoreBytes": {
          "type": "integer",
          "minimum": 0
        },
        "decodedItems": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RetainedCommandStepBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRawBytes",
        "maxDecodedItems",
        "maxWorkUnitsPerStep",
        "maxOutputBytes",
        "maxStepMicros"
      ],
      "properties": {
        "maxRawBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxDecodedItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxWorkUnitsPerStep": {
          "type": "integer",
          "minimum": 0
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxStepMicros": {
          "type": "integer",
          "minimum": 0
        },
        "maxCheckpointBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxInFlightPages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RetainedCommandClassBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded"
      ],
      "properties": {
        "bounded": {
          "$ref": "#/$defs/RetainedCommandStepBudget"
        },
        "resumable": {
          "$ref": "#/$defs/RetainedCommandStepBudget"
        }
      }
    },
    "RetainedCommandPublicationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolId",
        "lanes"
      ],
      "properties": {
        "toolId": {
          "type": "string",
          "minLength": 1
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ArtifactToolPublicationLane"
          }
        }
      }
    },
    "RetainedCommandRouteDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "disposition",
        "lanes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "$ref": "#/$defs/InteractiveJobClassification"
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactToolPublicationLane"
          }
        },
        "blocker": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "RetainedCommandRouteExecutionLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "execution",
        "lanes",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "$ref": "#/$defs/RetainedCommandExecution"
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ArtifactToolPublicationLane"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RetainedCommandRouteExecutionFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "execution",
        "feature"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "$ref": "#/$defs/RetainedCommandExecution"
        },
        "admission": {
          "$ref": "#/$defs/RetainedCommandAdmission"
        },
        "status": {
          "$ref": "#/$defs/InteractiveJobClassification"
        },
        "feature": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RetainedCommandRouteVariant": {
      "oneOf": [
        {
          "$ref": "#/$defs/RetainedCommandRouteDisposition"
        },
        {
          "$ref": "#/$defs/RetainedCommandRouteExecutionLane"
        },
        {
          "$ref": "#/$defs/RetainedCommandRouteExecutionFeature"
        }
      ]
    },
    "RetainedCommandCohortFactory": {
      "$comment": "The one shared command-job factory a cohort of sibling apps publishes through — an object, unlike RetainedCommandDeclaredLimits' single factory string.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "payloadSchema": {
          "type": "string",
          "minLength": 1
        },
        "maximumRawBytes": {
          "type": "integer",
          "minimum": 0
        },
        "shared": {
          "type": "boolean"
        }
      }
    },
    "RetainedCommandCohortRoute": {
      "$comment": "A cohort route separates the lanes a route EMITS from the lanes its publication contract declares; the three RetainedCommandRoute dialects collapse both into one `lanes` array.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "emittedLanes",
        "publicationLanes",
        "execution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "emittedLanes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ArtifactToolPublicationLane"
          }
        },
        "publicationLanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ArtifactToolPublicationLane"
          }
        },
        "execution": {
          "$ref": "#/$defs/RetainedCommandExecution"
        },
        "admission": {
          "$ref": "#/$defs/RetainedCommandAdmission"
        },
        "reducer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RetainedCommandCohortApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "controller",
        "documentSchema"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "type": "string",
          "minLength": 1
        },
        "documentSchema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RetainedCommandRoute": {
      "$comment": "One route row, published so an owner can narrow a single route positionally without reaching into definitions.",
      "$ref": "#/$defs/RetainedCommandRouteVariant"
    },
    "RetainedCommandRoutes": {
      "$comment": "Shared shape for retained-command route tables, standalone or nested in RetainedCommandLimits.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RetainedCommandRoute"
      }
    },
    "RetainedCommandRoutesDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "routes"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "$ref": "#/$defs/RetainedCommandRoutes"
        },
        "maximumRawBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumWorkItems": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RetainedCommandBudget": {
      "oneOf": [
        {
          "$ref": "#/$defs/RetainedCommandByteBudget"
        },
        {
          "$ref": "#/$defs/RetainedCommandClassBudget"
        }
      ]
    }
  },
  "$ref": "#/$defs/RetainedCommandBudget"
}
