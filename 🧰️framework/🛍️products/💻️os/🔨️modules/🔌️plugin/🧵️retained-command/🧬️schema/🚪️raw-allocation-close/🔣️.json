{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "maximumItems",
    "maximumCopyBytes",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "retained-command-raw-allocation-close/v2"
    },
    "maximumItems": {
      "const": 1
    },
    "maximumCopyBytes": {
      "const": 4096
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capacity",
          "initializedBytes",
          "expectedCopiedBytes",
          "expectedReleasedBytes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          },
          "initializedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "expectedCopiedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "expectedReleasedBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
