{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.artifact.retained-command.metadata-retirement.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "cases",
    "required"
  ],
  "properties": {
    "contract": {
      "const": "semio.artifact.retained-command.metadata-retirement.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "text",
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "required": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zeroGrant",
        "physicalReceipt",
        "terminalDropBytes"
      ],
      "properties": {
        "zeroGrant": {
          "const": "unchanged"
        },
        "physicalReceipt": {
          "const": "exact"
        },
        "terminalDropBytes": {
          "const": 0
        }
      }
    }
  }
}
