{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.os.plugin.source-watch-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "includes",
    "excludes",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "semio.framework.os.plugin.source-watch-plan/v1"
    },
    "includes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32768,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "excludes": {
      "type": "array",
      "maxItems": 32768,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "files": {
      "type": "array",
      "maxItems": 32768,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    }
  }
}
