{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/browser-bundle/patch-handoff/component.json",
  "definitions": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "receipt": {
      "type": "array",
      "minItems": 4,
      "maxItems": 35,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "baseRevision",
        "revision",
        "ops"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "ops": {
          "type": "array",
          "maxItems": 4096
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope",
        "verifiedSurfaceId",
        "activationGeneration",
        "instanceId",
        "patches",
        "receipt"
      ],
      "properties": {
        "kind": {
          "const": "browser-actor-ui-patch"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "verifiedSurfaceId": {
          "const": "s.gis.gismap@1/viewer"
        },
        "activationGeneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0
        },
        "patches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/patch"
          }
        },
        "receipt": {
          "$ref": "#/definitions/receipt"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope",
        "verifiedSurfaceId",
        "activationGeneration",
        "instanceId",
        "receipt",
        "verdicts"
      ],
      "properties": {
        "kind": {
          "const": "browser-actor-ui-patch-result"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "verifiedSurfaceId": {
          "type": "string",
          "minLength": 1
        },
        "activationGeneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0
        },
        "receipt": {
          "$ref": "#/definitions/receipt"
        },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/verdict"
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "outcome",
        "revision"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "enum": [
            "acknowledged",
            "rejected"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    }
  }
}
