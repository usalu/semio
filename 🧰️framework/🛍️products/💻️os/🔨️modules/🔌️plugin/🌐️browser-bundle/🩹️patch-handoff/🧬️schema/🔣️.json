{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/browser-bundle/patch-handoff/component.json",
  "$ref": "#/$defs/BrowserActorPatchHandoffV1",
  "$defs": {
    "BrowserActorPatchHandoffV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offer",
        "acknowledged",
        "rejected",
        "hostileResults",
        "hostileOffers",
        "wireSetChildren"
      ],
      "properties": {
        "offer": {
          "$ref": "#/definitions/offer"
        },
        "acknowledged": {
          "$ref": "#/definitions/result"
        },
        "rejected": {
          "$ref": "#/definitions/result"
        },
        "hostileResults": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/definitions/result"
          }
        },
        "hostileOffers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "patches"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "patches": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/patch"
                }
              }
            }
          }
        },
        "wireSetChildren": {
          "description": "One guest `set-children` op as the component boundary lifts it (`list<node-id>` = `list<u64>` → `BigUint64Array`) and the canonical op it decodes to.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lift",
            "surface",
            "node",
            "children"
          ],
          "properties": {
            "lift": {
              "const": "BigUint64Array"
            },
            "surface": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "node": {
              "type": "integer",
              "minimum": 0
            },
            "children": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "receipt": {
      "type": "array",
      "minItems": 4,
      "maxItems": 35,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "baseRevision",
        "revision",
        "ops"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "ops": {
          "type": "array",
          "maxItems": 4096
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope",
        "verifiedSurfaceId",
        "activationGeneration",
        "instanceId",
        "patches",
        "receipt"
      ],
      "properties": {
        "kind": {
          "const": "browser-actor-ui-patch"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "verifiedSurfaceId": {
          "const": "s.gis.gismap@1/viewer"
        },
        "activationGeneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0
        },
        "patches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/patch"
          }
        },
        "receipt": {
          "$ref": "#/definitions/receipt"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope",
        "verifiedSurfaceId",
        "activationGeneration",
        "instanceId",
        "receipt",
        "verdicts"
      ],
      "properties": {
        "kind": {
          "const": "browser-actor-ui-patch-result"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "verifiedSurfaceId": {
          "type": "string",
          "minLength": 1
        },
        "activationGeneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0
        },
        "receipt": {
          "$ref": "#/definitions/receipt"
        },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/verdict"
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "outcome",
        "revision"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "enum": [
            "acknowledged",
            "rejected"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    }
  }
}
