{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/plugin/browser-bundle/action-handoff/component.json",
  "$ref": "#/$defs/BrowserActorActionHandoffV1",
  "$defs": {
    "BrowserActorActionHandoffV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "acknowledged",
        "rejected",
        "hostileResults",
        "uiIntent",
        "commandRequest",
        "actionInvocation",
        "commandInvocation",
        "commandViewState",
        "publication"
      ],
      "properties": {
        "request": {
          "$ref": "#/definitions/request"
        },
        "acknowledged": {
          "$ref": "#/definitions/result"
        },
        "rejected": {
          "$ref": "#/definitions/result"
        },
        "hostileResults": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/definitions/result"
          }
        },
        "uiIntent": {
          "$ref": "#/definitions/uiIntent"
        },
        "commandRequest": {
          "$ref": "#/definitions/request"
        },
        "actionInvocation": {
          "$ref": "#/definitions/actionInvocation"
        },
        "commandInvocation": {
          "$ref": "#/definitions/commandInvocation"
        },
        "commandViewState": {
          "type": "object",
          "minProperties": 1
        },
        "publication": {
          "$ref": "#/definitions/publication"
        }
      }
    }
  },
  "definitions": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "bytes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 262144,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "owner": {
      "type": "object",
      "required": [
        "scope",
        "verifiedSurfaceId",
        "appChannelVersion",
        "activationGeneration",
        "instanceId",
        "surfaceRevision",
        "actionSequence"
      ],
      "properties": {
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "verifiedSurfaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "appChannelVersion": {
          "const": 15
        },
        "activationGeneration": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "surfaceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actionSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bytes"
          ],
          "properties": {
            "kind": {
              "const": "ui-intent"
            },
            "bytes": {
              "$ref": "#/definitions/bytes"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bytes"
          ],
          "properties": {
            "kind": {
              "const": "app-command"
            },
            "bytes": {
              "$ref": "#/definitions/bytes"
            }
          }
        }
      ]
    },
    "request": {
      "allOf": [
        {
          "$ref": "#/definitions/owner"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "verifiedSurfaceId",
            "appChannelVersion",
            "activationGeneration",
            "instanceId",
            "surfaceRevision",
            "actionSequence",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "browser-actor-action"
            },
            "scope": {
              "$ref": "#/definitions/scope"
            },
            "verifiedSurfaceId": {
              "type": "string"
            },
            "appChannelVersion": {
              "const": 15
            },
            "activationGeneration": {
              "type": "string"
            },
            "instanceId": {
              "type": "integer"
            },
            "surfaceRevision": {
              "type": "integer"
            },
            "actionSequence": {
              "type": "integer"
            },
            "payload": {
              "$ref": "#/definitions/payload"
            }
          }
        }
      ]
    },
    "actionInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "arguments"
      ],
      "properties": {
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pluginId",
            "appId",
            "modeId",
            "windowKindId",
            "windowInstanceId",
            "actionId"
          ],
          "properties": {
            "pluginId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "appId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "modeId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "windowKindId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "windowInstanceId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "actionId": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "commandInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "arguments"
      ],
      "properties": {
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "commandId"
          ],
          "properties": {
            "owner": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "app"
              ],
              "properties": {
                "app": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pluginId",
                    "appId"
                  ],
                  "properties": {
                    "pluginId": { "type": "string", "minLength": 1, "maxLength": 256 },
                    "appId": { "type": "string", "minLength": 1, "maxLength": 256 }
                  }
                }
              }
            },
            "commandId": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "result": {
      "allOf": [
        {
          "$ref": "#/definitions/owner"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "verifiedSurfaceId",
            "appChannelVersion",
            "activationGeneration",
            "instanceId",
            "surfaceRevision",
            "actionSequence",
            "outcome",
            "mutationCount",
            "hostEffects"
          ],
          "properties": {
            "kind": {
              "const": "browser-actor-action-result"
            },
            "scope": {
              "$ref": "#/definitions/scope"
            },
            "verifiedSurfaceId": {
              "type": "string"
            },
            "appChannelVersion": {
              "const": 15
            },
            "activationGeneration": {
              "type": "string"
            },
            "instanceId": {
              "type": "integer"
            },
            "surfaceRevision": {
              "type": "integer"
            },
            "actionSequence": {
              "type": "integer"
            },
            "outcome": {
              "enum": [
                "guest-applied",
                "rejected"
              ]
            },
            "mutationCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "hostEffects": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "$ref": "#/definitions/bytes"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "rejected"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "hostEffects": {
                    "type": "array",
                    "maxItems": 0
                  }
                },
                "required": [
                  "reason"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "reason"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "uiIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "revision",
        "node",
        "nodeKey",
        "trigger",
        "action",
        "args",
        "input",
        "seq"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nodeKey": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "enum": [
            "activate",
            "change",
            "commit",
            "delta",
            "drop",
            "submit",
            "abort",
            "repeatLast",
            "hoverPreview"
          ]
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "name",
            "version"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "args": {},
        "input": {},
        "seq": {
          "type": "string",
          "pattern": "^(?:0|(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615))$"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emit",
        "error",
        "hostEffect",
        "projectedEffect",
        "externalHostEffect",
        "externalProjectedEffect"
      ],
      "properties": {
        "emit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Emit"
          ],
          "properties": {
            "Emit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "in_reply_to",
                "document_ops",
                "config_ops",
                "draft_ops",
                "output",
                "diagnostics"
              ],
              "properties": {
                "in_reply_to": {
                  "const": 0
                },
                "document_ops": {
                  "type": "array",
                  "maxItems": 262144,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "config_ops": {
                  "type": "array",
                  "maxItems": 262144,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "draft_ops": {
                  "type": "array",
                  "maxItems": 262144,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "output": {
                  "type": "array",
                  "maxItems": 262144,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "diagnostics": {
                  "type": "array",
                  "maxItems": 262144,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Error"
          ],
          "properties": {
            "Error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "in_reply_to",
                "fault",
                "report"
              ],
              "properties": {
                "in_reply_to": {
                  "const": null
                },
                "fault": {
                  "type": "array",
                  "maxItems": 262144,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "report": {
                  "type": "array",
                  "maxItems": 262144,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              }
            }
          }
        },
        "hostEffect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "val"
          ],
          "properties": {
            "tag": {
              "const": "request-inference-proposal"
            },
            "val": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "gis-map-bounds-region"
                }
              }
            }
          }
        },
        "projectedEffect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestInferenceProposal"
          ],
          "properties": {
            "requestInferenceProposal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "gis-map-bounds-region"
                }
              }
            }
          }
        },
        "externalHostEffect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "val"
          ],
          "properties": {
            "tag": {
              "const": "open-external-url"
            },
            "val": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^https?://"
                }
              }
            }
          }
        },
        "externalProjectedEffect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openExternalUrl"
          ],
          "properties": {
            "openExternalUrl": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^https?://"
                }
              }
            }
          }
        }
      }
    }
  }
}
