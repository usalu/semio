{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "files", "expected", "inputs", "laws"],
  "properties": {
    "schema": { "const": "semio.browser-codegen-sources/v1" },
    "files": { "type": "object", "additionalProperties": false, "required": ["entry.js", "value.js"], "properties": { "entry.js": { "type": "string", "maxLength": 1024 }, "value.js": { "type": "string", "maxLength": 1024 } } },
    "expected": { "const": 42 },
    "inputs": { "const": ["fixture/entry.js", "fixture/value.js"] },
    "laws": { "const": ["stable-onload-capture", "replacement-after-capture-is-not-evaluated", "metafile-exact-capture-coverage", "foreign-root-denied", "non-javascript-denied", "cancel-before-capture"] }
  }
}
