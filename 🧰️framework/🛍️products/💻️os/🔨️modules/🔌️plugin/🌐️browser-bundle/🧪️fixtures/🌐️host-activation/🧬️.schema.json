{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "actors", "limits", "responses", "stream", "closedFault", "lateStreamFault", "laws"],
  "properties": {
    "schema": { "const": "semio.browser-host-activation/v1" },
    "actors": { "const": [{ "id": "same-actor", "generation": "1" }, { "id": "same-actor", "generation": "2" }] },
    "limits": { "const": { "pendingEffects": 128, "streams": 128, "bufferedStreamBytes": 1048576, "streamChunkBytes": 65536 } },
    "responses": { "const": [[0, 1, 127, 255], [42, 7]] },
    "stream": { "const": [0, 1, 128, 255] },
    "closedFault": { "const": { "origin": "os", "code": "capability-revoked", "severity": "error", "message": "browser host: closed", "scope": {}, "retryable": false } },
    "lateStreamFault": { "const": { "origin": "os", "code": "browser.host.stream-failed", "severity": "error", "message": "late-stream-fault", "scope": {}, "retryable": false } },
    "laws": { "const": ["generation-isolation", "pending-close", "late-reply", "closed-dispatch", "capacity-recovery", "dispatch-fault", "stream-close", "unused-stream-close", "external-abort", "invalid-identity", "tagged-error", "reject-untagged-result", "stream-reservation-before-dispatch", "buffered-stream-byte-bound", "unused-stream-return", "stream-chunk-backing-bound", "parked-consumer-return", "parked-consumer-throw", "cancel-failure-retirement", "canonical-request-fault-payload", "late-stream-terminal-fault", "private-invocation-fault-brand"] }
  }
}
