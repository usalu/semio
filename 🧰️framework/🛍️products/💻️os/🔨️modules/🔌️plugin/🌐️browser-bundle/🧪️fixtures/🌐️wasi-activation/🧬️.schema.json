{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "limits", "output", "readyIndices", "emptyAmbient", "terminal", "laws"],
  "properties": {
    "schema": { "const": "semio.browser-wasi-activation/v1" },
    "limits": { "const": { "resources": 256, "waiters": 128, "writeBytes": 65536, "outputBytes": 1048576 } },
    "output": { "const": [65, 0, 128, 255] },
    "readyIndices": { "const": [0] },
    "emptyAmbient": { "const": { "environment": [], "arguments": [], "cwd": null, "terminal": null } },
    "terminal": { "const": { "phase": "closed", "resources": 0, "waiters": 0, "timers": 0 } },
    "laws": { "const": ["fresh-resource-classes", "foreign-resource-denied", "closed-stdin", "no-ambient-process", "bounded-write-permits", "aggregate-output-bound", "exact-u64-clock", "asynchronous-poll", "close-retires-timers-waiters", "resource-capacity", "waiter-capacity", "invalid-poll-denied", "sink-failure-credit-at-capacity", "reentrant-sink-close-releases-credit-once", "reentrant-clock-close-never-rearms"] }
  }
}
