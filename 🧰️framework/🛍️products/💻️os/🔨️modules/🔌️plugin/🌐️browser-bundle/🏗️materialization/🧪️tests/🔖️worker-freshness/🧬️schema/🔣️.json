{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schemas/plugin/shard-worker-publication/v1",
  "title": "ShardWorkerPublication",
  "description": "A published shard worker is current only when its text is exactly the one the current sources generate.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "published", "publication"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "published": { "enum": ["absent", "generated", "generated-without", "empty"] },
      "removed": { "type": "string", "minLength": 1 },
      "publication": { "enum": ["missing", "stale", "current"] }
    }
  }
}
