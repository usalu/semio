{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "framework.plugin.cancellation-lease-return.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases",
    "witnessSelection",
    "blockedReselect"
  ],
  "properties": {
    "schema": {
      "const": "framework.plugin.cancellation-lease-return.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "keyed",
          "operations",
          "permit",
          "expectedActive",
          "expectedDocumentActive"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "keyed": {
            "type": "boolean"
          },
          "operations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "permit": {
            "type": "boolean"
          },
          "expectedActive": {
            "type": "integer",
            "minimum": 0
          },
          "expectedDocumentActive": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "witnessSelection": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fuel",
          "quote",
          "lookups",
          "runs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fuel": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "integer",
            "minimum": 0
          },
          "lookups": {
            "type": "integer",
            "minimum": 0
          },
          "runs": {
            "type": "boolean"
          }
        }
      }
    },
    "blockedReselect": {
      "const": true
    }
  }
}
