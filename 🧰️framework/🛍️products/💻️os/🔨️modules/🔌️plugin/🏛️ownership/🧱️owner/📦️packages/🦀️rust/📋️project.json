{
  "name": "@semio-tech/framework-plugin-ownership",
  "root": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🏛️ownership/🧱️owner/📦️packages/🦀️rust",
  "sourceRoot": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🏛️ownership/🧱️owner",
  "projectType": "library",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧵️job/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "lang:rust",
    "role:framework",
    "family:os-plugin"
  ],
  "targets": {
    "check": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "command": "bun 📜️script.ts check",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "command": "bun 📜️script.ts test",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      }
    }
  }
}
