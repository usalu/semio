{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/mounted-owner/component.json",
  "title": "MountedOwnerTurnObservationV1",
  "$ref": "#/$defs/MountedOwnerTurnObservationV1",
  "$defs": {
    "IdentityV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instanceId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        }
      },
      "required": [
        "instanceId",
        "operationId",
        "generation"
      ]
    },
    "RetainedCloneGrantV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ]
    },
    "RetainedCloneProgressV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "copiedItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "copiedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "retainedCapacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "releasedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "copiedItems",
        "copiedBytes",
        "retainedCapacityBytes",
        "releasedBytes"
      ]
    },
    "ScheduleObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancelled": {
          "type": "boolean"
        },
        "clockAvailable": {
          "type": "boolean"
        },
        "nowUs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "deadlineUs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "fuel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "cancelled",
        "clockAvailable",
        "nowUs",
        "deadlineUs",
        "fuel"
      ]
    },
    "RetirementDemandV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "copyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ]
    },
    "MountedOwnerTurnObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/IdentityV1"
        },
        "expectedIdentity": {
          "$ref": "#/$defs/IdentityV1"
        },
        "phase": {
          "enum": [
            "preparation",
            "maintenance",
            "close"
          ]
        },
        "grant": {
          "$ref": "#/$defs/RetainedCloneGrantV1"
        },
        "schedule": {
          "$ref": "#/$defs/ScheduleObservationV1"
        },
        "demand": {
          "$ref": "#/$defs/RetirementDemandV1"
        },
        "receipt": {
          "$ref": "#/$defs/RetainedCloneProgressV1"
        },
        "result": {
          "enum": [
            "progress",
            "complete",
            "blocked",
            "awaiting-input",
            "refused"
          ]
        },
        "terminalIsEmpty": {
          "type": "boolean"
        },
        "wakeOwned": {
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "expectedIdentity",
        "phase",
        "grant",
        "schedule",
        "demand",
        "receipt",
        "result",
        "terminalIsEmpty",
        "wakeOwned"
      ]
    },
    "MountedOwnerPolicyV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preparation": {
          "$ref": "#/$defs/RetainedCloneGrantV1"
        },
        "maintenance": {
          "$ref": "#/$defs/RetainedCloneGrantV1"
        },
        "close": {
          "$ref": "#/$defs/RetainedCloneGrantV1"
        }
      },
      "required": [
        "preparation",
        "maintenance",
        "close"
      ]
    },
    "MountedOwnerNestedJobObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/IdentityV1"
        },
        "expectedIdentity": {
          "$ref": "#/$defs/IdentityV1"
        },
        "phase": {
          "enum": [
            "preparation",
            "maintenance",
            "close"
          ]
        },
        "grant": {
          "$ref": "#/$defs/RetainedCloneGrantV1"
        },
        "schedule": {
          "$ref": "#/$defs/ScheduleObservationV1"
        },
        "demand": {
          "$ref": "#/$defs/RetirementDemandV1"
        },
        "receipt": {
          "$ref": "#/$defs/RetainedCloneProgressV1"
        },
        "result": {
          "enum": [
            "progress",
            "complete",
            "blocked",
            "awaiting-input",
            "refused"
          ]
        },
        "terminalIsEmpty": {
          "type": "boolean"
        },
        "wakeOwned": {
          "type": "boolean"
        },
        "usedFuel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "identity",
        "expectedIdentity",
        "phase",
        "grant",
        "schedule",
        "demand",
        "receipt",
        "result",
        "terminalIsEmpty",
        "wakeOwned",
        "usedFuel"
      ]
    },
    "MountedOwnerJobReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "progress": {
          "$ref": "#/$defs/RetainedCloneProgressV1"
        },
        "complete": {
          "type": "boolean"
        },
        "terminalIsEmpty": {
          "type": "boolean"
        }
      },
      "required": [
        "progress",
        "complete",
        "terminalIsEmpty"
      ]
    }
  }
}
