{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/os/extension-store-record.json",
  "title": "Extension Store Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["extensionId", "directoryName", "version", "label", "extends", "moduleUrl", "packageHash", "installedAt"],
  "properties": {
    "extensionId": { "type": "string", "minLength": 1 },
    "directoryName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "extends": { "type": "string", "minLength": 1 },
    "moduleUrl": { "type": "string", "minLength": 1 },
    "packageHash": { "type": "string", "minLength": 1 },
    "installedAt": { "type": "integer", "minimum": 0 }
  }
}
