{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routes",
    "authority",
    "receipt",
    "commitWithoutAuthority",
    "previewNeedsAuthority",
    "newAuthority"
  ],
  "properties": {
    "routes": {
      "const": [
        "document",
        "member",
        "supersede"
      ]
    },
    "authority": {
      "const": "same-caller"
    },
    "receipt": {
      "const": "same-original"
    },
    "commitWithoutAuthority": {
      "const": false
    },
    "previewNeedsAuthority": {
      "const": false
    },
    "newAuthority": {
      "const": false
    }
  }
}
