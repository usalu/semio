{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Interaction Retirement Receiving",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grantSource",
    "originalWorkByteLimits",
    "wholeOperationGrant",
    "zeroItemPhysicalBytes",
    "originalLimitsAreRenewed",
    "retainedOwnerClosedBeforeFailure"
  ],
  "properties": {
    "grantSource": {
      "const": "caller.retirement-request"
    },
    "originalWorkByteLimits": {
      "const": [
        1,
        64,
        4096
      ]
    },
    "wholeOperationGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "zeroItemPhysicalBytes": {
      "const": [
        0,
        0
      ]
    },
    "originalLimitsAreRenewed": {
      "const": false
    },
    "retainedOwnerClosedBeforeFailure": {
      "const": true
    }
  }
}
