{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/os/plugin/interaction/mutation/set-interaction-state/schema.json",
  "title": "SetState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection",
    "hover",
    "activeMode",
    "activeGranularity"
  ],
  "properties": {
    "selection": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Selection"
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Selection",
          "de": "Auswahl"
        },
        "group": "record",
        "order": 10
      }
    },
    "hover": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Hover"
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Hover",
          "de": "Hover"
        },
        "group": "record",
        "order": 20
      }
    },
    "activeMode": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "single",
          "multiple"
        ]
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Active selection mode",
          "de": "Aktiver Auswahlmodus"
        },
        "group": "record",
        "order": 30
      }
    },
    "activeGranularity": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Active granularity",
          "de": "Aktive Granularität"
        },
        "group": "record",
        "order": 40
      }
    }
  },
  "$defs": {
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granularity",
        "ids"
      ],
      "properties": {
        "granularity": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchorId": {
          "type": "string"
        }
      }
    },
    "Hover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "ids"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
