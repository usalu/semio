{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/os/plugin/interaction/mutation/set-interaction-state/schema.json",
  "title": "SetState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection",
    "hover",
    "activeMode",
    "activeGranularity"
  ],
  "properties": {
    "selection": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Selection"
      }
    },
    "hover": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Hover"
      }
    },
    "activeMode": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "single",
          "multiple"
        ]
      }
    },
    "activeGranularity": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granularity",
        "ids"
      ],
      "properties": {
        "granularity": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchorId": {
          "type": "string"
        }
      }
    },
    "Hover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "ids"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
