{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Query Receiving Authority and Output Width",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grantSource",
    "widthPricesGrant",
    "originalCopyOneAdmitsMetadataClose",
    "outputWidths",
    "wholeOperationGrant",
    "pagePublicationRefusal"
  ],
  "properties": {
    "grantSource": {
      "const": "caller.request"
    },
    "widthPricesGrant": {
      "const": false
    },
    "originalCopyOneAdmitsMetadataClose": {
      "const": false
    },
    "outputWidths": {
      "const": [
        1,
        64,
        4096
      ]
    },
    "wholeOperationGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pagePublicationRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalBytes",
        "originalPagePreserved",
        "replyAdmitted",
        "inputSource"
      ],
      "properties": {
        "physicalBytes": {
          "const": [
            0,
            0
          ]
        },
        "originalPagePreserved": {
          "const": true
        },
        "replyAdmitted": {
          "const": false
        },
        "inputSource": {
          "const": "caller.request"
        }
      }
    }
  }
}
