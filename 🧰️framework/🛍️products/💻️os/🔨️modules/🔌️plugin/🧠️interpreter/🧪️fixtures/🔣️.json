{
  "$schema": "../🧬️schema/🔣️.schema.json",
  "version": 1,
  "cases": [
    {
      "name": "overlapping-copy",
      "destination": 8,
      "source": 0,
      "length": 8,
      "growPages": 0,
      "outcome": "ok",
      "expectedBytes": [1, 2, 3, 4, 5, 6, 7, 8]
    },
    {
      "name": "overlapping-copy-reverse",
      "destination": 0,
      "source": 4,
      "length": 4,
      "growPages": 0,
      "outcome": "ok",
      "expectedBytes": [5, 6, 7, 8]
    },
    {
      "name": "exact-initial-bound",
      "destination": 65528,
      "source": 0,
      "length": 8,
      "growPages": 0,
      "outcome": "ok",
      "expectedBytes": [1, 2, 3, 4, 5, 6, 7, 8]
    },
    {
      "name": "zero-length-at-bound",
      "destination": 65536,
      "source": 65536,
      "length": 0,
      "growPages": 0,
      "outcome": "ok",
      "expectedBytes": []
    },
    {
      "name": "copy-after-grow",
      "destination": 65536,
      "source": 0,
      "length": 8,
      "growPages": 1,
      "outcome": "ok",
      "expectedBytes": [1, 2, 3, 4, 5, 6, 7, 8]
    },
    {
      "name": "initial-bound-plus-one",
      "destination": 65529,
      "source": 0,
      "length": 8,
      "growPages": 0,
      "outcome": "trap",
      "ownedError": "memory.copy destination is out of bounds: start=65529 length=8 end=65537 bound=65536"
    },
    {
      "name": "u32-maximum-destination",
      "destination": 4294967295,
      "source": 0,
      "length": 1,
      "growPages": 0,
      "outcome": "trap",
      "ownedError": "memory.copy destination is out of bounds: start=4294967295 length=1 end=4294967296 bound=65536"
    },
    {
      "name": "initial-source-bound-plus-one",
      "destination": 0,
      "source": 65529,
      "length": 8,
      "growPages": 0,
      "outcome": "trap",
      "ownedError": "memory.copy source is out of bounds: start=65529 length=8 end=65537 bound=65536"
    },
    {
      "name": "u32-maximum-source",
      "destination": 0,
      "source": 4294967295,
      "length": 1,
      "growPages": 0,
      "outcome": "trap",
      "ownedError": "memory.copy source is out of bounds: start=4294967295 length=1 end=4294967296 bound=65536"
    }
  ]
}
