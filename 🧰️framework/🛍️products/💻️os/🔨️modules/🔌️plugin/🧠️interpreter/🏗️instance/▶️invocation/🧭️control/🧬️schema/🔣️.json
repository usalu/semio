{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "args",
          "body",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "body": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "expected": {
            "type": "integer"
          },
          "continuation": {
            "enum": ["settledControl", "retiredCallee"]
          },
          "labelPeak": {
            "type": "integer",
            "minimum": 3
          },
          "executionFuel": {
            "type": "integer",
            "minimum": 1
          },
          "atomicTransfer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["before", "after", "retireLabel", "prefixFuel", "expectedFuel"],
            "properties": {
              "before": { "type": "integer", "minimum": 0 },
              "after": { "type": "integer", "minimum": 0 },
              "retireLabel": { "type": "boolean" },
              "prefixFuel": { "type": "integer", "minimum": 0 },
              "expectedFuel": { "type": "integer", "minimum": 1 }
            }
          },
          "callee": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      }
    }
  }
}
