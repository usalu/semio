{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "budget",
    "cases"
  ],
  "properties": {
    "budget": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events",
          "valid"
        ],
        "properties": {
          "events": {
            "type": "array"
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
