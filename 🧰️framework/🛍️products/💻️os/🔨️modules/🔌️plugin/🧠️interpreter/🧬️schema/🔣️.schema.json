{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://framework/plugin/interpreter/memory-copy-ranges/v1",
  "type": "object",
  "required": ["$schema", "version", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "../🧬️schema/🔣️.schema.json" },
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "destination", "source", "length", "growPages", "outcome"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "destination": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "source": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "length": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "growPages": { "type": "integer", "minimum": 0, "maximum": 1 },
          "outcome": { "enum": ["ok", "trap"] },
          "ownedError": { "type": "string", "minLength": 1 },
          "expectedBytes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "outcome": { "const": "trap" } }, "required": ["outcome"] },
            "then": {
              "properties": { "ownedError": { "type": "string", "minLength": 1 } },
              "required": ["ownedError"],
              "not": {
                "properties": { "expectedBytes": {} },
                "required": ["expectedBytes"]
              }
            },
            "else": {
              "properties": { "expectedBytes": { "type": "array" } },
              "required": ["expectedBytes"],
              "not": {
                "properties": { "ownedError": {} },
                "required": ["ownedError"]
              }
            }
          }
        ]
      }
    }
  }
}
