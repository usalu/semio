{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.semio-tech.com/framework/plugin/render-revision",
  "title": "Render Revision Identity",
  "description": "A mounted render projection matches only the same instance, local revision, generation and complete canonical revision; work grants do not identify content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["appInstanceId", "baseRevision", "generation", "canonicalBaseRevision"],
  "properties": {
    "appInstanceId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "baseRevision": { "$ref": "#/definitions/counter" },
    "generation": { "$ref": "#/definitions/counter" },
    "canonicalBaseRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "definitions": {
    "counter": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$" }
  }
}
