{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "expected",
          "current",
          "instance",
          "live",
          "accepted"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "current": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "instance": {
            "type": "integer",
            "minimum": 0
          },
          "live": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
