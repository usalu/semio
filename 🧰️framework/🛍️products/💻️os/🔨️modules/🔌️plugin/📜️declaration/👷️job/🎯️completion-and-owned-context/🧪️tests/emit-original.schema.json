{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "receiver",
          "published",
          "items",
          "copy",
          "depth",
          "fuel",
          "cancel",
          "busy",
          "result",
          "afterSource",
          "afterReceiver",
          "afterPublished"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "boolean"
          },
          "receiver": {
            "type": "boolean"
          },
          "published": {
            "type": "boolean"
          },
          "items": {
            "type": "boolean"
          },
          "copy": {
            "type": "boolean"
          },
          "depth": {
            "type": "boolean"
          },
          "fuel": {
            "type": "boolean"
          },
          "cancel": {
            "type": "boolean"
          },
          "busy": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "published",
              "pending",
              "refused"
            ]
          },
          "afterSource": {
            "type": "boolean"
          },
          "afterReceiver": {
            "type": "boolean"
          },
          "afterPublished": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
