{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {
        "component": "📦️component.wasm",
        "descriptor": "🔣️.json",
        "descriptorPack": "🛂️.descriptor.semio",
        "receipt": "🧾️receipt.json"
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "pluginId",
    "cratePath"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "cratePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
