{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://framework/plugin/window-kits/document/editable-fixture",
  "title": "Editable Document Draft Fixture",
  "type": "object",
  "required": ["$schema", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./🧬️schema/🔣️.json" },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["locale", "page", "item", "text", "revision", "labels"],
        "additionalProperties": false,
        "properties": {
          "locale": { "enum": ["en", "de"] },
          "page": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "item": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "text": { "type": "string" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "staticArguments": { "type": "object" },
          "labels": {
            "type": "object",
            "required": ["apply", "discard", "cancel"],
            "additionalProperties": false,
            "properties": {
              "apply": { "type": "string", "minLength": 1 },
              "discard": { "type": "string", "minLength": 1 },
              "cancel": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
