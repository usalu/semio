{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/plugin/table/row-capacity.fixture.json",
  "title": "TableRowCapacityFixture",
  "description": "A Home-shaped windowed table row (cells, labelled row actions and a row activation — verbs on the row's ONE target, whose one argument map every verb inherits), the host's default window, the reconcile items one such row may cost and the rows one window of them must serve inside the body's item budget. Row actions travel only as RowAction props, never as child records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "controller", "tableLabel", "columns", "actionsLabel", "row", "window", "expect"],
  "properties": {
    "$schema": { "type": "string" },
    "controller": { "type": "string", "minLength": 1 },
    "tableLabel": { "type": "string", "minLength": 1 },
    "columns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "maxItems": 16 },
    "actionsLabel": { "type": "string", "minLength": 1 },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyPrefix", "idLength", "cells", "argument", "activation", "actions"],
      "properties": {
        "keyPrefix": { "type": "string", "minLength": 1 },
        "idLength": { "type": "integer", "minimum": 1, "maximum": 64 },
        "cells": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 16 },
        "argument": { "type": "string", "minLength": 1 },
        "activation": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["icon", "label", "verb"],
            "properties": {
              "icon": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "verb": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "rows"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1, "description": "The host's default window request (TREE_WINDOW_DEFAULT_ROWS)." }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowChildren", "minRowsPerWindow", "maxRowItems"],
      "properties": {
        "rowChildren": { "const": 0, "description": "A plain row has no child records: cells and row actions are props." },
        "minRowsPerWindow": { "type": "integer", "minimum": 1, "description": "Rows of this shape one default window must serve inside the body item budget." },
        "maxRowItems": { "type": "integer", "minimum": 1, "description": "Surface reconcile items (census) one row of this shape may cost: the body item budget over minRowsPerWindow." }
      }
    }
  }
}
