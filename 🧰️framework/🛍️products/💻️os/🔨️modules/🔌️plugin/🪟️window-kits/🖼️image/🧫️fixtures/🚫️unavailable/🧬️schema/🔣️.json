{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.framework.window.image.unavailable/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "windowKey", "unavailableNodeKey", "labels"],
  "properties": {
    "$schema": { "type": "string", "const": "./🧬️schema/🔣️.json" },
    "windowKey": { "type": "string", "const": "framework.window.image" },
    "unavailableNodeKey": { "type": "string", "const": "framework.window.image.unavailable" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "const": "Preview unavailable" },
        "de": { "type": "string", "const": "Vorschau nicht verfügbar" }
      }
    }
  }
}
