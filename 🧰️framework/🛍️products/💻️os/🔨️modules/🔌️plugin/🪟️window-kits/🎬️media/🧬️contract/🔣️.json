{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://framework/media-transport/v1",
  "title": "Media Transport Host Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "mediaType",
    "revision",
    "durationMs",
    "positionMs",
    "selectionStartMs",
    "selectionEndMs",
    "locale",
    "labels",
    "resource",
    "capability",
    "hostContentHeight"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "audio",
        "video"
      ]
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0][0-9]|1844674407370955161[0-5])$"
    },
    "durationMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "positionMs": {
      "type": "integer",
      "minimum": 0
    },
    "selectionStartMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "selectionEndMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "locale": {
      "enum": [
        "en",
        "de"
      ]
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play",
        "pause",
        "seek",
        "position",
        "duration",
        "selectionStart",
        "selectionEnd",
        "loading",
        "progress",
        "cancel",
        "unsupported",
        "unknownDuration",
        "audio",
        "video"
      ],
      "properties": {
        "play": {
          "type": "string"
        },
        "pause": {
          "type": "string"
        },
        "seek": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "selectionStart": {
          "type": "string"
        },
        "selectionEnd": {
          "type": "string"
        },
        "loading": {
          "type": "string"
        },
        "progress": {
          "type": "string"
        },
        "cancel": {
          "type": "string"
        },
        "unsupported": {
          "type": "string"
        },
        "unknownDuration": {
          "type": "string"
        },
        "audio": {
          "type": "string"
        },
        "video": {
          "type": "string"
        }
      }
    },
    "resource": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "controllerId",
            "appInstanceId",
            "parentDocumentId",
            "outputPort",
            "revision",
            "generation"
          ],
          "properties": {
            "kind": {
              "const": "artifact-media-export"
            },
            "controllerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "appInstanceId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "parentDocumentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "outputPort": {
              "const": "playback:out"
            },
            "revision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0][0-9]|1844674407370955161[0-5])$"
            },
            "generation": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0][0-9]|1844674407370955161[0-5])$"
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "loading",
            "unsupported"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "hostContentHeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "durationMs": {
            "type": "null"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "positionMs": {
            "const": 0
          },
          "selectionStartMs": {
            "type": "null"
          },
          "selectionEndMs": {
            "type": "null"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "capability": {
            "properties": {
              "status": {
                "const": "ready"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "resource": {
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
