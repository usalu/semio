{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/reactor/pending/component.json",
  "title": "Semio OS Plugin Reactor Pending",
  "$defs": {
    "PendingPatchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationGeneration",
        "instanceId",
        "guestLifetime",
        "patchSequence",
        "surface",
        "revision"
      ],
      "properties": {
        "activationGeneration": {
          "$ref": "#/$defs/ReactorU64"
        },
        "instanceId": {
          "$ref": "#/$defs/ReactorInstanceId"
        },
        "guestLifetime": {
          "$ref": "#/$defs/ReactorU64"
        },
        "patchSequence": {
          "$ref": "#/$defs/ReactorU64"
        },
        "surface": {
          "$ref": "#/$defs/ReactorSurfaceKey"
        },
        "revision": {
          "$ref": "#/$defs/ReactorU64"
        }
      }
    },
    "PendingPatchIdentityChanges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activationGeneration": {
          "$ref": "#/$defs/ReactorU64"
        },
        "instanceId": {
          "$ref": "#/$defs/ReactorInstanceId"
        },
        "guestLifetime": {
          "$ref": "#/$defs/ReactorU64"
        },
        "patchSequence": {
          "$ref": "#/$defs/ReactorU64"
        },
        "surface": {
          "$ref": "#/$defs/ReactorSurfaceKey"
        },
        "revision": {
          "$ref": "#/$defs/ReactorU64"
        }
      }
    },
    "PendingPatchAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation",
        "instance",
        "guest",
        "sequence",
        "surface",
        "revision"
      ],
      "properties": {
        "activation": {
          "type": "integer",
          "minimum": 1
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "guest": {
          "type": "integer",
          "minimum": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "surface": {
          "$ref": "#/$defs/ReactorSurfaceKey"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ReactorInstanceId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "ReactorSurfaceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ReactorU64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "maxLength": 20
    }
  },
  "$ref": "#/$defs/PendingPatchAcknowledgement"
}
