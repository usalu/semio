{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "issued", "cases", "retirementCycles"],
  "properties": {
    "version": {
      "const": 1
    },
    "issued": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "instance", "guest", "sequence", "surface", "revision"],
      "properties": {
        "activation": {
          "type": "integer",
          "minimum": 1
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "guest": {
          "type": "integer",
          "minimum": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ack", "committed", "pending", "live", "accepted"],
        "properties": {
          "id": {
            "type": "string"
          },
          "ack": {
            "type": "object",
            "additionalProperties": false,
            "required": ["activation", "instance", "guest", "sequence", "surface", "revision"],
            "properties": {
              "activation": {
                "type": "integer",
                "minimum": 1
              },
              "instance": {
                "type": "integer",
                "minimum": 0
              },
              "guest": {
                "type": "integer",
                "minimum": 1
              },
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "surface": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "committed": {
            "type": "boolean"
          },
          "pending": {
            "type": "boolean"
          },
          "live": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "retirementCycles": {
      "const": 65
    }
  }
}
