{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "checkpoint",
    "pendingPayload",
    "zeroGrantMoved",
    "originalCaller",
    "terminalDrop"
  ],
  "properties": {
    "source": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "checkpoint": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "pendingPayload": {
      "type": "null"
    },
    "zeroGrantMoved": {
      "const": false
    },
    "originalCaller": {
      "const": true
    },
    "terminalDrop": {
      "const": 0
    }
  }
}
