{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "identity",
    "bytes",
    "copyCeilings",
    "acknowledgement",
    "refusals",
    "nativeTarget"
  ],
  "properties": {
    "contract": {
      "const": "actor.original-owned-output-loan/v1"
    },
    "identity": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 1
    },
    "copyCeilings": {
      "const": [
        1,
        3,
        64
      ]
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copy",
        "capacity",
        "release",
        "work"
      ],
      "properties": {
        "items": {
          "const": 1
        },
        "copy": {
          "const": 0
        },
        "capacity": {
          "const": 0
        },
        "release": {
          "const": 0
        },
        "work": {
          "const": 1
        }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "enum": [
          "job",
          "operation",
          "generation",
          "offset",
          "extent",
          "held-read",
          "held-close",
          "zero-items",
          "zero-fuel",
          "expired"
        ]
      },
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true
    },
    "nativeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "feature",
        "laws"
      ],
      "properties": {
        "name": {
          "const": "owned-output"
        },
        "feature": {
          "const": "original-actor-context-testing"
        },
        "laws": {
          "const": 6
        }
      }
    }
  }
}
