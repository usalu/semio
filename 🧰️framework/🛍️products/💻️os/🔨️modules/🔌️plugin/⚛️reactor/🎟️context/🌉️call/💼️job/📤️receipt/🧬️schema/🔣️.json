{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "extent",
    "cases",
    "loanHandbacks"
  ],
  "properties": {
    "contract": {
      "const": "actor.original-owned-job-header/v2"
    },
    "extent": {
      "const": 184
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "prefixHex",
          "body",
          "refusal"
        ],
        "properties": {
          "kind": {
            "enum": [
              "start",
              "step",
              "output",
              "acknowledge",
              "cancel",
              "close"
            ]
          },
          "prefixHex": {
            "type": "string",
            "pattern": "^534a4832[0-9a-f]{8}$"
          },
          "body": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "refusal": {
            "enum": [
              "none",
              "semantic",
              "ownershipLimit"
            ]
          }
        }
      }
    },
    "loanHandbacks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "extent",
          "accepted"
        ],
        "properties": {
          "pointer": {
            "enum": [
              "original",
              "foreign"
            ]
          },
          "extent": {
            "enum": [
              183,
              184
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
