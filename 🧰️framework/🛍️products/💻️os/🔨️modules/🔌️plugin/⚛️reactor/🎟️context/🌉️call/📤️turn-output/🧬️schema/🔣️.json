{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "result",
    "grant",
    "batchedRetirement",
    "batchedEncoding",
    "states"
  ],
  "additionalProperties": false,
  "properties": {
    "result": {
      "type": "object"
    },
    "grant": {
      "type": "object"
    },
    "batchedRetirement": {
      "type": "object",
      "required": ["uiPatches"],
      "additionalProperties": false,
      "properties": {
        "uiPatches": { "type": "array" }
      }
    },
    "batchedEncoding": {
      "type": "object",
      "required": ["expectedBytes", "tinyGrantItems", "cancelAfterTurns", "minimumTurnReduction"],
      "additionalProperties": false,
      "properties": {
        "expectedBytes": { "type": "integer", "minimum": 1 },
        "tinyGrantItems": { "type": "integer", "minimum": 1 },
        "cancelAfterTurns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "minimumTurnReduction": { "type": "integer", "minimum": 2 }
      }
    },
    "states": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "event",
          "held"
        ],
        "additionalProperties": false,
        "properties": {
          "event": {
            "enum": [
              "publish",
              "deniedClose",
              "foreignClose",
              "fundedClose"
            ]
          },
          "held": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
