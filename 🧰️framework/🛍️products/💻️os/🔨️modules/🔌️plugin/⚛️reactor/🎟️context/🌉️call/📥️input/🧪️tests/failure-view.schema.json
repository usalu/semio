{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "present",
          "keys"
        ],
        "properties": {
          "present": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "boolean"
            }
          },
          "keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "outcomeValue",
                "outcomeReceiving",
                "settlementValue",
                "settlementReceiving"
              ]
            }
          }
        }
      }
    }
  }
}
