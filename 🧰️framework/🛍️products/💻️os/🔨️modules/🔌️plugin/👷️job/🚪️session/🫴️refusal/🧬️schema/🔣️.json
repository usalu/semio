{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Refused Worker Source Custody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "original",
    "turn",
    "maximumCloseTurns",
    "ownedJobBytes",
    "message",
    "cases",
    "sameContext",
    "fullCause",
    "retainedParameters",
    "paidCancel",
    "paidError",
    "terminalDropBytes",
    "whole",
    "fuel",
    "deadlineMicros",
    "paidErasedBox",
    "deferredInitialWorker",
    "originalInferenceFactoryOnly"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "original": {
      "const": {
        "operation": 17,
        "generation": 9
      }
    },
    "turn": {
      "const": {
        "maximumItems": 1,
        "maximumCopyBytes": 4096,
        "maximumCapacityBytes": 65536,
        "maximumReleaseBytes": 65536,
        "maximumDepth": 128
      }
    },
    "maximumCloseTurns": {
      "const": 10000
    },
    "ownedJobBytes": {
      "const": 128
    },
    "message": {
      "const": "original worker 源\u0000\r\n"
    },
    "cases": {
      "const": [
        {
          "kind": "value",
          "receipt": null,
          "context": null
        },
        {
          "kind": "fault",
          "receipt": "original receipt 源",
          "context": "original context 源"
        }
      ]
    },
    "sameContext": {
      "const": true
    },
    "fullCause": {
      "const": true
    },
    "retainedParameters": {
      "const": true
    },
    "paidCancel": {
      "const": true
    },
    "paidError": {
      "const": true
    },
    "terminalDropBytes": {
      "const": 0
    },
    "whole": {
      "const": {
        "maximumItems": 10000,
        "maximumCopyBytes": 4194304,
        "maximumCapacityBytes": 4194304,
        "maximumReleaseBytes": 4194304,
        "maximumDepth": 128
      }
    },
    "fuel": {
      "const": 10000
    },
    "deadlineMicros": {
      "const": 600000000
    },
    "paidErasedBox": {
      "const": true
    },
    "originalInferenceFactoryOnly": {
      "type": "boolean",
      "const": true
    },
    "deferredInitialWorker": {
      "type": "boolean",
      "const": true
    }
  }
}
