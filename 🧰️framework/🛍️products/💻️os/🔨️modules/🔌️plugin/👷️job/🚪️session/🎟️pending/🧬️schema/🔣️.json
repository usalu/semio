{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "initial",
    "events",
    "ownedSourceRetainedUntilAdmission",
    "sameOperation",
    "sameGeneration",
    "aliasReceipt",
    "deniedHeapBytes",
    "bodyCredits",
    "terminalDropBytes",
    "clock",
    "cancel",
    "refilledPolicyLoop",
    "recordHandle",
    "storeGeneration",
    "cleanupReceiver",
    "previewReceiver"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "initial": {
      "const": "pendingSource"
    },
    "events": {
      "const": [
        "deniedAlias",
        "originalAlias",
        "deniedAdmission",
        "originalAdmission",
        "cancel",
        "paidClose"
      ]
    },
    "ownedSourceRetainedUntilAdmission": {
      "const": true
    },
    "sameOperation": {
      "const": 17
    },
    "sameGeneration": {
      "const": 9
    },
    "aliasReceipt": {
      "const": {
        "copiedItems": 1,
        "copiedBytes": 0,
        "retainedCapacityBytes": 0,
        "releasedBytes": 0
      }
    },
    "deniedHeapBytes": {
      "const": 0
    },
    "bodyCredits": {
      "const": [
        0,
        1,
        3,
        64
      ]
    },
    "terminalDropBytes": {
      "const": 0
    },
    "clock": {
      "const": "originalCaller"
    },
    "cancel": {
      "const": "originalCaller"
    },
    "refilledPolicyLoop": {
      "const": false
    },
    "recordHandle": {
      "const": 77
    },
    "storeGeneration": {
      "const": 35
    },
    "cleanupReceiver": {
      "const": {
        "callerTurnBorrowed": true,
        "detachedContextBirth": false,
        "originalFailureRetained": true,
        "maximumStepsPerCall": 1,
        "cancelReturnWitness": "original-source-parent"
      }
    },
    "previewReceiver": {
      "const": {
        "persistentProducer": true,
        "originalCaller": true,
        "budgetRefill": false,
        "events": [
          "source",
          "alias",
          "admission",
          "callback",
          "acknowledgement",
          "resume",
          "callback",
          "close",
          "delivery"
        ]
      }
    }
  }
}
