{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ownedProducer"
  ],
  "properties": {
    "ownedProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "cancelAfter",
        "mutationValues",
        "sameEmissionBacking",
        "sameMetadataBacking",
        "deniedTransferKeepsProducer",
        "foreignDecoderRefused",
        "hostBase"
      ],
      "properties": {
        "verb": {
          "type": "string",
          "minLength": 1
        },
        "cancelAfter": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "mutationValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "sameEmissionBacking": {
          "const": true
        },
        "sameMetadataBacking": {
          "const": true
        },
        "deniedTransferKeepsProducer": {
          "const": true
        },
        "foreignDecoderRefused": {
          "const": true
        },
        "hostBase": {
          "type": "object",
          "required": [
            "deferredUntilTypingSettled",
            "changedFrontierRefused"
          ],
          "properties": {
            "deferredUntilTypingSettled": {
              "const": true
            },
            "changedFrontierRefused": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
