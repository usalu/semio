{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "steps",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "semio.tool-run.original-job-receiving.v1"
    },
    "steps": {
      "const": [
        "cancel-birth",
        "ledger-birth",
        "original-callback",
        "physical-receipt-return",
        "borrow-original-descriptor",
        "semantic-receiving",
        "acknowledge",
        "remove-descriptor"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "depth",
          "admitted"
        ],
        "properties": {
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "admitted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
