{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "steps",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "semio.tool-run.original-port-admission.v1"
    },
    "steps": {
      "const": [
        {
          "kind": "birth-native-queue",
          "copyBytes": 0,
          "items": 1
        },
        {
          "kind": "handoff-original-effect",
          "copyBytes": 0,
          "items": 1
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant",
          "admitted"
        ],
        "properties": {
          "grant": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "admitted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
