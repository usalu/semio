{
  "schema": "semio.plugin-registry.rebuild-chain/v1",
  "steps": [
    {
      "id": "provenance",
      "stage": "inputs",
      "command": [
        "repo",
        "run",
        "repo:cargo-provenance-check"
      ]
    },
    {
      "id": "mutation-authority",
      "stage": "inputs",
      "command": [
        "repo",
        "run",
        "@semio-tech/dsl-derive-rs:check-generated"
      ]
    },
    {
      "id": "schema-index",
      "stage": "inputs",
      "command": [
        "repo",
        "run",
        "@semio-tech/dsl-derive-rs:check-schema-index"
      ]
    },
    {
      "id": "guest-framework",
      "stage": "inputs",
      "command": [
        "repo",
        "run",
        "@semio-tech/plugin-registry:guest-framework-check"
      ]
    },
    {
      "id": "describe",
      "stage": "descriptors",
      "command": [
        "repo",
        "run",
        "workspace:components",
        "describe",
        "--all"
      ]
    },
    {
      "id": "generate",
      "stage": "registry",
      "command": [
        "repo",
        "run",
        "@semio-tech/plugin-registry:generate"
      ]
    },
    {
      "id": "check",
      "stage": "registry",
      "command": [
        "repo",
        "run",
        "@semio-tech/plugin-registry:check"
      ]
    }
  ],
  "guestFrameworkChecks": [
    {
      "target": "wasm32-wasip2",
      "workspace": "Cargo.toml",
      "packages": [
        "semio-framework",
        "semio-framework-replication",
        "semio-framework-os-kernel",
        "semio-framework-os",
        "semio-framework-plugin"
      ],
      "features": [
        "semio-framework-os-kernel/deflate",
        "semio-framework-replication/deflate"
      ]
    },
    {
      "target": "wasm32-unknown-unknown",
      "workspace": "Cargo.toml",
      "packages": [
        "semio-framework-os-kernel"
      ],
      "features": [
        "semio-framework-os-kernel/sync"
      ]
    },
    {
      "target": "wasm32-unknown-unknown",
      "workspace": "Cargo.toml",
      "packages": [
        "semio-framework-os-renderer-wgpu"
      ],
      "features": []
    }
  ]
}
