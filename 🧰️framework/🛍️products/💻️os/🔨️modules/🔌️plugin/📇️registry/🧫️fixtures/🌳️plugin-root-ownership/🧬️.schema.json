{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "cases"
  ],
  "properties": {
    "format": {
      "const": "semio.registry.plugin-root-ownership/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(?:-[a-z]+)*$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "🦀️.rs",
                "🎮️commands/🦀️.rs",
                "🔨️modules/📌️.empty.md",
                "🔨️modules/🦀️.rs",
                "🎮️commands/📌️.empty.md",
                "🔌️plugin/🦀️.rs"
              ]
            }
          },
          "expected": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "missing:🦀️.rs",
                "missing:🎮️commands/🦀️.rs",
                "nested-contract"
              ]
            }
          }
        }
      }
    }
  }
}
