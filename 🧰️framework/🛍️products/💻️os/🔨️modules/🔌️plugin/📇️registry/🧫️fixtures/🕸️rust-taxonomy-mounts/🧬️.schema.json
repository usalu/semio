{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "expectedCodes",
          "rustcSuccess",
          "expectedUnmounted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(?:-[a-z]+)*$"
          },
          "files": {
            "type": "object",
            "minProperties": 3,
            "propertyNames": {
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "expectedCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "unmounted",
                "missing-target",
                "missing-manifest",
                "invalid-manifest"
              ]
            }
          },
          "rustcSuccess": {
            "type": "boolean"
          },
          "expectedUnmounted": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "\\.rs$"
            }
          }
        }
      }
    }
  }
}
