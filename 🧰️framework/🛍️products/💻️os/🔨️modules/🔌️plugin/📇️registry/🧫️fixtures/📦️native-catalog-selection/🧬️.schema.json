{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "packages",
    "profiles",
    "availableProviders",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.registry.native-catalog-selection/v1"
    },
    "authority": {
      "const": "planning-only"
    },
    "packages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "availableProviders": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profileId",
          "mutation",
          "expectedCode",
          "expectedCalls",
          "expectedReceiptCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "profileId": {
            "enum": [
              "native-stdio-v1",
              "native-stdio-vcs-v1"
            ]
          },
          "mutation": {
            "enum": [
              "none",
              "unknown-profile",
              "duplicate-root",
              "missing-root",
              "missing-dependency",
              "dependency-version",
              "cycle",
              "duplicate-package",
              "foreign-package",
              "duplicate-provider",
              "missing-provider",
              "provider-package",
              "provider-count",
              "unselected-result",
              "selected-provider-failure",
              "cancel-before-first",
              "cancel-after-first",
              "registry-conflict"
            ]
          },
          "expectedCode": {
            "enum": [
              "planned",
              "denied"
            ]
          },
          "expectedCalls": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "semio:stdio",
                "semio:vcs"
              ]
            }
          },
          "expectedReceiptCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 27
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "packageId",
        "version"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "packageId": {
          "type": "string",
          "pattern": "^semio:[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 134
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 64
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "packageId",
        "version",
        "dependencies",
        "receiptCount"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "packageId": {
          "type": "string",
          "pattern": "^semio:[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 134
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 64
        },
        "dependencies": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "receiptCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roots"
      ],
      "properties": {
        "id": {
          "enum": [
            "native-stdio-v1",
            "native-stdio-vcs-v1"
          ]
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "packageId",
        "receiptCount"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "packageId": {
          "type": "string",
          "pattern": "^semio:[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 134
        },
        "receiptCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    }
  }
}
