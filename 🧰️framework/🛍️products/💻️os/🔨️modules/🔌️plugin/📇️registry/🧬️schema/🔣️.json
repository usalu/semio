{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InjectedPluginCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "targets",
    "hosts",
    "playgrounds"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "targets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/PluginCatalogTargetV1"
      }
    },
    "hosts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/PluginCatalogHostV1"
      }
    },
    "playgrounds": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/PluginCatalogPlaygroundV1"
      }
    }
  },
  "$defs": {
    "PluginCatalogIdV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "PluginCatalogTextV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "PluginCatalogTextsV1": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/PluginCatalogTextV1"
      }
    },
    "PluginCatalogTargetV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "wasmOut",
        "moduleUrl",
        "role",
        "dependsOn",
        "contributes",
        "consumes",
        "activationEvents",
        "capabilities"
      ],
      "properties": {
        "pluginId": {
          "$ref": "#/$defs/PluginCatalogIdV1"
        },
        "wasmOut": {
          "$ref": "#/$defs/PluginCatalogTextV1"
        },
        "moduleUrl": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https?://[^\\s]+$"
        },
        "role": {
          "enum": [
            "plugin",
            "extension"
          ]
        },
        "dependsOn": {
          "$ref": "#/$defs/PluginCatalogTextsV1"
        },
        "contributes": {
          "$ref": "#/$defs/PluginCatalogTextsV1"
        },
        "consumes": {
          "$ref": "#/$defs/PluginCatalogTextsV1"
        },
        "activationEvents": {
          "$ref": "#/$defs/PluginCatalogTextsV1"
        },
        "capabilities": {
          "$ref": "#/$defs/PluginCatalogTextsV1"
        },
        "extends": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "extension"
              }
            }
          },
          "then": {
            "required": [
              "extends"
            ]
          },
          "else": {
            "not": {
              "required": [
                "extends"
              ]
            }
          }
        }
      ]
    },
    "PluginCatalogHostV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "landingAppId",
        "hostAppId"
      ],
      "properties": {
        "pluginId": {
          "$ref": "#/$defs/PluginCatalogIdV1"
        },
        "landingAppId": {
          "$ref": "#/$defs/PluginCatalogIdV1"
        },
        "hostAppId": {
          "$ref": "#/$defs/PluginCatalogIdV1"
        }
      }
    },
    "PluginCatalogPlaygroundV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "pluginId",
        "aliases"
      ],
      "properties": {
        "variant": {
          "$ref": "#/$defs/PluginCatalogIdV1"
        },
        "pluginId": {
          "$ref": "#/$defs/PluginCatalogIdV1"
        },
        "app": {
          "$ref": "#/$defs/PluginCatalogTextV1"
        },
        "aliases": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PluginCatalogTextV1"
          }
        }
      }
    }
  },
  "x-semio-admission": {
    "maxJsonBytes": 2097152,
    "maxEdges": 4096,
    "maxWork": 65536,
    "maxRows": 128,
    "maxDurationMs": 30000,
    "schemes": [
      "http:",
      "https:"
    ]
  },
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/registry/component.json"
}
