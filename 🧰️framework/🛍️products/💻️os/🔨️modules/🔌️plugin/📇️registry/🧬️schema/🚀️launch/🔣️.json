{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.launch-taxonomy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["slugs", "prefixes"],
  "properties": {
    "slugs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["folder", "slug"],
        "properties": { "folder": {"type": "string"}, "slug": {"type": "string"} }
      }
    },
    "prefixes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["variant", "prefix"],
        "properties": { "variant": {"type": "string"}, "prefix": {"type": "string"} }
      }
    }
  }
}
