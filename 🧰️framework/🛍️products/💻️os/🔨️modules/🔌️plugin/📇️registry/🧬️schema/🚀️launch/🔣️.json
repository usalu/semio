{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.launch-taxonomy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slugs",
    "prefixes"
  ],
  "properties": {
    "slugs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "folder",
          "slug"
        ],
        "properties": {
          "folder": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      }
    },
    "prefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant",
          "prefix"
        ],
        "properties": {
          "variant": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "LaunchNamePrefixV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:[0-9#*]\\uFE0F?\\u20E3|\\p{Extended_Pictographic}|\\p{Emoji_Presentation})[^\\s/\\\\\\u0000-\\u001F\\u007F]*$(?![\\s\\S])"
    },
    "LaunchNameCasesV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "declarations"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "input": {},
              "accepted": {
                "type": "boolean"
              }
            }
          }
        },
        "declarations": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "block",
              "accepted",
              "prefix"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "block": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              },
              "prefix": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
