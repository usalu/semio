{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/registry/descriptor-verification/component.json",
  "title": "Registry Semantic Package Descriptor Admission V1",
  "description": "Admission policy for the committed SEMANTIC PackageDescriptor (the guest's own describe() answer) consumed by Registry verification: it carries no byte identity — the binding to shipped bytes lives in the generated ComponentReceiptV1 — and its execution protocol is the current host application channel.",
  "$ref": "#/$defs/PackageDescriptorV1",
  "$defs": {
    "RegistryPackageId": {
      "type": "string",
      "pattern": "^semio:[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 134
    },
    "RegistryPluginId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "RegistryLocalizedLabel": {
      "description": "🏷️ The plugin name in every terminology and locale (the `🖱️ui/🌐️locale/🧬️schema/🏷️localized-label` shape): no default language, no cell blank.",
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "reuse"],
      "properties": {
        "native": { "$ref": "#/$defs/RegistryLocalizedLabelRow" },
        "reuse": { "$ref": "#/$defs/RegistryLocalizedLabelRow" }
      }
    },
    "RegistryLocalizedLabelRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "de": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "PackageDescriptorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptorVersion",
        "packageId",
        "role",
        "manifest",
        "execution",
        "executionProtocol",
        "quotas",
        "contributions"
      ],
      "properties": {
        "descriptorVersion": {
          "const": 1
        },
        "packageId": {
          "$ref": "#/$defs/RegistryPackageId"
        },
        "role": {
          "enum": [
            "plugin",
            "extension"
          ]
        },
        "manifest": {
          "type": "object",
          "required": [
            "pluginId",
            "label",
            "version",
            "apps",
            "examples"
          ],
          "properties": {
            "pluginId": {
              "$ref": "#/$defs/RegistryPluginId"
            },
            "label": {
              "$ref": "#/$defs/RegistryLocalizedLabel"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "apps": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "activationEvents": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "const": "onStartupFinished"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "onCommand"
                ],
                "properties": {
                  "onCommand": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "onViewVisible"
                ],
                "properties": {
                  "onViewVisible": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "onFileType"
                ],
                "properties": {
                  "onFileType": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ext"
                    ],
                    "properties": {
                      "ext": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "onArtifactKind"
                ],
                "properties": {
                  "onArtifactKind": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "onExtensionRequest"
                ],
                "properties": {
                  "onExtensionRequest": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "point"
                    ],
                    "properties": {
                      "point": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "capabilityRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "extensionPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "execution": {
          "enum": [
            "declarative",
            "linked",
            "isolated",
            "exclusive",
            "cold"
          ]
        },
        "executionProtocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appChannelVersion"
          ],
          "properties": {
            "appChannelVersion": {
              "const": 25
            }
          }
        },
        "components": {
          "description": "The deployable components of a package whose apps close in more than one: each app of manifest.apps belongs to exactly one component, and a host loads only the component that owns the app an activation opens; an activation of no app runs on the first. Absent for a package of one component.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "apps"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9_-]+$"
              },
              "apps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "quotas": {
          "type": "object"
        },
        "contributions": {
          "type": "object",
          "properties": {
            "topicContributions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "topic"
                ],
                "properties": {
                  "topic": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
