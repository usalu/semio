{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "cancelAt",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "cancelAt": {
            "enum": [
              "final-allocation-before-service-initialization",
              "after-child-service-backing",
              "after-tool-service-backing",
              "during-large-absent-field"
            ]
          },
          "expected": {
            "type": "object",
            "required": [
              "published",
              "balanced"
            ],
            "additionalProperties": false,
            "properties": {
              "published": {
                "const": false
              },
              "balanced": {
                "const": true
              }
            }
          }
        }
      },
      "uniqueItems": true
    }
  }
}
