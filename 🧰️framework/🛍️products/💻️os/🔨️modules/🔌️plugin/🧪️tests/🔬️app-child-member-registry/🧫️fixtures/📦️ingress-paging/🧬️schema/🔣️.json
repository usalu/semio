{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "pageSlots", "maximumAdmissionBytes", "cases"],
  "properties": {
    "schema": { "const": "semio.owned-document.ingress-paging/v1" },
    "pageSlots": { "const": 8 }, "maximumAdmissionBytes": { "const": 262144 },
    "cases": { "type": "array", "minItems": 3, "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "entries", "frames", "pointerSlots"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "entries": { "type": "integer", "minimum": 0, "maximum": 1024 }, "frames": { "type": "array", "maxItems": 128, "items": { "type": "integer", "minimum": 1, "maximum": 8 } }, "pointerSlots": { "type": "integer", "minimum": 0, "maximum": 128 } }
    }}
  }
}
