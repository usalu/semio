{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "modes",
    "borrowedMethod",
    "ownedMethod",
    "predicate",
    "validator",
    "mutationValue"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "identity",
          "completion",
          "original",
          "cancelled",
          "mode",
          "followChildren",
          "cancellationScope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "boolean"
          },
          "completion": {
            "type": "boolean"
          },
          "original": {
            "type": "boolean"
          },
          "cancelled": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "borrowed",
              "owned",
              "refuse"
            ]
          },
          "followChildren": {
            "type": "boolean"
          },
          "cancellationScope": {
            "enum": [
              "none",
              "token",
              "document",
              "instance",
              "context"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "cancellationScope": {
                  "const": "none"
                }
              }
            },
            "then": {
              "properties": {
                "cancelled": {
                  "const": false
                }
              }
            },
            "else": {
              "properties": {
                "cancelled": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "borrowedMethod": {
      "type": "string",
      "minLength": 1
    },
    "ownedMethod": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "validator": {
      "type": "string",
      "minLength": 1
    },
    "mutationValue": {
      "type": "integer",
      "minimum": 1
    }
  }
}
