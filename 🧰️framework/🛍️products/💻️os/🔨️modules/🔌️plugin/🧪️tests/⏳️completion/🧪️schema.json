  "properties": {
    "version": { "const": 1 },
    "registration": { "type": "object", "additionalProperties": false, "required": ["attempts", "registeredEntries", "diagnostics", "diagnosticCode"], "properties": { "attempts": { "const": 2 }, "registeredEntries": { "const": 1 }, "diagnostics": { "const": 1 }, "diagnosticCode": { "const": "test.subset-macro.ok" } } },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["instance", "parkedRequests", "tasksAfterCancel", "requestsAfterCancel", "restartValue", "completionFaultCode", "completionFaultMessage"], "properties": { "instance": { "const": 507 }, "parkedRequests": { "const": 1 }, "tasksAfterCancel": { "const": 0 }, "requestsAfterCancel": { "const": 0 }, "restartValue": { "const": 7 }, "completionFaultCode": { "const": "plugin.request-registry" }, "completionFaultMessage": { "const": "request already consumed or unknown" } } },
