{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["maximumItems", "maximumBytes", "maximumTurns", "cases"],
  "properties": {
    "maximumItems": { "const": 1 }, "maximumBytes": { "const": 262144 }, "maximumTurns": { "const": 100000 },
    "cases": { "type": "array", "minItems": 2, "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parentTouched", "parentLabel", "childCount", "childLabel", "operations", "members"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "parentTouched": { "type": "boolean" },
        "parentLabel": { "type": "string" }, "childCount": { "type": "integer" }, "childLabel": { "type": "string" },
        "operations": { "type": "integer", "minimum": 2, "maximum": 3 }, "members": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    } }
  }
}
