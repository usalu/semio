{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "framework.plugin.lifecycle-grant",
  "type": "object",
  "required": ["schema", "grant", "demand", "refusalAxes", "progressAxes", "forwardOriginalGrant", "terminalWitnessRequired", "childCompletionKeepsParent"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "framework.plugin.lifecycle-grant"},
    "grant": {"type": "object", "required": ["maximumItems", "maximumCopyBytes", "maximumCapacityBytes", "maximumReleaseBytes", "maximumDepth"], "additionalProperties": false, "properties": {"maximumItems": {"type": "integer", "minimum": 0}, "maximumCopyBytes": {"type": "integer", "minimum": 0}, "maximumCapacityBytes": {"type": "integer", "minimum": 0}, "maximumReleaseBytes": {"type": "integer", "minimum": 0}, "maximumDepth": {"type": "integer", "minimum": 0}}},
    "demand": {"type": "object", "required": ["copyBytes", "capacityBytes", "releaseBytes", "depth"], "additionalProperties": false, "properties": {"copyBytes": {"type": "integer", "minimum": 0}, "capacityBytes": {"type": "integer", "minimum": 0}, "releaseBytes": {"type": "integer", "minimum": 0}, "depth": {"type": "integer", "minimum": 0}}},
    "refusalAxes": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["maximumItems", "maximumCopyBytes", "maximumCapacityBytes", "maximumReleaseBytes", "maximumDepth"]}},
    "progressAxes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["copiedItems", "copiedBytes", "retainedCapacityBytes", "releasedBytes"]}},
    "forwardOriginalGrant": {"const": true}, "terminalWitnessRequired": {"const": true}, "childCompletionKeepsParent": {"const": true}
  }
}
