{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:policy:raster-source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "acceptedIdentity",
    "cases",
    "scrubberCases",
    "obligations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "acceptedIdentity": {
      "const": "original"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "before",
          "after",
          "accepted",
          "category"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "enum": [
              "store",
              "raster",
              "editor",
              "plugin",
              "laws"
            ]
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scrubberCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "kept",
          "removed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "kept": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
