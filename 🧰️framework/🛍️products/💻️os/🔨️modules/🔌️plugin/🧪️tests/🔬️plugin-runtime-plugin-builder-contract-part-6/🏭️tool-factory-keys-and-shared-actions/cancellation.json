      "initial": false,
      "outcome": "refused",
      "expected": null
    },
    {
      "name": "Duplicate Proof Refuses",
      "surface": "app",
      "proof": "duplicate",
      "initial": false,
      "outcome": "refused",
      "expected": null
    },
    {
      "name": "Missing Migrated Proof Refuses",
      "surface": "window",
      "proof": "missing-migrated",
      "initial": false,
      "outcome": "refused",
      "expected": null
    },
    {
      "name": "Exact command",
      "surface": "command",
      "proof": "exact",
