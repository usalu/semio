{
  "type": "object",
  "required": [
    "schema",
    "formats",
    "capabilityGaps",
    "wireIngress"
  ],
  "properties": {
    "schema": {
      "const": "semio.framework.os.plugin.natural-file-lifecycle/v1"
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "appId",
          "formatKind",
          "extension",
          "mediaType",
          "binary"
        ],
        "additionalProperties": false,
        "properties": {
          "appId": {
            "type": "string",
            "pattern": "#editor$"
          },
          "formatKind": {
            "type": "string",
            "minLength": 1
          },
          "extension": {
            "type": "string",
            "pattern": "^\\."
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "binary": {
            "type": "boolean"
          }
        }
      }
    },
    "openCancellation": {
      "type": "object",
      "required": [
        "reason",
        "expectedOrder",
        "expectedCrossings"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expectedOrder": {
          "const": [
            "open",
            "submit",
            "cancel",
            "retire",
            "closed"
          ]
        },
        "expectedCrossings": {
          "const": [
            "media-in",
            "acknowledge",
            "read-document"
          ]
        }
      }
    },
    "openFailure": {
      "type": "object",
      "required": [
        "import",
        "retirement"
      ],
      "additionalProperties": false,
      "properties": {
        "import": {
          "type": "string",
          "minLength": 1
        },
        "retirement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilityGaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "appId",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "appId": {
            "type": "string",
            "pattern": "#editor$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "wireIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatKind",
        "commandBytes",
        "browserPayloadBytes",
        "nativePayloadBytes"
      ],
      "properties": {
        "formatKind": {
          "type": "string",
          "minLength": 1
        },
        "commandBytes": {
          "type": "integer",
          "minimum": 1
        },
        "browserPayloadBytes": {
          "type": "integer",
          "minimum": 1
        },
        "nativePayloadBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
