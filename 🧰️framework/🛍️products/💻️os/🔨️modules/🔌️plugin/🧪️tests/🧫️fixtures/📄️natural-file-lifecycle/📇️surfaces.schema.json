{
  "type": "object",
  "required": [
    "schema",
    "surfaces"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "semio.framework.os.plugin.source-surfaces/v1"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "owner",
          "editorApp",
          "viewerApp",
          "naturalFile"
        ],
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "editorApp": {
            "type": "string",
            "pattern": "#editor$"
          },
          "viewerApp": {
            "type": "string",
            "pattern": "#viewer$"
          },
          "naturalFile": {
            "enum": [
              "declared",
              "missing"
            ]
          }
        }
      }
    }
  }
}
