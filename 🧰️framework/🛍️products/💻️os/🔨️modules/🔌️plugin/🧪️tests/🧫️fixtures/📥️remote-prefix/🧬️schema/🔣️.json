{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps",
          "refused",
          "count",
          "notifications"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "enum": [
                "valid",
                "malformed",
                "duplicate"
              ]
            }
          },
          "refused": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "notifications": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
