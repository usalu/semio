{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "beforeSha256",
    "afterSha256",
    "thirdpartyPinsSha256",
    "package",
    "dependencies",
    "missingDirectFirstparty"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "beforeSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "afterSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "thirdpartyPinsSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "missingDirectFirstparty": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
