{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "package",
    "root",
    "original",
    "metadataTarget",
    "metadataLaw",
    "files",
    "aggregate",
    "macro",
    "publicCodecTypes",
    "dependencies"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "package": {
      "const": "semio-framework-plugin-surface-fixture"
    },
    "root": {
      "type": "string"
    },
    "original": {
      "type": "string"
    },
    "metadataTarget": {
      "type": "string"
    },
    "metadataLaw": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "assertions",
          "functions"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "assertions": {
            "type": "integer",
            "minimum": 0
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "sha256",
                "assertions",
                "law",
                "target"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "assertions": {
                  "type": "integer",
                  "minimum": 0
                },
                "law": {
                  "type": "boolean"
                },
                "target": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "lawName",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "lawName": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "sha256",
        "scopeReplacements"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scopeReplacements": {
          "const": 6
        }
      }
    },
    "publicCodecTypes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "features"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
