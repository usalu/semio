{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "macroSource",
    "trait",
    "consumer",
    "owners"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "macroSource": {
      "type": "string"
    },
    "trait": {
      "const": "ArtifactCanonicalJsonTree"
    },
    "consumer": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "package",
          "manifest",
          "sources"
        ],
        "properties": {
          "identifier": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
