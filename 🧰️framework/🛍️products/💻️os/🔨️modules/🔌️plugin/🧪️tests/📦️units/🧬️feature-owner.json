{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "original",
    "originalSha256",
    "records",
    "laws",
    "testsSha256",
    "remainingFunctions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "const": "semio-framework-plugin-declared-verdict"
    },
    "original": {
      "type": "string"
    },
    "originalSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "testsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "laws": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "assertions"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "assertions": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "remainingFunctions": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
