{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contract",
    "sameOriginalSource",
    "sameReadyGeneration",
    "opaqueAdmission",
    "admissionRetainedOnYield",
    "renewalBeforeStoreDonation",
    "repeatRenewalOnRetry",
    "states",
    "validationBeforeRenewal",
    "publicationGuards"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "contract": {
      "const": "framework.os.original-window-reset"
    },
    "sameOriginalSource": {
      "const": true
    },
    "sameReadyGeneration": {
      "const": true
    },
    "opaqueAdmission": {
      "const": true
    },
    "admissionRetainedOnYield": {
      "const": true
    },
    "renewalBeforeStoreDonation": {
      "const": true
    },
    "repeatRenewalOnRetry": {
      "const": false
    },
    "states": {
      "const": [
        {
          "phase": "candidate-valid",
          "candidate": true,
          "liveChanged": false,
          "admitted": false
        },
        {
          "phase": "renewal-pending",
          "candidate": true,
          "liveChanged": false,
          "admitted": false
        },
        {
          "phase": "ready-no-commit-fuel",
          "candidate": true,
          "liveChanged": false,
          "admitted": true
        },
        {
          "phase": "commit",
          "candidate": false,
          "liveChanged": true,
          "admitted": false
        }
      ]
    },
    "validationBeforeRenewal": {
      "const": true
    },
    "publicationGuards": {
      "const": [
        {
          "valid": false,
          "closing": false,
          "renew": false
        },
        {
          "valid": true,
          "closing": true,
          "renew": false
        },
        {
          "valid": true,
          "closing": false,
          "renew": true
        }
      ]
    }
  }
}
