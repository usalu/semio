{
  "name": "@semio-tech/framework-window-semantic-preview",
  "tags": [
    "framework",
    "plugin"
  ],
  "targets": {
    "verify-source": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🪟️window/🎚️config/🧬️preview",
