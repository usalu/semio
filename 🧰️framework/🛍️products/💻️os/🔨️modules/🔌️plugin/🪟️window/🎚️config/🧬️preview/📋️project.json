    "verify-native": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🪟️window/🎚️config/🧬️preview",
