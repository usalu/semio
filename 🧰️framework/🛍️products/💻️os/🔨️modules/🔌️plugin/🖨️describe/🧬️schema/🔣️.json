{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/describe/component.json",
  "title": "Semio OS Plugin Describe",
  "$defs": {
    "DescribeContractId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*/v[0-9]+$"
    },
    "DescribeLawId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "DescribeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "DescribeHex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "DescribeEnvironmentPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16384
        }
      ],
      "additionalItems": false
    },
    "FreshSourceEpochV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "toolchain",
        "environment",
        "legs",
        "files"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/DescribeContractId"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cargo",
            "rustc"
          ],
          "properties": {
            "cargo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "rustc": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        },
        "environment": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/DescribeEnvironmentPair"
          }
        },
        "legs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "package",
              "args"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "package": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32768,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "byteLength",
              "mode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "$ref": "#/$defs/DescribeSha256"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              }
            }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/FreshSourceEpochV1"
}
