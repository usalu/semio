{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maxOutputBytes", "diagnosticChars", "cases"],
  "properties": {
    "schema": {
      "const": "semio.plugin.fresh-process-laws/v1"
    },
    "maxOutputBytes": {
      "const": 67108864
    },
    "diagnosticChars": {
      "const": 6000
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mode", "stdout", "stderr", "exitCode", "reason", "diagnostic"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "mode": {
            "enum": ["exit", "missing", "cancel", "timeout", "flood", "pre-cancel"]
          },
          "stdout": {
            "type": "string",
            "maxLength": 1000
          },
          "stderr": {
            "type": "string",
            "maxLength": 1000
          },
          "exitCode": {
            "enum": [0, 101]
          },
          "reason": {
            "enum": ["exit", "spawn-error", "cancelled", "timeout", "output-limit"]
          },
          "diagnostic": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
