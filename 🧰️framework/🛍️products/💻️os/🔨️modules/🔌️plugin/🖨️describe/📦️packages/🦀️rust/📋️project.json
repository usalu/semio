{
  "name": "@semio-tech/os-plugin-describe-rs",
  "$schema": "../../../../../../🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🖨️describe/📦️packages/🦀️rust",
  "targets": {
    "build": {
      "executor": "repo:script",
      "inputs": [
        "production",
        "^production",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🖨️describe/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build --host-platform={hostPlatform}",
        "forwardAllArgs": false
      },
      "cache": true,
      "outputs": [],
      "metadata": {
        "semio": {
          "hostPlatformOutputsV1": {
            "version": 1,
            "outputs": {
              "darwin": [
                "{workspaceRoot}/.cache/b/p/m/browser/{options.env.SEMIO_BUILD_MODE}/tools/descriptor-emitter/darwin"
              ],
              "linux": [
                "{workspaceRoot}/.cache/b/p/m/browser/{options.env.SEMIO_BUILD_MODE}/tools/descriptor-emitter/linux"
              ],
              "win32": [
                "{workspaceRoot}/.cache/b/p/m/browser/{options.env.SEMIO_BUILD_MODE}/tools/descriptor-emitter/win32"
              ]
            }
          }
        }
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🖨️describe/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "describe": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🖨️describe/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts describe",
        "forwardAllArgs": true
      },
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "side-effecting", "reason": "mutates-workspace" }
        }
      }
    },
    "test-fresh-component": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "dependsOn": [],
      "options": {
        "command": "bun ./📜️script.ts test-fresh-component",
        "cwd": "{projectRoot}"
      },
      "metadata": {
        "workspaceCommand": [
          "test-fresh-component"
        ]
      }
    },
    "test-canonical-descriptor-pack": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "dependsOn": [],
      "options": {
        "command": "bun ./📜️script.ts test-canonical-descriptor-pack",
        "cwd": "{projectRoot}"
      },
      "metadata": {
        "workspaceCommand": [
          "test-canonical-descriptor-pack"
        ]
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🔏️hash/🟦️.ts",
      "sharedGlobals"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/✨️macros/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  }
}
