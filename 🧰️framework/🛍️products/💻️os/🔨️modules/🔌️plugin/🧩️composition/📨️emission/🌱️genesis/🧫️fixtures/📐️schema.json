{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "receipts",
    "ownerInput",
    "source",
    "initial",
    "patches",
    "phaseOrder",
    "cancelBeforeCommit",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "receipts": {
      "type": "object",
      "required": ["parentTouched", "groupId", "editIds", "copyOrder", "transactions"],
      "additionalProperties": false,
      "properties": {
        "parentTouched": {"const": [false, true]},
        "groupId": {"const": "group:私的-α"},
        "editIds": {"const": ["edit:parent-α", "edit:brep-β", "edit:model-γ"]},
        "copyOrder": {"const": [0, 1, 2]},
        "transactions": {"const": [null, {"id": "transaction:separate-δ", "tool": "tool:neutral"}]}
      }
    },
    "ownerInput": {
      "type": "object",
      "required": ["parentMutations", "childMutations", "cancelStops", "initialPack"],
      "additionalProperties": false,
      "properties": {
        "parentMutations": {"const": [19, 7, 3]},
        "childMutations": {"const": [17, 3, 9]},
        "cancelStops": {"const": [0, 1, 3, 17, 65]},
        "initialPack": {"const": {"ordered": [17, 3, 9]}}
      }
    },
    "source": {
      "type": "object",
      "required": [
        "slot",
        "childId",
        "reference",
        "actor",
        "maximumWorkItems",
        "maximumBorrowedBytes",
        "maximumDeclaredChildren",
        "maximumPhaseAllocationBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "const": "breps"
        },
        "childId": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "object",
          "required": [
            "artifactId",
            "dialect"
          ],
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "type": "string",
              "minLength": 1
            },
            "dialect": {
              "type": "object",
              "required": [
                "artifactKind",
                "standard",
                "subset"
              ],
              "additionalProperties": false,
              "properties": {
                "artifactKind": {
                  "type": "string",
                  "minLength": 1
                },
                "standard": {
                  "type": "string",
                  "minLength": 1
                },
                "subset": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "maximumWorkItems": {
          "const": 1
        },
        "maximumBorrowedBytes": {
          "const": 64
        },
        "maximumDeclaredChildren": {
          "const": 64
        },
        "maximumPhaseAllocationBytes": {
          "const": 262144
        }
      }
    },
    "initial": {
      "type": "object"
    },
    "patches": {
      "type": "object",
      "required": [
        "parent",
        "brep",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "parent": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "brep": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "model": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "phaseOrder": {
      "const": [
        "admit",
        "open",
        "prepareBrep",
        "prepareModel",
        "prepareParent",
        "stage",
        "commit",
        "adopt",
        "retire"
      ]
    },
    "cancelBeforeCommit": {
      "const": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "expected": {
      "type": "object"
    }
  }
}
