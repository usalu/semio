{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "groupIds",
    "transactions"
  ],
  "properties": {
    "groupIds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": ["string", "null"], "maxLength": 256 }
    },
    "actor": {
      "type": "string",
      "maxLength": 256
    },
    "transactions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 256
              },
              "tool": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        ]
      }
    }
  }
}
