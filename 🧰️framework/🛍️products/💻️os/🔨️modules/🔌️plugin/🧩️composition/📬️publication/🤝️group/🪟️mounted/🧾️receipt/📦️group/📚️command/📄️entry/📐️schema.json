{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "maximumCopyBytes",
    "maximumCapacityBytes",
    "locales",
    "terminologies",
    "timestamps",
    "invalidMillis",
    "cases",
    "cancelTurns",
    "largeLabelBytes"
  ],
  "additionalProperties": false,
  "properties": {
    "maximumCopyBytes": {
      "type": "integer",
      "const": 64
    },
    "maximumCapacityBytes": {
      "type": "integer",
      "const": 1048576
    },
    "locales": {
      "type": "array",
      "minItems": 1
    },
    "terminologies": {
      "type": "array",
      "minItems": 1
    },
    "timestamps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "millis",
          "iso"
        ],
        "properties": {
          "millis": {
            "type": "integer"
          },
          "iso": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          }
        }
      }
    },
    "invalidMillis": {
      "type": "array",
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1
    },
    "cancelTurns": {
      "type": "array",
      "minItems": 1
    },
    "largeLabelBytes": {
      "const": 8194
    }
  }
}
