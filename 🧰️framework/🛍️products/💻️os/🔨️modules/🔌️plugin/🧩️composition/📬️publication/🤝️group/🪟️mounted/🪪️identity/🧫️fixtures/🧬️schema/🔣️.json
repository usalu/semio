{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "copyBytes", "capacityBytes", "cases"],
  "properties": {
    "schema": { "const": "semio.mounted.private-child-group-identity/v1" },
    "copyBytes": { "const": 64 }, "capacityBytes": { "const": 70 },
    "cases": { "type": "array", "minItems": 3, "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parent", "actor", "revision", "instance", "operation", "expectedId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "parent": { "type": "string", "maxLength": 8192 }, "actor": { "type": "string", "maxLength": 8192 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "instance": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "operation": { "type": "integer", "minimum": 1 },
        "expectedId": { "type": "string", "pattern": "^group:[a-f0-9]{64}$" }
      }
    }}
  }
}
