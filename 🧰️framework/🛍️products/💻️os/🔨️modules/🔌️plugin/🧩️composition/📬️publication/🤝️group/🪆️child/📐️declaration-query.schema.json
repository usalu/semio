{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "declarations",
    "cases",
    "pageAdmissionCases",
    "completionCases"
  ],
  "properties": {
    "declarations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "standard",
          "subset"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "standard": {
            "type": "string"
          },
          "subset": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "matchOrdinal",
          "capacityReadyAfterOrdinals"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "matchOrdinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "capacityReadyAfterOrdinals": {
            "type": "array",
            "prefixItems": [
              {
                "const": false
              },
              {
                "const": false
              },
              {
                "const": true
              }
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "pageAdmissionCases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pages",
          "wholeBirthBytes",
          "deniedCapacityBytes",
          "outputOwnerReady",
          "copiedItems",
          "copiedBytes",
          "birthBytes",
          "freeBytes"
        ],
        "properties": {
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "wholeBirthBytes": {
            "type": "integer",
            "minimum": 0
          },
          "deniedCapacityBytes": {
            "type": "integer",
            "minimum": 0
          },
          "outputOwnerReady": {
            "const": false
          },
          "copiedItems": {
            "type": "integer",
            "minimum": 0
          },
          "copiedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "birthBytes": {
            "type": "integer",
            "minimum": 0
          },
          "freeBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "completionCases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "innerComplete",
          "outerReady",
          "complete"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "innerComplete": {
            "const": true
          },
          "outerReady": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
