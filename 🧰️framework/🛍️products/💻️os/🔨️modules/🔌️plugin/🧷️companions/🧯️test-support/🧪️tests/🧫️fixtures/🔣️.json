    }
  ],
  "trees": [
    {
      "id": "nested-children-in-declaration-order",
      "root": "owner/🦀️.rs",
      "files": {
        "owner/🦀️.rs": "#[path = \"alpha/🦀️.rs\"]\nmod alpha;\npub(crate) use alpha::*;\n#[cfg(any(test, not(test)))]\n#[path = \"🌱️seed/🦀️.rs\"]\npub mod beta;\nmod outer {\n    #[path = \"gamma/🦀️.rs\"]\n    pub(crate) mod gamma;\n}\n#[cfg(test)]\n#[path = \"🧪️tests/🔬️unit/🦀️.rs\"]\nmod unit;\n",
        "owner/alpha/🦀️.rs": "#[path = \"deep/🦀️.rs\"]\nmod deep;\npub fn alpha() {}\n",
        "owner/alpha/deep/🦀️.rs": "pub fn deep() {}",
        "owner/🌱️seed/🦀️.rs": "pub fn seed() {}\n",
        "owner/outer/gamma/🦀️.rs": "pub fn gamma() {}\n",
        "owner/🧪️tests/🔬️unit/🦀️.rs": "pub fn unit() {}\n"
      },
      "expected": [
        "owner/🦀️.rs",
        "owner/alpha/🦀️.rs",
        "owner/alpha/deep/🦀️.rs",
        "owner/🌱️seed/🦀️.rs",
        "owner/outer/gamma/🦀️.rs"
      ]
    },
    {
      "id": "hub-include-keeps-the-includer-directory",
      "root": "renderer/🦀️.rs",
      "files": {
        "renderer/🦀️.rs": "include!(\"📥️mounts/one/🦀️.rs\");\ninclude!(\"📥️mounts/two/🦀️.rs\");\n",
        "renderer/📥️mounts/one/🦀️.rs": "#[path = \"../../🛎️first/🦀️.rs\"]\nmod first;\n",
        "renderer/📥️mounts/two/🦀️.rs": "#[path = \"../../🛎️first/🦀️.rs\"]\nmod again;\n#[path = \"../../📮️second/🦀️.rs\"]\nmod second;\n#[path = \"../../../outside/🦀️.rs\"]\nmod outside;\n",
        "renderer/🛎️first/🦀️.rs": "pub fn first() {}\n",
        "renderer/📮️second/🦀️.rs": "pub fn second() {}",
        "outside/🦀️.rs": "pub fn outside() {}\n"
      },
      "expected": [
        "renderer/🦀️.rs",
        "renderer/📥️mounts/one/🦀️.rs",
        "renderer/🛎️first/🦀️.rs",
        "renderer/📥️mounts/two/🦀️.rs",
        "renderer/📮️second/🦀️.rs"
      ]
    },
