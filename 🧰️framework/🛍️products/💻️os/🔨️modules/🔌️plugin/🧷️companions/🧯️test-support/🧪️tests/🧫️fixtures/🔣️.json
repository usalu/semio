{
  "schemaVersion": 1,
  "children": [
    {
      "id": "plain-path-mount",
      "source": "#[path = \"alpha/🦀️.rs\"]\nmod alpha;\n",
      "expected": [
        {
          "path": "alpha/🦀️.rs",
          "modules": [],
          "via": "path"
        }
      ]
    },
    {
      "id": "attributes-and-visibility-in-any-order",
      "source": "#[cfg(test)]\n#[path = \"a/🦀️.rs\"]\npub(crate) mod a;\n#[path = \"b/🦀️.rs\"]\n#[cfg(not(test))]\npub mod b;\n#[doc = \"x\"] #[path = \"c/🦀️.rs\"] #[allow(dead_code)] pub(super) mod c;\n",
      "expected": [
        {
          "path": "a/🦀️.rs",
          "modules": [],
          "via": "path"
        },
        {
          "path": "b/🦀️.rs",
          "modules": [],
          "via": "path"
        },
        {
          "path": "c/🦀️.rs",
          "modules": [],
          "via": "path"
        }
      ]
    },
    {
      "id": "inline-module-nesting-is-kept",
      "source": "mod outer {\n    #[path = \"gamma/🦀️.rs\"]\n    pub(crate) mod gamma;\n    mod inner {\n        #[path = \"delta.rs\"]\n        mod delta;\n    }\n}\n#[path = \"renamed\"]\nmod relocated {\n    #[path = \"epsilon.rs\"]\n    mod epsilon;\n}\n",
      "expected": [
        {
          "path": "gamma/🦀️.rs",
          "modules": [
            "outer"
          ],
          "via": "path"
        },
        {
          "path": "delta.rs",
          "modules": [
            "outer",
            "inner"
          ],
          "via": "path"
        },
        {
          "path": "epsilon.rs",
          "modules": [
            "renamed"
          ],
          "via": "path"
        }
      ]
    },
    {
      "id": "decoys-are-not-mounts",
      "source": "// #[path = \"comment.rs\"] mod comment;\n/* #[path = \"block.rs\"] mod block; */\nconst TEXT: &str = \"#[path = \\\"string.rs\\\"] mod string;\";\nmod without_path;\nmacro_rules! m { () => { #[path = \"macro.rs\"] mod from_macro; }; }\nfn body() {\n    #[path = \"function.rs\"]\n    mod in_function {}\n}\nstruct Holder {\n    field: u8,\n}\n#[path = \"real.rs\"]\nmod real;\n",
      "expected": [
        {
          "path": "real.rs",
          "modules": [],
          "via": "path"
        }
      ]
    },
    {
      "id": "include-literal-items-are-children",
      "source": "include!(\"hub-one/🦀️.rs\");\n#[cfg(test)]\ninclude!(\"../../../tests/standalone/🦀️.rs\");\ninclude!(concat!(env!(\"OUT_DIR\"), \"/x.rs\"));\nstatic NAMES: &[&str] = &[\"a\", \"b\"];\n#[path = \"after.rs\"]\nmod after;\n",
      "expected": [
        {
          "path": "hub-one/🦀️.rs",
          "modules": [],
          "via": "include"
        },
        {
          "path": "../../../tests/standalone/🦀️.rs",
          "modules": [],
          "via": "include"
        },
        {
          "path": "after.rs",
          "modules": [],
          "via": "path"
        }
      ]
    },
    {
      "id": "items-between-mounts-are-skipped-whole",
      "source": "use std::fmt;\nconst TABLE: [u8; 3] = [1, 2, 3];\nimpl Holder {\n    fn f(&self) -> u8 { 1 }\n}\n#[path = \"first.rs\"]\nmod first;\nstruct Holder { a: u8 }\n#[derive(Debug)]\nenum Kind { A, B }\n#[path = \"second.rs\"]\npub mod second;\n",
      "expected": [
        {
          "path": "first.rs",
          "modules": [],
          "via": "path"
        },
        {
          "path": "second.rs",
          "modules": [],
          "via": "path"
        }
      ]
    }
  ],
  "refusals": [
    {
      "id": "ambiguous-path-attributes",
