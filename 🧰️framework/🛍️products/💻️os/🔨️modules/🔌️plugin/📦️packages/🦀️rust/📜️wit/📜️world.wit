package semio:framework;

interface types {
  record migrate-artifact-input {
    from-version: string,
    to-version: string,
    data: list<u8>,
  }

  record migrate-artifact-output {
    data: list<u8>,
  }

  variant plugin-error {
    fault(list<u8>),
  }

  enum inference-cache-mode {
    cold,
    incremental,
    bypass,
  }

  record inference-budget {
    allocation-bytes: u64,
    work-units: u64,
    recursion-depth: u32,
  }

  record inference-diagnostic {
    code: string,
    message: string,
    severity: string,
    parameters: list<tuple<string, string>>,
  }

  record inference-provenance {
    owner: string,
    inference-schema: string,
    algorithm-version: u32,
    policy-version: u32,
    source-dialect: string,
  }

  record artifact-inference-request {
    wire-version: u32,
    owner: string,
    artifact-kind: string,
    artifact-schema: string,
    artifact-schema-version: u32,
    document-schema: string,
    document-schema-version: u32,
    inference-schema: string,
    inference-schema-version: u32,
    algorithm-version: u32,
    policy-version: u32,
    revision: u64,
    generation: u64,
    source-dialect: string,
    policy: list<u8>,
    budgets: inference-budget,
    cancellation-id: string,
    previous-state: option<list<u8>>,
    requested-cache-mode: inference-cache-mode,
    canonical-payload: list<u8>,
  }

  record artifact-inference-result {
    wire-version: u32,
    owner: string,
    artifact-kind: string,
    artifact-schema: string,
    artifact-schema-version: u32,
    document-schema: string,
    document-schema-version: u32,
    inference-schema: string,
    inference-schema-version: u32,
    algorithm-version: u32,
    policy-version: u32,
    revision: u64,
    generation: u64,
    source-dialect: string,
    canonical-payload: list<u8>,
    diagnostics: list<inference-diagnostic>,
    provenance: inference-provenance,
    validity: string,
    quality: string,
    complete: bool,
    actual-cache-mode: inference-cache-mode,
    cancellation-id: string,
  }
}

interface plugin {
  use types.{
    migrate-artifact-input,
    migrate-artifact-output,
    plugin-error,
  };

  /// 📦️ `PluginManifest`, encoded as `store::pack_rt::encode_wire_value` bytes (the container-less
  /// dynamic-value grammar — see `pack::encode_record_body`) — no JSON string anywhere on this ABI.
  manifest: func() -> list<u8>;
  instantiate-app: func(app-id: string, instance-id: string) -> result<u32, plugin-error>;
  /// 🔀️ The single bidirectional entry point: a batched, synchronous duplex exchange. Each element of
  /// `commands` is one binary-encoded `protocol_channel::AppCommand`; the result is every
  /// `protocol_channel::AppFrame` produced by processing the batch, plus anything queued out of band
  /// since the previous call (pending effects, backbone-ingested `DocumentChanged`). `exchange(id, [])`
  /// is a pure drain — the heartbeat that replaces the old poll-backbone + refresh-ui tick. This
  /// subsumes and replaces the previous per-verb surface (`handle-action`, `handle-command`,
  /// `update-window`, `refresh-ui`, `context-menu`, `apply-mutations[-text]`,
  /// `read/load-app-document-{text,pack}`, `attach/detach-backbone`, `consume/produce-media`) — every
  /// UI interaction and every headless-runner interaction is just a forwarded `AppCommand` on this one
  /// call, so a workflow that wires apps together never needs a UI-mock API: it drives the exact same
  /// channel a live UI does.
  exchange: func(instance-id: u32, commands: list<list<u8>>) -> result<list<list<u8>>, plugin-error>;
  /// 📦️ `data` (both directions) is pack-container bytes (see `document-pack-files`, carried inside
  /// `AppFrame::Document`/`AppCommand::LoadDocument` on the channel now) — signature unchanged.
  migrate-artifact: func(input: migrate-artifact-input) -> result<migrate-artifact-output, plugin-error>;
  /// 🩹️ Clears the plugin's single-flight instance guard after a wasm trap skipped `Drop`. Hosts
  /// must only call this between serialized top-level calls — never while another call is in flight.
  clear-instance-guard: func();
  /// 📦️ Ticket 26/08/10/ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION (D3): this
  /// plugin's own composer roster, JSON-encoded `Vec<(ArtifactDialect, Vec<ArtifactDialect>)>`
  /// (`io::wire_list_composer_entries`) — one `(writes, reads)` row per registered `ComposerEntry`.
  /// The host calls this once per plugin at load time to build its cross-plugin `IoRouter`.
  list-artifact-dialects: func() -> list<u8>;
  /// 📦️ Composes `sources` into this plugin's own registry entry matching `key`. `key` is a
  /// JSON-encoded `io::IoKey`; `sources` is a JSON-encoded `Vec<io::WireComposeSource>`; the ok
  /// result is a JSON-encoded `io::WireComposedArtifact` (`io::wire_artifact_compose`). Only ever
  /// called for a key THIS plugin owns (the host router already resolved ownership before
  /// forwarding) — never falls through to `host.io-compose` itself, to keep cross-plugin routing
  /// one hop.
  artifact-compose: func(key: list<u8>, sources: list<u8>) -> result<list<u8>, plugin-error>;
  /// 💡️ Deterministic JSON wire roster of this plugin's executable artifact inference services.
  /// The host calls this once at plugin load and rejects conflicting ownership/version metadata.
  list-artifact-inferences: func() -> result<list<u8>, plugin-error>;
  /// 💡️ Typed versioned inference boundary with revision/generation, dialect, policy, finite
  /// budgets, cancellation, prior state, requested cache behavior, and canonical payloads.
  artifact-infer: func(request: artifact-inference-request) -> result<artifact-inference-result, plugin-error>;
}

interface extension {
  use types.{plugin-error};

  /// 📦️ ExtensionManifest encoded as store::pack_rt::encode_wire_value bytes.
  manifest: func() -> list<u8>;
  activate: func() -> result<_, plugin-error>;
  deactivate: func();
  /// 🔀️ Generic host-mediated call. `capability` selects the handler; request/result are wire-encoded bytes.
  invoke: func(capability: string, request: list<u8>) -> result<list<u8>, plugin-error>;
}

interface host {
  log: func(level: string, message: string);
  now-ms: func() -> s64;
  /// 📦️ `read-document`/`write-document` payloads are `store::pack_rt::encode_wire_value` bytes.
  read-artifact: func(handle: u64) -> result<list<u8>, list<u8>>;
  write-artifact: func(handle: u64, payload: list<u8>) -> result<_, list<u8>>;
  /// 📦️ `params` is a wire-encoded `DslValue` (`encode_wire_value`).
  open-window: func(kind: string, params: list<u8>) -> result<u64, list<u8>>;
  /// 📦️ `invocation`/`result` are wire-encoded `DslValue` blobs.
  invoke-action: func(target: string, invocation: list<u8>) -> result<list<u8>, list<u8>>;
  read-asset: func(handle: u64) -> result<list<u8>, list<u8>>;
  network-fetch: func(origin: string, path: string) -> result<list<u8>, list<u8>>;
  write-blob: func(data: list<u8>, media-type: string) -> result<string, list<u8>>;
  read-blob: func(hash: string) -> result<list<u8>, list<u8>>;
  /// 📦️ `message` is a `store::encode_backbone_message` blob (a binary `BackboneMessage`).
  backbone-send: func(uri: string, message: list<u8>) -> result<_, list<u8>>;
  backbone-poll: func(uri: string) -> result<list<list<u8>>, list<u8>>;
  backbone-status: func(uri: string) -> result<string, list<u8>>;
  /// Content-addressed engine derive — returns 32-byte EngineKey.
  engine-derive: func(engine-id: string, input: list<u8>) -> result<list<u8>, list<u8>>;
  /// Read engine cache output by engine-id + key bytes from engine-derive.
  engine-read: func(engine-id: string, key: list<u8>) -> result<list<u8>, list<u8>>;
  /// 📦️ Ticket 26/08/10/ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION (D3): every
  /// dialect coordinate ANY loaded plugin (not just this one) can move `artifact-kind` through in
  /// `direction` ("import"|"export"), JSON-encoded `Vec<io::ArtifactDialect>` — backs a guest-side
  /// `io_dispatch` fallback hook that needs to enumerate before it can pick a key to compose.
  io-dialects: func(artifact-kind: string, direction: string) -> result<list<u8>, list<u8>>;
  /// 📦️ Routes `key`/`sources` (same JSON shapes as `plugin.artifact-compose`) to whichever OTHER
  /// loaded plugin actually owns `key`, per the host's `IoRouter`. Refuses to route a call back
  /// into the CALLING plugin (reentrancy guard — see the host router implementation) and is only
  /// ever one hop: the plugin that receives the resulting `plugin.artifact-compose` call must not
  /// itself call `io-compose` again for the same request.
  io-compose: func(key: list<u8>, sources: list<u8>) -> result<list<u8>, list<u8>>;
  /// 🧩️ UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM (C1): resolves an `io::ArtifactLink` (`link` is that
  /// type's own binary/DSL-pack encoding) into the linked artifact's current pack bytes. WASI guests
  /// MUST NEVER resolve a link themselves (no guest has host-store access) — this is the ONE host
  /// import that exists for exactly that reason, mirroring `io-compose`'s "cross-plugin routing is a
  /// host concern, not a guest one" shape. Error is a plain `string` (not `list<u8>` Fault bytes,
  /// unlike every other function on this interface) — deliberate per this ticket's own signature
  /// spec; a full resolver (host-side `LinkResolver`/`LinkState` wiring, `🏪️store/🦀️component.rs`)
  /// is a later wave — a stub/passthrough host implementation is sufficient for this one.
  resolve-artifact-link: func(link: list<u8>) -> result<list<u8>, string>;
}

world plugin-world {
  import host;
  export plugin;
}

world extension-world {
  import host;
  export extension;
}
