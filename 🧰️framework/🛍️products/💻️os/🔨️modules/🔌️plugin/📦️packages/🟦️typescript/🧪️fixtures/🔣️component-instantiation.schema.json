{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Explicit Component Instance Ownership",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "calls", "expected"],
  "properties": {
    "component": { "type": "string", "minLength": 1 },
    "calls": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance", "delta"],
        "properties": { "instance": { "enum": [0, 1] }, "delta": { "type": "integer", "minimum": 0, "maximum": 4294967295 } }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleImportInstances", "instantiated", "results", "memory", "distinctMemories", "factoryHasNoModuleInstanceRoots", "automaticHasModuleInstanceRoots"],
      "properties": {
        "moduleImportInstances": { "const": 0 },
        "instantiated": { "const": 2 },
        "results": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
        "memory": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
        "distinctMemories": { "const": true },
        "factoryHasNoModuleInstanceRoots": { "const": true },
        "automaticHasModuleInstanceRoots": { "const": true }
      }
    }
  }
}
