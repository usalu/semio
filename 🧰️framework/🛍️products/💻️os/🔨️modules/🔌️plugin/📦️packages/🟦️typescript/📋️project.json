{
  "name": "@semio-tech/framework-plugin-web",
  "targets": {
    "test-tick-payload": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "command": "bun ./📜️script.ts test-tick-payload"
      }
    },
    "support": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "reads",
        "production",
        "browserBundleSources"
      ],
      "outputs": [
        "{workspaceRoot}/.cache/b/p/m/browser/{options.env.SEMIO_BUILD_MODE}/modules/🪞️vendor/🤝️bytecode-alliance/🪟️preview2-shim",
        "{workspaceRoot}/.cache/b/p/m/browser/{options.env.SEMIO_BUILD_MODE}/modules/🧵️shard"
      ],
      "options": {
        "command": "bun ./📜️script.ts support"
      },
      "dependsOn": []
    },
    "test-catalog-composition": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "command": "bun ./📜️script.ts test catalog-composition"
      }
    },
    "test-catalog-receivers": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "command": "bun ./📜️script.ts test catalog-receivers"
      }
    },
    "test-mounted-owner": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "command": "bun ./📜️script.ts test mounted-owner"
      }
    },
    "test-lifecycle": {
      "executor": "repo:script",
      "outputs": [],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "options": {
        "command": "bun ./📜️script.ts test lifecycle"
      }
    },
    "test-package-receipt": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "cache": true,
      "dependsOn": [],
      "options": {
        "command": "bun ./📜️script.ts test",
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/📥️receipt"
      },
      "outputs": [],
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "source"
          }
        }
      }
    },
    "test-original-guest-loan": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
