{
  "name": "@semio-tech/framework-plugin-web",
  "targets": {
    "test-tick-payload": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts test-tick-payload"
      }
    },
    "support": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "production",
        "browserBundleSources"
      ],
      "outputs": [
        "{projectRoot}/dist/🔌️plugin-modules/🪞️vendor/🤝️bytecode-alliance/🪟️preview2-shim",
        "{projectRoot}/dist/🔌️plugin-modules/🪞️vendor/🔤️guestslim-typst-fonts.bin",
        "{projectRoot}/dist/🔌️plugin-modules/🧵️shard",
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}/🔌️plugin-modules/🪞️vendor/🤝️bytecode-alliance/🪟️preview2-shim",
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}/🔌️plugin-modules/🪞️vendor/🔤️guestslim-typst-fonts.bin",
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}/🔌️plugin-modules/🧵️shard"
      ],
      "options": {
        "command": "bun ./📜️script.ts support"
      },
      "dependsOn": [
        "semio-framework-os-infinite:fonts"
      ]
    },
    "test-catalog-composition": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts test catalog-composition"
      }
    },
    "test-catalog-receivers": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts test catalog-receivers"
      }
    },
    "test-mounted-owner": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts test mounted-owner"
      }
    },
    "test-lifecycle": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default"
      ],
      "options": {
        "command": "bun ./📜️script.ts test lifecycle"
      }
    },
    "test-package-receipt": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "bun ./📜️script.ts test",
        "cwd": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/📥️receipt"
      },
      "outputs": [],
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "source"
          }
        }
      }
    },
    "test-original-guest-loan": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts test-original-guest-loan"
      },
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "source"
          }
        }
      }
    },
    "test-original-inference-wire-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts test-original-inference-wire-source"
      },
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "source"
          }
        }
      }
    }
  },
  "namedInputs": {
    "browserBundleSources": [
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🌐️browser-bundle/**/*.ts",
      "!{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🌐️browser-bundle/**/🧪️tests/**/*.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🧬️schema/📜️.wit"
    ],
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/**/*.{ts,json}"
    ]
  }
}
