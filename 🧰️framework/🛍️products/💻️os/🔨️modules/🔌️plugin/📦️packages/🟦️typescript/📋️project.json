{
  "name": "@semio-tech/framework-plugin-web",
  "targets": {
    "support-dev": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "browserBundleSources"
      ],
      "outputs": [
        "{projectRoot}/dist/dev/🔌️plugin-modules/🪞️vendor/🤝️bytecode-alliance/🪟️preview2-shim",
        "{projectRoot}/dist/dev/🔌️plugin-modules/🧵️shard"
      ],
      "options": {
        "command": "bun ./📜️script.ts support dev"
      }
    },
    "support-release": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "browserBundleSources"
      ],
      "outputs": [
        "{projectRoot}/dist/release/🔌️plugin-modules/🪞️vendor/🤝️bytecode-alliance/🪟️preview2-shim",
        "{projectRoot}/dist/release/🔌️plugin-modules/🧵️shard"
      ],
      "options": {
        "command": "bun ./📜️script.ts support release"
      }
    }
  },
  "namedInputs": {
    "browserBundleSources": [
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🌐️browser-bundle/**/*.ts",
      "!{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🌐️browser-bundle/**/🧪️tests/**/*.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🧫️fixtures/🛂️actor-exports/🔣️.json"
    ],
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/**/*.{ts,json}"
    ]
  }
}
