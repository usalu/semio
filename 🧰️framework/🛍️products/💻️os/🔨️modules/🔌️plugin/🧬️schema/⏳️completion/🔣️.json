{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.plugin.awaited-completion.fixture.v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "registration", "checkpoint", "restartAuthority", "transientClose", "ownerReturningRejection", "execution", "scope"],
  "properties": {
    "version": { "const": 1 },
    "registration": { "type": "object", "additionalProperties": false, "required": ["attempts", "registeredEntries", "diagnostics", "diagnosticCode"], "properties": { "attempts": { "const": 2 }, "registeredEntries": { "const": 1 }, "diagnostics": { "const": 1 }, "diagnosticCode": { "const": "test.subset-macro.ok" } } },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["instance", "parkedRequests", "tasksAfterCancel", "requestsAfterCancel", "restartValue", "completionFaultCode", "completionFaultMessage"], "properties": { "instance": { "const": 507 }, "parkedRequests": { "const": 1 }, "tasksAfterCancel": { "const": 0 }, "requestsAfterCancel": { "const": 0 }, "restartValue": { "const": 7 }, "completionFaultCode": { "const": "plugin.request-registry" }, "completionFaultMessage": { "const": "request already consumed or unknown" } } },
    "restartAuthority": { "const": { "tool": "applyCountFromTask", "generatedToolIds": ["compositeEdit", "applyCountFromTask"], "defaultProofs": 0, "retainedProofs": 1, "distinctConcreteOwners": true, "artifactPublications": 1, "uiPublications": 1, "uiScopes": 1, "terminalReceipts": 1, "closeItems": 1, "closeBytes": 4096 } },
    "transientClose": { "const": { "initiallyTerminal": false, "shortBytes": 4095, "originalAliveAfterHandoff": true, "originalAliveAfterRelease": false, "phases": ["retained", "released", "complete"], "foreignTerminal": false } },
    "ownerReturningRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "noImplicitRetry", "cases", "callers", "reservedCallers"],
      "properties": {
        "schema": { "const": "semio.plugin.artifact-tool-completion-rejection/v1" },
        "noImplicitRetry": { "const": true },
        "cases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "cell", "busy", "outcome", "finalCell", "submittedOwnerReturned"],
            "properties": {
              "id": { "enum": ["accepted", "duplicate", "busy"] },
              "cell": { "enum": ["empty", "existing"] },
              "busy": { "type": "boolean" },
              "outcome": { "enum": ["accepted", "rejected"] },
              "finalCell": { "enum": ["empty", "existing", "submitted"] },
              "submittedOwnerReturned": { "type": "boolean" }
            }
          }
        },
        "callers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "source", "terminalGuard", "legacyLossToken"],
            "properties": {
              "family": { "enum": ["puzzle", "draw", "writer"] },
              "source": { "type": "string", "minLength": 1 },
              "terminalGuard": { "type": "string", "minLength": 1 },
              "legacyLossToken": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reservedCallers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "source", "sourceStart", "sourceEnd", "terminalGuard", "retainedOwner", "incrementalClose", "legacyLossToken"],
            "properties": {
              "family": { "enum": ["puzzle5d-copy", "puzzle5d-cut", "puzzle5d-paste", "puzzle5d-import"] },
              "source": { "type": "string", "minLength": 1 },
              "sourceStart": { "type": "string", "minLength": 1 },
              "sourceEnd": { "type": "string", "minLength": 1 },
              "terminalGuard": { "type": "string", "minLength": 1 },
              "retainedOwner": { "type": "string", "minLength": 1 },
              "incrementalClose": { "type": "string", "minLength": 1 },
              "legacyLossToken": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "execution": { "const": ["await-registration-before-observation", "await-validator-before-diagnostics", "await-executor-before-checkpoint", "await-request-retirement-before-observation"] },
    "scope": { "type": "object", "additionalProperties": false, "required": ["nativeFixture", "retainedProductionRegistration", "guestCheckpointRuntime"], "properties": { "nativeFixture": { "const": true }, "retainedProductionRegistration": { "const": false }, "guestCheckpointRuntime": { "const": false } } }
  }
}
