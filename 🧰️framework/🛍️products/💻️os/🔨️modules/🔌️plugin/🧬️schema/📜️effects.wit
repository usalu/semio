package semio:framework@1.0.0;

/// 🧬️ MICROKERNEL-POOLED-ACTOR-PLUGIN-RUNTIME (A2, design-abi.md §2). Everything a guest asks the
/// host to do, returned in `reactor::turn-result.effects` — this interface has NO functions, only
/// the data `poll` carries out. Rust SSOT: `semio_framework::kernel::Effect` (packet A3); the WIT
/// variants mirror it field-for-field and the guest SDK glue converts between them (the same
/// pattern the old `ArtifactInferenceRequest` conversion already used).
///
/// 🗺️ CLEAN-ARTIFACT-STANDARD-SUBSET-MECHANISM absorption (packet A2, per `important.md`): the old
/// host imports `io-routes`/`io-identify` become `registry-query` (kind = "io-routes" |
/// "io-identify"); `io-run` (host, multi-hop) becomes its own `io-run` effect, distinct from the
/// existing single-plugin `io-compose` effect. The guest EXPORTS `io-run`/`io-sniff` (single hop,
/// local registry) do not appear here at all — they are absorbed into the cold job kinds
/// `semio.io-run`/`semio.io-sniff` (jobs.wit), not effects.
interface effects {
  use types.{pack, request-id, message-endpoint};
  use capabilities.{capability-id};

  record send-message-effect {
    target: message-endpoint,
    payload: pack,
  }
  record publish-event-effect {
    topic: string,
    payload: pack,
  }

  /// 🧬️ W0 (design-abi.md §1, SSOT mechanism): the payload half of `blob-load-effect`, extracted
  /// so a future async host import can take the same shape without the `req` correlation field.
  record blob-load-params {
    hash: string,
  }
  record blob-load-effect {
    req: request-id,
    params: blob-load-params,
  }
  /// 🧬️ W0: payload half of `blob-write-effect`, see `blob-load-params`.
  record blob-write-params {
    media-type: pack,
    bytes: pack,
  }
  record blob-write-effect {
    req: request-id,
    params: blob-write-params,
  }

  /// 🧬️ W0: payload half of `http-request-effect`, see `blob-load-params`. Named `http-params`
  /// rather than `http-request-params` per the packet's own worked example.
  record http-params {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: option<pack>,
    /// ⚠️ Named `streaming`, not `stream` — `stream` is a WIT-reserved keyword (`wit-parser`
    /// rejects it, discovered by packet B1's `cargo check -p semio-framework-plugin-host` failing
    /// to parse this whole WIT package at this exact line; same reserved-word class as the peer
    /// W1-D report's own `from`/`into` finding). `semio_framework::kernel::Effect::HttpRequest`'s
    /// Rust-side field stays named `stream` — only the WIT record field is renamed.
    streaming: bool,
  }
  record http-request-effect {
    req: request-id,
    params: http-params,
  }

  /// 🧬️ W0: payload half of `artifact-read-effect`, see `blob-load-params`.
  record artifact-read-params {
    doc: u64,
    lane: string,
  }
  record artifact-read-effect {
    req: request-id,
    params: artifact-read-params,
  }
  /// 🧬️ W0: payload half of `artifact-write-effect`, see `blob-load-params`.
  record artifact-write-params {
    doc: u64,
    lane: string,
    ops: pack,
  }
  record artifact-write-effect {
    req: request-id,
    params: artifact-write-params,
  }
  /// 🧬️ W0: NOT wrapped in a `-params` record — the payload is already a single named type
  /// (`pack`, the wire-value alias from `types.wit`), so a second layer around one already-
  /// nominal field would be pointless indirection.
  record link-resolve-effect {
    req: request-id,
    link: pack,
  }

  /// 🌉️ Absorbs the old `io-dialects`/`io-routes`/`io-identify` host imports: `kind` selects the
  /// query ("io-routes" | "io-identify" | "io-dialects"), `filter` is that query's JSON-encoded
  /// request (e.g. `{source, target}` for "io-routes"); the `event.completed` answer carries the
  /// JSON-encoded result the old synchronous import used to return directly.
  ///
  /// 🧬️ W0: payload half extracted into `registry-query-params`, see `blob-load-params`.
  record registry-query-params {
    kind: string,
    filter: pack,
  }
  record registry-query-effect {
    req: request-id,
    params: registry-query-params,
  }
  /// 🌉️ One-hop compose, unchanged semantics from the old `io-compose` host import: routes to
  /// whichever OTHER loaded plugin owns `key`, refusing (via `event.completed` fault) a route back
  /// into the calling plugin.
  ///
  /// 🧬️ W0: payload half extracted into `io-compose-params`, see `blob-load-params`.
  record io-compose-params {
    key: pack,
    sources: pack,
  }
  record io-compose-effect {
    req: request-id,
    params: io-compose-params,
  }
  /// 🌉️ Absorbs the old `io-run` host import: executes the WHOLE resolved `source -> target` route
  /// (however many plugins own its hops) — the guest never chains hops itself. Refuses the entire
  /// route (no partial execution) if the calling plugin owns any hop, per the preserved
  /// ≤3-hop/cycle-free/reentrancy-guard semantics `important.md` names.
  ///
  /// 🧬️ W0: payload half extracted into `io-run-params`, see `blob-load-params`.
  record io-run-params {
    source: string,
    target: string,
    payload: pack,
  }
  record io-run-effect {
    req: request-id,
    params: io-run-params,
  }

  /// 🧬️ W0: payload half of `cache-derive-effect`, see `blob-load-params`.
  record cache-derive-params {
    engine-id: string,
    input: pack,
  }
  record cache-derive-effect {
    req: request-id,
    params: cache-derive-params,
  }
  /// 🧬️ W0: payload half of `cache-read-effect`, see `blob-load-params`.
  record cache-read-params {
    engine-id: string,
    key: pack,
  }
  record cache-read-effect {
    req: request-id,
    params: cache-read-params,
  }

  /// 🧬️ W0: payload half of `open-window-effect`, see `blob-load-params`. The inner field is
  /// still named `params` (unchanged from before this refactor, it predates and is unrelated to
  /// the new outer `open-window-effect.params` field it now nests under).
  record open-window-params {
    kind: string,
    params: pack,
  }
  record open-window-effect {
    req: request-id,
    params: open-window-params,
  }
  record close-window-effect {
    window: u64,
  }
  /// 🧬️ W0: payload half of `dispatch-action-effect`, see `blob-load-params`.
  record dispatch-action-params {
    action: string,
    args: option<pack>,
    delay-ms: u64,
  }
  record dispatch-action-effect {
    req: request-id,
    params: dispatch-action-params,
  }
  /// 🔁️ Replaces `HostEffect::InvokeExtension` — `response_action` disappears; the SDK resumes the
  /// awaiting future on `event.completed` instead of re-dispatching a named action.
  ///
  /// 🧬️ W0: payload half extracted into `invoke-extension-params`, see `blob-load-params`.
  record invoke-extension-params {
    extension-id: string,
    capability: string,
    payload: pack,
  }
  record invoke-extension-effect {
    req: request-id,
    params: invoke-extension-params,
  }

  record notify-effect {
    message: string,
  }
  record clipboard-write-effect {
    fragment: pack,
  }
  record navigate-effect {
    uri: string,
  }
  record open-external-url-effect {
    url: string,
  }
  record set-panel-effect {
    panel-json: string,
  }
  record set-active-utility-effect {
    window-id: string,
    utility-id: string,
  }
  record set-active-tool-effect {
    tool-id: string,
  }
  record replay-shell-command-effect {
    action-id: string,
    args: option<pack>,
  }

  /// 🧬️ W0: payload half of `spawn-plugin-instance-effect`, see `blob-load-params`.
  record spawn-plugin-instance-params {
    plugin-id: string,
    app-id: string,
    os-instance-id: option<string>,
    label: option<string>,
    artifact-json: option<string>,
  }
  record spawn-plugin-instance-effect {
    req: request-id,
    params: spawn-plugin-instance-params,
  }
  record open-plugin-instance-effect {
    plugin-id: string,
    app-id: string,
    os-instance-id: option<string>,
  }
  /// 🧬️ W0: payload half of `open-dialog-effect`, see `blob-load-params`.
  record open-dialog-params {
    dialog-id: string,
    args: option<pack>,
  }
  record open-dialog-effect {
    req: request-id,
    params: open-dialog-params,
  }
  record icon-render-export-effect {
    items: pack,
  }
  record download-media-export-effect {
    filename: string,
    mime-type: string,
    data: string,
    encoding: option<string>,
  }
  /// 🎥️ `program` is a `pack` of `semio_framework::kernel::VideoRenderProgram` (`semio.video-render.program.v1`): the
  /// host renders it frame by frame, encodes H.264 in an MP4 and downloads it as `filename`.
  record video-render-export-effect {
    filename: string,
    program: pack,
  }
  /// 🧬️ W0: payload half of `request-file-open-effect`, see `blob-load-params`.
  record request-file-open-params {
    accept: string,
    read-as: option<string>,
    import-action: string,
    args: option<pack>,
    multiple: bool,
  }
  record request-file-open-effect {
    req: request-id,
    params: request-file-open-params,
  }
  /// 🧬️ W0: payload half of `request-media-frames-effect`, see `blob-load-params`.
  record request-media-frames-params {
    accept: string,
    frame-action: string,
    done-action: string,
    fallback-action: string,
    sample-stride: u32,
    max-frames: u32,
    max-long-edge-px: u32,
    fps-hint: f64,
    payload: option<string>,
    args: option<pack>,
  }
  record request-media-frames-effect {
    req: request-id,
    params: request-media-frames-params,
  }
  record load-document-effect {
    doc-pack: pack,
    spr: pack,
  }

  record set-timer-effect {
    id: u64,
    after-ms: u32,
    repeat: bool,
  }

  enum job-placement {
    inline,
    isolated,
    exclusive,
  }
  record spawn-job-effect {
    job: u64,
    kind: string,
    input: pack,
    placement: job-placement,
  }
  record cancel-job-effect {
    job: u64,
  }

  variant respond-result {
    ok(pack),
    fault(pack),
  }
  /// 🧬️ W0: NOT wrapped in a `-params` record — the payload is already a single named type
  /// (`respond-result`), so a second layer around one already-nominal field would be pointless
  /// indirection.
  record respond-effect {
    req: request-id,
    outcome: respond-result,
  }

  /// 🧬️ W0: payload half of `storage-read-effect`, see `blob-load-params`.
  record storage-read-params {
    key: string,
  }
  record storage-read-effect {
    req: request-id,
    params: storage-read-params,
  }
  /// 🧬️ W0: payload half of `storage-write-effect`, see `blob-load-params`.
  record storage-write-params {
    key: string,
    value: pack,
  }
  record storage-write-effect {
    req: request-id,
    params: storage-write-params,
  }
  /// 🧬️ W0: payload half of `storage-delete-effect`, see `blob-load-params`.
  record storage-delete-params {
    key: string,
  }
  record storage-delete-effect {
    req: request-id,
    params: storage-delete-params,
  }

  /// 🧬️ W0: payload half of `request-capability-effect`, see `blob-load-params`.
  record request-capability-params {
    id: capability-id,
    scope: string,
    reason: string,
    optional: bool,
  }
  record request-capability-effect {
    req: request-id,
    params: request-capability-params,
  }
  record release-capability-effect {
    id: capability-id,
  }

  record subscribe-effect {
    topic: string,
  }

  /// 💡️ An installed owner's operation bound to the shell's authenticated document scope.
  record request-service-operation-effect {
    owner: string,
    service-id: string,
    action: string,
    payload: pack,
  }

  variant effect {
    send-message(send-message-effect),
    publish-event(publish-event-effect),
    blob-load(blob-load-effect),
    blob-write(blob-write-effect),
    http-request(http-request-effect),
    artifact-read(artifact-read-effect),
    artifact-write(artifact-write-effect),
    link-resolve(link-resolve-effect),
    registry-query(registry-query-effect),
    io-compose(io-compose-effect),
    io-run(io-run-effect),
    cache-derive(cache-derive-effect),
    cache-read(cache-read-effect),
    open-window(open-window-effect),
    close-window(close-window-effect),
    dispatch-action(dispatch-action-effect),
    invoke-extension(invoke-extension-effect),
    notify(notify-effect),
    clipboard-write(clipboard-write-effect),
    navigate(navigate-effect),
    open-external-url(open-external-url-effect),
    set-panel(set-panel-effect),
    set-active-utility(set-active-utility-effect),
    set-active-tool(set-active-tool-effect),
    replay-shell-command(replay-shell-command-effect),
    spawn-plugin-instance(spawn-plugin-instance-effect),
    open-plugin-instance(open-plugin-instance-effect),
    open-dialog(open-dialog-effect),
    icon-render-export(icon-render-export-effect),
    download-media-export(download-media-export-effect),
    request-file-open(request-file-open-effect),
    request-media-frames(request-media-frames-effect),
    load-document(load-document-effect),
    request-sync,
    set-timer(set-timer-effect),
    spawn-job(spawn-job-effect),
    cancel-job(cancel-job-effect),
    respond(respond-effect),
    storage-read(storage-read-effect),
    storage-write(storage-write-effect),
    storage-delete(storage-delete-effect),
    request-capability(request-capability-effect),
    release-capability(release-capability-effect),
    subscribe(subscribe-effect),
    unsubscribe(subscribe-effect),
    request-service-operation(request-service-operation-effect),
    video-render-export(video-render-export-effect),
  }
}
