package semio:framework@1.0.0;

/// 🧬️ MICROKERNEL-POOLED-ACTOR-PLUGIN-RUNTIME (A2, design-abi.md §1). The one turn-loop entry
/// point every actor exports — replaces `exchange`, the poll-backbone + refresh-ui heartbeat, and
/// every per-verb surface (`handle-action`, `handle-command`, `update-window`, `refresh-ui`,
/// `context-menu`, `apply-mutations[-text]`, `read/load-app-document-{text,pack}`,
/// `attach/detach-backbone`, `consume/produce-media`). Rust SSOT for `budget`/`turn-status`/
/// `turn-result`: `semio_framework::kernel::{Budget, TurnResult}` (packet A3).
///
/// 🧬️ B1 world-collapse: `poll` itself is now `async func`, and the earlier "deliberately not
/// dependent on stackful-async component-model features" framing is RETIRED — S7 (terra-probe-
/// spikes) found a plain sync `func` EXPORT is callable on a Store with
/// `wasm_component_model_async(true)` only through `call_concurrent`, so the sync `stage-*` exports
/// are bound `async | store` on the host; every `async func` export flattens to at most 16 core
/// params (wit-bindgen frees no async param block), so oversized budgets arrive through those sync
/// stages instead. What `poll` still avoids is a SECOND long-lived call shape (the
/// deleted `runner::run`'s `stream<event>`) — it stays one call in, one `turn-result` out, it just
/// runs on an async-capable Store like every other export in this world.
interface reactor {
  use types.{plugin-error, pack, instance-id};
  use effects.{effect};
  use events.{event, original-media-loan, natural-source-loan};
  use ui.{ui-patch};
  use instance-lifetime.{lifetime, receipt, ui-patch-receipt};

  record retained-grant {
    maximum-items: u64,
    maximum-copy-bytes: u64,
    maximum-capacity-bytes: u64,
    maximum-release-bytes: u64,
    maximum-depth: u64,
  }
  record retained-progress {
    copied-items: u64,
    copied-bytes: u64,
    retained-capacity-bytes: u64,
    released-bytes: u64,
  }
  record original-actor-turn-work {
    clock-binding: u64,
    absolute-deadline-us: u64,
    fuel: u64,
  }
  record retained-turn-input {
    operation: u64,
    generation: u64,
    epoch: u64,
    work: original-actor-turn-work,
    grant: retained-grant,
  }
  record retained-turn-receipt {
    input: retained-turn-input,
    spent: retained-progress,
    work-units-spent: u64,
    remaining: retained-grant,
    remaining-fuel: u64,
  }
  enum actor-authority-refusal {
    invalid-value,
    canceled,
    ownership-limit,
    allocation-failed,
    work-limit,
    depth-limit,
    unsupported-owner,
    invariant-violated,
  }
  record actor-admission-call {
    input: retained-turn-input,
    spent: retained-progress,
    work-units-spent: u64,
    ready: bool,
    refusal: option<actor-authority-refusal>,
  }
  record actor-context-budget {
    input: retained-turn-input,
    retained-policy: retained-grant,
    fuel: u64,
    deadline-us: u64,
    cancelled: bool,
  }
  enum actor-input-disposition { borrowed, retained, returned }
  record actor-input-admission-call {
    input: retained-turn-input,
    spent: retained-progress,
    work-units-spent: u64,
    ready: bool,
    disposition: actor-input-disposition,
    returned-wire: option<list<u8>>,
    refusal: option<actor-authority-refusal>,
  }
  variant actor-call-failure {
    authority(actor-authority-refusal),
    semantic,
  }
  enum actor-failure-call-kind { allocate, deallocate, channel-version, checkpoint, restore, describe, cancel-job, admit-actor-input, publish-actor-failure, read-actor-failure, borrow-actor-failure, acknowledge-actor-failure-chunk, acknowledge-actor-failure, start-job, step-job, read-job-output, acknowledge-job-output, close-jobs, borrow-job-output, acknowledge-job-output-chunk, poll, admit-actor-context, close-actor-context, close-actor-output, pack-schema-hash, genesis, print-mirror, apply-ops, replay-envelopes, sqlite-schema, sqlite-export, sqlite-import, sqlite-take-payload, sqlite-take-file, sqlite-close, sqlite-retirement }
  record actor-failure-call-reference { failed-epoch: u64, call-kind: actor-failure-call-kind }
  record actor-failure-outcome { reference: actor-failure-call-reference, byte-length: u64 }
  record actor-failure-chunk { offset: u64, bytes: option<list<u8>>, output-closed: bool }
  record actor-failure-publish-call { input: retained-turn-input, spent: retained-progress, work-units-spent: u64, reference: actor-failure-call-reference, outcome: option<actor-failure-outcome>, refusal: option<actor-call-failure> }
  record actor-failure-read-call { input: retained-turn-input, spent: retained-progress, work-units-spent: u64, reference: actor-failure-call-reference, chunk: option<actor-failure-chunk>, refusal: option<actor-call-failure> }
  record actor-failure-ack-call { input: retained-turn-input, spent: retained-progress, work-units-spent: u64, reference: actor-failure-call-reference, acknowledged: bool, refusal: option<actor-call-failure> }
  record actor-call-refusal {
    input: retained-turn-input,
    spent: retained-progress,
    work-units-spent: u64,
    failure: actor-call-failure,
  }
  record actor-context-close-call {
    input: retained-turn-input,
    spent: retained-progress,
    work-units-spent: u64,
    complete: bool,
    blocked: bool,
    refusal: option<actor-authority-refusal>,
  }
  record budget {
    retained: retained-turn-input,
    retained-policy: retained-grant,
    work-fuel: u64,
    fuel: u64,
    deadline-us: u64,
    max-effects: u32,
    max-patch-bytes: u32,
    max-frames: u32,
  }
  record job-checkpoint {
    state: list<u8>,
    applied-progress: u64,
  }
  record command-page-cursor {
    owner: u64,
    generation: u64,
    command-index: u32,
    command-count: u32,
    instance: instance-id,
    seq: u64,
    kind: u8,
    page-index: u32,
    page-count: u32,
    item-count: u32,
    metadata: u32,
  }
  enum original-media-phase { begin, page, complete, cancel }
  enum original-media-result { retry, pending, accepted, stale, refused }
  record original-media-ack {
    loan: original-media-loan,
    owner: u64,
    seq: u64,
    kind: u8,
    extent: u32,
    phase: original-media-phase,
    page-index: option<u32>,
    %result: original-media-result,
  }

  enum natural-source-phase { prepare, begin, page, complete, cancel }
  enum natural-source-result { retry, pending, accepted, stale, refused }
  record natural-source-ack {
    loan: option<natural-source-loan>,
    owner: u64,
    seq: u64,
    kind: u8,
    extent: u32,
    phase: natural-source-phase,
    page-index: option<u32>,
    %result: natural-source-result,
  }

  record command-ingress-status {
    natural-source-ack: option<natural-source-ack>,
    original-media-ack: option<original-media-ack>,
    kind: u8,
    cursor: command-page-cursor,
    fault: list<u8>,
  }
  record cold-document-pair-frontier {
    document-id: string,
    head-edit-ordinal: u64,
    head-edit-id: string,
    last-commit-seq: u64,
    chain-sha256: list<u8>,
  }
  record cold-document-pair-header {
    lifetime: lifetime,
    transfer-generation: u64,
    descriptor-sha256: list<u8>,
    baseline-frontier: cold-document-pair-frontier,
    pack-sha256: list<u8>,
    spr-sha256: list<u8>,
    aggregate-sha256: list<u8>,
    pack-length: u64,
    spr-length: u64,
    page-count: u32,
  }
  record cold-document-pair-page {
    header: cold-document-pair-header,
    page-index: u32,
    bytes: list<u8>,
  }
  record cold-document-pair-cursor {
    lifetime: lifetime,
    transfer-generation: u64,
    page-index: u32,
    page-count: u32,
  }
  record cold-document-pair-applied {
    lifetime: lifetime,
    transfer-generation: u64,
    baseline-frontier: cold-document-pair-frontier,
    aggregate-sha256: list<u8>,
  }
  record cold-document-pair-fault {
    cursor: cold-document-pair-cursor,
    fault: list<u8>,
  }
  variant cold-pair-ingress-status {
    idle,
    page-accepted(cold-document-pair-cursor),
    backpressure(cold-document-pair-cursor),
    loading(cold-document-pair-cursor),
    applied(cold-document-pair-applied),
    fault(cold-document-pair-fault),
  }
  variant turn-status {
    idle,
    more-work,
    checkpoint-ready(job-checkpoint),
    faulted(list<u8>),
  }
  /// 👥️ One RENDER-PLANE presence signal produced by this turn — pack-encoded
  /// `contract-presence::PresenceUpdate`: addressed by `(surface, node-key)`, TTL-scoped, and
  /// carrying the emitter's own selection/hover plus any peer marks it derived.
  ///
  /// 🚦️ Ruling (sol, 26/08/20, unified program): this is deliberately NOT the replication
  /// `PresencePeer` roster shape it originally declared. The consumer of a turn result is the
  /// RENDERER, which needs presence keyed to the node it must decorate and expiring on its own
  /// clock; the collaboration ROSTER already has a dedicated channel in both directions
  /// (`ephemeral-snapshot` outbound, `app-command::presence` -> `adopt-presence` inbound), and
  /// shipping the whole roster on every turn would duplicate a plane that already works.
  ///
  /// ⛔️ Presence NEVER enters the document and never bumps a `revision`. A hover that produced a
  /// document revision would defeat the entire revisioned-patch protocol, so a turn whose only
  /// change is presence emits `presence` and an EMPTY `ui-patches`.
  record presence-update {
    update: pack,
  }
  record turn-result {
    retained-receipt: retained-turn-receipt,
    ui-patches: list<ui-patch>,
    effects: list<effect>,
    presence: list<presence-update>,
    next-wake: option<u64>,
    status: turn-status,
    fuel-used: u64,
    command-ingress: command-ingress-status,
    cold-pair-ingress: cold-pair-ingress-status,
    lifecycle-receipt: option<receipt>,
    ui-patch-receipt: option<ui-patch-receipt>,
  }
  /// 📥️ Hands the next `poll` the ONE command-ingress page it may admit. Staged rather than passed
  /// as a `poll` parameter, and carried as `bytes` rather than the fixed 64-block `byte-page.page`,
  /// for one measured reason: an ASYNC-LIFTED export whose parameters exceed the canonical ABI's
  /// 16 flat values is called through an indirect parameter area the caller allocates in guest
  /// memory with `cabi_realloc` — and `wit-bindgen`'s async lift never deallocates it
  /// (`wit-bindgen-core` `abi::call`, `if sig.indirect_params && !async_`). With the page by value
  /// `poll`'s area was 4 360 B, leaked on EVERY turn: the whole 512 MiB guest budget in ~118 000
  /// turns, which a browser boot reaches in about a minute (ticket
  /// 26/09/09/PROCEDURAL-3D-END-TO-END, `📓️guest-memory-retention-2026-09-10.md`). `cursor` plus a
  /// `list<u8>` is 13 flat values, so this call is passed directly and the bytes cross as a list the
  /// guest owns and drops.
  ///
  /// ⚖️ LAW: exactly one staged page per `poll`. Staging twice without an intervening turn is a host
  /// defect and faults here rather than silently replacing the page the guest has not read yet.
  stage-command-page: async func(cursor: command-page-cursor, bytes: list<u8>) -> result<_, plugin-error>;

  /// 🧊️ Hands the next `poll` the ONE cold document-pair page it may admit — same staging contract
  /// and the same reason as `stage-command-page`; SYNC like `stage-actor-context-budget`, because the page flattens to 26
  /// core values and `wit-bindgen` frees the indirect parameter area of sync exports only.
  stage-cold-pair-page: func(page: cold-document-pair-page) -> result<_, plugin-error>;

  /// 🎚️ Stages the ONE `actor-context-budget` the next `admit-actor-context`, `admit-actor-input`, `close-actor-context`,
  /// `close-actor-output`, `poll`, `checkpoint`, `restore`, `describe` or `codec` call consumes. Staged rather than passed
  /// for the reason `stage-command-page` states, and it is a SYNC export on purpose: the budget flattens to 19 core values,
  /// so it crosses through an indirect parameter area, and `wit-bindgen` frees that area for sync exports only
  /// (bytecodealliance/wit-bindgen#1757). Every async export below therefore flattens to at most
  /// `MAX_FLAT_ASYNC_PARAMS` (16) values and is called directly; a budget on an async signature leaked 152 to 168 B of guest
  /// linear memory per call (ticket 26/09/01/SOURCING-END-TO-END, `🧯️async-param-leak.md`). The law
  /// `every async func flattens to at most 16 core params` pins it for every schema in this directory.
  ///
  /// ⚖️ LAW: exactly one staged budget per consuming call, taken at its synchronous entry. A consuming call with no staged
  /// budget is refused as cancelled with an empty grant, and the host stages immediately before each call it makes.
  stage-actor-context-budget: func(budget: actor-context-budget);

  /// 📥️ Tagged ActorInput admission owns every command, event and cold pair until its actual return proof.
  admit-actor-context: async func() -> actor-admission-call;
  admit-actor-input: async func(wire: option<list<u8>>) -> actor-input-admission-call;
  close-actor-context: async func() -> actor-context-close-call;
  close-actor-output: async func() -> actor-context-close-call;
  /// ▶️ Poll consumes only its already admitted tagged input under the same authenticated scope.
  poll: async func() -> result<turn-result, actor-call-refusal>;

  /// 🤝️ The app-channel version this guest was compiled for (`CHANNEL_VERSION`). A host reads it exactly once, right after
  /// instantiation and before any frame, and refuses a guest of another version with `plugin.channel-mismatch`: the frame layout
  /// is versioned as a whole, so a stale component is never misread under a stale or forged descriptor. `async` like every export
  /// of `world actor`; the owned ABI's twin is `semio_owned_channel_version_v1`.
  channel-version: async func() -> u32;
}
