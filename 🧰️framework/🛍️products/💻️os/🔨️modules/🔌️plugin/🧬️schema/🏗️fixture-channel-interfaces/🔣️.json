{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.os.fixture-channel-interfaces/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "originalSource",
    "originalSha256",
    "canonicalHandles",
    "channels"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "const": "🦀️.rs"
    },
    "originalSource": {
      "type": "string",
      "minLength": 1
    },
    "originalSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonicalHandles": {
      "const": [
        "semio_framework_2d",
        "compute",
        "EngineHandles"
      ]
    },
    "channels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot",
          "diff",
          "mutation",
          "leafOwner",
          "command",
          "editor",
          "viewer",
          "dialect",
          "schema"
        ],
        "properties": {
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "diff": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "type": "string",
            "minLength": 1
          },
          "leafOwner": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "editor": {
            "type": "string",
            "minLength": 1
          },
          "viewer": {
            "type": "string",
            "minLength": 1
          },
          "dialect": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
