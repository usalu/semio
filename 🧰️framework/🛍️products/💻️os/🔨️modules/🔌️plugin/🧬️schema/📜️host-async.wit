package semio:framework@1.0.0;

/// 🧬️ MICROKERNEL-POOLED-ACTOR-PLUGIN-RUNTIME (B1 world-collapse). `world actor`'s async import
/// surface — WASI 0.3-style async counterpart to
/// `effects.wit`'s completable variants (`req: request-id` payloads): every function below takes
/// the SAME `*-params` record `effects` already carries — the whole point of the W0 `-params`
/// refactor was to let this import and the poll-world `effect` case share one payload shape and
/// never drift, verified mechanically by `🖥️host/🪞️schema-parity/🦀️.rs`. The `req`
/// correlation field itself disappears here: the returned future IS the correlation, so callers
/// never allocate a `request-id` for these calls. Every `err` side stays the same packed fault
/// bytes `event.completed`'s `completion-result::fault` already carries.
///
/// 🌊️ `http-fetch`/`blob-read` return a host-written `stream<u8>` body — this is what actually
/// fixes the poll bridge's gap (`⚛️reactor/🦀️.rs`'s `Event::HttpChunk` handler only keeps
/// the FINAL chunk, `done == true`, silently discarding every earlier one); `blob-load` stays
/// buffered for small blobs, `blob-read` is the streaming counterpart for large ones.
///
/// 🚪️ `emit`/`emit-patch` are the ONE fire-and-forget door for everything that carries no `req`,
/// plus the one deliberate `req`-bearing exception, `respond` (see `effects.wit`'s `respond-effect`
/// doc comment: `respond` answers a HOST-issued `request` event, it does not await a HOST-issued
/// completion of its own, so it stays one-way through `emit` rather than gaining a dedicated async
/// import). `cancel-request` (guest future-drop → host cancellation) is deliberately NOT added
/// here — it belongs to the packet that builds the async runtime adapter, where guest future-drop
/// actually maps onto it.
interface host-async {
  use types.{pack};
  use effects.{
    storage-read-params, storage-write-params, storage-delete-params,
    blob-load-params, blob-write-params,
    http-params,
    artifact-read-params, artifact-write-params,
    registry-query-params, io-compose-params, io-run-params,
    cache-derive-params, cache-read-params,
    invoke-extension-params, open-window-params, open-dialog-params,
    dispatch-action-params, spawn-plugin-instance-params,
    request-file-open-params, request-media-frames-params,
    request-capability-params, job-placement, effect,
  };
  use ui.{ui-patch};

  /// 🌊️ The envelope `http-fetch` resolves to — `body` streams so the guest can start consuming
  /// before the response finishes, replacing the poll world's `http-chunk` event entirely.
  record http-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: stream<u8>,
  }

  storage-read: async func(params: storage-read-params) -> result<option<pack>, pack>;
  storage-write: async func(params: storage-write-params) -> result<_, pack>;
  storage-delete: async func(params: storage-delete-params) -> result<_, pack>;

  blob-load: async func(params: blob-load-params) -> result<pack, pack>;
  blob-write: async func(params: blob-write-params) -> result<pack, pack>;
  blob-read: async func(hash: string) -> result<stream<u8>, pack>;

  http-fetch: async func(params: http-params) -> result<http-response, pack>;

  artifact-read: async func(params: artifact-read-params) -> result<pack, pack>;
  artifact-write: async func(params: artifact-write-params) -> result<pack, pack>;

  link-resolve: async func(link: pack) -> result<pack, pack>;

  registry-query: async func(params: registry-query-params) -> result<pack, pack>;
  io-compose: async func(params: io-compose-params) -> result<pack, pack>;
  io-run: async func(params: io-run-params) -> result<pack, pack>;

  cache-derive: async func(params: cache-derive-params) -> result<pack, pack>;
  cache-read: async func(params: cache-read-params) -> result<pack, pack>;

  invoke-extension: async func(params: invoke-extension-params) -> result<pack, pack>;

  open-window: async func(params: open-window-params) -> result<pack, pack>;
  open-dialog: async func(params: open-dialog-params) -> result<pack, pack>;
  dispatch-action: async func(params: dispatch-action-params) -> result<pack, pack>;
  spawn-plugin-instance: async func(params: spawn-plugin-instance-params) -> result<pack, pack>;
  request-file-open: async func(params: request-file-open-params) -> result<pack, pack>;
  request-media-frames: async func(params: request-media-frames-params) -> result<pack, pack>;
  request-capability: async func(params: request-capability-params) -> result<pack, pack>;

  /// 🧬️ Not wrapped in a `*-params` record — `spawn-job-effect` never was one (job completion
  /// correlates by `job: u64`, not `req: request-id`, so it fell outside the W0 refactor). Takes
  /// the exact same four fields `spawn-job-effect` already carries, no new payload shape invented.
  spawn-job: async func(job: u64, kind: string, input: pack, placement: job-placement) -> result<pack, pack>;

  /// 🚪️ The single fire-and-forget door for the ~24 one-way `effect` variants (and `respond`) —
  /// takes the whole existing `effect` variant rather than growing a hand-written signature per
  /// case.
  emit: func(value: effect);
  emit-patch: func(patch: ui-patch);
}
