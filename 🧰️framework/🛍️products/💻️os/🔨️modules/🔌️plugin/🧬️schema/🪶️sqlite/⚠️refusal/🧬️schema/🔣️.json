{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQLite Snapshot Rejection",
  "$ref": "#/$defs/rejection",
  "$defs": {
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "diagnostics"
      ],
      "properties": {
        "kind": {
          "enum": [
            "invalidValue",
            "canceled",
            "ownershipLimit",
            "allocationFailed",
            "workLimit",
            "depthLimit",
            "unsupportedOwner",
            "invariantViolated"
          ]
        },
        "message": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
