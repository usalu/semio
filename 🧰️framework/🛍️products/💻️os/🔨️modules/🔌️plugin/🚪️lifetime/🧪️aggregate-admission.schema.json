{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.plugin.native-aggregate-admission.fixture.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "registry", "beforeDetach", "descendants", "terminal"],
  "properties": {
    "version": {"const": 1},
    "scope": {"const": {"nativeAggregateMounted": false, "nativeLayoutMeasured": false, "allocatorFailureExecuted": false, "strictCallbackTimingProven": false}},
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "logicalSlots", "initializationGrantBytes", "injectedLayouts", "allocatorOvershoot"],
      "properties": {
        "owner": {"const": "PluginRuntime::RuntimeInstanceRegistry"},
        "logicalSlots": {"const": 1024}, "initializationGrantBytes": {"const": 4096},
        "injectedLayouts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["slotBytes", "allocationGrantBytes", "allocationCalls", "requestedBytes", "initializationTurns"],
          "properties": {"slotBytes": {"type": "integer", "minimum": 1}, "allocationGrantBytes": {"$ref": "#/definitions/bytes"}, "allocationCalls": {"enum": [0, 1]}, "requestedBytes": {"$ref": "#/definitions/bytes"}, "initializationTurns": {"$ref": "#/definitions/bytes"}}
        }},
        "allocatorOvershoot": {"const": {"requestedBytes": 16384, "actualBytes": 20480, "admittedBytes": 16384, "retainedBytes": 20480, "appConstructed": false}}
      }
    },
    "beforeDetach": {
      "type": "object", "additionalProperties": false, "required": ["required", "cases"],
      "properties": {
        "required": {"const": ["RuntimeCloseWorkerState", "runtime.close_quarantine", "REACTOR_CLOSES", "PATCHES", "PENDING_PATCHES", "COMMAND_INGRESS", "JOB_RENDER_BINDINGS", "PRESENCE", "return-source"]},
        "cases": {"type": "array", "minItems": 12, "maxItems": 12, "items": {
          "type": "object", "additionalProperties": false, "required": ["missing", "sameCapturedKey", "generationAvailable", "detach"],
          "properties": {"missing": {"type": "array", "uniqueItems": true, "items": {"enum": ["RuntimeCloseWorkerState", "runtime.close_quarantine", "REACTOR_CLOSES", "PATCHES", "PENDING_PATCHES", "COMMAND_INGRESS", "JOB_RENDER_BINDINGS", "PRESENCE", "return-source"]}}, "sameCapturedKey": {"type": "boolean"}, "generationAvailable": {"type": "boolean"}, "detach": {"type": "boolean"}}
        }}
      }
    },
    "descendants": {
      "type": "object", "additionalProperties": false,
      "required": ["resumeLogicalCapBytes", "fields", "logicalBytes", "physicalCapacityBytes", "retirementGrants", "emptyReservedFieldStillOwnsBacking"],
      "properties": {
        "resumeLogicalCapBytes": {"const": 196608},
        "fields": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["owner", "length", "capacity"], "properties": {"owner": {"enum": ["PendingResume.meta.actor", "TaskResumeOutcome.Emit.artifact_ops", "TaskResumeOutcome.Emit.config_ops", "TaskResumeOutcome.Emit.draft_ops", "InstanceMetadata.app_id"]}, "length": {"$ref": "#/definitions/bytes"}, "capacity": {"$ref": "#/definitions/bytes"}}}},
        "logicalBytes": {"$ref": "#/definitions/bytes"}, "physicalCapacityBytes": {"$ref": "#/definitions/bytes"}, "retirementGrants": {"const": [0, 1, 64, 4096]}, "emptyReservedFieldStillOwnsBacking": {"const": true}
      }
    },
    "terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["ready", "cases", "lateVerdictKeepsReleasedShellWitness", "faultDoesNotEraseStructuralOwner"],
      "properties": {
        "ready": {"const": {"appEmpty": true, "pumpEmpty": true, "descendantsEmpty": true, "schedulingRevoked": true, "queuedCallbacks": 0, "runningCallbacks": 0, "quarantineAlias": false, "shellReleased": true, "elapsedUs": 7999}},
        "cases": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["name", "changes", "ackConsumed"], "properties": {"name": {"type": "string", "minLength": 1}, "changes": {"$ref": "#/definitions/terminalFields"}, "ackConsumed": {"type": "boolean"}}}},
        "lateVerdictKeepsReleasedShellWitness": {"const": true}, "faultDoesNotEraseStructuralOwner": {"const": true}
      }
    }
  },
  "definitions": {
    "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "terminalFields": {"type": "object", "additionalProperties": false, "properties": {"appEmpty": {"type": "boolean"}, "pumpEmpty": {"type": "boolean"}, "descendantsEmpty": {"type": "boolean"}, "schedulingRevoked": {"type": "boolean"}, "queuedCallbacks": {"$ref": "#/definitions/bytes"}, "runningCallbacks": {"$ref": "#/definitions/bytes"}, "quarantineAlias": {"type": "boolean"}, "shellReleased": {"type": "boolean"}, "elapsedUs": {"type": ["integer", "null"], "minimum": 0}}}
  }
}
