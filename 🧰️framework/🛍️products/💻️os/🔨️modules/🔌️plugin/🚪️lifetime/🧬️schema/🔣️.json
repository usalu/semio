{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/plugin/lifetime/component.json",
  "title": "Semio OS Plugin Lifetime",
  "$defs": {
    "DetachParticipant": {
      "enum": [
        "RuntimeCloseWorkerState",
        "runtime.close_quarantine",
        "REACTOR_CLOSES",
        "PATCHES",
        "PENDING_PATCHES",
        "COMMAND_INGRESS",
        "JOB_RENDER_BINDINGS",
        "PRESENCE",
        "return-source"
      ]
    },
    "LifetimeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "TerminalFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appEmpty": {
          "type": "boolean"
        },
        "pumpEmpty": {
          "type": "boolean"
        },
        "descendantsEmpty": {
          "type": "boolean"
        },
        "schedulingRevoked": {
          "type": "boolean"
        },
        "queuedCallbacks": {
          "$ref": "#/$defs/LifetimeBytes"
        },
        "runningCallbacks": {
          "$ref": "#/$defs/LifetimeBytes"
        },
        "quarantineAlias": {
          "type": "boolean"
        },
        "shellReleased": {
          "type": "boolean"
        },
        "elapsedUs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "$ref": "#/$defs/TerminalFields"
}
