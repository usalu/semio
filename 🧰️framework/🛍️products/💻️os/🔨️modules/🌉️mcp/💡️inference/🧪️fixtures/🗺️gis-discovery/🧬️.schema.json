{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.mcp.gis-inference-discovery/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["declared"],
  "properties": {
    "declared": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "artifactKind", "artifactSchema", "artifactSchemaVersion", "documentSchema", "documentSchemaVersion", "inferenceSchema", "inferenceSchemaVersion", "algorithmVersion", "policyVersion", "contributor", "dependsOn"],
        "properties": {
          "owner": { "const": "gis" },
          "artifactKind": { "const": "s.gis.gismap" },
          "artifactSchema": { "const": "s.gis.gismap" },
          "artifactSchemaVersion": { "const": 1 },
          "documentSchema": { "const": "gis.map" },
          "documentSchemaVersion": { "const": 1 },
          "inferenceSchema": { "const": "s.gis.gismap.inference" },
          "inferenceSchemaVersion": { "const": 1 },
          "algorithmVersion": { "const": 1 },
          "policyVersion": { "const": 1 },
          "contributor": { "const": "gis" },
          "dependsOn": { "type": "array", "maxItems": 0 }
        }
      }
    }
  }
}
