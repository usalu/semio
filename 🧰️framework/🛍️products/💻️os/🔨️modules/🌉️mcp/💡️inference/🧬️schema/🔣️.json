{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/mcp/inference/component.json",
  "title": "Semio OS MCP Inference Discovery",
  "$defs": {
    "InferenceIdV1": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "InferenceVersionV1": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "DeclaredInferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "artifactKind",
        "artifactSchema",
        "artifactSchemaVersion",
        "documentSchema",
        "documentSchemaVersion",
        "inferenceSchema",
        "inferenceSchemaVersion",
        "algorithmVersion",
        "policyVersion",
        "contributor",
        "dependsOn"
      ],
      "properties": {
        "owner": { "$ref": "#/$defs/InferenceIdV1" },
        "artifactKind": { "$ref": "#/$defs/InferenceIdV1" },
        "artifactSchema": { "$ref": "#/$defs/InferenceIdV1" },
        "artifactSchemaVersion": { "$ref": "#/$defs/InferenceVersionV1" },
        "documentSchema": { "$ref": "#/$defs/InferenceIdV1" },
        "documentSchemaVersion": { "$ref": "#/$defs/InferenceVersionV1" },
        "inferenceSchema": { "$ref": "#/$defs/InferenceIdV1" },
        "inferenceSchemaVersion": { "$ref": "#/$defs/InferenceVersionV1" },
        "algorithmVersion": { "$ref": "#/$defs/InferenceVersionV1" },
        "policyVersion": { "$ref": "#/$defs/InferenceVersionV1" },
        "contributor": { "$ref": "#/$defs/InferenceIdV1" },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/InferenceIdV1" } }
      }
    },
    "InferenceDiscoveryRosterV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared"],
      "properties": {
        "declared": { "type": "array", "items": { "$ref": "#/$defs/DeclaredInferenceV1" } }
      }
    },
    "InferenceBindingCancellationLawV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "law", "cancelAnswerCeilingMs", "phases", "cases"],
      "properties": {
        "$schema": { "type": "string", "minLength": 1 },
        "law": { "type": "string", "minLength": 1 },
        "cancelAnswerCeilingMs": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "phases": { "$ref": "https://json.schemas.assets.semio-tech.com/os/mcp/workspace/component.json#/$defs/SessionActivationPhasesV1" },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cancelAt", "expected", "rebindMatchesUncancelled"],
            "properties": {
              "cancelAt": { "oneOf": [{ "$ref": "https://json.schemas.assets.semio-tech.com/os/mcp/workspace/component.json#/$defs/SessionActivationPhaseV1" }, { "type": "null" }] },
              "expected": { "enum": ["CANCELLED", "BOUND"] },
              "rebindMatchesUncancelled": { "type": "boolean" }
            }
          }
        }
      }
    },
    "InferenceExecutionSiteV1": {"enum": ["guest", "hub"]},
    "InferenceRouteV1": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"},
    "HubInferenceServiceV1": {"type": "object", "additionalProperties": false, "required": ["serviceId", "route"], "properties": {"serviceId": {"$ref": "#/$defs/InferenceIdV1"}, "route": {"$ref": "#/$defs/InferenceRouteV1"}}},
    "InferenceJobStateV1": {"enum": ["accepted", "running", "succeeded", "failed", "cancelled"]},
    "InferenceProposalStateV1": {"enum": ["none", "offered", "approved", "stale", "cancelled"]},
    "InferenceJobEventV1": {"type": "object", "additionalProperties": false, "required": ["ordinal", "kind", "atMs"], "properties": {"ordinal": {"type": "integer", "minimum": 1}, "kind": {"type": "string", "minLength": 1, "maxLength": 64}, "atMs": {"type": "integer", "minimum": 0}, "message": {"type": "string"}}},
    "InferenceJobProgressV1": {"type": "object", "additionalProperties": false, "required": ["cursor", "fraction", "atMs"], "properties": {"cursor": {"type": "integer", "minimum": 0}, "fraction": {"type": "number", "minimum": 0, "maximum": 1}, "atMs": {"type": "integer", "minimum": 0}, "message": {"type": "string"}}},
    "InferenceProposalV1": {"type": "object", "additionalProperties": false, "required": ["hash"], "properties": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "action": {"type": "string", "minLength": 1}, "capabilityId": {"type": "string", "minLength": 1}, "input": {"type": "object"}, "preview": {}}},
    "InferenceJobPageV1": {"type": "object", "additionalProperties": false, "required": ["schema", "jobId", "serviceId", "artifactKind", "pluginId", "documentId", "site", "state", "proposalState", "cancelRequested", "events", "progress", "nextCursor"], "properties": {"schema": {"const": "semio.mcp.inference-job/v1"}, "jobId": {"type": "string", "minLength": 1}, "serviceId": {"$ref": "#/$defs/InferenceIdV1"}, "artifactKind": {"$ref": "#/$defs/InferenceIdV1"}, "pluginId": {"$ref": "#/$defs/InferenceIdV1"}, "documentId": {"type": "string", "minLength": 1}, "site": {"$ref": "#/$defs/InferenceExecutionSiteV1"}, "state": {"$ref": "#/$defs/InferenceJobStateV1"}, "proposalState": {"$ref": "#/$defs/InferenceProposalStateV1"}, "cancelRequested": {"type": "boolean"}, "proposal": {"$ref": "#/$defs/InferenceProposalV1"}, "events": {"type": "array", "items": {"$ref": "#/$defs/InferenceJobEventV1"}}, "progress": {"type": "array", "items": {"$ref": "#/$defs/InferenceJobProgressV1"}}, "nextCursor": {"type": "integer", "minimum": 0}, "result": {}, "commit": {}, "error": {"type": "object"}}},
    "InferenceServiceLawV1": {"type": "object", "additionalProperties": false, "required": ["$schema", "law", "declared", "selection", "proposals", "lifecycles", "hubPages"], "properties": {"$schema": {"type": "string"}, "law": {"type": "string", "minLength": 1}, "declared": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["owner", "artifactKind", "inferenceSchema", "contributor"]}}, "selection": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "artifactKind", "hubServices"], "oneOf": [{"required": ["expect"]}, {"required": ["refusal"]}], "properties": {"name": {"type": "string"}, "artifactKind": {"$ref": "#/$defs/InferenceIdV1"}, "inferenceSchema": {"$ref": "#/$defs/InferenceIdV1"}, "pluginId": {"$ref": "#/$defs/InferenceIdV1"}, "hubServices": {"type": "array", "items": {"$ref": "#/$defs/HubInferenceServiceV1"}}, "expect": {"type": "object", "additionalProperties": false, "required": ["serviceId", "pluginId", "site"], "properties": {"serviceId": {"$ref": "#/$defs/InferenceIdV1"}, "pluginId": {"$ref": "#/$defs/InferenceIdV1"}, "site": {"$ref": "#/$defs/InferenceExecutionSiteV1"}, "route": {"$ref": "#/$defs/InferenceRouteV1"}, "commitAction": {"type": "string", "minLength": 1}}}, "refusal": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"enum": ["NOT_FOUND", "INPUT_INVALID", "PRECONDITION_FAILED"]}, "field": {"type": "string"}}}}}}, "proposals": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "serviceId", "documentId", "action", "capabilityId", "declaredArgs", "result"], "oneOf": [{"required": ["expect"]}, {"required": ["refusal"]}], "properties": {"name": {"type": "string"}, "serviceId": {"$ref": "#/$defs/InferenceIdV1"}, "documentId": {"type": "string"}, "action": {"type": "string"}, "capabilityId": {"type": "string"}, "declaredArgs": {"type": "array", "items": {"type": "string"}}, "result": {}, "expect": {"type": "object", "additionalProperties": false, "required": ["input", "hash"], "properties": {"input": {"type": "object"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "refusal": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"enum": ["NOT_FOUND", "INPUT_INVALID", "PRECONDITION_FAILED"]}, "field": {"type": "string"}}}}}}, "lifecycles": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "proposal", "steps", "journal"], "properties": {"name": {"type": "string"}, "proposal": {"type": "boolean"}, "journal": {"type": "array", "items": {"type": "string"}}, "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["op", "expect"], "properties": {"op": {"enum": ["progress", "offer", "approve", "commit", "refuse", "cancel", "cancelled", "succeed"]}, "fraction": {"type": "number", "minimum": 0, "maximum": 1}, "accepted": {"type": "boolean"}, "expect": {"type": "object", "additionalProperties": false, "required": ["state", "proposalState"], "properties": {"state": {"$ref": "#/$defs/InferenceJobStateV1"}, "proposalState": {"$ref": "#/$defs/InferenceProposalStateV1"}, "cancelRequested": {"type": "boolean"}, "result": {"type": "boolean"}}}}}}}}}, "hubPages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "page", "expect"], "properties": {"name": {"type": "string"}, "page": {"type": "object"}, "expect": {"type": "object", "additionalProperties": false, "required": ["state", "proposalState", "fractions", "events", "nextCursor"], "properties": {"state": {"$ref": "#/$defs/InferenceJobStateV1"}, "proposalState": {"$ref": "#/$defs/InferenceProposalStateV1"}, "proposalHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "fractions": {"type": "array", "items": {"type": "number"}}, "events": {"type": "array", "items": {"type": "string"}}, "nextCursor": {"type": "integer", "minimum": 0}}}}}}}}
  }
}
