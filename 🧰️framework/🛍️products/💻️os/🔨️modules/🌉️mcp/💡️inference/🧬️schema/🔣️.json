{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/mcp/inference/component.json",
  "title": "Semio OS MCP Inference Discovery",
  "$defs": {
    "InferenceIdV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "InferenceVersionV1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "DeclaredInferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "artifactKind",
        "artifactSchema",
        "artifactSchemaVersion",
        "documentSchema",
        "documentSchemaVersion",
        "inferenceSchema",
        "inferenceSchemaVersion",
        "algorithmVersion",
        "policyVersion",
        "contributor",
        "dependsOn"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "artifactKind": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "artifactSchema": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "artifactSchemaVersion": {
          "$ref": "#/$defs/InferenceVersionV1"
        },
        "documentSchema": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "documentSchemaVersion": {
          "$ref": "#/$defs/InferenceVersionV1"
        },
        "inferenceSchema": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "inferenceSchemaVersion": {
          "$ref": "#/$defs/InferenceVersionV1"
        },
        "algorithmVersion": {
          "$ref": "#/$defs/InferenceVersionV1"
        },
        "policyVersion": {
          "$ref": "#/$defs/InferenceVersionV1"
        },
        "contributor": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/InferenceIdV1"
          }
        }
      }
    },
    "InferenceDiscoveryRosterV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared"
      ],
      "properties": {
        "declared": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeclaredInferenceV1"
          }
        }
      }
    },
    "InferenceExecutionSiteV1": {
      "enum": [
        "guest",
        "hub"
      ]
    },
    "InferenceRouteV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
    },
    "HubInferenceServiceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "route"
      ],
      "properties": {
        "serviceId": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "route": {
          "$ref": "#/$defs/InferenceRouteV1"
        }
      }
    },
    "InferenceJobStateV1": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "InferenceProposalStateV1": {
      "enum": [
        "none",
        "offered",
        "approved",
        "stale",
        "cancelled"
      ]
    },
    "InferenceJobEventV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "kind",
        "atMs"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "InferenceJobProgressV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "fraction",
        "atMs"
      ],
      "properties": {
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "InferenceProposalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        },
        "preview": {}
      }
    },
    "InferenceJobPageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "serviceId",
        "artifactKind",
        "pluginId",
        "documentId",
        "site",
        "state",
        "proposalState",
        "cancelRequested",
        "events",
        "progress",
        "nextCursor"
      ],
      "properties": {
        "schema": {
          "const": "semio.mcp.inference-job/v1"
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "serviceId": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "artifactKind": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "pluginId": {
          "$ref": "#/$defs/InferenceIdV1"
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "site": {
          "$ref": "#/$defs/InferenceExecutionSiteV1"
        },
        "state": {
          "$ref": "#/$defs/InferenceJobStateV1"
        },
        "proposalState": {
          "$ref": "#/$defs/InferenceProposalStateV1"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "proposal": {
          "$ref": "#/$defs/InferenceProposalV1"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InferenceJobEventV1"
          }
        },
        "progress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InferenceJobProgressV1"
          }
        },
        "nextCursor": {
          "type": "integer",
          "minimum": 0
        },
        "result": {},
        "commit": {},
        "error": {
          "type": "object"
        }
      }
    }
  }
}
