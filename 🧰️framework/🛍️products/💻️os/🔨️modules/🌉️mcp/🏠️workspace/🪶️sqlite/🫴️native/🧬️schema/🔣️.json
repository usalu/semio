{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "owner",
    "custody",
    "publication",
    "nativeMaximumBytes",
    "maximumCloseTurns",
    "bodyGrant",
    "closeGrant",
    "deniedCloseGrant",
    "refusals",
    "cancellation",
    "duplicate",
    "maximumFileBytes",
