    "maximumElapsedMicroseconds",
    "retained"
  ],
  "additionalProperties": false,
  "properties": {
    "workUnits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maximumElapsedMicroseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    }
  }
}
