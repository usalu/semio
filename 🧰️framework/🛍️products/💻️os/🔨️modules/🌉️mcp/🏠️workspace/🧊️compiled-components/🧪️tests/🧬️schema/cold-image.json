{
  "type": "object",
  "additionalProperties": false,
  "required": ["pluginId", "cratePath", "patches", "startChannel", "preparedChannel", "outcomes"],
  "properties": {
    "pluginId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "cratePath": {"type": "string", "minLength": 1},
    "patches": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
          "to": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"}
        }
      }
    },
    "startChannel": {"$ref": "#/definitions/channel"},
    "preparedChannel": {"$ref": "#/definitions/channel"},
    "outcomes": {"const": ["altered-image-refused", "cold-image-attached"]}
  },
  "definitions": {
    "channel": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    }
  }
}
