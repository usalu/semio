{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/mcp/workspace/component.json",
  "title": "Semio OS MCP Headless Workspace",
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Sha256Etag": {
      "type": "string",
      "pattern": "^\"[0-9a-f]{64}\"$"
    },
    "Base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "ScopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ArtifactSelectorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "artifactSchema"
      ],
      "properties": {
        "artifactKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artifactSchema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "CanonicalCheckpointPartV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "sha256"
      ],
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/Ordinal"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "CanonicalCheckpointUntrustedV1": {
      "allOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/os/mcp/component.json#/$defs/UntrustedContentV1"
        },
        {
          "type": "object",
          "properties": {
            "provenance": {
              "type": "object",
              "properties": {
                "source": {
                  "const": "hub-checkpoint"
                }
              }
            },
            "content": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "packBase64",
                "sprBase64"
              ],
              "properties": {
                "packBase64": {
                  "$ref": "#/$defs/Base64"
                },
                "sprBase64": {
                  "$ref": "#/$defs/Base64"
                }
              }
            }
          }
        }
      ]
    },
    "CanonicalCheckpointFrontierV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainHash"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/ScopeId"
        },
        "headEditOrdinal": {
          "$ref": "#/$defs/Ordinal"
        },
        "headEditId": {
          "type": "string",
          "maxLength": 256
        },
        "lastCommitSeq": {
          "$ref": "#/$defs/Ordinal"
        },
        "chainHash": {
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "CanonicalCheckpointResourceValueV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "scope",
        "descriptorDigestV1",
        "activeCheckpointId",
        "etag",
        "authorityGeneration",
        "catalogGeneration",
        "frontier",
        "pack",
        "spr",
        "untrusted"
      ],
      "properties": {
        "schema": {
          "const": "semio.mcp.canonical-checkpoint-resource/v1"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spaceId",
            "documentId"
          ],
          "properties": {
            "spaceId": {
              "$ref": "#/$defs/ScopeId"
            },
            "documentId": {
              "$ref": "#/$defs/ScopeId"
            }
          }
        },
        "descriptorDigestV1": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "activeCheckpointId": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "etag": {
          "$ref": "#/$defs/Sha256Etag"
        },
        "authorityGeneration": {
          "$ref": "#/$defs/Generation"
        },
        "catalogGeneration": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "frontier": {
          "$ref": "#/$defs/CanonicalCheckpointFrontierV1"
        },
        "pack": {
          "$ref": "#/$defs/CanonicalCheckpointPartV1"
        },
        "spr": {
          "$ref": "#/$defs/CanonicalCheckpointPartV1"
        },
        "untrusted": {
          "$ref": "#/$defs/CanonicalCheckpointUntrustedV1"
        }
      }
    },
    "HubLiveCatalogPackageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "packageId",
        "version",
        "componentSha256",
        "descriptorByteSha256",
        "executionProtocol"
      ],
      "properties": {
        "pluginId": {
          "$ref": "#/$defs/ScopeId"
        },
        "packageId": {
          "$ref": "#/$defs/ScopeId"
        },
        "version": {
          "$ref": "#/$defs/ScopeId"
        },
        "componentSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "descriptorByteSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "executionProtocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appChannelVersion"
          ],
          "properties": {
            "appChannelVersion": {
              "const": 23
            }
          }
        }
      }
    },
    "HubLiveCatalogSelectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "descriptorDigestV1",
        "catalogGenerationId",
        "package"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spaceId",
            "documentId"
          ],
          "properties": {
            "spaceId": {
              "$ref": "#/$defs/ScopeId"
            },
            "documentId": {
              "$ref": "#/$defs/ScopeId"
            }
          }
        },
        "descriptorDigestV1": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "catalogGenerationId": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "package": {
          "$ref": "#/$defs/HubLiveCatalogPackageV1"
        }
      }
    },
    "SessionActivationPhaseV1": {
      "description": "One phase of activating a plugin session and reading its document: the component is resolved, read, content-hashed, its compiled code loaded or compiled in an isolated worker, its guest opened, a bound hub document loaded into it through the stepped archive load (its polled completed/total is the phase fraction), then the document read. Every job that activates a session reports these (inference_run's artifact binding, artifact_create). A phase a warm session already passed is skipped, never reported twice; every phase is interruptible.",
      "enum": [
        "resolving-component",
        "reading-component",
        "hashing-component",
        "loading-compiled-code",
        "compiling-component",
        "opening-guest",
        "loading-document",
        "reading-document"
      ]
    },
    "SessionActivationPhaseRowV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "position"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/SessionActivationPhaseV1"
        },
        "position": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "description": "Where the phase starts within an activation; each job maps it onto its own progress span."
        }
      }
    },
    "SessionActivationPhasesV1": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/SessionActivationPhaseRowV1"
      }
    }
  }
}
