  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "jobId",
    "proposalHash"
  ],
  "properties": {
    "schema": {
      "const": "semio.hub.inference-approval/v1"
    },
    "version": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "proposalHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
