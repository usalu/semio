    "GatewayError": {
      "description": "🚧️ The one error shape every gateway operation returns internally, before a call site decides whether it becomes a JSON-RPC protocol error or a tool-result `isError:true` payload. Implements `std::error::Error` so it composes with `?` in ordinary fallible Rust code, not only at the JSON-RPC/tool-result boundary.",
      "properties": {
        "code": {
          "$ref": "#/$defs/GatewayErrorCode"
        },
        "details": {
          "default": null
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "GatewayErrorCode": {
      "description": "🏷️ The twelve gateway failure codes every capability surface can raise — see this file's module doc for the frozen source of truth.",
      "enum": [
        "INPUT_INVALID",
        "PRECONDITION_FAILED",
        "REVISION_CONFLICT",
        "PERMISSION_DENIED",
        "APPROVAL_REQUIRED",
        "PLUGIN_UNAVAILABLE",
        "SIDE_EFFECT_REJECTED",
        "CANCELLED",
        "COMPENSATION_FAILED",
        "NOT_FOUND",
        "BUDGET_EXCEEDED",
        "INTERNAL"
      ],
      "type": "string"
    },
