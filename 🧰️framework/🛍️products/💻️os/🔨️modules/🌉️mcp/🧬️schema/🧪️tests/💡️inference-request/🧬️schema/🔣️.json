{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 6,
  "maxItems": 6,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "shape",
      "input",
      "valid"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "shape": {
        "enum": [
          "InferenceRunInput",
          "InferenceSubmitInput"
        ]
      },
      "input": {
        "type": "object"
      },
      "valid": {
        "type": "boolean"
      }
    }
  }
}
