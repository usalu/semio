{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/mcp/artifact/component.json",
  "title": "Semio OS MCP Artifact Verbs",
  "$defs": {
    "ArtifactCreateJobStatusV1": {
      "description": "How an artifact_create job ended. Every artifact_create is a job (jobId, job_get, job_cancel, notifications/cancelled) that reports the plugin session's activation phases while it runs.",
      "enum": ["SUCCEEDED", "CANCELLED"]
    },
    "ArtifactCreateCancellationLawV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "law", "cancelAnswerCeilingMs", "cases"],
      "properties": {
        "$schema": { "type": "string", "minLength": 1 },
        "law": { "type": "string", "minLength": 1 },
        "cancelAnswerCeilingMs": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cancelAt", "expected"],
            "properties": {
              "cancelAt": { "oneOf": [{ "$ref": "https://json.schemas.assets.semio-tech.com/os/mcp/workspace/component.json#/$defs/SessionActivationPhaseV1" }, { "type": "null" }] },
              "expected": { "$ref": "#/$defs/ArtifactCreateJobStatusV1" }
            }
          }
        }
      }
    },
    "UntrustedContentLawV1": {
      "description": "Document-authored content reaches an agent only inside the untrusted envelope. A canary written into a document must appear inside every carrier's envelope and nowhere else in any tool result or resource; every hostile envelope must be refused by the envelope schema.",
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "law", "canary", "envelopeField", "plants", "carriers", "observers", "hostile"],
      "properties": {
        "$schema": { "type": "string", "minLength": 1 },
        "law": { "type": "string", "minLength": 1 },
        "canary": { "type": "string", "pattern": "^[ -~]{24,}$" },
        "envelopeField": { "const": "untrusted" },
        "plants": {
          "description": "How a collaborator writes the canary into a document, per lane: create `artifactKind`, then invoke `capabilityId` with `input`, every `{{canary}}` in its strings replaced by the canary.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lane", "artifactKind", "capabilityId", "input"],
            "properties": {
              "lane": { "enum": ["headless", "shell"] },
              "artifactKind": { "type": "string", "minLength": 1 },
              "capabilityId": { "type": "string", "minLength": 1 },
              "input": { "type": "object" }
            }
          }
        },
        "carriers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "name", "source"],
            "properties": {
              "surface": { "enum": ["tool", "resource"] },
              "name": { "type": "string", "minLength": 1 },
              "source": { "enum": ["artifact-body", "artifact-export", "hub-checkpoint", "space-directory"] }
            }
          }
        },
        "observers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "name"],
            "properties": { "surface": { "enum": ["tool", "resource", "list"] }, "name": { "type": "string", "minLength": 1 } }
          }
        },
        "hostile": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "value": {}
            }
          }
        }
      }
    }
  }
}
