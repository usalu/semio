{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "maxItems": 16,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "direction",
      "hex"
    ],
    "properties": {
      "direction": {
        "enum": [
          "shell_to_gateway",
          "gateway_to_shell"
        ]
      },
      "hex": {
        "type": "string",
        "maxLength": 256,
        "pattern": "^(?:[a-f0-9]{2})+$"
      }
    }
  }
}
