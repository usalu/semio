{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://framework.os.mcp.agent-credential",
  "$ref": "#/$defs/CredentialExchangeRequestV1",
  "$defs": {
    "CredentialExchangeRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bodyBytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1024,
          "pattern": "^/(?!(?:\\.{1,2})(?:/|$))(?!.*(?:[\\\\?#%:\\u0000-\\u001f]|/\\.{1,2}(?:/|$)))[A-Za-z0-9_.~-]+(?:/[A-Za-z0-9_.~-]+)*$"
        },
        "bodyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        }
      }
    }
  }
}
