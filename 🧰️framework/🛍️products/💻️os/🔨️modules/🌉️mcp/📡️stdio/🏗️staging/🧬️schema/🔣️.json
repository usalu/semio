{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "command",
          "arguments"
        ],
        "properties": {
          "platform": {
            "enum": [
              "darwin",
              "linux",
              "win32"
            ]
          },
          "command": {
            "const": "repo"
          },
          "arguments": {
            "const": [
              "run",
              "@semio-tech/framework-os-mcp-rs:build",
              "--output=stream"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "CatalogLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "arguments",
        "catalog",
        "target",
        "forwarded"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "pattern": "^@[a-z0-9-]+/[a-z0-9-]+:[a-z0-9-]+$"
        },
        "forwarded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LaunchMode": {
      "const": "prototype"
    },
    "ComponentCustody": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "binaryOverride", "catalog", "modelsAvailable", "staged", "active"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "binaryOverride": { "type": ["string", "null"] },
          "catalog": { "type": ["string", "null"] },
          "modelsAvailable": { "type": "boolean" },
          "staged": { "type": "array", "items": { "type": "string" } },
          "active": { "type": "array", "items": { "enum": ["native", "models"] } }
        }
      }
    },
    "Lifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "closeDuringPreparation",
        "exitCode",
        "ready",
        "cancelled"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "closeDuringPreparation": {
          "const": true
        },
        "exitCode": {
          "const": 0
        },
        "ready": {
          "const": false
        },
        "cancelled": {
          "const": true
        }
      }
    },
    "Producer": {
      "const": {
        "manifest": "🧰️framework/🛍️products/💻️os/🔨️modules/🌉️mcp/📦️packages/🦀️rust/Cargo.toml",
        "package": "semio-os-mcp",
        "binary": "semio-os-mcp",
        "sourcesRecord": "semio-os-mcp.sources.json",
        "diagnosticChannel": "stderr",
        "prerequisites": [
          {
            "target": "@semio-tech/assets:build",
            "produces": [
              "🧰️framework/🔨️modules/🖼️assets/🔣️icons/🤖️generated/🪪️icon-name/🦀️.rs"
            ]
          },
          {
            "target": "@semio-tech/framework-schema:generate",
            "produces": [
              "🧰️framework/🔨️modules/🧬️schema/🤖️generated/🏷️entity-kinds/🦀️.rs"
            ]
          },
          {
            "target": "@semio-tech/ui-styling-tokens:generate",
            "produces": [
              "🧰️framework/🔨️modules/🖱️ui/🎨️styling/🔤️tokens/🦀️.rs"
            ]
          }
        ]
      }
    },
    "Diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "lines",
        "stdout",
        "stderr"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "stdout": {
          "type": "array",
          "maxItems": 0
        },
        "stderr": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "Transports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
        "catalog",
              "args",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
        "catalog": {
          "type": ["string", "null"]
        },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "Captures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "arguments",
              "character",
              "bytes",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "character": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "status": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    }
  }
}
