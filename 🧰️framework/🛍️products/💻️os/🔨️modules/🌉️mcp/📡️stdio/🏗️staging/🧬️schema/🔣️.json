{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "command",
          "arguments"
        ],
        "properties": {
          "platform": {
            "enum": [
              "darwin",
              "linux",
              "win32"
            ]
          },
          "command": {
            "const": "repo"
          },
          "arguments": {
            "const": [
              "run",
              "@semio-tech/framework-os-mcp-rs:build",
              "--output=stream"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "CatalogLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "arguments",
        "catalog",
        "target",
        "forwarded"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "pattern": "^@[a-z0-9-]+/[a-z0-9-]+:[a-z0-9-]+$"
        },
        "forwarded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LaunchMode": {
      "const": "prototype"
    },
    "Lifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "closeDuringPreparation",
        "exitCode",
        "ready",
        "cancelled"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "closeDuringPreparation": {
          "const": true
        },
        "exitCode": {
          "const": 0
        },
        "ready": {
          "const": false
        },
        "cancelled": {
          "const": true
        }
      }
    },
    "Producer": {
      "const": {
        "manifest": "🧰️framework/🛍️products/💻️os/🔨️modules/🌉️mcp/📦️packages/🦀️rust/Cargo.toml",
        "package": "semio-framework-os-mcp",
        "binary": "semio-os-mcp",
        "sourcesRecord": "semio-os-mcp.sources.json",
        "diagnosticChannel": "stderr"
      }
    },
    "Diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "lines",
        "stdout",
        "stderr"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "stdout": {
          "type": "array",
          "maxItems": 0
        },
        "stderr": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "Transports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "args",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "Captures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "arguments",
              "character",
              "bytes",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "character": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "status": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    }
  }
}
