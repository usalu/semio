{
  "name": "@semio-tech/framework-os-scale-fixture",
  "root": "🧰️framework/🛍️products/💻️os/🧪️testing/⚖️scale/📦️packages/🦀️rust",
  "sourceRoot": "🧰️framework/🛍️products/💻️os/🧪️testing/⚖️scale",
  "projectType": "library",
  "namedInputs": {
    "default": ["{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🧬️schema/**/*.wit", "sharedGlobals"],
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "lang:rust",
    "role:test",
    "family:scale-fixture"
  ],
  "targets": {
    "check": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "command": "bun 📜️script.ts check",
        "cwd": "{projectRoot}"
      }
    },
    "check-wasm": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "command": "bun 📜️script.ts check-wasm",
        "cwd": "{projectRoot}"
      }
    },
    "build-wasm": {
      "executor": "repo:script",
      "options": {
        "command": "bun 📜️script.ts build-wasm",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/component"
      ]
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "command": "bun 📜️script.ts test",
        "cwd": "{projectRoot}"
      }
    }
  }
}
