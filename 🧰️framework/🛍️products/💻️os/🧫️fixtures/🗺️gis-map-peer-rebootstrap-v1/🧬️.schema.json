{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/os/gis-map-peer-rebootstrap-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "clients", "published", "order", "sourceHostiles", "nonclaims"],
  "properties": {
    "schema": { "const": "semio.os.gis-map-peer-rebootstrap/v1" },
    "scope": { "$ref": "#/$defs/scope" },
    "clients": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientInstanceId"],
        "properties": { "clientInstanceId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" } }
      }
    },
    "published": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "descriptorDigestV1", "aggregateSha256", "frontier", "scene"],
      "properties": {
        "checkpointId": { "$ref": "#/$defs/hash" },
        "descriptorDigestV1": { "$ref": "#/$defs/hash" },
        "aggregateSha256": { "$ref": "#/$defs/hash" },
        "frontier": { "$ref": "#/$defs/frontier" },
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "nodeKind", "region"],
          "properties": {
            "revision": { "type": "integer", "minimum": 1 },
            "nodeKind": { "const": "tiled-map" },
            "region": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind"],
              "properties": { "id": { "type": "string", "pattern": "^inference-.+$" }, "kind": { "const": "inference-bounds" } }
            }
          }
        }
      }
    },
    "order": {
      "type": "array",
      "prefixItems": [
        { "const": "rebootstrap-required" },
        { "const": "fresh-authority" },
        { "const": "artifact-bootstrap" },
        { "const": "page-accepted" },
        { "const": "applied" },
        { "const": "scene-patch" },
        { "const": "patch-ack" }
      ],
      "minItems": 7,
      "maxItems": 7
    },
    "sourceHostiles": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "nonclaims": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "documentId"],
      "properties": { "spaceId": { "type": "string", "minLength": 1, "maxLength": 256 }, "documentId": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainHash"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "headEditOrdinal": { "type": "integer", "minimum": 1 },
        "headEditId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "lastCommitSeq": { "type": "integer", "minimum": 1 },
        "chainHash": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    }
  }
}
