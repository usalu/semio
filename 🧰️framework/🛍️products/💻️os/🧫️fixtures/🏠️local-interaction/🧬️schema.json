{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "outerReadHex", "outerRejectedHex", "receiptHex", "malformedFrameHex", "maximumCommandBytes", "maximumReplyBytes", "lifecycles", "sequenceCases", "reopen", "lateTokenAccepted", "terminalBeforeClosed"],
  "properties": {
    "version": {"const": 1}, "outerReadHex": {"const": "1d0902000d"}, "outerRejectedHex": {"const": "1703030d00"},
    "receiptHex": {"const": "0002"}, "malformedFrameHex": {"const": "ff"}, "maximumCommandBytes": {"const": 142}, "maximumReplyBytes": {"const": 4256},
    "lateTokenAccepted": {"const": false}, "terminalBeforeClosed": {"const": false},
    "reopen": {"type": "object", "additionalProperties": false, "required": ["requests", "readSequences", "cancelSequences", "ordinarySequence", "ackSequence"], "properties": {"requests": {"const": ["1", "2"]}, "readSequences": {"const": [1, 3]}, "cancelSequences": {"const": [2, 4]}, "ordinarySequence": {"const": 5}, "ackSequence": {"const": 6}}},
    "sequenceCases": {"type": "array", "minItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["sequence", "request", "operation", "result", "after"], "properties": {
      "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "request": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}, "operation": {"enum": ["ordinary", "query"]},
      "result": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["sequence", "cancelSequence", "request"], "properties": {"sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "cancelSequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991}, "request": {"type": ["string", "null"]}}}]},
      "after": {"type": "object", "additionalProperties": false, "required": ["sequence", "request"], "properties": {"sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "request": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}}}
    }}},
    "lifecycles": {"type": "array", "minItems": 13, "items": {"type": "object", "additionalProperties": false, "required": ["id", "events", "cancelled"], "properties": {
      "id": {"type": "string", "minLength": 1}, "cancelled": {"type": "boolean"},
      "events": {"type": "array", "minItems": 5, "items": {"enum": ["read", "readReceipt", "mixedReceipts", "wrongReceipt", "duplicateReadReceipt", "started", "startedWithNotice", "pageWithNotice", "page", "malformed", "consume", "ack", "closed", "abort", "cancel", "ordinary", "ordinaryDone", "ordinaryEmpty", "consumeError", "dispose"]}}
    }}}
  }
}
