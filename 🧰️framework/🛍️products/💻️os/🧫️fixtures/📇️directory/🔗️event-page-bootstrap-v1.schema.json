{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.directory.event-page-bootstrap-trace.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bootstrapEpoch", "initialAfter", "pages", "wakeups", "expectedSocketSince", "forgedAckFields", "retainedHome", "retry", "cancellation", "rebootstrap", "terminalClose"],
  "properties": {
    "schema": { "const": "semio.directory.event-page-bootstrap-trace.v1" },
    "bootstrapEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "initialAfter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "pages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["afterSeqExclusive", "throughSeqInclusive", "hasMore", "sessionBindingSha256", "authorizationGeneration", "receiptSha256"],
        "properties": {
          "afterSeqExclusive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "throughSeqInclusive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "hasMore": { "type": "boolean" },
          "sessionBindingSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "authorizationGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "receiptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "wakeups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    },
    "expectedSocketSince": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "forgedAckFields": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["bootstrapEpoch", "sessionBindingSha256", "authorizationGeneration", "throughSeqInclusive", "receiptSha256"] }
    },
    "retainedHome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "appId", "instanceId", "switchedVisibleInstanceId", "expectedDestroyCount"],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "appId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "instanceId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "switchedVisibleInstanceId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "expectedDestroyCount": { "const": 1 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transportAfter", "homeRejectedReceiptSha256", "expectedAfter"],
      "properties": {
        "transportAfter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "homeRejectedReceiptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expectedAfter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lateThroughSeqInclusive", "expectedAckCount"],
      "properties": {
        "lateThroughSeqInclusive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedAckCount": { "const": 0 }
      }
    },
    "rebootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextEpoch", "expectedAfter"],
      "properties": {
        "nextEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "expectedAfter": { "const": 0 }
      }
    },
    "terminalClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "expectedBootstrapEpoch", "expectedAfter", "expectedReconnects"],
      "properties": {
        "code": { "const": 4401 },
        "expectedBootstrapEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "expectedAfter": { "const": 0 },
        "expectedReconnects": { "const": 0 }
      }
    }
  }
}
