{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "progressStage", "cases"],
  "properties": {
    "schema": {
      "const": "semio.os.document-browser-actor-session-activation/v1"
    },
    "progressStage": {
      "const": "browser-actor"
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "bodies", "loads", "describes", "activated"],
        "properties": {
          "name": {
            "enum": [
              "before-session",
              "valid-session",
              "socket-close-during-body",
              "socket-replaced-during-load",
              "descriptor-mismatch",
              "same-document-other-space",
              "wrong-session",
              "body-hash-mismatch",
              "scope-change-at-headers",
              "client-replaced-during-load",
              "descriptor-noncanonical",
              "descriptor-result-shape",
              "client-change-after-describe",
              "duplicate-session-during-load",
              "socket-close-after-describe",
              "client-change-during-progress"
            ]
          },
          "bodies": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "loads": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "describes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "activated": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        }
      }
    }
  }
}
