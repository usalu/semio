{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.os.browser-document-open-transport/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "nowMs", "intent", "installedTarget", "plan", "socketGrant", "expected", "hostile"],
  "properties": {
    "schema": { "const": "semio.os.browser-document-open-transport/v1" },
    "version": { "const": 1 },
    "nowMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "intent": { "$ref": "#/$defs/intent" },
    "installedTarget": { "$ref": "#/$defs/installedTarget" },
    "plan": { "$ref": "#/$defs/plan" },
    "socketGrant": { "$ref": "#/$defs/socketGrant" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpPaths", "webSocketPath", "protocol", "helloSchema", "helloPackSchemaHashByte", "responseMaxBytes", "rustWorkerBypassDenied", "scopeIsolation", "forbiddenSocketFragments"],
      "properties": {
        "httpPaths": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "items": false, "minItems": 2, "maxItems": 2 },
        "webSocketPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "protocol": { "const": "semio.socket.v1" },
        "helloSchema": { "type": "string", "minLength": 1, "maxLength": 256 },
        "helloPackSchemaHashByte": { "type": "integer", "minimum": 0, "maximum": 255 },
        "responseMaxBytes": { "const": 65536 },
        "rustWorkerBypassDenied": { "const": true },
        "scopeIsolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right", "leftKey", "rightKey", "localKey"],
          "properties": {
            "left": { "$ref": "#/$defs/scope" },
            "right": { "$ref": "#/$defs/scope" },
            "leftKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "rightKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "localKey": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "forbiddenSocketFragments": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "uniqueItems": true }
      }
    },
    "hostile": {
      "type": "array",
      "minItems": 6,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "stage", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "stage": { "enum": ["plan", "exchange", "socket", "session"] },
          "replacePath": { "type": "string", "minLength": 1, "maxLength": 128 },
          "value": {},
          "expected": { "enum": ["invalid-plan", "cancelled-before-exchange", "response-too-large", "credential-free", "withheld-activation"] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "hash": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "documentId"],
      "properties": { "spaceId": { "$ref": "#/$defs/id" }, "documentId": { "$ref": "#/$defs/id" } }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "scope", "requestedSurfaceId", "clientInstanceId"],
      "properties": {
        "schema": { "const": "semio.hub.document-open-intent/v1" },
        "version": { "const": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "requestedSurfaceId": { "$ref": "#/$defs/id" },
        "clientInstanceId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "installedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "artifact", "surface"],
      "properties": {
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pluginId", "packageId", "version", "componentSha256", "componentBlake3", "descriptorByteSha256"],
          "properties": {
            "pluginId": { "$ref": "#/$defs/id" }, "packageId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/id" },
            "componentSha256": { "$ref": "#/$defs/hash" }, "componentBlake3": { "$ref": "#/$defs/hash" }, "descriptorByteSha256": { "$ref": "#/$defs/hash" }
          }
        },
        "artifact": {
          "type": "object", "additionalProperties": false, "required": ["kind", "schema", "packSchemaHash"],
          "properties": { "kind": { "$ref": "#/$defs/id" }, "schema": { "$ref": "#/$defs/id" }, "packSchemaHash": { "$ref": "#/$defs/hash" } }
        },
        "surface": {
          "type": "object", "additionalProperties": false, "required": ["surfaceId", "appId", "windowKindId", "role", "rendererTarget"],
          "properties": { "surfaceId": { "$ref": "#/$defs/id" }, "appId": { "$ref": "#/$defs/id" }, "windowKindId": { "$ref": "#/$defs/id" }, "role": { "enum": ["viewer", "editor"] }, "rendererTarget": { "enum": ["react", "wgpu", "wasm"] } }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "receipt", "expiresAtUnixMs", "scope", "descriptorDigestV1", "catalog", "package", "artifact", "surface", "grant", "checkpoint", "revalidation"],
      "properties": {
        "schema": { "const": "semio.hub.document-open-plan/v1" },
        "version": { "const": 1 },
        "receipt": { "type": "string", "pattern": "^open\\.v1\\.[A-Za-z0-9_-]{43}$" },
        "expiresAtUnixMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "scope": { "$ref": "#/$defs/scope" },
        "descriptorDigestV1": { "$ref": "#/$defs/hash" },
        "catalog": { "type": "object", "additionalProperties": false, "required": ["generationId"], "properties": { "generationId": { "$ref": "#/$defs/hash" } } },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pluginId", "packageId", "version", "componentSha256", "componentBlake3", "descriptorByteSha256"],
          "properties": {
            "pluginId": { "$ref": "#/$defs/id" }, "packageId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/id" },
            "componentSha256": { "$ref": "#/$defs/hash" }, "componentBlake3": { "$ref": "#/$defs/hash" }, "descriptorByteSha256": { "$ref": "#/$defs/hash" }
          }
        },
        "artifact": {
          "type": "object", "additionalProperties": false, "required": ["kind", "schema", "packSchemaHash"],
          "properties": { "kind": { "$ref": "#/$defs/id" }, "schema": { "$ref": "#/$defs/id" }, "packSchemaHash": { "$ref": "#/$defs/hash" } }
        },
        "surface": {
          "type": "object", "additionalProperties": false, "required": ["surfaceId", "appId", "windowKindId", "role", "rendererTarget"],
          "properties": { "surfaceId": { "$ref": "#/$defs/id" }, "appId": { "$ref": "#/$defs/id" }, "windowKindId": { "$ref": "#/$defs/id" }, "role": { "enum": ["viewer", "editor"] }, "rendererTarget": { "const": "react" } }
        },
        "grant": {
          "type": "object", "additionalProperties": false, "required": ["read", "write", "observe"],
          "properties": { "read": { "const": true }, "write": { "type": "boolean" }, "observe": { "const": true } }
        },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "revalidation": { "$ref": "#/$defs/revalidation" }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainHash"],
      "properties": {
        "documentId": { "$ref": "#/$defs/id" },
        "headEditOrdinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "headEditId": { "$ref": "#/$defs/id" },
        "lastCommitSeq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "chainHash": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "contains": { "type": "integer", "minimum": 1 } }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "descriptorDigestV1", "baselineFrontier", "aggregateSha256"],
      "properties": {
        "checkpointId": { "$ref": "#/$defs/hash" },
        "descriptorDigestV1": { "$ref": "#/$defs/hash" },
        "baselineFrontier": { "$ref": "#/$defs/frontier" },
        "aggregateSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "revalidation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["directoryRevision", "membershipGeneration", "sessionGeneration"],
          "properties": {
            "directoryRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "membershipGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "sessionGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["directoryRevision", "membershipGeneration", "shareGeneration"],
          "properties": {
            "directoryRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "membershipGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "shareGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      ]
    },
    "socketGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "protocol", "grant", "actorId", "expiresAtMs"],
      "properties": {
        "schema": { "const": "semio.hub.socket-grant/v1" },
        "protocol": { "const": "semio.socket.v1" },
        "grant": { "type": "string", "pattern": "^socket\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$" },
        "actorId": { "type": "string", "pattern": "^hub\\.v1\\.[0-9a-f]{64}$" },
        "expiresAtMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
