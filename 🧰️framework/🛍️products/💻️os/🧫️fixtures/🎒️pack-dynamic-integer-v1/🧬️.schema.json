{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/os/pack-dynamic-integer-fixture-v1.json",
  "title": "Lossless dynamic pack integer corpus",
  "description": "Language-neutral byte corpus for the dynamic `Shape::Value` grammar's `TAG_INT` (0x03) and `TAG_UINT` (0x04) forms. Every integer is a decimal STRING anchored to the exact signed/unsigned 64-bit range so no host has to route it through a JSON number.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "accept", "reject", "nonclaims"],
  "$defs": {
    "uintDecimal": {
      "type": "string",
      "$comment": "Exactly 0 .. 18446744073709551615 (u64), no leading zeros — anchored by the pattern itself, not by the reader.",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "intDecimal": {
      "type": "string",
      "$comment": "Exactly -9223372036854775808 .. 9223372036854775807 (i64), no leading zeros and no negative zero — anchored by the pattern itself.",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807|-([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7]|9223372036854775808))$"
    },
    "f64LeHex": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "wireHex": { "type": "string", "pattern": "^([0-9a-f]{2}){1,256}$" },
    "scalar": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "uint": { "$ref": "#/$defs/uintDecimal" },
        "int": { "$ref": "#/$defs/intDecimal" },
        "f64LeHex": { "$ref": "#/$defs/f64LeHex" }
      }
    },
    "depth3": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "uint": { "$ref": "#/$defs/uintDecimal" },
        "int": { "$ref": "#/$defs/intDecimal" },
        "f64LeHex": { "$ref": "#/$defs/f64LeHex" }
      }
    },
    "depth2": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "uint": { "$ref": "#/$defs/uintDecimal" },
        "int": { "$ref": "#/$defs/intDecimal" },
        "f64LeHex": { "$ref": "#/$defs/f64LeHex" },
        "list": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/depth3" } },
        "map": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": "string", "minLength": 1, "maxLength": 32 }, { "$ref": "#/$defs/depth3" }] } }
      }
    },
    "depth1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "uint": { "$ref": "#/$defs/uintDecimal" },
        "int": { "$ref": "#/$defs/intDecimal" },
        "f64LeHex": { "$ref": "#/$defs/f64LeHex" },
        "list": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/depth2" } },
        "map": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": "string", "minLength": 1, "maxLength": 32 }, { "$ref": "#/$defs/depth2" }] } }
      }
    }
  },
  "properties": {
    "schema": { "const": "semio.pack.dynamic-integer/v1" },
    "version": { "const": 1 },
    "accept": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "variant", "value", "wireHex"],
        "properties": {
          "id": { "enum": ["uint-zero", "uint-safe-plus-one", "uint-max", "int-min", "float-negative-zero", "nested"] },
          "variant": { "enum": ["uint", "int", "float", "map"] },
          "value": { "$ref": "#/$defs/depth1" },
          "wireHex": { "$ref": "#/$defs/wireHex" }
        }
      }
    },
    "reject": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "wireHex"],
        "properties": {
          "id": { "enum": ["truncated-u64", "u64-overflow", "nonminimal-u64", "nonminimal-zigzag-i64"] },
          "outcome": { "enum": ["decode-error", "noncanonical"] },
          "decodes": { "$ref": "#/$defs/scalar" },
          "wireHex": { "$ref": "#/$defs/wireHex" }
        },
        "allOf": [
          {
            "if": { "properties": { "outcome": { "const": "noncanonical" } }, "required": ["outcome"] },
            "then": { "properties": { "decodes": { "$ref": "#/$defs/scalar" } }, "required": ["decodes"] },
            "else": { "properties": { "decodes": false } }
          }
        ]
      }
    },
    "nonclaims": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1 } }
  }
}
