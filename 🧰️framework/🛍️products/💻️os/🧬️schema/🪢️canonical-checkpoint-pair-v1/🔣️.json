{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/canonical-checkpoint-pair-v1.json",
  "title": "Canonical checkpoint pair",
  "description": "The one seed every shell opens a hub document on: the hub's active canonical checkpoint pair (GET /spaces/{spaceId}/documents/{documentId}/active-checkpoint/pair), decoded from its framed wire, its pack, SPR and aggregate digests verified, and admitted only when it is exactly the checkpoint the hub authorized for the open (scope, checkpoint id, descriptor digest, baseline frontier, aggregate). A door-created artifact's first checkpoint is its genesis; a checked-in document's is its check-in.",
  "definitions": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainHash"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "headEditOrdinal": {
          "type": "integer",
          "minimum": 0
        },
        "headEditId": {
          "type": "string"
        },
        "lastCommitSeq": {
          "type": "integer",
          "minimum": 0
        },
        "chainHash": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointId",
        "descriptorDigestV1",
        "baselineFrontier",
        "aggregateSha256"
      ],
      "properties": {
        "checkpointId": {
          "$ref": "#/definitions/hex32"
        },
        "descriptorDigestV1": {
          "$ref": "#/definitions/hex32"
        },
        "baselineFrontier": {
          "$ref": "#/definitions/frontier"
        },
        "aggregateSha256": {
          "$ref": "#/definitions/hex32"
        }
      }
    }
  }
}
