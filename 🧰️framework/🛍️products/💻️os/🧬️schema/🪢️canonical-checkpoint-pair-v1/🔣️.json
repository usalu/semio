{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/canonical-checkpoint-pair-v1.json",
  "title": "Canonical checkpoint pair",
  "description": "The one seed every shell opens a hub document on: the hub's active canonical checkpoint pair (GET /spaces/{spaceId}/documents/{documentId}/active-checkpoint/pair), decoded from its framed wire, its pack, SPR and aggregate digests verified, and admitted only when it is exactly the checkpoint the hub authorized for the open (scope, checkpoint id, descriptor digest, baseline frontier, aggregate). A door-created artifact's first checkpoint is its genesis; a checked-in document's is its check-in.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mediaType", "limits", "pairs", "refusals", "admissions"],
  "definitions": {
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte", "length"],
      "properties": { "byte": { "type": "integer", "minimum": 0, "maximum": 255 }, "length": { "type": "integer", "minimum": 0 } }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainHash"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "headEditOrdinal": { "type": "integer", "minimum": 0 },
        "headEditId": { "type": "string" },
        "lastCommitSeq": { "type": "integer", "minimum": 0 },
        "chainHash": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "documentId"],
      "properties": { "spaceId": { "type": "string", "minLength": 1 }, "documentId": { "type": "string", "minLength": 1 } }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "descriptorDigestV1", "baselineFrontier", "aggregateSha256"],
      "properties": {
        "checkpointId": { "$ref": "#/definitions/hex32" },
        "descriptorDigestV1": { "$ref": "#/definitions/hex32" },
        "baselineFrontier": { "$ref": "#/definitions/frontier" },
        "aggregateSha256": { "$ref": "#/definitions/hex32" }
      }
    }
  },
  "properties": {
    "schema": { "const": "semio.hub.canonical-checkpoint-pair-fixture/v1" },
    "mediaType": { "const": "application/vnd.semio.canonical-checkpoint-pair.v1" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headerBytes", "recordBytes", "records", "pairBytes"],
      "properties": {
        "headerBytes": { "const": 16384 },
        "recordBytes": { "const": 4096 },
        "records": { "const": 16384 },
        "pairBytes": { "const": 67108864 }
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selection", "pack", "spr", "packSha256", "sprSha256", "aggregateSha256", "bodyHex"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spaceId", "documentId", "descriptorDigestV1", "checkpointId", "baselineFrontier"],
            "properties": {
              "spaceId": { "type": "string", "minLength": 1 },
              "documentId": { "type": "string", "minLength": 1 },
              "descriptorDigestV1": { "$ref": "#/definitions/hex32" },
              "checkpointId": { "$ref": "#/definitions/hex32" },
              "baselineFrontier": { "$ref": "#/definitions/frontier" }
            }
          },
          "pack": { "$ref": "#/definitions/part" },
          "spr": { "$ref": "#/definitions/part" },
          "packSha256": { "$ref": "#/definitions/hex32" },
          "sprSha256": { "$ref": "#/definitions/hex32" },
          "aggregateSha256": { "$ref": "#/definitions/hex32" },
          "bodyHex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" }
        }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "bodyHex", "refusal"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "enum": ["decode", "digest"] },
          "bodyHex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
          "refusal": { "type": "string", "pattern": "^canonical-checkpoint-pair\\.[a-z-]+$" }
        }
      }
    },
    "admissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pair", "scope", "expected", "refusal"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pair": { "type": "string", "minLength": 1 },
          "scope": { "$ref": "#/definitions/scope" },
          "expected": { "$ref": "#/definitions/checkpoint" },
          "refusal": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^canonical-checkpoint-pair\\.[a-z-]+$" }] }
        }
      }
    }
  }
}
