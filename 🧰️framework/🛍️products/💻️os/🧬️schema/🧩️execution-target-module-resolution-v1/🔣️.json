{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/execution-target-module-resolution-v1.json",
  "title": "Execution-target module resolution",
  "description": "How a shell resolves the component a hub document runs by the serving catalog generation: the local copy only on an equal content hash, a content-addressed store entry only when its bytes verify, else the hub's execution-target component and descriptor bytes, verified against the lease before they are stored and mounted. Bytes and lease come from the hub corpus document-execution-target-lease-v1. `eviction` is the store's own bound: components beyond `componentCapacityBytes` are evicted least recently used first (admitting or reading an entry uses it; the entry just admitted is never evicted), a read serves only bytes that still verify and removes an entry that does not, and the store survives a restart.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpus", "cases", "eviction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpus": { "type": "string", "minLength": 1 },
    "eviction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentCapacityBytes", "components", "steps"],
      "properties": {
        "componentCapacityBytes": { "type": "integer", "minimum": 1 },
        "components": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fill", "byteLength", "sha256"],
            "properties": {
              "fill": { "type": "integer", "minimum": 0, "maximum": 255 },
              "byteLength": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "component", "resident"],
                "properties": {
                  "op": { "enum": ["admit", "tamper"] },
                  "component": { "type": "string", "minLength": 1 },
                  "resident": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "component", "hit", "resident"],
                "properties": {
                  "op": { "const": "read" },
                  "component": { "type": "string", "minLength": 1 },
                  "hit": { "type": "boolean" },
                  "resident": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "resident"],
                "properties": {
                  "op": { "const": "restart" },
                  "resident": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
                }
              }
            ]
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "local", "store", "hub", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "local": { "enum": ["none", "leaseComponent", "otherComponent"] },
          "store": { "enum": ["empty", "verified", "tamperedComponent", "tamperedDescriptor"] },
          "hub": { "enum": ["exact", "wrongComponent", "wrongDescriptor", "cancelledAtComponent", "unavailableOnce", "unavailable"] },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "requests", "steps"],
            "properties": {
              "outcome": { "enum": ["local", "store", "hub", "refused", "cancelled"] },
              "requests": { "type": "array", "items": { "enum": ["manifest", "component", "descriptor"] } },
              "steps": { "type": "array", "items": { "enum": ["lease", "component", "descriptor", "verified"] } }
            }
          }
        }
      }
    }
  }
}
