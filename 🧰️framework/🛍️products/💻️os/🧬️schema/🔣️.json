{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/component.json",
  "title": "OS",
  "description": "Product-level os contracts owned by the os shell itself: the wire shapes its product-root backbone worker and TypeScript package exchange with the hub and with plugin runtimes. Module-level concerns live in the owning 🔨️modules/<m>/🧬️schema module instead.",
  "$defs": {
    "DocumentCachePairV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack",
        "spr"
      ],
      "properties": {
        "pack": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "spr": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "DocumentCacheAcceptanceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial",
        "candidate",
        "reply",
        "cases"
      ],
      "properties": {
        "initial": {
          "$ref": "#/$defs/DocumentCachePairV1"
        },
        "candidate": {
          "$ref": "#/$defs/DocumentCachePairV1"
        },
        "reply": {
          "$ref": "#/$defs/DocumentCachePairV1"
        },
        "cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "expected"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "done",
                  "document",
                  "error",
                  "error-document",
                  "transport",
                  "enqueue"
                ]
              },
              "expected": {
                "enum": [
                  "initial",
                  "candidate",
                  "reply"
                ]
              }
            }
          }
        }
      },
      "title": "Document Cache Acceptance V1"
    },
    "GisMapApprovalHistoryPhase": {
      "enum": [
        "unavailable",
        "available",
        "submitting",
        "applied",
        "failed"
      ]
    },
    "GisMapApprovalHistoryExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "canUndo",
        "retained",
        "oldOwnerRetired"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/GisMapApprovalHistoryPhase"
        },
        "canUndo": {
          "type": "boolean"
        },
        "retained": {
          "type": "boolean"
        },
        "oldOwnerRetired": {
          "type": "boolean"
        }
      }
    },
    "GisMapApprovalHistoryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "phases",
        "cases",
        "ordinaryHistory",
        "nonclaims"
      ],
      "properties": {
        "schema": {
          "const": "semio.os.gis-map-approval-history-fixture/v1"
        },
        "version": {
          "const": 1
        },
        "phases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": [
            {
              "const": "unavailable"
            },
            {
              "const": "available"
            },
            {
              "const": "submitting"
            },
            {
              "const": "applied"
            },
            {
              "const": "failed"
            }
          ],
          "additionalItems": false
        },
        "cases": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "current",
              "event",
              "ownerMatches",
              "mountedCurrentMatches",
              "revalidationMatches",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "current": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/GisMapApprovalHistoryPhase"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "event": {
                "enum": [
                  "approval-received",
                  "mounted-current",
                  "undo",
                  "rebootstrap",
                  "close"
                ]
              },
              "ownerMatches": {
                "type": "boolean"
              },
              "mountedCurrentMatches": {
                "type": "boolean"
              },
              "revalidationMatches": {
                "type": "boolean"
              },
              "expected": {
                "$ref": "#/$defs/GisMapApprovalHistoryExpected"
              }
            }
          }
        },
        "ordinaryHistory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remoteNewerThanLocal",
            "localNewerThanRemote",
            "remoteSubmitting",
            "noRemote"
          ],
          "properties": {
            "remoteNewerThanLocal": {
              "const": "remote"
            },
            "localNewerThanRemote": {
              "const": "local"
            },
            "remoteSubmitting": {
              "const": "blocked"
            },
            "noRemote": {
              "const": "local"
            }
          }
        },
        "nonclaims": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": [
            {
              "const": "no-shell-browser-process"
            },
            {
              "const": "no-gis-scene"
            },
            {
              "const": "no-second-peer"
            },
            {
              "const": "no-redo"
            }
          ],
          "additionalItems": false
        }
      }
    },
    "GisMapInferencePortPhase": {
      "enum": [
        "idle",
        "submitting",
        "running",
        "offered",
        "approving",
        "indeterminate",
        "applied",
        "cancelled",
        "stale",
        "failed"
      ]
    },
    "GisMapInferencePortCode": {
      "enum": [
        "inference.unavailable",
        "inference.denied",
        "inference.not-found",
        "inference.invalid",
        "inference.bounds",
        "inference.conflict",
        "inference.capacity",
        "inference.expired",
        "inference.cancelled",
        "approval.commit-unavailable",
        "inference.storage",
        "inference.transport",
        "inference.lease-unverified"
      ]
    },
    "GisMapInferencePortHex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "GisMapInferencePortHex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "GisMapInferencePortJobState": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "GisMapInferencePortProposalState": {
      "enum": [
        "none",
        "offered",
        "approved",
        "stale",
        "cancelled"
      ]
    },
    "GisMapInferencePortPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "proposalHash",
        "regionId",
        "ring"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.gis-map-inference-preview/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "proposalHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "regionId": {
          "type": "string",
          "pattern": "^inference-[0-9a-f]{32}$"
        },
        "ring": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "additionalItems": false
          }
        }
      }
    },
    "GisMapInferencePortStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "jobId",
        "cursor",
        "completed",
        "total",
        "proposalHash",
        "cancelRequested",
        "code"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/GisMapInferencePortPhase"
        },
        "jobId": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex32"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "proposalHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "$ref": "#/$defs/GisMapInferencePortPreview"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortCode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "GisMapInferencePortProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "runEpoch",
        "completed",
        "total",
        "atMs"
      ],
      "properties": {
        "cursor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "runEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "atMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "GisMapInferencePortReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "state",
        "proposalState",
        "proposalHash",
        "cursor",
        "expiresAtMs"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.inference-job-receipt/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "state": {
          "$ref": "#/$defs/GisMapInferencePortJobState"
        },
        "proposalState": {
          "$ref": "#/$defs/GisMapInferencePortProposalState"
        },
        "proposalHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "GisMapInferencePortPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "state",
        "proposalState",
        "proposalHash",
        "cancelRequested",
        "stale",
        "events",
        "progress",
        "nextCursor"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.inference-job-events/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "state": {
          "$ref": "#/$defs/GisMapInferencePortJobState"
        },
        "proposalState": {
          "$ref": "#/$defs/GisMapInferencePortProposalState"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "proposalHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "$ref": "#/$defs/GisMapInferencePortPreview"
        },
        "events": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object"
          }
        },
        "progress": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/GisMapInferencePortProgress"
          }
        },
        "nextCursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "GisMapInferencePortApprovalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "mutationId",
        "commandHash",
        "proposalHash",
        "applied",
        "undo"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.inference-approval-receipt/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "mutationId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "commandHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "proposalHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "applied": {
          "type": "boolean"
        },
        "undo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetId",
            "expectedCurrent"
          ],
          "properties": {
            "targetId": {
              "$ref": "#/$defs/GisMapInferencePortHex32"
            },
            "expectedCurrent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "documentId",
                "headEditOrdinal",
                "headEditId",
                "lastCommitSeq",
                "chainSha256"
              ],
              "properties": {
                "documentId": {
                  "type": "string",
                  "minLength": 1
                },
                "headEditOrdinal": {
                  "type": "integer",
                  "minimum": 1
                },
                "headEditId": {
                  "type": "string",
                  "minLength": 1
                },
                "lastCommitSeq": {
                  "type": "integer",
                  "minimum": 1
                },
                "chainSha256": {
                  "$ref": "#/$defs/GisMapInferencePortHex64"
                }
              }
            }
          }
        }
      }
    },
    "GisMapInferencePortEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "start",
            "lease-unverified",
            "receipt",
            "page",
            "approve",
            "approval",
            "cancel",
            "indeterminate",
            "failed",
            "clear"
          ]
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortReceipt"
            },
            {
              "$ref": "#/$defs/GisMapInferencePortApprovalReceipt"
            }
          ]
        },
        "page": {
          "$ref": "#/$defs/GisMapInferencePortPage"
        },
        "code": {
          "$ref": "#/$defs/GisMapInferencePortCode"
        }
      }
    },
    "GisMapInferencePortStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "event",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "$ref": "#/$defs/GisMapInferencePortEvent"
        },
        "expected": {
          "$ref": "#/$defs/GisMapInferencePortStatus"
        }
      }
    },
    "GisMapInferencePortHostile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "from",
        "event",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/GisMapInferencePortStatus"
        },
        "event": {
          "$ref": "#/$defs/GisMapInferencePortEvent"
        },
        "expected": {
          "$ref": "#/$defs/GisMapInferencePortStatus"
        }
      }
    },
    "GisMapInferencePendingCancelProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "jobId",
        "cancelRequested"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/GisMapInferencePortPhase"
        },
        "jobId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/GisMapInferencePortHex32"
            }
          ]
        },
        "cancelRequested": {
          "const": true
        }
      }
    },
    "GisMapInferencePortOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "viewBox", "path"],
      "properties": {
        "regionId": { "type": "string", "pattern": "^inference-[0-9a-f]{32}$" },
        "viewBox": { "const": "0 0 100 100" },
        "path": { "type": "string", "pattern": "^M [0-9.]+ [0-9.]+(?: L [0-9.]+ [0-9.]+){4} Z$" }
      }
    },
    "GisMapInferencePortLocaleText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    },
    "GisMapInferencePortControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "reject", "approve", "cancel", "overlay"],
      "properties": {
        "request": { "$ref": "#/$defs/GisMapInferencePortLocaleText" },
        "reject": { "$ref": "#/$defs/GisMapInferencePortLocaleText" },
        "approve": { "$ref": "#/$defs/GisMapInferencePortLocaleText" },
        "cancel": { "$ref": "#/$defs/GisMapInferencePortLocaleText" },
        "overlay": { "$ref": "#/$defs/GisMapInferencePortLocaleText" }
      }
    },
    "GisMapInferencePortUiRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "cancel", "reject", "approve", "overlay"],
      "properties": {
        "request": { "type": "boolean" },
        "cancel": { "type": "boolean" },
        "reject": { "type": "boolean" },
        "approve": { "type": "boolean" },
        "overlay": { "type": "boolean" }
      }
    },
    "GisMapInferencePortUiAffordances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idle", "submitting", "running", "offered", "approving"],
      "properties": {
        "idle": { "$ref": "#/$defs/GisMapInferencePortUiRow" },
        "submitting": { "$ref": "#/$defs/GisMapInferencePortUiRow" },
        "running": { "$ref": "#/$defs/GisMapInferencePortUiRow" },
        "offered": { "$ref": "#/$defs/GisMapInferencePortUiRow" },
        "approving": { "$ref": "#/$defs/GisMapInferencePortUiRow" }
      }
    },
    "GisMapInferencePortV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "phases",
        "terminalPhases",
        "ariaRoles",
        "codes",
        "locales",
        "serverJobStates",
        "serverProposalStates",
        "limits",
        "serviceId",
        "sampleJobId",
        "otherJobId",
        "proposalHash",
        "preview",
        "initial",
        "successLifecycle",
        "cancelLifecycle",
        "uncertainLifecycle",
        "cancelBeforeReceipt",
        "retainedClosing",
        "wire",
        "leaseRefusal",
        "hostileTransitions",
        "crossFixture",
        "nonclaims",
        "rejectLifecycle",
        "mapOverlay",
        "controls",
        "uiAffordances"
      ],
      "properties": {
        "schema": {
          "const": "semio.os.gis-map-inference-port-fixture/v1"
        },
        "version": {
          "const": 1
        },
        "phases": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/GisMapInferencePortPhase"
          }
        },
        "terminalPhases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "applied",
              "cancelled",
              "stale",
              "failed"
            ]
          }
        },
        "ariaRoles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idle",
            "submitting",
            "running",
            "offered",
            "approving",
            "indeterminate",
            "applied",
            "cancelled",
            "stale",
            "failed"
          ],
          "properties": {
            "idle": {
              "const": "status"
            },
            "submitting": {
              "const": "status"
            },
            "running": {
              "const": "status"
            },
            "offered": {
              "const": "status"
            },
            "approving": {
              "const": "status"
            },
            "indeterminate": {
              "const": "status"
            },
            "applied": {
              "const": "alert"
            },
            "cancelled": {
              "const": "alert"
            },
            "stale": {
              "const": "alert"
            },
            "failed": {
              "const": "alert"
            }
          }
        },
        "codes": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/GisMapInferencePortCode"
          }
        },
        "locales": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "en",
              "de"
            ]
          }
        },
        "serverJobStates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/GisMapInferencePortJobState"
          }
        },
        "serverProposalStates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/GisMapInferencePortProposalState"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestMaxBytes",
            "responseMaxBytes",
            "progressMaxCursor",
            "eventPageMaxItems",
            "jobMaxLifetimeMs",
            "pollIntervalMs",
            "maxPollTurns"
          ],
          "properties": {
            "requestMaxBytes": {
              "const": 1024
            },
            "responseMaxBytes": {
              "const": 16384
            },
            "progressMaxCursor": {
              "const": 16
            },
            "eventPageMaxItems": {
              "const": 8
