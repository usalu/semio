{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/component.json",
  "title": "OS",
  "description": "Product-level os contracts owned by the os shell itself: the wire shapes its product-root backbone worker and TypeScript package exchange with the hub and with plugin runtimes. Module-level concerns live in the owning 🔨️modules/<m>/🧬️schema module instead.",
  "$defs": {
    "DocumentCachePairV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack",
        "spr"
      ],
      "properties": {
        "pack": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "spr": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "DocumentCacheAcceptanceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial",
        "candidate",
        "reply",
        "cases"
      ],
      "properties": {
        "initial": {
          "$ref": "#/$defs/DocumentCachePairV1"
        },
        "candidate": {
          "$ref": "#/$defs/DocumentCachePairV1"
        },
        "reply": {
          "$ref": "#/$defs/DocumentCachePairV1"
        },
        "cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "expected"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "done",
                  "document",
                  "error",
                  "error-document",
                  "transport",
                  "enqueue"
                ]
              },
              "expected": {
                "enum": [
                  "initial",
                  "candidate",
                  "reply"
                ]
              }
            }
          }
        }
      },
      "title": "Document Cache Acceptance V1"
    },
    "LocalInteractionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "outerReadHex",
        "outerRejectedHex",
        "receiptHex",
        "malformedFrameHex",
        "maximumCommandBytes",
        "maximumReplyBytes",
        "lifecycles",
        "sequenceCases",
        "reopen",
        "lateTokenAccepted",
        "terminalBeforeClosed"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "outerReadHex": {
          "const": "1d0902000d"
        },
        "outerRejectedHex": {
          "const": "1703030d00"
        },
        "receiptHex": {
          "const": "0002"
        },
        "malformedFrameHex": {
          "const": "ff"
        },
        "maximumCommandBytes": {
          "const": 142
        },
        "maximumReplyBytes": {
          "const": 4256
        },
        "lateTokenAccepted": {
          "const": false
        },
        "terminalBeforeClosed": {
          "const": false
        },
        "reopen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "readSequences",
            "cancelSequences",
            "ordinarySequence",
            "ackSequence"
          ],
          "properties": {
            "requests": {
              "const": [
                "1",
                "2"
              ]
            },
            "readSequences": {
              "const": [
                1,
                3
              ]
            },
            "cancelSequences": {
              "const": [
                2,
                4
              ]
            },
            "ordinarySequence": {
              "const": 5
            },
            "ackSequence": {
              "const": 6
            }
          }
        },
        "sequenceCases": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "request",
              "operation",
              "result",
              "after"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "request": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "operation": {
                "enum": [
                  "ordinary",
                  "query"
                ]
              },
              "result": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sequence",
                      "cancelSequence",
                      "request"
                    ],
                    "properties": {
                      "sequence": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "cancelSequence": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "request": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              },
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sequence",
                  "request"
                ],
                "properties": {
                  "sequence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "request": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  }
                }
              }
            }
          }
        },
        "lifecycles": {
          "type": "array",
          "minItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "events",
              "cancelled"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "cancelled": {
                "type": "boolean"
              },
              "events": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "enum": [
                    "read",
                    "readReceipt",
                    "mixedReceipts",
                    "wrongReceipt",
                    "duplicateReadReceipt",
                    "started",
                    "startedWithNotice",
                    "pageWithNotice",
                    "page",
                    "malformed",
                    "consume",
                    "ack",
                    "closed",
                    "abort",
                    "cancel",
                    "ordinary",
                    "ordinaryDone",
                    "ordinaryEmpty",
                    "consumeError",
                    "dispose"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "JcoProbeDestinationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "packageId",
        "semanticOwnerRoot",
        "packageRoot",
        "cargoManifestPath",
        "cargoLockPath",
        "componentPath",
        "witPath",
        "adapterPath"
      ],
      "properties": {
        "kind": {
          "const": "jco-canonical-package-v1"
        },
        "packageId": {
          "const": "jcoprobe-guest"
        },
        "semanticOwnerRoot": {
          "const": "🧰️framework/🛍️products/💻️os/🧫️fixtures/🧩️jcoprobe/👽️guest"
        },
        "packageRoot": {
          "const": "🧰️framework/🛍️products/💻️os/🧫️fixtures/🧩️jcoprobe/👽️guest/📦️packages/🦀️rust"
        },
        "cargoManifestPath": {
          "const": "🧰️framework/🛍️products/💻️os/🧫️fixtures/🧩️jcoprobe/👽️guest/📦️packages/🦀️rust/Cargo.toml"
        },
        "cargoLockPath": {
          "const": "🧰️framework/🛍️products/💻️os/🧫️fixtures/🧩️jcoprobe/👽️guest/📦️packages/🦀️rust/Cargo.lock"
        },
        "componentPath": {
          "const": "🧰️framework/🛍️products/💻️os/🧫️fixtures/🧩️jcoprobe/👽️guest/🧩️component/🦀️.rs"
        },
        "witPath": {
          "const": "🧰️framework/🛍️products/💻️os/🧫️fixtures/🧩️jcoprobe/👽️guest/📦️packages/🦀️rust/🧬️schema/📜️world.wit"
        },
        "adapterPath": {
          "const": "🧰️framework/🛍️products/💻️os/🧫️fixtures/🧩️jcoprobe/👽️guest/📦️packages/🦀️rust/📚️library/🦀️.rs"
        }
      }
    }
  }
}
