{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/component.json",
  "title": "OS",
  "description": "Product-level os contracts owned by the os shell itself: the wire shapes its product-root backbone worker and TypeScript package exchange with the hub and with plugin runtimes. Module-level concerns live in the owning 🔨️modules/<m>/🧬️schema module instead.",
  "$defs": {
    "GisMapApprovalHistoryPhase": {
      "enum": [
        "unavailable",
        "available",
        "submitting",
        "applied",
        "failed"
      ]
    },
    "GisMapApprovalHistoryExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "canUndo",
        "retained",
        "oldOwnerRetired"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/GisMapApprovalHistoryPhase"
        },
        "canUndo": {
          "type": "boolean"
        },
        "retained": {
          "type": "boolean"
        },
        "oldOwnerRetired": {
          "type": "boolean"
        }
      }
    },
    "GisMapApprovalHistoryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "phases",
        "cases",
        "ordinaryHistory",
        "nonclaims"
      ],
      "properties": {
        "schema": {
          "const": "semio.os.gis-map-approval-history-fixture/v1"
        },
        "version": {
          "const": 1
        },
        "phases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": [
            {
              "const": "unavailable"
            },
            {
              "const": "available"
            },
            {
              "const": "submitting"
            },
            {
              "const": "applied"
            },
            {
              "const": "failed"
            }
          ],
          "additionalItems": false
        },
        "cases": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "current",
              "event",
              "ownerMatches",
              "mountedCurrentMatches",
              "revalidationMatches",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "current": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/GisMapApprovalHistoryPhase"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "event": {
                "enum": [
                  "approval-received",
                  "mounted-current",
                  "undo",
                  "rebootstrap",
                  "close"
                ]
              },
              "ownerMatches": {
                "type": "boolean"
              },
              "mountedCurrentMatches": {
                "type": "boolean"
              },
              "revalidationMatches": {
                "type": "boolean"
              },
              "expected": {
                "$ref": "#/$defs/GisMapApprovalHistoryExpected"
              }
            }
          }
        },
        "ordinaryHistory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remoteNewerThanLocal",
            "localNewerThanRemote",
            "remoteSubmitting",
            "noRemote"
          ],
          "properties": {
            "remoteNewerThanLocal": {
              "const": "remote"
            },
            "localNewerThanRemote": {
              "const": "local"
            },
            "remoteSubmitting": {
              "const": "blocked"
            },
            "noRemote": {
              "const": "local"
            }
          }
        },
        "nonclaims": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": [
            {
              "const": "no-shell-browser-process"
            },
            {
              "const": "no-gis-scene"
            },
            {
              "const": "no-second-peer"
            },
            {
              "const": "no-redo"
            }
          ],
          "additionalItems": false
        }
      }
    },
    "GisMapInferencePortPhase": {
      "enum": [
        "idle",
        "submitting",
        "running",
        "offered",
        "approving",
        "applied",
        "cancelled",
        "stale",
        "failed"
      ]
    },
    "GisMapInferencePortCode": {
      "enum": [
        "inference.unavailable",
        "inference.denied",
        "inference.not-found",
        "inference.invalid",
        "inference.bounds",
        "inference.conflict",
        "inference.capacity",
        "inference.expired",
        "inference.cancelled",
        "approval.commit-unavailable",
        "inference.storage",
        "inference.transport",
        "inference.lease-unverified"
      ]
    },
    "GisMapInferencePortHex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "GisMapInferencePortHex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "GisMapInferencePortJobState": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "GisMapInferencePortProposalState": {
      "enum": [
        "none",
        "offered",
        "approved",
        "stale",
        "cancelled"
      ]
    },
    "GisMapInferencePortPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "proposalHash",
        "regionId",
        "ring"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.gis-map-inference-preview/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "proposalHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "regionId": {
          "type": "string",
          "pattern": "^inference-[0-9a-f]{32}$"
        },
        "ring": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "additionalItems": false
          }
        }
      }
    },
    "GisMapInferencePortStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "jobId",
        "cursor",
        "completed",
        "total",
        "proposalHash",
        "cancelRequested",
        "code"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/GisMapInferencePortPhase"
        },
        "jobId": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex32"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "proposalHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "$ref": "#/$defs/GisMapInferencePortPreview"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortCode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "GisMapInferencePortProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "runEpoch",
        "completed",
        "total",
        "atMs"
      ],
      "properties": {
        "cursor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "runEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "atMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "GisMapInferencePortReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "state",
        "proposalState",
        "cursor",
        "expiresAtMs"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "state": {
          "$ref": "#/$defs/GisMapInferencePortJobState"
        },
        "proposalState": {
          "$ref": "#/$defs/GisMapInferencePortProposalState"
        },
        "proposalHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "GisMapInferencePortPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "state",
        "proposalState",
        "cancelRequested",
        "stale",
        "events",
        "progress",
        "nextCursor"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "state": {
          "$ref": "#/$defs/GisMapInferencePortJobState"
        },
        "proposalState": {
          "$ref": "#/$defs/GisMapInferencePortProposalState"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "proposalHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "preview": {
          "$ref": "#/$defs/GisMapInferencePortPreview"
        },
        "events": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object"
          }
        },
        "progress": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/GisMapInferencePortProgress"
          }
        },
        "nextCursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "GisMapInferencePortApprovalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "mutationId",
        "commandHash",
        "proposalHash",
        "applied",
        "undo"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "mutationId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "commandHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "proposalHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "applied": {
          "type": "boolean"
        },
        "undo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetId",
            "expectedCurrent"
          ],
          "properties": {
            "targetId": {
              "$ref": "#/$defs/GisMapInferencePortHex32"
            },
            "expectedCurrent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "documentId",
                "headEditOrdinal",
                "headEditId",
                "lastCommitSeq",
                "chainSha256"
              ],
              "properties": {
                "documentId": {
                  "type": "string",
                  "minLength": 1
                },
                "headEditOrdinal": {
                  "type": "integer",
                  "minimum": 1
                },
                "headEditId": {
                  "type": "string",
                  "minLength": 1
                },
                "lastCommitSeq": {
                  "type": "integer",
                  "minimum": 1
                },
                "chainSha256": {
                  "$ref": "#/$defs/GisMapInferencePortHex64"
                }
              }
            }
          }
        }
      }
    },
    "GisMapInferencePortEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "start",
            "lease-unverified",
            "receipt",
            "page",
            "approve",
            "approval",
            "cancel",
            "failed",
            "clear"
          ]
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortReceipt"
            },
            {
              "$ref": "#/$defs/GisMapInferencePortApprovalReceipt"
            }
          ]
        },
        "page": {
          "$ref": "#/$defs/GisMapInferencePortPage"
        },
        "code": {
          "$ref": "#/$defs/GisMapInferencePortCode"
        }
      }
    },
    "GisMapInferencePortStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "event",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "$ref": "#/$defs/GisMapInferencePortEvent"
        },
        "expected": {
          "$ref": "#/$defs/GisMapInferencePortStatus"
        }
      }
    },
    "GisMapInferencePortHostile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "from",
        "event",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/GisMapInferencePortStatus"
        },
        "event": {
          "$ref": "#/$defs/GisMapInferencePortEvent"
        },
        "expected": {
          "$ref": "#/$defs/GisMapInferencePortStatus"
        }
      }
    },
