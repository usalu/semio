            "cancelled": {
              "const": "alert"
            },
            "stale": {
              "const": "alert"
            },
            "failed": {
              "const": "alert"
            }
          }
        },
        "codes": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
