{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/config/opening.json",
  "title": "OpeningPreferences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaults"
  ],
  "properties": {
    "defaults": {
      "type": "array",
      "x-semio-state": "config",
      "items": {
        "$ref": "#/$defs/DefaultApp"
      }
    }
  },
  "$defs": {
    "DefaultApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialect",
        "role",
        "app"
      ],
      "properties": {
        "dialect": {
          "$ref": "https://semio.tech/schema/framework/io/schema.json#/$defs/ArtifactDialect"
        },
        "role": {
          "$ref": "https://semio.tech/schema/framework/manifest/schema.json#/$defs/AppRole"
        },
        "app": {
          "$ref": "https://semio.tech/schema/framework/manifest/schema.json#/$defs/AppRef"
        }
      }
    }
  }
}
