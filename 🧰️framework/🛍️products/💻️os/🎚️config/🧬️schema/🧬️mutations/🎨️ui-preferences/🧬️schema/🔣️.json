{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/config/mutation/ui-preferences.json",
  "title": "UiPreferencesConfigMutation",
  "oneOf": [
    { "$ref": "#/$defs/SetAppearance" },
    { "$ref": "#/$defs/SetLayout" },
    { "$ref": "#/$defs/SetDriver" },
    { "$ref": "#/$defs/SetCustomDriver" },
    { "$ref": "#/$defs/SetLocale" },
    { "$ref": "#/$defs/SetTerminology" },
    { "$ref": "#/$defs/SetTheme" },
    { "$ref": "#/$defs/SetCustomTheme" },
    { "$ref": "#/$defs/SetKeybindingOverride" },
    { "$ref": "#/$defs/SetNamedLayout" }
  ],
  "$defs": {
    "PreferenceKeys": { "$comment": "The one UiPreferences key each mutation writes; its data class is that key's (`../../../🎨️ui-preferences/🔣️.json` DataClasses).", "const": { "setAppearance": "appearance", "setLayout": "layout", "setDriver": "driverId", "setCustomDriver": "customDrivers", "setLocale": "locale", "setTerminology": "terminology", "setTheme": "themeId", "setCustomTheme": "customThemes", "setKeybindingOverride": "keybindingOverrides", "setNamedLayout": "namedLayouts" } },
    "SetAppearance": { "type": "object", "additionalProperties": false, "required": ["mutation", "appearance"], "properties": { "mutation": { "type": "string", "const": "setAppearance", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "appearance": { "anyOf": [{ "type": "string", "enum": ["system", "light", "dark"] }, { "type": "null" }], "x-semio-ui": { "widget": "segmented", "role": "value", "label": { "en": "Appearance", "de": "Erscheinungsbild" }, "options": { "system": { "en": "System", "de": "System" }, "light": { "en": "Light", "de": "Hell" }, "dark": { "en": "Dark", "de": "Dunkel" } }, "group": "shell", "order": 20 } } }, "x-semio-ui": { "label": { "en": "Appearance", "de": "Erscheinungsbild" } } },
    "SetLayout": { "type": "object", "additionalProperties": false, "required": ["mutation", "layout"], "properties": { "mutation": { "type": "string", "const": "setLayout", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "layout": { "anyOf": [{ "type": "string", "enum": ["desktop", "tablet"] }, { "type": "null" }], "x-semio-ui": { "widget": "segmented", "role": "value", "label": { "en": "Layout", "de": "Layout" }, "options": { "desktop": { "en": "Desktop", "de": "Desktop" }, "tablet": { "en": "Tablet", "de": "Tablet" } }, "group": "shell", "order": 20 } } }, "x-semio-ui": { "label": { "en": "Layout", "de": "Layout" } } },
    "SetDriver": { "type": "object", "additionalProperties": false, "required": ["mutation", "driverId"], "properties": { "mutation": { "const": "setDriver", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "driverId": { "anyOf": [{ "type": "string" }, { "type": "null" }], "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Driver", "de": "Treiber" }, "description": { "en": "Id of the input driver; empty resets to the default.", "de": "ID des Eingabetreibers; leer setzt auf den Standard zurück." }, "group": "shell", "order": 20 } } }, "x-semio-ui": { "label": { "en": "Driver", "de": "Treiber" } } },
    "SetCustomDriver": { "type": "object", "additionalProperties": false, "required": ["mutation", "driverId", "driver"], "properties": { "mutation": { "const": "setCustomDriver", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "driverId": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Driver ID", "de": "Treiber-ID" }, "group": "identity", "order": 20 } }, "driver": { "anyOf": [{ "$ref": "#/$defs/UiDriver" }, { "type": "null" }], "x-semio-ui": { "role": "value", "label": { "en": "Driver", "de": "Treiber" }, "group": "record", "order": 30 } } }, "x-semio-ui": { "label": { "en": "Custom driver", "de": "Eigener Treiber" } } },
    "SetLocale": { "type": "object", "additionalProperties": false, "required": ["mutation", "locale"], "properties": { "mutation": { "type": "string", "const": "setLocale", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "locale": { "anyOf": [{ "type": "string", "enum": ["en", "de"] }, { "type": "null" }], "x-semio-ui": { "widget": "segmented", "role": "value", "label": { "en": "Language", "de": "Sprache" }, "options": { "en": { "en": "English", "de": "Englisch" }, "de": { "en": "German", "de": "Deutsch" } }, "group": "shell", "order": 20 } } }, "x-semio-ui": { "label": { "en": "Language", "de": "Sprache" } } },
    "SetTerminology": { "type": "object", "additionalProperties": false, "required": ["mutation", "terminology"], "properties": { "mutation": { "const": "setTerminology", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "terminology": { "anyOf": [{ "type": "string" }, { "type": "null" }], "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Terminology", "de": "Terminologie" }, "description": { "en": "Terminology the shell names things with; empty resets it.", "de": "Terminologie, mit der die Oberfläche Dinge benennt; leer setzt sie zurück." }, "group": "shell", "order": 20 } } }, "x-semio-ui": { "label": { "en": "Terminology", "de": "Terminologie" } } },
    "SetTheme": { "type": "object", "additionalProperties": false, "required": ["mutation", "themeId"], "properties": { "mutation": { "const": "setTheme", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "themeId": { "anyOf": [{ "type": "string" }, { "type": "null" }], "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Theme", "de": "Design" }, "group": "shell", "order": 20 } } }, "x-semio-ui": { "label": { "en": "Theme", "de": "Design" } } },
    "SetCustomTheme": { "type": "object", "additionalProperties": false, "required": ["mutation", "themeId", "theme"], "properties": { "mutation": { "const": "setCustomTheme", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "themeId": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Theme ID", "de": "Design-ID" }, "group": "identity", "order": 20 } }, "theme": { "anyOf": [{ "$ref": "#/$defs/UiTheme" }, { "type": "null" }], "x-semio-ui": { "role": "value", "label": { "en": "Theme", "de": "Design" }, "group": "record", "order": 30 } } }, "x-semio-ui": { "label": { "en": "Custom theme", "de": "Eigenes Design" } } },
    "SetKeybindingOverride": { "type": "object", "additionalProperties": false, "required": ["mutation", "controlId", "keys"], "properties": { "mutation": { "const": "setKeybindingOverride", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "controlId": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Control", "de": "Steuerelement" }, "description": { "en": "Id of the remappable control.", "de": "ID des umbelegbaren Steuerelements." }, "group": "keybinding", "order": 20 } }, "keys": { "anyOf": [{ "type": "string" }, { "type": "null" }], "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Key binding", "de": "Tastenkürzel" }, "description": { "en": "Chord such as Ctrl+Shift+Z; empty restores the default.", "de": "Tastenkombination wie Strg+Umschalt+Z; leer stellt den Standard wieder her." }, "group": "keybinding", "order": 30 } } }, "x-semio-ui": { "label": { "en": "Key binding", "de": "Tastenkürzel" } } },
    "UiDriver": { "type": "object", "additionalProperties": false, "required": ["driverId", "label", "config"], "properties": { "driverId": { "type": "string" }, "label": { "type": "string" }, "config": {} } },
    "SetNamedLayout": { "type": "object", "additionalProperties": false, "required": ["mutation", "appId", "layoutId", "layout"], "properties": { "mutation": { "const": "setNamedLayout", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Preference", "de": "Einstellung" } } }, "appId": { "type": "string", "minLength": 1, "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "App", "de": "App" }, "group": "identity", "order": 20 } }, "layoutId": { "type": "string", "minLength": 1, "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Layout ID", "de": "Layout-ID" }, "group": "identity", "order": 30 } }, "layout": { "anyOf": [{ "$ref": "#/$defs/UserNamedLayout" }, { "type": "null" }], "x-semio-ui": { "role": "value", "label": { "en": "Named layout", "de": "Benanntes Layout" }, "group": "record", "order": 40 } } }, "x-semio-ui": { "label": { "en": "Named layout", "de": "Benanntes Layout" } } },
    "UiDriver": { "type": "object", "additionalProperties": false, "required": ["driverId", "label", "config"], "properties": { "driverId": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Driver ID", "de": "Treiber-ID" }, "group": "identity", "order": 10 } }, "label": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Label", "de": "Bezeichnung" }, "group": "identity", "order": 20 } }, "config": { "x-semio-ui": { "role": "value", "label": { "en": "Configuration", "de": "Konfiguration" }, "group": "record", "order": 30 } } } },
    "UiTheme": { "type": "object", "additionalProperties": false, "required": ["themeId", "label", "config"], "properties": { "themeId": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Theme ID", "de": "Design-ID" }, "group": "identity", "order": 10 } }, "label": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Label", "de": "Bezeichnung" }, "group": "identity", "order": 20 } }, "config": { "x-semio-ui": { "role": "value", "label": { "en": "Configuration", "de": "Konfiguration" }, "group": "record", "order": 30 } } } },
    "UserNamedLayout": { "$comment": "Same shape as `../../../🎨️ui-preferences/🔣️.json` $defs.UserNamedLayout.", "type": "object", "additionalProperties": false, "required": ["label", "layout"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 256, "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Label", "de": "Bezeichnung" }, "group": "identity", "order": 10 } }, "layout": { "$ref": "#/$defs/WindowLayout", "x-semio-ui": { "role": "value", "label": { "en": "Window layout", "de": "Fensterlayout" }, "group": "record", "order": 20 } } } },
    "WindowLayout": { "type": "object", "additionalProperties": false, "required": ["root"], "properties": { "root": { "oneOf": [{ "$ref": "#/$defs/WindowLayoutAxisNode" }, { "$ref": "#/$defs/WindowLayoutStackNode" }], "x-semio-ui": { "role": "value", "label": { "en": "Root", "de": "Wurzel" }, "group": "record", "order": 10 } } } },
    "WindowLayoutAxisNode": { "type": "object", "additionalProperties": false, "required": ["kind", "children"], "properties": { "kind": { "enum": ["row", "column"], "x-semio-ui": { "widget": "segmented", "role": "value", "label": { "en": "Direction", "de": "Richtung" }, "options": { "row": { "en": "Row", "de": "Zeile" }, "column": { "en": "Column", "de": "Spalte" } }, "group": "layout", "order": 10 } }, "size": { "type": "number", "x-semio-ui": { "widget": "stepper", "role": "value", "label": { "en": "Size", "de": "Größe" }, "description": { "en": "Share of the parent's extent.", "de": "Anteil an der Ausdehnung des Elternknotens." }, "step": 0.05, "precision": 2, "group": "layout", "order": 20 } }, "children": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/WindowLayoutAxisNode" }, { "$ref": "#/$defs/WindowLayoutStackNode" }] }, "x-semio-ui": { "role": "value", "label": { "en": "Children", "de": "Kinder" }, "group": "record", "order": 30 } } }, "x-semio-ui": { "label": { "en": "Split", "de": "Aufteilung" } } },
    "WindowLayoutStackNode": { "type": "object", "additionalProperties": false, "required": ["kind", "children"], "properties": { "kind": { "const": "stack", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Kind", "de": "Art" } } }, "size": { "type": "number", "x-semio-ui": { "widget": "stepper", "role": "value", "label": { "en": "Size", "de": "Größe" }, "description": { "en": "Share of the parent's extent.", "de": "Anteil an der Ausdehnung des Elternknotens." }, "step": 0.05, "precision": 2, "group": "layout", "order": 20 } }, "children": { "type": "array", "items": { "$ref": "#/$defs/WindowLayoutWindowNode" }, "x-semio-ui": { "role": "value", "label": { "en": "Children", "de": "Kinder" }, "group": "record", "order": 30 } } }, "x-semio-ui": { "label": { "en": "Window stack", "de": "Fensterstapel" } } },
    "WindowLayoutWindowNode": { "type": "object", "additionalProperties": false, "required": ["kind", "windowKindId"], "properties": { "kind": { "const": "window", "x-semio-ui": { "widget": "hidden", "role": "discriminator", "label": { "en": "Kind", "de": "Art" } } }, "windowKindId": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Window kind", "de": "Fensterart" }, "group": "window", "order": 20 } }, "title": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Title", "de": "Titel" }, "group": "window", "order": 30 } }, "instanceId": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Window instance", "de": "Fensterinstanz" }, "group": "window", "order": 40 } }, "templateId": { "type": "string", "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Template", "de": "Vorlage" }, "group": "window", "order": 50 } }, "corner": { "enum": ["topLeft", "topRight", "bottomLeft", "bottomRight"], "x-semio-ui": { "widget": "select", "role": "value", "label": { "en": "Corner", "de": "Ecke" }, "options": { "topLeft": { "en": "Top left", "de": "Oben links" }, "topRight": { "en": "Top right", "de": "Oben rechts" }, "bottomLeft": { "en": "Bottom left", "de": "Unten links" }, "bottomRight": { "en": "Bottom right", "de": "Unten rechts" } }, "group": "window", "order": 60 } } } }
  }
}
