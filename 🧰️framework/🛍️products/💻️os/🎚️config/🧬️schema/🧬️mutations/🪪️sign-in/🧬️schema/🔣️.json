{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/config/mutation/sign-in/schema.json",
  "title": "SignIn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "displayName",
    "email",
    "hubBaseUrl",
    "issuedAtMs",
    "userId"
  ],
  "properties": {
    "mutation": {
      "const": "signIn"
    },
    "userId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "User ID",
          "de": "Benutzer-ID"
        },
        "group": "identity",
        "order": 10
      }
    },
    "email": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Email",
          "de": "E-Mail"
        },
        "group": "identity",
        "order": 20
      }
    },
    "displayName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Display name",
          "de": "Anzeigename"
        },
        "group": "identity",
        "order": 30
      }
    },
    "hubBaseUrl": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Hub URL",
          "de": "Hub-URL"
        },
        "group": "hub",
        "order": 40
      }
    },
    "issuedAtMs": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Issued at",
          "de": "Ausgestellt am"
        },
        "description": {
          "en": "Unix time in milliseconds.",
          "de": "Unix-Zeit in Millisekunden."
        },
        "unit": "ms",
        "step": 1,
        "precision": 0,
        "group": "metadata",
        "order": 50
      }
    }
  }
}
