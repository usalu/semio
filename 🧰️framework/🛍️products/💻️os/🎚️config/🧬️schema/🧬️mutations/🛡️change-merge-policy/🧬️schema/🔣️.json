{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/config/mutation/change-merge-policy/schema.json",
  "title": "ChangeMergePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "policy"
  ],
  "properties": {
    "mutation": {
      "const": "changeMergePolicy"
    },
    "policy": {
      "title": "MergePolicy",
      "type": "string",
      "enum": [
        "LaissezFaire",
        "Normal",
        "Vigilant"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Merge policy",
          "de": "Zusammenführungsrichtlinie"
        },
        "description": {
          "en": "Lowest outcome severity that rejects incoming history: laissez-faire rejects fatal only, normal rejects errors, vigilant rejects warnings too.",
          "de": "Niedrigster Schweregrad, ab dem eingehende Historie abgelehnt wird: Laissez-faire lehnt nur Fatales ab, Normal lehnt Fehler ab, Wachsam auch Warnungen."
        },
        "options": {
          "LaissezFaire": {
            "en": "Laissez-faire",
            "de": "Laissez-faire"
          },
          "Normal": {
            "en": "Normal",
            "de": "Normal"
          },
          "Vigilant": {
            "en": "Vigilant",
            "de": "Wachsam"
          }
        },
        "group": "policy",
        "order": 10
      }
    }
  }
}
