{
  "name": "@semio-tech/framework-os-config",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "sourceRoot": "🧰️framework/🛍️products/💻️os/🎚️config/📦️packages/🦀️rust",
  "targets": {
    "check": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🎚️config/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/💻️os/🎚️config/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
