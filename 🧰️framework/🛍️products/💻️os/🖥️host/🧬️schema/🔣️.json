{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/host/component.json",
  "$ref": "#/$defs/OsHostCodecAbiV1",
  "$defs": {
    "OsHostCodecAbiV1": {
      "title": "OS Host Codec ABI",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operations",
        "errors",
        "request",
        "reply",
        "limits"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operations": {
          "const": {
            "mediaAcceptFilterKinds": 1539,
            "normalizeStdioFormatKind": 1540
          }
        },
        "errors": {
          "const": {
            "malformedRequest": 1,
            "missingKindArray": 4,
            "unknownKind": 5,
            "invalidUtf8": 6,
            "inputLimit": 7,
            "outputLimit": 8,
            "invalidState": 9
          }
        },
        "request": {
          "const": {
            "metadataOrder": [
              "version:u8",
              "inputBytes:u32le"
            ],
            "filterOrder": [
              "version:u8",
              "kindCount:u16le",
              "kinds:(byteLength:u16le,utf8)*"
            ],
            "filterRetainedState": [
              "header:3bytes",
              "currentLength:2bytes",
              "currentKind:max1024bytes",
              "resolvedOutput"
            ],
            "normalizeOrder": [
              "kindUtf8:max1024bytes"
            ],
            "normalizeRetainedState": [
              "currentKind:max1024bytes",
              "resolvedOutput"
            ],
            "admission": "one-byte-or-completed-item-opportunity-per-grant"
          }
        },
        "reply": {
          "const": {
            "payloadOrder": [
              "version:u8",
              "kind:u8",
              "byteLength:u32le",
              "bytes"
            ],
            "kinds": {
              "acceptFilterUtf8": 2,
              "normalizedKindUtf8": 3
            },
            "summaryOrder": [
              "version:u8",
              "kind:u8",
              "outputBytes:u32le"
            ]
          }
        },
        "limits": {
          "const": {
            "inputBytes": 1048576,
            "outputBytes": 1048576,
            "pageBytes": 65536,
            "transferPages": 256,
            "kindCount": 256,
            "kindBytes": 1024,
            "diagnosticBytes": 1024
          }
        }
      }
    }
  }
}
