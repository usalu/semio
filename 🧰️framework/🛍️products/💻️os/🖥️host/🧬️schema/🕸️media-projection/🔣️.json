{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/os/host/media-projection/component.json",
  "$ref": "#/$defs/WorkflowMediaContractProjectionV1",
  "$defs": {
    "WorkflowMediaContractProjectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kindId",
        "mediaType",
        "wire",
        "conversion"
      ],
      "properties": {
        "kindId": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "form"
          ],
          "properties": {
            "class": {
              "enum": [
                "twoD",
                "threeD",
                "text",
                "data",
                "graph",
                "kit",
                "computation",
                "presentation"
              ]
            },
            "form": {
              "$ref": "#/definitions/form"
            }
          }
        },
        "wire": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "schema"
              ],
              "properties": {
                "kind": {
                  "const": "document"
                },
                "schema": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "formatKind"
              ],
              "properties": {
                "kind": {
                  "const": "binary"
                },
                "formatKind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "conversion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/form"
                },
                {
                  "$ref": "#/definitions/form"
                }
              ],
              "additionalItems": false,
              "minItems": 2,
              "maxItems": 2
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "form": {
      "enum": [
        "any",
        "vector",
        "raster",
        "brep",
        "mesh",
        "document",
        "value",
        "dag",
        "trinity",
        "type",
        "design",
        "kit",
        "flow",
        "sequence",
        "procedure",
        "deck"
      ]
    }
  }
}
