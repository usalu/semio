{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/os/gis-map-approval-history-fixture-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "phases", "cases", "ordinaryHistory", "nonclaims"],
  "$defs": {
    "phase": { "enum": ["unavailable", "available", "submitting", "applied", "failed"] },
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["phase", "canUndo", "retained"],
      "required": ["phase", "canUndo", "retained", "oldOwnerRetired"],
      "properties": { "phase": { "$ref": "#/$defs/phase" }, "canUndo": { "type": "boolean" }, "retained": { "type": "boolean" }, "oldOwnerRetired": { "type": "boolean" } }
    }
  },
  "properties": {
    "schema": { "const": "semio.os.gis-map-approval-history-fixture/v1" },
    "version": { "const": 1 },
    "phases": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "prefixItems": [{ "const": "unavailable" }, { "const": "available" }, { "const": "submitting" }, { "const": "applied" }, { "const": "failed" }], "items": false
    },
    "cases": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "current", "event", "ownerMatches", "mountedCurrentMatches", "revalidationMatches", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "current": { "oneOf": [{ "$ref": "#/$defs/phase" }, { "type": "null" }] },
          "event": { "enum": ["approval-received", "mounted-current", "undo", "rebootstrap", "close"] },
          "ownerMatches": { "type": "boolean" }, "mountedCurrentMatches": { "type": "boolean" }, "revalidationMatches": { "type": "boolean" }, "expected": { "$ref": "#/$defs/expected" }
        }
      }
    },
    "ordinaryHistory": {
      "type": "object", "additionalProperties": false,
      "required": ["remoteNewerThanLocal", "localNewerThanRemote", "remoteSubmitting", "noRemote"],
      "properties": { "remoteNewerThanLocal": { "const": "remote" }, "localNewerThanRemote": { "const": "local" }, "remoteSubmitting": { "const": "blocked" }, "noRemote": { "const": "local" } }
    },
    "nonclaims": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "prefixItems": [{ "const": "no-shell-browser-process" }, { "const": "no-gis-scene" }, { "const": "no-second-peer" }, { "const": "no-redo" }], "items": false
    }
  }
}
