{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "lib": ["DOM", "DOM.AsyncIterable", "DOM.Iterable", "ESNext"],
    "tsBuildInfoFile": "../../../node_modules/.cache/tsconfig.os.tsbuildinfo",
    "types": ["bun", "node", "react", "react-dom", "vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/📤️dist/**",
    "**/storybook-static/**",
    "**/target/**",
    "**/🎯️target/**",
    "**/🗑️generated/**",
    "**/🤖️generated/**",
    "**/🕸️bindings/**",
    "🔨️modules/🧑‍💻dev/🧩️extension-modules/**",
    "🔨️modules/🧑‍💻dev/🔌️plugin-modules/**",
    "🧫️fixtures/🧩️jcoprobe/🌐️browser-bundles/**"
  ]
}
