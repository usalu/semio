{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "tsBuildInfoFile": "../../../node_modules/.cache/tsconfig.os.tsbuildinfo",
    "types": ["bun", "node", "react", "react-dom", "vite/client"],
    "paths": {
      "dom-accessibility-api": ["../../../node_modules/dom-accessibility-api/dist/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/📤️dist/**",
    "**/storybook-static/**",
    "**/target/**",
    "**/🎯️target/**",
    "**/🗑️generated/**",
    "**/🤖️generated/**",
    "**/🕸️bindings/**",
    "🔨️modules/🧑‍💻dev/🧩️extension-modules/**",
    "🔨️modules/🧑‍💻dev/🔌️plugin-modules/**",
    "🧪️testing/🧩️jcoprobe/🌐️browser-bundles/**"
  ]
}
