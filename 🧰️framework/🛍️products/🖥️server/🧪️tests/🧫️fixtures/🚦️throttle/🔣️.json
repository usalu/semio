    },
    {
      "name": "an allowance refills over hours and says how long its next token takes",
      "rate": { "tokens": 100, "perMs": 3600000, "burst": 3 },
      "requests": [
        { "atMs": 0, "admitted": true },
        { "atMs": 1, "admitted": true },
        { "atMs": 2, "admitted": true },
        { "atMs": 3, "admitted": false, "retryAfterMs": 35997 },
        { "atMs": 30000, "admitted": false, "retryAfterMs": 6000 },
        { "atMs": 36000, "admitted": true },
        { "atMs": 36000, "admitted": false, "retryAfterMs": 36000 },
        { "atMs": 108000, "admitted": true },
