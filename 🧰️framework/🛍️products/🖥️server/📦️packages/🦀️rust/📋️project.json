{
  "name": "@semio-tech/framework-server-rs",
  "$schema": "../../../🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "root": "🧰️framework/🛍️products/🖥️server/📦️packages/🦀️rust",
  "sourceRoot": "🧰️framework/🛍️products/🖥️server/📦️packages/🦀️rust",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "role:product",
    "family:server"
  ],
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/**/*.rs",
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/✨️macros/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "inputs": [
        "production",
        "^production",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🛍️products/🖥️server/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ]
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🖥️server/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
