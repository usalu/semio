{
  "name": "@semio-tech/framework-server",
  "$schema": "../../../🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/🧬️wire-types/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/🚚️transport/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/🔤️codec/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/🛣️routes-and-sockets/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/📡️client/🟦️.ts",
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/🧪️tests/🎚️config/🟦️.ts",
      "sharedGlobals"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv"
      ],
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🖥️server/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
