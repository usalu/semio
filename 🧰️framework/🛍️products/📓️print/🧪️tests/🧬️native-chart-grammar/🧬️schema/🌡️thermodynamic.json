{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["toleranceMm", "sources", "profile", "primaryProjected", "guards", "cases"],
  "properties": {
    "toleranceMm": { "type": "number", "exclusiveMinimum": 0 },
    "sources": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["url", "sha256"], "properties": { "url": { "type": "string", "pattern": "^https://raw.githubusercontent.com/SciTools/tephi/" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
    "profile": { "type": "array", "minItems": 4, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } },
    "primaryProjected": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/pair" } } },
    "guards": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["id", "options"], "properties": { "id": { "type": "string", "pattern": "^[a-z-]+$" }, "options": { "type": "string", "minLength": 1 } } } },
    "cases": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["id", "mode", "domain", "pressure", "width", "height", "explicitRange", "background"], "properties": { "id": { "type": "string", "pattern": "^[a-z-]+$" }, "mode": { "enum": ["skew-t", "tephigram"] }, "domain": { "$ref": "#/definitions/pair" }, "pressure": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "explicitRange": { "type": "boolean" }, "background": { "type": "boolean" } } } }
  },
  "definitions": { "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } }
}
