{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrintNativeGrammarEmission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "name",
    "source"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "main",
        "spatial",
        "planar"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.tex$",
      "maxLength": 160
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "prefix": "SEMIO_PRINT_NATIVE_V1 ",
        "maximumBytes": 2097152,
        "maximumRecords": 512,
        "maximumFileBytes": 131072
      }
    }
  }
}
