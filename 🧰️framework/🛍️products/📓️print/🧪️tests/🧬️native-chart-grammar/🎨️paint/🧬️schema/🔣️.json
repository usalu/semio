{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumOperators": 262144,
        "maximumSteps": 2097152,
        "maximumPoints": 262144,
        "maximumRows": 16384,
        "maximumLogicalOutputBytes": 16777216,
        "yieldSteps": 256,
        "progressSteps": 4096,
        "pointChargeBytes": 64,
        "rowChargeBytes": 256,
        "maximumStackDepth": 256,
        "maximumDashEntries": 64,
        "maximumTextBytes": 1048576
      }
    },
    "FailureCase": {
      "enum": [
        "cancel",
        "points",
        "marker",
        "detached-undefined"
      ]
    }
  }
}
