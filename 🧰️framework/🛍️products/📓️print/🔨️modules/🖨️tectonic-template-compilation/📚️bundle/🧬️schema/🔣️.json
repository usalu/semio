{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/print/tectonic-template-compilation/bundle/schema.json",
  "title": "PrintBundleManifest",
  "description": "Locked TeX bundle ranges fetched for reproducible tectonic runs.",
  "$ref": "#/$defs/PrintBundleManifest",
  "$defs": {
    "PrintBundleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "url",
        "archiveBytes",
        "upstreamIdentity",
        "files"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^ ]+\\.tar$"
        },
        "archiveBytes": {
          "type": "integer",
          "minimum": 1
        },
        "upstreamIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PrintBundleFile"
          }
        }
      }
    },
    "PrintBundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "offset",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
