{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "const": "build"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "additionalItems": false
    },
    {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "const": "complete"
        },
        {
          "enum": [
            "templates",
            "visualizations"
          ]
        }
      ],
      "additionalItems": false
    },
    {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": [
        {
          "const": "watch"
        }
      ],
      "additionalItems": false
    }
  ]
}
