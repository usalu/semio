{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "family",
      "directory",
      "filename",
      "texFilename"
    ],
    "properties": {
      "family": {
        "type": "string",
        "minLength": 1
      },
      "directory": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\]+$"
      },
      "filename": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\]+$"
      },
      "texFilename": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\]+$"
      }
    }
  }
}
