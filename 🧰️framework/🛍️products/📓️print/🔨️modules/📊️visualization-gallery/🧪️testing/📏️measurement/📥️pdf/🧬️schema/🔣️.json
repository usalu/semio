{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrintPdfMeasurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hash",
    "pages"
  ],
  "properties": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "string",
        "maxLength": 1048576
      }
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumPdfBytes": 67108864,
        "maximumInflatedBytes": 134217728,
        "maximumPages": 512,
        "maximumPageTextItems": 16384,
        "maximumTextBytes": 16777216,
        "maximumPageTextUnits": 1048576,
        "maximumErrorUnits": 8192,
        "maximumWorkers": 1,
        "maximumWorkerOldGenerationMiB": 256
      }
    }
  }
}
