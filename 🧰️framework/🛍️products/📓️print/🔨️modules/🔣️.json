{
  "x-semio": {
    "kind": "collection",
    "members": [
      {
        "directory": "🎨print-design-token-paints",
        "id": "framework.print.module.print-design-token-paints",
        "kind": "module",
        "module": {
          "productionConsumers": [
            "framework.print.command.latex-token-stylesheet-generation",
            "framework.print.command.template-pdf-build",
            "framework.print.command.template-pdf-watch"
          ]
        },
        "responsibility": "Resolves design-token paints and renders the canonical LaTeX design-token stylesheet text."
      },
      {
        "directory": "🕸️graph",
        "id": "framework.print.module.graph",
        "kind": "module",
        "module": {
          "productionConsumers": [
            "framework.print.module.source-staging",
            "framework.print.module.tectonic-template-compilation"
          ]
        },
        "responsibility": "Defines the implementation-neutral graph vocabulary and rendering macros consumed by print surfaces."
      },
      {
        "directory": "🔤print-font-catalog",
        "id": "framework.print.module.print-font-catalog",
        "kind": "module",
        "module": {
          "productionConsumers": [
            "framework.print.command.print-font-provisioning",
            "framework.print.command.template-pdf-build",
            "framework.print.command.template-pdf-watch"
          ]
        },
        "responsibility": "Defines the canonical print-font descriptors and their deterministic search paths."
      },
      {
        "directory": "🖨️tectonic-template-compilation",
        "id": "framework.print.module.tectonic-template-compilation",
        "kind": "module",
        "module": {
          "productionConsumers": [
            "framework.print.command.template-pdf-build",
            "framework.print.command.template-pdf-watch"
          ]
        },
        "responsibility": "Compiles one registered TeX template's light and dark representations to verified PDFs, including its panel-glass pass."
      },
      {
        "directory": "📊️visualization-gallery",
        "id": "framework.print.module.visualization-gallery",
        "kind": "module",
        "module": {
          "productionConsumers": [
            "framework.print.module.tectonic-template-compilation",
            "framework.print.command.print-pipeline-verification",
            "framework.print.command.viz-catalog-generation"
          ]
        },
        "responsibility": "Loads the chart-kind catalogue, generates the visualization catalogue packages and gallery documents, and checks taxonomy coverage, family registration and option vocabularies."
      },
      {
        "directory": "📊️viz-kernel",
        "id": "framework.print.module.viz-kernel",
        "kind": "module",
        "module": {
          "productionConsumers": [
            "framework.print.module.visualization-gallery",
            "framework.print.command.viz-catalog-generation"
          ]
        },
        "responsibility": "Implements the visualization kernel in TypeScript — scales, formats, transforms, marks, shapes, coordinate systems, hierarchy, network, flow, geo and spatial layouts, themes — and renders a chart specification into the 2D scene graph and into TikZ source."
      },
      {
        "directory": "📥️source-staging",
        "id": "framework.print.module.source-staging",
        "kind": "module",
        "module": {
          "productionConsumers": [
            "framework.print.module.tectonic-template-compilation",
            "mit-bestand.bericht"
          ]
        },
        "responsibility": "Stages semantic source filenames and references for compiler-safe template and report builds."
      },
      {
        "directory": "🧪️viz-probe",
        "id": "framework.print.module.viz-probe",
        "kind": "module",
        "module": {
          "productionConsumers": [
            "framework.print.command.print-pipeline-verification"
          ]
        },
        "responsibility": "Compiles a semio-viz-probe document with the repository tectonic and returns its validated numeric records as a comparable projection."
      }
    ]
  }
}
