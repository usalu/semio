% 🔑 Uncertainty keys, `semio / viz / family / uncertainty`.
% mark      (choice `errorbar|interval|forest|band|fan|gradient|funnel|density|pvalue|power`, default errorbar)
% estimate  (column, default `estimate`)  point estimate column
% lower     (column, default `lower`)     lower interval bound column
% upper     (column, default `upper`)     upper interval bound column
% weight    (column, default `weight`)    weight column; drives the forest box area and the funnel y axis
% itemlabel (column, default `label`)     row label column
% reference (fp, default 1)               reference value drawn as a dashed rule
% levels    (int, default 3)              number of nested bands of a fan or gradient band
% cap       (mm, default 1.2)             half-length of the error bar cap
\tl_new:N \l_semio_viz_unc_mark_tl
\tl_new:N \l_semio_viz_unc_estimate_tl
\tl_new:N \l_semio_viz_unc_lower_tl
\tl_new:N \l_semio_viz_unc_upper_tl
\tl_new:N \l_semio_viz_unc_weight_tl
\tl_new:N \l_semio_viz_unc_label_tl
\fp_new:N \l_semio_viz_unc_reference_fp
\int_new:N \l_semio_viz_unc_levels_int
\fp_new:N \l_semio_viz_unc_cap_fp

\keys_define:nn { semio / viz / family / uncertainty } {
  mark      .tl_set:N = \l_semio_viz_unc_mark_tl,
  estimate  .tl_set:N = \l_semio_viz_unc_estimate_tl,
  lower     .tl_set:N = \l_semio_viz_unc_lower_tl,
  upper     .tl_set:N = \l_semio_viz_unc_upper_tl,
  weight    .tl_set:N = \l_semio_viz_unc_weight_tl,
  itemlabel .tl_set:N = \l_semio_viz_unc_label_tl,
  reference .fp_set:N = \l_semio_viz_unc_reference_fp,
  levels    .int_set:N = \l_semio_viz_unc_levels_int,
  cap       .fp_set:N = \l_semio_viz_unc_cap_fp,
  unknown   .code:n = { },
}

% 🔑 Evaluation keys, `semio / viz / family / evaluation`.
