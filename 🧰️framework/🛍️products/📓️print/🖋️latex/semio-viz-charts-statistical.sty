\tl_new:N \l_semio_viz_tr_eval_score_tl
\tl_new:N \l_semio_viz_tr_eval_truth_tl
\bool_new:N \l_semio_viz_tr_eval_diagonal_bool
\bool_new:N \l_semio_viz_tr_eval_points_bool
\int_new:N \l_semio_viz_tr_eval_bars_int

\keys_define:nn { semio / viz / family / evaluation } {
  curve    .tl_set:N = \l_semio_viz_tr_eval_curve_tl,
  score    .tl_set:N = \l_semio_viz_tr_eval_score_tl,
  truth    .tl_set:N = \l_semio_viz_tr_eval_truth_tl,
  diagonal .bool_set:N = \l_semio_viz_tr_eval_diagonal_bool,
  points   .bool_set:N = \l_semio_viz_tr_eval_points_bool,
