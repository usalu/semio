\cs_new:Npn \semio_thesis_label_dissertation: {
  \tl_if_blank:VTF \l_semio_thesis_type_tl {
    \str_case:VnF \l_semio_thesis_level_tl {
      { bachelor } { \semio_thesis_label:nn { Bachelor's~Thesis } { Bachelorarbeit } }
      { master } { \semio_thesis_label:nn { Master's~Thesis } { Masterarbeit } }
      { doctoral } { Dissertation }
    } { \semio_thesis_label:nn { Thesis } { Abschlussarbeit } }
  } { \tl_use:N \l_semio_thesis_type_tl }
}
\cs_new:Npn \semio_thesis_label:nn #1#2 {
  \str_if_eq:VnTF \l_semio_language_tl { de } {#2} {#1}
}
\NewExpandableDocumentCommand \SemioThesisTypeTitle {} { \semio_thesis_label_dissertation: }
\cs_new_protected:Npn \semio_thesis_validate: {
  \tl_if_blank:VT \l_semio_thesis_level_tl {
    \PackageError{semio-thesis}{Thesis~level~is~required}{Set~thesis-level=bachelor,~master,~doctoral~or~custom.}
  }
  \str_if_eq:VnT \l_semio_thesis_level_tl { custom } {
    \tl_if_blank:VT \l_semio_thesis_type_tl {
      \PackageError{semio-thesis}{Custom~thesis~type~is~required}{Set~thesis-type~to~the~required~title.}
    }
  }
}
\AddToHook{begindocument}{
  \clist_if_in:nVT { thesis, phd } \l_semio_type_tl {
    \hypersetup{pdftitle={\@title},pdfauthor={\@author},pdfkeywords={\tl_use:N \l_semio_thesis_keywords_tl}}
  }
}
\AddToHook{begindocument/before}{
  \clist_if_in:nVT { thesis, phd } \l_semio_type_tl { \semio_thesis_validate: }
}

