\ExplSyntaxOff
\newcommand{\semio@thesis@declaration@en}{%
  I declare that this thesis is my own work, that I have used no sources or aids other than the ones named in it, and that every passage taken from another work, in letter or in substance, is marked as such. This thesis has not been submitted, in this or a similar form, to any other examination authority.%
}
\newcommand{\semio@thesis@declaration@de}{%
  Hiermit erkläre ich, dass ich die vorliegende Arbeit selbstständig verfasst und keine anderen als die angegebenen Quellen und Hilfsmittel benutzt habe, und dass alle Stellen, die dem Wortlaut oder dem Sinn nach anderen Werken entnommen sind, als solche kenntlich gemacht wurden. Diese Arbeit wurde in gleicher oder ähnlicher Form noch keiner anderen Prüfungsbehörde vorgelegt.%
}
\ExplSyntaxOn

\cs_new_protected:Npn \semio_thesis_declaration_text: {
  \str_case:VnF \l_semio_language_tl
    { { de } { \semio@thesis@declaration@de } }
    { \semio@thesis@declaration@en }
}

\cs_new_protected:Npn \semio_thesis_address:n #1 {
  \group_begin:
  \ExplSyntaxOff
  \SemioSans
  \setlength{\parindent}{0pt}%
  #1%
  \group_end:
}

\cs_new_protected:Npn \semio_thesis_field_window:nN #1#2 {
  \tl_if_empty:NF #2 {
    \WindowItem{
      \begin{Window}[title={#1}, anchor=center, text-size=fit]
        \SemioSans \tl_use:N #2
      \end{Window}
    }
  }
}

\cs_new_protected:Npn \semio_thesis_title_page: {
  \semio_cover_geometry_restore:
  \clearpage
  \setcounter{page}{1}
  \bool_gset_true:N \g_semio_thesis_frontmatter_bool
  \semio_thesis_numbering_suspend:
  \semio_frontmatter_begin:
  \newgeometry{left=1.5cm, right=1.5cm, top=1.5cm, bottom=1.5cm}
  \thispagestyle{empty}
  \bool_gset_true:N \g_semio_cover_geometry_bool
  \group_begin:
  \semio_theme_apply:
  \setlength{\parskip}{0pt}
  \begin{WindowArrangement}[height=\textheight]
    \begin{WindowColumn}
      \bool_lazy_any:nT {
        { ! \tl_if_blank_p:V \l_semio_thesis_university_tl }
        { ! \tl_if_blank_p:V \l_semio_thesis_faculty_tl }
        { ! \tl_if_blank_p:V \l_semio_thesis_institute_tl }
      } {
        \WindowItem[1.6]{
          \begin{Window}[title={\semio_thesis_label_faculty:}, anchor=nw, text-size=fit]
            \semio_thesis_address:n {
              \tl_use:N \l_semio_thesis_university_tl
              \tl_if_empty:NF \l_semio_thesis_faculty_tl { \par \tl_use:N \l_semio_thesis_faculty_tl }
              \tl_if_empty:NF \l_semio_thesis_institute_tl { \par \tl_use:N \l_semio_thesis_institute_tl }
            }
          \end{Window}
        }
      }
      \WindowItem[3]{
        \begin{Window}[title={\semio_thesis_label_title:}, anchor=center, text-size=fit]
          \SemioSans \@title
          \tl_if_empty:NF \l_semio_subtitle_tl { \par \SemioSans \tl_use:N \l_semio_subtitle_tl }
        \end{Window}
      }
      \WindowItem[1]{
          \begin{Window}[title={\semio_thesis_label:nn { Academic~Work } { Abschlussarbeit }},anchor=center,text-size=fit]
            \SemioSans \semio_thesis_label_dissertation:
          \end{Window}
        }
      \bool_lazy_any:nT {
        { ! \tl_if_blank_p:V \l_semio_thesis_degree_tl }
        { ! \tl_if_blank_p:V \l_semio_thesis_discipline_tl }
        { ! \tl_if_blank_p:V \l_semio_thesis_programme_tl }
      } {
        \WindowItem[1.6]{
          \begin{Window}[title={\semio_thesis_label_degree:}, anchor=center, text-size=fit]
            \SemioSans \tl_use:N \l_semio_thesis_degree_tl
            \tl_if_empty:NF \l_semio_thesis_discipline_tl { \par \SemioSans \tl_use:N \l_semio_thesis_discipline_tl }
            \tl_if_empty:NF \l_semio_thesis_programme_tl { \par \SemioSans \tl_use:N \l_semio_thesis_programme_tl }
          \end{Window}
        }
      }
      \WindowItem[1.4]{
        \begin{Window}[title={\semio_thesis_label_author:}, anchor=center, text-size=fit]
          \SemioSans \@author
          \tl_if_empty:NF \l_semio_thesis_student_id_tl { \par \semio_thesis_label:nn { Student~ID } { Matrikelnummer }:~\tl_use:N \l_semio_thesis_student_id_tl }
          \tl_if_empty:NF \l_semio_thesis_orcid_tl { \par \SemioMono ORCID~ \tl_use:N \l_semio_thesis_orcid_tl }
        \end{Window}
      }
      \bool_lazy_or:nnT
        { ! \tl_if_empty_p:N \l_semio_thesis_supervisor_tl }
        { ! \tl_if_empty_p:N \l_semio_thesis_reviewers_tl }
      {
        \WindowItem[1.8]{
          \begin{WindowRow}
            \semio_thesis_field_window:nN { \semio_thesis_label_supervisor: } \l_semio_thesis_supervisor_tl
            \semio_thesis_field_window:nN { \semio_thesis_label_reviewers: } \l_semio_thesis_reviewers_tl
          \end{WindowRow}
        }
      }
      \bool_lazy_any:nT
        {
          { ! \tl_if_empty_p:N \l_semio_thesis_place_tl }
          { ! \tl_if_empty_p:N \l_semio_thesis_submission_tl }
          { ! \tl_if_empty_p:N \l_semio_thesis_defense_tl }
        }
      {
        \WindowItem[1.2]{
          \begin{WindowRow}
            \semio_thesis_field_window:nN { \semio_thesis_label_place: } \l_semio_thesis_place_tl
            \semio_thesis_field_window:nN { \semio_thesis_label_submission: } \l_semio_thesis_submission_tl
            \semio_thesis_field_window:nN { \semio_thesis_label_defense: } \l_semio_thesis_defense_tl
          \end{WindowRow}
        }
      }
    \end{WindowColumn}
  \end{WindowArrangement}
  \par
  \group_end:
  \semio_cover_geometry_restore:
}

\NewDocumentCommand{\makethesistitle}{}{\semio_thesis_title_page:}
\str_if_eq:VnT \l_semio_type_tl { thesis } {
