\NewDocumentCommand{\makedeclaration}{+o}{
  \semio_thesis_unnumbered_heading:e { \semio_thesis_title_declaration: }
  \begin{Blockquote}
    \IfNoValueTF{#1}{
      \tl_if_blank:VTF \l_semio_thesis_declaration_text_tl
        { \semio_thesis_declaration_text: }
        { \tl_use:N \l_semio_thesis_declaration_text_tl }
    }{#1}
  \end{Blockquote}
  \par
  \semio_thesis_signature_line:
}

\cs_new_protected:Npn \semio_thesis_signature_line: {
  \par
  \group_begin:
  \SemioSans
  \tl_if_empty:NF \l_semio_thesis_place_tl {
    \tl_use:N \l_semio_thesis_place_tl
    \tl_if_empty:NF \l_semio_thesis_submission_tl { ,~ }
  }
  \tl_if_empty:NF \l_semio_thesis_submission_tl { \tl_use:N \l_semio_thesis_submission_tl }
  \par
  \vspace { \SemioSpacingDouble }
  \rule { 6cm } { \semio@stroke@hairline }
  \par
  \@author
  \par
  \group_end:
}

