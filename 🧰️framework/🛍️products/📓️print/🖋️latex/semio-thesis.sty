\cs_new_protected:Npn \semio_thesis_numbering_suspend: {
  \bool_if:NF \g_semio_thesis_unnumbered_bool {
    \int_gset:Nn \g_semio_thesis_numbering_depth_int { \value{secnumdepth} }
    \bool_gset_true:N \g_semio_thesis_unnumbered_bool
  }
  \setcounter{secnumdepth}{-1}
}
\cs_new_protected:Npn \semio_thesis_numbering_restore: {
  \bool_if:NT \g_semio_thesis_unnumbered_bool {
    \setcounter{secnumdepth}{\int_use:N \g_semio_thesis_numbering_depth_int}
    \bool_gset_false:N \g_semio_thesis_unnumbered_bool
  }
}
