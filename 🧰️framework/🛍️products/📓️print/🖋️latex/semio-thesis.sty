  thesis-type .tl_set:N = \l_semio_thesis_type_tl,
  programme .tl_set:N = \l_semio_thesis_programme_tl,
  student-id .tl_set:N = \l_semio_thesis_student_id_tl,
  keywords .tl_set:N = \l_semio_thesis_keywords_tl,
  declaration-text .tl_set:N = \l_semio_thesis_declaration_text_tl,
  declaration-title .tl_set:N = \l_semio_thesis_declaration_title_tl,
  dedication-title .tl_set:N = \l_semio_thesis_dedication_title_tl,
  abbreviations-title .tl_set:N = \l_semio_thesis_abbreviations_title_tl,
  university .tl_set:N = \l_semio_thesis_university_tl,
  faculty .tl_set:N = \l_semio_thesis_faculty_tl,
  institute .tl_set:N = \l_semio_thesis_institute_tl,
  degree .tl_set:N = \l_semio_thesis_degree_tl,
  discipline .tl_set:N = \l_semio_thesis_discipline_tl,
  supervisor .tl_set:N = \l_semio_thesis_supervisor_tl,
  reviewers .tl_set:N = \l_semio_thesis_reviewers_tl,
  submission .tl_set:N = \l_semio_thesis_submission_tl,
