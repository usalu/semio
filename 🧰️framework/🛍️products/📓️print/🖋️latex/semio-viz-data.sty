        { \bool_set_false:N \l_semio_viz_data_first_field_bool }
        { \tl_put_right:Nn \l_semio_viz_data_rowtext_tl { , } }
      \tl_put_right:Nn \l_semio_viz_data_rowtext_tl { {##1} }
    }
}
\tl_new:N \l_semio_viz_data_rowtext_tl
\bool_new:N \l_semio_viz_data_first_field_bool

