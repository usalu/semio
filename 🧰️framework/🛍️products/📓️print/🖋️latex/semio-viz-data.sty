% 🔗 Binds every standalone `x` of the sampled expression to the sampling variable. Neighbouring
% characters are consumed by the match, so `x*x` needs a second pass; the loop runs until the
% expression stops changing (l3regex here has no usable lookaround).
\cs_new_protected:Npn \semio_viz_data_bind_x: {
  \bool_set_true:N \l_semio_viz_data_changed_bool
  \int_zero:N \l_semio_viz_data_pass_int
  \bool_do_while:nn
    {
      \l_semio_viz_data_changed_bool &&
      \int_compare_p:nNn { \l_semio_viz_data_pass_int } < { 16 }
    }
    {
      \tl_set_eq:NN \l_semio_viz_data_before_tl \l_semio_viz_data_expr_tl
      \regex_replace_all:nnN { ([^a-zA-Z0-9_])x([^a-zA-Z0-9_]) }
        { \1 \c{l_semio_viz_data_x_fp} \2 } \l_semio_viz_data_expr_tl
      \bool_set:Nn \l_semio_viz_data_changed_bool
        { ! \tl_if_eq_p:NN \l_semio_viz_data_before_tl \l_semio_viz_data_expr_tl }
      \int_incr:N \l_semio_viz_data_pass_int
    }
}
\bool_new:N \l_semio_viz_data_changed_bool
\int_new:N \l_semio_viz_data_pass_int
\tl_new:N \l_semio_viz_data_before_tl

% ➗ Samples an fp expression in `x` over a domain into a two-column table `x,y`.
\cs_new_protected:Npn \semio_viz_data_function:nnn #1#2#3 {
  \semio_viz_data_keys_reset:
  \keys_set:nn { semio / viz / data } {#3}
  \semio_viz_table_new:nn {#1} { x, y }
  \semio_viz_table_kind_set:nn {#1} { function }
  \semio_viz_table_role_set:nnn {#1} { x } { x }
  \semio_viz_table_role_set:nnn {#1} { y } { y }
  \fp_set:Nn \l_semio_viz_data_lo_fp { \clist_item:Nn \l_semio_viz_data_domain_clist { 1 } }
  \fp_set:Nn \l_semio_viz_data_hi_fp { \clist_item:Nn \l_semio_viz_data_domain_clist { 2 } }
  \tl_set:Nn \l_semio_viz_data_expr_tl { ( #2 ) }
  \semio_viz_data_bind_x:
  \int_step_inline:nn { \l_semio_viz_data_samples_int }
    {
      \fp_set:Nn \l_semio_viz_data_x_fp
        {
          \l_semio_viz_data_lo_fp
            + ( ##1 - 1 ) / ( \l_semio_viz_data_samples_int - 1 )
              * ( \l_semio_viz_data_hi_fp - \l_semio_viz_data_lo_fp )
        }
      \fp_set:Nn \l_semio_viz_data_y_fp { \l_semio_viz_data_expr_tl }
      \semio_viz_table_row:nx {#1}
        {
          \fp_to_decimal:n { round( \l_semio_viz_data_x_fp , 6 ) } ,
          \fp_to_decimal:n { round( \l_semio_viz_data_y_fp , 6 ) }
        }
    }
}
\fp_new:N \l_semio_viz_data_lo_fp
\fp_new:N \l_semio_viz_data_hi_fp
\fp_new:N \l_semio_viz_data_x_fp
\fp_new:N \l_semio_viz_data_y_fp
\tl_new:N \l_semio_viz_data_expr_tl

\cs_generate_variant:Nn \semio_viz_table_role_set:nnn { nnV }
