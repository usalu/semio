% 📄 Splits one delimiter-separated line into \l_semio_viz_data_fields_seq, honouring quoted fields
% and doubled quotes exactly as RFC 4180 (and therefore d3-dsv) does within a single record.
\cs_new_protected:Npn \semio_viz_data_split_line:N #1 {
  \seq_clear:N \l_semio_viz_data_fields_seq
  \str_clear:N \l_semio_viz_data_field_str
  \bool_set_false:N \l_semio_viz_data_quoted_bool
  \int_zero:N \l_semio_viz_data_skip_int
  \int_step_inline:nn { \str_count:N #1 }
    {
      \int_compare:nNnTF { \l_semio_viz_data_skip_int } > { 0 }
        { \int_decr:N \l_semio_viz_data_skip_int }
        {
          \str_set:Nx \l_semio_viz_data_char_str { \str_range:Nnn #1 {##1} {##1} }
          \bool_if:NTF \l_semio_viz_data_quoted_bool
            {
              \str_if_eq:VVTF \l_semio_viz_data_char_str \l_semio_viz_data_quote_str
                {
                  \str_if_eq:eVTF { \str_range:Nnn #1 { ##1 + 1 } { ##1 + 1 } }
                    \l_semio_viz_data_quote_str
                    {
                      \str_put_right:NV \l_semio_viz_data_field_str \l_semio_viz_data_quote_str
                      \int_set:Nn \l_semio_viz_data_skip_int { 1 }
                    }
                    { \bool_set_false:N \l_semio_viz_data_quoted_bool }
                }
                { \str_put_right:NV \l_semio_viz_data_field_str \l_semio_viz_data_char_str }
            }
            {
              \str_if_eq:VVTF \l_semio_viz_data_char_str \l_semio_viz_data_delimiter_str
                {
                  \seq_put_right:NV \l_semio_viz_data_fields_seq \l_semio_viz_data_field_str
                  \str_clear:N \l_semio_viz_data_field_str
                }
                {
                  \str_if_eq:VVTF \l_semio_viz_data_char_str \l_semio_viz_data_quote_str
                    { \bool_set_true:N \l_semio_viz_data_quoted_bool }
                    { \str_put_right:NV \l_semio_viz_data_field_str \l_semio_viz_data_char_str }
                }
            }
        }
    }
  \seq_put_right:NV \l_semio_viz_data_fields_seq \l_semio_viz_data_field_str
}
\int_new:N \l_semio_viz_data_skip_int
\str_new:N \l_semio_viz_data_quote_str
\str_new:N \l_semio_viz_data_delimiter_str

% 📥 Loads a delimiter-separated file into a named table.
\cs_new_protected:Npn \semio_viz_data_csv:nnn #1#2#3 {
  \semio_viz_data_keys_reset:
  \keys_set:nn { semio / viz / data } {#3}
  \str_set:NV \l_semio_viz_data_delimiter_str \l_semio_viz_data_delimiter_tl
  \str_set:NV \l_semio_viz_data_quote_str \l_semio_viz_data_quote_tl
  \bool_set_true:N \l_semio_viz_data_first_bool
  \clist_if_empty:NF \l_semio_viz_data_columns_clist
    {
      \semio_viz_table_new:nx {#1} { \clist_use:Nn \l_semio_viz_data_columns_clist { , } }
      \bool_set_false:N \l_semio_viz_data_first_bool
    }
  \ior_open:Nn \g_semio_viz_data_ior {#2}
  \ior_str_map_inline:Nn \g_semio_viz_data_ior
    {
      \str_set:Nn \l_semio_viz_data_line_str {##1}
      \str_if_empty:NF \l_semio_viz_data_line_str
        {
          \semio_viz_data_split_line:N \l_semio_viz_data_line_str
          \bool_lazy_and:nnTF
            { \l_semio_viz_data_first_bool } { \l_semio_viz_data_header_bool }
            {
              \semio_viz_table_new:nx {#1}
                { \seq_use:Nn \l_semio_viz_data_fields_seq { , } }
              \bool_set_false:N \l_semio_viz_data_first_bool
            }
            {
              \bool_if:NT \l_semio_viz_data_first_bool
                {
                  \semio_viz_table_new:nx {#1}
                    {
                      \semio_viz_data_generic_columns:n
                        { \seq_count:N \l_semio_viz_data_fields_seq }
                    }
                  \bool_set_false:N \l_semio_viz_data_first_bool
                }
              \semio_viz_data_fields_row:
              \semio_viz_table_row:nV {#1} \l_semio_viz_data_rowtext_tl
            }
        }
    }
  \ior_close:N \g_semio_viz_data_ior
}

% 🧱 Renders the parsed fields as a table row; each field is brace-wrapped so that a field may
% itself contain the delimiter and still survive the comma-list row representation.
