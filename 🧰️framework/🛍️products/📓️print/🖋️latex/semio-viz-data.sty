      }
  }

% 🔁 A name that is not a collection but is a table marked with \SemioVizGeometry becomes one on first use.
\cs_new_protected:Npn \semio_viz_geom_ensure:n #1
  {
    \tl_set:Nx \l_tmpb_tl {#1}
    \tl_set:Nx \l_tmpb_tl { \tl_to_str:N \l_tmpb_tl }
    \seq_if_in:NVF \g_semio_viz_geom_names_seq \l_tmpb_tl
      {
        \bool_set_false:N \l_semio_viz_geom_found_bool
        \seq_map_inline:Nn \g_semio_viz_table_names_seq
          {
            \str_if_eq:VnT \l_tmpb_tl {##1}
              {
                \bool_set_true:N \l_semio_viz_geom_found_bool
                \seq_map_break:
              }
          }
        \bool_if:NT \l_semio_viz_geom_found_bool
          { \semio_viz_geom_from_table:nnn {#1} {#1} { } }
      }
  }
\bool_new:N \l_semio_viz_geom_found_bool

% 🔁 Runs #2 over every part of collection #1, converting a marked table into one first.
\cs_new_protected:Npn \semio_viz_geom_map_inline:nn #1#2
  {
    \semio_viz_geom_ensure:n {#1}
    \semio_viz_geom_require:n {#1}
    \seq_map_inline:cn { g_semio_viz_geom_ \l_semio_viz_geom_name_tl _seq } {#2}
  }

% 🔢 Number of parts of collection #1, into the integer #2.
\cs_new_protected:Npn \semio_viz_geom_count:nN #1#2
  {
    \semio_viz_geom_ensure:n {#1}
    \semio_viz_geom_require:n {#1}
    \int_set:Nn #2
      { \seq_count:c { g_semio_viz_geom_ \l_semio_viz_geom_name_tl _seq } }
  }

% 🗾 Declares an empty geometry collection addressed by name.
\NewDocumentCommand \SemioVizGeoCollection { m O{} } { \semio_viz_geom_new:n {#1} }
% 🔷 Appends a closed ring `lon,lat; lon,lat; …` (first vertex not repeated) to a geometry.
\NewDocumentCommand \SemioVizGeoPolygon { m O{} m }
  { \semio_viz_geom_part:nnnn {#1} { polygon } {#2} {#3} }
% 〰️ Appends an open line string to a geometry.
\NewDocumentCommand \SemioVizGeoLine { m O{} m }
  { \semio_viz_geom_part:nnnn {#1} { line } {#2} {#3} }
% 📍 Appends a single `lon,lat` point to a geometry.
\NewDocumentCommand \SemioVizGeoPointPart { m O{} m }
  { \semio_viz_geom_part:nnnn {#1} { point } {#2} {#3} }

% 🔁 Builds a geometry collection from a table marked with \SemioVizGeometry (columns ring, lon, lat).
% 🔁 A ring whose last vertex repeats its first loses that duplicate, because the projector treats rings as closed.
\tl_new:N \l_semio_viz_geom_ringcol_tl
\tl_new:N \l_semio_viz_geom_loncol_tl
\tl_new:N \l_semio_viz_geom_latcol_tl
\tl_new:N \l_semio_viz_geom_valcol_tl
\tl_new:N \l_semio_viz_geom_ringvalue_tl
\tl_new:N \l_semio_viz_geom_curring_tl
\tl_new:N \l_semio_viz_geom_coords_tl
\tl_new:N \l_semio_viz_geom_firstpt_tl
\tl_new:N \l_semio_viz_geom_target_tl

\keys_define:nn { semio / viz / geo / fromtable }
  {
    ring .tl_set:N = \l_semio_viz_geom_ringcol_tl ,
    lon .tl_set:N = \l_semio_viz_geom_loncol_tl ,
    lat .tl_set:N = \l_semio_viz_geom_latcol_tl ,
    value .tl_set:N = \l_semio_viz_geom_valcol_tl ,
  }

% 🔁 Builds collection #1 from the geographic table #2 under the column options #3: consecutive
% rows sharing a ring value become one polygon part.
\cs_new_protected:Npn \semio_viz_geom_from_table:nnn #1#2#3
  {
    \tl_set:Nn \l_semio_viz_geom_ringcol_tl { ring }
    \tl_set:Nn \l_semio_viz_geom_loncol_tl { lon }
    \tl_set:Nn \l_semio_viz_geom_latcol_tl { lat }
    \tl_clear:N \l_semio_viz_geom_valcol_tl
    \keys_set:nn { semio / viz / geo / fromtable } {#3}
    \semio_viz_geom_new:n {#1}
    \tl_set:Nx \l_semio_viz_geom_target_tl { \tl_to_str:n {#1} }
    \semio_viz_table_nrows:nN {#2} \l_tmpa_int
    \tl_clear:N \l_semio_viz_geom_curring_tl
    \tl_clear:N \l_semio_viz_geom_coords_tl
    \int_step_inline:nn { \l_tmpa_int }
      { \semio_viz_geom_from_row:nn {#2} {##1} }
    \semio_viz_geom_flush_ring:
  }

% 📍 One row of that walk: a new ring value flushes the ring being built, and a vertex repeating
% the ring's first one is dropped, because the projector treats every ring as closed.
\cs_new_protected:Npn \semio_viz_geom_from_row:nn #1#2
  {
    \semio_viz_table_cell:nnnN {#1} {#2} { \l_semio_viz_geom_ringcol_tl }
      \l_tmpb_tl
    \tl_if_eq:NNF \l_tmpb_tl \l_semio_viz_geom_curring_tl
      {
        \semio_viz_geom_flush_ring:
        \tl_set_eq:NN \l_semio_viz_geom_curring_tl \l_tmpb_tl
        \tl_clear:N \l_semio_viz_geom_coords_tl
        \tl_clear:N \l_semio_viz_geom_firstpt_tl
      }
    \semio_viz_table_cell:nnnN {#1} {#2} { \l_semio_viz_geom_loncol_tl }
      \l_tmpa_tl
    \semio_viz_table_cell:nnnN {#1} {#2} { \l_semio_viz_geom_latcol_tl }
      \l_semio_viz_cell_tl
    \tl_if_empty:NF \l_semio_viz_geom_valcol_tl
      {
        \semio_viz_table_cell:nnnN {#1} {#2} { \l_semio_viz_geom_valcol_tl }
          \l_semio_viz_geom_ringvalue_tl
      }
    \tl_set:Nx \l_tmpb_tl
      { \l_tmpa_tl , \l_semio_viz_cell_tl }
    \tl_if_empty:NTF \l_semio_viz_geom_firstpt_tl
      { \tl_set_eq:NN \l_semio_viz_geom_firstpt_tl \l_tmpb_tl }
      { }
    \tl_if_eq:NNF \l_tmpb_tl \l_semio_viz_geom_firstpt_tl
      {
        \tl_if_empty:NF \l_semio_viz_geom_coords_tl
          { \tl_put_right:Nn \l_semio_viz_geom_coords_tl { ; } }
        \tl_put_right:NV \l_semio_viz_geom_coords_tl \l_tmpb_tl
      }
    \tl_if_empty:NT \l_semio_viz_geom_coords_tl
      { \tl_put_right:NV \l_semio_viz_geom_coords_tl \l_tmpb_tl }
  }

% 📤 Files the ring being built as a polygon part, unless it is empty.
\cs_new_protected:Npn \semio_viz_geom_flush_ring:
  {
    \tl_if_empty:NF \l_semio_viz_geom_coords_tl
      {
        \use:x
          {
            \exp_not:N \semio_viz_geom_part:nnnn
              { \exp_not:V \l_semio_viz_geom_target_tl } { polygon }
              {
                id = \exp_not:V \l_semio_viz_geom_curring_tl ,
                value = \tl_if_empty:NTF \l_semio_viz_geom_valcol_tl
                          { 1 } { \exp_not:V \l_semio_viz_geom_ringvalue_tl }
              }
              { \exp_not:V \l_semio_viz_geom_coords_tl }
          }
      }
  }

% 🔁 \SemioVizGeoFromTable{collection}{table}[ring=,lon=,lat=]: converts a geographic data table into a projectable collection.
\NewDocumentCommand \SemioVizGeoFromTable { m m O{} }
  { \semio_viz_geom_from_table:nnn {#1} {#2} {#3} }
