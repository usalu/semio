\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-data}[2026/08/18 v0.1.0 semio viz data]

\RequirePackage{expl3}
\RequirePackage{xparse}

\ExplSyntaxOn

%region 🔖️Diagnostics
\msg_new:nnn { semio-viz } { unknown-table }
  { Unknown~viz~table~'#1'. }
\msg_new:nnn { semio-viz } { unknown-column }
  { Unknown~column~'#2'~in~table~'#1'. }
\msg_new:nnn { semio-viz } { empty-data }
  { Viz~table~'#1'~has~no~rows. }
\msg_new:nnn { semio-viz } { unknown-pointset }
  { Unknown~viz~point~set~'#1'.~Declare~it~with~\SemioVizPointSet. }
\msg_new:nnn { semio-viz } { unknown-grid }
  { Unknown~viz~grid~'#1'.~Declare~it~with~\SemioVizValueGrid. }
\msg_new:nnn { semio-viz } { unknown-geometry }
  { Unknown~viz~geometry~collection~'#1'.~Declare~it~with~\SemioVizGeoCollection. }
%endregion 🔖️Diagnostics

%region 🔖️Tables
\seq_new:N \g_semio_viz_table_names_seq
\tl_new:N \l_semio_viz_cell_tl
\int_new:N \l_semio_viz_col_int
\int_new:N \l_semio_viz_row_int

% 🏷️ Name of the sequence holding the rows of table #1.
\cs_new_protected:Npn \semio_viz_table_cs:n #1 { g_semio_viz_table_ \tl_to_str:n {#1} _rows_seq }
% 🏷️ Name of the comma list holding the column names of table #1.
\cs_new_protected:Npn \semio_viz_table_cols_cs:n #1 { g_semio_viz_table_ \tl_to_str:n {#1} _cols_clist }

\tl_new:N \l_semio_viz_tab_tl
\tl_new:N \l_semio_viz_colname_tl

% 📌 Fully expands the table name #1 once, so every csname built from it afterwards is the same.
\cs_new_protected:Npn \semio_viz_table_bind:n #1 {
  \tl_set:Nx \l_semio_viz_tab_tl {#1}
}
% 📌 The same for a column name, so a column given through a variable resolves once.
\cs_new_protected:Npn \semio_viz_table_bind_col:n #1 {
  \tl_set:Nx \l_semio_viz_colname_tl {#1}
}

% 🔒 Binds table #1 and stops with a diagnostic when no such table is declared.
\cs_new_protected:Npn \semio_viz_table_require:n #1 {
  \semio_viz_table_bind:n {#1}
  \exp_args:NV \semio_viz_table_require_chk:n \l_semio_viz_tab_tl
}
% 🔎 The check behind it, on the already-expanded name.
\cs_new_protected:Npn \semio_viz_table_require_chk:n #1 {
  \seq_if_in:NnF \g_semio_viz_table_names_seq {#1}
    { \msg_error:nnn { semio-viz } { unknown-table } {#1} }
}

% 📋 Declares table #1 with the column list #2; declaring an existing table empties it.
\cs_new_protected:Npn \semio_viz_table_new:nn #1#2 {
  \semio_viz_table_bind:n {#1}
  \exp_args:NV \semio_viz_table_new_aux:nn \l_semio_viz_tab_tl {#2}
}
% 🧱 The declaration itself, on the already-expanded name.
\cs_new_protected:Npn \semio_viz_table_new_aux:nn #1#2 {
  \seq_if_in:NnTF \g_semio_viz_table_names_seq {#1}
    {
      \seq_gclear:c { g_semio_viz_table_ #1 _rows_seq }
      \clist_gset:cn { g_semio_viz_table_ #1 _cols_clist } {#2}
    }
    {
      \seq_gput_right:Nn \g_semio_viz_table_names_seq {#1}
      \cs_if_exist:cF { g_semio_viz_table_ #1 _rows_seq } { \seq_new:c { g_semio_viz_table_ #1 _rows_seq } }
      \cs_if_exist:cF { g_semio_viz_table_ #1 _cols_clist } { \clist_new:c { g_semio_viz_table_ #1 _cols_clist } }
      \clist_gset:cn { g_semio_viz_table_ #1 _cols_clist } {#2}
    }
}

% ➕ Appends the comma-separated row #2 to table #1.
\cs_new_protected:Npn \semio_viz_table_row:nn #1#2 {
  \semio_viz_table_require:n {#1}
  \seq_gput_right:cn { g_semio_viz_table_ \l_semio_viz_tab_tl _rows_seq } {#2}
}

% 🔢 Number of rows of table #1, into the integer #2.
\cs_new_protected:Npn \semio_viz_table_nrows:nN #1#2 {
  \semio_viz_table_require:n {#1}
  \int_set:Nn #2 { \seq_count:c { g_semio_viz_table_ \l_semio_viz_tab_tl _rows_seq } }
}

% 🔎 1-based position of column #2 in table #1, zero when the table does not declare it.
%    Silent: the caller decides whether an absent column is an error or an empty cell.
\cs_new_protected:Npn \semio_viz_table_col_find:nnN #1#2#3 {
  \semio_viz_table_require:n {#1}
  \semio_viz_table_bind_col:n {#2}
  \int_zero:N #3
  \int_zero:N \l_tmpa_int
  \clist_map_inline:cn { g_semio_viz_table_ \l_semio_viz_tab_tl _cols_clist } {
    \int_incr:N \l_tmpa_int
    \tl_set:Nn \l_tmpb_tl {##1}
    \str_if_eq:VVT \l_semio_viz_colname_tl \l_tmpb_tl { \int_set_eq:NN #3 \l_tmpa_int }
  }
}

% ❓ True when table #1 declares a column named #2.
\prg_new_protected_conditional:Npnn \semio_viz_table_col_exist:nn #1#2 { T, F, TF } {
  \semio_viz_table_col_find:nnN {#1} {#2} \l_semio_viz_col_int
  \int_compare:nNnTF \l_semio_viz_col_int > { 0 } { \prg_return_true: } { \prg_return_false: }
}

% 🔎 The same position as `col_find`, but an absent column is an error: this is the accessor a
% renderer uses when the column is part of its contract.
\cs_new_protected:Npn \semio_viz_table_col_index:nnN #1#2#3 {
  \semio_viz_table_col_find:nnN {#1} {#2} #3
  \int_compare:nNnT #3 = { 0 }
    {
      \msg_error:nnxx { semio-viz } { unknown-column }
        { \tl_use:N \l_semio_viz_tab_tl } { \tl_use:N \l_semio_viz_colname_tl }
    }
}

\seq_new:N \l_semio_viz_row_seq
\tl_new:N \l_semio_viz_row_tl
\cs_generate_variant:Nn \seq_set_split:Nnn { NnV }

% 🧾 Loads row #2 of table #1 into \l_semio_viz_row_seq, one item per declared
% column: a comma list drops empty items, and an empty cell is exactly how a
% stratified table marks its root or a sparse matrix marks a hole.
\cs_new_protected:Npn \semio_viz_table_row_load:nn #1#2 {
  \semio_viz_table_require:n {#1}
  \tl_set:Nx \l_semio_viz_row_tl
    { \seq_item:cn { g_semio_viz_table_ \l_semio_viz_tab_tl _rows_seq } {#2} }
  \seq_set_split:NnV \l_semio_viz_row_seq { , } \l_semio_viz_row_tl
}

% 🧾 Cell #1 of the loaded row by column index; index zero is no column.
\cs_new_protected:Npn \semio_viz_table_row_cell:nN #1#2 {
  \int_compare:nNnTF {#1} > { 0 }
    { \tl_set:Nx #2 { \seq_item:Nn \l_semio_viz_row_seq {#1} } \tl_trim_spaces:N #2 }
    { \tl_clear:N #2 }
}

% 🧾 Column index of #2 in table #1; a blank column name is no column, a named one
%    that the table does not declare is an error.
\cs_new_protected:Npn \semio_viz_table_col_index_opt:nnN #1#2#3 {
  \tl_if_blank:nTF {#2}
    { \int_zero:N #3 }
    { \semio_viz_table_col_index:nnN {#1} {#2} #3 }
}

% 🧾 Cell (row #2, column #3) of table #1 into #4; a column the table does not declare is an error.
\cs_new_protected:Npn \semio_viz_table_cell:nnnN #1#2#3#4 {
  \semio_viz_table_col_index:nnN {#1} {#3} \l_semio_viz_col_int
  \semio_viz_table_row_load:nn {#1} {#2}
  \semio_viz_table_row_cell:nN { \l_semio_viz_col_int } #4
}

% 🧾 Cell (row #2, column #3) of table #1, empty when the table has no such column:
%    the reader for optional columns a family only uses when the data carries them.
\cs_new_protected:Npn \semio_viz_table_cell_opt:nnnN #1#2#3#4 {
  \semio_viz_table_col_find:nnN {#1} {#3} \l_semio_viz_col_int
  \int_compare:nNnTF \l_semio_viz_col_int = { 0 }
    { \tl_clear:N #4 }
    {
      \semio_viz_table_row_load:nn {#1} {#2}
      \semio_viz_table_row_cell:nN { \l_semio_viz_col_int } #4
    }
}

% 📉 Smallest value of column #2 of table #1 into #3; empty cells take no part.
\cs_new_protected:Npn \semio_viz_table_col_min:nnN #1#2#3 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_row_int
  \fp_zero:N #3
  \int_compare:nNnF \l_semio_viz_row_int = { 0 } {
    \semio_viz_table_cell:nnnN {#1} { 1 } {#2} \l_semio_viz_cell_tl
    \tl_if_empty:NF \l_semio_viz_cell_tl { \fp_set:Nn #3 { \l_semio_viz_cell_tl } }
    \int_step_inline:nn { \l_semio_viz_row_int } {
      \semio_viz_table_cell:nnnN {#1} {##1} {#2} \l_semio_viz_cell_tl
      \tl_if_empty:NF \l_semio_viz_cell_tl {
        \fp_set:Nn #3 { \fp_eval:n { min(#3, \l_semio_viz_cell_tl) } }
      }
    }
  }
}

% 📈 Largest value of column #2 of table #1 into #3; an empty column leaves the unit maximum.
\cs_new_protected:Npn \semio_viz_table_col_max:nnN #1#2#3 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_row_int
  \fp_set:Nn #3 { 1 }
  \int_compare:nNnF \l_semio_viz_row_int = { 0 } {
    \semio_viz_table_cell:nnnN {#1} { 1 } {#2} \l_semio_viz_cell_tl
    \tl_if_empty:NF \l_semio_viz_cell_tl { \fp_set:Nn #3 { \l_semio_viz_cell_tl } }
    \int_step_inline:nn { \l_semio_viz_row_int } {
      \semio_viz_table_cell:nnnN {#1} {##1} {#2} \l_semio_viz_cell_tl
      \tl_if_empty:NF \l_semio_viz_cell_tl {
        \fp_set:Nn #3 { \fp_eval:n { max(#3, \l_semio_viz_cell_tl) } }
      }
    }
  }
}

% ➕ Total of column #2 of table #1 into #3, counting the non-empty cells for the mean below.
\cs_new_protected:Npn \semio_viz_table_col_sum:nnN #1#2#3 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_row_int
  \fp_zero:N #3
  \int_zero:N \l_tmpa_int
  \int_step_inline:nn { \l_semio_viz_row_int } {
    \semio_viz_table_cell:nnnN {#1} {##1} {#2} \l_semio_viz_cell_tl
    \tl_if_empty:NF \l_semio_viz_cell_tl {
      \fp_add:Nn #3 { \l_semio_viz_cell_tl }
      \int_incr:N \l_tmpa_int
    }
  }
}

% 🧮 Mean of column #2 of table #1 into #3, over its non-empty cells alone.
\cs_new_protected:Npn \semio_viz_table_col_mean:nnN #1#2#3 {
  \semio_viz_table_col_sum:nnN {#1} {#2} #3
  \int_compare:nNnTF \l_tmpa_int = { 0 }
    { \fp_zero:N #3 }
    { \fp_set:Nn #3 { \fp_eval:n { #3 / \l_tmpa_int } } }
}

% 🧪 Declares the generic `demo` table once, so any family can be drawn without a data set.
\cs_new_protected:Npn \semio_viz_data_demo: {
  \seq_if_in:NnF \g_semio_viz_table_names_seq { demo } {
    % 🧪 Columns beyond cat/val/val2/grp/t (label/from/to/row/col/chip/s1-3)
    % exist so the row-structured families rewritten off hand-placed TikZ
    % (grid/gantt/process/heat) still render real content from the generic
    % \SemioVizDemo{kind} gallery path, which always binds `data=demo`.
    \semio_viz_table_new:nn { demo } { cat, val, val2, grp, t, label, value, from, to, row, col, chip, s1, s2, s3 }
    \semio_viz_table_row:nn { demo } { A, 4, 2, x, 1, {Alpha},   4, A, B, R1, C1, Q1, {Stage 1}, {Stage 2}, {Stage 3} }
    \semio_viz_table_row:nn { demo } { B, 7, 3, x, 2, {Beta},    7, B, D, R1, C2, Q1, {Stage 1}, {Stage 2}, {Stage 3} }
    \semio_viz_table_row:nn { demo } { C, 3, 5, y, 3, {Gamma},   3, A, C, R2, C1, Q2, {Stage 1}, {Stage 2}, {Stage 3} }
    \semio_viz_table_row:nn { demo } { D, 8, 4, y, 4, {Delta},   8, C, E, R2, C2, Q2, {Stage 1}, {Stage 2}, {Stage 3} }
    \semio_viz_table_row:nn { demo } { E, 5, 6, x, 5, {Epsilon}, 5, B, E, R2, C3, Q3, {Stage 1}, {Stage 2}, {Stage 3} }
  }
}

\semio_viz_data_demo:

% 📋 Declares a named table and its column list.
\NewDocumentCommand \SemioVizTable { m m } { \semio_viz_table_new:nn {#1} {#2} }
% ➕ Appends one comma-separated row to a named table.
\NewDocumentCommand \SemioVizRow { m m } { \semio_viz_table_row:nn {#1} {#2} }
%endregion 🔖️Tables

%region 🔖️Columns
\seq_new:N \l_semio_viz_table_values_seq
\cs_generate_variant:Nn \semio_viz_table_cell:nnnN { nVnN , VnnN , VVnN , VnVN , nnVN }

% 🧺 Collects every non-empty cell of column #2 of table #1 into the sequence #3.
\cs_new_protected:Npn \semio_viz_table_col_values:nnN #1#2#3 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_row_int
  \seq_clear:N #3
  \int_step_inline:nn { \l_semio_viz_row_int }
    {
      \semio_viz_table_cell:nnnN {#1} {##1} {#2} \l_semio_viz_cell_tl
      \tl_if_empty:NF \l_semio_viz_cell_tl { \seq_put_right:NV #3 \l_semio_viz_cell_tl }
    }
}

% 🔢 Number of non-empty cells in column #2 of table #1.
\cs_new_protected:Npn \semio_viz_table_col_count:nnN #1#2#3 {
  \semio_viz_table_col_values:nnN {#1} {#2} \l_semio_viz_table_values_seq
  \int_set:Nn #3 { \seq_count:N \l_semio_viz_table_values_seq }
}

% 📈 R-7 quantile at probability #3 of the numeric column #2 of table #1.
\cs_new_protected:Npn \semio_viz_table_col_quantile:nnnN #1#2#3#4 {
  \semio_viz_table_col_values:nnN {#1} {#2} \l_semio_viz_table_values_seq
  \seq_sort:Nn \l_semio_viz_table_values_seq
    { \fp_compare:nNnTF {##1} > {##2} { \sort_return_swapped: } { \sort_return_same: } }
  \int_set:Nn \l_semio_viz_table_n_int { \seq_count:N \l_semio_viz_table_values_seq }
  \fp_set:Nn \l_semio_viz_table_h_fp { ( \l_semio_viz_table_n_int - 1 ) * (#3) }
  \int_set:Nn \l_semio_viz_table_lo_int { \fp_to_int:n { floor( \l_semio_viz_table_h_fp ) } }
  \fp_set:Nn #4
    {
      \seq_item:Nn \l_semio_viz_table_values_seq { \l_semio_viz_table_lo_int + 1 }
        + ( \l_semio_viz_table_h_fp - \l_semio_viz_table_lo_int )
          * ( \seq_item:Nn \l_semio_viz_table_values_seq
                { \int_min:nn { \l_semio_viz_table_lo_int + 2 } { \l_semio_viz_table_n_int } }
              - \seq_item:Nn \l_semio_viz_table_values_seq { \l_semio_viz_table_lo_int + 1 } )
    }
}
\int_new:N \l_semio_viz_table_n_int
\int_new:N \l_semio_viz_table_lo_int
\fp_new:N \l_semio_viz_table_h_fp

% 📊 Median of the numeric column #2 of table #1.
\cs_new_protected:Npn \semio_viz_table_col_median:nnN #1#2#3
  { \semio_viz_table_col_quantile:nnnN {#1} {#2} { 0.5 } #3 }

% 🔤 Every argument variant the table readers are called with, generated beside the base functions so
% that a package which calls one only has to require `semio-viz-data`.
\cs_generate_variant:Nn \semio_viz_table_nrows:nN { VN }
\cs_generate_variant:Nn \semio_viz_table_col_min:nnN { nVN , VnN , VVN }
\cs_generate_variant:Nn \semio_viz_table_col_max:nnN { nVN , VnN , VVN }
\cs_generate_variant:Nn \semio_viz_table_col_values:nnN { VnN , VVN }
%endregion 🔖️Columns

%region 🔖️Roles
% 🎭 Structured data sets are ordinary tables plus a role map: which column carries the id, the
% parent, the value, the source, the target and so on. Renderers read roles, never fixed names.
\prop_new:N \g_semio_viz_table_kind_prop

\cs_new_protected:Npn \semio_viz_table_kind_set:nn #1#2 {
  \semio_viz_table_require:n {#1}
  \prop_gput:NVn \g_semio_viz_table_kind_prop \l_semio_viz_tab_tl {#2}
  \prop_if_exist:cF { g_semio_viz_table_ \l_semio_viz_tab_tl _roles_prop }
    { \prop_new:c { g_semio_viz_table_ \l_semio_viz_tab_tl _roles_prop } }
}

% 🎭 Binds role #2 of table #1 to its column #3.
\cs_new_protected:Npn \semio_viz_table_role_set:nnn #1#2#3 {
  \semio_viz_table_require:n {#1}
  \prop_gput:cnn { g_semio_viz_table_ \l_semio_viz_tab_tl _roles_prop } {#2} {#3}
}

% 🎭 Column bound to role #2 of table #1; empty when the role is not declared.
\cs_new:Npn \semio_viz_table_role:nn #1#2
  { \prop_item:cn { g_semio_viz_table_ \tl_to_str:n {#1} _roles_prop } {#2} }

% 🎭 Kind of table #1: table, hierarchy, graph, matrix, geometry or function.
\cs_new:Npn \semio_viz_table_kind:n #1
  { \prop_item:Nn \g_semio_viz_table_kind_prop {#1} }

\tl_new:N \l_semio_viz_data_id_tl
\tl_new:N \l_semio_viz_data_parent_tl
\tl_new:N \l_semio_viz_data_value_tl
\tl_new:N \l_semio_viz_data_source_tl
\tl_new:N \l_semio_viz_data_target_tl
\tl_new:N \l_semio_viz_data_weight_tl
\tl_new:N \l_semio_viz_data_nodes_tl
\tl_new:N \l_semio_viz_data_edges_tl
\tl_new:N \l_semio_viz_data_row_tl
\tl_new:N \l_semio_viz_data_col_tl
\tl_new:N \l_semio_viz_data_ring_tl
\tl_new:N \l_semio_viz_data_lon_tl
\tl_new:N \l_semio_viz_data_lat_tl
\tl_new:N \l_semio_viz_data_label_tl
\clist_new:N \l_semio_viz_data_domain_clist
\int_new:N \l_semio_viz_data_samples_int
\tl_new:N \l_semio_viz_data_delimiter_tl
\tl_new:N \l_semio_viz_data_quote_tl
\bool_new:N \l_semio_viz_data_header_bool
\clist_new:N \l_semio_viz_data_columns_clist

% 🔑 The data vocabulary, `semio / viz / data`: which column carries which role when a table is
% declared as a structure, plus the CSV reader's own delimiter, quote, header and column keys.
\keys_define:nn { semio / viz / data }
  {
    id .tl_set:N = \l_semio_viz_data_id_tl,
    parent .tl_set:N = \l_semio_viz_data_parent_tl,
    value .tl_set:N = \l_semio_viz_data_value_tl,
    source .tl_set:N = \l_semio_viz_data_source_tl,
    target .tl_set:N = \l_semio_viz_data_target_tl,
    weight .tl_set:N = \l_semio_viz_data_weight_tl,
    nodes .tl_set:N = \l_semio_viz_data_nodes_tl,
    edges .tl_set:N = \l_semio_viz_data_edges_tl,
    row .tl_set:N = \l_semio_viz_data_row_tl,
    col .tl_set:N = \l_semio_viz_data_col_tl,
    ring .tl_set:N = \l_semio_viz_data_ring_tl,
    lon .tl_set:N = \l_semio_viz_data_lon_tl,
    lat .tl_set:N = \l_semio_viz_data_lat_tl,
    label .tl_set:N = \l_semio_viz_data_label_tl,
    domain .clist_set:N = \l_semio_viz_data_domain_clist,
    samples .int_set:N = \l_semio_viz_data_samples_int,
    delimiter .tl_set:N = \l_semio_viz_data_delimiter_tl,
    quote .tl_set:N = \l_semio_viz_data_quote_tl,
    header .bool_set:N = \l_semio_viz_data_header_bool,
    header .default:n = { true },
    columns .clist_set:N = \l_semio_viz_data_columns_clist,
  }


% 🧹 Resets every data key to its documented default before a key set is parsed.
\cs_new_protected:Npn \semio_viz_data_keys_reset: {
  \tl_set:Nn \l_semio_viz_data_id_tl { id }
  \tl_set:Nn \l_semio_viz_data_parent_tl { parent }
