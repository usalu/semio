% 🧱 Draws one row of boxes per partition part, stacked downwards from the origin.
\cs_new_protected:Npn \semio_viz_math_young:
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_math_partition_clist
      {
        \int_incr:N \l_tmpa_int
        \int_step_inline:nnnn { 0 } { 1 } { ##1 - 1 }
          {
            \draw [ semio~sci~box ]
              ( \fp_eval:n { ####1 * \l_semio_viz_math_cell_fp } ,
                \fp_eval:n { - \l_tmpa_int * \l_semio_viz_math_cell_fp } )
              rectangle
              ( \fp_eval:n { ( ####1 + 1 ) * \l_semio_viz_math_cell_fp } ,
                \fp_eval:n { ( 1 - \l_tmpa_int ) * \l_semio_viz_math_cell_fp } ) ;
          }
        \semio_viz_sci_report_values:nn { young/row } { \int_use:N \l_tmpa_int , ##1 }
      }
  }
% 🔡 Draws the column and row headers, then one boxed and labelled cell per entry.
\cs_new_protected:Npn \semio_viz_math_table:
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_math_collab_clist
      {
        \int_incr:N \l_tmpa_int
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=south ]
          at ( \fp_eval:n { ( \l_tmpa_int - 0.5 ) * \l_semio_viz_math_cell_fp } , 0.6 ) {##1} ;
      }
    \int_zero:N \l_tmpb_int
    \clist_map_inline:Nn \l_semio_viz_math_rowlab_clist
      {
        \int_incr:N \l_tmpb_int
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=east ]
          at ( -0.6 , \fp_eval:n { - ( \l_tmpb_int - 0.5 ) * \l_semio_viz_math_cell_fp } ) {##1} ;
      }
    \clist_map_inline:Nn \l_semio_viz_math_cells_clist
      {
        \semio_viz_math_record:n {##1}
        \draw [ semio~sci~box ]
          ( \fp_eval:n { ( \semio_viz_math_field:n { 2 } - 1 ) * \l_semio_viz_math_cell_fp } ,
            \fp_eval:n { - \semio_viz_math_field:n { 1 } * \l_semio_viz_math_cell_fp } )
          rectangle
          ( \fp_eval:n { \semio_viz_math_field:n { 2 } * \l_semio_viz_math_cell_fp } ,
            \fp_eval:n { ( 1 - \semio_viz_math_field:n { 1 } ) * \l_semio_viz_math_cell_fp } ) ;
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground ]
          at ( \fp_eval:n { ( \semio_viz_math_field:n { 2 } - 0.5 ) * \l_semio_viz_math_cell_fp } ,
               \fp_eval:n { ( 0.5 - \semio_viz_math_field:n { 1 } ) * \l_semio_viz_math_cell_fp } )
          { \semio_viz_math_field:n { 3 } } ;
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-braid` (§38 braid and knot diagrams):
%    mode (braid|knot, braid): open braid word or its plat closure.
%    strands (int, 3): strand count. crossings (clist of `strand/sign`): the braid word, sign ±1.
%    stride (fp, 7): millimetres per crossing. gauge (fp, 6): millimetres between strands.
\int_new:N \l_semio_viz_math_strands_int
\clist_new:N \l_semio_viz_math_crossings_clist
\fp_new:N \l_semio_viz_math_stride_fp
\fp_new:N \l_semio_viz_math_gauge_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-braid }
% 🧶 Binds the `sci-braid` keys to the strand count, the braid word and the crossing and strand spacing.
\keys_define:nn { semio / viz / family / sci-braid }
  {
    mode      .tl_set:N    = \l_semio_viz_math_mode_tl ,
    strands   .int_set:N   = \l_semio_viz_math_strands_int ,
    crossings .clist_set:N = \l_semio_viz_math_crossings_clist ,
    stride    .fp_set:N    = \l_semio_viz_math_stride_fp ,
    gauge     .fp_set:N    = \l_semio_viz_math_gauge_fp ,
  }

% 🪢 §38 braid words and their knot closures, drawn crossing by crossing from the word.
\SemioVizFamily { sci-braid }
  {
    \semio_viz_sci_enter:nnn { sci-braid }
      {
        mode=braid , strands=3 , crossings={ 1/1 , 2/-1 , 1/1 , 2/-1 } , stride=7 , gauge=6 ,
        axes=false , grid=false
      }
      {#1}
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_math_crossings_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_math_record:n {##1}
        \semio_viz_math_braid_step:nnn { \l_tmpa_int }
          { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } }
      }
    \str_if_eq:VnT \l_semio_viz_math_mode_tl { knot } { \semio_viz_math_braid_closure: }
  }
% 🪡 Draws column #1 of the word: strand #2 curves over its neighbour of sign #3, the rest run straight through.
\cs_new_protected:Npn \semio_viz_math_braid_step:nnn #1#2#3
  {
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_strands_int }
      {
        \int_compare:nNnTF {##1} = {#2}
          {
            \draw [ semio~sci~curve ]
              ( \fp_eval:n { ( #1 - 1 ) * \l_semio_viz_math_stride_fp } , \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } )
              .. controls
                ( \fp_eval:n { ( #1 - 0.5 ) * \l_semio_viz_math_stride_fp } , \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } ) and
                ( \fp_eval:n { ( #1 - 0.5 ) * \l_semio_viz_math_stride_fp } , \fp_eval:n { ( ##1 + 1 ) * \l_semio_viz_math_gauge_fp } ) ..
              ( \fp_eval:n { #1 * \l_semio_viz_math_stride_fp } , \fp_eval:n { ( ##1 + 1 ) * \l_semio_viz_math_gauge_fp } ) ;
          }
          {
            \int_compare:nNnTF {##1} = { #2 + 1 }
              {
                \draw [ semio~sci~curve~alt , double=semio-chrome-base , double~distance=1.1pt ]
                  ( \fp_eval:n { ( #1 - 1 ) * \l_semio_viz_math_stride_fp } , \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } )
                  .. controls
                    ( \fp_eval:n { ( #1 - 0.5 ) * \l_semio_viz_math_stride_fp } , \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } ) and
                    ( \fp_eval:n { ( #1 - 0.5 ) * \l_semio_viz_math_stride_fp } , \fp_eval:n { ( ##1 - 1 ) * \l_semio_viz_math_gauge_fp } ) ..
                  ( \fp_eval:n { #1 * \l_semio_viz_math_stride_fp } , \fp_eval:n { ( ##1 - 1 ) * \l_semio_viz_math_gauge_fp } ) ;
              }
              {
                \draw [ semio~sci~thin ]
                  ( \fp_eval:n { ( #1 - 1 ) * \l_semio_viz_math_stride_fp } , \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } ) --
                  ( \fp_eval:n { #1 * \l_semio_viz_math_stride_fp } , \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } ) ;
              }
          }
      }
    \semio_viz_sci_report_values:nn { braid/crossing } { #1 , #2 , #3 }
  }
% 🔄 Loops every strand from the right end back around under the braid to its left end, closing it into a knot.
\cs_new_protected:Npn \semio_viz_math_braid_closure:
  {
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_strands_int }
      {
        \draw [ semio~sci~thin ]
          ( 0 , \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } )
          .. controls ( \fp_eval:n { -2 - 1.4 * ##1 } , \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } ) and
                      ( \fp_eval:n { -2 - 1.4 * ##1 } , \fp_eval:n { -1.5 * \l_semio_viz_math_gauge_fp } ) ..
          ( \fp_eval:n { \clist_count:N \l_semio_viz_math_crossings_clist * \l_semio_viz_math_stride_fp / 2 } ,
            \fp_eval:n { -1.5 * \l_semio_viz_math_gauge_fp } )
          .. controls ( \fp_eval:n { \clist_count:N \l_semio_viz_math_crossings_clist * \l_semio_viz_math_stride_fp + 2 + 1.4 * ##1 } ,
                        \fp_eval:n { -1.5 * \l_semio_viz_math_gauge_fp } ) and
                      ( \fp_eval:n { \clist_count:N \l_semio_viz_math_crossings_clist * \l_semio_viz_math_stride_fp + 2 + 1.4 * ##1 } ,
                        \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } ) ..
          ( \fp_eval:n { \clist_count:N \l_semio_viz_math_crossings_clist * \l_semio_viz_math_stride_fp } ,
            \fp_eval:n { ##1 * \l_semio_viz_math_gauge_fp } ) ;
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-set` (§38/§39 set diagrams):
%    mode (venn|euler|area-proportional, venn): circle placement rule.
%    sets (clist of `label/size`), intersections (clist of `labels/size`).
%    radius (fp, 11): base circle radius in millimetres; area-proportional scales it by the set sizes.
%    labels (bool, true): draw region counts.
\bool_new:N \l_semio_viz_math_labels_bool
\fp_new:N \l_semio_viz_math_radius_fp
\clist_new:N \l_semio_viz_math_sets_clist
\clist_new:N \l_semio_viz_math_inter_clist
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-set }
% 🧿 Binds the `sci-set` keys to the set and intersection sizes, the base radius and the label switch.
\keys_define:nn { semio / viz / family / sci-set }
  {
    mode          .tl_set:N    = \l_semio_viz_math_mode_tl ,
    sets          .clist_set:N = \l_semio_viz_math_sets_clist ,
    intersections .clist_set:N = \l_semio_viz_math_inter_clist ,
    radius        .fp_set:N    = \l_semio_viz_math_radius_fp ,
    labels        .bool_set:N  = \l_semio_viz_math_labels_bool ,
  }

% ⭕ Centre distance of two equal circles of radius r whose lens area is `#1`, by 60 bisection steps on the lens-area formula.
\fp_new:N \l_semio_viz_math_dist_fp
\cs_new_protected:Npn \semio_viz_math_lens_distance:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_sci_q_lo_fp { 0 }
    \fp_set:Nn \l_semio_viz_sci_q_hi_fp { 2 * (#2) }
    \int_step_inline:nnnn { 1 } { 1 } { 60 }
      {
        \fp_set:Nn \l_semio_viz_sci_q_mid_fp { ( \l_semio_viz_sci_q_lo_fp + \l_semio_viz_sci_q_hi_fp ) / 2 }
        \fp_set:Nn \l_semio_viz_sci_a_fp
          {
            2 * (#2) * (#2) * acos ( \l_semio_viz_sci_q_mid_fp / ( 2 * (#2) ) ) * pi / 180
            - \l_semio_viz_sci_q_mid_fp * sqrt ( max ( 0 , (#2) * (#2) - \l_semio_viz_sci_q_mid_fp * \l_semio_viz_sci_q_mid_fp / 4 ) )
          }
        \fp_compare:nNnTF { \l_semio_viz_sci_a_fp } > {#1}
          { \fp_set_eq:NN \l_semio_viz_sci_q_lo_fp \l_semio_viz_sci_q_mid_fp }
          { \fp_set_eq:NN \l_semio_viz_sci_q_hi_fp \l_semio_viz_sci_q_mid_fp }
      }
    \fp_set:Nn \l_semio_viz_math_dist_fp { ( \l_semio_viz_sci_q_lo_fp + \l_semio_viz_sci_q_hi_fp ) / 2 }
  }

% 🔵 §38/§39 set diagrams: Venn circles for two to four sets, Euler placement and the area-proportional two-set solution.
\SemioVizFamily { sci-set }
  {
    \semio_viz_sci_enter:nnn { sci-set }
      {
        mode=venn , sets={ A/38 , B/26 , C/17 } , intersections={ AB/12 , AC/7 , BC/5 , ABC/3 } ,
        radius=11 , labels=true , axes=false , grid=false
      }
      {#1}
    \str_case:VnF \l_semio_viz_math_mode_tl
      {
        { area-proportional } { \semio_viz_math_set_proportional: }
        { euler }             { \semio_viz_math_set_euler: }
      }
      { \semio_viz_math_set_venn: }
  }
% 🟡 Fills and outlines one set circle centred at (#1,#2) with radius #3 in the hue of index #4.
\cs_new_protected:Npn \semio_viz_math_set_circle:nnnn #1#2#3#4
  {
    \fill [ fill=\semio_viz_sci_hue:n {#4} , fill~opacity=0.22 ]
      ( #1 , #2 ) circle [ radius=#3 ] ;
    \draw [ semio~sci~thin , draw=\semio_viz_sci_hue:n {#4} ]
      ( #1 , #2 ) circle [ radius=#3 ] ;
    \semio_viz_sci_report_values:nn { set/circle }
      { \fp_to_decimal:n {#1} , \fp_to_decimal:n {#2} , \fp_to_decimal:n {#3} }
  }
% 🌸 Places all sets as equal circles spaced evenly around a small ring, each with its optional size label.
\cs_new_protected:Npn \semio_viz_math_set_venn:
  {
    \int_set:Nn \l_tmpa_int { \clist_count:N \l_semio_viz_math_sets_clist }
    \int_step_inline:nnnn { 1 } { 1 } { \l_tmpa_int }
      {
        \semio_viz_math_record:n { \clist_item:Nn \l_semio_viz_math_sets_clist {##1} }
        \semio_viz_math_set_circle:nnnn
          { \fp_eval:n { 0.62 * \l_semio_viz_math_radius_fp
              * cos ( 2 * pi * ##1 / \l_tmpa_int + pi / 2 ) } }
          { \fp_eval:n { 0.62 * \l_semio_viz_math_radius_fp
              * sin ( 2 * pi * ##1 / \l_tmpa_int + pi / 2 ) } }
          { \fp_eval:n { \l_semio_viz_math_radius_fp } } {##1}
        \bool_if:NT \l_semio_viz_math_labels_bool
          {
            \node [ font=\c_semio_viz_theme_font_title_tl , text=semio-chrome-foreground ]
              at ( \fp_eval:n { 1.55 * \l_semio_viz_math_radius_fp * cos ( 2 * pi * ##1 / \l_tmpa_int + pi / 2 ) } ,
                   \fp_eval:n { 1.55 * \l_semio_viz_math_radius_fp * sin ( 2 * pi * ##1 / \l_tmpa_int + pi / 2 ) } )
              { \semio_viz_math_field:n { 1 } ~ \semio_viz_math_field:n { 2 } } ;
          }
      }
  }
% 🥚 Lines the sets up in a row, each radius scaled by the square root of its share of the largest set.
\cs_new_protected:Npn \semio_viz_math_set_euler:
  {
    \int_set:Nn \l_tmpa_int { \clist_count:N \l_semio_viz_math_sets_clist }
    \fp_set:Nn \l_semio_viz_math_maxsize_fp { 1e-9 }
    \clist_map_inline:Nn \l_semio_viz_math_sets_clist
      {
        \semio_viz_math_record:n {##1}
        \fp_set:Nn \l_semio_viz_math_maxsize_fp
          { max ( \l_semio_viz_math_maxsize_fp , \semio_viz_math_field:n { 2 } ) }
      }
    \int_step_inline:nnnn { 1 } { 1 } { \l_tmpa_int }
      {
        \semio_viz_math_record:n { \clist_item:Nn \l_semio_viz_math_sets_clist {##1} }
        \semio_viz_math_set_circle:nnnn
          { \fp_eval:n { 1.15 * \l_semio_viz_math_radius_fp * ( ##1 - ( \l_tmpa_int + 1 ) / 2 ) } }
          { 0 }
          { \fp_eval:n { \l_semio_viz_math_radius_fp
              * sqrt ( \semio_viz_math_field:n { 2 } / \l_semio_viz_math_maxsize_fp ) } }
          {##1}
      }
  }
% ⚖️ Solves the two-set area-proportional layout: radii from the two sizes, centre distance from the overlap.
\cs_new_protected:Npn \semio_viz_math_set_proportional:
  {
    \semio_viz_math_record:n { \clist_item:Nn \l_semio_viz_math_sets_clist { 1 } }
    \fp_set:Nn \l_semio_viz_sci_e_fp { \semio_viz_math_field:n { 2 } }
    \semio_viz_math_record:n { \clist_item:Nn \l_semio_viz_math_sets_clist { 2 } }
    \fp_set:Nn \l_semio_viz_sci_f_fp { \semio_viz_math_field:n { 2 } }
    \semio_viz_math_record:n { \clist_item:Nn \l_semio_viz_math_inter_clist { 1 } }
    \fp_set:Nn \l_semio_viz_sci_g_fp { \semio_viz_math_field:n { 2 } }
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \l_semio_viz_math_radius_fp * sqrt ( \l_semio_viz_sci_e_fp / max ( \l_semio_viz_sci_e_fp , \l_semio_viz_sci_f_fp ) ) }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \l_semio_viz_math_radius_fp * sqrt ( \l_semio_viz_sci_f_fp / max ( \l_semio_viz_sci_e_fp , \l_semio_viz_sci_f_fp ) ) }
    \semio_viz_math_lens_distance:nn
      { \fp_eval:n { pi * \l_semio_viz_sci_a_fp * \l_semio_viz_sci_a_fp
          * \l_semio_viz_sci_g_fp / \l_semio_viz_sci_e_fp } }
      { \fp_eval:n { ( \l_semio_viz_sci_a_fp + \l_semio_viz_sci_b_fp ) / 2 } }
    \semio_viz_math_set_circle:nnnn
      { \fp_eval:n { - \l_semio_viz_math_dist_fp / 2 } } { 0 } { \fp_eval:n { \l_semio_viz_sci_a_fp } } { 1 }
    \semio_viz_math_set_circle:nnnn
      { \fp_eval:n { \l_semio_viz_math_dist_fp / 2 } } { 0 } { \fp_eval:n { \l_semio_viz_sci_b_fp } } { 2 }
    \semio_viz_sci_report_values:nn { set/distance } { \fp_to_decimal:N \l_semio_viz_math_dist_fp }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-upset` (§39 intersection plots):
%    mode (upset|combination-matrix|intersection-matrix|overlap-network, upset).
%    sets (clist of `label/size`), intersections (clist of `members/size`) where members are set labels joined by `+`.
%    cell (fp, 5): matrix cell size. barHeight (fp, 20): bar panel height in millimetres.
\fp_new:N \l_semio_viz_math_barh_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-upset }
% 🎚️ Binds the `sci-upset` keys to the set and intersection lists, the matrix cell size and the bar panel height.
\keys_define:nn { semio / viz / family / sci-upset }
  {
    mode          .tl_set:N    = \l_semio_viz_math_mode_tl ,
