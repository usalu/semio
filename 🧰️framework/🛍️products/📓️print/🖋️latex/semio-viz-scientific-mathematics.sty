% 🔺 §41 probability simplex: barycentric coordinates on an equilateral triangle with composition guides.
\SemioVizFamily { sci-simplex }
  {
    \semio_viz_sci_enter:nnn { sci-simplex }
      {
        points={ 0.6/0.3/0.1/p , 0.2/0.5/0.3/q , 0.1/0.2/0.7/r } , side=44 , gridLines=4 ,
        axes=false , grid=false
      }
      {#1}
    \draw [ semio~sci~axis ]
      ( 0 , 0 ) -- ( \fp_eval:n { \l_semio_viz_math_side_fp } , 0 ) --
      ( \fp_eval:n { \l_semio_viz_math_side_fp / 2 } , \fp_eval:n { \l_semio_viz_math_side_fp * sqrt (3) / 2 } ) -- cycle ;
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_gridlines_int - 1 }
      {
        \draw [ semio~sci~grid ]
          ( \fp_eval:n { \l_semio_viz_math_side_fp * ##1 / ( 2 * \l_semio_viz_math_gridlines_int ) } ,
            \fp_eval:n { \l_semio_viz_math_side_fp * sqrt (3) * ##1 / ( 2 * \l_semio_viz_math_gridlines_int ) } ) --
          ( \fp_eval:n { \l_semio_viz_math_side_fp * ( 1 - ##1 / ( 2 * \l_semio_viz_math_gridlines_int ) ) } ,
            \fp_eval:n { \l_semio_viz_math_side_fp * sqrt (3) * ##1 / ( 2 * \l_semio_viz_math_gridlines_int ) } ) ;
      }
    \clist_map_inline:Nn \l_semio_viz_math_points_clist
      {
        \semio_viz_math_record:n {##1}
        \semio_viz_math_simplex_point:
      }
  }
% 🔘 Normalises the record's three weights into triangle coordinates and dots the labelled composition there.
\cs_new_protected:Npn \semio_viz_math_simplex_point:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \semio_viz_math_field:n { 1 } + \semio_viz_math_field:n { 2 } + \semio_viz_math_field:n { 3 } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      {
        \l_semio_viz_math_side_fp
          * ( \semio_viz_math_field:n { 2 } + \semio_viz_math_field:n { 3 } / 2 ) / \l_semio_viz_sci_a_fp
      }
    \fp_set:Nn \l_semio_viz_sci_c_fp
      { \l_semio_viz_math_side_fp * sqrt (3) / 2 * \semio_viz_math_field:n { 3 } / \l_semio_viz_sci_a_fp }
    \fill [ fill=semio-primary ]
      ( \fp_eval:n { \l_semio_viz_sci_b_fp } , \fp_eval:n { \l_semio_viz_sci_c_fp } ) circle [ radius=0.9 ] ;
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=south~west ]
      at ( \fp_eval:n { \l_semio_viz_sci_b_fp } , \fp_eval:n { \l_semio_viz_sci_c_fp } )
      { \semio_viz_math_field:n { 4 } } ;
    \semio_viz_sci_report_values:nn { simplex/point }
      { \fp_to_decimal:N \l_semio_viz_sci_b_fp , \fp_to_decimal:N \l_semio_viz_sci_c_fp }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-transition` (§41 stochastic structure):
%    mode (markov|bayesian|matrix, markov).
%    nodes (clist of `id/x/y/label`), edges (clist of `from/to/style/label`) for the graph modes.
%    matrix (clist of rows, each a `;`-free clist of probabilities) for the matrix mode.
%    cell (fp, 6): matrix cell size in millimetres.
\clist_new:N \l_semio_viz_math_matrix_clist
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-transition }
% 🪞 Binds the `sci-transition` keys to the graph nodes and edges, the probability matrix and the cell and coordinate units.
\keys_define:nn { semio / viz / family / sci-transition }
  {
    mode   .tl_set:N    = \l_semio_viz_math_mode_tl ,
    nodes  .clist_set:N = \l_semio_viz_math_nodes_clist ,
    edges  .clist_set:N = \l_semio_viz_math_edges_clist ,
    matrix .clist_set:N = \l_semio_viz_math_matrix_clist ,
    cell   .fp_set:N    = \l_semio_viz_math_cell_fp ,
    unit   .fp_set:N    = \l_semio_viz_math_unit_fp ,
  }

% 🔗 §41 stochastic structure: Markov chains, Bayesian networks and the transition matrix as a probability heat grid.
\SemioVizFamily { sci-transition }
  {
    \semio_viz_sci_enter:nnn { sci-transition }
      {
        mode=markov , unit=18 , cell=6 , axes=false , grid=false ,
        nodes={ s/0/0/S , r/1/0.6/R , c/2/0/C } ,
        edges={ s/r/arrow/0.4 , r/c/arrow/0.3 , c/s/arrow/0.5 } ,
        matrix={ 0.6/0.3/0.1 , 0.2/0.5/0.3 , 0.1/0.2/0.7 }
      }
      {#1}
    \str_if_eq:VnTF \l_semio_viz_math_mode_tl { matrix }
      { \semio_viz_math_matrix_grid: }
      {
        \semio_viz_math_nodes_read:N \l_semio_viz_math_nodes_clist
        \tl_set:Nn \l_semio_viz_math_nodeshape_tl { circle }
        \semio_viz_math_diagram_edges:
        \semio_viz_math_diagram_nodes:
      }
  }
% 🧊 Walks the matrix rows and their slash-separated entries, drawing one heat cell each.
\cs_new_protected:Npn \semio_viz_math_matrix_grid:
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_math_matrix_clist
      {
        \int_incr:N \l_tmpa_int
        \seq_set_split:Nnn \l_tmpb_seq { / } {##1}
        \int_zero:N \l_tmpb_int
        \seq_map_inline:Nn \l_tmpb_seq
          {
            \int_incr:N \l_tmpb_int
            \semio_viz_math_matrix_cell:nnn { \l_tmpa_int } { \l_tmpb_int } {####1}
          }
      }
  }
% 🔳 Fills row #1, column #2 with the ramp colour of probability #3 and prints that value inside it.
\cs_new_protected:Npn \semio_viz_math_matrix_cell:nnn #1#2#3
  {
    \fill [ fill=\semio_viz_sci_ramp:n {#3} ]
      ( \fp_eval:n { ( #2 - 1 ) * \l_semio_viz_math_cell_fp } , \fp_eval:n { - #1 * \l_semio_viz_math_cell_fp } )
      rectangle
      ( \fp_eval:n { #2 * \l_semio_viz_math_cell_fp } , \fp_eval:n { ( 1 - #1 ) * \l_semio_viz_math_cell_fp } ) ;
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground ]
      at ( \fp_eval:n { ( #2 - 0.5 ) * \l_semio_viz_math_cell_fp } ,
           \fp_eval:n { ( 0.5 - #1 ) * \l_semio_viz_math_cell_fp } ) {#3} ;
    \semio_viz_sci_report_values:nn { matrix/cell } { #1 , #2 , #3 }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-density` (§41 joint and conditional densities):
%    mode (joint|marginal|conditional|copula, joint).
%    points (clist of `x/y`): the sample. bandwidth (fp, 0.12): Gaussian kernel width.
%    columns, rows (int, 28): estimation lattice. levels (int, 5): contour count.
%    at (fp, 0.5): the conditioning value of x in `conditional` mode.
\fp_new:N \l_semio_viz_math_bw_fp
\fp_new:N \l_semio_viz_math_at_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-density }
% 🌫️ Binds the `sci-density` keys to the sample points, the kernel bandwidth, the estimation lattice and the conditioning value.
\keys_define:nn { semio / viz / family / sci-density }
  {
    mode      .tl_set:N    = \l_semio_viz_math_mode_tl ,
    points    .clist_set:N = \l_semio_viz_math_points_clist ,
    bandwidth .fp_set:N    = \l_semio_viz_math_bw_fp ,
    columns   .int_set:N   = \l_semio_viz_math_cols_int ,
    rows      .int_set:N   = \l_semio_viz_math_rows_int ,
    levels    .int_set:N   = \l_semio_viz_math_levels_int ,
    at        .fp_set:N    = \l_semio_viz_math_at_fp ,
  }

% 🫧 Gaussian kernel density of the point sample at the current (\SemioX,\SemioY).
\cs_new_protected:Npn \semio_viz_math_kde:N #1
  {
    \fp_zero:N #1
    \clist_map_inline:Nn \l_semio_viz_math_points_clist
      {
        \seq_set_split:Nnn \l_tmpb_seq { / } {##1}
        \fp_add:Nn #1
          {
            exp ( - ( ( \SemioX - \seq_item:Nn \l_tmpb_seq { 1 } ) ^ 2
                    + ( \SemioY - \seq_item:Nn \l_tmpb_seq { 2 } ) ^ 2 )
                  / ( 2 * \l_semio_viz_math_bw_fp * \l_semio_viz_math_bw_fp ) )
          }
      }
    \fp_set:Nn #1
      { #1 / ( 2 * pi * \l_semio_viz_math_bw_fp * \l_semio_viz_math_bw_fp * \clist_count:N \l_semio_viz_math_points_clist ) }
  }

% 🫧 §41 densities: the joint kernel estimate as a raster with contours, its marginals, a conditional slice and a copula scatter.
\SemioVizFamily { sci-density }
  {
    \semio_viz_sci_enter:nnn { sci-density }
      {
        mode=joint , bandwidth=0.12 , columns=28 , rows=28 , levels=5 , at=0.5 ,
        points={ 0.12/0.31 , 0.44/0.58 , 0.71/0.42 , 0.26/0.77 , 0.83/0.69 , 0.55/0.19 ,
                 0.37/0.49 , 0.62/0.86 , 0.19/0.62 , 0.91/0.34 } ,
        domain={0,1} , range={0,1}
      }
      {#1}
    \semio_viz_sci_window_keys:
    \str_case:VnF \l_semio_viz_math_mode_tl
      {
        { copula }
          {
            \semio_viz_sci_frame:
            \clist_map_inline:Nn \l_semio_viz_math_points_clist
              {
                \seq_set_split:Nnn \l_tmpb_seq { / } {##1}
                \semio_viz_sci_dot:nnn { \seq_item:Nn \l_tmpb_seq { 1 } } { \seq_item:Nn \l_tmpb_seq { 2 } }
                  { semio-primary }
              }
          }
        { marginal }  { \semio_viz_sci_frame: \semio_viz_math_marginals: }
        { conditional }
          {
            \semio_viz_sci_frame:
            \semio_viz_math_conditional:
          }
      }
      {
        \semio_viz_math_density_raster:
        \semio_viz_sci_frame:
        \clist_map_inline:Nn \l_semio_viz_math_points_clist
          {
            \seq_set_split:Nnn \l_tmpb_seq { / } {##1}
            \semio_viz_sci_dot:nnn { \seq_item:Nn \l_tmpb_seq { 1 } } { \seq_item:Nn \l_tmpb_seq { 2 } }
              { semio-chrome-foreground }
          }
      }
  }
% 🖼️ Evaluates the kernel estimate on the columns×rows lattice and fills each cell with its ramp colour.
\cs_new_protected:Npn \semio_viz_math_density_raster:
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_cols_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_rows_int - 1 }
          {
            \fp_set:Nn \SemioX
              { \l_semio_viz_sci_dxmin_fp + ( \l_semio_viz_sci_dxmax_fp - \l_semio_viz_sci_dxmin_fp )
                * ( ##1 + 0.5 ) / \l_semio_viz_math_cols_int }
            \fp_set:Nn \SemioY
              { \l_semio_viz_sci_dymin_fp + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp )
                * ( ####1 + 0.5 ) / \l_semio_viz_math_rows_int }
            \semio_viz_math_kde:N \l_semio_viz_sci_a_fp
            \fill [ fill=\semio_viz_sci_ramp:n { \l_semio_viz_sci_a_fp / 2 } ]
              ( \fp_eval:n { \l_semio_viz_sci_w_fp * ##1 / \l_semio_viz_math_cols_int } ,
                \fp_eval:n { \l_semio_viz_sci_h_fp * ####1 / \l_semio_viz_math_rows_int } )
              rectangle
              ( \fp_eval:n { \l_semio_viz_sci_w_fp * ( ##1 + 1 ) / \l_semio_viz_math_cols_int } ,
                \fp_eval:n { \l_semio_viz_sci_h_fp * ( ####1 + 1 ) / \l_semio_viz_math_rows_int } ) ;
          }
      }
  }
% 🏔️ Integrates the kernel estimate over y at 61 x positions and draws the rescaled marginal as a filled band.
\cs_new_protected:Npn \semio_viz_math_marginals:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \seq_clear:N \l_semio_viz_sci_pts_b_seq
    \int_step_inline:nnnn { 0 } { 1 } { 60 }
      {
        \fp_set:Nn \SemioX
          { \l_semio_viz_sci_dxmin_fp + ( \l_semio_viz_sci_dxmax_fp - \l_semio_viz_sci_dxmin_fp ) * ##1 / 60 }
        \fp_zero:N \l_semio_viz_sci_c_fp
        \int_step_inline:nnnn { 0 } { 1 } { 24 }
          {
            \fp_set:Nn \SemioY
              { \l_semio_viz_sci_dymin_fp + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp ) * ####1 / 24 }
            \semio_viz_math_kde:N \l_semio_viz_sci_d_fp
            \fp_add:Nn \l_semio_viz_sci_c_fp { \l_semio_viz_sci_d_fp }
          }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \SemioX }
          { \l_semio_viz_sci_c_fp * ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp ) / 25 }
      }
    \semio_viz_sci_extent:N \l_semio_viz_sci_pts_seq
    \seq_clear:N \l_semio_viz_sci_pts_c_seq
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_c_seq { \semio_viz_points_x:n {##1} }
          {
            \l_semio_viz_sci_dymin_fp
            + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp )
              * \semio_viz_points_y:n {##1} / max ( 1e-9 , \l_semio_viz_sci_ymax_fp )
          }
      }
    \semio_viz_sci_polyarea:Nnn \l_semio_viz_sci_pts_c_seq { semio~sci~band } { \l_semio_viz_sci_dymin_fp }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_c_seq { semio~sci~curve }
  }
% 🔪 Slices the kernel estimate at the conditioning x, rescales it into the window and marks the slice position.
\cs_new_protected:Npn \semio_viz_math_conditional:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \fp_set:Nn \SemioX { \l_semio_viz_math_at_fp }
    \int_step_inline:nnnn { 0 } { 1 } { 60 }
      {
        \fp_set:Nn \SemioY
          { \l_semio_viz_sci_dymin_fp + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp ) * ##1 / 60 }
        \semio_viz_math_kde:N \l_semio_viz_sci_a_fp
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \SemioY } { \l_semio_viz_sci_a_fp }
      }
    \semio_viz_sci_extent:N \l_semio_viz_sci_pts_seq
    \seq_clear:N \l_semio_viz_sci_pts_b_seq
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \semio_viz_points_x:n {##1} }
          {
            \l_semio_viz_sci_dymin_fp
            + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp )
              * \semio_viz_points_y:n {##1} / max ( 1e-9 , \l_semio_viz_sci_ymax_fp )
          }
      }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq { semio~sci~curve }
    \draw [ semio~sci~aux ]
      ( \semio_viz_sci_mx:n { \l_semio_viz_math_at_fp } , 0 ) --
      ( \semio_viz_sci_mx:n { \l_semio_viz_math_at_fp } , \fp_eval:n { \l_semio_viz_sci_h_fp } ) ;
  }
%endregion 🔖️Families

\ExplSyntaxOff
