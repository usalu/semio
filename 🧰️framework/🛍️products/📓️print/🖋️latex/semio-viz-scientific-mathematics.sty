% 🗳️ Draws intersection column #1: the size bar for #3 and a filled or hollow dot per set in the membership #2.
\cs_new_protected:Npn \semio_viz_math_upset_column:nnn #1#2#3
  {
    \str_if_eq:VnF \l_semio_viz_math_mode_tl { combination-matrix }
      {
        \fill [ fill=semio-primary ]
          ( \fp_eval:n { ( #1 - 0.8 ) * \l_semio_viz_math_cell_fp } , 0 ) rectangle
          ( \fp_eval:n { ( #1 - 0.2 ) * \l_semio_viz_math_cell_fp } ,
            \fp_eval:n { \l_semio_viz_math_barh_fp * (#3) / \l_semio_viz_sci_a_fp } ) ;
      }
    \int_zero:N \l_tmpb_int
    \clist_map_inline:Nn \l_semio_viz_math_sets_clist
      {
        \int_incr:N \l_tmpb_int
        \semio_viz_math_record:n {##1}
        \seq_set_split:Nnn \l_tmpa_seq { + } {#2}
        \seq_if_in:NxTF \l_tmpa_seq { \semio_viz_math_field:n { 1 } }
          {
            \fill [ fill=semio-primary ]
              ( \fp_eval:n { ( #1 - 0.5 ) * \l_semio_viz_math_cell_fp } ,
                \fp_eval:n { - \l_tmpb_int * \l_semio_viz_math_cell_fp } ) circle [ radius=0.9 ] ;
          }
          {
            \fill [ fill=semio-chrome-panel ]
              ( \fp_eval:n { ( #1 - 0.5 ) * \l_semio_viz_math_cell_fp } ,
                \fp_eval:n { - \l_tmpb_int * \l_semio_viz_math_cell_fp } ) circle [ radius=0.9 ] ;
          }
      }
    \semio_viz_sci_report_values:nn { upset/column } { #1 , #3 }
  }

