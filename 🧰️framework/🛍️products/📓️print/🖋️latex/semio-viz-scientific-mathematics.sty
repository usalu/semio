\semio_viz_sci_keys_canvas:n { sci-probability-tree }
% 🌲 Binds the `sci-probability-tree` keys to the branch records, the depth and sibling spacing and the label switch.
\keys_define:nn { semio / viz / family / sci-probability-tree }
  {
    branches          .clist_set:N = \l_semio_viz_math_branches_clist ,
