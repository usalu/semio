% 📊 §39 intersection plots: the UpSet bar panel over its membership matrix, and the plain combination matrix.
\SemioVizFamily { sci-upset }
  {
    \semio_viz_sci_enter:nnn { sci-upset }
      {
        mode=upset , sets={ A/38 , B/26 , C/17 } ,
        intersections={ A/19 , B/9 , A+B/12 , A+C/7 , B+C/5 , A+B+C/3 } ,
        cell=5 , barHeight=20 , axes=false , grid=false
      }
      {#1}
    \fp_zero:N \l_semio_viz_sci_a_fp
    \clist_map_inline:Nn \l_semio_viz_math_inter_clist
      {
        \semio_viz_math_record:n {##1}
        \fp_set:Nn \l_semio_viz_sci_a_fp { max ( \l_semio_viz_sci_a_fp , \semio_viz_math_field:n { 2 } ) }
      }
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_math_inter_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_math_record:n {##1}
        \semio_viz_math_upset_column:nnn { \l_tmpa_int }
          { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } }
      }
    \int_zero:N \l_tmpb_int
    \clist_map_inline:Nn \l_semio_viz_math_sets_clist
