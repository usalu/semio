                       \fp_eval:n { \l_semio_viz_math_unit_fp * \semio_viz_math_field:n { 3 } } )
                  { \semio_viz_math_field:n { 4 } } ;
              }
          }
          {
            \node [ font=\c_semio_viz_theme_font_title_tl , text=semio-chrome-foreground ,
                    inner~sep=0.6mm , fill=semio-chrome-base ]
              at ( \fp_eval:n { \l_semio_viz_math_unit_fp * \semio_viz_math_field:n { 2 } } ,
                   \fp_eval:n { \l_semio_viz_math_unit_fp * \semio_viz_math_field:n { 3 } } )
              { \semio_viz_math_field:n { 4 } } ;
          }
        \semio_viz_sci_report_values:nn { diagram/node }
          { \fp_to_decimal:n { \l_semio_viz_math_unit_fp * \semio_viz_math_field:n { 2 } } ,
            \fp_to_decimal:n { \l_semio_viz_math_unit_fp * \semio_viz_math_field:n { 3 } } }
      }
  }

% 🔷 §38 node-and-arrow diagrams: commutative squares, string and tensor networks, Hasse and Cayley graphs, Dynkin marks, proof and rewrite trees.
