% 🔀 Draws every edge between its two endpoint node positions, with its label riding the line.
\cs_new_protected:Npn \semio_viz_math_diagram_edges:
  {
    \clist_map_inline:Nn \l_semio_viz_math_edges_clist
      {
        \semio_viz_math_record:n {##1}
