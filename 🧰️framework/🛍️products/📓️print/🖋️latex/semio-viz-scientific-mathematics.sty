        { double } { semio~sci~arrow , double , double~distance=0.5pt }
        { dashed } { semio~sci~arrow , dash~pattern=on~1.4pt~off~1.2pt }
        { wire }   { semio~sci~thin }
        { leg }    { semio~sci~thin , draw=semio-secondary }
