%region 🔖️Variants
% 🔧 Expansion variants the renderers below need; the kernel packages declare none of them yet.
\cs_generate_variant:Nn \prop_put:Nnn { Nxx }
\cs_generate_variant:Nn \seq_set_split:Nnn { Nnx }
\cs_generate_variant:Nn \prop_item:Nn { Ne , NV }
\prg_generate_conditional_variant:Nnn \seq_if_in:Nn { Nx } { T, F, TF }
\fp_new:N \l_semio_viz_math_maxsize_fp
\cs_generate_variant:Nn \semio_viz_tr_dist_quantile:nnnnnnN { VnnnnnN }
%endregion 🔖️Variants

%region 🔖️Parsing
% 🧩 Splits a `a/b/c/…` record into the scratch sequence every renderer below reads its fields from.
\seq_new:N \l_semio_viz_math_rec_seq
\cs_new_protected:Npn \semio_viz_math_record:n #1
  { \seq_set_split:Nnx \l_semio_viz_math_rec_seq { / } {#1} }
% 🔢 Returns field #1 of the record most recently split by \semio_viz_math_record:n.
\cs_new:Npn \semio_viz_math_field:n #1
  { \seq_item:Nn \l_semio_viz_math_rec_seq {#1} }

% 🧩 Node table `id/x/y/label`: positions are looked up by id when edges are drawn.
\prop_new:N \l_semio_viz_math_nodex_prop
\prop_new:N \l_semio_viz_math_nodey_prop
\cs_new_protected:Npn \semio_viz_math_nodes_read:N #1
  {
    \prop_clear:N \l_semio_viz_math_nodex_prop
    \prop_clear:N \l_semio_viz_math_nodey_prop
    \clist_map_inline:Nn #1
      {
        \semio_viz_math_record:n {##1}
        \prop_put:Nxx \l_semio_viz_math_nodex_prop
          { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } }
        \prop_put:Nxx \l_semio_viz_math_nodey_prop
          { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 3 } }
      }
  }
% 📍 Reads back the x coordinate stored for the node whose id is #1.
\cs_new:Npn \semio_viz_math_nodex:n #1 { \prop_item:Ne \l_semio_viz_math_nodex_prop {#1} }
% 📌 Reads back the y coordinate stored for the node whose id is #1.
\cs_new:Npn \semio_viz_math_nodey:n #1 { \prop_item:Ne \l_semio_viz_math_nodey_prop {#1} }
%endregion 🔖️Parsing

