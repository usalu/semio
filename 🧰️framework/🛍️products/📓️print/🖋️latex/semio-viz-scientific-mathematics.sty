%region 🔖️Families

%region 🔖️Keys
% 🔑 Keys of `sci-function` (§25 curve plotting):
%    mode (cartesian|parametric|polar|implicit|piecewise|vector-valued, cartesian): what the expressions mean.
%    expr (l3fp over \SemioX or \SemioT): the function, or the x component in parametric modes.
%    exprY (l3fp over \SemioT): the y component in parametric and vector-valued modes.
%    pieces (clist of `from/to/expr`): the segments of a piecewise function.
%    samples (int, 120): uniform sample count. refine (int, 2), tolerance (fp, 0.03): adaptive midpoint refinement budget.
%    columns, rows (int, 40): implicit-curve lattice. level (fp, 0): the implicit level set f=level.
%    fill (none|area, none): shade between curve and the baseline. baseline (fp, 0): that baseline.
%    glyphs (int, 0): number of arrow glyphs drawn along a vector-valued curve.
\tl_new:N \l_semio_viz_math_mode_tl
\tl_new:N \l_semio_viz_math_expr_tl
\tl_new:N \l_semio_viz_math_expry_tl
\tl_new:N \l_semio_viz_math_fill_tl
\clist_new:N \l_semio_viz_math_pieces_clist
\int_new:N \l_semio_viz_math_samples_int
\int_new:N \l_semio_viz_math_refine_int
\int_new:N \l_semio_viz_math_cols_int
\int_new:N \l_semio_viz_math_rows_int
\int_new:N \l_semio_viz_math_glyphs_int
\fp_new:N \l_semio_viz_math_tol_fp
\fp_new:N \l_semio_viz_math_level_fp
\fp_new:N \l_semio_viz_math_base_fp

\semio_viz_sci_keys_canvas:n { sci-function }
% 📉 Binds the `sci-function` keys to the mode, expressions, sampling budget, lattice and fill variables.
\keys_define:nn { semio / viz / family / sci-function }
  {
    mode      .tl_set:N    = \l_semio_viz_math_mode_tl ,
    expr      .tl_set:N    = \l_semio_viz_math_expr_tl ,
    exprY     .tl_set:N    = \l_semio_viz_math_expry_tl ,
    pieces    .clist_set:N = \l_semio_viz_math_pieces_clist ,
    samples   .int_set:N   = \l_semio_viz_math_samples_int ,
    refine    .int_set:N   = \l_semio_viz_math_refine_int ,
    tolerance .fp_set:N    = \l_semio_viz_math_tol_fp ,
    columns   .int_set:N   = \l_semio_viz_math_cols_int ,
    rows      .int_set:N   = \l_semio_viz_math_rows_int ,
    level     .fp_set:N    = \l_semio_viz_math_level_fp ,
    fill      .tl_set:N    = \l_semio_viz_math_fill_tl ,
    baseline  .fp_set:N    = \l_semio_viz_math_base_fp ,
    glyphs    .int_set:N   = \l_semio_viz_math_glyphs_int ,
  }
%endregion 🔖️Keys

% 📈 Samples the current mode into the shared point sequence, in data coordinates.
\cs_new_protected:Npn \semio_viz_math_curve_sample:
  {
    \str_case:VnF \l_semio_viz_math_mode_tl
      {
        { parametric }
          { \semio_viz_math_param_sample:nn { \l_semio_viz_math_expr_tl } { \l_semio_viz_math_expry_tl } }
        { vector-valued }
          { \semio_viz_math_param_sample:nn { \l_semio_viz_math_expr_tl } { \l_semio_viz_math_expry_tl } }
        { polar }
          {
            \semio_viz_math_param_sample:nn
              { ( \l_semio_viz_math_expr_tl ) * cos ( \SemioT ) }
              { ( \l_semio_viz_math_expr_tl ) * sin ( \SemioT ) }
          }
      }
      {
        \semio_viz_sci_sample:Nnnnn \l_semio_viz_sci_pts_seq { \l_semio_viz_math_expr_tl }
          { \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } }
          { \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 } }
          { \l_semio_viz_math_samples_int }
        \semio_viz_sci_refine:Nnnn \l_semio_viz_sci_pts_seq { \l_semio_viz_math_expr_tl }
          { \l_semio_viz_math_refine_int } { \l_semio_viz_math_tol_fp }
      }
  }
% 🧵 Sweeps \SemioT over the domain and records each finite (#1,#2) pair as a curve point.
\cs_new_protected:Npn \semio_viz_math_param_sample:nn #1#2
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_samples_int }
      {
        \fp_set:Nn \SemioT
          {
            \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 }
            + ( \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 } - \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } )
              * ##1 / \l_semio_viz_math_samples_int
          }
        \fp_set:Nn \SemioX {#1}
        \semio_viz_tr_finite:nT {#2}
          { \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \SemioX } {#2} }
      }
  }

% 📈 Draws the sampled curve, its optional area fill and its optional direction glyphs.
\cs_new_protected:Npn \semio_viz_math_curve_draw:
  {
    \str_if_eq:VnT \l_semio_viz_math_fill_tl { area }
      { \semio_viz_sci_polyarea:Nnn \l_semio_viz_sci_pts_seq { semio~sci~band } { \l_semio_viz_math_base_fp } }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \int_compare:nNnT { \l_semio_viz_math_glyphs_int } > { 0 }
      {
        \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_glyphs_int }
          {
            \int_set:Nn \l_tmpb_int
              { \seq_count:N \l_semio_viz_sci_pts_seq * ##1 / ( \l_semio_viz_math_glyphs_int + 1 ) }
            \semio_viz_sci_arrow:nnnnn
              { \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { \l_tmpb_int } } }
              { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { \l_tmpb_int } } }
              { \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { \l_tmpb_int + 1 } } }
              { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { \l_tmpb_int + 1 } } }
              { semio~sci~vector }
          }
      }
  }

% 📈 §25 curve plotting: cartesian, parametric, polar, piecewise, vector-valued and implicit level sets.
\SemioVizFamily { sci-function }
  {
    \semio_viz_sci_enter:nnn { sci-function }
      {
        mode=cartesian , expr={ sin ( \SemioX ) * exp ( - abs ( \SemioX ) / 4 ) } , exprY={ sin ( 2 * \SemioT ) } ,
        pieces={} , samples=120 , refine=2 , tolerance=0.03 , columns=40 , rows=40 , level=0 ,
        fill=none , baseline=0 , glyphs=0 , domain={-6,6} , range={}
      }
      {#1}
    \str_case:VnF \l_semio_viz_math_mode_tl
      {
        { implicit }
          {
            \semio_viz_sci_window_keys:
            \semio_viz_sci_frame:
            \semio_viz_sci_zero_lines:
            \semio_viz_sci_marching:nnnnn { \l_semio_viz_math_expr_tl }
              { \l_semio_viz_math_cols_int } { \l_semio_viz_math_rows_int }
              { \l_semio_viz_math_level_fp } { semio~sci~curve }
          }
        { piecewise }
          {
            \semio_viz_sci_window_keys:
            \semio_viz_sci_frame:
            \semio_viz_sci_zero_lines:
            \int_zero:N \l_tmpa_int
            \clist_map_inline:Nn \l_semio_viz_math_pieces_clist
              {
                \int_incr:N \l_tmpa_int
                \semio_viz_math_record:n {##1}
                \semio_viz_sci_sample:Nnnnn \l_semio_viz_sci_pts_seq
                  { \semio_viz_math_field:n { 3 } }
                  { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } }
                  { \l_semio_viz_math_samples_int }
                \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq
                  { semio~sci~curve , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
              }
          }
      }
      {
        \semio_viz_math_curve_sample:
        \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.06 }
        \semio_viz_sci_window_keys:
        \semio_viz_sci_frame:
        \semio_viz_sci_zero_lines:
        \semio_viz_math_curve_draw:
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-integral` (§25 area under a curve):
%    expr (l3fp over \SemioX): the integrand. from, to (fp): the interval.
%    bins (int, 10): Riemann partition size. rule (left|right|mid|trapezoid, mid): the sampling rule.
%    bars (bool, true): draw the partition rectangles as well as the shaded area.
\tl_new:N \l_semio_viz_math_rule_tl
\int_new:N \l_semio_viz_math_bins_int
\fp_new:N \l_semio_viz_math_from_fp
\fp_new:N \l_semio_viz_math_to_fp
\bool_new:N \l_semio_viz_math_bars_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-integral }
% 🪣 Binds the `sci-integral` keys to the integrand, interval, bin count and Riemann rule.
\keys_define:nn { semio / viz / family / sci-integral }
  {
    expr    .tl_set:N  = \l_semio_viz_math_expr_tl ,
    from    .fp_set:N  = \l_semio_viz_math_from_fp ,
    to      .fp_set:N  = \l_semio_viz_math_to_fp ,
    bins    .int_set:N = \l_semio_viz_math_bins_int ,
    rule    .tl_set:N  = \l_semio_viz_math_rule_tl ,
    bars    .bool_set:N = \l_semio_viz_math_bars_bool ,
    samples .int_set:N = \l_semio_viz_math_samples_int ,
  }

% 📐 §25 integral area and Riemann partition; the sum itself is reported as a probe value.
\SemioVizFamily { sci-integral }
  {
    \semio_viz_sci_enter:nnn { sci-integral }
      {
        expr={ 0.6 * \SemioX * \SemioX + 1 } , from=0 , to=3 , bins=10 , rule=mid , bars=true ,
        samples=120 , domain={-0.5,3.5} , range={}
      }
      {#1}
    \semio_viz_sci_sample:Nnnnn \l_semio_viz_sci_pts_seq { \l_semio_viz_math_expr_tl }
      { \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } }
      { \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 } }
      { \l_semio_viz_math_samples_int }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.08 }
    \fp_set:Nn \l_semio_viz_sci_dymin_fp { min ( 0 , \l_semio_viz_sci_dymin_fp ) }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_riemann:nnnnnN { \l_semio_viz_math_expr_tl }
      { \l_semio_viz_math_from_fp } { \l_semio_viz_math_to_fp }
      { \l_semio_viz_math_bins_int } { \l_semio_viz_math_rule_tl } \l_semio_viz_sci_pts_b_seq
    \bool_if:NT \l_semio_viz_math_bars_bool { \semio_viz_math_riemann_bars: }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \semio_viz_sci_report_values:nn { integral/sum } { \fp_to_decimal:N \l_semio_viz_sci_riemann_fp }
  }
% 🏗️ Draws one shaded rectangle per Riemann partition point, from the zero line up to its sampled height.
\cs_new_protected:Npn \semio_viz_math_riemann_bars:
  {
    \fp_set:Nn \l_semio_viz_sci_h_step_fp
      { ( \l_semio_viz_math_to_fp - \l_semio_viz_math_from_fp ) / \l_semio_viz_math_bins_int }
    \seq_map_inline:Nn \l_semio_viz_sci_pts_b_seq
      {
        \draw [ semio~sci~band , draw=semio-primary , line~width=\semio@stroke@hairline ]
          ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { 0 } )
          rectangle
          ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} + \l_semio_viz_sci_h_step_fp } ,
            \semio_viz_sci_my:n { \semio_viz_points_y:n {##1} } ) ;
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-approximation` (§25 series approximation):
%    mode (taylor|fourier, taylor): which series. expr (l3fp over \SemioX): the target function.
%    order (int, 5): highest term. centre (fp, 0): Taylor expansion point.
%    period (fp, 6.283185307179586): Fourier fundamental period.
%    partials (bool, true): draw every partial sum, not only the highest.
\int_new:N \l_semio_viz_math_order_int
\fp_new:N \l_semio_viz_math_centre_fp
\fp_new:N \l_semio_viz_math_period_fp
\bool_new:N \l_semio_viz_math_partials_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-approximation }
% 🌊 Binds the `sci-approximation` keys to the series kind, target, order, centre and period.
\keys_define:nn { semio / viz / family / sci-approximation }
  {
    mode     .tl_set:N   = \l_semio_viz_math_mode_tl ,
    expr     .tl_set:N   = \l_semio_viz_math_expr_tl ,
    order    .int_set:N  = \l_semio_viz_math_order_int ,
    centre   .fp_set:N   = \l_semio_viz_math_centre_fp ,
    period   .fp_set:N   = \l_semio_viz_math_period_fp ,
    partials .bool_set:N = \l_semio_viz_math_partials_bool ,
    samples  .int_set:N  = \l_semio_viz_math_samples_int ,
  }

% 🧮 Taylor coefficient a_k = f^(k)(c)/k! by a central finite difference of order k.
\fp_new:N \l_semio_viz_math_coef_fp
\seq_new:N \l_semio_viz_math_coef_seq
\cs_new_protected:Npn \semio_viz_math_taylor_coefficients:
  {
    \seq_clear:N \l_semio_viz_math_coef_seq
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_order_int }
      {
        \fp_zero:N \l_semio_viz_math_coef_fp
        \int_step_inline:nnnn { 0 } { 1 } {##1}
          {
            \fp_set:Nn \SemioX { \l_semio_viz_math_centre_fp + ( ##1 / 2 - ####1 ) * 0.2 }
            \fp_add:Nn \l_semio_viz_math_coef_fp
              {
                ( ####1 - 2 * floor ( ####1 / 2 ) == 0 ? 1 : -1 )
                * exp ( \semio_viz_tr_dist_lgamma:n { ##1 + 1 } - \semio_viz_tr_dist_lgamma:n { ####1 + 1 }
                        - \semio_viz_tr_dist_lgamma:n { ##1 - ####1 + 1 } )
                * ( \l_semio_viz_math_expr_tl )
              }
          }
        \seq_put_right:Nx \l_semio_viz_math_coef_seq
          {
            \fp_to_decimal:n
              { \l_semio_viz_math_coef_fp / ( 0.2 ^ (##1) * exp ( \semio_viz_tr_dist_lgamma:n { ##1 + 1 } ) ) }
          }
      }
  }
% 🧮 Fourier coefficients a_k, b_k of the target on one period, by the trapezoid rule on 240 nodes.
\seq_new:N \l_semio_viz_math_cosa_seq
\seq_new:N \l_semio_viz_math_sinb_seq
\fp_new:N \l_semio_viz_math_acc_fp
\fp_new:N \l_semio_viz_math_accb_fp
\cs_new_protected:Npn \semio_viz_math_fourier_coefficients:
  {
    \seq_clear:N \l_semio_viz_math_cosa_seq
    \seq_clear:N \l_semio_viz_math_sinb_seq
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_order_int }
      {
        \fp_zero:N \l_semio_viz_math_acc_fp
        \fp_zero:N \l_semio_viz_math_accb_fp
        \int_step_inline:nnnn { 0 } { 1 } { 239 }
          {
            \fp_set:Nn \SemioX
              { - \l_semio_viz_math_period_fp / 2 + \l_semio_viz_math_period_fp * ( ####1 + 0.5 ) / 240 }
            \fp_add:Nn \l_semio_viz_math_acc_fp
              { ( \l_semio_viz_math_expr_tl ) * cos ( 2 * pi * ##1 * \SemioX / \l_semio_viz_math_period_fp ) }
            \fp_add:Nn \l_semio_viz_math_accb_fp
              { ( \l_semio_viz_math_expr_tl ) * sin ( 2 * pi * ##1 * \SemioX / \l_semio_viz_math_period_fp ) }
          }
        \seq_put_right:Nx \l_semio_viz_math_cosa_seq
          { \fp_to_decimal:n { 2 * \l_semio_viz_math_acc_fp / 240 } }
        \seq_put_right:Nx \l_semio_viz_math_sinb_seq
          { \fp_to_decimal:n { 2 * \l_semio_viz_math_accb_fp / 240 } }
      }
  }
% ➕ Accumulates the first #2 series terms at each domain sample into the point sequence #1.
\cs_new_protected:Npn \semio_viz_math_series_sample:Nn #1#2
  {
    \seq_clear:N #1
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_samples_int }
      {
        \fp_set:Nn \SemioX
          {
            \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 }
            + ( \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 } - \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } )
              * ##1 / \l_semio_viz_math_samples_int
          }
        \fp_zero:N \l_semio_viz_math_acc_fp
        \int_step_inline:nnnn { 0 } { 1 } {#2} { \semio_viz_math_series_term:n {####1} }
        \semio_viz_points_put:Nnn #1 { \SemioX } { \l_semio_viz_math_acc_fp }
      }
  }
% 🔣 Adds term #1 of the Fourier or Taylor expansion to the running partial sum.
\cs_new_protected:Npn \semio_viz_math_series_term:n #1
  {
    \str_if_eq:VnTF \l_semio_viz_math_mode_tl { fourier }
      {
        \fp_add:Nn \l_semio_viz_math_acc_fp
          {
            ( #1 == 0 ? 0.5 : 1 ) * \seq_item:Nn \l_semio_viz_math_cosa_seq { #1 + 1 }
              * cos ( 2 * pi * #1 * \SemioX / \l_semio_viz_math_period_fp )
            + ( #1 == 0 ? 0 : \seq_item:Nn \l_semio_viz_math_sinb_seq { #1 + 1 }
              * sin ( 2 * pi * #1 * \SemioX / \l_semio_viz_math_period_fp ) )
          }
      }
      {
        \fp_add:Nn \l_semio_viz_math_acc_fp
          { \seq_item:Nn \l_semio_viz_math_coef_seq { #1 + 1 } * ( \SemioX - \l_semio_viz_math_centre_fp ) ^ (#1) }
      }
  }

% 🧮 §25 Taylor and Fourier approximation: the target curve plus each partial sum, coefficients computed in fp.
\SemioVizFamily { sci-approximation }
  {
    \semio_viz_sci_enter:nnn { sci-approximation }
      {
        mode=taylor , expr={ sin ( \SemioX ) } , order=5 , centre=0 ,
        period=6.283185307179586 , partials=true , samples=120 , domain={-3.2,3.2} , range={-1.6,1.6}
      }
      {#1}
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \str_if_eq:VnTF \l_semio_viz_math_mode_tl { fourier }
      { \semio_viz_math_fourier_coefficients: }
      { \semio_viz_math_taylor_coefficients: }
    \semio_viz_sci_sample:Nnnnn \l_semio_viz_sci_pts_seq { \l_semio_viz_math_expr_tl }
      { \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } }
      { \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 } }
      { \l_semio_viz_math_samples_int }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~aux , draw=semio-chrome-foreground }
    \bool_if:NTF \l_semio_viz_math_partials_bool
      {
        \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_order_int }
          {
            \semio_viz_math_series_sample:Nn \l_semio_viz_sci_pts_b_seq {##1}
            \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq
              { semio~sci~curve , draw=\semio_viz_sci_hue:n {##1} }
          }
      }
      {
        \semio_viz_math_series_sample:Nn \l_semio_viz_sci_pts_b_seq { \l_semio_viz_math_order_int }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq { semio~sci~curve }
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-complex` (§25 complex plane):
%    mode (argand|complex-plane|domain-coloring|riemann-surface, argand).
%    values (clist of `re/im/label`): the numbers of an Argand diagram.
%    exprRe, exprIm (l3fp over \SemioX,\SemioY): the mapped function for the other modes.
%    columns, rows (int, 24): raster resolution of the domain colouring. sheets (int, 3): Riemann-surface sheets.
\clist_new:N \l_semio_viz_math_values_clist
\tl_new:N \l_semio_viz_math_exprre_tl
\tl_new:N \l_semio_viz_math_exprim_tl
\int_new:N \l_semio_viz_math_sheets_int
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-complex }
% 🌐 Binds the `sci-complex` keys to the Argand values, the mapped real and imaginary parts and the raster size.
\keys_define:nn { semio / viz / family / sci-complex }
  {
    mode    .tl_set:N    = \l_semio_viz_math_mode_tl ,
    values  .clist_set:N = \l_semio_viz_math_values_clist ,
    exprRe  .tl_set:N    = \l_semio_viz_math_exprre_tl ,
    exprIm  .tl_set:N    = \l_semio_viz_math_exprim_tl ,
    columns .int_set:N   = \l_semio_viz_math_cols_int ,
    rows    .int_set:N   = \l_semio_viz_math_rows_int ,
    sheets  .int_set:N   = \l_semio_viz_math_sheets_int ,
  }

% 🎨 Scans the window on the columns×rows lattice and colours one domain-colouring cell per lattice point.
\cs_new_protected:Npn \semio_viz_math_domain_raster:
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_cols_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_rows_int - 1 }
          {
            \fp_set:Nn \SemioX
              { \l_semio_viz_sci_dxmin_fp + ( \l_semio_viz_sci_dxmax_fp - \l_semio_viz_sci_dxmin_fp )
                * ( ##1 + 0.5 ) / \l_semio_viz_math_cols_int }
            \fp_set:Nn \SemioY
              { \l_semio_viz_sci_dymin_fp + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp )
                * ( ####1 + 0.5 ) / \l_semio_viz_math_rows_int }
            \semio_viz_math_domain_cell:nn {##1} {####1}
          }
      }
  }
% 🌈 Fills lattice cell (#1,#2) with the cyclic ramp colour of the mapped value's argument.
\cs_new_protected:Npn \semio_viz_math_domain_cell:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp { \l_semio_viz_math_exprre_tl }
    \fp_set:Nn \l_semio_viz_sci_b_fp { \l_semio_viz_math_exprim_tl }
    \fp_set:Nn \l_semio_viz_sci_c_fp { atan ( \l_semio_viz_sci_b_fp , \l_semio_viz_sci_a_fp ) }
    \fill [ fill=\semio_viz_sci_ramp_cyclic:n { \l_semio_viz_sci_c_fp } ]
      ( \fp_eval:n { \l_semio_viz_sci_w_fp * #1 / \l_semio_viz_math_cols_int } ,
        \fp_eval:n { \l_semio_viz_sci_h_fp * #2 / \l_semio_viz_math_rows_int } )
      rectangle
      ( \fp_eval:n { \l_semio_viz_sci_w_fp * ( #1 + 1 ) / \l_semio_viz_math_cols_int } ,
        \fp_eval:n { \l_semio_viz_sci_h_fp * ( #2 + 1 ) / \l_semio_viz_math_rows_int } ) ;
    \semio_viz_sci_report_values:nn { complex/cell }
      { \fp_to_decimal:N \SemioX , \fp_to_decimal:N \SemioY , \fp_to_decimal:N \l_semio_viz_sci_c_fp }
  }

% 🧮 §25 complex plane: Argand vectors, an image grid of a conformal map, domain colouring or stacked Riemann sheets.
\SemioVizFamily { sci-complex }
  {
    \semio_viz_sci_enter:nnn { sci-complex }
      {
        mode=argand , values={ 1/0.6/z , -0.8/1.1/w , 0.2/-1.3/u } ,
        exprRe={ \SemioX * \SemioX - \SemioY * \SemioY } , exprIm={ 2 * \SemioX * \SemioY } ,
        columns=24 , rows=24 , sheets=3 , domain={-1.5,1.5} , range={-1.5,1.5}
      }
      {#1}
    \semio_viz_sci_window_keys:
    \str_case:VnF \l_semio_viz_math_mode_tl
      {
        { domain-coloring }
          { \semio_viz_math_domain_raster: \semio_viz_sci_frame: }
        { complex-plane }
          {
            \semio_viz_sci_frame:
            \semio_viz_sci_zero_lines:
            \semio_viz_math_conformal_grid:
          }
        { riemann-surface }
          {
            \semio_viz_sci_frame:
            \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_sheets_int }
              {
                \semio_viz_math_param_sample:nn
                  { ( 0.2 + 0.9 * \SemioT / ( 2 * pi ) ) * cos ( \SemioT + 2 * pi * ##1 / \l_semio_viz_math_sheets_int ) }
                  { 0.45 * ( 0.2 + 0.9 * \SemioT / ( 2 * pi ) ) * sin ( \SemioT + 2 * pi * ##1 / \l_semio_viz_math_sheets_int )
                    + 0.28 * ( ##1 - ( \l_semio_viz_math_sheets_int + 1 ) / 2 ) }
                \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq
                  { semio~sci~curve , draw=\semio_viz_sci_hue:n {##1} }
              }
          }
      }
      {
        \semio_viz_sci_frame:
        \semio_viz_sci_zero_lines:
        \clist_map_inline:Nn \l_semio_viz_math_values_clist
          {
            \semio_viz_math_record:n {##1}
            \semio_viz_sci_arrow:nnnnn { 0 } { 0 }
              { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } } { semio~sci~vector }
            \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=south~west ]
              at ( \semio_viz_sci_mx:n { \semio_viz_math_field:n { 1 } } ,
                   \semio_viz_sci_my:n { \semio_viz_math_field:n { 2 } } )
              { \semio_viz_math_field:n { 3 } } ;
          }
      }
  }
% 🕸️ Pushes nine vertical and nine horizontal domain lines through the map and draws their images.
\cs_new_protected:Npn \semio_viz_math_conformal_grid:
  {
    \int_set:Nn \l_semio_viz_math_samples_int { 60 }
    \int_step_inline:nnnn { 0 } { 1 } { 8 }
      {
        \seq_clear:N \l_semio_viz_sci_pts_b_seq
        \int_step_inline:nnnn { 0 } { 1 } { 40 }
          {
            \fp_set:Nn \SemioX
              { \l_semio_viz_sci_dxmin_fp + ( \l_semio_viz_sci_dxmax_fp - \l_semio_viz_sci_dxmin_fp ) * ##1 / 8 }
            \fp_set:Nn \SemioY
              { \l_semio_viz_sci_dymin_fp + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp ) * ####1 / 40 }
            \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq
              { \l_semio_viz_math_exprre_tl } { \l_semio_viz_math_exprim_tl }
          }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq { semio~sci~thin , draw=semio-primary }
        \seq_clear:N \l_semio_viz_sci_pts_c_seq
        \int_step_inline:nnnn { 0 } { 1 } { 40 }
          {
            \fp_set:Nn \SemioY
              { \l_semio_viz_sci_dymin_fp + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp ) * ##1 / 8 }
            \fp_set:Nn \SemioX
              { \l_semio_viz_sci_dxmin_fp + ( \l_semio_viz_sci_dxmax_fp - \l_semio_viz_sci_dxmin_fp ) * ####1 / 40 }
            \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_c_seq
              { \l_semio_viz_math_exprre_tl } { \l_semio_viz_math_exprim_tl }
          }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_c_seq { semio~sci~thin , draw=semio-secondary }
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-iteration` (§25 discrete dynamics):
%    mode (sequence|recurrence|cobweb|bifurcation, sequence).
%    expr (l3fp over \SemioX): the map x_{n+1} = f(x_n); for `sequence` a formula in the index \SemioT.
%    start (fp, 0.2): the initial value. steps (int, 40): iterations.
%    parameter (fp, 3.2): the map parameter, available as \SemioY.
%    from, to (fp, 2.5/4): the bifurcation parameter sweep. columns (int, 120): sweep resolution.
%    settle (int, 120), keep (int, 60): bifurcation transient and plotted tail.
\fp_new:N \l_semio_viz_math_start_fp
\fp_new:N \l_semio_viz_math_param_fp
\int_new:N \l_semio_viz_math_steps_int
\int_new:N \l_semio_viz_math_settle_int
\int_new:N \l_semio_viz_math_keep_int
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-iteration }
% 🔂 Binds the `sci-iteration` keys to the map, its start value, parameter and bifurcation sweep budget.
\keys_define:nn { semio / viz / family / sci-iteration }
  {
    mode      .tl_set:N  = \l_semio_viz_math_mode_tl ,
    expr      .tl_set:N  = \l_semio_viz_math_expr_tl ,
    start     .fp_set:N  = \l_semio_viz_math_start_fp ,
    steps     .int_set:N = \l_semio_viz_math_steps_int ,
    parameter .fp_set:N  = \l_semio_viz_math_param_fp ,
    from      .fp_set:N  = \l_semio_viz_math_from_fp ,
    to        .fp_set:N  = \l_semio_viz_math_to_fp ,
    columns   .int_set:N = \l_semio_viz_math_cols_int ,
    settle    .int_set:N = \l_semio_viz_math_settle_int ,
    keep      .int_set:N = \l_semio_viz_math_keep_int ,
    samples   .int_set:N = \l_semio_viz_math_samples_int ,
  }

% 🛰️ Iterates the map from the start value and stores every step as an (index, value) point.
\cs_new_protected:Npn \semio_viz_math_orbit:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \fp_set:Nn \SemioX { \l_semio_viz_math_start_fp }
    \fp_set:Nn \SemioY { \l_semio_viz_math_param_fp }
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_steps_int }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq {##1} { \SemioX }
        \fp_set:Nn \SemioX { \l_semio_viz_math_expr_tl }
      }
  }
% 🕷️ Builds the cobweb staircase, alternating a hop up to the curve with a hop across to the diagonal.
\cs_new_protected:Npn \semio_viz_math_cobweb:
  {
    \seq_clear:N \l_semio_viz_sci_pts_b_seq
    \fp_set:Nn \SemioX { \l_semio_viz_math_start_fp }
    \fp_set:Nn \SemioY { \l_semio_viz_math_param_fp }
    \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \SemioX } { 0 }
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_steps_int }
      {
        \fp_set:Nn \l_semio_viz_sci_a_fp { \l_semio_viz_math_expr_tl }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \SemioX } { \l_semio_viz_sci_a_fp }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \l_semio_viz_sci_a_fp } { \l_semio_viz_sci_a_fp }
        \fp_set_eq:NN \SemioX \l_semio_viz_sci_a_fp
      }
  }
% 🌿 Sweeps the parameter across the columns, discards the settle transient and dots the retained tail.
\cs_new_protected:Npn \semio_viz_math_bifurcation:
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_cols_int }
      {
        \fp_set:Nn \SemioY
          { \l_semio_viz_math_from_fp
            + ( \l_semio_viz_math_to_fp - \l_semio_viz_math_from_fp ) * ##1 / \l_semio_viz_math_cols_int }
        \fp_set:Nn \SemioX { \l_semio_viz_math_start_fp }
        \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_settle_int }
          { \fp_set:Nn \SemioX { \l_semio_viz_math_expr_tl } }
        \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_keep_int }
          {
            \fp_set:Nn \SemioX { \l_semio_viz_math_expr_tl }
            \fill [ fill=semio-primary , fill~opacity=0.55 ]
              ( \semio_viz_sci_mx:n { \SemioY } , \semio_viz_sci_my:n { \SemioX } ) circle [ radius=0.09 ] ;
          }
      }
  }

% 🔁 §25 discrete dynamics: index plots, cobweb staircases and the bifurcation cascade of a parameterised map.
\SemioVizFamily { sci-iteration }
  {
    \semio_viz_sci_enter:nnn { sci-iteration }
      {
        mode=sequence , expr={ \SemioY * \SemioX * ( 1 - \SemioX ) } , start=0.2 , steps=40 ,
        parameter=3.2 , from=2.5 , to=4 , columns=120 , settle=120 , keep=60 , samples=120 ,
        domain={} , range={}
      }
      {#1}
    \str_case:VnF \l_semio_viz_math_mode_tl
      {
        { bifurcation }
          {
            \semio_viz_sci_window:nnnn
              { \l_semio_viz_math_from_fp } { \l_semio_viz_math_to_fp } { 0 } { 1 }
            \semio_viz_sci_window_keys:
            \semio_viz_sci_frame:
            \semio_viz_math_bifurcation:
          }
        { cobweb }
          {
            \semio_viz_math_cobweb:
            \semio_viz_sci_window:nnnn { 0 } { 1 } { 0 } { 1 }
            \semio_viz_sci_window_keys:
            \semio_viz_sci_frame:
            \fp_set:Nn \SemioY { \l_semio_viz_math_param_fp }
            \semio_viz_sci_sample:Nnnnn \l_semio_viz_sci_pts_seq { \l_semio_viz_math_expr_tl } { 0 } { 1 }
              { \l_semio_viz_math_samples_int }
            \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
            \draw [ semio~sci~aux ] ( 0 , 0 ) -- ( \fp_eval:n { \l_semio_viz_sci_w_fp } , \fp_eval:n { \l_semio_viz_sci_h_fp } ) ;
            \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq { semio~sci~thin , draw=semio-secondary }
          }
        { recurrence }
          {
            \semio_viz_math_orbit:
            \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.08 }
            \semio_viz_sci_window_keys:
            \semio_viz_sci_frame:
            \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
            \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
              { \semio_viz_sci_dot:nnn { \semio_viz_points_x:n {##1} } { \semio_viz_points_y:n {##1} } { semio-primary } }
          }
      }
      {
        \semio_viz_math_orbit:
        \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.08 }
        \semio_viz_sci_window_keys:
        \semio_viz_sci_frame:
        \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
          {
            \draw [ semio~sci~thin , draw=semio-primary ]
              ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { 0 } ) --
              ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { \semio_viz_points_y:n {##1} } ) ;
            \semio_viz_sci_dot:nnn { \semio_viz_points_x:n {##1} } { \semio_viz_points_y:n {##1} } { semio-primary }
          }
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-dynamics` (§25 continuous dynamics):
%    mode (direction-field|phase-portrait|nullcline|phase-space|stability, direction-field).
%    u, v (l3fp over \SemioX,\SemioY): the vector field. columns, rows (int, 13/11): glyph lattice.
%    seeds (clist of `x/y`): trajectory start points. steps (int, 200), step (fp, 0.05): integration budget.
%    scale (fp, 1): glyph length factor. normalize (bool, true): unit-length direction glyphs.
\clist_new:N \l_semio_viz_math_seeds_clist
\tl_new:N \l_semio_viz_math_u_tl
\tl_new:N \l_semio_viz_math_v_tl
\fp_new:N \l_semio_viz_math_step_fp
\fp_new:N \l_semio_viz_math_scale_fp
\bool_new:N \l_semio_viz_math_norm_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-dynamics }
% 🧭 Binds the `sci-dynamics` keys to the u and v field components, the glyph lattice, the seeds and the integration budget.
\keys_define:nn { semio / viz / family / sci-dynamics }
  {
    mode      .tl_set:N    = \l_semio_viz_math_mode_tl ,
    u         .tl_set:N    = \l_semio_viz_math_u_tl ,
    v         .tl_set:N    = \l_semio_viz_math_v_tl ,
    columns   .int_set:N   = \l_semio_viz_math_cols_int ,
    rows      .int_set:N   = \l_semio_viz_math_rows_int ,
    seeds     .clist_set:N = \l_semio_viz_math_seeds_clist ,
    steps     .int_set:N   = \l_semio_viz_math_steps_int ,
    step      .fp_set:N    = \l_semio_viz_math_step_fp ,
    scale     .fp_set:N    = \l_semio_viz_math_scale_fp ,
    normalize .bool_set:N  = \l_semio_viz_math_norm_bool ,
  }

% 🗺️ Places one field glyph at the centre of every cell of the columns×rows lattice.
\cs_new_protected:Npn \semio_viz_math_field_glyphs:
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_cols_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_rows_int - 1 }
          {
            \fp_set:Nn \SemioX
              { \l_semio_viz_sci_dxmin_fp + ( \l_semio_viz_sci_dxmax_fp - \l_semio_viz_sci_dxmin_fp )
                * ( ##1 + 0.5 ) / \l_semio_viz_math_cols_int }
            \fp_set:Nn \SemioY
              { \l_semio_viz_sci_dymin_fp + ( \l_semio_viz_sci_dymax_fp - \l_semio_viz_sci_dymin_fp )
                * ( ####1 + 0.5 ) / \l_semio_viz_math_rows_int }
            \semio_viz_math_field_glyph:
          }
      }
  }
% ➡️ Draws one field arrow at the current point, ramp-coloured by speed and optionally length-normalised.
\cs_new_protected:Npn \semio_viz_math_field_glyph:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp { \l_semio_viz_math_u_tl }
    \fp_set:Nn \l_semio_viz_sci_b_fp { \l_semio_viz_math_v_tl }
    \fp_set:Nn \l_semio_viz_sci_c_fp { max ( 1e-6 , sqrt ( \l_semio_viz_sci_a_fp ^ 2 + \l_semio_viz_sci_b_fp ^ 2 ) ) }
    \bool_if:NTF \l_semio_viz_math_norm_bool
      { \fp_set:Nn \l_semio_viz_sci_d_fp { \l_semio_viz_math_scale_fp * \l_semio_viz_sci_w_fp
          / ( 1.8 * \l_semio_viz_math_cols_int * \l_semio_viz_sci_c_fp ) } }
      { \fp_set:Nn \l_semio_viz_sci_d_fp { \l_semio_viz_math_scale_fp * \l_semio_viz_sci_w_fp
          / ( 1.8 * \l_semio_viz_math_cols_int ) } }
    \draw [ semio~sci~vector , draw=\semio_viz_sci_ramp:n { \l_semio_viz_sci_c_fp / ( 1 + \l_semio_viz_sci_c_fp ) } ]
      ( \semio_viz_sci_mx:n { \SemioX } , \semio_viz_sci_my:n { \SemioY } ) --
      ++ ( \fp_eval:n { \l_semio_viz_sci_d_fp * \l_semio_viz_sci_a_fp } ,
           \fp_eval:n { \l_semio_viz_sci_d_fp * \l_semio_viz_sci_b_fp } ) ;
    \semio_viz_sci_report_values:nn { dynamics/glyph }
      { \fp_to_decimal:N \SemioX , \fp_to_decimal:N \SemioY ,
        \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp }
  }
% 🛤️ Integrates one Runge–Kutta trajectory per seed point and draws each in its own hue.
\cs_new_protected:Npn \semio_viz_math_trajectories:
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_math_seeds_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_math_record:n {##1}
        \semio_viz_sci_rkfour:nnnnnnN { \l_semio_viz_math_u_tl } { \l_semio_viz_math_v_tl }
          { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } }
          { \l_semio_viz_math_step_fp } { \l_semio_viz_math_steps_int } \l_semio_viz_sci_pts_b_seq
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq
          { semio~sci~curve , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
      }
  }

% 🌀 §25 continuous dynamics: slope and direction fields, nullclines, phase portraits and the trace–determinant stability plane.
\SemioVizFamily { sci-dynamics }
  {
    \semio_viz_sci_enter:nnn { sci-dynamics }
      {
        mode=direction-field , u={ \SemioY } , v={ - \SemioX - 0.3 * \SemioY } ,
        columns=13 , rows=11 , seeds={ 1.6/0/ , -1.6/0/ , 0/1.6/ } , steps=200 , step=0.05 ,
        scale=1 , normalize=true , domain={-2,2} , range={-2,2} , grid=false
      }
      {#1}
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \str_case:VnF \l_semio_viz_math_mode_tl
      {
        { phase-portrait } { \semio_viz_math_field_glyphs: \semio_viz_math_trajectories: }
        { phase-space }    { \semio_viz_math_trajectories: }
        { nullcline }
          {
            \semio_viz_sci_marching:nnnnn { \l_semio_viz_math_u_tl } { 36 } { 36 } { 0 }
              { semio~sci~curve }
            \semio_viz_sci_marching:nnnnn { \l_semio_viz_math_v_tl } { 36 } { 36 } { 0 }
              { semio~sci~curve~alt }
          }
        { stability }
          {
            \semio_viz_sci_marching:nnnnn { \SemioX * \SemioX - 4 * \SemioY } { 48 } { 48 } { 0 }
              { semio~sci~curve }
            \semio_viz_sci_marching:nnnnn { \SemioY } { 48 } { 48 } { 0 } { semio~sci~curve~alt }
            \semio_viz_sci_marching:nnnnn { \SemioX } { 48 } { 48 } { 0 } { semio~sci~aux }
          }
      }
      { \semio_viz_math_field_glyphs: }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-distribution` (§25/§41 laws):
%    law (normal|exponential|uniform|beta|binomial|poisson, normal).
%    curve (pdf|cdf|survival|hazard|quantile, pdf): which function of the law is drawn.
%    p1, p2 (fp, 0/1): the two law parameters. discrete (bool, false): draw stems instead of a curve.
%    samples (int, 120): resolution. shade (clist of 2): a shaded sub-interval of the density.
\tl_new:N \l_semio_viz_math_law_tl
\tl_new:N \l_semio_viz_math_curve_tl
\fp_new:N \l_semio_viz_math_pa_fp
\fp_new:N \l_semio_viz_math_pb_fp
\bool_new:N \l_semio_viz_math_discrete_bool
\clist_new:N \l_semio_viz_math_shade_clist
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-distribution }
% 🔔 Binds the `sci-distribution` keys to the law, the drawn function, its two parameters and the shaded interval.
\keys_define:nn { semio / viz / family / sci-distribution }
  {
    law      .tl_set:N    = \l_semio_viz_math_law_tl ,
    curve    .tl_set:N    = \l_semio_viz_math_curve_tl ,
    p1       .fp_set:N    = \l_semio_viz_math_pa_fp ,
    p2       .fp_set:N    = \l_semio_viz_math_pb_fp ,
    discrete .bool_set:N  = \l_semio_viz_math_discrete_bool ,
    samples  .int_set:N   = \l_semio_viz_math_samples_int ,
    shade    .clist_set:N = \l_semio_viz_math_shade_clist ,
  }

% 🧪 Evaluates the selected density, distribution, survival, hazard or quantile function at #1 into #2.
\cs_new_protected:Npn \semio_viz_math_law_value:nN #1#2
  {
    \str_case:VnF \l_semio_viz_math_curve_tl
      {
        { pdf } { \semio_viz_tr_dist_pdf:VnnnN \l_semio_viz_math_law_tl
            { \l_semio_viz_math_pa_fp } { \l_semio_viz_math_pb_fp } {#1} #2 }
        { cdf } { \semio_viz_tr_dist_cdf:VnnnN \l_semio_viz_math_law_tl
            { \l_semio_viz_math_pa_fp } { \l_semio_viz_math_pb_fp } {#1} #2 }
        { survival }
          {
            \semio_viz_tr_dist_cdf:VnnnN \l_semio_viz_math_law_tl
              { \l_semio_viz_math_pa_fp } { \l_semio_viz_math_pb_fp } {#1} #2
            \fp_set:Nn #2 { 1 - #2 }
          }
        { hazard }
          {
            \semio_viz_tr_dist_pdf:VnnnN \l_semio_viz_math_law_tl
              { \l_semio_viz_math_pa_fp } { \l_semio_viz_math_pb_fp } {#1} \l_semio_viz_sci_e_fp
            \semio_viz_tr_dist_cdf:VnnnN \l_semio_viz_math_law_tl
              { \l_semio_viz_math_pa_fp } { \l_semio_viz_math_pb_fp } {#1} \l_semio_viz_sci_f_fp
            \fp_set:Nn #2 { \l_semio_viz_sci_e_fp / max ( 1e-9 , 1 - \l_semio_viz_sci_f_fp ) }
          }
        { quantile }
          {
            \semio_viz_tr_dist_quantile:VnnnnnN \l_semio_viz_math_law_tl
              { \l_semio_viz_math_pa_fp } { \l_semio_viz_math_pb_fp } { min ( 0.999 , max ( 0.001 , #1 ) ) }
              { \l_semio_viz_sci_dymin_fp } { \l_semio_viz_sci_dymax_fp } #2
          }
      }
      { \fp_zero:N #2 }
  }
% 📶 Samples the chosen law function uniformly across the window into the point sequence.
\cs_new_protected:Npn \semio_viz_math_law_sample:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_samples_int }
      {
        \fp_set:Nn \l_semio_viz_sci_g_fp
          {
            \l_semio_viz_sci_dxmin_fp
            + ( \l_semio_viz_sci_dxmax_fp - \l_semio_viz_sci_dxmin_fp ) * ##1 / \l_semio_viz_math_samples_int
          }
        \semio_viz_math_law_value:nN { \l_semio_viz_sci_g_fp } \l_semio_viz_sci_a_fp
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \l_semio_viz_sci_g_fp } { \l_semio_viz_sci_a_fp }
      }
  }
% 🪵 Evaluates the law at every integer inside the window, for the discrete stem rendering.
\cs_new_protected:Npn \semio_viz_math_law_stems:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { \fp_to_int:n { ceil ( \l_semio_viz_sci_dxmin_fp ) } } { 1 }
      { \fp_to_int:n { floor ( \l_semio_viz_sci_dxmax_fp ) } }
      {
        \semio_viz_math_law_value:nN {##1} \l_semio_viz_sci_a_fp
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq {##1} { \l_semio_viz_sci_a_fp }
      }
  }

% 🎲 §25/§41 laws: density, mass, distribution, survival, hazard and quantile functions of the common families.
\SemioVizFamily { sci-distribution }
  {
    \semio_viz_sci_enter:nnn { sci-distribution }
      {
        law=normal , curve=pdf , p1=0 , p2=1 , discrete=false , samples=120 , shade={} ,
        domain={-4,4} , range={}
      }
      {#1}
    \semio_viz_sci_window_keys:
    \bool_if:NTF \l_semio_viz_math_discrete_bool
      { \semio_viz_math_law_stems: }
      { \semio_viz_math_law_sample: }
    \semio_viz_sci_extent:N \l_semio_viz_sci_pts_seq
    \fp_set:Nn \l_semio_viz_sci_dymin_fp { min ( 0 , \l_semio_viz_sci_ymin_fp ) }
    \fp_set:Nn \l_semio_viz_sci_dymax_fp { \l_semio_viz_sci_ymax_fp * 1.12 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \int_compare:nNnT { \clist_count:N \l_semio_viz_math_shade_clist } = { 2 }
      { \semio_viz_math_law_shade: }
    \bool_if:NTF \l_semio_viz_math_discrete_bool
      {
        \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
          {
            \draw [ semio~sci~curve ]
              ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { 0 } ) --
              ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { \semio_viz_points_y:n {##1} } ) ;
            \semio_viz_sci_dot:nnn { \semio_viz_points_x:n {##1} } { \semio_viz_points_y:n {##1} } { semio-primary }
          }
        \semio_viz_sci_report:Nn \l_semio_viz_sci_pts_seq { stem }
      }
      { \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve } }
  }
% 🖍️ Shades the sampled curve between the two x bounds given by the shade key.
\cs_new_protected:Npn \semio_viz_math_law_shade:
  {
    \seq_clear:N \l_semio_viz_sci_pts_b_seq
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      {
        \fp_compare:nT
          {
            \semio_viz_points_x:n {##1} >= \clist_item:Nn \l_semio_viz_math_shade_clist { 1 } &&
            \semio_viz_points_x:n {##1} <= \clist_item:Nn \l_semio_viz_math_shade_clist { 2 }
          }
          { \seq_put_right:Nn \l_semio_viz_sci_pts_b_seq {##1} }
      }
    \semio_viz_sci_polyarea:Nnn \l_semio_viz_sci_pts_b_seq { semio~sci~band } { 0 }
  }

