% 🌳 §41 probability tree: every branch drawn from its depth, sibling index and parent, with its probability on the edge.
\SemioVizFamily { sci-probability-tree }
  {
    \semio_viz_sci_enter:nnn { sci-probability-tree }
      {
        branches={ 1/1/0/0.6/A , 1/2/0/0.4/B , 2/1/1/0.7/AA , 2/2/1/0.3/AB , 2/3/2/0.5/BA , 2/4/2/0.5/BB } ,
        levelWidth=22 , levelGap=9 , showProbabilities=true , axes=false , grid=false
      }
      {#1}
    \prop_clear:N \l_semio_viz_math_nodex_prop
    \prop_clear:N \l_semio_viz_math_nodey_prop
    \clist_map_inline:Nn \l_semio_viz_math_branches_clist
      {
        \semio_viz_math_record:n {##1}
        \prop_put:Nxx \l_semio_viz_math_nodex_prop
          { \semio_viz_math_field:n { 1 } - \semio_viz_math_field:n { 2 } }
          { \fp_to_decimal:n { \l_semio_viz_math_levelw_fp * \semio_viz_math_field:n { 1 } } }
        \prop_put:Nxx \l_semio_viz_math_nodey_prop
          { \semio_viz_math_field:n { 1 } - \semio_viz_math_field:n { 2 } }
          {
            \fp_to_decimal:n
              { \l_semio_viz_math_levelgap_fp
                * ( \semio_viz_math_field:n { 2 } - ( 1 + \semio_viz_math_level_count:n { \semio_viz_math_field:n { 1 } } ) / 2 )
                * 3 / ( 1 + \semio_viz_math_field:n { 1 } ) }
          }
      }
    \prop_put:Nnn \l_semio_viz_math_nodex_prop { 0-0 } { 0 }
    \prop_put:Nnn \l_semio_viz_math_nodey_prop { 0-0 } { 0 }
    \clist_map_inline:Nn \l_semio_viz_math_branches_clist
      {
        \semio_viz_math_record:n {##1}
        \semio_viz_math_branch_draw:
      }
  }
% 🧷 Reports 2^#1, the number of siblings a binary tree carries at depth #1.
\cs_new:Npn \semio_viz_math_level_count:n #1
  { \fp_eval:n { 2 ^ (#1) } }
% 🍃 Draws the arrow from the parent node to the current branch, its probability on the edge and its label at the tip.
\cs_new_protected:Npn \semio_viz_math_branch_draw:
  {
    \tl_set:Nx \l_tmpa_tl
      {
        \int_eval:n { \semio_viz_math_field:n { 1 } - 1 } -
        \semio_viz_math_field:n { 3 }
      }
    \tl_set:Nx \l_tmpb_tl { \semio_viz_math_field:n { 1 } - \semio_viz_math_field:n { 2 } }
    \use:x
      {
        \exp_not:N \draw [ semio~sci~arrow ]
          ( \prop_item:NV \l_semio_viz_math_nodex_prop \l_tmpa_tl ,
            \prop_item:NV \l_semio_viz_math_nodey_prop \l_tmpa_tl ) --
          node [ font=\exp_not:N \c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal ,
                 fill=semio-chrome-base , inner~sep=0.3mm , sloped ]
            { \bool_if:NT \l_semio_viz_math_showprob_bool { \semio_viz_math_field:n { 4 } } }
          ( \prop_item:NV \l_semio_viz_math_nodex_prop \l_tmpb_tl ,
            \prop_item:NV \l_semio_viz_math_nodey_prop \l_tmpb_tl ) ;
      }
    \use:x
      {
        \exp_not:N \node [ font=\exp_not:N \c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground ,
                           anchor=west , inner~sep=0.8mm ]
          at ( \prop_item:NV \l_semio_viz_math_nodex_prop \l_tmpb_tl ,
               \prop_item:NV \l_semio_viz_math_nodey_prop \l_tmpb_tl )
          { \semio_viz_math_field:n { 5 } } ;
      }
    \semio_viz_sci_report_values:nn { tree/branch }
      { \semio_viz_math_field:n { 1 } , \semio_viz_math_field:n { 2 } , \semio_viz_math_field:n { 4 } }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-stochastic` (§41 sample paths):
%    mode (random-walk|brownian|monte-carlo, random-walk).
%    paths (int, 4), steps (int, 120): how many sample paths of what length.
%    drift (fp, 0), volatility (fp, 1): the increment law. samples (int, 300): Monte-Carlo point count.
%    accept (l3fp over \SemioX,\SemioY): the Monte-Carlo acceptance region.
\int_new:N \l_semio_viz_math_paths_int
\fp_new:N \l_semio_viz_math_drift_fp
\fp_new:N \l_semio_viz_math_vol_fp
\tl_new:N \l_semio_viz_math_accept_tl
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-stochastic }
% 🌪️ Binds the `sci-stochastic` keys to the path count and length, the drift and volatility and the acceptance region.
\keys_define:nn { semio / viz / family / sci-stochastic }
  {
    mode       .tl_set:N  = \l_semio_viz_math_mode_tl ,
    paths      .int_set:N = \l_semio_viz_math_paths_int ,
    steps      .int_set:N = \l_semio_viz_math_steps_int ,
    drift      .fp_set:N  = \l_semio_viz_math_drift_fp ,
    volatility .fp_set:N  = \l_semio_viz_math_vol_fp ,
    samples    .int_set:N = \l_semio_viz_math_samples_int ,
    accept     .tl_set:N  = \l_semio_viz_math_accept_tl ,
  }

% 🎰 §41 sample paths: seeded random walks, Brownian paths and Monte-Carlo acceptance scatter — reproducible, never `\pdfuniformdeviate`.
\SemioVizFamily { sci-stochastic }
  {
    \semio_viz_sci_enter:nnn { sci-stochastic }
      {
        mode=random-walk , paths=4 , steps=120 , drift=0 , volatility=1 , samples=300 ,
        accept={ \SemioX * \SemioX + \SemioY * \SemioY - 1 } , domain={0,120} , range={-20,20}
      }
      {#1}
    \str_if_eq:VnTF \l_semio_viz_math_mode_tl { monte-carlo }
      {
        \semio_viz_sci_window:nnnn { -1 } { 1 } { -1 } { 1 }
        \semio_viz_sci_window_keys:
        \semio_viz_sci_frame:
        \semio_viz_sci_marching:nnnnn { \l_semio_viz_math_accept_tl } { 40 } { 40 } { 0 } { semio~sci~curve }
        \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_samples_int }
          {
            \semio_viz_sci_random:N \l_semio_viz_sci_e_fp
            \semio_viz_sci_random:N \l_semio_viz_sci_f_fp
            \fp_set:Nn \SemioX { 2 * \l_semio_viz_sci_e_fp - 1 }
            \fp_set:Nn \SemioY { 2 * \l_semio_viz_sci_f_fp - 1 }
            \fp_compare:nNnTF { \l_semio_viz_math_accept_tl } < { 0 }
              { \semio_viz_sci_dot:nnn { \SemioX } { \SemioY } { semio-primary } }
              { \semio_viz_sci_dot:nnn { \SemioX } { \SemioY } { semio-chrome-border-normal } }
          }
      }
      {
        \semio_viz_sci_window_keys:
        \semio_viz_sci_frame:
        \semio_viz_sci_zero_lines:
        \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_paths_int }
          {
            \semio_viz_math_walk:
            \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq
              { semio~sci~thin , draw=\semio_viz_sci_hue:n {##1} }
          }
      }
  }
% 👣 Accumulates one sample path, adding a normal increment in brownian mode and a ±1 jump otherwise.
\cs_new_protected:Npn \semio_viz_math_walk:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \fp_zero:N \l_semio_viz_sci_a_fp
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_math_steps_int }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq {##1} { \l_semio_viz_sci_a_fp }
        \str_if_eq:VnTF \l_semio_viz_math_mode_tl { brownian }
          {
            \semio_viz_sci_random_normal:N \l_semio_viz_sci_b_fp
            \fp_add:Nn \l_semio_viz_sci_a_fp
              { \l_semio_viz_math_drift_fp + \l_semio_viz_math_vol_fp * \l_semio_viz_sci_b_fp }
          }
          {
            \semio_viz_sci_random:N \l_semio_viz_sci_b_fp
            \fp_add:Nn \l_semio_viz_sci_a_fp
              { \l_semio_viz_math_drift_fp
                + \l_semio_viz_math_vol_fp * ( \l_semio_viz_sci_b_fp < 0.5 ? -1 : 1 ) }
          }
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-simplex` (§41 compositional space):
%    points (clist of `a/b/c/label`): barycentric compositions, normalised before plotting.
%    side (fp, 44): triangle side length in millimetres. gridLines (int, 4): interior guide count.
\int_new:N \l_semio_viz_math_gridlines_int
\fp_new:N \l_semio_viz_math_side_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-simplex }
% ⛰️ Binds the `sci-simplex` keys to the barycentric compositions, the triangle side and the guide count.
\keys_define:nn { semio / viz / family / sci-simplex }
