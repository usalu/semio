% 🪟 Clips the window rectangle successively by every half-plane constraint and shades the polygon that survives.
\cs_new_protected:Npn \semio_viz_math_feasible:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \l_semio_viz_sci_dxmin_fp } { \l_semio_viz_sci_dymin_fp }
    \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \l_semio_viz_sci_dxmax_fp } { \l_semio_viz_sci_dymin_fp }
    \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \l_semio_viz_sci_dxmax_fp } { \l_semio_viz_sci_dymax_fp }
    \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \l_semio_viz_sci_dxmin_fp } { \l_semio_viz_sci_dymax_fp }
    \clist_map_inline:Nn \l_semio_viz_math_constraints_clist
      {
        \semio_viz_math_record:n {##1}
        \semio_viz_spatial_clip:NNnnn \l_semio_viz_sci_pts_seq \l_semio_viz_sci_pts_b_seq
          { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } } { \semio_viz_math_field:n { 3 } }
        \seq_set_eq:NN \l_semio_viz_sci_pts_seq \l_semio_viz_sci_pts_b_seq
      }
    \int_compare:nNnT { \seq_count:N \l_semio_viz_sci_pts_seq } > { 2 }
      {
        \seq_put_right:Nx \l_semio_viz_sci_pts_seq { \seq_item:Nn \l_semio_viz_sci_pts_seq { 1 } }
        \semio_viz_sci_polyarea:Nnn \l_semio_viz_sci_pts_seq { semio~sci~band } { \l_semio_viz_sci_dymin_fp }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
      }
  }
% 📏 Traces each constraint boundary as a marching-squares level line in its own hue.
\cs_new_protected:Npn \semio_viz_math_constraint_lines:
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_math_constraints_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_math_record:n {##1}
        \semio_viz_sci_marching:nnnnn
          { \semio_viz_math_field:n { 1 } * \SemioX + \semio_viz_math_field:n { 2 } * \SemioY }
          { 24 } { 24 } { \semio_viz_math_field:n { 3 } }
          { semio~sci~aux , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
      }
  }
% 🗻 Traces evenly spaced level lines of the linear objective across the window.
\cs_new_protected:Npn \semio_viz_math_contours:
  {
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_math_levels_int }
      {
        \semio_viz_sci_marching:nnnnn
          { \clist_item:Nn \l_semio_viz_math_objective_clist { 1 } * \SemioX
            + \clist_item:Nn \l_semio_viz_math_objective_clist { 2 } * \SemioY }
          { 30 } { 30 }
          { \fp_eval:n { 2 * ##1 } }
          { semio~sci~thin , draw=semio-secondary }
      }
  }
% 🏅 Dots every candidate, keeps the non-dominated ones and joins them into the Pareto frontier.
\cs_new_protected:Npn \semio_viz_math_pareto:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \clist_map_inline:Nn \l_semio_viz_math_points_clist
      {
        \semio_viz_math_record:n {##1}
        \semio_viz_sci_dot:nnn { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } }
          { semio-chrome-border-normal }
        \semio_viz_math_pareto_test:nn { \semio_viz_math_field:n { 1 } } { \semio_viz_math_field:n { 2 } }
      }
    \semio_viz_math_sort_by_x:N \l_semio_viz_sci_pts_seq
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      { \semio_viz_sci_dot:nnn { \semio_viz_points_x:n {##1} } { \semio_viz_points_y:n {##1} } { semio-primary } }
  }
\bool_new:N \l_semio_viz_math_dominated_bool
% ⚔️ Adds the point (#1,#2) to the frontier only when no other candidate dominates it in both coordinates.
\cs_new_protected:Npn \semio_viz_math_pareto_test:nn #1#2
  {
    \bool_set_false:N \l_semio_viz_math_dominated_bool
    \clist_map_inline:Nn \l_semio_viz_math_points_clist
      {
        \seq_set_split:Nnn \l_tmpb_seq { / } {##1}
        \fp_compare:nT
          { \seq_item:Nn \l_tmpb_seq { 1 } >= #1 && \seq_item:Nn \l_tmpb_seq { 2 } >= #2 &&
            ( \seq_item:Nn \l_tmpb_seq { 1 } > #1 || \seq_item:Nn \l_tmpb_seq { 2 } > #2 ) }
          { \bool_set_true:N \l_semio_viz_math_dominated_bool }
      }
    \bool_if:NF \l_semio_viz_math_dominated_bool
      { \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq {#1} {#2} }
  }
% 🔤 Sorts the point sequence #1 into ascending x order.
\cs_new_protected:Npn \semio_viz_math_sort_by_x:N #1
  {
    \seq_sort:Nn #1
      {
        \fp_compare:nNnTF { \semio_viz_points_x:n {##1} } > { \semio_viz_points_x:n {##2} }
          { \sort_return_swapped: } { \sort_return_same: }
      }
  }
% 🔻 Draws the four-level decision lattice: a hued dot per node and an edge back up to its parent.
\cs_new_protected:Npn \semio_viz_math_lattice:
  {
    \int_step_inline:nnnn { 0 } { 1 } { 3 }
      {
        \int_step_inline:nnnn { 0 } { 1 } {##1}
          {
            \fill [ fill=\semio_viz_sci_hue:n { ##1 + 1 } ]
              ( \fp_eval:n { \l_semio_viz_sci_w_fp * ( 0.5 + ( ####1 - ##1 / 2 ) / 5 ) } ,
                \fp_eval:n { \l_semio_viz_sci_h_fp * ( 1 - ##1 / 3.4 ) } ) circle [ radius=1.1 ] ;
            \int_compare:nNnT {##1} > { 0 }
              {
                \draw [ semio~sci~thin ]
                  ( \fp_eval:n { \l_semio_viz_sci_w_fp * ( 0.5 + ( ####1 - ##1 / 2 ) / 5 ) } ,
                    \fp_eval:n { \l_semio_viz_sci_h_fp * ( 1 - ##1 / 3.4 ) } ) --
                  ( \fp_eval:n { \l_semio_viz_sci_w_fp * ( 0.5 + ( min ( ####1 , ##1 - 1 ) - ( ##1 - 1 ) / 2 ) / 5 ) } ,
                    \fp_eval:n { \l_semio_viz_sci_h_fp * ( 1 - ( ##1 - 1 ) / 3.4 ) } ) ;
              }
          }
      }
  }

