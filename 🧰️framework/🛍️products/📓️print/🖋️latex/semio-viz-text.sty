%region 🔖️Keys-text-viz
% 🔑 `text-viz` keys, l3keys family `semio / viz / family / text-viz`. Every §13 chart kind is one
% option set over these; the twelve catalogue entries are pairwise distinct in `layout` or in the
% options the chosen layout reads.
% variant   (tl)     the catalogue slug, recorded by the registry
% data      (table)  source table; default `demo-text-terms`
% term      (column) token or type identity                        default `term`
% count     (column) frequency                                     default `count`
% document  (column) document key of the term-by-document grid     default `doc`
% position  (column) occurrence position on the text axis          default `pos`
% time      (column) reading window / time step                    default `t`
% series    (column) topic identity of a long topic table          default `topic`
% value     (column) numeric channel of the curve and river layouts default `weight`
% layout    (choice `spiral|grid|matrix|lane|curve|band|river`)     default `spiral`
% sort      (choice `none|count|term`)                             default `count`
% sizemin   (mm)  smallest glyph body height                       default 1.8
% sizemax   (mm)  largest glyph body height                        default 5.4
% growth    (mm)  Archimedean spiral growth per radian             default 0.9
% step      (rad) angular step of the placement spiral             default 0.35
% tries     (int) placement attempts before a word is dropped      default 220
% aspect    (fp)  horizontal stretch of the placement spiral       default 1.7
% collide   (bool) reject a position whose box meets a placed box  default true
% rotate    (bool) place every second word on its side             default false
% columns   (int) columns of the grid layout                       default 4
% marker    (choice `tick|dot|band`) lane occurrence glyph         default tick
% context   (fp)  half width in text units of a KWIC band          default 4
% guide     (bool) centre guide of the lane layouts                default false
% baseline  (choice `zero|silhouette|wiggle`) river offset         default zero
% area      (bool) fill the curve layouts                          default true
% points    (bool) mark every sample of the curve layouts          default false
% labels    (bool) print row, lane and axis captions               default true
% padding   (fp)  relative gap between adjacent cells and bands    default 0.12
\tl_new:N \l_semio_viz_tx_data_tl
\tl_new:N \l_semio_viz_tx_term_col_tl
\tl_new:N \l_semio_viz_tx_count_col_tl
\tl_new:N \l_semio_viz_tx_doc_col_tl
\tl_new:N \l_semio_viz_tx_pos_col_tl
\tl_new:N \l_semio_viz_tx_time_col_tl
\tl_new:N \l_semio_viz_tx_series_col_tl
\tl_new:N \l_semio_viz_tx_value_col_tl
\tl_new:N \l_semio_viz_tx_layout_tl
\tl_new:N \l_semio_viz_tx_sort_tl
\tl_new:N \l_semio_viz_tx_marker_tl
\tl_new:N \l_semio_viz_tx_baseline_tl
\fp_new:N \l_semio_viz_tx_sizemin_fp
\fp_new:N \l_semio_viz_tx_sizemax_fp
\fp_new:N \l_semio_viz_tx_growth_fp
\fp_new:N \l_semio_viz_tx_step_fp
\fp_new:N \l_semio_viz_tx_aspect_fp
\fp_new:N \l_semio_viz_tx_context_fp
\fp_new:N \l_semio_viz_tx_padding_fp
\fp_new:N \l_semio_viz_tx_width_fp
