  \tl_set:Nn \l_semio_viz_tx_time_col_tl { t }
  \tl_set:Nn \l_semio_viz_tx_series_col_tl { topic }
  \tl_set:Nn \l_semio_viz_tx_value_col_tl { weight }
  \tl_set:Nn \l_semio_viz_tx_layout_tl { spiral }
