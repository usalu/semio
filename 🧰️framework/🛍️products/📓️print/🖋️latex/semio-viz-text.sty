% 📏 Canvas size: the enclosing VizFigure's millimetres when there is one, the fallback otherwise.
\cs_new_protected:Npn \semio_viz_tx_canvas: {
  \cs_if_exist:NTF \l_semio_viz_width_fp
    { \fp_set_eq:NN \l_semio_viz_tx_width_fp \l_semio_viz_width_fp }
    { \fp_set:Nn \l_semio_viz_tx_width_fp { 80 } }
  \cs_if_exist:NTF \l_semio_viz_height_fp
    { \fp_set_eq:NN \l_semio_viz_tx_height_fp \l_semio_viz_height_fp }
    { \fp_set:Nn \l_semio_viz_tx_height_fp { 40 } }
  \fp_compare:nNnT { \l_semio_viz_tx_width_fp } < { 8 } { \fp_set:Nn \l_semio_viz_tx_width_fp { 80 } }
  \fp_compare:nNnT { \l_semio_viz_tx_height_fp } < { 8 } { \fp_set:Nn \l_semio_viz_tx_height_fp { 40 } }
}
