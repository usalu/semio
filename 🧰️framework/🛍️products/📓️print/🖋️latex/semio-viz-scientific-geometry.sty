% 🔥 The positional heatmap: one bin per cell of the columns-by-rows partition of the surface.
\cs_new_protected:Npn \semio_viz_geom_pitch_heat:
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_cols_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_rows_int - 1 }
          { \semio_viz_geom_pitch_bin:nn {##1} {####1} }
      }
  }
% 🧮 Counts the events falling inside bin (#1,#2) and paints it on the ramp when the count is not zero.
\cs_new_protected:Npn \semio_viz_geom_pitch_bin:nn #1#2
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_geom_events_clist
      {
        \semio_viz_geom_record:n {##1}
        \fp_compare:nT
          {
            \semio_viz_geom_field:n { 1 } >= #1 / \l_semio_viz_geom_cols_int &&
            \semio_viz_geom_field:n { 1 } < ( #1 + 1 ) / \l_semio_viz_geom_cols_int &&
            \semio_viz_geom_field:n { 2 } >= #2 / \l_semio_viz_geom_rows_int &&
            \semio_viz_geom_field:n { 2 } < ( #2 + 1 ) / \l_semio_viz_geom_rows_int
          }
          { \int_incr:N \l_tmpa_int }
      }
    \int_compare:nNnT { \l_tmpa_int } > { 0 }
      {
        \fill [ fill=\semio_viz_sci_ramp:n { \l_tmpa_int / 3 } , fill~opacity=0.7 ]
          ( \fp_eval:n { \l_semio_viz_sci_w_fp * #1 / \l_semio_viz_geom_cols_int } ,
            \fp_eval:n { \l_semio_viz_sci_h_fp * #2 / \l_semio_viz_geom_rows_int } )
          rectangle
          ( \fp_eval:n { \l_semio_viz_sci_w_fp * ( #1 + 1 ) / \l_semio_viz_geom_cols_int } ,
            \fp_eval:n { \l_semio_viz_sci_h_fp * ( #2 + 1 ) / \l_semio_viz_geom_rows_int } ) ;
        \semio_viz_sci_report_values:nn { pitch/bin } { #1 , #2 , \int_use:N \l_tmpa_int }
      }
  }
% 👕 The player markers: one filled disc per node, carrying its shirt number as the caption.
\cs_new_protected:Npn \semio_viz_geom_positions:
  {
    \clist_map_inline:Nn \l_semio_viz_geom_nodes_clist
      {
        \semio_viz_geom_record:n {##1}
        \node [ semio~sci~glyph , circle , inner~sep=0.7mm , fill=semio-primary ,
                font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-base ]
          at ( \semio_viz_sci_mx:n { \semio_viz_geom_field:n { 2 } } ,
               \semio_viz_sci_my:n { \semio_viz_geom_field:n { 3 } } )
          { \semio_viz_geom_field:n { 4 } } ;
      }
  }
% 🔁 The pass network: the node coordinates are indexed by id, every edge is drawn at a width that
% grows with its pass count, and the players are stamped on top.
\cs_new_protected:Npn \semio_viz_geom_passes:
  {
    \prop_clear:N \l_semio_viz_geom_nx_prop
    \prop_clear:N \l_semio_viz_geom_ny_prop
    \clist_map_inline:Nn \l_semio_viz_geom_nodes_clist
      {
        \semio_viz_geom_record:n {##1}
        \prop_put:Nxx \l_semio_viz_geom_nx_prop
          { \semio_viz_geom_field:n { 1 } } { \semio_viz_geom_field:n { 2 } }
        \prop_put:Nxx \l_semio_viz_geom_ny_prop
          { \semio_viz_geom_field:n { 1 } } { \semio_viz_geom_field:n { 3 } }
      }
    \clist_map_inline:Nn \l_semio_viz_geom_edges_clist
      {
        \semio_viz_geom_record:n {##1}
        \use:x
          {
            \exp_not:N \draw
              [ semio~sci~thin , draw=semio-primary ,
                line~width=\fp_eval:n { 0.2 + 0.22 * \semio_viz_geom_field:n { 3 } } pt ]
              ( \semio_viz_sci_mx:n { \prop_item:Ne \l_semio_viz_geom_nx_prop { \semio_viz_geom_field:n { 1 } } } ,
                \semio_viz_sci_my:n { \prop_item:Ne \l_semio_viz_geom_ny_prop { \semio_viz_geom_field:n { 1 } } } ) --
              ( \semio_viz_sci_mx:n { \prop_item:Ne \l_semio_viz_geom_nx_prop { \semio_viz_geom_field:n { 2 } } } ,
                \semio_viz_sci_my:n { \prop_item:Ne \l_semio_viz_geom_ny_prop { \semio_viz_geom_field:n { 2 } } } ) ;
          }
      }
    \semio_viz_geom_positions:
  }

%region 🔖️Keys
% 🔑 Keys of `sci-bracket` (§43 tournament structures):
%    rounds (int, 3): knockout rounds. entries (clist of labels): the first-round competitors.
%    results (clist of `round/slot/label`): the winner label placed in each later slot.
%    slotHeight (fp, 6), roundWidth (fp, 22): millimetre geometry.
\int_new:N \l_semio_viz_geom_rounds_int
\clist_new:N \l_semio_viz_geom_entries_clist
\clist_new:N \l_semio_viz_geom_results_clist
\fp_new:N \l_semio_viz_geom_sloth_fp
\fp_new:N \l_semio_viz_geom_roundw_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-bracket }
% 🗝️ The option surface of `sci-bracket`: the round count, the first-round entries, the recorded
% winners and the millimetre geometry of a slot and a round.
\keys_define:nn { semio / viz / family / sci-bracket }
  {
    rounds     .int_set:N   = \l_semio_viz_geom_rounds_int ,
    entries    .clist_set:N = \l_semio_viz_geom_entries_clist ,
    results    .clist_set:N = \l_semio_viz_geom_results_clist ,
    slotHeight .fp_set:N    = \l_semio_viz_geom_sloth_fp ,
    roundWidth .fp_set:N    = \l_semio_viz_geom_roundw_fp ,
  }

% 🏆 §43 knockout bracket: every round's slots placed from the round index, with the recorded winners written in.
\SemioVizFamily { sci-bracket }
  {
    \semio_viz_sci_enter:nnn { sci-bracket }
      {
        rounds=3 , entries={ A , B , C , D , E , F , G , H } ,
        results={ 2/1/A , 2/2/D , 2/3/E , 2/4/H , 3/1/A , 3/2/H , 4/1/A } ,
        slotHeight=6 , roundWidth=22 , axes=false , grid=false
      }
      {#1}
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_geom_entries_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_geom_bracket_slot:nnn { 1 } { \l_tmpa_int } {##1}
      }
    \clist_map_inline:Nn \l_semio_viz_geom_results_clist
      {
        \semio_viz_geom_record:n {##1}
        \semio_viz_geom_bracket_slot:nnn
          { \semio_viz_geom_field:n { 1 } } { \semio_viz_geom_field:n { 2 } } { \semio_viz_geom_field:n { 3 } }
      }
  }
% 🥇 One bracket slot labelled #3: round #1 sets its column, and slot #2 its row, spaced by the
% doubling that each round of the knockout brings.
\cs_new_protected:Npn \semio_viz_geom_bracket_slot:nnn #1#2#3
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp { ( #1 - 1 ) * \l_semio_viz_geom_roundw_fp }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { - ( ( #2 - 0.5 ) * ( 2 ^ ( #1 - 1 ) ) - 0.5 ) * \l_semio_viz_geom_sloth_fp }
    \node [ semio~sci~box , anchor=west , minimum~width=\fp_eval:n { 0.72 * \l_semio_viz_geom_roundw_fp } mm ,
            inner~sep=0.7mm , font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground ]
      at ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) {#3} ;
    \int_compare:nNnT {#1} > { 1 }
      {
        \draw [ semio~sci~thin ]
          ( \fp_eval:n { \l_semio_viz_sci_a_fp - 0.24 * \l_semio_viz_geom_roundw_fp } ,
            \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
          ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) ;
      }
    \semio_viz_sci_report_values:nn { bracket/slot }
      { #1 , #2 , \fp_to_decimal:N \l_semio_viz_sci_b_fp }
  }
%region 🔖️Keys
% 🔑 Keys of `sci-sports-series` (§43 competition series):
%    mode (race|lap|split|win-probability|play-by-play|standings|radar, race).
%    series (clist of `label/points`) where points is a `+`-joined `x:y` list.
%    events (clist of `time/team/label`): the play-by-play markers.
%    axesLabels (clist): the radar axis names. reference (fp, 0.5): the win-probability reference line.
\clist_new:N \l_semio_viz_geom_series_clist
\clist_new:N \l_semio_viz_geom_axeslabels_clist
\fp_new:N \l_semio_viz_geom_reference_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-sports-series }
% 🗝️ The option surface of `sci-sports-series`: which reading, the series records, the play-by-play
% events, the radar axis names and the win-probability reference level.
\keys_define:nn { semio / viz / family / sci-sports-series }
  {
    mode       .tl_set:N    = \l_semio_viz_geom_mode_tl ,
    series     .clist_set:N = \l_semio_viz_geom_series_clist ,
    events     .clist_set:N = \l_semio_viz_geom_events_clist ,
    axesLabels .clist_set:N = \l_semio_viz_geom_axeslabels_clist ,
    reference  .fp_set:N    = \l_semio_viz_geom_reference_fp ,
  }

% 🏁 §43 competition series: race and lap positions, split times, win probability, play-by-play markers, standings and the player radar.
\SemioVizFamily { sci-sports-series }
  {
    \semio_viz_sci_enter:nnn { sci-sports-series }
      {
        mode=race , reference=0.5 , domain={} , range={} ,
        axesLabels={ pace , passing , shooting , defence , stamina , vision } ,
        series={
          A/1:4+2:3+3:3+4:2+5:1+6:1 ,
          B/1:1+2:1+3:2+4:3+5:3+6:2 ,
          C/1:3+2:4+3:4+4:4+5:4+6:4 ,
          D/1:2+2:2+3:1+4:1+5:2+6:3
        } ,
        events={ 12/A/goal , 34/B/card , 58/A/goal , 77/B/goal }
      }
      {#1}
    \str_case:VnF \l_semio_viz_geom_mode_tl
      {
        { radar }        { \semio_viz_geom_radar: }
        { play-by-play } { \semio_viz_geom_playbyplay: }
        { standings }    { \semio_viz_geom_standings: }
      }
      { \semio_viz_geom_series: }
  }
% 🏁 Reads one `label/x:y+x:y…` record into the shared point sequence.
\cs_new_protected:Npn \semio_viz_geom_series_points:
  {
    \seq_set_split:Nnx \l_tmpa_seq { + } { \semio_viz_geom_field:n { 2 } }
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \seq_map_inline:Nn \l_tmpa_seq
      {
        \semio_viz_sci_split_colon:Nn \l_tmpb_seq {##1}
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \seq_item:Nn \l_tmpb_seq { 1 } } { \seq_item:Nn \l_tmpb_seq { 2 } }
      }
  }
% 📊 The bounding box over every series, padded by 0.4 above and below so the outermost line clears
% the frame.
\cs_new_protected:Npn \semio_viz_geom_series_extent:
  {
    \fp_set:Nn \l_semio_viz_sci_dxmin_fp { inf }
    \fp_set:Nn \l_semio_viz_sci_dxmax_fp { -inf }
    \fp_set:Nn \l_semio_viz_sci_dymin_fp { inf }
    \fp_set:Nn \l_semio_viz_sci_dymax_fp { -inf }
    \clist_map_inline:Nn \l_semio_viz_geom_series_clist
      {
        \semio_viz_geom_record:n {##1}
        \semio_viz_geom_series_points:
        \semio_viz_sci_extent:N \l_semio_viz_sci_pts_seq
        \fp_set:Nn \l_semio_viz_sci_dxmin_fp { min ( \l_semio_viz_sci_dxmin_fp , \l_semio_viz_sci_xmin_fp ) }
        \fp_set:Nn \l_semio_viz_sci_dxmax_fp { max ( \l_semio_viz_sci_dxmax_fp , \l_semio_viz_sci_xmax_fp ) }
        \fp_set:Nn \l_semio_viz_sci_dymin_fp { min ( \l_semio_viz_sci_dymin_fp , \l_semio_viz_sci_ymin_fp ) }
        \fp_set:Nn \l_semio_viz_sci_dymax_fp { max ( \l_semio_viz_sci_dymax_fp , \l_semio_viz_sci_ymax_fp ) }
      }
    \fp_sub:Nn \l_semio_viz_sci_dymin_fp { 0.4 }
    \fp_add:Nn \l_semio_viz_sci_dymax_fp { 0.4 }
  }
% 📈 The line readings: the window is set from the mode, the win-probability reference is ruled in,
% and each series is drawn in its own hue with its label at the last point.
\cs_new_protected:Npn \semio_viz_geom_series:
  {
    \semio_viz_geom_series_extent:
    \str_case:VnF \l_semio_viz_geom_mode_tl
      {
        { race } { \semio_viz_geom_flip_y: }
        { lap }  { \semio_viz_geom_flip_y: }
        { win-probability }
          { \semio_viz_sci_window:nnnn { \l_semio_viz_sci_dxmin_fp } { \l_semio_viz_sci_dxmax_fp } { 0 } { 1 } }
      }
      { }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \str_if_eq:VnT \l_semio_viz_geom_mode_tl { win-probability }
      {
        \draw [ semio~sci~aux ]
          ( 0 , \semio_viz_sci_my:n { \l_semio_viz_geom_reference_fp } ) --
          ( \fp_eval:n { \l_semio_viz_sci_w_fp } ,
            \semio_viz_sci_my:n { \l_semio_viz_geom_reference_fp } ) ;
      }
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_geom_series_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_geom_record:n {##1}
        \semio_viz_geom_series_points:
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq
          { semio~sci~curve , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=west ]
          at ( \fp_eval:n { \l_semio_viz_sci_w_fp + 1 } ,
               \semio_viz_sci_my:n
                 { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { -1 } } } )
          { \semio_viz_geom_field:n { 1 } } ;
      }
  }
% 🏁 Race and lap charts count positions downward, so the y window is inverted.
\cs_new_protected:Npn \semio_viz_geom_flip_y:
  {
    \semio_viz_sci_window:nnnn
      { \l_semio_viz_sci_dxmin_fp } { \l_semio_viz_sci_dxmax_fp }
      { \l_semio_viz_sci_dymax_fp } { \l_semio_viz_sci_dymin_fp }
  }
% ⏱️ The match timeline: ninety minutes across the frame, with every event dotted on the centre line
% and its name set at an angle above it.
\cs_new_protected:Npn \semio_viz_geom_playbyplay:
  {
    \semio_viz_sci_window:nnnn { 0 } { 90 } { 0 } { 1 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \draw [ semio~sci~curve ]
      ( 0 , \semio_viz_sci_my:n { 0.5 } ) --
      ( \fp_eval:n { \l_semio_viz_sci_w_fp } , \semio_viz_sci_my:n { 0.5 } ) ;
    \clist_map_inline:Nn \l_semio_viz_geom_events_clist
      {
        \semio_viz_geom_record:n {##1}
        \semio_viz_sci_dot:nnn { \semio_viz_geom_field:n { 1 } } { 0.5 } { semio-primary }
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=south , rotate=45 ]
          at ( \semio_viz_sci_mx:n { \semio_viz_geom_field:n { 1 } } ,
               \fp_eval:n { \semio_viz_sci_my:n { 0.5 } + 1.4 } )
          { \semio_viz_geom_field:n { 3 } } ;
        \semio_viz_sci_report_values:nn { sports/event } { \semio_viz_geom_field:n { 1 } }
      }
  }
% 🏅 The standings reading: every series filled down to the lower bound and outlined in its own hue.
\cs_new_protected:Npn \semio_viz_geom_standings:
  {
    \semio_viz_geom_series_extent:
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_geom_series_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_geom_record:n {##1}
        \semio_viz_geom_series_points:
        \semio_viz_sci_polyarea:Nnn \l_semio_viz_sci_pts_seq
          { fill=\semio_viz_sci_hue:n { \l_tmpa_int } , fill~opacity=0.18 } { \l_semio_viz_sci_dymin_fp }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq
          { semio~sci~curve , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
      }
  }
% 🏁 Player radar: one spoke per axis label, each series closed round the star.
\cs_new_protected:Npn \semio_viz_geom_radar:
  {
    \int_set:Nn \l_tmpb_int { \clist_count:N \l_semio_viz_geom_axeslabels_clist }
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_geom_axeslabels_clist
      {
        \int_incr:N \l_tmpa_int
        \draw [ semio~sci~grid ]
          ( 0 , 0 ) -- ( \fp_eval:n { 24 * cosd ( 90 - 360 * ( \l_tmpa_int - 1 ) / \l_tmpb_int ) } ,
                        \fp_eval:n { 24 * sind ( 90 - 360 * ( \l_tmpa_int - 1 ) / \l_tmpb_int ) } ) ;
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal ]
          at ( \fp_eval:n { 28 * cosd ( 90 - 360 * ( \l_tmpa_int - 1 ) / \l_tmpb_int ) } ,
               \fp_eval:n { 28 * sind ( 90 - 360 * ( \l_tmpa_int - 1 ) / \l_tmpb_int ) } ) {##1} ;
      }
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_geom_series_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_geom_record:n {##1}
        \semio_viz_geom_series_points:
        \semio_viz_geom_radar_polygon:
      }
  }
% ⭐ One closed radar star: the nth value of the series is carried out along the nth spoke.
\cs_new_protected:Npn \semio_viz_geom_radar_polygon:
  {
    \tl_clear:N \l_semio_viz_sci_path_tl
    \int_zero:N \l_tmpb_int
    \int_set:Nn \l_tmpb_int { \clist_count:N \l_semio_viz_geom_axeslabels_clist }
    \int_zero:N \l_semio_viz_geom_cols_int
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      {
        \int_incr:N \l_semio_viz_geom_cols_int
        \tl_if_empty:NF \l_semio_viz_sci_path_tl { \tl_put_right:Nn \l_semio_viz_sci_path_tl { -- } }
        \tl_put_right:Nx \l_semio_viz_sci_path_tl
          {
            (
              \fp_to_decimal:n
                { 5 * \semio_viz_points_y:n {##1}
                  * cosd ( 90 - 360 * ( \l_semio_viz_geom_cols_int - 1 ) / \l_tmpb_int ) } ,
              \fp_to_decimal:n
                { 5 * \semio_viz_points_y:n {##1}
                  * sind ( 90 - 360 * ( \l_semio_viz_geom_cols_int - 1 ) / \l_tmpb_int ) }
            )
          }
      }
    \use:x
      {
        \exp_not:N \draw
          [ semio~sci~curve , draw=\semio_viz_sci_hue:n { \l_tmpa_int } ,
            fill=\semio_viz_sci_hue:n { \l_tmpa_int } , fill~opacity=0.14 ]
          \exp_not:V \l_semio_viz_sci_path_tl ~ -- ~ cycle ;
      }
  }
%endregion 🔖️Families


\ExplSyntaxOff
