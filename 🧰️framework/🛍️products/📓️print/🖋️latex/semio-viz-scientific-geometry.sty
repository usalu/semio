%region 🔖️Families

%region 🔖️Keys
% 🔑 Keys of `sci-construction` (§26 Euclidean figures):
%    mode (polygon|triangle|circle|angle|tangent|secant|similarity|congruence|coordinate, polygon).
%    points (clist of `label/x/y`): the vertices, in millimetres of the figure.
%    marks (bool, true): draw angle arcs and side ticks. radius (fp, 18): circle radius for the circle modes.
%    centre (clist of 2, `0,0`): circle centre. through (clist of 2): the external point of a tangent or secant.
%    labels (bool, true): print vertex labels.
\tl_new:N \l_semio_viz_geom_mode_tl
\clist_new:N \l_semio_viz_geom_points_clist
\clist_new:N \l_semio_viz_geom_centre_clist
\clist_new:N \l_semio_viz_geom_through_clist
\bool_new:N \l_semio_viz_geom_marks_bool
\bool_new:N \l_semio_viz_geom_labels_bool
\fp_new:N \l_semio_viz_geom_radius_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-construction }
% 🗝️ The option surface of `sci-construction`: the construction mode, its vertex list, the circle
% centre and radius, the external point and the two annotation switches.
\keys_define:nn { semio / viz / family / sci-construction }
  {
    mode    .tl_set:N    = \l_semio_viz_geom_mode_tl ,
    points  .clist_set:N = \l_semio_viz_geom_points_clist ,
    centre  .clist_set:N = \l_semio_viz_geom_centre_clist ,
    through .clist_set:N = \l_semio_viz_geom_through_clist ,
    radius  .fp_set:N    = \l_semio_viz_geom_radius_fp ,
    marks   .bool_set:N  = \l_semio_viz_geom_marks_bool ,
    labels  .bool_set:N  = \l_semio_viz_geom_labels_bool ,
  }

% 📐 Vertex labels and dots of the current point list.
\cs_new_protected:Npn \semio_viz_geom_vertices:
  {
    \clist_map_inline:Nn \l_semio_viz_geom_points_clist
      {
        \semio_viz_geom_record:n {##1}
        \fill [ fill=semio-chrome-foreground ]
          ( \semio_viz_geom_field:n { 2 } , \semio_viz_geom_field:n { 3 } ) circle [ radius=0.7 ] ;
        \bool_if:NT \l_semio_viz_geom_labels_bool
          {
            \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=south~west ]
              at ( \semio_viz_geom_field:n { 2 } , \semio_viz_geom_field:n { 3 } )
              { \semio_viz_geom_field:n { 1 } } ;
          }
        \semio_viz_sci_report_values:nn { construction/point }
          { \semio_viz_geom_field:n { 2 } , \semio_viz_geom_field:n { 3 } }
      }
  }
% 📐 Closed outline through the current point list.
\cs_new_protected:Npn \semio_viz_geom_outline:
  {
    \tl_clear:N \l_semio_viz_sci_path_tl
    \clist_map_inline:Nn \l_semio_viz_geom_points_clist
      {
        \semio_viz_geom_record:n {##1}
        \tl_if_empty:NF \l_semio_viz_sci_path_tl { \tl_put_right:Nn \l_semio_viz_sci_path_tl { -- } }
        \tl_put_right:Nx \l_semio_viz_sci_path_tl
          { ( \semio_viz_geom_field:n { 2 } , \semio_viz_geom_field:n { 3 } ) }
      }
    \use:x { \exp_not:N \draw [ semio~sci~curve ] \exp_not:V \l_semio_viz_sci_path_tl ~ -- ~ cycle ; }
  }
% 📐 Interior angle arc at vertex `#2` of the triangle `#1`,`#2`,`#3`.
\cs_new_protected:Npn \semio_viz_geom_angle:nnn #1#2#3
  {
    \semio_viz_geom_record:n { \clist_item:Nn \l_semio_viz_geom_points_clist {#2} }
    \fp_set:Nn \l_semio_viz_sci_a_fp { \semio_viz_geom_field:n { 2 } }
    \fp_set:Nn \l_semio_viz_sci_b_fp { \semio_viz_geom_field:n { 3 } }
    \semio_viz_geom_record:n { \clist_item:Nn \l_semio_viz_geom_points_clist {#1} }
    \fp_set:Nn \l_semio_viz_sci_c_fp
      { atand ( \semio_viz_geom_field:n { 3 } - \l_semio_viz_sci_b_fp ,
                \semio_viz_geom_field:n { 2 } - \l_semio_viz_sci_a_fp ) }
    \semio_viz_geom_record:n { \clist_item:Nn \l_semio_viz_geom_points_clist {#3} }
    \fp_set:Nn \l_semio_viz_sci_d_fp
      { atand ( \semio_viz_geom_field:n { 3 } - \l_semio_viz_sci_b_fp ,
                \semio_viz_geom_field:n { 2 } - \l_semio_viz_sci_a_fp ) }
    \draw [ semio~sci~thin , draw=semio-secondary ]
      ( \fp_eval:n { \l_semio_viz_sci_a_fp + 4 * cosd ( \l_semio_viz_sci_c_fp ) } ,
        \fp_eval:n { \l_semio_viz_sci_b_fp + 4 * sind ( \l_semio_viz_sci_c_fp ) } )
      arc [ start~angle=\fp_eval:n { \l_semio_viz_sci_c_fp } ,
            end~angle=\fp_eval:n { \l_semio_viz_sci_d_fp } , radius=4 ] ;
    \semio_viz_sci_report_values:nn { construction/angle }
      { \fp_to_decimal:n { abs ( \l_semio_viz_sci_d_fp - \l_semio_viz_sci_c_fp ) } }
  }

% 📐 §26 Euclidean constructions: polygons and triangles with angle marks, circle geometry, tangents and secants, coordinate figures.
\SemioVizFamily { sci-construction }
  {
    \semio_viz_sci_enter:nnn { sci-construction }
      {
        mode=polygon , points={ A/0/0 , B/44/0 , C/13/30 } , centre={ 22 , 15 } , through={ 52 , 34 } ,
        radius=18 , marks=true , labels=true , axes=false , grid=false
      }
      {#1}
    \str_case:VnF \l_semio_viz_geom_mode_tl
      {
        { circle }    { \semio_viz_geom_circle: }
        { tangent }   { \semio_viz_geom_circle: \semio_viz_geom_tangent: }
        { secant }    { \semio_viz_geom_circle: \semio_viz_geom_secant: }
        { coordinate }
          {
            \bool_set_true:N \l_semio_viz_sci_axes_bool
            \bool_set_true:N \l_semio_viz_sci_grid_bool
            \semio_viz_sci_window:nnnn { -5 } { 55 } { -5 } { 40 }
            \semio_viz_sci_frame:
            \semio_viz_geom_outline:
            \semio_viz_geom_vertices:
          }
        { similarity }
          {
            \semio_viz_geom_outline:
            \semio_viz_geom_vertices:
            \begin{scope}[ shift={(52,6)} , scale=0.6 ]
            \semio_viz_geom_outline:
            \end{scope}
          }
        { congruence }
          {
            \semio_viz_geom_outline:
            \semio_viz_geom_vertices:
            \begin{scope}[ shift={(52,4)} , rotate=18 ]
            \semio_viz_geom_outline:
            \end{scope}
          }
      }
      {
        \semio_viz_geom_outline:
        \semio_viz_geom_vertices:
        \bool_if:NT \l_semio_viz_geom_marks_bool
          {
            \int_set:Nn \l_tmpa_int { \clist_count:N \l_semio_viz_geom_points_clist }
            \int_step_inline:nnnn { 1 } { 1 } { \l_tmpa_int }
              {
                \semio_viz_geom_angle:nnn
                  { \int_mod:nn { ##1 } { \l_tmpa_int } + 1 } {##1}
                  { \int_mod:nn { ##1 + \l_tmpa_int - 2 } { \l_tmpa_int } + 1 }
              }
          }
      }
  }
% ⭕ The construction circle at the given centre and radius, with its centre point dotted in.
\cs_new_protected:Npn \semio_viz_geom_circle:
  {
    \draw [ semio~sci~curve ]
      ( \clist_item:Nn \l_semio_viz_geom_centre_clist { 1 } ,
        \clist_item:Nn \l_semio_viz_geom_centre_clist { 2 } )
      circle [ radius=\fp_eval:n { \l_semio_viz_geom_radius_fp } ] ;
    \fill [ fill=semio-chrome-foreground ]
      ( \clist_item:Nn \l_semio_viz_geom_centre_clist { 1 } ,
        \clist_item:Nn \l_semio_viz_geom_centre_clist { 2 } ) circle [ radius=0.7 ] ;
  }
% 📐 Tangent points from an external point: the classic right-angle construction, solved in fp.
\cs_new_protected:Npn \semio_viz_geom_tangent:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \clist_item:Nn \l_semio_viz_geom_through_clist { 1 } - \clist_item:Nn \l_semio_viz_geom_centre_clist { 1 } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \clist_item:Nn \l_semio_viz_geom_through_clist { 2 } - \clist_item:Nn \l_semio_viz_geom_centre_clist { 2 } }
    \fp_set:Nn \l_semio_viz_sci_c_fp
      { sqrt ( \l_semio_viz_sci_a_fp ^ 2 + \l_semio_viz_sci_b_fp ^ 2 ) }
    \fp_set:Nn \l_semio_viz_sci_d_fp
      { acosd ( \l_semio_viz_geom_radius_fp / \l_semio_viz_sci_c_fp ) }
    \fp_set:Nn \l_semio_viz_sci_e_fp
      { atand ( \l_semio_viz_sci_b_fp , \l_semio_viz_sci_a_fp ) }
    \int_step_inline:nnnn { -1 } { 2 } { 1 }
      {
        \draw [ semio~sci~aux , draw=semio-secondary ]
          ( \clist_item:Nn \l_semio_viz_geom_through_clist { 1 } ,
            \clist_item:Nn \l_semio_viz_geom_through_clist { 2 } ) --
          ( \fp_eval:n { \clist_item:Nn \l_semio_viz_geom_centre_clist { 1 }
              + \l_semio_viz_geom_radius_fp * cosd ( \l_semio_viz_sci_e_fp + 180 + ##1 * \l_semio_viz_sci_d_fp ) } ,
            \fp_eval:n { \clist_item:Nn \l_semio_viz_geom_centre_clist { 2 }
              + \l_semio_viz_geom_radius_fp * sind ( \l_semio_viz_sci_e_fp + 180 + ##1 * \l_semio_viz_sci_d_fp ) } ) ;
      }
    \semio_viz_sci_report_values:nn { construction/tangent }
      { \fp_to_decimal:N \l_semio_viz_sci_c_fp , \fp_to_decimal:N \l_semio_viz_sci_d_fp }
  }
% 📐 Secant through the external point and the circle centre, cut at both intersections.
\cs_new_protected:Npn \semio_viz_geom_secant:
  {
    \fp_set:Nn \l_semio_viz_sci_e_fp
      {
        atand ( \clist_item:Nn \l_semio_viz_geom_through_clist { 2 } - \clist_item:Nn \l_semio_viz_geom_centre_clist { 2 } ,
                \clist_item:Nn \l_semio_viz_geom_through_clist { 1 } - \clist_item:Nn \l_semio_viz_geom_centre_clist { 1 } )
        + 24
      }
    \draw [ semio~sci~aux , draw=semio-secondary ]
      ( \clist_item:Nn \l_semio_viz_geom_through_clist { 1 } ,
        \clist_item:Nn \l_semio_viz_geom_through_clist { 2 } ) --
      ( \fp_eval:n { \clist_item:Nn \l_semio_viz_geom_centre_clist { 1 }
          - \l_semio_viz_geom_radius_fp * cosd ( \l_semio_viz_sci_e_fp ) } ,
        \fp_eval:n { \clist_item:Nn \l_semio_viz_geom_centre_clist { 2 }
          - \l_semio_viz_geom_radius_fp * sind ( \l_semio_viz_sci_e_fp ) } ) ;
  }

%region 🔖️Keys
% 🔑 Keys of `sci-conic` (§26 conic sections):
%    kind (ellipse|parabola|hyperbola, ellipse): which conic.
%    a, b (fp, 1.6/1): the semi-axes, or the focal parameter of a parabola.
%    foci (bool, true), directrix (bool, false), asymptotes (bool, true): construction elements to draw.
%    samples (int, 160): curve resolution.
\tl_new:N \l_semio_viz_geom_kind_tl
\fp_new:N \l_semio_viz_geom_a_fp
\fp_new:N \l_semio_viz_geom_b_fp
\bool_new:N \l_semio_viz_geom_foci_bool
\bool_new:N \l_semio_viz_geom_directrix_bool
\bool_new:N \l_semio_viz_geom_asym_bool
\int_new:N \l_semio_viz_geom_samples_int
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-conic }
% 🗝️ The option surface of `sci-conic`: which conic, its two semi-axes, the construction elements to
% show and the sampling resolution of the curve.
\keys_define:nn { semio / viz / family / sci-conic }
  {
    kind       .tl_set:N   = \l_semio_viz_geom_kind_tl ,
    a          .fp_set:N   = \l_semio_viz_geom_a_fp ,
    b          .fp_set:N   = \l_semio_viz_geom_b_fp ,
    foci       .bool_set:N = \l_semio_viz_geom_foci_bool ,
    directrix  .bool_set:N = \l_semio_viz_geom_directrix_bool ,
    asymptotes .bool_set:N = \l_semio_viz_geom_asym_bool ,
    samples    .int_set:N  = \l_semio_viz_geom_samples_int ,
  }

% 🥚 §26 conic sections with their foci, directrix and asymptotes, all placed from the semi-axes.
\SemioVizFamily { sci-conic }
  {
    \semio_viz_sci_enter:nnn { sci-conic }
      {
        kind=ellipse , a=1.6 , b=1 , foci=true , directrix=false , asymptotes=true , samples=160 ,
        domain={-2.6,2.6} , range={-2,2}
      }
      {#1}
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \str_case:VnF \l_semio_viz_geom_kind_tl
      {
        { parabola }
          {
            \semio_viz_geom_conic_sample:nnnn
              { \l_semio_viz_geom_a_fp * \SemioT * \SemioT } { 2 * \l_semio_viz_geom_a_fp * \SemioT }
              { -1.6 } { 1.6 }
            \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
            \bool_if:NT \l_semio_viz_geom_foci_bool
              { \semio_viz_sci_dot:nnn { \fp_eval:n { 1 / ( 4 * \l_semio_viz_geom_a_fp ) } } { 0 } { semio-primary } }
            \bool_if:NT \l_semio_viz_geom_directrix_bool
              {
                \draw [ semio~sci~aux ]
                  ( \semio_viz_sci_mx:n { - 1 / ( 4 * \l_semio_viz_geom_a_fp ) } , 0 ) --
                  ( \semio_viz_sci_mx:n { - 1 / ( 4 * \l_semio_viz_geom_a_fp ) } , \fp_eval:n { \l_semio_viz_sci_h_fp } ) ;
              }
          }
        { hyperbola }
          {
            \semio_viz_geom_conic_sample:nnnn
              { \l_semio_viz_geom_a_fp * ( exp ( \SemioT ) + exp ( - \SemioT ) ) / 2 }
              { \l_semio_viz_geom_b_fp * ( exp ( \SemioT ) - exp ( - \SemioT ) ) / 2 } { -1.4 } { 1.4 }
            \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
            \semio_viz_geom_conic_sample:nnnn
              { - \l_semio_viz_geom_a_fp * ( exp ( \SemioT ) + exp ( - \SemioT ) ) / 2 }
              { \l_semio_viz_geom_b_fp * ( exp ( \SemioT ) - exp ( - \SemioT ) ) / 2 } { -1.4 } { 1.4 }
            \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
            \bool_if:NT \l_semio_viz_geom_asym_bool { \semio_viz_geom_asymptotes: }
            \bool_if:NT \l_semio_viz_geom_foci_bool { \semio_viz_geom_foci:n { 1 } }
          }
      }
      {
        \semio_viz_geom_conic_sample:nnnn
          { \l_semio_viz_geom_a_fp * cos ( \SemioT ) } { \l_semio_viz_geom_b_fp * sin ( \SemioT ) }
          { 0 } { 6.283185307179586 }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
        \bool_if:NT \l_semio_viz_geom_foci_bool { \semio_viz_geom_foci:n { -1 } }
      }
  }
% 〰️ Samples the parametric pair (#1,#2) over the parameter range #3 to #4, dropping any point whose
% ordinate is not finite.
\cs_new_protected:Npn \semio_viz_geom_conic_sample:nnnn #1#2#3#4
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_samples_int }
      {
        \fp_set:Nn \SemioT { #3 + ( #4 - (#3) ) * ##1 / \l_semio_viz_geom_samples_int }
        \semio_viz_tr_finite:nT {#2}
          { \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq {#1} {#2} }
      }
  }
% 🎯 The two foci on the major axis, at ±sqrt(a²+#1·b²), so #1 is -1 for an ellipse and 1 for a
% hyperbola; the focal distance is reported for the probe.
\cs_new_protected:Npn \semio_viz_geom_foci:n #1
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { sqrt ( abs ( \l_semio_viz_geom_a_fp ^ 2 + (#1) * \l_semio_viz_geom_b_fp ^ 2 ) ) }
    \semio_viz_sci_dot:nnn { \l_semio_viz_sci_a_fp } { 0 } { semio-primary }
    \semio_viz_sci_dot:nnn { - \l_semio_viz_sci_a_fp } { 0 } { semio-primary }
    \semio_viz_sci_report_values:nn { conic/focus } { \fp_to_decimal:N \l_semio_viz_sci_a_fp }
  }
% ✖️ The two asymptotes y = ±(b/a)x of a hyperbola, drawn across the whole plotted domain.
\cs_new_protected:Npn \semio_viz_geom_asymptotes:
  {
    \int_step_inline:nnnn { -1 } { 2 } { 1 }
      {
        \seq_clear:N \l_semio_viz_sci_pts_b_seq
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \l_semio_viz_sci_dxmin_fp }
          { ##1 * \l_semio_viz_geom_b_fp * \l_semio_viz_sci_dxmin_fp / \l_semio_viz_geom_a_fp }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \l_semio_viz_sci_dxmax_fp }
          { ##1 * \l_semio_viz_geom_b_fp * \l_semio_viz_sci_dxmax_fp / \l_semio_viz_geom_a_fp }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq { semio~sci~aux }
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-transform` (§26 transform geometry):
%    kind (translation|rotation|reflection|scaling|shear, rotation): the map applied to the shape.
%    points (clist of `label/x/y`): the pre-image polygon.
%    dx, dy (fp, 18/0): translation. angle (fp, 35): rotation or reflection-axis angle in degrees.
%    sx, sy (fp, 1.4/0.8): scale factors. shear (fp, 0.5): shear factor. about (clist of 2): the fixed point.
\fp_new:N \l_semio_viz_geom_dx_fp
\fp_new:N \l_semio_viz_geom_dy_fp
\fp_new:N \l_semio_viz_geom_angle_fp
\fp_new:N \l_semio_viz_geom_sx_fp
\fp_new:N \l_semio_viz_geom_sy_fp
\fp_new:N \l_semio_viz_geom_shear_fp
\clist_new:N \l_semio_viz_geom_about_clist
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-transform }
% 🗝️ The option surface of `sci-transform`: which map, the pre-image polygon, and the parameters of
% each map — offsets, angle, scale factors, shear and the fixed point.
\keys_define:nn { semio / viz / family / sci-transform }
  {
    kind   .tl_set:N    = \l_semio_viz_geom_kind_tl ,
    points .clist_set:N = \l_semio_viz_geom_points_clist ,
    dx     .fp_set:N    = \l_semio_viz_geom_dx_fp ,
    dy     .fp_set:N    = \l_semio_viz_geom_dy_fp ,
    angle  .fp_set:N    = \l_semio_viz_geom_angle_fp ,
    sx     .fp_set:N    = \l_semio_viz_geom_sx_fp ,
    sy     .fp_set:N    = \l_semio_viz_geom_sy_fp ,
    shear  .fp_set:N    = \l_semio_viz_geom_shear_fp ,
    about  .clist_set:N = \l_semio_viz_geom_about_clist ,
    labels .bool_set:N  = \l_semio_viz_geom_labels_bool ,
  }

% 🔁 Image of `#1`,`#2` under the current transform, into a_fp/b_fp.
\cs_new_protected:Npn \semio_viz_geom_map:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_sci_e_fp { #1 - \clist_item:Nn \l_semio_viz_geom_about_clist { 1 } }
    \fp_set:Nn \l_semio_viz_sci_f_fp { #2 - \clist_item:Nn \l_semio_viz_geom_about_clist { 2 } }
    \str_case:VnF \l_semio_viz_geom_kind_tl
      {
        { translation }
          {
            \fp_set:Nn \l_semio_viz_sci_a_fp { \l_semio_viz_sci_e_fp + \l_semio_viz_geom_dx_fp }
            \fp_set:Nn \l_semio_viz_sci_b_fp { \l_semio_viz_sci_f_fp + \l_semio_viz_geom_dy_fp }
          }
        { reflection }
          {
            \fp_set:Nn \l_semio_viz_sci_a_fp
              { \l_semio_viz_sci_e_fp * cosd ( 2 * \l_semio_viz_geom_angle_fp )
                + \l_semio_viz_sci_f_fp * sind ( 2 * \l_semio_viz_geom_angle_fp ) }
            \fp_set:Nn \l_semio_viz_sci_b_fp
              { \l_semio_viz_sci_e_fp * sind ( 2 * \l_semio_viz_geom_angle_fp )
                - \l_semio_viz_sci_f_fp * cosd ( 2 * \l_semio_viz_geom_angle_fp ) }
          }
        { scaling }
          {
            \fp_set:Nn \l_semio_viz_sci_a_fp { \l_semio_viz_sci_e_fp * \l_semio_viz_geom_sx_fp }
            \fp_set:Nn \l_semio_viz_sci_b_fp { \l_semio_viz_sci_f_fp * \l_semio_viz_geom_sy_fp }
          }
        { shear }
          {
            \fp_set:Nn \l_semio_viz_sci_a_fp
              { \l_semio_viz_sci_e_fp + \l_semio_viz_geom_shear_fp * \l_semio_viz_sci_f_fp }
            \fp_set:Nn \l_semio_viz_sci_b_fp { \l_semio_viz_sci_f_fp }
          }
      }
      {
        \fp_set:Nn \l_semio_viz_sci_a_fp
          { \l_semio_viz_sci_e_fp * cosd ( \l_semio_viz_geom_angle_fp )
            - \l_semio_viz_sci_f_fp * sind ( \l_semio_viz_geom_angle_fp ) }
        \fp_set:Nn \l_semio_viz_sci_b_fp
          { \l_semio_viz_sci_e_fp * sind ( \l_semio_viz_geom_angle_fp )
            + \l_semio_viz_sci_f_fp * cosd ( \l_semio_viz_geom_angle_fp ) }
      }
    \fp_add:Nn \l_semio_viz_sci_a_fp { \clist_item:Nn \l_semio_viz_geom_about_clist { 1 } }
    \fp_add:Nn \l_semio_viz_sci_b_fp { \clist_item:Nn \l_semio_viz_geom_about_clist { 2 } }
  }

% 🔁 §26 transform geometry: the pre-image, its image under the named map, and the correspondence between vertices.
\SemioVizFamily { sci-transform }
