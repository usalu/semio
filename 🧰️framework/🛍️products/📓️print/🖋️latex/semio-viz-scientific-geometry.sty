        sx=1.4 , sy=0.8 , shear=0.5 , about={ 6 , 6 } , labels=true , axes=false , grid=false
      }
      {#1}
    \semio_viz_geom_outline:
    \semio_viz_geom_vertices:
    \tl_clear:N \l_semio_viz_sci_path_tl
    \clist_map_inline:Nn \l_semio_viz_geom_points_clist
      {
        \semio_viz_geom_record:n {##1}
