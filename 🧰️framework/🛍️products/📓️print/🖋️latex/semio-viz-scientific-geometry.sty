        \tl_if_empty:NF \l_semio_viz_sci_path_tl { \tl_put_right:Nn \l_semio_viz_sci_path_tl { -- } }
        \tl_put_right:Nx \l_semio_viz_sci_path_tl
          { ( \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp ) }
        \draw [ semio~sci~aux ]
          ( \semio_viz_geom_field:n { 2 } , \semio_viz_geom_field:n { 3 } ) --
          ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) ;
        \semio_viz_sci_report_values:nn { transform/image }
          { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp }
      }
    \use:x { \exp_not:N \draw [ semio~sci~curve~alt ] \exp_not:V \l_semio_viz_sci_path_tl ~ -- ~ cycle ; }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-tiling` (§26 tessellations):
%    kind (square|triangular|hexagonal|penrose|hyperbolic, hexagonal).
