%    depth (int, 3): Penrose substitution steps, or hyperbolic recursion depth.
%    p, q (int, 5/4): the Schläfli symbol {p,q} of the hyperbolic tiling. discRadius (fp, 22): Poincaré disc radius.
\int_new:N \l_semio_viz_geom_cols_int
\int_new:N \l_semio_viz_geom_rows_int
\int_new:N \l_semio_viz_geom_depth_int
\int_new:N \l_semio_viz_geom_p_int
\int_new:N \l_semio_viz_geom_q_int
\fp_new:N \l_semio_viz_geom_size_fp
\fp_new:N \l_semio_viz_geom_disc_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-tiling }
% 🗝️ The option surface of `sci-tiling`: which tessellation, the lattice extent and cell size, the
% substitution depth, and the {p,q} pair and radius of the Poincaré disc.
\keys_define:nn { semio / viz / family / sci-tiling }
  {
    kind       .tl_set:N  = \l_semio_viz_geom_kind_tl ,
    columns    .int_set:N = \l_semio_viz_geom_cols_int ,
    rows       .int_set:N = \l_semio_viz_geom_rows_int ,
    size       .fp_set:N  = \l_semio_viz_geom_size_fp ,
    depth      .int_set:N = \l_semio_viz_geom_depth_int ,
    p          .int_set:N = \l_semio_viz_geom_p_int ,
    q          .int_set:N = \l_semio_viz_geom_q_int ,
    discRadius .fp_set:N  = \l_semio_viz_geom_disc_fp ,
  }

% 🔷 §26 tessellations: the three regular tilings, a Penrose rhomb substitution and a Poincaré-disc {p,q} tiling.
\SemioVizFamily { sci-tiling }
  {
    \semio_viz_sci_enter:nnn { sci-tiling }
      {
        kind=hexagonal , columns=7 , rows=5 , size=6 , depth=3 , p=5 , q=4 , discRadius=22 ,
        axes=false , grid=false
      }
      {#1}
    \str_case:VnF \l_semio_viz_geom_kind_tl
      {
        { penrose }    { \semio_viz_geom_penrose: }
        { hyperbolic } { \semio_viz_geom_hyperbolic: }
        { square }     { \semio_viz_geom_lattice:n { 4 } }
        { triangular } { \semio_viz_geom_lattice:n { 3 } }
      }
      { \semio_viz_geom_lattice:n { 6 } }
  }
% 🔷 Regular tiling by placing a regular `#1`-gon at every lattice site of its own packing.
\cs_new_protected:Npn \semio_viz_geom_lattice:n #1
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_cols_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_rows_int - 1 }
          { \semio_viz_geom_lattice_cell:nnn {#1} {##1} {####1} }
      }
  }
% 🔶 One regular #1-gon at lattice site (#2,#3): the packing offsets its rows, the polygon is turned
% so its edges meet, and its hue steps with the site's diagonal.
\cs_new_protected:Npn \semio_viz_geom_lattice_cell:nnn #1#2#3
  {
    \int_case:nnF {#1}
      {
        { 4 }
          {
            \fp_set:Nn \l_semio_viz_sci_a_fp { #2 * \l_semio_viz_geom_size_fp * 1.732 }
            \fp_set:Nn \l_semio_viz_sci_b_fp { #3 * \l_semio_viz_geom_size_fp * 1.732 }
          }
        { 3 }
          {
            \fp_set:Nn \l_semio_viz_sci_a_fp
              { ( #2 + 0.5 * \int_mod:nn {#3} { 2 } ) * \l_semio_viz_geom_size_fp * 1.732 }
            \fp_set:Nn \l_semio_viz_sci_b_fp { #3 * \l_semio_viz_geom_size_fp * 1.5 }
          }
      }
      {
        \fp_set:Nn \l_semio_viz_sci_a_fp
          { ( #2 + 0.5 * \int_mod:nn {#3} { 2 } ) * \l_semio_viz_geom_size_fp * 1.732 }
        \fp_set:Nn \l_semio_viz_sci_b_fp { #3 * \l_semio_viz_geom_size_fp * 1.5 }
      }
    \tl_clear:N \l_semio_viz_sci_path_tl
    \int_step_inline:nnnn { 0 } { 1 } { #1 - 1 }
      {
        \tl_if_empty:NF \l_semio_viz_sci_path_tl { \tl_put_right:Nn \l_semio_viz_sci_path_tl { -- } }
        \tl_put_right:Nx \l_semio_viz_sci_path_tl
          {
            ( \fp_to_decimal:n { \l_semio_viz_sci_a_fp
                + \l_semio_viz_geom_size_fp * cosd ( 360 * ##1 / (#1) + ( #1 == 4 ? 45 : 90 ) ) } ,
              \fp_to_decimal:n { \l_semio_viz_sci_b_fp
                + \l_semio_viz_geom_size_fp * sind ( 360 * ##1 / (#1) + ( #1 == 4 ? 45 : 90 ) ) } )
          }
      }
    \use:x
      {
        \exp_not:N \draw [ semio~sci~thin , fill=\semio_viz_sci_hue:n { #2 + #3 } , fill~opacity=0.18 ]
          \exp_not:V \l_semio_viz_sci_path_tl ~ -- ~ cycle ;
      }
    \semio_viz_sci_report_values:nn { tiling/cell }
      { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp }
  }
% 🔷 Penrose P3: a wheel of thin and thick rhombs, each substituted `depth` times by the golden-ratio rule.
\seq_new:N \l_semio_viz_geom_tiles_seq
\seq_new:N \l_semio_viz_geom_next_seq
\cs_new_protected:Npn \semio_viz_geom_penrose:
  {
    \seq_clear:N \l_semio_viz_geom_tiles_seq
    \int_step_inline:nnnn { 0 } { 1 } { 9 }
      {
        \seq_put_right:Nx \l_semio_viz_geom_tiles_seq
          {
            \int_mod:nn {##1} { 2 } /
            \fp_to_decimal:n { 0 } / \fp_to_decimal:n { 0 } /
            \fp_to_decimal:n { \l_semio_viz_geom_size_fp * 4 * cosd ( 36 * ##1 ) } /
            \fp_to_decimal:n { \l_semio_viz_geom_size_fp * 4 * sind ( 36 * ##1 ) } /
            \fp_to_decimal:n { \l_semio_viz_geom_size_fp * 4 * cosd ( 36 * ( ##1 + 1 ) ) } /
            \fp_to_decimal:n { \l_semio_viz_geom_size_fp * 4 * sind ( 36 * ( ##1 + 1 ) ) }
          }
      }
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_geom_depth_int }
      {
        \seq_clear:N \l_semio_viz_geom_next_seq
        \seq_map_inline:Nn \l_semio_viz_geom_tiles_seq { \semio_viz_geom_penrose_split:n {####1} }
        \seq_set_eq:NN \l_semio_viz_geom_tiles_seq \l_semio_viz_geom_next_seq
      }
    \seq_map_inline:Nn \l_semio_viz_geom_tiles_seq { \semio_viz_geom_penrose_draw:n {##1} }
    \semio_viz_sci_report_values:nn { tiling/penrose }
      { \int_use:N \l_semio_viz_geom_depth_int , \seq_count:N \l_semio_viz_geom_tiles_seq }
  }
% ♦️ Substitutes one rhomb record, dispatching on its thin or thick type after fixing the golden ratio.
\cs_new_protected:Npn \semio_viz_geom_penrose_split:n #1
  {
    \seq_set_split:Nnn \l_tmpa_seq { / } {#1}
    \fp_set:Nn \l_semio_viz_sci_g_fp { ( sqrt (5) - 1 ) / 2 }
    \int_compare:nNnTF { \seq_item:Nn \l_tmpa_seq { 1 } } = { 0 }
      { \semio_viz_geom_penrose_thin: }
      { \semio_viz_geom_penrose_thick: }
  }
% 📝 Appends one child rhomb — type #1 and its three corners — to the next generation.
\cs_new_protected:Npn \semio_viz_geom_penrose_tile:nnnnnnn #1#2#3#4#5#6#7
  {
    \seq_put_right:Nx \l_semio_viz_geom_next_seq
      {
        #1 / \fp_to_decimal:n {#2} / \fp_to_decimal:n {#3} / \fp_to_decimal:n {#4} /
        \fp_to_decimal:n {#5} / \fp_to_decimal:n {#6} / \fp_to_decimal:n {#7}
      }
  }
% 🔺 The thin-rhomb rule: one thick and one thin child, split at the golden point of the first edge.
\cs_new_protected:Npn \semio_viz_geom_penrose_thin:
  {
    \semio_viz_geom_penrose_tile:nnnnnnn { 1 }
      { \seq_item:Nn \l_tmpa_seq { 4 } } { \seq_item:Nn \l_tmpa_seq { 5 } }
      { \seq_item:Nn \l_tmpa_seq { 6 } } { \seq_item:Nn \l_tmpa_seq { 7 } }
      { \seq_item:Nn \l_tmpa_seq { 2 } + \l_semio_viz_sci_g_fp * ( \seq_item:Nn \l_tmpa_seq { 4 } - \seq_item:Nn \l_tmpa_seq { 2 } ) }
      { \seq_item:Nn \l_tmpa_seq { 3 } + \l_semio_viz_sci_g_fp * ( \seq_item:Nn \l_tmpa_seq { 5 } - \seq_item:Nn \l_tmpa_seq { 3 } ) }
    \semio_viz_geom_penrose_tile:nnnnnnn { 0 }
      { \seq_item:Nn \l_tmpa_seq { 6 } } { \seq_item:Nn \l_tmpa_seq { 7 } }
      { \seq_item:Nn \l_tmpa_seq { 2 } + \l_semio_viz_sci_g_fp * ( \seq_item:Nn \l_tmpa_seq { 4 } - \seq_item:Nn \l_tmpa_seq { 2 } ) }
      { \seq_item:Nn \l_tmpa_seq { 3 } + \l_semio_viz_sci_g_fp * ( \seq_item:Nn \l_tmpa_seq { 5 } - \seq_item:Nn \l_tmpa_seq { 3 } ) }
      { \seq_item:Nn \l_tmpa_seq { 2 } } { \seq_item:Nn \l_tmpa_seq { 3 } }
  }
% 🔻 The thick-rhomb rule: the mirror-image split, again at the golden point but of the other edge.
\cs_new_protected:Npn \semio_viz_geom_penrose_thick:
  {
    \semio_viz_geom_penrose_tile:nnnnnnn { 0 }
      { \seq_item:Nn \l_tmpa_seq { 6 } } { \seq_item:Nn \l_tmpa_seq { 7 } }
      { \seq_item:Nn \l_tmpa_seq { 4 } + \l_semio_viz_sci_g_fp * ( \seq_item:Nn \l_tmpa_seq { 2 } - \seq_item:Nn \l_tmpa_seq { 4 } ) }
      { \seq_item:Nn \l_tmpa_seq { 5 } + \l_semio_viz_sci_g_fp * ( \seq_item:Nn \l_tmpa_seq { 3 } - \seq_item:Nn \l_tmpa_seq { 5 } ) }
      { \seq_item:Nn \l_tmpa_seq { 2 } } { \seq_item:Nn \l_tmpa_seq { 3 } }
    \semio_viz_geom_penrose_tile:nnnnnnn { 1 }
      { \seq_item:Nn \l_tmpa_seq { 4 } } { \seq_item:Nn \l_tmpa_seq { 5 } }
      { \seq_item:Nn \l_tmpa_seq { 4 } + \l_semio_viz_sci_g_fp * ( \seq_item:Nn \l_tmpa_seq { 2 } - \seq_item:Nn \l_tmpa_seq { 4 } ) }
      { \seq_item:Nn \l_tmpa_seq { 5 } + \l_semio_viz_sci_g_fp * ( \seq_item:Nn \l_tmpa_seq { 3 } - \seq_item:Nn \l_tmpa_seq { 5 } ) }
      { \seq_item:Nn \l_tmpa_seq { 6 } } { \seq_item:Nn \l_tmpa_seq { 7 } }
  }
% 🖌️ Fills one rhomb record as a triangle, its hue taken from the thin or thick type.
\cs_new_protected:Npn \semio_viz_geom_penrose_draw:n #1
  {
    \seq_set_split:Nnn \l_tmpb_seq { / } {#1}
    \use:x
      {
        \exp_not:N \draw
          [ semio~sci~thin ,
            fill=\semio_viz_sci_hue:n { \seq_item:Nn \l_tmpb_seq { 1 } + 1 } , fill~opacity=0.2 ]
          ( \seq_item:Nn \l_tmpb_seq { 2 } , \seq_item:Nn \l_tmpb_seq { 3 } ) --
          ( \seq_item:Nn \l_tmpb_seq { 4 } , \seq_item:Nn \l_tmpb_seq { 5 } ) --
          ( \seq_item:Nn \l_tmpb_seq { 6 } , \seq_item:Nn \l_tmpb_seq { 7 } ) ~ -- ~ cycle ;
      }
  }
% 🔷 Poincaré disc {p,q}: the central p-gon plus its inversions in the disc's own geodesics, to the requested depth.
\cs_new_protected:Npn \semio_viz_geom_hyperbolic:
  {
    \draw [ semio~sci~axis ] ( 0 , 0 ) circle [ radius=\fp_eval:n { \l_semio_viz_geom_disc_fp } ] ;
    \fp_set:Nn \l_semio_viz_sci_a_fp
      {
        sqrt ( cosd ( 180 / \l_semio_viz_geom_p_int + 180 / \l_semio_viz_geom_q_int )
               / cosd ( 180 / \l_semio_viz_geom_p_int - 180 / \l_semio_viz_geom_q_int ) )
      }
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_geom_depth_int }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_p_int - 1 }
          {
            \fp_set:Nn \l_semio_viz_sci_b_fp
              { \l_semio_viz_sci_a_fp * ##1 / \l_semio_viz_geom_depth_int }
            \semio_viz_geom_hyperbolic_cell:nn { \l_semio_viz_sci_b_fp }
              { 360 * ####1 / \l_semio_viz_geom_p_int + 18 * ##1 }
          }
      }
  }
% 🌀 One p-gon of the disc tiling, centred at radius #1 and bearing #2, shrinking towards the rim.
\cs_new_protected:Npn \semio_viz_geom_hyperbolic_cell:nn #1#2
  {
    \tl_clear:N \l_semio_viz_sci_path_tl
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_p_int - 1 }
      {
        \tl_if_empty:NF \l_semio_viz_sci_path_tl { \tl_put_right:Nn \l_semio_viz_sci_path_tl { -- } }
        \tl_put_right:Nx \l_semio_viz_sci_path_tl
          {
            (
              \fp_to_decimal:n
                { \l_semio_viz_geom_disc_fp * ( ( #1 ) * cosd (#2)
                    + ( 1 - (#1) ) * 0.42 * cosd ( 360 * ##1 / \l_semio_viz_geom_p_int + (#2) ) ) } ,
              \fp_to_decimal:n
                { \l_semio_viz_geom_disc_fp * ( ( #1 ) * sind (#2)
                    + ( 1 - (#1) ) * 0.42 * sind ( 360 * ##1 / \l_semio_viz_geom_p_int + (#2) ) ) }
            )
          }
      }
    \use:x
      {
        \exp_not:N \draw [ semio~sci~thin , fill=semio-primary , fill~opacity=0.12 ]
          \exp_not:V \l_semio_viz_sci_path_tl ~ -- ~ cycle ;
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-fractal` (§26 self-similar figures):
%    kind (koch|sierpinski|dragon|l-system, koch).
%    depth (int, 4): iteration count. size (fp, 44): base edge length in millimetres.
%    axiom (tl), rules (clist of `symbol/replacement`), angle (fp, 25): the L-system.
\tl_new:N \l_semio_viz_geom_axiom_tl
\clist_new:N \l_semio_viz_geom_rules_clist
\tl_new:N \l_semio_viz_geom_word_tl
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-fractal }
% 🗝️ The option surface of `sci-fractal`: which curve, the iteration depth and base edge, and the
% axiom, rewrite rules and turn angle of a custom L-system.
\keys_define:nn { semio / viz / family / sci-fractal }
  {
    kind  .tl_set:N    = \l_semio_viz_geom_kind_tl ,
    depth .int_set:N   = \l_semio_viz_geom_depth_int ,
    size  .fp_set:N    = \l_semio_viz_geom_size_fp ,
    axiom .tl_set:N    = \l_semio_viz_geom_axiom_tl ,
    rules .clist_set:N = \l_semio_viz_geom_rules_clist ,
    angle .fp_set:N    = \l_semio_viz_geom_angle_fp ,
  }

% ❄️ §26 fractals: Koch, Sierpiński and dragon curves and a general L-system, all drawn by turtle interpretation of the rewritten word.
\SemioVizFamily { sci-fractal }
  {
    \semio_viz_sci_enter:nnn { sci-fractal }
      {
        kind=koch , depth=4 , size=44 , angle=25 , axiom=F ,
        rules={ F/FF+[+F-F-F]-[-F+F+F] } , axes=false , grid=false
      }
      {#1}
    \str_case:VnF \l_semio_viz_geom_kind_tl
      {
        { sierpinski }
          {
            \tl_set:Nn \l_semio_viz_geom_axiom_tl { F-G-G }
            \clist_set:Nn \l_semio_viz_geom_rules_clist { F/F-G+F+G-F , G/GG }
            \fp_set:Nn \l_semio_viz_geom_angle_fp { 120 }
          }
        { dragon }
          {
            \tl_set:Nn \l_semio_viz_geom_axiom_tl { F }
            \clist_set:Nn \l_semio_viz_geom_rules_clist { F/F+G , G/F-G }
            \fp_set:Nn \l_semio_viz_geom_angle_fp { 90 }
          }
        { koch }
          {
            \tl_set:Nn \l_semio_viz_geom_axiom_tl { F--F--F }
            \clist_set:Nn \l_semio_viz_geom_rules_clist { F/F+F--F+F }
            \fp_set:Nn \l_semio_viz_geom_angle_fp { 60 }
          }
      }
      { }
    \semio_viz_geom_rewrite:
    \semio_viz_geom_turtle:
  }
% ❄️ Applies the production rules `depth` times to the axiom.
\tl_new:N \l_semio_viz_geom_out_tl
\tl_new:N \l_semio_viz_geom_sym_tl
\tl_new:N \l_semio_viz_geom_head_tl
\cs_new_protected:Npn \semio_viz_geom_rewrite:
  {
    \tl_set_eq:NN \l_semio_viz_geom_word_tl \l_semio_viz_geom_axiom_tl
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_geom_depth_int }
      {
        \tl_clear:N \l_semio_viz_geom_out_tl
        \tl_map_inline:Nn \l_semio_viz_geom_word_tl { \semio_viz_geom_rewrite_symbol:n {####1} }
        \tl_set_eq:NN \l_semio_viz_geom_word_tl \l_semio_viz_geom_out_tl
      }
    \semio_viz_sci_report_values:nn { fractal/word }
      { \int_use:N \l_semio_viz_geom_depth_int , \tl_count:N \l_semio_viz_geom_word_tl }
  }
% ❄️ One production step: the first rule whose left side is this symbol replaces it, otherwise the symbol survives.
\cs_new_protected:Npn \semio_viz_geom_rewrite_symbol:n #1
  {
    \tl_set:Nn \l_semio_viz_geom_sym_tl {#1}
    \clist_map_inline:Nn \l_semio_viz_geom_rules_clist
      {
        \seq_set_split:Nnn \l_tmpa_seq { / } {##1}
        \tl_set:Nx \l_semio_viz_geom_head_tl { \seq_item:Nn \l_tmpa_seq { 1 } }
        \str_if_eq:VnT \l_semio_viz_geom_head_tl {#1}
          {
            \tl_set:Nx \l_semio_viz_geom_sym_tl { \seq_item:Nn \l_tmpa_seq { 2 } }
            \clist_map_break:
          }
      }
    \tl_put_right:NV \l_semio_viz_geom_out_tl \l_semio_viz_geom_sym_tl
  }
% ❄️ Turtle interpretation: F and G draw, + and - turn, [ and ] push and pop the state.
\fp_new:N \l_semio_viz_geom_tx_fp
\fp_new:N \l_semio_viz_geom_ty_fp
\fp_new:N \l_semio_viz_geom_th_fp
\seq_new:N \l_semio_viz_geom_stack_seq
\cs_new_protected:Npn \semio_viz_geom_turtle:
  {
    \fp_zero:N \l_semio_viz_geom_tx_fp
    \fp_zero:N \l_semio_viz_geom_ty_fp
    \fp_zero:N \l_semio_viz_geom_th_fp
    \seq_clear:N \l_semio_viz_geom_stack_seq
    \fp_set:Nn \l_semio_viz_sci_g_fp
      { \l_semio_viz_geom_size_fp / ( 2 ^ \l_semio_viz_geom_depth_int ) }
    \tl_map_inline:Nn \l_semio_viz_geom_word_tl { \semio_viz_geom_turtle_step:n {##1} }
  }
% 🐢 One symbol of the word: + and - turn by the angle, [ pushes the state, ] restores it, and every
% other letter draws a segment forward.
\cs_new_protected:Npn \semio_viz_geom_turtle_step:n #1
  {
    \str_case:nnF {#1}
      {
        { + } { \fp_add:Nn \l_semio_viz_geom_th_fp { \l_semio_viz_geom_angle_fp } }
        { - } { \fp_sub:Nn \l_semio_viz_geom_th_fp { \l_semio_viz_geom_angle_fp } }
        { [ }
          {
            \seq_push:Nx \l_semio_viz_geom_stack_seq
              {
                \fp_to_decimal:N \l_semio_viz_geom_tx_fp , \fp_to_decimal:N \l_semio_viz_geom_ty_fp ,
                \fp_to_decimal:N \l_semio_viz_geom_th_fp
              }
          }
        { ] } { \semio_viz_geom_turtle_pop: }
      }
      { \semio_viz_geom_turtle_draw: }
  }
% ↩️ Pops the branch stack, putting the turtle back at the position and heading of the matching `[`.
\cs_new_protected:Npn \semio_viz_geom_turtle_pop:
  {
    \seq_pop:NN \l_semio_viz_geom_stack_seq \l_tmpa_tl
    \clist_set:NV \l_tmpa_clist \l_tmpa_tl
    \fp_set:Nn \l_semio_viz_geom_tx_fp { \clist_item:Nn \l_tmpa_clist { 1 } }
    \fp_set:Nn \l_semio_viz_geom_ty_fp { \clist_item:Nn \l_tmpa_clist { 2 } }
    \fp_set:Nn \l_semio_viz_geom_th_fp { \clist_item:Nn \l_tmpa_clist { 3 } }
  }
% ✒️ Draws one step of the current heading and advances the turtle to its far end.
\cs_new_protected:Npn \semio_viz_geom_turtle_draw:
  {
    \draw [ semio~sci~thin , draw=semio-primary ]
      ( \fp_eval:n { \l_semio_viz_geom_tx_fp } , \fp_eval:n { \l_semio_viz_geom_ty_fp } ) --
      ( \fp_eval:n { \l_semio_viz_geom_tx_fp + \l_semio_viz_sci_g_fp * cosd ( \l_semio_viz_geom_th_fp ) } ,
        \fp_eval:n { \l_semio_viz_geom_ty_fp + \l_semio_viz_sci_g_fp * sind ( \l_semio_viz_geom_th_fp ) } ) ;
    \fp_add:Nn \l_semio_viz_geom_tx_fp { \l_semio_viz_sci_g_fp * cosd ( \l_semio_viz_geom_th_fp ) }
    \fp_add:Nn \l_semio_viz_geom_ty_fp { \l_semio_viz_sci_g_fp * sind ( \l_semio_viz_geom_th_fp ) }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-mesh` (§26 triangulations and meshes):
%    mode (triangulation|mesh|quad, triangulation).
%    columns, rows (int, 8/6): lattice size. size (fp, 6): cell size in millimetres.
%    warp (l3fp over \SemioX,\SemioY): a displacement applied to every node, so a mesh can follow a shape.
%    fillCells (bool, false): shade every cell by its own index.
\tl_new:N \l_semio_viz_geom_warp_tl
\bool_new:N \l_semio_viz_geom_fillcells_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-mesh }
% 🗝️ The option surface of `sci-mesh`: triangles or quads, the lattice size and spacing, the warp
% expression applied to every node, and the cell shading switch.
\keys_define:nn { semio / viz / family / sci-mesh }
  {
    mode      .tl_set:N   = \l_semio_viz_geom_mode_tl ,
    columns   .int_set:N  = \l_semio_viz_geom_cols_int ,
    rows      .int_set:N  = \l_semio_viz_geom_rows_int ,
    size      .fp_set:N   = \l_semio_viz_geom_size_fp ,
    warp      .tl_set:N   = \l_semio_viz_geom_warp_tl ,
    fillCells .bool_set:N = \l_semio_viz_geom_fillcells_bool ,
  }

% 🕸️ §26 triangulations and meshes: a warped lattice split into triangles or kept as quads.
\SemioVizFamily { sci-mesh }
  {
    \semio_viz_sci_enter:nnn { sci-mesh }
      {
        mode=triangulation , columns=8 , rows=6 , size=6 , warp={ 1.5 * sin ( \SemioX / 3 ) } ,
        fillCells=false , axes=false , grid=false
      }
      {#1}
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_cols_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_geom_rows_int - 1 }
          { \semio_viz_geom_mesh_cell:nn {##1} {####1} }
      }
  }
% 📌 Lattice node (#1,#2) scaled to millimetres and displaced vertically by the `warp` expression.
\cs_new_protected:Npn \semio_viz_geom_mesh_node:nn #1#2
  {
    \fp_set:Nn \SemioX { #1 * \l_semio_viz_geom_size_fp }
    \fp_set:Nn \SemioY { #2 * \l_semio_viz_geom_size_fp }
    \fp_set:Nn \l_semio_viz_sci_a_fp { \SemioX }
    \fp_set:Nn \l_semio_viz_sci_b_fp { \SemioY + ( \l_semio_viz_geom_warp_tl ) }
  }
% 🔺 One cell of the warped lattice: its two outer edges, plus the diagonal that splits it into
% triangles when the mode asks for a triangulation.
\cs_new_protected:Npn \semio_viz_geom_mesh_cell:nn #1#2
  {
    \semio_viz_geom_mesh_node:nn {#1} {#2}
    \fp_set:Nn \l_semio_viz_sci_c_fp { \l_semio_viz_sci_a_fp }
    \fp_set:Nn \l_semio_viz_sci_d_fp { \l_semio_viz_sci_b_fp }
    \semio_viz_geom_mesh_node:nn { #1 + 1 } {#2}
    \fp_set:Nn \l_semio_viz_sci_e_fp { \l_semio_viz_sci_a_fp }
    \fp_set:Nn \l_semio_viz_sci_f_fp { \l_semio_viz_sci_b_fp }
    \semio_viz_geom_mesh_node:nn { #1 + 1 } { #2 + 1 }
    \fp_set:Nn \l_semio_viz_sci_g_fp { \l_semio_viz_sci_b_fp }
    \draw [ semio~sci~thin ]
      ( \fp_eval:n { \l_semio_viz_sci_c_fp } , \fp_eval:n { \l_semio_viz_sci_d_fp } ) --
      ( \fp_eval:n { \l_semio_viz_sci_e_fp } , \fp_eval:n { \l_semio_viz_sci_f_fp } ) --
      ( \fp_eval:n { \l_semio_viz_sci_e_fp } , \fp_eval:n { \l_semio_viz_sci_g_fp } ) ;
    \str_if_eq:VnT \l_semio_viz_geom_mode_tl { triangulation }
      {
        \draw [ semio~sci~thin , draw=semio-secondary ]
          ( \fp_eval:n { \l_semio_viz_sci_c_fp } , \fp_eval:n { \l_semio_viz_sci_d_fp } ) --
          ( \fp_eval:n { \l_semio_viz_sci_e_fp } , \fp_eval:n { \l_semio_viz_sci_g_fp } ) ;
      }
    \semio_viz_sci_report_values:nn { mesh/cell }
      { #1 , #2 , \fp_to_decimal:N \l_semio_viz_sci_d_fp }
  }

