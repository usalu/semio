\ExplSyntaxOn
\tl_new:N \l_semio_assignment_course_tl
\tl_new:N \l_semio_assignment_institution_tl
\tl_new:N \l_semio_assignment_duration_tl
\tl_new:N \l_semio_assignment_submission_tl
\tl_new:N \l_semio_assignment_number_tl
\tl_new:N \l_semio_assignment_faculty_tl
\tl_new:N \l_semio_assignment_logo_tl
\tl_new:N \l_semio_assignment_cover_image_tl
\tl_new:N \l_semio_assignment_cover_title_tl
\tl_new:N \l_semio_assignment_institution_label_tl
\tl_new:N \l_semio_assignment_faculty_label_tl
\keys_define:nn { semio / assignment } {
  institution-label .tl_set:N = \l_semio_assignment_institution_label_tl,
  faculty-label .tl_set:N = \l_semio_assignment_faculty_label_tl,
  course .tl_set:N = \l_semio_assignment_course_tl,
  institution .tl_set:N = \l_semio_assignment_institution_tl,
  duration .tl_set:N = \l_semio_assignment_duration_tl,
  submission .tl_set:N = \l_semio_assignment_submission_tl,
  number .tl_set:N = \l_semio_assignment_number_tl,
  faculty .tl_set:N = \l_semio_assignment_faculty_tl,
  logo .tl_set:N = \l_semio_assignment_logo_tl,
  cover-image .tl_set:N = \l_semio_assignment_cover_image_tl,
  cover-title .tl_set:N = \l_semio_assignment_cover_title_tl,
}
\NewDocumentCommand \SemioAssignmentSetup { m } { \keys_set:nn { semio / assignment } {#1} }
\cs_new:Npn \semio_assignment_label:n #1 {
  \str_case:Vn \l_semio_language_tl {
    { en } { \str_case:nn {#1} { { assignment } { Assignment } { duration } { Duration } { submission } { Submission } { course } { Course } { title } { Title } { faculty } { Faculty } } }
    { de } { \str_case:nn {#1} { { assignment } { Aufgabenblatt } { duration } { Bearbeitungszeit } { submission } { Abgabe } { course } { Lehrveranstaltung } { title } { Titel } { faculty } { Fakultät } } }
  }
}

\seq_new:N \g_semio_assignment_cover_facts_seq
\seq_new:N \g_semio_assignment_cover_partners_seq
\NewDocumentCommand \SemioAssignmentCoverFact { m m } {
  \seq_gput_right:Nn \g_semio_assignment_cover_facts_seq {
    \WindowItem { \begin{Window}[title={#1}, anchor=center, text-size=fit] \SemioSans #2 \end{Window} }
  }
}
\NewDocumentCommand \SemioAssignmentCoverPartner { m +m } {
  \seq_gput_right:Nn \g_semio_assignment_cover_partners_seq {
    \WindowItem { \begin{Window}[title={#1}, anchor=nw, text-size=fit] \semio_cover_address:n {#2} \end{Window} }
  }
}
\cs_new_protected:Npn \semio_assignment_cover_text:nN #1#2 {
  \tl_if_empty:NF #2 {
    \WindowItem { \begin{Window}[title={#1}, anchor=center, text-size=fit] \SemioSans \tl_use:N #2 \end{Window} }
  }
}
\cs_new_protected:Npn \semio_assignment_cover_logo:n #1 { \SemioLogoFit { \linewidth } { 1.1cm } {#1} }
\NewDocumentCommand \makeassignmentcover { } {
  \clearpage
  \newgeometry { left=1.5cm, right=1.5cm, top=1.5cm, bottom=1.5cm }
  \thispagestyle { empty }
  \bool_gset_true:N \g_semio_cover_geometry_bool
  \group_begin:
  \semio_theme_apply:
  \setlength { \parskip } { 0pt }
  \noindent
  \begin{WindowArrangement}[height=\textheight]
    \begin{WindowColumn}
      \WindowItem[0.9] {
        \begin{WindowRow}
          \semio_assignment_cover_text:nN { \semio_assignment_label:n { course } } \l_semio_assignment_course_tl
          \semio_assignment_cover_text:nN { \semio_assignment_label:n { assignment } } \l_semio_assignment_number_tl
        \end{WindowRow}
      }
      \WindowItem[1.1] {
        \begin{Window}[title={\semio_assignment_label:n { title }}, anchor=center, text-size=fit]
          \SemioSans \@title
          \tl_if_empty:NF \l_semio_subtitle_tl { \par \tl_use:N \l_semio_subtitle_tl }
        \end{Window}
      }
      \tl_if_empty:NF \l_semio_assignment_cover_image_tl {
        \WindowItem[11.4] {
          \begin{Window}[title={\tl_use:N \l_semio_assignment_cover_title_tl}, image-fit=cover, anchor=center]
            \exp_args:NV \SemioImage \l_semio_assignment_cover_image_tl
          \end{Window}
        }
      }
      \seq_if_empty:NF \g_semio_assignment_cover_facts_seq {
        \WindowItem[1.05] { \begin{WindowRow} \seq_use:Nn \g_semio_assignment_cover_facts_seq { } \end{WindowRow} }
      }
      \seq_if_empty:NF \g_semio_assignment_cover_partners_seq {
        \WindowItem[4.2] { \begin{WindowRow} \seq_use:Nn \g_semio_assignment_cover_partners_seq { } \end{WindowRow} }
      }
      \WindowItem[1.5] {
        \begin{WindowRow}
          \tl_if_empty:NF \l_semio_assignment_logo_tl {
            \WindowItem {
              \begin{Window}[title={\tl_if_empty:NTF \l_semio_assignment_institution_label_tl { \tl_use:N \l_semio_assignment_institution_tl } { \tl_use:N \l_semio_assignment_institution_label_tl }}, anchor=center]
                \exp_args:NV \semio_assignment_cover_logo:n \l_semio_assignment_logo_tl
              \end{Window}
            }
          }
          \semio_assignment_cover_text:nN { \tl_if_empty:NTF \l_semio_assignment_faculty_label_tl { \semio_assignment_label:n { faculty } } { \tl_use:N \l_semio_assignment_faculty_label_tl } } \l_semio_assignment_faculty_tl
        \end{WindowRow}
      }
    \end{WindowColumn}
  \end{WindowArrangement}
  \group_end:
  \semio_cover_geometry_restore:
}
\cs_new_protected:Npn \semio_assignment_metadata:nN #1#2 {
  \tl_if_empty:NF #2 { \par \noindent \textbf { \semio_assignment_label:n {#1}: } ~ \tl_use:N #2 }
}
\cs_new_protected:Npn \semio_assignment_title: {
  \par \group_begin:
  \setlength { \parindent } { 0pt }
  \SemioSans
  \tl_if_empty:NF \l_semio_assignment_institution_tl { \tl_use:N \l_semio_assignment_institution_tl \par }
  \tl_if_empty:NF \l_semio_assignment_course_tl { \tl_use:N \l_semio_assignment_course_tl \par }
  { \small \semio_assignment_label:n { assignment } \par }
  \smallskip
  { \LARGE \color { semio-chrome-foreground } \@title \par }
  \tl_if_empty:NF \l_semio_subtitle_tl { \large \tl_use:N \l_semio_subtitle_tl \par }
  \normalsize
  \tl_if_blank:eF { \@author } { \@author \par }
  \tl_if_blank:eF { \@date } { \@date \par }
  \semio_assignment_metadata:nN { duration } \l_semio_assignment_duration_tl
  \semio_assignment_metadata:nN { submission } \l_semio_assignment_submission_tl
  \par \medskip
  \noindent \textcolor { semio-chrome-border-normal } { \rule { \linewidth } { \semio@stroke@hairline } }
  \par \medskip
  \group_end:
}
\NewDocumentCommand \makeassignmenttitle { } { \semio_assignment_title: }

\NewDocumentCommand \AssignmentContrastImage { O{} m } {
  \group_begin:
  \str_if_eq:VnTF \l_semio_theme_tl { dark } {
    \setlength { \fboxsep } { .4mm }
    \colorbox { semio-chrome-light-canvas } { \includegraphics[#1]{#2} }
  } {
    \includegraphics[#1]{#2}
  }
  \group_end:
}

\int_new:N \l_semio_assignment_columns_int
\dim_new:N \l_semio_assignment_row_dim
\dim_new:N \l_semio_assignment_shape_dim
\dim_new:N \l_semio_assignment_value_dim
\keys_define:nn { semio / assignment / table } {
  value-columns .int_set:N = \l_semio_assignment_columns_int,
  value-columns .initial:n = 5,
  row-height .dim_set:N = \l_semio_assignment_row_dim,
  row-height .initial:n = 14mm,
  shape-width .dim_set:N = \l_semio_assignment_shape_dim,
  shape-width .initial:n = 27mm,
}
\NewDocumentCommand \AssignmentParameterRow { +m } {
  \rule [ -.3\l_semio_assignment_row_dim ] { 0pt } { \l_semio_assignment_row_dim }
  #1 \prg_replicate:nn { \l_semio_assignment_columns_int } { & }
  \tabularnewline \hline
}
\NewDocumentEnvironment { AssignmentParameterTable } { O{} m +b } {
  \par \group_begin:
  \keys_set:nn { semio / assignment / table } {#1}
  \int_compare:nNnTF { \l_semio_assignment_columns_int } > { 0 } {
    \dim_set:Nn \l_semio_assignment_value_dim {
      ( \linewidth - \l_semio_assignment_shape_dim
        - \int_eval:n { 2 * ( \l_semio_assignment_columns_int + 1 ) } \tabcolsep
        - \int_eval:n { \l_semio_assignment_columns_int + 2 } \arrayrulewidth )
        / \int_use:N \l_semio_assignment_columns_int
    }
    \arrayrulecolor { semio-chrome-border-normal }
    \noindent
    \begin{tabular}{|>{\centering\arraybackslash}m{\l_semio_assignment_shape_dim}|*{\int_use:N\l_semio_assignment_columns_int}{m{\l_semio_assignment_value_dim}|}}
      \hline
      \rule[-2mm]{0pt}{10mm} \textbf{#2}
      \prg_replicate:nn { \l_semio_assignment_columns_int } { & }
      \tabularnewline \hline
      #3
    \end{tabular}
  } {
    \PackageError { semio-assignment } { Positive~value-columns~required } { Select~one~or~more~writable~columns. }
  }
  \par \group_end:
}{}


\bool_new:N \l_semio_assignment_matrix_active_bool
\tl_new:N \l_semio_assignment_matrix_title_tl
\NewDocumentEnvironment { AssignmentTable } { m } {
  \group_begin:
  \bool_set_true:N \l_semio_assignment_matrix_active_bool
  \tl_set:Nn \l_semio_assignment_matrix_title_tl {#1}
} { \group_end: }
\cs_new:Npn \semio_assignment_matrix_chrome: {
  \use:c { semio@table@long@continuation@chrome }
    { \int_eval:n { \l_semio_assignment_type_columns_int + 1 } }
}

\int_new:N \l_semio_assignment_type_columns_int
\int_new:N \l_semio_assignment_parameter_rows_int
\dim_new:N \l_semio_assignment_matrix_header_dim
\dim_new:N \l_semio_assignment_matrix_padding_dim
\dim_new:N \l_semio_assignment_matrix_image_width_dim
\dim_new:N \l_semio_assignment_matrix_image_height_dim
\dim_new:N \l_semio_assignment_matrix_row_dim
\dim_new:N \l_semio_assignment_label_dim
\dim_new:N \l_semio_assignment_type_dim
\keys_define:nn { semio / assignment / matrix } {
  type-columns .int_set:N = \l_semio_assignment_type_columns_int,
  type-columns .initial:n = 8,
  parameter-rows .int_set:N = \l_semio_assignment_parameter_rows_int,
  parameter-rows .initial:n = 8,
  header-height .dim_set:N = \l_semio_assignment_matrix_header_dim,
  header-height .initial:n = 16mm,
  padding .dim_set:N = \l_semio_assignment_matrix_padding_dim,
  padding .initial:n = 2mm,
  row-height .dim_set:N = \l_semio_assignment_matrix_row_dim,
  row-height .initial:n = 6mm,
  label-width .dim_set:N = \l_semio_assignment_label_dim,
  label-width .initial:n = 27mm,
}
\cs_new_protected:Npn \semio_assignment_matrix_header_begin:n #1 {
  \vbox to \l_semio_assignment_matrix_header_dim \bgroup
    \vfil \hbox to #1 \bgroup \hfil
}
\cs_new_protected:Npn \semio_assignment_matrix_header_end: {
  \hfil \egroup \vfil \egroup
}
\cs_new:Npn \semio_assignment_matrix_writing_strut: {
  \rule[-.5\l_semio_assignment_matrix_row_dim]{0pt}{\l_semio_assignment_matrix_row_dim}
}
\cs_new:Npn \semio_assignment_matrix_writing_cell: {
  \multicolumn{1}{c|}{\semio_assignment_matrix_writing_strut:}
}
\cs_new:Npn \semio_assignment_matrix_blank_row: {
  \multicolumn{1}{|c|}{\semio_assignment_matrix_writing_strut:}
  \prg_replicate:nn { \l_semio_assignment_type_columns_int } { & \semio_assignment_matrix_writing_cell: }
  \tabularnewline \hline
}
\NewExpandableDocumentCommand \AssignmentParameterMatrixBlankRows { m } {
  \prg_replicate:nn {#1} { \semio_assignment_matrix_blank_row: }
}
\NewDocumentCommand \AssignmentMatrixImage { m } {
  \group_begin:
  \dim_set_eq:NN \l_semio_assignment_matrix_image_width_dim \l_semio_assignment_type_dim
  \dim_set:Nn \l_semio_assignment_matrix_image_height_dim {
    \l_semio_assignment_matrix_header_dim - 2 \l_semio_assignment_matrix_padding_dim
  }
  \str_if_eq:VnT \l_semio_theme_tl { dark } {
    \dim_sub:Nn \l_semio_assignment_matrix_image_width_dim { .8mm }
    \dim_sub:Nn \l_semio_assignment_matrix_image_height_dim { .8mm }
  }
  \AssignmentContrastImage[
    width=\l_semio_assignment_matrix_image_width_dim,
    height=\l_semio_assignment_matrix_image_height_dim,
    keepaspectratio
  ]{#1}
  \group_end:
}
\cs_new:Npn \semio_assignment_matrix_text:n #1 {
  \semio_assignment_matrix_writing_strut:
  \raisebox { \dim_eval:n { ( \depth - \height ) / 2 } } [ 0pt ] [ 0pt ] {#1}
}
\cs_new:Npn \semio_assignment_matrix_value:n #1 {
  & \multicolumn{1}{c|}{\semio_assignment_matrix_text:n {#1}}
}
\NewExpandableDocumentCommand \AssignmentParameterMatrixRow { m m } {
  \multicolumn{1}{|c|}{\semio_assignment_matrix_text:n {#1}}
  \clist_map_function:nN {#2} \semio_assignment_matrix_value:n
  \tabularnewline \hline
}
\NewDocumentEnvironment { AssignmentParameterMatrix } { O{} m +m +b } {
  \par \group_begin:
  \keys_set:nn { semio / assignment / matrix } {#1}
  \bool_lazy_and:nnTF
    { \int_compare_p:n { \l_semio_assignment_type_columns_int > 0 } }
    { \int_compare_p:n { \l_semio_assignment_parameter_rows_int > 0 } } {

    \cs_set_eq:NN \semio_assignment_matrix_top: \hline
    \bool_if:NT \l_semio_assignment_matrix_active_bool {
      \exp_args:NV \semio_table_long_open:n \l_semio_assignment_matrix_title_tl
      \cs_set_eq:NN \semio_assignment_matrix_top: \semio_assignment_matrix_chrome:
    }
    \setlength { \tabcolsep } { \l_semio_assignment_matrix_padding_dim }
    \renewcommand { \arraystretch } { 0 }
    \setlength { \extrarowheight } { 0pt }
    \dim_set:Nn \l_semio_assignment_type_dim {
      ( \linewidth - \l_semio_assignment_label_dim
        - \int_eval:n { 2 * ( \l_semio_assignment_type_columns_int + 1 ) } \tabcolsep
        - \int_eval:n { \l_semio_assignment_type_columns_int + 2 } \arrayrulewidth )
        / \int_use:N \l_semio_assignment_type_columns_int
    }
    \arrayrulecolor { semio-chrome-border-normal }
    \noindent
    \begin{tabular}{|>{\semio_assignment_matrix_header_begin:n {\l_semio_assignment_label_dim}}c<{\semio_assignment_matrix_header_end:}|*{\int_use:N\l_semio_assignment_type_columns_int}{>{\semio_assignment_matrix_header_begin:n {\l_semio_assignment_type_dim}}c<{\semio_assignment_matrix_header_end:}|}}
      \semio_assignment_matrix_top:
      \textbf{#2} & #3
      \tabularnewline \hline
      \tl_if_blank:nTF {#4} {
        \AssignmentParameterMatrixBlankRows{\l_semio_assignment_parameter_rows_int}
      } {#4}
    \end{tabular}
    \bool_if:NT \l_semio_assignment_matrix_active_bool { \semio_table_long_close: }
  } {
    \PackageError { semio-assignment } { Positive~matrix~dimensions~required } { Select~one~or~more~type~columns~and~parameter~rows. }
  }
} { \par \group_end: }
\str_if_eq:VnT \l_semio_type_tl { assignment } {
  \AtBeginDocument {
    \hypersetup { pdftitle = { \@title }, pdfauthor = { \@author } }
    \str_case:Vn \l_semio_language_tl {
      { en } { \hypersetup { pdflang = en-US } }
      { de } { \hypersetup { pdflang = de-DE } }
    }
  }
  \RenewDocumentCommand \maketitle { } { \semio_assignment_title: }
  \date{}
}
\ExplSyntaxOff
