% LR-winsep: external space BEFORE a window's frame. The generic 0.2em block
% separation is too small when the preceding element is a heading (a paragraph
% brings ~5pt of intrinsic leading, a window brings none), which left a
% table/figure frame flush against the heading bar. Use a dedicated window
% before-space so heading->window matches heading->paragraph (~5pt). Merges with
% the previous window's after-skip (0.85em still wins between two windows) and
% vanishes at the top of a page.
\providecommand{\semio@window@sep@before}{7pt}
\cs_new_protected:Npn \semio_block_sep_before: {
  \bool_if:NF \l_semio_window_in_item_bool {
    \use:c { semio@frame@open }
      { \bool_if:NTF \l_semio_register_list_bool { 0pt } { \use:c { semio@window@sep@before } } }
  }
}
% 🔒 Closes a block-level window frame so the next frame can share its bottom edge.
\cs_new_protected:Npn \semio_block_sep_after: {
  \bool_if:NF \l_semio_window_in_item_bool {
    \use:c { semio@frame@seal } { \use:c { semio@spacing@table@outer } - \parskip }
  }
}

