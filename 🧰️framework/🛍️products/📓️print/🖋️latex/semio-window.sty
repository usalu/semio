%region PageParity
% 📖 Sheet side comes from the count of shipped pages, never from \thepage: a
% digital deliverable restarts its numbering at 1 on whichever sheet follows the
% frontmatter, so the page number's parity stops naming the sheet side. The
% emblem and logo chips sit on the outer edge of both sides.
\newcounter{semio@shippedpages}
\AddToHook{shipout/before}{\stepcounter{semio@shippedpages}}
\newcommand{\Ifsemiopagerecto}[2]{%
  \ifodd\value{semio@shippedpages}#2\else#1\fi
}
\newcommand{\Ifsemiochromemirrored}[2]{%
  \if@twoside\Ifsemiopagerecto{#1}{#2}\else#2\fi
}
% 📐 Realigns the binding margins once the page number's parity has left the
% sheet side, so the gutter stays at the spine.
\newcommand{\semio@page@parity@align}{%
  \if@twoside
    \Ifsemiopagerecto
      {\ifodd\value{page}\else\semio@page@parity@swap\fi}%
      {\ifodd\value{page}\semio@page@parity@swap\fi}%
  \fi
}
\newcommand{\semio@page@parity@swap}{%
  \dimen@\oddsidemargin
  \global\oddsidemargin\evensidemargin
  \global\evensidemargin\dimen@
}
%endregion PageParity

\newcommand{\semio@chrome@bar@threezone}[4]{%
