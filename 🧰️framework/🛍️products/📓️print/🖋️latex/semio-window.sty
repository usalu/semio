}

%region WindowBreakParts chrome
% 🧩 Records (into the `.window-breaks` aux file, via
% \semio_window_break_record:n) how many page-parts this window instance
% rendered into on *this* compile pass — read back on the *next* pass by
% \semio_window_break_suffix_apply: to decide whether page 1's hierarchy
% chip needs a ":1" suffix. Wired into the `semio~window` tcbset style as
% `overlay unbroken=` / `overlay last=`.
% ⚠️ \newcommand bodies are tokenized *once*, in full, using whatever
% catcodes are active at the point of definition — an `\ExplSyntaxOn` token
% appearing *inside* an already-tokenized body cannot retroactively fix how
% the "_"/":" characters right after it were scanned. So this macro's
% *definition* (not just its body) must sit inside this ExplSyntaxOn wrapper
% for its l3 (`\semio_window_break_record:n`) call site to tokenize as a
% single control sequence. NB: ExplSyntaxOn also makes space (char 32) an
% *ignored* character, not just kept at catcode 10 — that's why the rest of
% this file spells literal spaces inside ExplSyntaxOn regions as "~"
% (tcbset's `before~skip=0pt` etc.); this macro has none, so it's unaffected.
\ExplSyntaxOn
\newcommand{\semio@window@break@record}[1]{%
  \semio_window_break_record:n {#1}%
}
\ExplSyntaxOff

% 🪟 Chips are finish layers inside every fragment's rectangle, painted after the
% content so they stay above images and text: the title chip anchors
% to the frame's top-left corner and the number chip to its top-right corner,
% both inset by the frame stroke so the top rule stays continuous. Part one shows
% the page-one number, later parts the live part number.
\newcommand{\semio@window@chips@number}{%
  \ifnum\value{tcbbreakpart}>1\relax
    \semio@window@header@number:\arabic{tcbbreakpart}%
  \else
    \semio@window@header@number@first
  \fi
}

\newcommand{\semio@window@chips@overlay}{%
  \protected@edef\semio@window@chips@title{\semio@window@header@title}%
  \protected@edef\semio@window@chips@numval{\semio@window@chips@number}%
  \if\relax\detokenize\expandafter{\semio@window@chips@title}\relax\else
    \node[anchor=north west, inner sep=0pt, outer sep=0pt] at ([shift={(\semio@stroke@hairline,-\semio@stroke@hairline)}]frame.north west) {%
      \semio@chip@pane{rb}{\semio@window@chips@title}%
    };%
  \fi
  \if\relax\detokenize\expandafter{\semio@window@chips@numval}\relax\else
    \node[anchor=north east, inner sep=0pt, outer sep=0pt] at ([shift={(-\semio@stroke@hairline,-\semio@stroke@hairline)}]frame.north east) {%
      \semio@chip@pane{lb}{\semio@window@chips@numval}%
    };%
  \fi
}

%endregion WindowBreakParts chrome

%region WindowWholeKeep
% 🧲 Split start of a breakable kind window: once the body height is known, a
% window that fits on one page moves there whole instead of breaking; only a
% window taller than a page breaks, and it starts on a fresh page when the room
% left cannot take its first lines or its leading unbreakable block. A body with
% no break point that fits a page stays one block. Every part carries its own
% chip overlay (\semio@window@chips@overlay).
\let\semio@window@tcb@split@start\tcb@split@start
\newif\ifsemio@window@whole@move
\newif\ifsemio@window@whole@solid
% 🧪 Sets \ifsemio@window@whole@move when no first part of the body fits #1.
\newcommand{\semio@window@whole@trial}[1]{%
  \begingroup
    \vbadness=\@M \vfuzz=\maxdimen \splittopskip=\z@ \splitmaxdepth=\z@
    \setbox\@tempboxa=\copy\tcb@upperbox
    \@tempdimb=\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax
    \@tempdimc=\dimexpr#1-\tcb@h@padding-\tcb@h@padtitle\relax
    \global\semio@window@whole@movefalse
    \ifdim\@tempdimc<\kvtcb@breakminlines\baselineskip
      \global\semio@window@whole@movetrue
    \else
      \setbox\z@=\vsplit\@tempboxa to\@tempdimc
      \ifnum\badness=1000000 \global\semio@window@whole@movetrue \fi
      \ifdim\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax=\@tempdimb \global\semio@window@whole@movetrue \fi
    \fi
  \endgroup
}
\newcommand{\semio@window@whole@split@start}{%
  \let\tcb@split@start\semio@window@tcb@split@start
  \tcb@breakat@init
  \tcb@comp@h@page
  \tcb@comp@h@total@standalone
  \@tempdima=\tcb@h@page
  \global\semio@window@whole@movefalse
  \global\semio@window@whole@solidfalse
  \ifdim\tcb@h@total>\@tempdima
    \ifdim\tcb@h@total>\vsize
      \semio@window@whole@trial{\vsize}%
      \ifsemio@window@whole@move
        \global\semio@window@whole@solidtrue
      \else
        \semio@window@whole@trial{\@tempdima}%
      \fi
    \else
      \global\semio@window@whole@movetrue
    \fi
  \fi
  \ifsemio@window@whole@move \pagebreak \fi
  \ifsemio@window@whole@solid \tcb@break@allowedfalse \fi
  \semio@window@tcb@split@start
}
%endregion WindowWholeKeep

% 🧭 The running-header chip follows the document's highest heading tier. Once a
% part appears, sections and every lower tier stop replacing it; documents whose
% highest tier is chapter or section keep that tier instead. A mark travels with
% the heading box, avoiding TeX page-builder read-ahead, while the global value
% covers pages without a fresh mark. Lower tiers repeat the retained root mark
% to supersede KOMA's numbered marks. \SemioNavShort is consumed by the next
% heading even when that heading is below the tracked tier, so it cannot leak.
\let\semio@nav@short@pending\relax
\newcommand{\SemioNavShort}[1]{\gdef\semio@nav@short@pending{#1}}
\newcommand{\semio@chrome@heading@set}[1]{%
  \ifx\semio@nav@short@pending\relax
    \gdef\semio@chrome@heading{#1}%
    \markright{#1}%
  \else
    \global\let\semio@chrome@heading\semio@nav@short@pending
    \expandafter\markright\expandafter{\semio@nav@short@pending}%
    \global\let\semio@nav@short@pending\relax
  \fi
}

\newcount\semio@chrome@heading@level
\newcount\semio@chrome@heading@candidate@level
\semio@chrome@heading@level=99\relax
\newcommand{\semio@chrome@heading@track}[2]{%
  \semio@chrome@heading@candidate@level=\numexpr\semio@toc@level{#1}\relax
  \ifnum\semio@chrome@heading@candidate@level<\semio@chrome@heading@level
    \global\semio@chrome@heading@level=\semio@chrome@heading@candidate@level
  \fi
  \ifnum\semio@chrome@heading@candidate@level=\semio@chrome@heading@level
    \semio@chrome@heading@set{#2}%
  \else
    \global\let\semio@nav@short@pending\relax
    \expandafter\markright\expandafter{\semio@chrome@heading}%
  \fi
}

%region Chip
% 🪟 One chip model for windows, figures, tables, headings and the page bars: a
% chip is a rectangle with its own surface that draws only its inner edges (the
% edges not on the component's frame), so it adds no seam, gap or overlap.
\newlength{\semio@chip@h}
\newlength{\semio@chip@w}
\newsavebox{\semio@chip@slot}
\newsavebox{\semio@chip@title@box}
\newsavebox{\semio@chip@number@box}
\newlength{\semio@chip@row@h}

% 🧊 Chip glass, derived from the design tokens (semio-tokens.sty). A chip lies one
% level above what it sits on: its surface is the glass of that level (the level
% colour at \semio@glass@alpha@<level>) under a veil of the foreground at
% \semio@chip@tint, so the content beneath shows through and the chip still reads
% as a surface of its own. The page canvas is the base level, so the chips of a
% heading and of the page bars are window glass; a window, figure or table is
% itself a window-level frame, so its chips are the glass of the pane level.
% \SemioChipTransparency{false} (profiles that forbid transparency, such as
% PDF/A-1) fills the same two layers flattened onto the canvas instead.
\newif\ifsemio@chip@glass
\semio@chip@glasstrue
\newcommand{\semio@chip@level}{window}
\newcommand{\semio@chip@surface}{semio-chrome-\semio@chip@level}
\newcommand{\semio@chip@alpha}{\csname semio@glass@alpha@\semio@chip@level\endcsname}
\newcommand{\semio@chip@alpha@pct}{\csname semio@glass@alpha@\semio@chip@level @pct\endcsname}
\newcommand{\SemioChipTransparency}[1]{\csname semio@chip@glass#1\endcsname}

\newcommand{\semio@chip@layer}[4]{%
  \rlap{\begin{pgfscope}\pgfsetfillopacity{#1}\textcolor{#2}{\rule{#3}{#4}}\end{pgfscope}}%
}

\newcommand{\semio@chip@fill}[3]{%
  \ifsemio@chip@glass
    \semio@chip@layer{\semio@chip@alpha}{#1}{#2}{#3}%
    \semio@chip@layer{\semio@chip@tint}{semio-chrome-foreground}{#2}{#3}%
  \else
    \textcolor{#1!\semio@chip@alpha@pct!semio-chrome-canvas!\semio@chip@tint@rest@pct!semio-chrome-foreground}{\rule{#2}{#3}}%
  \fi
}

% 📐 Chip height: the measured label slot plus symmetric vertical inset and the
% chip's own inner-edge hairline; one height for every chip of a row.
\newcommand{\semio@chip@h@set}{%
  \sbox{\semio@chip@slot}{\semio@heading@bar@font Ägjpqy()}%
  \setlength{\semio@chip@h}{%
    \dimexpr\ht\semio@chip@slot+\dp\semio@chip@slot
      +\semio@chip@inset@v+\semio@chip@inset@v+\semio@stroke@hairline\relax
  }%
  \setlength{\semio@chip@row@h}{\dimexpr\semio@chip@h+\semio@stroke@hairline\relax}%
}
\newcommand{\semio@window@top@clearance}{\dimexpr\semio@window@bodypad+\semio@chip@h\relax}
\newcommand{\semio@heading@frame@h}{\semio@chip@row@h}

\newcommand{\semio@window@stroke@h}[2]{%
  \textcolor{#1}{\rule{\dimexpr#2\relax}{\semio@stroke@hairline}}%
}

\newcommand{\semio@chip@edge}[3]{\in@{#1}{#2}\ifin@#3\fi}

% 🎨 Horizontal chip edges are neutral like every horizontal edge; only the
% vertical edges carry the chip's edge colour.
\newcommand{\semio@chip@edges}[2]{%
  \semio@chip@edge{t}{#1}{\rlap{\textcolor{semio-chrome-border-normal}{\vbox to \semio@chip@h{\hrule width\semio@chip@w height\semio@stroke@hairline\vss}}}}%
  \semio@chip@edge{b}{#1}{\rlap{\textcolor{semio-chrome-border-normal}{\vbox to \semio@chip@h{\vss\hrule width\semio@chip@w height\semio@stroke@hairline}}}}%
  \semio@chip@edge{l}{#1}{\rlap{\textcolor{#2}{\rule{\semio@stroke@hairline}{\semio@chip@h}}}}%
  \semio@chip@edge{r}{#1}{\rlap{\hbox to \semio@chip@w{\hfil\textcolor{#2}{\rule{\semio@stroke@hairline}{\semio@chip@h}}}}}%
}

% 🏷️ Arguments: inner edges (letters t b l r), fill colour, edge colour, label inset, content.
\newcommand{\semio@chip@box}[5]{%
  \sbox{\semio@chip@slot}{\begingroup#5\endgroup}%
  \setlength{\semio@chip@w}{\dimexpr\wd\semio@chip@slot+#4+#4\relax}%
  \hbox to \semio@chip@w{%
    \rlap{\semio@chip@fill{#2}{\semio@chip@w}{\semio@chip@h}}%
    \semio@chip@edges{#1}{#3}%
    \vbox to \semio@chip@h{\vfil\nointerlineskip\hbox to \semio@chip@w{\hfil\usebox{\semio@chip@slot}\hfil}\vfil}%
  }%
}

\newcommand{\semio@chip@pane}[2]{%
  \begingroup
    \renewcommand{\semio@chip@level}{pane}%
    \semio@chip@box{#1}{\semio@chip@surface}{semio-chrome-border-normal}{\semio@chip@inset}{%
      \semio@heading@bar@font\color{semio-chrome-foreground}#2%
    }%
  \endgroup
}
%endregion Chip

%region Headings
