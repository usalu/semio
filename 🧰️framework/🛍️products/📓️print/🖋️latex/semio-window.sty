% 📄️ The page is one frame column: the navbar rule is the top edge of the text
% area and the footer rule its bottom edge, each overlapping it by one hairline.
% A frame that starts or ends a page shares that rule; prose keeps its air
% through \topskip above and, below, through a zero \maxdepth and the body
% padding the footer rule keeps from the text area; a window part that breaks
% at the page end is drawn across that padding onto the rule.
\setlength{\headheight}{38.14006pt}
\setlength{\headsep}{-\semio@stroke@hairline}
\newlength{\semio@chrome@footer@reserve}
\setlength{\semio@chrome@footer@reserve}{\dimexpr\semio@chrome@footer@height-\semio@stroke@hairline\relax}
\newlength{\semio@chrome@page@gap}
\setlength{\semio@chrome@page@gap}{\dimexpr\semio@page@margin-\headheight-\semio@spacing@double\relax}
\geometry{
  includehead, includefoot,
  top=\semio@chrome@page@gap,
  headheight=\headheight,
  headsep=-\semio@stroke@hairline,
  bottom=\semio@chrome@page@gap,
  footskip=\dimexpr\semio@chrome@footer@reserve+\semio@window@bodypad\relax,
}
\AtBeginDocument{%
  \semio@column@inset
  \setlength{\topskip}{\dimexpr\topskip+\semio@spacing@double+\semio@stroke@hairline\relax}%
  \maxdepth\z@
  \@maxdepth\z@
}
