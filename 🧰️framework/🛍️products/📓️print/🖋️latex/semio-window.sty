% 📐️ The bar is lowered by the strut depth its header field ends with, so the
% navbar rule is the bottom of the head box and meets the text area.
\newcommand{\semio@chrome@navbar@bar}[1]{%
  \leavevmode\lower\dp\strutbox\vbox to \semio@chrome@navbar@height{%
    \semio@chrome@footerfalse
    \vfil
    \hbox{\semio@window@stroke@h{semio-chrome-border-normal}{\headwidth}}%
    \nointerlineskip
    \semio@chrome@band@row{#1}%
    \nointerlineskip
    \hbox{\semio@window@stroke@h{semio-chrome-border-normal}{\headwidth}}%
    \nointerlineskip
    \hbox to \headwidth{\semio@chrome@column@side\hfil\semio@chrome@column@side}%
  }%
}
% 🔲️ One bar row closed by the band's left and right edges, drawn above the chips so every chip shares them.
\newcommand{\semio@chrome@band@row}[1]{%
  \setbox\z@\hbox to \headwidth{#1}%
  \hbox to \headwidth{%
    \rlap{\copy\z@}%
    \textcolor{semio-chrome-border-normal}{\vrule width\semio@stroke@hairline height\ht\z@ depth\dp\z@}%
    \hfil
    \textcolor{semio-chrome-border-normal}{\vrule width\semio@stroke@hairline height\ht\z@ depth\dp\z@}%
  }%
}
% 📰️ One side border of the text column, hanging from the navbar rule down to the footer rule.
\newcommand{\semio@chrome@column@side}{%
  \smash{\textcolor{semio-chrome-border-normal}{%
    \vrule width\semio@stroke@hairline height\z@ depth\dimexpr\textheight+\semio@window@bodypad-\semio@stroke@hairline\relax}}%
}

% 📐️ The bar is smashed onto the foot baseline, which \footskip puts one bar
% height minus a hairline below the text area: the footer rule is its bottom edge.
\newcommand{\semio@chrome@footer@bar}[1]{%
  \leavevmode\smash{\vbox to \dimexpr\semio@chrome@footer@reserve+\semio@stroke@hairline\relax{%
    \semio@chrome@footertrue
    \hbox{\semio@window@stroke@h{semio-chrome-border-normal}{\headwidth}}%
    \nointerlineskip
    \semio@chrome@band@row{#1}%
    \nointerlineskip
    \hbox{\semio@window@stroke@h{semio-chrome-border-normal}{\headwidth}}%
    \vfil
  }}%
}

