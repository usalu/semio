\cs_new_protected:Npn \semio_window_register_body_macro_apply:n #1 {
  \group_begin:
  \ExplSyntaxOff
  \makeatletter
  \gdef\semio@register@table@body{}
  \makeatother
  \group_end:
  \int_step_inline:nn { \seq_count:c { g_semio_register_ #1 _num_seq } } {
    \tl_set:Nx \l_tmpb_tl { \seq_item:cn { g_semio_register_ #1 _num_seq } { ##1 } }
    \tl_set:Nx \l_tmpc_tl { \seq_item:cn { g_semio_register_ #1 _title_seq } { ##1 } }
    \str_set:Nx \l_tmpd_str { \seq_item:cn { g_semio_register_ #1 _label_seq } { ##1 } }
    \tl_set:Nx \l_tmpe_tl { \str_use:N \l_tmpd_str }
    \str_if_eq:nnTF {#1} {toc}
      { \semio_window_toc_body_gappto:VVV \l_tmpb_tl \l_tmpc_tl \l_tmpe_tl }
      { \semio_window_register_body_gappto:VVV \l_tmpb_tl \l_tmpc_tl \l_tmpe_tl }
  }
}

