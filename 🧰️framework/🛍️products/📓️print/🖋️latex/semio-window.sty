          {{\def\semio@chrome@chip@edges{r}#2}\hfil{\def\semio@chrome@chip@edges{l}#4}}%
      }%
      \vfil
    }%
  }%
  \sbox\semio@chrome@bar@center@box{%
    \vbox to \dimexpr#1-\semio@stroke@hairline\relax{%
      \vfil
      \hbox to \headwidth{%
        \hfil
        #3%
        \hfil
      }%
      \vfil
    }%
  }%
  \hbox to \headwidth{%
    \usebox\semio@chrome@bar@edge@box
    \hskip-\wd\semio@chrome@bar@edge@box
