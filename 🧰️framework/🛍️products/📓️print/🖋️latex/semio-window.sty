  % LR-2.6: keep the shared 0.5em document \parskip (above) from leaking into
  % compact list contexts, where it would loosen inter-item spacing past the
  % surrounding body text. Reset it locally at each list start via etoolbox hooks
  % (this build's LaTeX predates the kernel env/.../begin hooks).
  \AtBeginEnvironment{itemize}{\setlength{\parskip}{\z@}}%
  \AtBeginEnvironment{enumerate}{\setlength{\parskip}{\z@}}%
  \AtBeginEnvironment{description}{\setlength{\parskip}{\z@}}%
  \ifcsname chapterheadstartvskip\endcsname
    \renewcommand*{\chapterheadstartvskip}{}%
    \renewcommand*{\chapterheadendvskip}{}%
  \fi
  \semio@chrome@dims@compute
  \setcounter{tocdepth}{\semio@toc@depth@unlimited}
  % 🪜 Every heading level through \subparagraph gets its own chip color and
  % chip style (\semio@heading@installall below), so every level must also
  % actually be numbered — KOMA's own default secnumdepth (3, chapter…
  % subsubsection) silently leaves \paragraph/\subparagraph unnumbered, which
  % breaks their \the<level> composition (a frozen, never-stepped counter
  % renders as a phantom "…0" segment) without any visual sign that numbering
  % was skipped, since the chip still renders regardless.
  \setcounter{secnumdepth}{\semio@toc@depth@unlimited}
  \semio@hierarchy@hooks@install
  \semio@heading@installall
  \makeatother
  \ExplSyntaxOn
  \semio_chrome_footer_install:
  \semio_header_footer_apply:
  \ExplSyntaxOff
}

