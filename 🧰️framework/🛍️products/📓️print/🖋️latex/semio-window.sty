% 🔲 A heading opens the frame of its section: the frame's top edge, shared with
% the section above and therefore neutral, with the title chip at the start and
% the number chip at the end inside it. The chips are in-content, so nothing runs
% below the chip row; each chip draws only its inner edges in the ladder colour,
% and the frame's sides are the text column's.
\newcommand{\semio@heading@frame@row}{%
  \hbox to \linewidth{%
    \rlap{\textcolor{semio-chrome-border-normal}{\vbox to \semio@heading@frame@h{\hrule width\linewidth height\semio@stroke@hairline\vss}}}%
    \hskip\semio@stroke@hairline
    \smash{\usebox{\semio@chip@title@box}}%
    \hfil
    \smash{\usebox{\semio@chip@number@box}}%
    \hskip\semio@stroke@hairline
    \vrule width\z@ height\semio@heading@frame@h
  }%
}

% 🪜 Arguments: vertical edge colour, title, number.
\newcommand{\semio@heading@label@color}{semio-chrome-foreground}
\newcommand{\semio@heading@frame}[3]{%
  \sbox{\semio@chip@title@box}{%
    \semio@chip@box{rb}{\semio@chip@surface}{#1}{\semio@chip@inset}{\semio@heading@bar@font\color{\semio@heading@label@color}#2}%
  }%
  \sbox{\semio@chip@number@box}{%
    \if\relax\detokenize{#3}\relax\else
      \semio@chip@box{lb}{\semio@chip@surface}{#1}{\semio@chip@inset}{\semio@heading@bar@font\color{\semio@heading@label@color}#3}%
    \fi
  }%
  \semio@heading@row@wrap{\semio@heading@frame@row}%
}

\newcommand{\semio@heading@bar}[3]{%
  \if\relax\detokenize{#3}\relax
    \semio@heading@frame{#1}{#2}{}%
  \else
    \semio@hierarchy@path@set{\csname the#3\endcsname}%
    \semio@heading@frame{#1}{#2}{\semio@kind@number@bare{\csname the#3\endcsname}}%
  \fi
}

\newcommand{\semio@toc@level@part}{-1}
\newcommand{\semio@toc@level@chapter}{0}
\newcommand{\semio@toc@level@section}{1}
\newcommand{\semio@toc@level@subsection}{2}
\newcommand{\semio@toc@level@subsubsection}{3}
\newcommand{\semio@toc@level@paragraph}{4}
\newcommand{\semio@toc@level@subparagraph}{5}
\newcommand{\semio@toc@depth@unlimited}{99}

\newcommand{\semio@toc@level}[1]{%
  \ifcsname semio@toc@level@#1\endcsname
    \csname semio@toc@level@#1\endcsname
  \else
    10%
  \fi
}

\newcommand{\semio@toc@track@heading}[2]{%
  \ifnum\numexpr\semio@toc@level{#1}\relax>\value{tocdepth}\else
    \semio@toc@track@num{#1}{\csname the#1\endcsname}{#2}%
  \fi
}

\newcommand{\semio@toc@track@heading@num}[3]{%
  \ifnum\numexpr\semio@toc@level{#1}\relax>\value{tocdepth}\else
    \semio@toc@track@num{#1}{#2}{#3}%
  \fi
}

% LR-topspace: tunable extra breathing room above every display heading
% (section / subsection / subsubsection / paragraph / appendix). Applied in the
% shared dispatch below via \addvspace, which merges with the block-before glue
% (no double gap) and is dropped at the top of a page (leading headings aren't
% pushed down). Adjust this one length to taste.
\providecommand{\semio@heading@topskip}{1.28em}
% LR-bottomskip: dedicated space BELOW every heading bar, before the body text
% (KOMA's afterskip is pinned to 1sp, so without this there is no knob). Used by
% \semio@koma@heading@lines and the nested-paragraph renderer below; may be
% negative to tighten below the natural minimum.
\providecommand{\semio@heading@bottomskip}{-1.38pt}
\def\semio@heading@level@chapter{chapter}
\newcommand{\semio@heading@chapter@baselineskip}{\baselineskip}
\AtBeginDocument{\edef\semio@heading@chapter@baselineskip{\the\baselineskip}}
\newcommand{\semio@koma@heading@lines}[4]{%
  \def\semio@heading@level@now{#1}%
  \ifx\semio@heading@level@now\semio@heading@level@chapter
    \semio@frame@open{0pt}%
  \else
    \semio@frame@open{\semio@block@sep@skip}%
  \fi
  \ifsemio@frame@interlocked\else
    \ifx\semio@heading@level@now\semio@heading@level@chapter
      % 📄️ A chapter opens its page: KOMA has put an empty box and
      % -\parskip-\baselineskip there, so what is left of \topskip is cancelled
      % and the chapter frame starts on the navbar rule.
      \vskip\dimexpr\parskip+\semio@heading@chapter@baselineskip-\topskip\relax
      \nointerlineskip
    \else
      \addvspace{\semio@heading@topskip}% LR-topspace: a bit more air above headings
    \fi
  \fi
  % 🧲 Keep the heading bar with its first lines of content so it never sits
  % orphaned at the foot of a page (reserves the bar + ~3 body lines; if that
  % much space isn't left, the heading moves to the next page as one unit).
  % LR-2.7: reserve a SECOND title bar's worth on top, so a heading that
  % introduces a table (heading -> optional "N Fälle." count -> table title bar)
  % keeps that title bar with it instead of stranding the heading at the page
  % foot above a table that migrated to the next page.
  \Needspace*{\dimexpr\semio@heading@frame@h+3\baselineskip+\semio@heading@frame@h\relax}%
  \ifnum\numexpr\semio@toc@level{#1}\relax>\value{tocdepth}\else
    \if\relax\detokenize{#4}\relax
      \semio@toc@track@num{#1}{}{#3}%
    \else
      \semio@toc@track@num{#1}{\csname the#1\endcsname}{#3}%
    \fi
  \fi
  \semio@chrome@heading@track{#1}{#3}%
  \semio@if@heading@chips
    {%
      \if\relax\detokenize{#4}\relax
        \semio@heading@bar{#2}{#3}{}%
      \else
        \semio@heading@bar{#2}{#3}{#1}%
      \fi
    }%
    {#3}%
  \vspace{\semio@heading@bottomskip}% LR-bottomskip: space below the heading bar
  \par
  \semio@frame@record{\semio@heading@bottomskip+1sp}%
}

\newcommand{\semio@heading@lines@dispatch}[4]{%
  \semio@koma@heading@lines{#1}{\csname semio@heading@color@#1\endcsname}{#4}{#3}%
}

\newcommand{\semio@heading@install@spacing}[1]{%
  % 🪝 KOMA suppresses beforeskip when a heading directly follows another
  % heading (\@nobreak); the real before-space is emitted unconditionally
  % by \semio@block@before inside \semio@koma@heading@lines instead. Both
  % skips stay a strictly positive 1sp only so KOMA keeps display-style
  % (not run-in) heading placement — see \@xsect.
  \RedeclareSectionCommand[
    beforeskip=1sp,
    afterskip=1sp,
  ]{#1}%
}

% 🪜 The heading ladder assigns each brand colour to the inner vertical edge
% for two consecutive rungs. Deeper headings step down through neutral edges.
% Rungs are handed out by a level's position in the *class's own* heading
% sequence, never by its name: an article-style class has no \chapter, so its
% \section takes the rung \chapter would have held. \semio@heading@rung@<level>
% keeps each level's number so the nested-paragraph chips (which sit below the
% deepest numbered level, see NestedParagraphs) can carry on down the same
% ladder rather than starting a second one.
% {@link https://github.com/usalu/semio/issues/2429}
\newcommand{\semio@heading@ladder@color}[1]{%
  \ifcase#1 semio-tertiary%
  \or semio-tertiary%
  \or semio-secondary%
  \or semio-secondary%
  \or semio-primary%
  \or semio-primary%
  \or semio-chrome-panel%
  \or semio-chrome-border-emphasized%
  \else semio-chrome-border-normal%
  \fi
}

\newcommand{\semio@heading@ladder@step}[1]{%
  \expandafter\edef\csname semio@heading@rung@#1\endcsname{\number\@tempcnta}%
  \expandafter\edef\csname semio@heading@color@#1\endcsname{%
    \semio@heading@ladder@color{\number\@tempcnta}%
  }%
  \advance\@tempcnta\@ne
}

\newcommand{\semio@heading@ladder@install}{%
  \@tempcnta\z@
  \semio@heading@ladder@step{part}%
  \ifcsname chapter\endcsname
    \semio@heading@ladder@step{chapter}%
  \fi
  \semio@heading@ladder@step{section}%
  \semio@heading@ladder@step{subsection}%
  \semio@heading@ladder@step{subsubsection}%
  \semio@heading@ladder@step{paragraph}%
  \semio@heading@ladder@step{subparagraph}%
}

\newcommand{\semio@heading@installall}{%
  \semio@heading@ladder@install
  \ifcsname chapter\endcsname
    \setkomafont{chapter}{\semio@heading@chip@font}%
  \fi
  \setkomafont{section}{\semio@heading@chip@font}%
  \setkomafont{subsection}{\semio@heading@chip@font}%
  \setkomafont{subsubsection}{\semio@heading@chip@font}%
  \setkomafont{paragraph}{\semio@heading@chip@font}%
  \setkomafont{subparagraph}{\semio@heading@chip@font}%
  \let\semio@orig@sectionlinesformat\sectionlinesformat
  \RenewDocumentCommand\sectionlinesformat{mmmm}{%
    \semio@heading@lines@dispatch{##1}{##2}{##3}{##4}%
  }%
  \ifcsname chapterlinesformat\endcsname
    \let\semio@orig@chapterlinesformat\chapterlinesformat
    \RenewDocumentCommand\chapterlinesformat{mmm}{%
      \semio@koma@heading@lines{chapter}{\semio@heading@color@chapter}{##3}{##2}%
    }%
  \fi
  \ifcsname partlineswithprefixformat\endcsname
    \let\semio@orig@partlineswithprefixformat\partlineswithprefixformat
    \RenewDocumentCommand\partlineswithprefixformat{mmm}{%
      \def\semio@part@kind{part}%
      \def\semio@part@kind@got{##1}%
      \ifx\semio@part@kind@got\semio@part@kind
        \edef\semio@part@title{\@currentheadentry}%
        \edef\semio@part@invoke{%
          \noexpand\semio@koma@heading@lines{part}{\semio@heading@color@part}%
          {\semio@part@title}{\unexpanded{##2}}%
        }%
        \semio@part@invoke
      \else
        \semio@orig@partlineswithprefixformat{##1}{##2}{##3}%
      \fi
    }%
  \fi
  \ifcsname chapter\endcsname
    \semio@heading@install@spacing{chapter}%
  \fi
  \semio@heading@install@spacing{part}%
  \semio@heading@install@spacing{section}%
  \semio@heading@install@spacing{subsection}%
  \semio@heading@install@spacing{subsubsection}%
  \semio@heading@install@spacing{paragraph}%
  \semio@heading@install@spacing{subparagraph}%
  % 🪜 \newcounter{paragraph}[subsubsection] resets paragraph whenever
  % subsubsection steps, but a document may nest \paragraph directly under
  % \subsection (skipping \subsubsection, e.g. the appendix user-story list)
  % — that \subsection call still resets subsubsection to 0, so the kernel's
  % default \theparagraph (always \thesubsubsection.\arabic{paragraph}) would
  % render a phantom ".0." segment for a level that was never actually used.
  % Drop that segment only when subsubsection is genuinely unused (=0); once
  % \subsubsection *is* called, its counter is nonzero and the normal 4-level
  % form composes exactly as before.
  \renewcommand{\theparagraph}{%
    \ifnum\c@subsubsection=\z@
      \thesubsection.\arabic{paragraph}%
    \else
      \thesubsubsection.\arabic{paragraph}%
    \fi
  }%
}

%endregion Headings

%region NestedParagraphs
\newcounter{semio@nest@depth}
\newcounter{semio@nest@a}
\newcounter{semio@nest@b}[semio@nest@a]
\newcounter{semio@nest@c}[semio@nest@b]
\newcounter{semio@nest@d}[semio@nest@c]
\newcounter{semio@nest@e}[semio@nest@d]

\newcommand{\semio@nest@counter@reset}{%
  \ifcase\value{semio@nest@depth}\or
    \setcounter{semio@nest@a}{0}\or
    \setcounter{semio@nest@b}{0}\or
    \setcounter{semio@nest@c}{0}\or
    \setcounter{semio@nest@d}{0}\or
    \setcounter{semio@nest@e}{0}%
  \fi
}

\newcommand{\semio@nest@counter@step}{%
  \ifcase\value{semio@nest@depth}\or
    \stepcounter{semio@nest@a}\or
    \stepcounter{semio@nest@b}\or
    \stepcounter{semio@nest@c}\or
    \stepcounter{semio@nest@d}\or
    \stepcounter{semio@nest@e}%
  \fi
}

\newcommand{\semio@nest@build@number}{%
  \ifnum\c@paragraph>\z@ \theparagraph\else \thesubsubsection\fi
  \ifnum\value{semio@nest@depth}>0 .\thesemio@nest@a\fi
  \ifnum\value{semio@nest@depth}>1 .\thesemio@nest@b\fi
  \ifnum\value{semio@nest@depth}>2 .\thesemio@nest@c\fi
  \ifnum\value{semio@nest@depth}>3 .\thesemio@nest@d\fi
  \ifnum\value{semio@nest@depth}>4 .\thesemio@nest@e\fi
}

% 🎨 Nested paragraphs keep walking the heading ladder (see Headings) instead of
% starting a palette of their own: a nest chip sits exactly one rung below the
% level whose number it extends — \paragraph once that level has been used,
% \subsubsection otherwise, mirroring \semio@nest@build@number — and each extra
% depth steps one rung further. Depths past the last brand pair land on the
% ladder's neutral edges.
\newcommand{\semio@nest@color@resolve}{%
  \ifnum\c@paragraph>\z@
    \edef\semio@nest@rung{\number\numexpr\semio@heading@rung@paragraph+\value{semio@nest@depth}\relax}%
  \else
    \edef\semio@nest@rung{\number\numexpr\semio@heading@rung@subsubsection+\value{semio@nest@depth}\relax}%
  \fi
  \edef\semio@nest@color{\semio@heading@ladder@color{\semio@nest@rung}}%
}

\newcommand{\semio@nest@paragraph}[1]{%
  \semio@frame@open{\semio@block@sep@skip}%
  \ifsemio@frame@interlocked\else
    \addvspace{\semio@heading@topskip}% LR-topspace: same extra air above nested-paragraph headings (SemioNest redefines \paragraph to this, bypassing the main dispatch)
  \fi
  % LR-orphanfix: nested-paragraph headings bypass \semio@koma@heading@lines and
  % so never got its keep-with-next reservation, leaving them stranded at the
  % page foot (e.g. "Gestaltung", "Tragwerksplanung"). Reserve the bar + ~3 body
  % lines so the heading moves to the next page with its content as one unit.
  \Needspace*{\dimexpr\semio@heading@frame@h+3\baselineskip\relax}%
  \semio@nest@counter@step
  \edef\semio@nest@num{\semio@nest@build@number}%
  % 🎯 The number is composed by hand, so no \refstepcounter ever announces it:
  % publish it and an anchor here, or a \label after a nested heading resolves
  % to the enclosing level's number and destination.
  \phantomsection
  \protected@edef\@currentlabel{\semio@nest@num}%
  \ifnum\numexpr\semio@toc@level@subparagraph+\value{semio@nest@depth}\relax>\value{tocdepth}\else
    \semio@toc@track@num{paragraph}{\semio@nest@num}{#1}%
  \fi
  \semio@nest@color@resolve
  \semio@hierarchy@path@set{\semio@nest@num}%
  \begingroup
  \semio@heading@frame{\semio@nest@color}{#1}{\semio@kind@number@bare{\semio@nest@num}}%
  \semio@block@after
  \endgroup
  \semio@frame@close{\semio@heading@bottomskip}% LR-bottomskip: space below nested-paragraph headings
}

\newenvironment{SemioNest}{%
  \stepcounter{semio@nest@depth}%
  \semio@nest@counter@reset
  \begingroup
  \let\semio@saved@paragraph\paragraph
  \def\paragraph{\semio@nest@paragraph}%
}{%
  \endgroup
  \addtocounter{semio@nest@depth}{-1}%
}
%endregion NestedParagraphs

%region WindowChipRow
% 🪟 Chip row of a frameless table: the frame's top rule, its two side strokes and
% the chips inside, one rectangle band as wide as the table. The title chip sits
% at the start, the number chip at the end; both are inset by the frame stroke.
\newcommand{\semio@window@chiprow}[2]{%
  \semio@window@chips@store{#1}{#2}%
  \ifvmode\else\par\fi
  \semio@noindent@noparskip
  \vbox{%
    \hbox to \linewidth{\semio@window@stroke@h{semio-chrome-border-normal}{\linewidth}}%
    \nointerlineskip
    \hbox to \linewidth{%
      \rlap{\textcolor{semio-chrome-border-normal}{\rule{\semio@stroke@hairline}{\semio@chip@h}}}%
      \rlap{\hbox to \linewidth{\hfil\textcolor{semio-chrome-border-normal}{\rule{\semio@stroke@hairline}{\semio@chip@h}}}}%
      \hskip\semio@stroke@hairline
      \semio@window@chips@band{\linewidth-2\dimexpr\semio@stroke@hairline\relax}%
    }%
  }%
  \ifvmode\nointerlineskip\fi
}
% 🏷️ The chips of a chip row without its strokes: stored once, then laid as one
% band whose ends touch the frame's inner side edges. A grid that draws its own
% rules lays the band inside its first row, so its dividers reach the top edge.
\newcommand{\semio@window@chips@store}[2]{%
  \protected@edef\semio@window@chiprow@title{#2}%
  \edef\semio@window@chiprow@number{#1}%
  \sbox{\semio@chip@title@box}{%
    \if\relax\detokenize\expandafter{\semio@window@chiprow@title}\relax\else
      \semio@chip@pane{rb}{#2}%
    \fi
  }%
  \sbox{\semio@chip@number@box}{%
    \if\relax\detokenize\expandafter{\semio@window@chiprow@number}\relax\else
      \semio@chip@pane{lb}{#1}%
    \fi
  }%
}
\newcommand{\semio@window@chips@band}[1]{%
  \hbox to \dimexpr#1\relax{\usebox{\semio@chip@title@box}\hfil\usebox{\semio@chip@number@box}}%
}
%endregion WindowChipRow

%region WindowArrangement
% H/V pitch between tiles: neighbouring tiles overlap by one hairline, so they share
% their border instead of being separated by a gap. Formerly synced to \semio@spacing@par in
% \AfterEndPreamble — same unit as paragraph \parskip.
\newlength{\semio@window@gap}
\setlength{\semio@window@gap}{-\semio@stroke@hairline}
\gdef\semio@window@valign{top}
\gdef\semio@window@halign{left}
\newcommand{\semio@window@height@dim}{}
\newcommand{\semio@image@target@w@plain}{0pt}
\newcommand{\semio@image@target@h@plain}{0pt}
\newcommand{\semio@image@graphics@none}[1]{\leavevmode\includegraphics{#1}}
\newcommand{\semio@image@graphics@w}[2]{\leavevmode\includegraphics[width=#1, keepaspectratio=true]{#2}}
\newcommand{\semio@image@graphics@wh}[3]{\leavevmode\includegraphics[width=#1, height=#2, keepaspectratio=true]{#3}}
\newcommand{\semio@image@graphics@fill}[3]{\leavevmode\includegraphics[width=#1, height=#2, keepaspectratio=false]{#3}}
\def\semio@tcb@variant@table{table}
\def\semio@tcb@variant@row{row}
\def\semio@tcb@variant@fit{fit}
\def\semio@tcb@variant@default{default}
\makeatletter
\newsavebox{\semio@window@textfit@box}
\newlength{\semio@window@textfit@target@h}
\newcommand{\semio@window@textfit@typeset}[1]{%
  \ifdim\semio@window@textfit@target@h>2pt
    \setbox\semio@window@textfit@box=\hbox{%
      \resizebox{\linewidth}{!}{%
        \vbox{\hsize=\linewidth\raggedright#1}%
      }%
    }%
    \dimen1=\dimexpr\ht\semio@window@textfit@box+\dp\semio@window@textfit@box\relax
    \ifdim\dimen1>\semio@window@textfit@target@h
      \leavevmode\hbox to \linewidth{%
        \scalebox{\ratio{\semio@window@textfit@target@h}{\dimen1}}{\usebox\semio@window@textfit@box}%
        \hfill
      }%
    \else
      \leavevmode\hbox to \linewidth{\box\semio@window@textfit@box\hfill}%
    \fi
  \else
    \leavevmode\hbox to \linewidth{%
      \vbox{\hsize=\linewidth\raggedright#1}%
      \hfill
    }%
  \fi
}

\newcommand{\semio@window@row@col}[2]{%
  \begin{minipage}[t]{#1}\raggedright #2\end{minipage}%
}

\ExplSyntaxOn

\NewDocumentCommand \WindowItem { O{1} +m } {
  \exp_args:Nc \seq_gput_right:Nn { \semio_window_frame_weight_seq_name: } {#1}
  \exp_args:Nc \seq_gput_right:Nn { \semio_window_frame_body_seq_name: } {#2}
}

% \int_step_inline:nn/\seq_map_inline:Nn are not safe to nest (l3kernel shares
% one internal loop-body macro across all active calls of the same name), and
% a WindowRow/WindowColumn item's captured body can itself open a nested
% WindowRow/WindowColumn, which would re-enter the same inline loop. These two
% renderers thread the loop index/count as real per-call macro parameters
% instead, which is always safe to nest or recurse. They read the CURRENT
% frame's dims/body seqs (see \semio_window_frame_push:) at the point each
% item is rendered — always the caller's own frame, since a nested
% WindowRow/WindowColumn rendered along the way pushes/pops its own frame
% around itself without disturbing the caller's.
\cs_new_protected:Npn \semio_window_row_items_render:nn #1 #2 {
  \int_compare:nNnF {#1} > {#2} {
    \group_begin:
      \semio_window_item_provide:n { \dim_use:N \l_semio_window_height_dim }
      \semio@window@row@col
        { \exp_args:Nc \seq_item:Nn { \semio_window_frame_dims_seq_name: } {#1} }
        { \exp_args:Nc \seq_item:Nn { \semio_window_frame_body_seq_name: } {#1} }
    \group_end:
    \int_compare:nNnF {#1} = {#2} { \hspace{\semio@window@gap} }
    \semio_window_row_items_render:nn { \int_eval:n { #1 + 1 } } {#2}
  }
}

\cs_new_protected:Npn \semio_window_column_items_render:nn #1 #2 {
  \int_compare:nNnF {#1} > {#2} {
    \int_compare:nNnT {#1} > { 1 } { \vspace{\semio@window@gap} }
    \group_begin:
      \semio_window_item_provide:n { \exp_args:Nc \seq_item:Nn { \semio_window_frame_dims_seq_name: } {#1} }
      \exp_args:Nc \seq_item:Nn { \semio_window_frame_body_seq_name: } {#1}
    \group_end:
    \semio_window_column_items_render:nn { \int_eval:n { #1 + 1 } } {#2}
  }
}

\NewDocumentEnvironment { WindowRow } { O{} } {
  \group_begin:
  \semio_window_arrangement_height_adopt:
  \semio_window_frame_push:
} {
  \semio_window_weights_to_dims:nn { \linewidth } { 0pt }
  \noindent\hbox to \linewidth{
    \semio_window_row_items_render:nn { 1 } { \semio_window_frame_weight_count: }
  }\par
  \prevdepth\z@\nointerlineskip
  \semio_window_frame_pop:
  \group_end:
}

% 📏 A column owns its declared height exactly. Chips are overlays inside each
% frame, so the chrome each item adds around its height=X body is measured from reference windows rendered through
% the column's own item loop — never estimated from tokens. One reference item
% yields the leading chrome, the step from one to two yields the item pitch;
% both feed \semio_window_weights_to_dims:nn so the bodies sum to the height.
\box_new:N \l_semio_window_column_probe_box
\dim_new:N \l_semio_window_column_probe_body_dim
\dim_new:N \l_semio_window_column_probe_one_dim
\dim_new:N \l_semio_window_column_probe_two_dim
\dim_new:N \l_semio_window_column_chrome_dim
\dim_new:N \l_semio_window_column_lead_dim

\cs_new_protected:Npn \semio_window_column_probe:nN #1 #2 {
  \semio_window_frame_push:
  \prg_replicate:nn {#1} {
    \exp_args:Nc \seq_put_right:Nx { \semio_window_frame_dims_seq_name: }
      { \dim_use:N \l_semio_window_column_probe_body_dim }
    \exp_args:Nc \seq_gput_right:Nn { \semio_window_frame_body_seq_name: }
      { \begin{Window}[title={Ägjpqy}]\end{Window} }
  }
  \vbox_set:Nn \l_semio_window_column_probe_box {
