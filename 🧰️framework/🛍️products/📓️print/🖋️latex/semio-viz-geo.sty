            \tl_set:Nn \l_semio_viz_geo_clipangle_tl { 90.000001 }
          }
        { stereographic }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 250 }
            \tl_set:Nn \l_semio_viz_geo_clipangle_tl { 142 }
          }
        { gnomonic }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 144.049 }
            \tl_set:Nn \l_semio_viz_geo_clipangle_tl { 60 }
          }
        { azimuthal-equal-area }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 124.75 }
            \tl_set:Nn \l_semio_viz_geo_clipangle_tl { 179.999 }
          }
        { azimuthal-equidistant }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 79.4188 }
            \tl_set:Nn \l_semio_viz_geo_clipangle_tl { 179.999 }
          }
        { conic-conformal }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 109.5 }
            \clist_set:Nn \l_semio_viz_geo_parallels_clist { 30, 30 }
          }
        { conic-equal-area }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 155.424 }
            \clist_set:Nn \l_semio_viz_geo_center_clist { 0, 33.6442 }
          }
        { conic-equidistant }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 131.154 }
            \clist_set:Nn \l_semio_viz_geo_center_clist { 0, 13.9389 }
          }
        { albers }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 1070 }
            \clist_set:Nn \l_semio_viz_geo_center_clist { -0.6, 38.7 }
            \clist_set:Nn \l_semio_viz_geo_rotate_clist { 96, 0, 0 }
            \clist_set:Nn \l_semio_viz_geo_parallels_clist { 29.5, 45.5 }
          }
      }
      { \msg_error:nnn { semio-viz } { unknown-projection-kind } {#1} }
  }

% 🧮 Turns the kind and its parallels into the effective raw projection and its conic constants (d3 conicProjection).
\cs_new_protected:Npn \semio_viz_geo_derive_conic:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      {
        \clist_item:Nn \l_semio_viz_geo_parallels_clist { 1 }
        * \c_semio_viz_geo_radians_fp
      }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      {
        \clist_item:Nn \l_semio_viz_geo_parallels_clist { 2 }
        * \c_semio_viz_geo_radians_fp
      }
    \fp_set:Nn \l_semio_viz_geo_cosphistd_fp { cos ( \l_semio_viz_geo_tmpa_fp ) }
    \exp_args:NV \semio_viz_geo_derive_dispatch:n \l_semio_viz_geo_raw_tl
  }

% 🧮 Derives the conic constants of the kind #1; a non-conic kind has none and needs no branch.
\cs_new_protected:Npn \semio_viz_geo_derive_dispatch:n #1
  {
    \str_case:nn {#1}
      {
        { conic-conformal } { \semio_viz_geo_derive_conformal: }
        { conic-equal-area } { \semio_viz_geo_derive_equal_area: }
        { conic-equidistant } { \semio_viz_geo_derive_equidistant: }
      }
  }

% 🧮 The cone constant and scale of `conic-conformal`; a vanishing constant means the cone has
% opened into the Mercator cylinder, and the raw projection is swapped for it.
\cs_new_protected:Npn \semio_viz_geo_derive_conformal:
  {
    \fp_compare:nNnTF \l_semio_viz_geo_tmpa_fp = \l_semio_viz_geo_tmpb_fp
      {
        \fp_set:Nn \l_semio_viz_geo_n_fp { sin ( \l_semio_viz_geo_tmpa_fp ) }
      }
      {
        \fp_set:Nn \l_semio_viz_geo_n_fp
          {
            ln ( cos ( \l_semio_viz_geo_tmpa_fp )
                 / cos ( \l_semio_viz_geo_tmpb_fp ) )
            / ln ( tan ( ( pi / 2 + \l_semio_viz_geo_tmpb_fp ) / 2 )
                   / tan ( ( pi / 2 + \l_semio_viz_geo_tmpa_fp ) / 2 ) )
          }
      }
    \fp_compare:nNnTF \l_semio_viz_geo_n_fp = { 0 }
      { \tl_set:Nn \l_semio_viz_geo_raw_tl { mercator } }
      {
        \fp_set:Nn \l_semio_viz_geo_f_fp
          {
            cos ( \l_semio_viz_geo_tmpa_fp )
            * ( tan ( ( pi / 2 + \l_semio_viz_geo_tmpa_fp ) / 2 )
                ** \l_semio_viz_geo_n_fp )
            / \l_semio_viz_geo_n_fp
          }
      }
  }

% 🧮 The cone constants of `conic-equal-area`; a vanishing constant swaps in the equal-area cylinder.
\cs_new_protected:Npn \semio_viz_geo_derive_equal_area:
  {
    \fp_set:Nn \l_semio_viz_geo_n_fp
      {
        ( sin ( \l_semio_viz_geo_tmpa_fp ) + sin ( \l_semio_viz_geo_tmpb_fp ) )
        / 2
      }
    \fp_compare:nNnTF { abs ( \l_semio_viz_geo_n_fp ) }
      < { \c_semio_viz_geo_epsilon_fp }
      { \tl_set:Nn \l_semio_viz_geo_raw_tl { cylindrical-equal-area } }
      {
        \fp_set:Nn \l_semio_viz_geo_c_fp
          {
            1 + sin ( \l_semio_viz_geo_tmpa_fp )
            * ( 2 * \l_semio_viz_geo_n_fp - sin ( \l_semio_viz_geo_tmpa_fp ) )
          }
        \fp_set:Nn \l_semio_viz_geo_rzero_fp
          { sqrt ( \l_semio_viz_geo_c_fp ) / \l_semio_viz_geo_n_fp }
      }
  }

% 🧮 The cone constants of `conic-equidistant`; equal parallels leave the equirectangular case.
\cs_new_protected:Npn \semio_viz_geo_derive_equidistant:
  {
    \fp_compare:nNnTF \l_semio_viz_geo_tmpa_fp = \l_semio_viz_geo_tmpb_fp
      {
        \fp_set:Nn \l_semio_viz_geo_n_fp { sin ( \l_semio_viz_geo_tmpa_fp ) }
      }
      {
        \fp_set:Nn \l_semio_viz_geo_n_fp
          {
            ( cos ( \l_semio_viz_geo_tmpa_fp )
              - cos ( \l_semio_viz_geo_tmpb_fp ) )
            / ( \l_semio_viz_geo_tmpb_fp - \l_semio_viz_geo_tmpa_fp )
          }
      }
    \fp_compare:nNnTF { abs ( \l_semio_viz_geo_n_fp ) }
      < { \c_semio_viz_geo_epsilon_fp }
      { \tl_set:Nn \l_semio_viz_geo_raw_tl { equirectangular } }
      {
        \fp_set:Nn \l_semio_viz_geo_g_fp
          {
            cos ( \l_semio_viz_geo_tmpa_fp ) / \l_semio_viz_geo_n_fp
            + \l_semio_viz_geo_tmpa_fp
          }
      }
  }

% 🗺️ Defines a named projection: parses keys, derives conic constants, the rotation angles and the center offset, and freezes them.
\cs_new_protected:Npn \semio_viz_geo_define:nn #1#2
  {
    \tl_set:Nn \l_semio_viz_geo_kind_tl { equirectangular }
    \keys_set:nn { semio / viz / geo / projection } { kind = equirectangular }
    \keys_set:nn { semio / viz / geo / projection } {#2}
    \exp_args:NV \semio_viz_geo_define_aux:nn \l_semio_viz_geo_kind_tl {#2}
    \tl_set:Nx \l_semio_viz_geo_name_tl {#1}
    \tl_set:Nx \l_semio_viz_geo_name_tl { \tl_to_str:N \l_semio_viz_geo_name_tl }
    \seq_if_in:NVF \g_semio_viz_geo_proj_seq \l_semio_viz_geo_name_tl
      { \seq_gput_right:NV \g_semio_viz_geo_proj_seq \l_semio_viz_geo_name_tl }
    \prop_gput:NVx \g_semio_viz_geo_proj_prop \l_semio_viz_geo_name_tl
      {
        { \l_semio_viz_geo_raw_tl }
        { \fp_use:N \l_semio_viz_geo_k_fp }
        { \fp_use:N \l_semio_viz_geo_tx_fp }
        { \fp_use:N \l_semio_viz_geo_ty_fp }
        { \fp_use:N \l_semio_viz_geo_dl_fp }
        { \fp_use:N \l_semio_viz_geo_dp_fp }
        { \fp_use:N \l_semio_viz_geo_dg_fp }
        { \fp_use:N \l_semio_viz_geo_ox_fp }
        { \fp_use:N \l_semio_viz_geo_oy_fp }
        { \fp_use:N \l_semio_viz_geo_n_fp }
        { \fp_use:N \l_semio_viz_geo_f_fp }
        { \fp_use:N \l_semio_viz_geo_c_fp }
        { \fp_use:N \l_semio_viz_geo_rzero_fp }
        { \fp_use:N \l_semio_viz_geo_g_fp }
        { \fp_use:N \l_semio_viz_geo_cosphistd_fp }
        { \fp_use:N \l_semio_viz_geo_clip_fp }
        { \fp_use:N \l_semio_viz_geo_deltasq_fp }
        { \clist_use:Nn \l_semio_viz_geo_clipextent_clist { , } }
      }
  }

% 🗺️ The definition's own work for kind #1 under the option list #2: the kind's presets first, then
% the caller's keys on top of them, then the conic constants and the offsets they imply.
\cs_new_protected:Npn \semio_viz_geo_define_aux:nn #1#2
  {
    \semio_viz_geo_kind_defaults:n {#1}
    \keys_set:nn { semio / viz / geo / projection } {#2}
    \tl_set:Nn \l_semio_viz_geo_raw_tl {#1}
    \str_if_eq:nnT {#1} { albers }
      { \tl_set:Nn \l_semio_viz_geo_raw_tl { conic-equal-area } }
    \semio_viz_geo_derive_conic:
    \fp_set:Nn \l_semio_viz_geo_tx_fp
      { \clist_item:Nn \l_semio_viz_geo_translate_clist { 1 } }
    \fp_set:Nn \l_semio_viz_geo_ty_fp
      { \clist_item:Nn \l_semio_viz_geo_translate_clist { 2 } }
    \fp_set:Nn \l_semio_viz_geo_dl_fp
      {
        \clist_item:Nn \l_semio_viz_geo_rotate_clist { 1 }
        * \c_semio_viz_geo_radians_fp
      }
    \fp_set:Nn \l_semio_viz_geo_dp_fp
      {
        \clist_item:Nn \l_semio_viz_geo_rotate_clist { 2 }
        * \c_semio_viz_geo_radians_fp
      }
    \fp_set:Nn \l_semio_viz_geo_dg_fp
      {
        \clist_item:Nn \l_semio_viz_geo_rotate_clist { 3 }
        * \c_semio_viz_geo_radians_fp
      }
    \str_if_eq:nnT {#1} { transverse-mercator }
      { \fp_add:Nn \l_semio_viz_geo_dg_fp { pi / 2 } }
    \fp_set:Nn \l_semio_viz_geo_lam_fp
      {
        \clist_item:Nn \l_semio_viz_geo_center_clist { 1 }
        * \c_semio_viz_geo_radians_fp
      }
    \fp_set:Nn \l_semio_viz_geo_phi_fp
      {
        \clist_item:Nn \l_semio_viz_geo_center_clist { 2 }
        * \c_semio_viz_geo_radians_fp
      }
    \semio_viz_geo_raw:
    \fp_set_eq:NN \l_semio_viz_geo_ox_fp \l_semio_viz_geo_px_fp
    \fp_set_eq:NN \l_semio_viz_geo_oy_fp \l_semio_viz_geo_py_fp
    \tl_if_empty:NTF \l_semio_viz_geo_clipangle_tl
      { \fp_set:Nn \l_semio_viz_geo_clip_fp { -1 } }
      {
        \fp_set:Nn \l_semio_viz_geo_clip_fp
          { \l_semio_viz_geo_clipangle_tl * \c_semio_viz_geo_radians_fp }
      }
    \fp_set:Nn \l_semio_viz_geo_deltasq_fp
      { \l_semio_viz_geo_precision_fp * \l_semio_viz_geo_precision_fp }
  }

% ▶️ Loads a stored projection into the working registers; every forward or inverse call runs against these.
\cs_new_protected:Npn \semio_viz_geo_use:n #1
  {
    \tl_set:Nx \l_semio_viz_geo_name_tl {#1}
    \tl_set:Nx \l_semio_viz_geo_name_tl { \tl_to_str:N \l_semio_viz_geo_name_tl }
    \prop_get:NVNTF \g_semio_viz_geo_proj_prop \l_semio_viz_geo_name_tl \l_tmpa_tl
      { \exp_after:wN \semio_viz_geo_load_a:nnnnnnnnn \l_tmpa_tl }
      { \msg_error:nnn { semio-viz } { unknown-projection } {#1} }
  }

% 📥 The first nine frozen fields of a stored projection: the raw kind, the scale, the translation
% and the three rotation angles.
\cs_new_protected:Npn \semio_viz_geo_load_a:nnnnnnnnn #1#2#3#4#5#6#7#8#9
  {
    \tl_set:Nn \l_semio_viz_geo_raw_tl {#1}
    \fp_set:Nn \l_semio_viz_geo_k_fp {#2}
    \fp_set:Nn \l_semio_viz_geo_tx_fp {#3}
    \fp_set:Nn \l_semio_viz_geo_ty_fp {#4}
    \fp_set:Nn \l_semio_viz_geo_dl_fp {#5}
    \fp_set:Nn \l_semio_viz_geo_dp_fp {#6}
    \fp_set:Nn \l_semio_viz_geo_dg_fp {#7}
    \fp_set:Nn \l_semio_viz_geo_ox_fp {#8}
    \fp_set:Nn \l_semio_viz_geo_oy_fp {#9}
    \semio_viz_geo_load_b:nnnnnnnnn
  }

% 📥 The remaining fields: the conic constants, the clip angle and extent, and the precision.
\cs_new_protected:Npn \semio_viz_geo_load_b:nnnnnnnnn #1#2#3#4#5#6#7#8#9
  {
    \fp_set:Nn \l_semio_viz_geo_n_fp {#1}
    \fp_set:Nn \l_semio_viz_geo_f_fp {#2}
    \fp_set:Nn \l_semio_viz_geo_c_fp {#3}
    \fp_set:Nn \l_semio_viz_geo_rzero_fp {#4}
    \fp_set:Nn \l_semio_viz_geo_g_fp {#5}
    \fp_set:Nn \l_semio_viz_geo_cosphistd_fp {#6}
    \fp_set:Nn \l_semio_viz_geo_clip_fp {#7}
    \fp_set:Nn \l_semio_viz_geo_deltasq_fp {#8}
    \clist_set:Nn \l_semio_viz_geo_clipextent_clist {#9}
  }

% ✏️ Overrides the live scale and translate without redefining the projection (used by fitExtent).
\cs_new_protected:Npn \semio_viz_geo_set_scale_translate:nnn #1#2#3
  {
    \fp_set:Nn \l_semio_viz_geo_k_fp {#1}
    \fp_set:Nn \l_semio_viz_geo_tx_fp {#2}
    \fp_set:Nn \l_semio_viz_geo_ty_fp {#3}
    \prop_gput:NVx \g_semio_viz_geo_proj_prop \l_semio_viz_geo_name_tl
      {
        { \l_semio_viz_geo_raw_tl }
        { \fp_use:N \l_semio_viz_geo_k_fp }
        { \fp_use:N \l_semio_viz_geo_tx_fp }
        { \fp_use:N \l_semio_viz_geo_ty_fp }
        { \fp_use:N \l_semio_viz_geo_dl_fp }
        { \fp_use:N \l_semio_viz_geo_dp_fp }
        { \fp_use:N \l_semio_viz_geo_dg_fp }
        { \fp_use:N \l_semio_viz_geo_ox_fp }
        { \fp_use:N \l_semio_viz_geo_oy_fp }
        { \fp_use:N \l_semio_viz_geo_n_fp }
        { \fp_use:N \l_semio_viz_geo_f_fp }
        { \fp_use:N \l_semio_viz_geo_c_fp }
        { \fp_use:N \l_semio_viz_geo_rzero_fp }
        { \fp_use:N \l_semio_viz_geo_g_fp }
        { \fp_use:N \l_semio_viz_geo_cosphistd_fp }
        { \fp_use:N \l_semio_viz_geo_clip_fp }
        { \fp_use:N \l_semio_viz_geo_deltasq_fp }
        { \clist_use:Nn \l_semio_viz_geo_clipextent_clist { , } }
      }
  }
%endregion 🔖️Registry

%region 🔖️Transform
% 📐 Raw projection plus d3's scaleTranslate: x = tx - k*ox + k*px, y = ty + k*oy - k*py.
\cs_new_protected:Npn \semio_viz_geo_transform:
  {
    \semio_viz_geo_raw:
    \fp_set:Nn \l_semio_viz_geo_x_fp
      {
        \l_semio_viz_geo_tx_fp
        + \l_semio_viz_geo_k_fp
          * ( \l_semio_viz_geo_px_fp - \l_semio_viz_geo_ox_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_y_fp
      {
        \l_semio_viz_geo_ty_fp
        - \l_semio_viz_geo_k_fp
          * ( \l_semio_viz_geo_py_fp - \l_semio_viz_geo_oy_fp )
      }
  }

% 🌍 Full forward: degrees in, rotation, raw projection, scale and translate; results in x_fp / y_fp.
\cs_new_protected:Npn \semio_viz_geo_forward:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_geo_lam_fp { (#1) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_phi_fp { (#2) * \c_semio_viz_geo_radians_fp }
    \semio_viz_geo_rotate:
    \semio_viz_geo_transform:
  }

% 🌍 Full inverse: plane coordinates in, degrees out in lon_fp / lat_fp.
\cs_new_protected:Npn \semio_viz_geo_inverse:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_geo_px_fp
      {
        ( (#1) - \l_semio_viz_geo_tx_fp ) / \l_semio_viz_geo_k_fp
        + \l_semio_viz_geo_ox_fp
      }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      {
        ( \l_semio_viz_geo_ty_fp - (#2) ) / \l_semio_viz_geo_k_fp
        + \l_semio_viz_geo_oy_fp
      }
    \semio_viz_geo_raw_invert:
    \semio_viz_geo_rotate_invert:
    \fp_set:Nn \l_semio_viz_geo_lon_fp
      { \l_semio_viz_geo_lam_fp * \c_semio_viz_geo_degrees_fp }
    \fp_set:Nn \l_semio_viz_geo_lat_fp
      { \l_semio_viz_geo_phi_fp * \c_semio_viz_geo_degrees_fp }
  }
%endregion 🔖️Transform

%region 🔖️Resample
% 🔬 d3-geo's adaptive resampling, verbatim: recursion is scoped by TeX groups so the twelve segment registers restore themselves.
\fp_new:N \l_semio_viz_geo_rs_xa_fp
\fp_new:N \l_semio_viz_geo_rs_ya_fp
\fp_new:N \l_semio_viz_geo_rs_lama_fp
\fp_new:N \l_semio_viz_geo_rs_ua_fp
\fp_new:N \l_semio_viz_geo_rs_va_fp
\fp_new:N \l_semio_viz_geo_rs_wa_fp
\fp_new:N \l_semio_viz_geo_rs_xb_fp
\fp_new:N \l_semio_viz_geo_rs_yb_fp
\fp_new:N \l_semio_viz_geo_rs_lamb_fp
\fp_new:N \l_semio_viz_geo_rs_ub_fp
\fp_new:N \l_semio_viz_geo_rs_vb_fp
\fp_new:N \l_semio_viz_geo_rs_wb_fp
\fp_new:N \l_semio_viz_geo_rs_xm_fp
\fp_new:N \l_semio_viz_geo_rs_ym_fp
\fp_new:N \l_semio_viz_geo_rs_lamm_fp
\fp_new:N \l_semio_viz_geo_rs_u_fp
\fp_new:N \l_semio_viz_geo_rs_v_fp
\fp_new:N \l_semio_viz_geo_rs_w_fp
\fp_new:N \l_semio_viz_geo_rs_m_fp
\fp_new:N \l_semio_viz_geo_rs_dx_fp
\fp_new:N \l_semio_viz_geo_rs_dy_fp
\fp_new:N \l_semio_viz_geo_rs_dsq_fp
\int_new:N \l_semio_viz_geo_rs_depth_int
\seq_new:N \g_semio_viz_geo_pts_seq
\seq_new:N \g_semio_viz_geo_path_seq
\int_new:N \l_semio_viz_geo_line_count_int

% 📤 Appends one plane vertex to the subpath under construction.
\cs_new_protected:Npn \semio_viz_geo_emit:nn #1#2
  { \seq_gput_right:Nx \g_semio_viz_geo_pts_seq { \fp_eval:n {#1} , \fp_eval:n {#2} } }

% 🔬 One recursion step: the segment is split when its midpoint departs far enough from the chord,
% or when the split is lopsided enough that d3 would split it anyway.
\cs_new_protected:Npn \semio_viz_geo_resample_rec:
  {
    \fp_set:Nn \l_semio_viz_geo_rs_dx_fp
      { \l_semio_viz_geo_rs_xb_fp - \l_semio_viz_geo_rs_xa_fp }
    \fp_set:Nn \l_semio_viz_geo_rs_dy_fp
      { \l_semio_viz_geo_rs_yb_fp - \l_semio_viz_geo_rs_ya_fp }
    \fp_set:Nn \l_semio_viz_geo_rs_dsq_fp
      {
        \l_semio_viz_geo_rs_dx_fp * \l_semio_viz_geo_rs_dx_fp
        + \l_semio_viz_geo_rs_dy_fp * \l_semio_viz_geo_rs_dy_fp
      }
    \bool_lazy_and:nnT
      {
        \fp_compare_p:nNn \l_semio_viz_geo_rs_dsq_fp >
          { 4 * \l_semio_viz_geo_deltasq_fp }
      }
      { \int_compare_p:nNn \l_semio_viz_geo_rs_depth_int > { 0 } }
      { \semio_viz_geo_resample_split: }
  }

% ✂️ Splits the segment at its own spherical midpoint and recurses into both halves.
\cs_new_protected:Npn \semio_viz_geo_resample_split:
  {
    \fp_set:Nn \l_semio_viz_geo_rs_u_fp
      { \l_semio_viz_geo_rs_ua_fp + \l_semio_viz_geo_rs_ub_fp }
    \fp_set:Nn \l_semio_viz_geo_rs_v_fp
      { \l_semio_viz_geo_rs_va_fp + \l_semio_viz_geo_rs_vb_fp }
    \fp_set:Nn \l_semio_viz_geo_rs_w_fp
      { \l_semio_viz_geo_rs_wa_fp + \l_semio_viz_geo_rs_wb_fp }
    \fp_set:Nn \l_semio_viz_geo_rs_m_fp
      {
        sqrt ( \l_semio_viz_geo_rs_u_fp * \l_semio_viz_geo_rs_u_fp
               + \l_semio_viz_geo_rs_v_fp * \l_semio_viz_geo_rs_v_fp
               + \l_semio_viz_geo_rs_w_fp * \l_semio_viz_geo_rs_w_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_rs_w_fp
      { \l_semio_viz_geo_rs_w_fp / \l_semio_viz_geo_rs_m_fp }
    \fp_set:Nn \l_semio_viz_geo_rs_lamm_fp
      {
        (
          abs ( abs ( \l_semio_viz_geo_rs_w_fp ) - 1 )
            < \c_semio_viz_geo_epsilon_fp
          ||
          abs ( \l_semio_viz_geo_rs_lama_fp - \l_semio_viz_geo_rs_lamb_fp )
            < \c_semio_viz_geo_epsilon_fp
        )
          ? ( \l_semio_viz_geo_rs_lama_fp + \l_semio_viz_geo_rs_lamb_fp ) / 2
          : atan ( \l_semio_viz_geo_rs_v_fp , \l_semio_viz_geo_rs_u_fp )
      }
    \fp_set_eq:NN \l_semio_viz_geo_lam_fp \l_semio_viz_geo_rs_lamm_fp
    \fp_set:Nn \l_semio_viz_geo_phi_fp { asin ( \l_semio_viz_geo_rs_w_fp ) }
    \semio_viz_geo_transform:
    \fp_set_eq:NN \l_semio_viz_geo_rs_xm_fp \l_semio_viz_geo_x_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_ym_fp \l_semio_viz_geo_y_fp
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      { \l_semio_viz_geo_rs_xm_fp - \l_semio_viz_geo_rs_xa_fp }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { \l_semio_viz_geo_rs_ym_fp - \l_semio_viz_geo_rs_ya_fp }
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      {
        \l_semio_viz_geo_rs_dy_fp * \l_semio_viz_geo_tmpa_fp
        - \l_semio_viz_geo_rs_dx_fp * \l_semio_viz_geo_tmpb_fp
      }
    \bool_lazy_any:nT
      {
        {
          \fp_compare_p:nNn
            {
              \l_semio_viz_geo_tmpc_fp * \l_semio_viz_geo_tmpc_fp
              / \l_semio_viz_geo_rs_dsq_fp
            }
            > { \l_semio_viz_geo_deltasq_fp }
        }
        {
          \fp_compare_p:nNn
            {
              abs
                (
                  ( \l_semio_viz_geo_rs_dx_fp * \l_semio_viz_geo_tmpa_fp
                    + \l_semio_viz_geo_rs_dy_fp * \l_semio_viz_geo_tmpb_fp )
                  / \l_semio_viz_geo_rs_dsq_fp - 0.5
                )
            }
            > { 0.3 }
        }
        {
          \fp_compare_p:nNn
            {
              \l_semio_viz_geo_rs_ua_fp * \l_semio_viz_geo_rs_ub_fp
              + \l_semio_viz_geo_rs_va_fp * \l_semio_viz_geo_rs_vb_fp
              + \l_semio_viz_geo_rs_wa_fp * \l_semio_viz_geo_rs_wb_fp
            }
            < { \c_semio_viz_geo_cosmindistance_fp }
        }
      }
      { \semio_viz_geo_resample_halves: }
  }

% 🔬 The two halves, each in its own TeX group, so the twelve segment registers restore themselves
% on the way back out of the recursion.
\cs_new_protected:Npn \semio_viz_geo_resample_halves:
  {
    \fp_set:Nn \l_semio_viz_geo_rs_u_fp
      { \l_semio_viz_geo_rs_u_fp / \l_semio_viz_geo_rs_m_fp }
    \fp_set:Nn \l_semio_viz_geo_rs_v_fp
      { \l_semio_viz_geo_rs_v_fp / \l_semio_viz_geo_rs_m_fp }
    \group_begin:
      \fp_set_eq:NN \l_semio_viz_geo_rs_xb_fp \l_semio_viz_geo_rs_xm_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_yb_fp \l_semio_viz_geo_rs_ym_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_lamb_fp \l_semio_viz_geo_rs_lamm_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_ub_fp \l_semio_viz_geo_rs_u_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_vb_fp \l_semio_viz_geo_rs_v_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_wb_fp \l_semio_viz_geo_rs_w_fp
      \int_decr:N \l_semio_viz_geo_rs_depth_int
      \semio_viz_geo_resample_rec:
    \group_end:
    \semio_viz_geo_emit:nn
      { \l_semio_viz_geo_rs_xm_fp } { \l_semio_viz_geo_rs_ym_fp }
    \group_begin:
      \fp_set_eq:NN \l_semio_viz_geo_rs_xa_fp \l_semio_viz_geo_rs_xm_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_ya_fp \l_semio_viz_geo_rs_ym_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_lama_fp \l_semio_viz_geo_rs_lamm_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_ua_fp \l_semio_viz_geo_rs_u_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_va_fp \l_semio_viz_geo_rs_v_fp
      \fp_set_eq:NN \l_semio_viz_geo_rs_wa_fp \l_semio_viz_geo_rs_w_fp
      \int_decr:N \l_semio_viz_geo_rs_depth_int
      \semio_viz_geo_resample_rec:
    \group_end:
  }
%endregion 🔖️Resample

%region 🔖️Clip
% ✂️ clipAngle visibility test, d3-geo clipCircle: cos(lambda)cos(phi) > cos(radius) on the rotated sphere.
\prg_new_conditional:Npnn \semio_viz_geo_visible: { T, F, TF }
  {
    \fp_compare:nNnTF \l_semio_viz_geo_clip_fp < { 0 }
      { \prg_return_true: }
      {
        \fp_compare:nNnTF
          { cos ( \l_semio_viz_geo_lam_fp ) * cos ( \l_semio_viz_geo_phi_fp ) }
          > { cos ( \l_semio_viz_geo_clip_fp ) }
          { \prg_return_true: }
          { \prg_return_false: }
      }
  }

\fp_new:N \l_semio_viz_geo_cl_la_fp
\fp_new:N \l_semio_viz_geo_cl_pa_fp
\fp_new:N \l_semio_viz_geo_cl_lb_fp
\fp_new:N \l_semio_viz_geo_cl_pb_fp
\fp_new:N \l_semio_viz_geo_cl_t_fp

% 🎯 Bisects a great-circle segment to the clip boundary (`clipSteps` halvings, 48 of them, i.e. below 1e-14 rad); d3 solves it analytically, the crossing is the same point.
\cs_new_protected:Npn \semio_viz_geo_clip_cross:
  {
    \fp_zero:N \l_semio_viz_geo_tmpa_fp
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp { 1 }
    \int_step_inline:nn { \l_semio_viz_geo_clip_steps_int }
      {
        \fp_set:Nn \l_semio_viz_geo_cl_t_fp
          {
            ( \l_semio_viz_geo_tmpa_fp + \l_semio_viz_geo_tmpb_fp ) / 2
          }
        \semio_viz_geo_slerp:
        \semio_viz_geo_visible:TF
          { \fp_set_eq:NN \l_semio_viz_geo_tmpa_fp \l_semio_viz_geo_cl_t_fp }
          { \fp_set_eq:NN \l_semio_viz_geo_tmpb_fp \l_semio_viz_geo_cl_t_fp }
      }
    \semio_viz_geo_slerp:
  }

% 🧵 Spherical linear interpolation between the clip endpoints at parameter cl_t, in radians.
\cs_new_protected:Npn \semio_viz_geo_slerp:
  {
    \fp_set:Nn \l_semio_viz_geo_rx_fp
      {
        ( 1 - \l_semio_viz_geo_cl_t_fp )
        * cos ( \l_semio_viz_geo_cl_pa_fp ) * cos ( \l_semio_viz_geo_cl_la_fp )
        + \l_semio_viz_geo_cl_t_fp
        * cos ( \l_semio_viz_geo_cl_pb_fp ) * cos ( \l_semio_viz_geo_cl_lb_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_ry_fp
      {
        ( 1 - \l_semio_viz_geo_cl_t_fp )
        * cos ( \l_semio_viz_geo_cl_pa_fp ) * sin ( \l_semio_viz_geo_cl_la_fp )
        + \l_semio_viz_geo_cl_t_fp
        * cos ( \l_semio_viz_geo_cl_pb_fp ) * sin ( \l_semio_viz_geo_cl_lb_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_rz_fp
      {
        ( 1 - \l_semio_viz_geo_cl_t_fp ) * sin ( \l_semio_viz_geo_cl_pa_fp )
        + \l_semio_viz_geo_cl_t_fp * sin ( \l_semio_viz_geo_cl_pb_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_lam_fp
      { atan ( \l_semio_viz_geo_ry_fp , \l_semio_viz_geo_rx_fp ) }
    \fp_set:Nn \l_semio_viz_geo_phi_fp
      {
        atan ( \l_semio_viz_geo_rz_fp ,
               sqrt ( \l_semio_viz_geo_rx_fp * \l_semio_viz_geo_rx_fp
                      + \l_semio_viz_geo_ry_fp * \l_semio_viz_geo_ry_fp ) )
      }
  }
%endregion 🔖️Clip

%region 🔖️Path
% 🧭 One projected subpath: lineStart / linePoint / lineEnd, with the ring variant resampling the closing segment like d3.
\bool_new:N \l_semio_viz_geo_first_bool
\bool_new:N \l_semio_viz_geo_prev_vis_bool
\bool_new:N \l_semio_viz_geo_closed_bool
\fp_new:N \l_semio_viz_geo_ring_x_fp
\fp_new:N \l_semio_viz_geo_ring_y_fp
\fp_new:N \l_semio_viz_geo_ring_lam_fp
\fp_new:N \l_semio_viz_geo_ring_u_fp
\fp_new:N \l_semio_viz_geo_ring_v_fp
\fp_new:N \l_semio_viz_geo_ring_w_fp
\fp_new:N \l_semio_viz_geo_prev_lon_fp
\fp_new:N \l_semio_viz_geo_prev_lat_fp

\cs_new_protected:Npn \semio_viz_geo_line_start:
  {
    \seq_gclear:N \g_semio_viz_geo_pts_seq
    \bool_set_true:N \l_semio_viz_geo_first_bool
  }

% 📤 Closes the subpath and files it under the part type #1, unless it collected no vertex at all.
\cs_new_protected:Npn \semio_viz_geo_line_end:n #1
  {
    \seq_if_empty:NF \g_semio_viz_geo_pts_seq
      {
        \seq_gput_right:Nx \g_semio_viz_geo_path_seq
          {
            {#1}
            { \seq_use:Nn \g_semio_viz_geo_pts_seq { ; } }
          }
      }
    \seq_gclear:N \g_semio_viz_geo_pts_seq
  }

% 📍 Adds one lon/lat vertex: rotate, clip, project, resample the segment from the previous vertex, then emit.
\cs_new_protected:Npn \semio_viz_geo_line_point:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_geo_lam_fp { (#1) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_phi_fp { (#2) * \c_semio_viz_geo_radians_fp }
    \semio_viz_geo_rotate:
    \semio_viz_geo_visible:TF
      { \semio_viz_geo_line_point_visible: }
      { \semio_viz_geo_line_point_hidden: }
  }

% 👁️ A vertex inside the clip: the crossing back in is emitted first when the previous one was out.
\cs_new_protected:Npn \semio_viz_geo_line_point_visible:
  {
    \bool_lazy_and:nnT
      { \bool_not_p:n { \l_semio_viz_geo_first_bool } }
      { \bool_not_p:n { \l_semio_viz_geo_prev_vis_bool } }
      { \semio_viz_geo_reenter: }
    \semio_viz_geo_line_point_add:
    \bool_set_true:N \l_semio_viz_geo_prev_vis_bool
  }

% 🙈 A vertex outside the clip: the crossing out is emitted when the previous one was in, and the
% vertex itself is only remembered.
\cs_new_protected:Npn \semio_viz_geo_line_point_hidden:
  {
    \bool_lazy_and:nnT
      { \bool_not_p:n { \l_semio_viz_geo_first_bool } }
      { \l_semio_viz_geo_prev_vis_bool }
      { \semio_viz_geo_exit: }
    \bool_set_false:N \l_semio_viz_geo_prev_vis_bool
    \bool_set_false:N \l_semio_viz_geo_first_bool
    \fp_set_eq:NN \l_semio_viz_geo_prev_lon_fp \l_semio_viz_geo_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_prev_lat_fp \l_semio_viz_geo_phi_fp
  }

% 🚪 Emits the point at which the line leaves the clip, so the subpath ends on the clip boundary.
\cs_new_protected:Npn \semio_viz_geo_exit:
  {
    \fp_set_eq:NN \l_semio_viz_geo_cl_la_fp \l_semio_viz_geo_prev_lon_fp
    \fp_set_eq:NN \l_semio_viz_geo_cl_pa_fp \l_semio_viz_geo_prev_lat_fp
    \fp_set_eq:NN \l_semio_viz_geo_cl_lb_fp \l_semio_viz_geo_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_cl_pb_fp \l_semio_viz_geo_phi_fp
    \fp_set_eq:NN \l_semio_viz_geo_tmpd_fp \l_semio_viz_geo_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_rk_fp \l_semio_viz_geo_phi_fp
    \semio_viz_geo_clip_cross:
    \semio_viz_geo_transform:
    \semio_viz_geo_emit:nn { \l_semio_viz_geo_x_fp } { \l_semio_viz_geo_y_fp }
    \fp_set_eq:NN \l_semio_viz_geo_lam_fp \l_semio_viz_geo_tmpd_fp
    \fp_set_eq:NN \l_semio_viz_geo_phi_fp \l_semio_viz_geo_rk_fp
  }

% 🚪 Emits the point at which the line comes back into the clip, the mirror of the exit above.
\cs_new_protected:Npn \semio_viz_geo_reenter:
  {
    \fp_set_eq:NN \l_semio_viz_geo_cl_la_fp \l_semio_viz_geo_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_cl_pa_fp \l_semio_viz_geo_phi_fp
    \fp_set_eq:NN \l_semio_viz_geo_cl_lb_fp \l_semio_viz_geo_prev_lon_fp
    \fp_set_eq:NN \l_semio_viz_geo_cl_pb_fp \l_semio_viz_geo_prev_lat_fp
    \fp_set_eq:NN \l_semio_viz_geo_tmpd_fp \l_semio_viz_geo_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_rk_fp \l_semio_viz_geo_phi_fp
    \semio_viz_geo_clip_cross:
    \semio_viz_geo_transform:
    \semio_viz_geo_emit:nn { \l_semio_viz_geo_x_fp } { \l_semio_viz_geo_y_fp }
    \fp_set_eq:NN \l_semio_viz_geo_lam_fp \l_semio_viz_geo_tmpd_fp
    \fp_set_eq:NN \l_semio_viz_geo_phi_fp \l_semio_viz_geo_rk_fp
    \bool_set_true:N \l_semio_viz_geo_first_bool
  }

% 📍 Projects the current vertex, resamples the segment from the previous one, and emits it.
\cs_new_protected:Npn \semio_viz_geo_line_point_add:
  {
    \fp_set:Nn \l_semio_viz_geo_rs_ub_fp
      { cos ( \l_semio_viz_geo_phi_fp ) * cos ( \l_semio_viz_geo_lam_fp ) }
    \fp_set:Nn \l_semio_viz_geo_rs_vb_fp
      { cos ( \l_semio_viz_geo_phi_fp ) * sin ( \l_semio_viz_geo_lam_fp ) }
    \fp_set:Nn \l_semio_viz_geo_rs_wb_fp { sin ( \l_semio_viz_geo_phi_fp ) }
    \fp_set_eq:NN \l_semio_viz_geo_rs_lamb_fp \l_semio_viz_geo_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_prev_lon_fp \l_semio_viz_geo_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_prev_lat_fp \l_semio_viz_geo_phi_fp
    \semio_viz_geo_transform:
    \fp_set_eq:NN \l_semio_viz_geo_rs_xb_fp \l_semio_viz_geo_x_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_yb_fp \l_semio_viz_geo_y_fp
    \bool_lazy_and:nnT
      { \bool_not_p:n { \l_semio_viz_geo_first_bool } }
      { \fp_compare_p:nNn \l_semio_viz_geo_deltasq_fp > { 0 } }
      {
        \int_set_eq:NN \l_semio_viz_geo_rs_depth_int
          \c_semio_viz_geo_maxdepth_int
        \semio_viz_geo_resample_rec:
      }
    \bool_if:NT \l_semio_viz_geo_first_bool
      {
        \fp_set_eq:NN \l_semio_viz_geo_ring_x_fp \l_semio_viz_geo_rs_xb_fp
        \fp_set_eq:NN \l_semio_viz_geo_ring_y_fp \l_semio_viz_geo_rs_yb_fp
        \fp_set_eq:NN \l_semio_viz_geo_ring_lam_fp \l_semio_viz_geo_rs_lamb_fp
        \fp_set_eq:NN \l_semio_viz_geo_ring_u_fp \l_semio_viz_geo_rs_ub_fp
        \fp_set_eq:NN \l_semio_viz_geo_ring_v_fp \l_semio_viz_geo_rs_vb_fp
        \fp_set_eq:NN \l_semio_viz_geo_ring_w_fp \l_semio_viz_geo_rs_wb_fp
      }
    \semio_viz_geo_emit:nn
      { \l_semio_viz_geo_rs_xb_fp } { \l_semio_viz_geo_rs_yb_fp }
    \fp_set_eq:NN \l_semio_viz_geo_rs_xa_fp \l_semio_viz_geo_rs_xb_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_ya_fp \l_semio_viz_geo_rs_yb_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_lama_fp \l_semio_viz_geo_rs_lamb_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_ua_fp \l_semio_viz_geo_rs_ub_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_va_fp \l_semio_viz_geo_rs_vb_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_wa_fp \l_semio_viz_geo_rs_wb_fp
    \bool_set_false:N \l_semio_viz_geo_first_bool
  }

% 🔁 Resamples the closing segment of a ring back to its first vertex without repeating that vertex.
\cs_new_protected:Npn \semio_viz_geo_ring_close:
  {
    \fp_set_eq:NN \l_semio_viz_geo_rs_xb_fp \l_semio_viz_geo_ring_x_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_yb_fp \l_semio_viz_geo_ring_y_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_lamb_fp \l_semio_viz_geo_ring_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_ub_fp \l_semio_viz_geo_ring_u_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_vb_fp \l_semio_viz_geo_ring_v_fp
    \fp_set_eq:NN \l_semio_viz_geo_rs_wb_fp \l_semio_viz_geo_ring_w_fp
    \fp_compare:nNnT \l_semio_viz_geo_deltasq_fp > { 0 }
      {
        \int_set_eq:NN \l_semio_viz_geo_rs_depth_int
          \c_semio_viz_geo_maxdepth_int
        \semio_viz_geo_resample_rec:
      }
  }

% 🛤️ Projects one `lon,lat; …` coordinate list into g_semio_viz_geo_path_seq as a closed (#1 = 1) or open subpath.
\cs_new_protected:Npn \semio_viz_geo_project_coords:nn #1#2
  {
    \semio_viz_geo_line_start:
    \bool_set_false:N \l_semio_viz_geo_prev_vis_bool
    \seq_set_split:Nnn \l_tmpa_seq { ; } {#2}
    \seq_map_inline:Nn \l_tmpa_seq
      {
        \tl_set:Nn \l_tmpb_tl {##1}
        \tl_trim_spaces:N \l_tmpb_tl
        \tl_if_empty:NF \l_tmpb_tl
          {
            \semio_viz_geo_line_point:nn
              { \clist_item:nn {##1} { 1 } }
              { \clist_item:nn {##1} { 2 } }
          }
      }
    \bool_lazy_and:nnT
      { \int_compare_p:nNn {#1} = { 1 } }
      { \l_semio_viz_geo_prev_vis_bool }
      { \semio_viz_geo_ring_close: }
    \semio_viz_geo_line_end:n {#1}
  }

% 🗺️ geoPath: projects every part of a geometry into g_semio_viz_geo_path_seq (subpaths as `{closed}{x,y;x,y;…}`).
\cs_new_protected:Npn \semio_viz_geo_path:nn #1#2
  {
    \semio_viz_geo_use:n {#1}
    \seq_gclear:N \g_semio_viz_geo_path_seq
    \semio_viz_geom_map_inline:nn {#2}
      { \semio_viz_geo_path_part:nnnn ##1 }
  }

% 🧩 One geometry part: a polygon is projected as a closed ring, a line and a point are not.
\cs_new_protected:Npn \semio_viz_geo_path_part:nnnn #1#2#3#4
  {
    \str_case:nn {#1}
      {
        { polygon } { \semio_viz_geo_project_coords:nn { 1 } {#4} }
        { line } { \semio_viz_geo_project_coords:nn { 0 } {#4} }
        { point } { \semio_viz_geo_project_coords:nn { 0 } {#4} }
      }
  }
%endregion 🔖️Path

%region 🔖️Fit
% 📏 Plane bounds of a projected geometry, computed like d3's path bounds (after resampling).
\fp_new:N \l_semio_viz_geo_bxmin_fp
\fp_new:N \l_semio_viz_geo_bymin_fp
\fp_new:N \l_semio_viz_geo_bxmax_fp
\fp_new:N \l_semio_viz_geo_bymax_fp

\cs_new_protected:Npn \semio_viz_geo_path_bounds:
  {
    \fp_set:Nn \l_semio_viz_geo_bxmin_fp { inf }
    \fp_set:Nn \l_semio_viz_geo_bymin_fp { inf }
    \fp_set:Nn \l_semio_viz_geo_bxmax_fp { -inf }
    \fp_set:Nn \l_semio_viz_geo_bymax_fp { -inf }
    \seq_map_inline:Nn \g_semio_viz_geo_path_seq
      { \semio_viz_geo_bounds_sub:nn ##1 }
  }

% 📐 Widens the running bounding box to hold every vertex of one projected subpath.
\cs_new_protected:Npn \semio_viz_geo_bounds_sub:nn #1#2
  {
    \seq_set_split:Nnn \l_tmpb_seq { ; } {#2}
    \seq_map_inline:Nn \l_tmpb_seq
      {
        \fp_set:Nn \l_semio_viz_geo_bxmin_fp
          { min ( \l_semio_viz_geo_bxmin_fp , \clist_item:nn {##1} { 1 } ) }
        \fp_set:Nn \l_semio_viz_geo_bxmax_fp
          { max ( \l_semio_viz_geo_bxmax_fp , \clist_item:nn {##1} { 1 } ) }
        \fp_set:Nn \l_semio_viz_geo_bymin_fp
          { min ( \l_semio_viz_geo_bymin_fp , \clist_item:nn {##1} { 2 } ) }
        \fp_set:Nn \l_semio_viz_geo_bymax_fp
          { max ( \l_semio_viz_geo_bymax_fp , \clist_item:nn {##1} { 2 } ) }
      }
  }

% 🔍 d3 fitExtent: measure at scale 150 / translate 0,0, then set scale 150k and the centering translation.
\cs_new_protected:Npn \semio_viz_geo_fit_extent:nnnnnn #1#2#3#4#5#6
  {
    \semio_viz_geo_use:n {#1}
    \semio_viz_geo_set_scale_translate:nnn { 150 } { 0 } { 0 }
    \seq_gclear:N \g_semio_viz_geo_path_seq
    \semio_viz_geom_map_inline:nn {#2} { \semio_viz_geo_path_part:nnnn ##1 }
    \semio_viz_geo_path_bounds:
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp { (#5) - (#3) }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp { (#6) - (#4) }
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      {
        min
          (
            \l_semio_viz_geo_tmpa_fp
              / ( \l_semio_viz_geo_bxmax_fp - \l_semio_viz_geo_bxmin_fp ) ,
            \l_semio_viz_geo_tmpb_fp
              / ( \l_semio_viz_geo_bymax_fp - \l_semio_viz_geo_bymin_fp )
          )
      }
    \semio_viz_geo_set_scale_translate:nnn
      { 150 * \l_semio_viz_geo_tmpc_fp }
      {
        (#3) + ( \l_semio_viz_geo_tmpa_fp - \l_semio_viz_geo_tmpc_fp
                 * ( \l_semio_viz_geo_bxmax_fp + \l_semio_viz_geo_bxmin_fp ) ) / 2
      }
      {
        (#4) + ( \l_semio_viz_geo_tmpb_fp - \l_semio_viz_geo_tmpc_fp
                 * ( \l_semio_viz_geo_bymax_fp + \l_semio_viz_geo_bymin_fp ) ) / 2
      }
  }

% 🔍 d3 fitWidth: scale so the plane width matches, then push the top edge to y = 0.
\cs_new_protected:Npn \semio_viz_geo_fit_width:nnn #1#2#3
  {
    \semio_viz_geo_use:n {#1}
    \semio_viz_geo_set_scale_translate:nnn { 150 } { 0 } { 0 }
    \seq_gclear:N \g_semio_viz_geo_path_seq
    \semio_viz_geom_map_inline:nn {#2} { \semio_viz_geo_path_part:nnnn ##1 }
    \semio_viz_geo_path_bounds:
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      { (#3) / ( \l_semio_viz_geo_bxmax_fp - \l_semio_viz_geo_bxmin_fp ) }
    \semio_viz_geo_set_scale_translate:nnn
      { 150 * \l_semio_viz_geo_tmpc_fp }
      {
        ( (#3) - \l_semio_viz_geo_tmpc_fp
          * ( \l_semio_viz_geo_bxmax_fp + \l_semio_viz_geo_bxmin_fp ) ) / 2
      }
      { - \l_semio_viz_geo_tmpc_fp * \l_semio_viz_geo_bymin_fp }
  }
%endregion 🔖️Fit

%region 🔖️Graticule
% 🕸️ d3-geo graticule: major meridians and parallels first, then the minor ones that are not already major.
\fp_new:N \l_semio_viz_geo_gr_dx_fp
\fp_new:N \l_semio_viz_geo_gr_dy_fp
\fp_new:N \l_semio_viz_geo_gr_Dx_fp
\fp_new:N \l_semio_viz_geo_gr_Dy_fp
\fp_new:N \l_semio_viz_geo_gr_prec_fp
\clist_new:N \l_semio_viz_geo_gr_minor_clist
\clist_new:N \l_semio_viz_geo_gr_major_clist
\tl_new:N \l_semio_viz_geo_gr_coords_tl
\seq_new:N \g_semio_viz_geo_gr_seq

%region 🔖️Keys
% 🔑 semio / viz / geo / graticule
% 🔑 step        (dx,dy)    minor and major step in degrees at once; default only sets the minor step.
% 🔑 stepMinor   (dx,dy)    default 10,10.
% 🔑 stepMajor   (dx,dy)    default 90,360.
% 🔑 extent      (x0,y0,x1,y1) sets both extents; default only sets the minor extent.
% 🔑 extentMinor (x0,y0,x1,y1) default -180,-80.000001,180,80.000001.
% 🔑 extentMajor (x0,y0,x1,y1) default -180,-89.999999,180,89.999999.
% 🔑 precision   (number)   sampling step in degrees along a parallel; default 2.5.
\keys_define:nn { semio / viz / geo / graticule }
  {
    step .code:n =
      {
        \fp_set:Nn \l_semio_viz_geo_gr_dx_fp { \clist_item:nn {#1} { 1 } }
        \fp_set:Nn \l_semio_viz_geo_gr_dy_fp { \clist_item:nn {#1} { 2 } }
        \fp_set_eq:NN \l_semio_viz_geo_gr_Dx_fp \l_semio_viz_geo_gr_dx_fp
        \fp_set_eq:NN \l_semio_viz_geo_gr_Dy_fp \l_semio_viz_geo_gr_dy_fp
      } ,
    stepMinor .code:n =
      {
        \fp_set:Nn \l_semio_viz_geo_gr_dx_fp { \clist_item:nn {#1} { 1 } }
        \fp_set:Nn \l_semio_viz_geo_gr_dy_fp { \clist_item:nn {#1} { 2 } }
      } ,
    stepMajor .code:n =
      {
        \fp_set:Nn \l_semio_viz_geo_gr_Dx_fp { \clist_item:nn {#1} { 1 } }
        \fp_set:Nn \l_semio_viz_geo_gr_Dy_fp { \clist_item:nn {#1} { 2 } }
      } ,
    extent .code:n =
      {
        \clist_set:Nn \l_semio_viz_geo_gr_minor_clist {#1}
        \clist_set:Nn \l_semio_viz_geo_gr_major_clist {#1}
      } ,
    extentMinor .clist_set:N = \l_semio_viz_geo_gr_minor_clist ,
    extentMajor .clist_set:N = \l_semio_viz_geo_gr_major_clist ,
    precision .fp_set:N = \l_semio_viz_geo_gr_prec_fp ,
  }
%endregion 🔖️Keys

% ♻️ Puts every graticule key back to d3.geoGraticule()'s own default.
\cs_new_protected:Npn \semio_viz_geo_graticule_defaults:
  {
    \fp_set:Nn \l_semio_viz_geo_gr_dx_fp { 10 }
    \fp_set:Nn \l_semio_viz_geo_gr_dy_fp { 10 }
    \fp_set:Nn \l_semio_viz_geo_gr_Dx_fp { 90 }
    \fp_set:Nn \l_semio_viz_geo_gr_Dy_fp { 360 }
    \fp_set:Nn \l_semio_viz_geo_gr_prec_fp { 2.5 }
    \clist_set:Nn \l_semio_viz_geo_gr_minor_clist
      { -180, -80.000001, 180, 80.000001 }
    \clist_set:Nn \l_semio_viz_geo_gr_major_clist
      { -180, -89.999999, 180, 89.999999 }
  }

% 〰️ One meridian at longitude #1 sampled from #2 to #3 every 90 degrees plus the end latitude (d3 graticuleX).
\cs_new_protected:Npn \semio_viz_geo_gr_meridian:nnn #1#2#3
  {
    \tl_clear:N \l_semio_viz_geo_gr_coords_tl
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp {#2}
    \bool_while_do:nn
      {
        \fp_compare_p:nNn \l_semio_viz_geo_tmpa_fp <
          { (#3) - \c_semio_viz_geo_epsilon_fp }
      }
      {
        \tl_put_right:Nx \l_semio_viz_geo_gr_coords_tl
          { \fp_eval:n {#1} , \fp_use:N \l_semio_viz_geo_tmpa_fp ; }
        \fp_add:Nn \l_semio_viz_geo_tmpa_fp { 90 }
      }
    \tl_put_right:Nx \l_semio_viz_geo_gr_coords_tl
      { \fp_eval:n {#1} , \fp_eval:n {#3} }
    \seq_gput_right:NV \g_semio_viz_geo_gr_seq \l_semio_viz_geo_gr_coords_tl
  }

% 〰️ One parallel at latitude #1 sampled from #2 to #3 every `precision` degrees plus the end longitude (d3 graticuleY).
\cs_new_protected:Npn \semio_viz_geo_gr_parallel:nnn #1#2#3
  {
    \tl_clear:N \l_semio_viz_geo_gr_coords_tl
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp {#2}
    \bool_while_do:nn
      {
        \fp_compare_p:nNn \l_semio_viz_geo_tmpa_fp <
          { (#3) - \c_semio_viz_geo_epsilon_fp }
      }
      {
        \tl_put_right:Nx \l_semio_viz_geo_gr_coords_tl
          { \fp_use:N \l_semio_viz_geo_tmpa_fp , \fp_eval:n {#1} ; }
        \fp_add:Nn \l_semio_viz_geo_tmpa_fp { \l_semio_viz_geo_gr_prec_fp }
      }
    \tl_put_right:Nx \l_semio_viz_geo_gr_coords_tl
      { \fp_eval:n {#3} , \fp_eval:n {#1} }
    \seq_gput_right:NV \g_semio_viz_geo_gr_seq \l_semio_viz_geo_gr_coords_tl
  }

% 🌐 The whole graticule under the option list #1: the two major lines first, then the minor grid.
\cs_new_protected:Npn \semio_viz_geo_graticule_lines:n #1
  {
    \semio_viz_geo_graticule_defaults:
    \keys_set:nn { semio / viz / geo / graticule } {#1}
    \seq_gclear:N \g_semio_viz_geo_gr_seq
    \semio_viz_geo_gr_major_meridians:
    \semio_viz_geo_gr_major_parallels:
    \semio_viz_geo_gr_minor_meridians:
    \semio_viz_geo_gr_minor_parallels:
  }

% 🌐 The major meridians, every `stepMajor` degrees across the major extent.
\cs_new_protected:Npn \semio_viz_geo_gr_major_meridians:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      {
        ceil ( \clist_item:Nn \l_semio_viz_geo_gr_major_clist { 1 }
               / \l_semio_viz_geo_gr_Dx_fp ) * \l_semio_viz_geo_gr_Dx_fp
      }
    \bool_while_do:nn
      {
        \fp_compare_p:nNn \l_semio_viz_geo_tmpb_fp <
          { \clist_item:Nn \l_semio_viz_geo_gr_major_clist { 3 } }
      }
      {
        \semio_viz_geo_gr_meridian:nnn { \l_semio_viz_geo_tmpb_fp }
          { \clist_item:Nn \l_semio_viz_geo_gr_major_clist { 2 } }
          { \clist_item:Nn \l_semio_viz_geo_gr_major_clist { 4 } }
        \fp_add:Nn \l_semio_viz_geo_tmpb_fp { \l_semio_viz_geo_gr_Dx_fp }
      }
  }

% 🌐 The major parallels, on the same major grid.
\cs_new_protected:Npn \semio_viz_geo_gr_major_parallels:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      {
        ceil ( \clist_item:Nn \l_semio_viz_geo_gr_major_clist { 2 }
               / \l_semio_viz_geo_gr_Dy_fp ) * \l_semio_viz_geo_gr_Dy_fp
      }
    \bool_while_do:nn
      {
        \fp_compare_p:nNn \l_semio_viz_geo_tmpb_fp <
          { \clist_item:Nn \l_semio_viz_geo_gr_major_clist { 4 } }
      }
      {
        \semio_viz_geo_gr_parallel:nnn { \l_semio_viz_geo_tmpb_fp }
          { \clist_item:Nn \l_semio_viz_geo_gr_major_clist { 1 } }
          { \clist_item:Nn \l_semio_viz_geo_gr_major_clist { 3 } }
        \fp_add:Nn \l_semio_viz_geo_tmpb_fp { \l_semio_viz_geo_gr_Dy_fp }
      }
  }

% 🌐 The minor meridians, every `stepMinor` degrees, skipping those a major line already carries.
\cs_new_protected:Npn \semio_viz_geo_gr_minor_meridians:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      {
        ceil ( \clist_item:Nn \l_semio_viz_geo_gr_minor_clist { 1 }
               / \l_semio_viz_geo_gr_dx_fp ) * \l_semio_viz_geo_gr_dx_fp
      }
    \bool_while_do:nn
      {
        \fp_compare_p:nNn \l_semio_viz_geo_tmpb_fp <
          { \clist_item:Nn \l_semio_viz_geo_gr_minor_clist { 3 } }
      }
      {
        \fp_compare:nNnT
          {
            abs ( \l_semio_viz_geo_tmpb_fp
                  - round ( \l_semio_viz_geo_tmpb_fp
                            / \l_semio_viz_geo_gr_Dx_fp , 0 )
                    * \l_semio_viz_geo_gr_Dx_fp )
          }
          > { \c_semio_viz_geo_epsilon_fp }
          {
            \semio_viz_geo_gr_meridian:nnn { \l_semio_viz_geo_tmpb_fp }
              { \clist_item:Nn \l_semio_viz_geo_gr_minor_clist { 2 } }
              { \clist_item:Nn \l_semio_viz_geo_gr_minor_clist { 4 } }
          }
        \fp_add:Nn \l_semio_viz_geo_tmpb_fp { \l_semio_viz_geo_gr_dx_fp }
      }
  }

% 🌐 The minor parallels, on the same minor grid and with the same skip.
\cs_new_protected:Npn \semio_viz_geo_gr_minor_parallels:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      {
        ceil ( \clist_item:Nn \l_semio_viz_geo_gr_minor_clist { 2 }
               / \l_semio_viz_geo_gr_dy_fp ) * \l_semio_viz_geo_gr_dy_fp
      }
    \bool_while_do:nn
      {
        \fp_compare_p:nNn \l_semio_viz_geo_tmpb_fp <
          { \clist_item:Nn \l_semio_viz_geo_gr_minor_clist { 4 } }
      }
      {
        \fp_compare:nNnT
          {
            abs ( \l_semio_viz_geo_tmpb_fp
                  - round ( \l_semio_viz_geo_tmpb_fp
                            / \l_semio_viz_geo_gr_Dy_fp , 0 )
                    * \l_semio_viz_geo_gr_Dy_fp )
          }
          > { \c_semio_viz_geo_epsilon_fp }
          {
            \semio_viz_geo_gr_parallel:nnn { \l_semio_viz_geo_tmpb_fp }
              { \clist_item:Nn \l_semio_viz_geo_gr_minor_clist { 1 } }
              { \clist_item:Nn \l_semio_viz_geo_gr_minor_clist { 3 } }
          }
        \fp_add:Nn \l_semio_viz_geo_tmpb_fp { \l_semio_viz_geo_gr_dy_fp }
      }
  }
%endregion 🔖️Graticule

%region 🔖️Measures
% 📐 d3-geo spherical measures on a `lon,lat; …` ring or point pair; all angles in radians internally.
\fp_new:N \l_semio_viz_geo_ms_a_fp
\fp_new:N \l_semio_viz_geo_ms_b_fp
\fp_new:N \l_semio_viz_geo_ms_c_fp
\fp_new:N \l_semio_viz_geo_ms_d_fp
\fp_new:N \l_semio_viz_geo_ms_sum_fp
\fp_new:N \l_semio_viz_geo_ms_lamprev_fp
\fp_new:N \l_semio_viz_geo_ms_cosprev_fp
\fp_new:N \l_semio_viz_geo_ms_sinprev_fp
\fp_new:N \l_semio_viz_geo_area_fp
\fp_new:N \l_semio_viz_geo_dist_fp
\clist_new:N \l_semio_viz_geo_ms_clist

% 🧮 Spherical polygon area in steradians (d3 geoArea on a single ring).
\cs_new_protected:Npn \semio_viz_geo_ring_area:n #1
  {
    \seq_set_split:Nnn \l_tmpa_seq { ; } {#1}
    \fp_zero:N \l_semio_viz_geo_ms_sum_fp
    \int_zero:N \l_tmpa_int
    \seq_map_inline:Nn \l_tmpa_seq
      {
        \tl_set:Nn \l_tmpb_tl {##1}
        \tl_trim_spaces:N \l_tmpb_tl
        \tl_if_empty:NF \l_tmpb_tl
          {
            \semio_viz_geo_area_point:nn
              { \clist_item:nn {##1} { 1 } }
              { \clist_item:nn {##1} { 2 } }
          }
      }
    \clist_set:Nx \l_semio_viz_geo_ms_clist { \seq_item:Nn \l_tmpa_seq { 1 } }
    \semio_viz_geo_area_point:nn
      { \clist_item:Nn \l_semio_viz_geo_ms_clist { 1 } }
      { \clist_item:Nn \l_semio_viz_geo_ms_clist { 2 } }
    \fp_set:Nn \l_semio_viz_geo_area_fp
      {
        (
          \l_semio_viz_geo_ms_sum_fp < 0
            ? 2 * pi + \l_semio_viz_geo_ms_sum_fp
            : \l_semio_viz_geo_ms_sum_fp
        ) * 2
      }
  }

% 📐 One vertex of the spherical area sum: the signed contribution of the segment from the previous
% vertex, in steradians.
\cs_new_protected:Npn \semio_viz_geo_area_point:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_geo_ms_a_fp { (#1) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_ms_b_fp
      { (#2) * \c_semio_viz_geo_radians_fp / 2 + pi / 4 }
    \int_compare:nNnTF \l_tmpa_int = { 0 }
      {
        \fp_set_eq:NN \l_semio_viz_geo_ms_lamprev_fp \l_semio_viz_geo_ms_a_fp
        \fp_set:Nn \l_semio_viz_geo_ms_cosprev_fp
          { cos ( \l_semio_viz_geo_ms_b_fp ) }
        \fp_set:Nn \l_semio_viz_geo_ms_sinprev_fp
          { sin ( \l_semio_viz_geo_ms_b_fp ) }
        \int_set:Nn \l_tmpa_int { 1 }
      }
      {
        \fp_set:Nn \l_semio_viz_geo_ms_c_fp
          { \l_semio_viz_geo_ms_a_fp - \l_semio_viz_geo_ms_lamprev_fp }
        \fp_set:Nn \l_semio_viz_geo_ms_d_fp
          { \l_semio_viz_geo_ms_c_fp >= 0 ? 1 : -1 }
        \fp_add:Nn \l_semio_viz_geo_ms_sum_fp
          {
            atan
              (
                \l_semio_viz_geo_ms_sinprev_fp * sin ( \l_semio_viz_geo_ms_b_fp )
                * \l_semio_viz_geo_ms_d_fp
                * sin ( \l_semio_viz_geo_ms_d_fp * \l_semio_viz_geo_ms_c_fp ) ,
                \l_semio_viz_geo_ms_cosprev_fp * cos ( \l_semio_viz_geo_ms_b_fp )
                + \l_semio_viz_geo_ms_sinprev_fp * sin ( \l_semio_viz_geo_ms_b_fp )
                  * cos ( \l_semio_viz_geo_ms_d_fp * \l_semio_viz_geo_ms_c_fp )
              )
          }
        \fp_set_eq:NN \l_semio_viz_geo_ms_lamprev_fp \l_semio_viz_geo_ms_a_fp
        \fp_set:Nn \l_semio_viz_geo_ms_cosprev_fp
          { cos ( \l_semio_viz_geo_ms_b_fp ) }
        \fp_set:Nn \l_semio_viz_geo_ms_sinprev_fp
          { sin ( \l_semio_viz_geo_ms_b_fp ) }
      }
  }

% 📏 d3 geoDistance: the great-circle angle between two lon/lat points in radians.
\cs_new_protected:Npn \semio_viz_geo_distance:nnnn #1#2#3#4
  {
    \fp_set:Nn \l_semio_viz_geo_ms_a_fp
      { ( (#3) - (#1) ) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_ms_b_fp { (#2) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_ms_c_fp { (#4) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_dist_fp
      {
        atan
          (
            sqrt
              (
                ( cos ( \l_semio_viz_geo_ms_c_fp )
                  * sin ( \l_semio_viz_geo_ms_a_fp ) ) ** 2
                + ( cos ( \l_semio_viz_geo_ms_b_fp )
                    * sin ( \l_semio_viz_geo_ms_c_fp )
                    - sin ( \l_semio_viz_geo_ms_b_fp )
                      * cos ( \l_semio_viz_geo_ms_c_fp )
                      * cos ( \l_semio_viz_geo_ms_a_fp ) ) ** 2
              ) ,
            sin ( \l_semio_viz_geo_ms_b_fp ) * sin ( \l_semio_viz_geo_ms_c_fp )
            + cos ( \l_semio_viz_geo_ms_b_fp ) * cos ( \l_semio_viz_geo_ms_c_fp )
              * cos ( \l_semio_viz_geo_ms_a_fp )
          )
      }
  }

% 🛰️ d3 geoInterpolate: point at parameter #5 along the great circle from (#1,#2) to (#3,#4); degrees into lon_fp/lat_fp.
\cs_new_protected:Npn \semio_viz_geo_interpolate:nnnnn #1#2#3#4#5
  {
    \semio_viz_geo_distance:nnnn {#1}{#2}{#3}{#4}
    \fp_compare:nNnTF \l_semio_viz_geo_dist_fp = { 0 }
      {
        \fp_set:Nn \l_semio_viz_geo_lon_fp {#1}
        \fp_set:Nn \l_semio_viz_geo_lat_fp {#2}
      }
      { \semio_viz_geo_interpolate_aux:nnnnn {#1}{#2}{#3}{#4}{#5} }
  }

% 🛫 The general case of the great-circle interpolation: the two endpoints weighted by the sines of
% the arc they subtend, which is the slerp d3 uses.
\cs_new_protected:Npn \semio_viz_geo_interpolate_aux:nnnnn #1#2#3#4#5
  {
    \fp_set:Nn \l_semio_viz_geo_ms_a_fp
      {
        sin ( (#5) * \l_semio_viz_geo_dist_fp )
        / sin ( \l_semio_viz_geo_dist_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_ms_b_fp
      {
        sin ( ( 1 - (#5) ) * \l_semio_viz_geo_dist_fp )
        / sin ( \l_semio_viz_geo_dist_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_rx_fp
      {
        \l_semio_viz_geo_ms_b_fp * cosd (#2) * cosd (#1)
        + \l_semio_viz_geo_ms_a_fp * cosd (#4) * cosd (#3)
      }
    \fp_set:Nn \l_semio_viz_geo_ry_fp
      {
        \l_semio_viz_geo_ms_b_fp * cosd (#2) * sind (#1)
        + \l_semio_viz_geo_ms_a_fp * cosd (#4) * sind (#3)
      }
    \fp_set:Nn \l_semio_viz_geo_rz_fp
      {
        \l_semio_viz_geo_ms_b_fp * sind (#2)
        + \l_semio_viz_geo_ms_a_fp * sind (#4)
      }
    \fp_set:Nn \l_semio_viz_geo_lon_fp
      {
        atan ( \l_semio_viz_geo_ry_fp , \l_semio_viz_geo_rx_fp )
        * \c_semio_viz_geo_degrees_fp
      }
    \fp_set:Nn \l_semio_viz_geo_lat_fp
      {
        atan ( \l_semio_viz_geo_rz_fp ,
               sqrt ( \l_semio_viz_geo_rx_fp * \l_semio_viz_geo_rx_fp
                      + \l_semio_viz_geo_ry_fp * \l_semio_viz_geo_ry_fp ) )
        * \c_semio_viz_geo_degrees_fp
      }
  }

% 🎯 d3 geoCentroid for a single spherical ring: the area-weighted cartesian centroid, degrees into lon_fp/lat_fp.
\fp_new:N \l_semio_viz_geo_ct_x_fp
\fp_new:N \l_semio_viz_geo_ct_y_fp
\fp_new:N \l_semio_viz_geo_ct_z_fp
\fp_new:N \l_semio_viz_geo_ct_xprev_fp
\fp_new:N \l_semio_viz_geo_ct_yprev_fp
\fp_new:N \l_semio_viz_geo_ct_zprev_fp

\cs_new_protected:Npn \semio_viz_geo_ring_centroid:n #1
  {
    \seq_set_split:Nnn \l_tmpa_seq { ; } {#1}
    \fp_zero:N \l_semio_viz_geo_ct_x_fp
    \fp_zero:N \l_semio_viz_geo_ct_y_fp
    \fp_zero:N \l_semio_viz_geo_ct_z_fp
    \fp_zero:N \l_semio_viz_geo_ct_mx_fp
    \fp_zero:N \l_semio_viz_geo_ct_my_fp
    \fp_zero:N \l_semio_viz_geo_ct_mz_fp
    \int_zero:N \l_semio_viz_geo_ct_n_int
    \int_zero:N \l_tmpa_int
    \seq_map_inline:Nn \l_tmpa_seq
      {
        \tl_set:Nn \l_tmpb_tl {##1}
        \tl_trim_spaces:N \l_tmpb_tl
        \tl_if_empty:NF \l_tmpb_tl
          {
            \semio_viz_geo_centroid_point:nn
              { \clist_item:nn {##1} { 1 } }
              { \clist_item:nn {##1} { 2 } }
          }
      }
    \clist_set:Nx \l_semio_viz_geo_ms_clist { \seq_item:Nn \l_tmpa_seq { 1 } }
    \semio_viz_geo_centroid_point:nn
      { \clist_item:Nn \l_semio_viz_geo_ms_clist { 1 } }
      { \clist_item:Nn \l_semio_viz_geo_ms_clist { 2 } }
    \fp_set:Nn \l_semio_viz_geo_ms_sum_fp
      {
        sqrt ( \l_semio_viz_geo_ct_x_fp * \l_semio_viz_geo_ct_x_fp
               + \l_semio_viz_geo_ct_y_fp * \l_semio_viz_geo_ct_y_fp
               + \l_semio_viz_geo_ct_z_fp * \l_semio_viz_geo_ct_z_fp )
      }
    \fp_compare:nNnT \l_semio_viz_geo_ms_sum_fp < { 1e-12 }
      { \semio_viz_geo_centroid_mean: }
    \fp_set:Nn \l_semio_viz_geo_lon_fp
      {
        atan ( \l_semio_viz_geo_ct_y_fp , \l_semio_viz_geo_ct_x_fp )
        * \c_semio_viz_geo_degrees_fp
      }
    \fp_set:Nn \l_semio_viz_geo_lat_fp
      {
        asin ( \l_semio_viz_geo_ct_z_fp / \l_semio_viz_geo_ms_sum_fp )
        * \c_semio_viz_geo_degrees_fp
      }
  }

% 🎯 Degenerate ring (a line, a repeated vertex, a single point): d3 falls back to the plain cartesian mean, and so does this.
\fp_new:N \l_semio_viz_geo_ct_mx_fp
\fp_new:N \l_semio_viz_geo_ct_my_fp
\fp_new:N \l_semio_viz_geo_ct_mz_fp
\int_new:N \l_semio_viz_geo_ct_n_int

\cs_new_protected:Npn \semio_viz_geo_centroid_mean:
  {
    \fp_set_eq:NN \l_semio_viz_geo_ct_x_fp \l_semio_viz_geo_ct_mx_fp
    \fp_set_eq:NN \l_semio_viz_geo_ct_y_fp \l_semio_viz_geo_ct_my_fp
    \fp_set_eq:NN \l_semio_viz_geo_ct_z_fp \l_semio_viz_geo_ct_mz_fp
    \fp_set:Nn \l_semio_viz_geo_ms_sum_fp
      {
        max ( 1e-12 ,
          sqrt ( \l_semio_viz_geo_ct_x_fp * \l_semio_viz_geo_ct_x_fp
                 + \l_semio_viz_geo_ct_y_fp * \l_semio_viz_geo_ct_y_fp
                 + \l_semio_viz_geo_ct_z_fp * \l_semio_viz_geo_ct_z_fp ) )
      }
  }

% 🎯 One vertex of the spherical centroid sum: its own unit vector and the segment it closes.
\cs_new_protected:Npn \semio_viz_geo_centroid_point:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_geo_rx_fp { cosd (#2) * cosd (#1) }
    \fp_set:Nn \l_semio_viz_geo_ry_fp { cosd (#2) * sind (#1) }
    \fp_set:Nn \l_semio_viz_geo_rz_fp { sind (#2) }
    \int_incr:N \l_semio_viz_geo_ct_n_int
    \fp_add:Nn \l_semio_viz_geo_ct_mx_fp { \l_semio_viz_geo_rx_fp }
    \fp_add:Nn \l_semio_viz_geo_ct_my_fp { \l_semio_viz_geo_ry_fp }
    \fp_add:Nn \l_semio_viz_geo_ct_mz_fp { \l_semio_viz_geo_rz_fp }
    \int_compare:nNnTF \l_tmpa_int = { 0 }
      { \int_set:Nn \l_tmpa_int { 1 } }
      {
        \fp_set:Nn \l_semio_viz_geo_ms_a_fp
          {
            \l_semio_viz_geo_ct_yprev_fp * \l_semio_viz_geo_rz_fp
            - \l_semio_viz_geo_ct_zprev_fp * \l_semio_viz_geo_ry_fp
          }
        \fp_set:Nn \l_semio_viz_geo_ms_b_fp
          {
            \l_semio_viz_geo_ct_zprev_fp * \l_semio_viz_geo_rx_fp
            - \l_semio_viz_geo_ct_xprev_fp * \l_semio_viz_geo_rz_fp
          }
        \fp_set:Nn \l_semio_viz_geo_ms_c_fp
          {
            \l_semio_viz_geo_ct_xprev_fp * \l_semio_viz_geo_ry_fp
            - \l_semio_viz_geo_ct_yprev_fp * \l_semio_viz_geo_rx_fp
          }
        \fp_set:Nn \l_semio_viz_geo_ms_d_fp
          {
            sqrt ( \l_semio_viz_geo_ms_a_fp * \l_semio_viz_geo_ms_a_fp
                   + \l_semio_viz_geo_ms_b_fp * \l_semio_viz_geo_ms_b_fp
                   + \l_semio_viz_geo_ms_c_fp * \l_semio_viz_geo_ms_c_fp )
          }
        \fp_compare:nNnTF \l_semio_viz_geo_ms_d_fp = { 0 }
          { \fp_zero:N \l_semio_viz_geo_ms_sum_fp }
          {
            \fp_set:Nn \l_semio_viz_geo_ms_sum_fp
              {
                - asin ( \l_semio_viz_geo_ms_d_fp )
                / \l_semio_viz_geo_ms_d_fp
              }
          }
        \fp_add:Nn \l_semio_viz_geo_ct_x_fp
          { \l_semio_viz_geo_ms_sum_fp * \l_semio_viz_geo_ms_a_fp }
        \fp_add:Nn \l_semio_viz_geo_ct_y_fp
          { \l_semio_viz_geo_ms_sum_fp * \l_semio_viz_geo_ms_b_fp }
        \fp_add:Nn \l_semio_viz_geo_ct_z_fp
          { \l_semio_viz_geo_ms_sum_fp * \l_semio_viz_geo_ms_c_fp }
      }
    \fp_set_eq:NN \l_semio_viz_geo_ct_xprev_fp \l_semio_viz_geo_rx_fp
    \fp_set_eq:NN \l_semio_viz_geo_ct_yprev_fp \l_semio_viz_geo_ry_fp
    \fp_set_eq:NN \l_semio_viz_geo_ct_zprev_fp \l_semio_viz_geo_rz_fp
  }

% ⭕ d3 geoCircle: a small circle of radius #3 degrees about (#1,#2), sampled every #4 degrees, as a `lon,lat; …` ring.
\tl_new:N \l_semio_viz_geo_circle_tl
\cs_new_protected:Npn \semio_viz_geo_circle:nnnn #1#2#3#4
  {
    \tl_clear:N \l_semio_viz_geo_circle_tl
    \fp_set:Nn \l_semio_viz_geo_ms_a_fp { (#3) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_ms_b_fp { (#4) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_dl_fp { - (#1) * \c_semio_viz_geo_radians_fp }
    \fp_set:Nn \l_semio_viz_geo_dp_fp { - (#2) * \c_semio_viz_geo_radians_fp }
    \fp_zero:N \l_semio_viz_geo_dg_fp
    \fp_set:Nn \l_semio_viz_geo_ms_c_fp
      { \l_semio_viz_geo_ms_a_fp + 2 * pi }
    \fp_set:Nn \l_semio_viz_geo_ms_d_fp
      { \l_semio_viz_geo_ms_a_fp - \l_semio_viz_geo_ms_b_fp / 2 }
    \bool_while_do:nn
      {
        \fp_compare_p:nNn \l_semio_viz_geo_ms_c_fp >
          \l_semio_viz_geo_ms_d_fp
      }
      {
        \fp_set:Nn \l_semio_viz_geo_lam_fp
          {
            atan ( - sin ( \l_semio_viz_geo_ms_a_fp )
                     * cos ( \l_semio_viz_geo_ms_c_fp ) ,
                   cos ( \l_semio_viz_geo_ms_a_fp ) )
          }
        \fp_set:Nn \l_semio_viz_geo_phi_fp
          {
            asin ( - sin ( \l_semio_viz_geo_ms_a_fp )
                     * sin ( \l_semio_viz_geo_ms_c_fp ) )
          }
        \semio_viz_geo_rotate_invert:
        \tl_put_right:Nx \l_semio_viz_geo_circle_tl
          {
            \fp_eval:n
              { \l_semio_viz_geo_lam_fp * \c_semio_viz_geo_degrees_fp } ,
            \fp_eval:n
              { \l_semio_viz_geo_phi_fp * \c_semio_viz_geo_degrees_fp } ;
          }
        \fp_sub:Nn \l_semio_viz_geo_ms_c_fp { \l_semio_viz_geo_ms_b_fp }
      }
  }
%endregion 🔖️Measures

%region 🔖️Rendering
% 🖌️ Strokes and fills whatever \semio_viz_geo_path:nn produced, and mirrors every subpath into the probe stream.
\tl_new:N \l_semio_viz_geo_style_tl
\tl_new:N \l_semio_viz_geo_draw_tl

\seq_new:N \l_semio_viz_geo_draw_seq

\cs_new_protected:Npn \semio_viz_geo_draw_subpath:nnn #1#2#3
  {
    \seq_set_split:Nnn \l_tmpb_seq { ; } {#3}
    \seq_clear:N \l_semio_viz_geo_draw_seq
    \seq_map_inline:Nn \l_tmpb_seq
      { \seq_put_right:Nn \l_semio_viz_geo_draw_seq { ( ##1 ) } }
    \int_compare:nNnT { \seq_count:N \l_semio_viz_geo_draw_seq } > { 1 }
      {
        \tl_set:Nx \l_semio_viz_geo_draw_tl
          { \seq_use:Nn \l_semio_viz_geo_draw_seq { -- } }
        \int_compare:nNnT {#2} = { 1 }
          { \tl_put_right:Nn \l_semio_viz_geo_draw_tl { -- cycle } }
        \use:x
          {
            \exp_not:N \path [ \exp_not:V \l_semio_viz_geo_style_tl ]
              \exp_not:V \l_semio_viz_geo_draw_tl ;
          }
        \semio_viz_probe_geometry:nx { path }
          { \seq_use:Nn \l_tmpb_seq { , } }
      }
  }

% 🖌️ Strokes every subpath the last projection produced under the TikZ style #1, and mirrors each
% one into the probe stream.
\cs_new_protected:Npn \semio_viz_geo_draw:n #1
  {
    \tl_set:Nx \l_semio_viz_geo_style_tl {#1}
    \seq_map_inline:Nn \g_semio_viz_geo_path_seq
      { \semio_viz_geo_draw_subpath:nnn {#1} ##1 }
  }

% 🎨 Draws every part of a geometry with a per-part style: #3 is expanded with {type}{id}{value} and must yield TikZ keys.
\tl_new:N \l_semio_viz_geo_partstyle_tl
\tl_new:N \l_semio_viz_geo_partid_tl
\tl_new:N \l_semio_viz_geo_partvalue_tl

\cs_new_protected:Npn \semio_viz_geo_draw_geometry:nnn #1#2#3
  {
    \semio_viz_geo_use:n {#1}
    \tl_set:Nn \l_semio_viz_geo_partstyle_tl {#3}
    \semio_viz_geom_map_inline:nn {#2}
      { \semio_viz_geo_draw_part:nnnn ##1 }
  }

% 🎨 One part of the geometry, projected on its own and stroked with the per-part style expanded
% from its type, id and value — which is what lets a choropleth colour each part differently.
\cs_new_protected:Npn \semio_viz_geo_draw_part:nnnn #1#2#3#4
  {
    \tl_set:Nn \l_semio_viz_geo_partid_tl {#2}
    \tl_set:Nn \l_semio_viz_geo_partvalue_tl {#3}
    \seq_gclear:N \g_semio_viz_geo_path_seq
    \semio_viz_geo_path_part:nnnn {#1}{#2}{#3}{#4}
    \exp_args:NV \semio_viz_geo_draw:n \l_semio_viz_geo_partstyle_tl
  }

% 📍 Projects a geometry's parts to their first vertex and runs #3 with the plane x, y, id and value.
\cs_new_protected:Npn \semio_viz_geo_map_anchors:nnn #1#2#3
  {
    \semio_viz_geo_use:n {#1}
    \tl_set:Nn \l_semio_viz_geo_partstyle_tl {#3}
    \semio_viz_geom_map_inline:nn {#2}
      { \semio_viz_geo_anchor:nnnn ##1 }
  }

% 📍 The anchor of one part: its centroid in figure coordinates, handed to the caller's code
% together with the part's own id and value.
\cs_new_protected:Npn \semio_viz_geo_anchor:nnnn #1#2#3#4
  {
    \str_if_eq:nnTF {#1} { point }
      {
        \semio_viz_geo_forward:nn
          { \clist_item:nn {#4} { 1 } } { \clist_item:nn {#4} { 2 } }
      }
      {
        \semio_viz_geo_ring_centroid:n {#4}
        \semio_viz_geo_forward:nn
          { \l_semio_viz_geo_lon_fp } { \l_semio_viz_geo_lat_fp }
      }
    \use:x
      {
        \exp_not:V \l_semio_viz_geo_partstyle_tl
          { \fp_eval:n { \l_semio_viz_geo_x_fp } }
          { \fp_eval:n { \l_semio_viz_geo_y_fp } }
          { \exp_not:n {#2} } { \exp_not:n {#3} }
      }
  }

% 🔚 First and last vertex of a `lon,lat; …` coordinate list, as two clists the families read component-wise.
\seq_new:N \l_semio_viz_geo_vtx_seq
\clist_new:N \l_semio_viz_geo_pta_clist
\clist_new:N \l_semio_viz_geo_ptb_clist

\cs_new_protected:Npn \semio_viz_geo_endpoints:n #1
  {
    \seq_set_split:Nnn \l_semio_viz_geo_vtx_seq { ; } {#1}
    \clist_set:Nx \l_semio_viz_geo_pta_clist
      { \seq_item:Nn \l_semio_viz_geo_vtx_seq { 1 } }
    \clist_set:Nx \l_semio_viz_geo_ptb_clist
      {
        \seq_item:Nn \l_semio_viz_geo_vtx_seq
          { \seq_count:N \l_semio_viz_geo_vtx_seq }
      }
  }

% 📊 Minimum and maximum of a geometry's part values, for the colour and size scales of the statistical families.
\fp_new:N \l_semio_viz_geo_vmin_fp
\fp_new:N \l_semio_viz_geo_vmax_fp

\cs_new_protected:Npn \semio_viz_geo_value_extent:n #1
  {
    \fp_set:Nn \l_semio_viz_geo_vmin_fp { inf }
    \fp_set:Nn \l_semio_viz_geo_vmax_fp { -inf }
    \semio_viz_geom_map_inline:nn {#1}
      { \semio_viz_geo_value_extent_part:nnnn ##1 }
  }

% 📐 Widens the running value extent to hold one part's own value.
\cs_new_protected:Npn \semio_viz_geo_value_extent_part:nnnn #1#2#3#4
  {
    \fp_set:Nn \l_semio_viz_geo_vmin_fp
      { min ( \l_semio_viz_geo_vmin_fp , #3 ) }
    \fp_set:Nn \l_semio_viz_geo_vmax_fp
      { max ( \l_semio_viz_geo_vmax_fp , #3 ) }
  }
%endregion 🔖️Rendering

%region 🔖️FamilyBase
% 🧱 The option vocabulary every geo family shares, so no namespace package re-invents projection, extent or palette keys.
%region 🔖️Keys
% 🔑 semio / viz / geo / base
% 🔑 projection (kind)   projection kind for the figure; default equirectangular.
% 🔑 rotate     (l,p,g)  projection rotation in degrees; default 0,0,0.
% 🔑 parallels  (p0,p1)  conic standard parallels in degrees; default 0,60.
% 🔑 geometry   (name)   geometry collection to draw; default demo-geo-regions.
% 🔑 width      (mm)     drawing width; default 76.
% 🔑 height     (mm)     drawing height; default 44.
% 🔑 palette    (choice) sequential | diverging | terrain | bathymetric | neutral; default sequential.
% 🔑 stroke     (colour) outline colour token; default semio-chrome-border-emphasized.
% 🔑 lineWidth  (dim)    outline width; default \semio@stroke@hairline.
% 🔑 opacity    (0..1)   fill opacity; default 1.
% 🔑 steps      (int)    number of discrete ramp steps; default 5.
% 🔑 fit        (choice) geometry | world; what the projection is fitted to. Families that draw a graticule default to world.
\tl_new:N \l_semio_viz_geo_f_projection_tl
\clist_new:N \l_semio_viz_geo_f_rotate_clist
\clist_new:N \l_semio_viz_geo_f_parallels_clist
\tl_new:N \l_semio_viz_geo_f_geometry_tl
\fp_new:N \l_semio_viz_geo_f_width_fp
\fp_new:N \l_semio_viz_geo_f_height_fp
\tl_new:N \l_semio_viz_geo_f_palette_tl
\tl_new:N \l_semio_viz_geo_f_stroke_tl
\tl_new:N \l_semio_viz_geo_f_linewidth_tl
\fp_new:N \l_semio_viz_geo_f_opacity_fp
\int_new:N \l_semio_viz_geo_f_steps_int
\tl_new:N \l_semio_viz_geo_f_fit_tl

\keys_define:nn { semio / viz / geo / base }
  {
    projection .tl_set:N = \l_semio_viz_geo_f_projection_tl ,
    rotate .clist_set:N = \l_semio_viz_geo_f_rotate_clist ,
    parallels .clist_set:N = \l_semio_viz_geo_f_parallels_clist ,
    geometry .tl_set:N = \l_semio_viz_geo_f_geometry_tl ,
    width .fp_set:N = \l_semio_viz_geo_f_width_fp ,
    height .fp_set:N = \l_semio_viz_geo_f_height_fp ,
    palette .tl_set:N = \l_semio_viz_geo_f_palette_tl ,
    stroke .tl_set:N = \l_semio_viz_geo_f_stroke_tl ,
    lineWidth .tl_set:N = \l_semio_viz_geo_f_linewidth_tl ,
    opacity .fp_set:N = \l_semio_viz_geo_f_opacity_fp ,
    steps .int_set:N = \l_semio_viz_geo_f_steps_int ,
    fit .tl_set:N = \l_semio_viz_geo_f_fit_tl ,
    unknown .code:n = { } ,
  }
%endregion 🔖️Keys

% ♻️ Puts the geo family keys every map family shares back to their documented defaults.
\cs_new_protected:Npn \semio_viz_geo_base_reset:
  {
    \tl_set:Nn \l_semio_viz_geo_f_projection_tl { equirectangular }
    \clist_set:Nn \l_semio_viz_geo_f_rotate_clist { 0, 0, 0 }
    \clist_set:Nn \l_semio_viz_geo_f_parallels_clist { 0, 60 }
    \tl_set:Nn \l_semio_viz_geo_f_geometry_tl { demo-geo-regions }
    \fp_set:Nn \l_semio_viz_geo_f_width_fp { 76 }
    \fp_set:Nn \l_semio_viz_geo_f_height_fp { 44 }
    \tl_set:Nn \l_semio_viz_geo_f_palette_tl { sequential }
    \tl_set:Nn \l_semio_viz_geo_f_stroke_tl { semio-chrome-border-emphasized }
    \tl_set:Nn \l_semio_viz_geo_f_linewidth_tl { \semio@stroke@hairline }
    \fp_set:Nn \l_semio_viz_geo_f_opacity_fp { 1 }
    \int_set:Nn \l_semio_viz_geo_f_steps_int { 5 }
    \tl_set:Nn \l_semio_viz_geo_f_fit_tl { geometry }
  }

% 🖼️ Defines the figure's projection `semio-family` and fits the named geometry into the width/height box.
\cs_new_protected:Npn \semio_viz_geo_base_frame:n #1
  {
    \use:x
      {
        \exp_not:N \semio_viz_geo_define:nn { semio-family }
          {
            kind = \l_semio_viz_geo_f_projection_tl ,
            rotate = { \exp_not:V \l_semio_viz_geo_f_rotate_clist } ,
            parallels = { \exp_not:V \l_semio_viz_geo_f_parallels_clist } ,
          }
      }
    \str_if_eq:VnTF \l_semio_viz_geo_f_fit_tl { world }
      { \semio_viz_geo_base_fit:n { demo-geo-world } }
      { \semio_viz_geo_base_fit:n {#1} }
  }

% 📐 Runs the fit against the chosen reference geometry.
\cs_new_protected:Npn \semio_viz_geo_base_fit:n #1
  {
    \semio_viz_geo_fit_extent:nnnnnn { semio-family } {#1}
      { 0 } { 0 }
      { \fp_eval:n { \l_semio_viz_geo_f_width_fp } }
      { \fp_eval:n { \l_semio_viz_geo_f_height_fp } }
  }

% 🎨 A TikZ colour expression for the palette at normalised position #1 in [0,1], quantised to `steps` levels.
\cs_new:Npn \semio_viz_geo_ramp:n #1
  {
    \str_case:VnF \l_semio_viz_geo_f_palette_tl
      {
        { diverging }
          {
            \semio_viz_theme_color:n { \fp_compare:nTF { (#1) < 0.5 } { 1 } { 0 } }
            ! \semio_viz_geo_ramp_pct:n {#1} ! semio-chrome-canvas
          }
        { terrain }
          {
            \semio_viz_theme_color:n { 2 }
            ! \semio_viz_geo_ramp_pct:n {#1} ! \semio_viz_theme_color:n { 3 }
          }
        { bathymetric }
          { \semio_viz_theme_color:n { 1 } ! \semio_viz_geo_ramp_pct:n {#1} ! semio-chrome-canvas }
        { neutral }
          { semio-chrome-text-normal ! \semio_viz_geo_ramp_pct:n {#1} ! semio-chrome-canvas }
      }
      { \semio_viz_theme_color:n { 0 } ! \semio_viz_geo_ramp_pct:n {#1} ! semio-chrome-canvas }
  }

% 🔢 The quantised mixing percentage: `steps` levels between 18 % and 100 %, diverging measured from the midpoint.
\cs_new:Npn \semio_viz_geo_ramp_pct:n #1
  {
    \semio_viz_geo_ramp_quant:n
      {
        \str_if_eq:VnTF \l_semio_viz_geo_f_palette_tl { diverging }
          { abs ( 2 * (#1) - 1 ) }
          { min ( 1 , max ( 0 , #1 ) ) }
      }
  }

% 🎨 Snaps the ramp position #1 onto one of `steps` classes, so a stepped ramp reads as classes.
\cs_new:Npn \semio_viz_geo_ramp_quant:n #1
  {
    \fp_eval:n
      {
        round
          (
            min ( 100 , max ( 0 ,
              18 + 82 *
              round ( min ( 1 , max ( 0 , #1 ) )
                      * ( \l_semio_viz_geo_f_steps_int - 1 ) )
              / ( \l_semio_viz_geo_f_steps_int - 1 ) ) )
            , 0
          )
      }
  }

% 🔢 Normalises a part value into [0,1] against the geometry's own value extent.
\cs_new:Npn \semio_viz_geo_norm:n #1
  {
    \fp_eval:n
      {
        \l_semio_viz_geo_vmax_fp - \l_semio_viz_geo_vmin_fp = 0
          ? 0.5
          : ( (#1) - \l_semio_viz_geo_vmin_fp )
            / ( \l_semio_viz_geo_vmax_fp - \l_semio_viz_geo_vmin_fp )
      }
  }
%endregion 🔖️FamilyBase

