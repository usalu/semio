%region 🔖️LayoutRegistry
% 📋 `semio / viz / geo / layout` -- options of the `projection` layout algorithm.
%   projection  (name of a projection defined with \SemioVizProjection)  default `equirectangular`
%   fit         (`none` or `extent`)                                     default `extent`
%   x0,y0,x1,y1 (millimetre rectangle the geometry is fitted into)       default 0,0,100,60
\tl_new:N \l_semio_viz_geo_layout_proj_tl
\tl_new:N \l_semio_viz_geo_layout_fit_tl
\fp_new:N \l_semio_viz_geo_layout_xlo_fp
\fp_new:N \l_semio_viz_geo_layout_ylo_fp
\fp_new:N \l_semio_viz_geo_layout_xhi_fp
\fp_new:N \l_semio_viz_geo_layout_yhi_fp
\seq_new:N \l_semio_viz_geo_layout_pts_seq
\seq_new:N \l_semio_viz_geo_layout_src_seq

\keys_define:nn { semio / viz / geo / layout }
  {
    projection .tl_set:N = \l_semio_viz_geo_layout_proj_tl ,
    fit .tl_set:N = \l_semio_viz_geo_layout_fit_tl ,
    x0 .fp_set:N = \l_semio_viz_geo_layout_xlo_fp ,
    y0 .fp_set:N = \l_semio_viz_geo_layout_ylo_fp ,
    x1 .fp_set:N = \l_semio_viz_geo_layout_xhi_fp ,
    y1 .fp_set:N = \l_semio_viz_geo_layout_yhi_fp ,
  }

% ♻️ Puts the projection layout's options back to their defaults, then reads the list #1.
\cs_new_protected:Npn \semio_viz_geo_layout_keys:n #1
  {
    \tl_set:Nn \l_semio_viz_geo_layout_proj_tl { equirectangular }
    \tl_set:Nn \l_semio_viz_geo_layout_fit_tl { extent }
    \fp_zero:N \l_semio_viz_geo_layout_xlo_fp
    \fp_zero:N \l_semio_viz_geo_layout_ylo_fp
    \fp_set:Nn \l_semio_viz_geo_layout_xhi_fp { 100 }
    \fp_set:Nn \l_semio_viz_geo_layout_yhi_fp { 60 }
    \keys_set:nn { semio / viz / geo / layout } {#1}
  }

% 🌐 Projects every part of a geometry into plane millimetres and stores the result as the
% geometry collection #2, so a renderer draws projected parts exactly like source parts.
\cs_new_protected:Npn \semio_viz_geo_layout_project:nn #1#2
  {
    \semio_viz_geom_new:n {#2}
    \semio_viz_geom_map_inline:nn {#1}
      { \semio_viz_geo_layout_part:nnnnn {#2} ##1 }
  }

% 🧩 One part of the projection layout: its vertices projected into the plane and filed as a part
% of the output collection #1, keeping the part's own type, id and value.
\cs_new_protected:Npn \semio_viz_geo_layout_part:nnnnn #1#2#3#4#5
  {
    \seq_clear:N \l_semio_viz_geo_layout_pts_seq
    \seq_set_split:Nnn \l_semio_viz_geo_layout_src_seq { ; } {#5}
    \seq_map_inline:Nn \l_semio_viz_geo_layout_src_seq
      { \semio_viz_geo_layout_vertex:n {##1} }
    \use:x
      {
        \exp_not:N \semio_viz_geom_part:nnnn { \exp_not:n {#1} } { \exp_not:n {#2} }
          { id = \exp_not:n {#3} , value = \exp_not:n {#4} }
          { \seq_use:Nn \l_semio_viz_geo_layout_pts_seq { ; } }
      }
  }

% 📍 One lon/lat vertex #1 of that part, projected and appended to the part being built.
\cs_new_protected:Npn \semio_viz_geo_layout_vertex:n #1
  {
    \semio_viz_geo_forward:nn { \clist_item:nn {#1} { 1 } } { \clist_item:nn {#1} { 2 } }
    \seq_put_right:Nx \l_semio_viz_geo_layout_pts_seq
      {
        \fp_eval:n { \l_semio_viz_geo_x_fp } , \fp_eval:n { \l_semio_viz_geo_y_fp }
      }
  }

% 🗺️ `projection`: a geographic collection projected into plane coordinates as a new collection,
% so any planar family can draw geography without knowing what a projection is.
\semio_viz_layout_define:nn { projection }
  {
    \semio_viz_geo_layout_keys:n {#3}
    \str_if_eq:VnT \l_semio_viz_geo_layout_fit_tl { extent }
      {
        \use:x
          {
            \exp_not:N \semio_viz_geo_fit_extent:nnnnnn
              { \exp_not:V \l_semio_viz_geo_layout_proj_tl } { \exp_not:n {#1} }
              { \fp_use:N \l_semio_viz_geo_layout_xlo_fp } { \fp_use:N \l_semio_viz_geo_layout_ylo_fp }
              { \fp_use:N \l_semio_viz_geo_layout_xhi_fp } { \fp_use:N \l_semio_viz_geo_layout_yhi_fp }
          }
      }
    \exp_args:NV \semio_viz_geo_use:n \l_semio_viz_geo_layout_proj_tl
    \semio_viz_geo_layout_project:nn {#1} {#2}
  }
%endregion 🔖️LayoutRegistry

