%region 🔖️Constants
% 🔢 Degree/radian conversion and the d3-geo tolerances, named so that no renderer spells a magic number.
\fp_const:Nn \c_semio_viz_geo_radians_fp { pi / 180 }
\fp_const:Nn \c_semio_viz_geo_degrees_fp { 180 / pi }
\fp_const:Nn \c_semio_viz_geo_halfpi_fp { pi / 2 }
\fp_const:Nn \c_semio_viz_geo_tau_fp { 2 * pi }
\fp_const:Nn \c_semio_viz_geo_epsilon_fp { 1e-6 }
\fp_const:Nn \c_semio_viz_geo_cosmindistance_fp { cosd ( 30 ) }
\int_const:Nn \c_semio_viz_geo_maxdepth_int { 16 }
\int_const:Nn \c_semio_viz_geo_newton_int { 25 }
%endregion 🔖️Constants

%region 🔖️State
\fp_new:N \l_semio_viz_geo_k_fp
\fp_new:N \l_semio_viz_geo_tx_fp
\fp_new:N \l_semio_viz_geo_ty_fp
\fp_new:N \l_semio_viz_geo_dl_fp
\fp_new:N \l_semio_viz_geo_dp_fp
\fp_new:N \l_semio_viz_geo_dg_fp
\fp_new:N \l_semio_viz_geo_ox_fp
\fp_new:N \l_semio_viz_geo_oy_fp
\fp_new:N \l_semio_viz_geo_n_fp
\fp_new:N \l_semio_viz_geo_f_fp
\fp_new:N \l_semio_viz_geo_c_fp
\fp_new:N \l_semio_viz_geo_rzero_fp
\fp_new:N \l_semio_viz_geo_g_fp
\fp_new:N \l_semio_viz_geo_cosphistd_fp
\fp_new:N \l_semio_viz_geo_clip_fp
\fp_new:N \l_semio_viz_geo_deltasq_fp
\tl_new:N \l_semio_viz_geo_raw_tl
\fp_new:N \l_semio_viz_geo_lam_fp
\fp_new:N \l_semio_viz_geo_phi_fp
\fp_new:N \l_semio_viz_geo_px_fp
\fp_new:N \l_semio_viz_geo_py_fp
\fp_new:N \l_semio_viz_geo_x_fp
\fp_new:N \l_semio_viz_geo_y_fp
\fp_new:N \l_semio_viz_geo_lon_fp
\fp_new:N \l_semio_viz_geo_lat_fp
\fp_new:N \l_semio_viz_geo_tmpa_fp
\fp_new:N \l_semio_viz_geo_tmpb_fp
\fp_new:N \l_semio_viz_geo_tmpc_fp
\fp_new:N \l_semio_viz_geo_tmpd_fp
\fp_new:N \l_semio_viz_geo_rx_fp
\fp_new:N \l_semio_viz_geo_ry_fp
\fp_new:N \l_semio_viz_geo_rz_fp
\fp_new:N \l_semio_viz_geo_rk_fp
%endregion 🔖️State

%region 🔖️Rotation
% 🌐 d3-geo rotateRadians: the lambda shift first, then the phi/gamma rotation of the cartesian frame.
\cs_new_protected:Npn \semio_viz_geo_rotate:
  {
    \fp_add:Nn \l_semio_viz_geo_lam_fp { \l_semio_viz_geo_dl_fp }
    \fp_compare:nNnT { abs ( \l_semio_viz_geo_lam_fp ) } > { pi }
      {
        \fp_sub:Nn \l_semio_viz_geo_lam_fp
          { round ( \l_semio_viz_geo_lam_fp / ( 2 * pi ) ) * 2 * pi }
      }
    \bool_lazy_and:nnF
      { \fp_compare_p:nNn { abs ( \l_semio_viz_geo_dp_fp ) } = { 0 } }
      { \fp_compare_p:nNn { abs ( \l_semio_viz_geo_dg_fp ) } = { 0 } }
      { \semio_viz_geo_rotate_phigamma: }
  }

% 🔄 The pitch and roll of the rotation, applied on the unit sphere after the yaw.
\cs_new_protected:Npn \semio_viz_geo_rotate_phigamma:
  {
    \fp_set:Nn \l_semio_viz_geo_rx_fp
      { cos ( \l_semio_viz_geo_lam_fp ) * cos ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_ry_fp
      { sin ( \l_semio_viz_geo_lam_fp ) * cos ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_rz_fp { sin ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_rk_fp
      {
        \l_semio_viz_geo_rz_fp * cos ( \l_semio_viz_geo_dp_fp )
        + \l_semio_viz_geo_rx_fp * sin ( \l_semio_viz_geo_dp_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_lam_fp
      {
        atan
          (
            \l_semio_viz_geo_ry_fp * cos ( \l_semio_viz_geo_dg_fp )
            - \l_semio_viz_geo_rk_fp * sin ( \l_semio_viz_geo_dg_fp ) ,
            \l_semio_viz_geo_rx_fp * cos ( \l_semio_viz_geo_dp_fp )
            - \l_semio_viz_geo_rz_fp * sin ( \l_semio_viz_geo_dp_fp )
          )
      }
    \fp_set:Nn \l_semio_viz_geo_phi_fp
      {
        asin
          (
            \l_semio_viz_geo_rk_fp * cos ( \l_semio_viz_geo_dg_fp )
            + \l_semio_viz_geo_ry_fp * sin ( \l_semio_viz_geo_dg_fp )
          )
      }
  }

% 🔁 Inverse rotation: the phi/gamma frame first, then the lambda shift removed.
\cs_new_protected:Npn \semio_viz_geo_rotate_invert:
  {
    \bool_lazy_and:nnF
      { \fp_compare_p:nNn { abs ( \l_semio_viz_geo_dp_fp ) } = { 0 } }
      { \fp_compare_p:nNn { abs ( \l_semio_viz_geo_dg_fp ) } = { 0 } }
      { \semio_viz_geo_rotate_phigamma_invert: }
    \fp_sub:Nn \l_semio_viz_geo_lam_fp { \l_semio_viz_geo_dl_fp }
    \fp_compare:nNnT { abs ( \l_semio_viz_geo_lam_fp ) } > { pi }
      {
        \fp_sub:Nn \l_semio_viz_geo_lam_fp
          { round ( \l_semio_viz_geo_lam_fp / ( 2 * pi ) ) * 2 * pi }
      }
  }

% 🔄 The inverse of that pitch and roll, for the way back from the plane to the sphere.
\cs_new_protected:Npn \semio_viz_geo_rotate_phigamma_invert:
  {
    \fp_set:Nn \l_semio_viz_geo_rx_fp
      { cos ( \l_semio_viz_geo_lam_fp ) * cos ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_ry_fp
      { sin ( \l_semio_viz_geo_lam_fp ) * cos ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_rz_fp { sin ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_rk_fp
      {
        \l_semio_viz_geo_rz_fp * cos ( \l_semio_viz_geo_dg_fp )
        - \l_semio_viz_geo_ry_fp * sin ( \l_semio_viz_geo_dg_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_lam_fp
      {
        atan
          (
            \l_semio_viz_geo_ry_fp * cos ( \l_semio_viz_geo_dg_fp )
            + \l_semio_viz_geo_rz_fp * sin ( \l_semio_viz_geo_dg_fp ) ,
            \l_semio_viz_geo_rx_fp * cos ( \l_semio_viz_geo_dp_fp )
            + \l_semio_viz_geo_rk_fp * sin ( \l_semio_viz_geo_dp_fp )
          )
      }
    \fp_set:Nn \l_semio_viz_geo_phi_fp
      {
        asin
          (
            \l_semio_viz_geo_rk_fp * cos ( \l_semio_viz_geo_dp_fp )
            - \l_semio_viz_geo_rx_fp * sin ( \l_semio_viz_geo_dp_fp )
          )
      }
  }
%endregion 🔖️Rotation

%region 🔖️RawProjections
% 🗺️ Raw projections, verbatim d3-geo: unit sphere in radians, plane coordinates out, no scale or translate.
\cs_new_protected:Npn \semio_viz_geo_raw:
  { \exp_args:NV \semio_viz_geo_raw_aux:n \l_semio_viz_geo_raw_tl }

% 🗺️ Dispatches to the raw projection named #1; an unknown name is an error, not a fallback.
\cs_new_protected:Npn \semio_viz_geo_raw_aux:n #1
  {
    \str_case:nnF {#1}
      {
        { equirectangular } { \semio_viz_geo_raw_equirectangular: }
        { mercator } { \semio_viz_geo_raw_mercator: }
        { transverse-mercator } { \semio_viz_geo_raw_transverse_mercator: }
        { equal-earth } { \semio_viz_geo_raw_equal_earth: }
        { natural-earth1 } { \semio_viz_geo_raw_naturalearth: }
        { orthographic } { \semio_viz_geo_raw_orthographic: }
        { stereographic } { \semio_viz_geo_raw_stereographic: }
        { gnomonic } { \semio_viz_geo_raw_gnomonic: }
        { azimuthal-equal-area } { \semio_viz_geo_raw_azimuthal_equal_area: }
        { azimuthal-equidistant } { \semio_viz_geo_raw_azimuthal_equidistant: }
        { conic-conformal } { \semio_viz_geo_raw_conic_conformal: }
        { conic-equal-area } { \semio_viz_geo_raw_conic_equal_area: }
        { conic-equidistant } { \semio_viz_geo_raw_conic_equidistant: }
        { cylindrical-equal-area } { \semio_viz_geo_raw_cylindrical_equal_area: }
      }
      { \msg_error:nnn { semio-viz } { unknown-projection-kind } {#1} }
  }

% 🗺️ `equirectangular`: longitude and latitude taken as the two plane coordinates unchanged.
\cs_new_protected:Npn \semio_viz_geo_raw_equirectangular:
  {
    \fp_set_eq:NN \l_semio_viz_geo_px_fp \l_semio_viz_geo_lam_fp
    \fp_set_eq:NN \l_semio_viz_geo_py_fp \l_semio_viz_geo_phi_fp
  }

% 🗺️ `mercator`: conformal, the latitude through the Gudermannian, so angles survive and areas do not.
\cs_new_protected:Npn \semio_viz_geo_raw_mercator:
  {
    \fp_set_eq:NN \l_semio_viz_geo_px_fp \l_semio_viz_geo_lam_fp
    \fp_set:Nn \l_semio_viz_geo_py_fp
      { ln ( tan ( ( pi / 2 + \l_semio_viz_geo_phi_fp ) / 2 ) ) }
  }

% 🗺️ `transverse-mercator`: the same conformal cylinder laid on its side.
\cs_new_protected:Npn \semio_viz_geo_raw_transverse_mercator:
  {
    \fp_set:Nn \l_semio_viz_geo_px_fp
      { ln ( tan ( ( pi / 2 + \l_semio_viz_geo_phi_fp ) / 2 ) ) }
    \fp_set:Nn \l_semio_viz_geo_py_fp { - \l_semio_viz_geo_lam_fp }
  }

\fp_const:Nn \c_semio_viz_geo_ee_ka_fp { 1.340264 }
\fp_const:Nn \c_semio_viz_geo_ee_kb_fp { -0.081106 }
\fp_const:Nn \c_semio_viz_geo_ee_kc_fp { 0.000893 }
\fp_const:Nn \c_semio_viz_geo_ee_kd_fp { 0.003796 }
\fp_const:Nn \c_semio_viz_geo_ee_m_fp { sqrt ( 3 ) / 2 }

% 🗺️ `equal-earth`: Šavrič, Patterson and Jenny's equal-area pseudocylindrical polynomial.
\cs_new_protected:Npn \semio_viz_geo_raw_equal_earth:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      { asin ( \c_semio_viz_geo_ee_m_fp * sin ( \l_semio_viz_geo_phi_fp ) ) }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp }
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      {
        \l_semio_viz_geo_tmpb_fp * \l_semio_viz_geo_tmpb_fp
        * \l_semio_viz_geo_tmpb_fp
      }
    \fp_set:Nn \l_semio_viz_geo_px_fp
      {
        \l_semio_viz_geo_lam_fp * cos ( \l_semio_viz_geo_tmpa_fp )
        /
        (
          \c_semio_viz_geo_ee_m_fp *
          (
            \c_semio_viz_geo_ee_ka_fp
            + 3 * \c_semio_viz_geo_ee_kb_fp * \l_semio_viz_geo_tmpb_fp
            + \l_semio_viz_geo_tmpc_fp *
              ( 7 * \c_semio_viz_geo_ee_kc_fp
                + 9 * \c_semio_viz_geo_ee_kd_fp * \l_semio_viz_geo_tmpb_fp )
          )
        )
      }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      {
        \l_semio_viz_geo_tmpa_fp *
        (
          \c_semio_viz_geo_ee_ka_fp
          + \c_semio_viz_geo_ee_kb_fp * \l_semio_viz_geo_tmpb_fp
          + \l_semio_viz_geo_tmpc_fp *
            ( \c_semio_viz_geo_ee_kc_fp
              + \c_semio_viz_geo_ee_kd_fp * \l_semio_viz_geo_tmpb_fp )
        )
      }
  }

% 🗺️ `natural-earth1`: Patterson's compromise pseudocylindrical, neither conformal nor equal-area.
\cs_new_protected:Npn \semio_viz_geo_raw_naturalearth:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      { \l_semio_viz_geo_phi_fp * \l_semio_viz_geo_phi_fp }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp }
    \fp_set:Nn \l_semio_viz_geo_px_fp
      {
        \l_semio_viz_geo_lam_fp *
        ( 0.8707 - 0.131979 * \l_semio_viz_geo_tmpa_fp
          + \l_semio_viz_geo_tmpb_fp *
            ( -0.013791 + \l_semio_viz_geo_tmpb_fp *
              ( 0.003971 * \l_semio_viz_geo_tmpa_fp
                - 0.001529 * \l_semio_viz_geo_tmpb_fp ) ) )
      }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      {
        \l_semio_viz_geo_phi_fp *
        ( 1.007226 + \l_semio_viz_geo_tmpa_fp *
          ( 0.015085 + \l_semio_viz_geo_tmpb_fp *
            ( -0.044475 + 0.028874 * \l_semio_viz_geo_tmpa_fp
              - 0.005916 * \l_semio_viz_geo_tmpb_fp ) ) )
      }
  }

% 🌐 `orthographic`: the sphere as seen from infinitely far away; only the near half is visible.
\cs_new_protected:Npn \semio_viz_geo_raw_orthographic:
  {
    \fp_set:Nn \l_semio_viz_geo_px_fp
      { cos ( \l_semio_viz_geo_phi_fp ) * sin ( \l_semio_viz_geo_lam_fp ) }
    \fp_set:Nn \l_semio_viz_geo_py_fp { sin ( \l_semio_viz_geo_phi_fp ) }
  }

% 🌐 `stereographic`: the conformal azimuthal projection from the antipode.
\cs_new_protected:Npn \semio_viz_geo_raw_stereographic:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp { cos ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { 1 + cos ( \l_semio_viz_geo_lam_fp ) * \l_semio_viz_geo_tmpa_fp }
    \fp_set:Nn \l_semio_viz_geo_px_fp
      {
        \l_semio_viz_geo_tmpa_fp * sin ( \l_semio_viz_geo_lam_fp )
        / \l_semio_viz_geo_tmpb_fp
      }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      { sin ( \l_semio_viz_geo_phi_fp ) / \l_semio_viz_geo_tmpb_fp }
  }

% 🌐 `gnomonic`: the projection from the sphere's own centre, on which every great circle is straight.
\cs_new_protected:Npn \semio_viz_geo_raw_gnomonic:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp { cos ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { cos ( \l_semio_viz_geo_lam_fp ) * \l_semio_viz_geo_tmpa_fp }
    \fp_set:Nn \l_semio_viz_geo_px_fp
      {
        \l_semio_viz_geo_tmpa_fp * sin ( \l_semio_viz_geo_lam_fp )
        / \l_semio_viz_geo_tmpb_fp
      }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      { sin ( \l_semio_viz_geo_phi_fp ) / \l_semio_viz_geo_tmpb_fp }
  }

% 🧭 d3-geo azimuthalRaw: k = scale(cos lambda cos phi) supplied as #1, x = k cos(phi) sin(lambda), y = k sin(phi).
\cs_new_protected:Npn \semio_viz_geo_azimuthal:n #1
  {
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      { cos ( \l_semio_viz_geo_lam_fp ) * cos ( \l_semio_viz_geo_phi_fp ) }
    \fp_set:Nn \l_semio_viz_geo_tmpd_fp {#1}
    \fp_set:Nn \l_semio_viz_geo_px_fp
      {
        \l_semio_viz_geo_tmpd_fp * cos ( \l_semio_viz_geo_phi_fp )
        * sin ( \l_semio_viz_geo_lam_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      { \l_semio_viz_geo_tmpd_fp * sin ( \l_semio_viz_geo_phi_fp ) }
  }

% 🌐 `azimuthal-equal-area`: Lambert's azimuthal projection, areas preserved about the centre.
\cs_new_protected:Npn \semio_viz_geo_raw_azimuthal_equal_area:
  { \semio_viz_geo_azimuthal:n { sqrt ( 2 / ( 1 + \l_semio_viz_geo_tmpc_fp ) ) } }

% 🧭 The k of azimuthalEquidistantRaw; at the projection centre c and sin(c) both vanish and d3's `c && c / sin(c)` yields 1.
\cs_new_protected:Npn \semio_viz_geo_raw_azimuthal_equidistant:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      { cos ( \l_semio_viz_geo_lam_fp ) * cos ( \l_semio_viz_geo_phi_fp ) }
    \fp_compare:nNnTF { abs ( \l_semio_viz_geo_tmpc_fp - 1 ) } < { 1e-14 }
      { \semio_viz_geo_azimuthal:n { 1 } }
      {
        \semio_viz_geo_azimuthal:n
          {
            acos ( \l_semio_viz_geo_tmpc_fp )
            / sin ( acos ( \l_semio_viz_geo_tmpc_fp ) )
          }
      }
  }

% 🗺️ `cylindrical-equal-area`: Lambert's cylinder, the sine of the latitude as the ordinate.
\cs_new_protected:Npn \semio_viz_geo_raw_cylindrical_equal_area:
  {
    \fp_set:Nn \l_semio_viz_geo_px_fp
      { \l_semio_viz_geo_lam_fp * \l_semio_viz_geo_cosphistd_fp }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      { sin ( \l_semio_viz_geo_phi_fp ) / \l_semio_viz_geo_cosphistd_fp }
  }

% 🗺️ `conic-conformal`: Lambert's conformal cone on the two standard parallels; equal parallels
% degenerate to the Mercator cylinder, which is what the guarded branch handles.
\cs_new_protected:Npn \semio_viz_geo_raw_conic_conformal:
  {
    \fp_compare:nNnTF \l_semio_viz_geo_f_fp > { 0 }
      {
        \fp_compare:nNnT \l_semio_viz_geo_phi_fp < { - pi / 2 + 1e-6 }
          { \fp_set:Nn \l_semio_viz_geo_phi_fp { - pi / 2 + 1e-6 } }
      }
      {
        \fp_compare:nNnT \l_semio_viz_geo_phi_fp > { pi / 2 - 1e-6 }
          { \fp_set:Nn \l_semio_viz_geo_phi_fp { pi / 2 - 1e-6 } }
      }
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      {
        \l_semio_viz_geo_f_fp
        / ( tan ( ( pi / 2 + \l_semio_viz_geo_phi_fp ) / 2 )
            ** \l_semio_viz_geo_n_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_px_fp
      {
        \l_semio_viz_geo_tmpa_fp
        * sin ( \l_semio_viz_geo_n_fp * \l_semio_viz_geo_lam_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      {
        \l_semio_viz_geo_f_fp - \l_semio_viz_geo_tmpa_fp
        * cos ( \l_semio_viz_geo_n_fp * \l_semio_viz_geo_lam_fp )
      }
  }

% 🗺️ `conic-equal-area`: Albers' cone; equal parallels degenerate to the cylindrical equal-area case.
\cs_new_protected:Npn \semio_viz_geo_raw_conic_equal_area:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      {
        sqrt ( \l_semio_viz_geo_c_fp
               - 2 * \l_semio_viz_geo_n_fp * sin ( \l_semio_viz_geo_phi_fp ) )
        / \l_semio_viz_geo_n_fp
      }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { \l_semio_viz_geo_n_fp * \l_semio_viz_geo_lam_fp }
    \fp_set:Nn \l_semio_viz_geo_px_fp
      { \l_semio_viz_geo_tmpa_fp * sin ( \l_semio_viz_geo_tmpb_fp ) }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      {
        \l_semio_viz_geo_rzero_fp
        - \l_semio_viz_geo_tmpa_fp * cos ( \l_semio_viz_geo_tmpb_fp )
      }
  }

% 🗺️ `conic-equidistant`: the cone on which distances along the meridians are true.
\cs_new_protected:Npn \semio_viz_geo_raw_conic_equidistant:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      { \l_semio_viz_geo_g_fp - \l_semio_viz_geo_phi_fp }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { \l_semio_viz_geo_n_fp * \l_semio_viz_geo_lam_fp }
    \fp_set:Nn \l_semio_viz_geo_px_fp
      { \l_semio_viz_geo_tmpa_fp * sin ( \l_semio_viz_geo_tmpb_fp ) }
    \fp_set:Nn \l_semio_viz_geo_py_fp
      {
        \l_semio_viz_geo_g_fp
        - \l_semio_viz_geo_tmpa_fp * cos ( \l_semio_viz_geo_tmpb_fp )
      }
  }
%endregion 🔖️RawProjections

%region 🔖️RawInverse
% 🔄 Closed-form raw inverses; equal-earth and natural-earth1 run d3-geo's own Newton iterations.
\cs_new_protected:Npn \semio_viz_geo_raw_invert:
  { \exp_args:NV \semio_viz_geo_raw_invert_aux:n \l_semio_viz_geo_raw_tl }

% 🔙 Dispatches to the inverse of the raw projection named #1; an unknown name is an error.
\cs_new_protected:Npn \semio_viz_geo_raw_invert_aux:n #1
  {
    \str_case:nnF {#1}
      {
        { equirectangular }
          {
            \fp_set_eq:NN \l_semio_viz_geo_lam_fp \l_semio_viz_geo_px_fp
            \fp_set_eq:NN \l_semio_viz_geo_phi_fp \l_semio_viz_geo_py_fp
          }
        { mercator }
          {
            \fp_set_eq:NN \l_semio_viz_geo_lam_fp \l_semio_viz_geo_px_fp
            \fp_set:Nn \l_semio_viz_geo_phi_fp
              { 2 * atan ( exp ( \l_semio_viz_geo_py_fp ) ) - pi / 2 }
          }
        { transverse-mercator }
          {
            \fp_set:Nn \l_semio_viz_geo_lam_fp { - \l_semio_viz_geo_py_fp }
            \fp_set:Nn \l_semio_viz_geo_phi_fp
              { 2 * atan ( exp ( \l_semio_viz_geo_px_fp ) ) - pi / 2 }
          }
        { cylindrical-equal-area }
          {
            \fp_set:Nn \l_semio_viz_geo_lam_fp
              { \l_semio_viz_geo_px_fp / \l_semio_viz_geo_cosphistd_fp }
            \fp_set:Nn \l_semio_viz_geo_phi_fp
              { asin ( \l_semio_viz_geo_py_fp * \l_semio_viz_geo_cosphistd_fp ) }
          }
        { equal-earth } { \semio_viz_geo_invert_equal_earth: }
        { natural-earth1 } { \semio_viz_geo_invert_naturalearth: }
        { orthographic }
          { \semio_viz_geo_azimuthal_invert:n { asin ( \l_semio_viz_geo_tmpa_fp ) } }
        { stereographic }
          { \semio_viz_geo_azimuthal_invert:n { 2 * atan ( \l_semio_viz_geo_tmpa_fp ) } }
        { gnomonic }
          { \semio_viz_geo_azimuthal_invert:n { atan ( \l_semio_viz_geo_tmpa_fp ) } }
        { azimuthal-equal-area }
          { \semio_viz_geo_azimuthal_invert:n { 2 * asin ( \l_semio_viz_geo_tmpa_fp / 2 ) } }
        { azimuthal-equidistant }
          { \semio_viz_geo_azimuthal_invert:n { \l_semio_viz_geo_tmpa_fp } }
        { conic-conformal } { \semio_viz_geo_invert_conic_conformal: }
        { conic-equal-area } { \semio_viz_geo_invert_conic_equal_area: }
        { conic-equidistant } { \semio_viz_geo_invert_conic_equidistant: }
      }
      { \msg_error:nnn { semio-viz } { geo-no-inverse } {#1} }
  }

% 🧭 d3-geo azimuthalInvert: tmpa is the plane radius z, tmpb the angular distance c produced by #1.
\cs_new_protected:Npn \semio_viz_geo_azimuthal_invert:n #1
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      {
        sqrt ( \l_semio_viz_geo_px_fp * \l_semio_viz_geo_px_fp
               + \l_semio_viz_geo_py_fp * \l_semio_viz_geo_py_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp {#1}
    \fp_set:Nn \l_semio_viz_geo_lam_fp
      {
        atan ( \l_semio_viz_geo_px_fp * sin ( \l_semio_viz_geo_tmpb_fp ) ,
               \l_semio_viz_geo_tmpa_fp * cos ( \l_semio_viz_geo_tmpb_fp ) )
      }
    \fp_compare:nNnTF \l_semio_viz_geo_tmpa_fp = { 0 }
      { \fp_zero:N \l_semio_viz_geo_phi_fp }
      {
        \fp_set:Nn \l_semio_viz_geo_phi_fp
          {
            asin ( \l_semio_viz_geo_py_fp * sin ( \l_semio_viz_geo_tmpb_fp )
                   / \l_semio_viz_geo_tmpa_fp )
          }
      }
  }

% 🔙 The inverse of `equal-earth`: the polynomial has none in closed form, so it is Newton's method
% on the ordinate, to d3's own tolerance.
\cs_new_protected:Npn \semio_viz_geo_invert_equal_earth:
  {
    \fp_set_eq:NN \l_semio_viz_geo_tmpa_fp \l_semio_viz_geo_py_fp
    \int_step_inline:nn { \l_semio_viz_geo_invert_steps_int }
      {
        \fp_set:Nn \l_semio_viz_geo_tmpb_fp
          { \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp }
        \fp_set:Nn \l_semio_viz_geo_tmpc_fp
          {
            \l_semio_viz_geo_tmpb_fp * \l_semio_viz_geo_tmpb_fp
            * \l_semio_viz_geo_tmpb_fp
          }
        \fp_set:Nn \l_semio_viz_geo_tmpd_fp
          {
            (
              \l_semio_viz_geo_tmpa_fp *
              ( \c_semio_viz_geo_ee_ka_fp
                + \c_semio_viz_geo_ee_kb_fp * \l_semio_viz_geo_tmpb_fp
                + \l_semio_viz_geo_tmpc_fp *
                  ( \c_semio_viz_geo_ee_kc_fp
                    + \c_semio_viz_geo_ee_kd_fp * \l_semio_viz_geo_tmpb_fp ) )
              - \l_semio_viz_geo_py_fp
            )
            /
            ( \c_semio_viz_geo_ee_ka_fp
              + 3 * \c_semio_viz_geo_ee_kb_fp * \l_semio_viz_geo_tmpb_fp
              + \l_semio_viz_geo_tmpc_fp *
                ( 7 * \c_semio_viz_geo_ee_kc_fp
                  + 9 * \c_semio_viz_geo_ee_kd_fp * \l_semio_viz_geo_tmpb_fp ) )
          }
        \fp_sub:Nn \l_semio_viz_geo_tmpa_fp { \l_semio_viz_geo_tmpd_fp }
      }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp }
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      {
        \l_semio_viz_geo_tmpb_fp * \l_semio_viz_geo_tmpb_fp
        * \l_semio_viz_geo_tmpb_fp
      }
    \fp_set:Nn \l_semio_viz_geo_lam_fp
      {
        \c_semio_viz_geo_ee_m_fp * \l_semio_viz_geo_px_fp *
        ( \c_semio_viz_geo_ee_ka_fp
          + 3 * \c_semio_viz_geo_ee_kb_fp * \l_semio_viz_geo_tmpb_fp
          + \l_semio_viz_geo_tmpc_fp *
            ( 7 * \c_semio_viz_geo_ee_kc_fp
              + 9 * \c_semio_viz_geo_ee_kd_fp * \l_semio_viz_geo_tmpb_fp ) )
        / cos ( \l_semio_viz_geo_tmpa_fp )
      }
    \fp_set:Nn \l_semio_viz_geo_phi_fp
      { asin ( sin ( \l_semio_viz_geo_tmpa_fp ) / \c_semio_viz_geo_ee_m_fp ) }
  }

% 🔙 The inverse of `natural-earth1`, likewise by Newton's method on the ordinate.
\cs_new_protected:Npn \semio_viz_geo_invert_naturalearth:
  {
    \fp_set_eq:NN \l_semio_viz_geo_tmpa_fp \l_semio_viz_geo_py_fp
    \int_step_inline:nn { \c_semio_viz_geo_newton_int }
      {
        \fp_set:Nn \l_semio_viz_geo_tmpb_fp
          { \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp }
        \fp_set:Nn \l_semio_viz_geo_tmpc_fp
          { \l_semio_viz_geo_tmpb_fp * \l_semio_viz_geo_tmpb_fp }
        \fp_set:Nn \l_semio_viz_geo_tmpd_fp
          {
            (
              \l_semio_viz_geo_tmpa_fp *
              ( 1.007226 + \l_semio_viz_geo_tmpb_fp *
                ( 0.015085 + \l_semio_viz_geo_tmpc_fp *
                  ( -0.044475 + 0.028874 * \l_semio_viz_geo_tmpb_fp
                    - 0.005916 * \l_semio_viz_geo_tmpc_fp ) ) )
              - \l_semio_viz_geo_py_fp
            )
            /
            ( 1.007226 + \l_semio_viz_geo_tmpb_fp *
              ( 0.015085 * 3 + \l_semio_viz_geo_tmpc_fp *
                ( -0.044475 * 7 + 0.028874 * 9 * \l_semio_viz_geo_tmpb_fp
                  - 0.005916 * 11 * \l_semio_viz_geo_tmpc_fp ) ) )
          }
        \fp_sub:Nn \l_semio_viz_geo_tmpa_fp { \l_semio_viz_geo_tmpd_fp }
      }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      { \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp }
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      { \l_semio_viz_geo_tmpb_fp * \l_semio_viz_geo_tmpb_fp }
    \fp_set_eq:NN \l_semio_viz_geo_phi_fp \l_semio_viz_geo_tmpa_fp
    \fp_set:Nn \l_semio_viz_geo_lam_fp
      {
        \l_semio_viz_geo_px_fp /
        ( 0.8707 - 0.131979 * \l_semio_viz_geo_tmpb_fp
          + \l_semio_viz_geo_tmpc_fp *
            ( -0.013791 + \l_semio_viz_geo_tmpc_fp *
              ( 0.003971 * \l_semio_viz_geo_tmpb_fp
                - 0.001529 * \l_semio_viz_geo_tmpc_fp ) ) )
      }
  }

% 🔺 Shared conic inverse angle: tmpa is the signed radial offset, tmpc becomes the conic longitude.
\cs_new_protected:Npn \semio_viz_geo_conic_angle:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpc_fp
      {
        atan ( \l_semio_viz_geo_px_fp , abs ( \l_semio_viz_geo_tmpa_fp ) )
        * sign ( \l_semio_viz_geo_tmpa_fp )
      }
    \fp_compare:nNnT { \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_n_fp } < { 0 }
      {
        \fp_sub:Nn \l_semio_viz_geo_tmpc_fp
          {
            pi * sign ( \l_semio_viz_geo_px_fp )
            * sign ( \l_semio_viz_geo_tmpa_fp )
          }
      }
    \fp_set:Nn \l_semio_viz_geo_lam_fp
      { \l_semio_viz_geo_tmpc_fp / \l_semio_viz_geo_n_fp }
  }

% 🔙 The inverse of `conic-conformal`, with the same degenerate branch as the forward projection.
\cs_new_protected:Npn \semio_viz_geo_invert_conic_conformal:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      { \l_semio_viz_geo_f_fp - \l_semio_viz_geo_py_fp }
    \fp_set:Nn \l_semio_viz_geo_tmpb_fp
      {
        sign ( \l_semio_viz_geo_n_fp ) *
        sqrt ( \l_semio_viz_geo_px_fp * \l_semio_viz_geo_px_fp
               + \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp )
      }
    \semio_viz_geo_conic_angle:
    \fp_set:Nn \l_semio_viz_geo_phi_fp
      {
        2 * atan ( ( \l_semio_viz_geo_f_fp / \l_semio_viz_geo_tmpb_fp )
                   ** ( 1 / \l_semio_viz_geo_n_fp ) )
        - pi / 2
      }
  }

% 🔙 The inverse of `conic-equal-area`, with the same degenerate branch.
\cs_new_protected:Npn \semio_viz_geo_invert_conic_equal_area:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      { \l_semio_viz_geo_rzero_fp - \l_semio_viz_geo_py_fp }
    \semio_viz_geo_conic_angle:
    \fp_set:Nn \l_semio_viz_geo_phi_fp
      {
        asin
          (
            ( \l_semio_viz_geo_c_fp
              - ( \l_semio_viz_geo_px_fp * \l_semio_viz_geo_px_fp
                  + \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp )
                * \l_semio_viz_geo_n_fp * \l_semio_viz_geo_n_fp )
            / ( 2 * \l_semio_viz_geo_n_fp )
          )
      }
  }

% 🔙 The inverse of `conic-equidistant`.
\cs_new_protected:Npn \semio_viz_geo_invert_conic_equidistant:
  {
    \fp_set:Nn \l_semio_viz_geo_tmpa_fp
      { \l_semio_viz_geo_g_fp - \l_semio_viz_geo_py_fp }
    \semio_viz_geo_conic_angle:
    \fp_set:Nn \l_semio_viz_geo_phi_fp
      {
        \l_semio_viz_geo_g_fp - sign ( \l_semio_viz_geo_n_fp ) *
        sqrt ( \l_semio_viz_geo_px_fp * \l_semio_viz_geo_px_fp
               + \l_semio_viz_geo_tmpa_fp * \l_semio_viz_geo_tmpa_fp )
      }
  }
%endregion 🔖️RawInverse

%region 🔖️Registry
% 🗂️ A projection is a frozen bundle of derived numbers; defining it once keeps every per-point call free of key parsing.
\seq_new:N \g_semio_viz_geo_proj_seq
\prop_new:N \g_semio_viz_geo_proj_prop
\tl_new:N \l_semio_viz_geo_name_tl
\tl_new:N \l_semio_viz_geo_kind_tl
\clist_new:N \l_semio_viz_geo_translate_clist
\clist_new:N \l_semio_viz_geo_center_clist
\clist_new:N \l_semio_viz_geo_rotate_clist
\clist_new:N \l_semio_viz_geo_parallels_clist
\clist_new:N \l_semio_viz_geo_clipextent_clist
\tl_new:N \l_semio_viz_geo_clipangle_tl
\fp_new:N \l_semio_viz_geo_precision_fp

%region 🔖️Keys
% 🔑 semio / viz / geo / projection
% 🔑 kind        (choice)   equirectangular | mercator | transverse-mercator | equal-earth | natural-earth1 |
% 🔑                        orthographic | stereographic | gnomonic | azimuthal-equal-area | azimuthal-equidistant |
% 🔑                        conic-conformal | conic-equal-area | conic-equidistant | albers.  Default equirectangular.
% 🔑 scale       (number)   d3 scale k; default is the d3 default of the kind.
% 🔑 translate   (x,y)      plane translation in millimetres; default 480,250 (the d3 default).
% 🔑 center      (lon,lat)  degrees; default is the d3 default of the kind.
% 🔑 rotate      (l,p,g)    degrees; default is the d3 default of the kind. transverse-mercator adds d3's own +90 gamma.
% 🔑 parallels   (p0,p1)    degrees, conic kinds only; default is the d3 default of the kind.
% 🔑 clipAngle   (number)   great-circle clip radius in degrees; empty disables clipping.
% 🔑 clipExtent  (x0,y0,x1,y1) plane clip rectangle; empty disables clipping.
% 🔑 precision   (number)   adaptive resampling tolerance in plane units; d3's default sqrt(0.5). 0 disables resampling.
\keys_define:nn { semio / viz / geo / projection }
  {
    kind .tl_set:N = \l_semio_viz_geo_kind_tl ,
    scale .fp_set:N = \l_semio_viz_geo_k_fp ,
    translate .clist_set:N = \l_semio_viz_geo_translate_clist ,
    center .clist_set:N = \l_semio_viz_geo_center_clist ,
    rotate .clist_set:N = \l_semio_viz_geo_rotate_clist ,
    parallels .clist_set:N = \l_semio_viz_geo_parallels_clist ,
    clipAngle .tl_set:N = \l_semio_viz_geo_clipangle_tl ,
    clipExtent .clist_set:N = \l_semio_viz_geo_clipextent_clist ,
    precision .fp_set:N = \l_semio_viz_geo_precision_fp ,
  }

% 🔧 The two iteration counts of the numeric solvers, shared by every projection.
\int_new:N \l_semio_viz_geo_invert_steps_int
\int_new:N \l_semio_viz_geo_clip_steps_int
\int_set:Nn \l_semio_viz_geo_invert_steps_int { 12 }
\int_set:Nn \l_semio_viz_geo_clip_steps_int { 48 }

% 🔑 semio / viz / geo / solver
% 🔑 invertSteps (int) Newton steps of the equal-earth inverse; default 12, d3's own count.
% 🔑 clipSteps   (int) halvings that bisect a great-circle segment to the clip boundary; default 48.
\keys_define:nn { semio / viz / geo / solver }
  {
    invertSteps .int_set:N = \l_semio_viz_geo_invert_steps_int ,
    clipSteps .int_set:N = \l_semio_viz_geo_clip_steps_int ,
  }
%endregion 🔖️Keys

% 🎚️ The d3 default scale, center, rotate, parallels and clip angle of every kind, so an unconfigured projection matches d3 exactly.
\cs_new_protected:Npn \semio_viz_geo_kind_defaults:n #1
  {
    \clist_set:Nn \l_semio_viz_geo_translate_clist { 480, 250 }
