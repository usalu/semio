    \clist_clear:N \l_semio_viz_geo_clipextent_clist
    \fp_set:Nn \l_semio_viz_geo_precision_fp { sqrt ( 0.5 ) }
    \str_case:nnF {#1}
      {
        { equirectangular } { \fp_set:Nn \l_semio_viz_geo_k_fp { 152.63 } }
        { mercator } { \fp_set:Nn \l_semio_viz_geo_k_fp { 961 / ( 2 * pi ) } }
        { transverse-mercator }
          {
            \fp_set:Nn \l_semio_viz_geo_k_fp { 159.155 }
