\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-scientific-physics}[2026/09/05 v0.2.0 semio viz namespace scientific-physics families]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-scientific-field}

\ExplSyntaxOn

%region 🔖️Parsing
\cs_generate_variant:Nn \seq_set_split:Nnn { Nnx }
\cs_generate_variant:Nn \prop_put:Nnn { Nxx }
\cs_generate_variant:Nn \prop_item:Nn { Ne }
\seq_new:N \l_semio_viz_phys_rec_seq
% ✂️ Splits one slash-separated record #1 into the shared field sequence.
\cs_new_protected:Npn \semio_viz_phys_record:n #1
  { \seq_set_split:Nnx \l_semio_viz_phys_rec_seq { / } {#1} }
% 🔢 Expands to field #1 of the record most recently split.
\cs_new:Npn \semio_viz_phys_field:n #1
  { \seq_item:Nn \l_semio_viz_phys_rec_seq {#1} }
%endregion 🔖️Parsing

%region 🔖️Families

%region 🔖️Keys
% 🔑 Keys of `sci-force` (§30 force and motion diagrams):
%    mode (free-body|force|decomposition|motion, free-body).
%    forces (clist of `magnitude/angle/label`): angle in degrees from the positive x axis.
%    body (point|box|disc, box): the glyph the forces act on. bodySize (fp, 7): its size in millimetres.
%    scale (fp, 5): millimetres per unit of force.
%    frames (clist of `x/y/label`): the strobe positions of a motion diagram.
\tl_new:N \l_semio_viz_phys_mode_tl
\tl_new:N \l_semio_viz_phys_body_tl
\clist_new:N \l_semio_viz_phys_forces_clist
\clist_new:N \l_semio_viz_phys_frames_clist
\fp_new:N \l_semio_viz_phys_scale_fp
\fp_new:N \l_semio_viz_phys_bodysize_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-force }
% 🎯 Binds the `sci-force` option names onto the mode, force list, strobe frames and body-glyph registers.
\keys_define:nn { semio / viz / family / sci-force }
  {
    mode     .tl_set:N    = \l_semio_viz_phys_mode_tl ,
    forces   .clist_set:N = \l_semio_viz_phys_forces_clist ,
    frames   .clist_set:N = \l_semio_viz_phys_frames_clist ,
    body     .tl_set:N    = \l_semio_viz_phys_body_tl ,
    bodySize .fp_set:N    = \l_semio_viz_phys_bodysize_fp ,
    scale    .fp_set:N    = \l_semio_viz_phys_scale_fp ,
  }

% 🧱 §30 force and motion: free-body diagrams, force sums, component decomposition and strobe motion diagrams.
\SemioVizFamily { sci-force }
  {
    \semio_viz_sci_enter:nnn { sci-force }
      {
        mode=free-body , body=box , bodySize=7 , scale=5 , axes=false , grid=false ,
        forces={ 4/90/N , 4/270/W , 2.6/0/F , 1.4/180/f } ,
        frames={ 0/0/t0 , 12/4/t1 , 26/10/t2 , 42/18/t3 , 60/28/t4 }
      }
      {#1}
    \str_if_eq:VnTF \l_semio_viz_phys_mode_tl { motion }
      { \semio_viz_phys_motion: }
      {
        \semio_viz_phys_body:
        \str_if_eq:VnTF \l_semio_viz_phys_mode_tl { decomposition }
          { \semio_viz_phys_decompose: }
          { \semio_viz_phys_forces: }
      }
  }
% 🧊 Draws the body the forces act on at the origin: a filled dot, a circle, or a square as the fallback.
\cs_new_protected:Npn \semio_viz_phys_body:
  {
    \str_case:VnF \l_semio_viz_phys_body_tl
      {
        { point } { \fill [ fill=semio-chrome-foreground ] ( 0 , 0 ) circle [ radius=1.1 ] ; }
        { disc }
          {
            \draw [ semio~sci~glyph ] ( 0 , 0 )
              circle [ radius=\fp_eval:n { \l_semio_viz_phys_bodysize_fp / 2 } ] ;
          }
      }
      {
        \draw [ semio~sci~glyph ]
          ( \fp_eval:n { - \l_semio_viz_phys_bodysize_fp / 2 } , \fp_eval:n { - \l_semio_viz_phys_bodysize_fp / 2 } )
          rectangle
          ( \fp_eval:n { \l_semio_viz_phys_bodysize_fp / 2 } , \fp_eval:n { \l_semio_viz_phys_bodysize_fp / 2 } ) ;
      }
  }
% 🧲 Draws one labelled arrow per entry of the force list.
\cs_new_protected:Npn \semio_viz_phys_forces:
  {
    \clist_map_inline:Nn \l_semio_viz_phys_forces_clist
      {
        \semio_viz_phys_record:n {##1}
        \semio_viz_phys_arrow:nnn
          { \semio_viz_phys_field:n { 1 } } { \semio_viz_phys_field:n { 2 } } { \semio_viz_phys_field:n { 3 } }
      }
  }
% ➡️ Resolves magnitude #1 and degree angle #2 into a scaled vector from the origin, captions it #3 on the side away from the tip, and reports the components.
\cs_new_protected:Npn \semio_viz_phys_arrow:nnn #1#2#3
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp { \l_semio_viz_phys_scale_fp * (#1) * cosd (#2) }
    \fp_set:Nn \l_semio_viz_sci_b_fp { \l_semio_viz_phys_scale_fp * (#1) * sind (#2) }
    \draw [ semio~sci~vector ]
      ( 0 , 0 ) -- ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) ;
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , inner~sep=0.6mm ,
            anchor=\fp_compare:nNnTF {#2} > { 90 } { east } { west } ]
      at ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) {#3} ;
    \semio_viz_sci_report_values:nn { force/vector }
      { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp }
  }
% 📐 Draws each force arrow together with the auxiliary right-angle path through its x and y components.
\cs_new_protected:Npn \semio_viz_phys_decompose:
  {
    \clist_map_inline:Nn \l_semio_viz_phys_forces_clist
      {
        \semio_viz_phys_record:n {##1}
        \semio_viz_phys_arrow:nnn
          { \semio_viz_phys_field:n { 1 } } { \semio_viz_phys_field:n { 2 } } { \semio_viz_phys_field:n { 3 } }
        \draw [ semio~sci~aux ]
          ( 0 , 0 ) -- ( \fp_eval:n { \l_semio_viz_sci_a_fp } , 0 ) --
          ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) ;
      }
  }
% 🎞️ Draws a strobe motion diagram: one hue-cycled square per frame position with its time label underneath.
\cs_new_protected:Npn \semio_viz_phys_motion:
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_phys_frames_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_phys_record:n {##1}
        \draw [ semio~sci~glyph , fill=\semio_viz_sci_hue:n { \l_tmpa_int } ]
          ( \fp_eval:n { \semio_viz_phys_field:n { 1 } - \l_semio_viz_phys_bodysize_fp / 4 } ,
            \fp_eval:n { \semio_viz_phys_field:n { 2 } - \l_semio_viz_phys_bodysize_fp / 4 } )
          rectangle
          ( \fp_eval:n { \semio_viz_phys_field:n { 1 } + \l_semio_viz_phys_bodysize_fp / 4 } ,
            \fp_eval:n { \semio_viz_phys_field:n { 2 } + \l_semio_viz_phys_bodysize_fp / 4 } ) ;
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=north ]
          at ( \semio_viz_phys_field:n { 1 } ,
               \fp_eval:n { \semio_viz_phys_field:n { 2 } - \l_semio_viz_phys_bodysize_fp / 4 - 0.6 } )
          { \semio_viz_phys_field:n { 3 } } ;
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-kinematics` (§30 motion over time):
%    mode (position|velocity|acceleration|projectile|orbital|phase-space, position).
%    expr (l3fp over \SemioT): the position law of the graph modes.
%    speed (fp, 22), angle (fp, 52), gravity (fp, 9.81): the projectile launch.
%    mass (fp, 1), radius (fp, 1), eccentricity (fp, 0.6): the orbital element set.
%    steps (int, 240), step (fp, 0.02): the integration budget of the computed trajectories.
\tl_new:N \l_semio_viz_phys_expr_tl
\fp_new:N \l_semio_viz_phys_speed_fp
\fp_new:N \l_semio_viz_phys_angle_fp
\fp_new:N \l_semio_viz_phys_gravity_fp
\fp_new:N \l_semio_viz_phys_ecc_fp
\fp_new:N \l_semio_viz_phys_radius_fp
\fp_new:N \l_semio_viz_phys_step_fp
\int_new:N \l_semio_viz_phys_steps_int
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-kinematics }
% 🧭 Binds the `sci-kinematics` option names onto the position law, launch parameters, orbital elements and integration budget.
\keys_define:nn { semio / viz / family / sci-kinematics }
  {
    mode         .tl_set:N  = \l_semio_viz_phys_mode_tl ,
    expr         .tl_set:N  = \l_semio_viz_phys_expr_tl ,
    speed        .fp_set:N  = \l_semio_viz_phys_speed_fp ,
    angle        .fp_set:N  = \l_semio_viz_phys_angle_fp ,
    gravity      .fp_set:N  = \l_semio_viz_phys_gravity_fp ,
    radius       .fp_set:N  = \l_semio_viz_phys_radius_fp ,
    eccentricity .fp_set:N  = \l_semio_viz_phys_ecc_fp ,
    steps        .int_set:N = \l_semio_viz_phys_steps_int ,
    step         .fp_set:N  = \l_semio_viz_phys_step_fp ,
  }

% 🚀 §30 motion over time: kinematic graphs derived from one position law, a computed projectile arc and a Kepler orbit.
\SemioVizFamily { sci-kinematics }
  {
    \semio_viz_sci_enter:nnn { sci-kinematics }
      {
        mode=position , expr={ 3 * \SemioT - 0.5 * 9.81 * \SemioT * \SemioT / 4 } ,
        speed=22 , angle=52 , gravity=9.81 , radius=1 , eccentricity=0.6 ,
        steps=240 , step=0.02 , domain={0,3} , range={}
      }
      {#1}
    \str_case:VnF \l_semio_viz_phys_mode_tl
      {
        { projectile }  { \semio_viz_phys_projectile: }
        { orbital }     { \semio_viz_phys_orbit: }
        { phase-space } { \semio_viz_phys_phase: }
        { velocity }     { \semio_viz_phys_derivative:n { 1 } }
        { acceleration } { \semio_viz_phys_derivative:n { 2 } }
      }
      { \semio_viz_phys_derivative:n { 0 } }
  }
% 🚀 The `#1`-th time derivative of the position law by a central difference, sampled over the domain.
\cs_new_protected:Npn \semio_viz_phys_derivative:n #1
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { 120 }
      {
        \fp_set:Nn \l_semio_viz_sci_g_fp
          {
            \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 }
            + ( \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 }
                - \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } ) * ##1 / 120
          }
        \fp_zero:N \l_semio_viz_sci_c_fp
        \int_step_inline:nnnn { 0 } { 1 } {#1}
          {
            \fp_set:Nn \SemioT { \l_semio_viz_sci_g_fp + ( #1 / 2 - ####1 ) * 0.08 }
            \fp_add:Nn \l_semio_viz_sci_c_fp
              {
                ( ####1 - 2 * floor ( ####1 / 2 ) == 0 ? 1 : -1 )
                * exp ( \semio_viz_tr_dist_lgamma:n { #1 + 1 } - \semio_viz_tr_dist_lgamma:n { ####1 + 1 }
                        - \semio_viz_tr_dist_lgamma:n { #1 - ####1 + 1 } )
                * ( \l_semio_viz_phys_expr_tl )
              }
          }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \l_semio_viz_sci_g_fp }
          { \l_semio_viz_sci_c_fp / ( 0.08 ^ (#1) ) }
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.08 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
  }
% 🚀 Projectile arc integrated with the shared Runge–Kutta stepper, not a closed-form parabola.
\cs_new_protected:Npn \semio_viz_phys_projectile:
  {
    \clist_clear:N \l_semio_viz_sci_domain_clist
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \fp_set:Nn \l_semio_viz_sci_c_fp { 0 }
    \fp_set:Nn \l_semio_viz_sci_d_fp { 0 }
    \fp_set:Nn \l_semio_viz_sci_e_fp { \l_semio_viz_phys_speed_fp * cosd ( \l_semio_viz_phys_angle_fp ) }
    \fp_set:Nn \l_semio_viz_sci_f_fp { \l_semio_viz_phys_speed_fp * sind ( \l_semio_viz_phys_angle_fp ) }
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_phys_steps_int }
      { \semio_viz_phys_projectile_step: }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.08 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \semio_viz_sci_report_values:nn { kinematics/range }
      { \fp_to_decimal:N \l_semio_viz_sci_c_fp }
  }
% 🏹 Advances the projectile one time step, recording the point while it is still at or above ground and then updating the vertical velocity by gravity.
\cs_new_protected:Npn \semio_viz_phys_projectile_step:
  {
    \fp_compare:nNnT { \l_semio_viz_sci_d_fp } > { -1e-9 }
      { \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \l_semio_viz_sci_c_fp } { \l_semio_viz_sci_d_fp } }
    \fp_add:Nn \l_semio_viz_sci_c_fp { \l_semio_viz_phys_step_fp * \l_semio_viz_sci_e_fp }
    \fp_add:Nn \l_semio_viz_sci_d_fp
      { \l_semio_viz_phys_step_fp * ( \l_semio_viz_sci_f_fp - \l_semio_viz_phys_gravity_fp * \l_semio_viz_phys_step_fp / 2 ) }
    \fp_sub:Nn \l_semio_viz_sci_f_fp { \l_semio_viz_phys_step_fp * \l_semio_viz_phys_gravity_fp }
  }
% 🚀 Kepler orbit from the conic r = a(1−e²)/(1+e·cos θ), with the focus marked.
\cs_new_protected:Npn \semio_viz_phys_orbit:
  {
    \clist_clear:N \l_semio_viz_sci_domain_clist
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { 240 }
      {
        \fp_set:Nn \SemioT { 2 * pi * ##1 / 240 }
        \fp_set:Nn \l_semio_viz_sci_a_fp
          {
            \l_semio_viz_phys_radius_fp * ( 1 - \l_semio_viz_phys_ecc_fp * \l_semio_viz_phys_ecc_fp )
            / ( 1 + \l_semio_viz_phys_ecc_fp * cos ( \SemioT ) )
          }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \l_semio_viz_sci_a_fp * cos ( \SemioT ) } { \l_semio_viz_sci_a_fp * sin ( \SemioT ) }
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.12 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \semio_viz_sci_dot:nnn { 0 } { 0 } { semio-tertiary }
  }
% 🌀 Integrates the damped-oscillator field with the shared Runge–Kutta stepper and plots the resulting phase-space spiral.
\cs_new_protected:Npn \semio_viz_phys_phase:
  {
    \clist_clear:N \l_semio_viz_sci_domain_clist
    \semio_viz_sci_rkfour:nnnnnnN { \SemioY } { - \SemioX - 0.12 * \SemioY }
      { 1.6 } { 0 } { \l_semio_viz_phys_step_fp * 4 } { \l_semio_viz_phys_steps_int } \l_semio_viz_sci_pts_seq
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.1 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-spacetime` (§30 relativity diagrams):
%    mode (spacetime|minkowski|light-cone, minkowski).
%    beta (fp, 0.5): the boost velocity as a fraction of c, which sets the primed axes.
%    worldlines (clist of `beta/label`): further world lines through the origin.
%    events (clist of `x/t/label`): marked events. gridLines (int, 4): primed grid density.
\fp_new:N \l_semio_viz_phys_beta_fp
\clist_new:N \l_semio_viz_phys_worldlines_clist
\clist_new:N \l_semio_viz_phys_events_clist
\int_new:N \l_semio_viz_phys_gridlines_int
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-spacetime }
% 💫 Binds the `sci-spacetime` option names onto the boost fraction β, the world-line list, the marked events and the primed grid density.
\keys_define:nn { semio / viz / family / sci-spacetime }
  {
    mode       .tl_set:N    = \l_semio_viz_phys_mode_tl ,
    beta       .fp_set:N    = \l_semio_viz_phys_beta_fp ,
    worldlines .clist_set:N = \l_semio_viz_phys_worldlines_clist ,
    events     .clist_set:N = \l_semio_viz_phys_events_clist ,
    gridLines  .int_set:N   = \l_semio_viz_phys_gridlines_int ,
  }

% 🕰️ §30 relativity: light cones, the boosted Minkowski axes for a given β and the world lines through the origin.
\SemioVizFamily { sci-spacetime }
  {
    \semio_viz_sci_enter:nnn { sci-spacetime }
      {
        mode=minkowski , beta=0.5 , gridLines=4 , domain={-2,2} , range={-2,2} , grid=false ,
        worldlines={ 0/A , 0.3/B , -0.7/C } , events={ 0.8/1.2/E1 , -1.1/0.6/E2 }
      }
      {#1}
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \semio_viz_phys_lightcone:
    \str_if_eq:VnT \l_semio_viz_phys_mode_tl { minkowski } { \semio_viz_phys_boosted_axes: }
    \str_if_eq:VnF \l_semio_viz_phys_mode_tl { light-cone } { \semio_viz_phys_worldlines: }
    \clist_map_inline:Nn \l_semio_viz_phys_events_clist
      {
        \semio_viz_phys_record:n {##1}
        \semio_viz_sci_dot:nnn { \semio_viz_phys_field:n { 1 } } { \semio_viz_phys_field:n { 2 } } { semio-tertiary }
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=south~west ]
          at ( \semio_viz_sci_mx:n { \semio_viz_phys_field:n { 1 } } ,
               \semio_viz_sci_my:n { \semio_viz_phys_field:n { 2 } } )
          { \semio_viz_phys_field:n { 3 } } ;
      }
  }
% 🔦 Shades the future and past light cones as two translucent triangles and strokes the two null rays through the origin.
\cs_new_protected:Npn \semio_viz_phys_lightcone:
  {
    \fill [ fill=semio-warning , fill~opacity=0.14 ]
      ( \semio_viz_sci_mx:n { 0 } , \semio_viz_sci_my:n { 0 } ) --
      ( \semio_viz_sci_mx:n { \l_semio_viz_sci_dymax_fp } , \semio_viz_sci_my:n { \l_semio_viz_sci_dymax_fp } ) --
      ( \semio_viz_sci_mx:n { - \l_semio_viz_sci_dymax_fp } , \semio_viz_sci_my:n { \l_semio_viz_sci_dymax_fp } ) -- cycle ;
    \fill [ fill=semio-warning , fill~opacity=0.14 ]
      ( \semio_viz_sci_mx:n { 0 } , \semio_viz_sci_my:n { 0 } ) --
      ( \semio_viz_sci_mx:n { \l_semio_viz_sci_dymax_fp } , \semio_viz_sci_my:n { - \l_semio_viz_sci_dymax_fp } ) --
      ( \semio_viz_sci_mx:n { - \l_semio_viz_sci_dymax_fp } , \semio_viz_sci_my:n { - \l_semio_viz_sci_dymax_fp } ) -- cycle ;
    \int_step_inline:nnnn { -1 } { 2 } { 1 }
      {
        \draw [ semio~sci~thin , draw=semio-warning ]
          ( \semio_viz_sci_mx:n { ##1 * \l_semio_viz_sci_dymin_fp } , \semio_viz_sci_my:n { \l_semio_viz_sci_dymin_fp } ) --
          ( \semio_viz_sci_mx:n { ##1 * \l_semio_viz_sci_dymax_fp } , \semio_viz_sci_my:n { \l_semio_viz_sci_dymax_fp } ) ;
      }
  }
% 🛰️ Draws the primed t′ and x′ axes tilted by β towards the light cone and reports the Lorentz factor γ.
\cs_new_protected:Npn \semio_viz_phys_boosted_axes:
  {
    \draw [ semio~sci~curve ]
      ( \semio_viz_sci_mx:n { \l_semio_viz_phys_beta_fp * \l_semio_viz_sci_dymin_fp } ,
        \semio_viz_sci_my:n { \l_semio_viz_sci_dymin_fp } ) --
      ( \semio_viz_sci_mx:n { \l_semio_viz_phys_beta_fp * \l_semio_viz_sci_dymax_fp } ,
        \semio_viz_sci_my:n { \l_semio_viz_sci_dymax_fp } ) ;
    \draw [ semio~sci~curve~alt ]
      ( \semio_viz_sci_mx:n { \l_semio_viz_sci_dxmin_fp } ,
        \semio_viz_sci_my:n { \l_semio_viz_phys_beta_fp * \l_semio_viz_sci_dxmin_fp } ) --
      ( \semio_viz_sci_mx:n { \l_semio_viz_sci_dxmax_fp } ,
        \semio_viz_sci_my:n { \l_semio_viz_phys_beta_fp * \l_semio_viz_sci_dxmax_fp } ) ;
    \semio_viz_sci_report_values:nn { spacetime/gamma }
      { \fp_to_decimal:n { 1 / sqrt ( 1 - \l_semio_viz_phys_beta_fp * \l_semio_viz_phys_beta_fp ) } }
  }
% 🧶 Strokes each listed world line through the origin at its own velocity, cycling the hue per entry.
\cs_new_protected:Npn \semio_viz_phys_worldlines:
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_phys_worldlines_clist
