%region 🔖️Keys
% 🔑 Keys of `sci-feynman` (§30/§56 Feynman diagrams):
%    vertices (clist of `id/x/y/label`): interaction points, in millimetres.
%    propagators (clist of `from/to/style/label`): styles fermion, antifermion, photon, gluon, scalar, ghost.
%    wiggle (fp, 1.6), coils (int, 7): the amplitude and count of the photon and gluon decorations.
\clist_new:N \l_semio_viz_phys_vertices_clist
\clist_new:N \l_semio_viz_phys_props_clist
\fp_new:N \l_semio_viz_phys_wiggle_fp
\int_new:N \l_semio_viz_phys_coils_int
\tl_new:N \l_semio_viz_phys_style_tl
\tl_new:N \l_semio_viz_phys_pot_tl
\prop_new:N \l_semio_viz_phys_vx_prop
\prop_new:N \l_semio_viz_phys_vy_prop
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-feynman }
% 🧬 Binds the `sci-feynman` option names onto the vertex and propagator lists and the wiggle amplitude and coil count.
\keys_define:nn { semio / viz / family / sci-feynman }
  {
    vertices    .clist_set:N = \l_semio_viz_phys_vertices_clist ,
    propagators .clist_set:N = \l_semio_viz_phys_props_clist ,
    wiggle      .fp_set:N    = \l_semio_viz_phys_wiggle_fp ,
    coils       .int_set:N   = \l_semio_viz_phys_coils_int ,
  }

% ⚛️ §30/§56 Feynman diagrams: propagator lines drawn in their own style from a vertex-and-edge table.
\SemioVizFamily { sci-feynman }
  {
    \semio_viz_sci_enter:nnn { sci-feynman }
      {
        wiggle=1.6 , coils=7 , axes=false , grid=false ,
        vertices={ i1/0/18/e- , i2/0/2/e+ , v1/16/10/ , v2/38/10/ , o1/54/18/μ- , o2/54/2/μ+ } ,
        propagators={ i1/v1/fermion/ , i2/v1/antifermion/ , v1/v2/photon/γ ,
                      v2/o1/fermion/ , v2/o2/antifermion/ }
      }
      {#1}
    \prop_clear:N \l_semio_viz_phys_vx_prop
    \prop_clear:N \l_semio_viz_phys_vy_prop
    \clist_map_inline:Nn \l_semio_viz_phys_vertices_clist
      {
        \semio_viz_phys_record:n {##1}
        \prop_put:Nxx \l_semio_viz_phys_vx_prop
          { \semio_viz_phys_field:n { 1 } } { \semio_viz_phys_field:n { 2 } }
        \prop_put:Nxx \l_semio_viz_phys_vy_prop
          { \semio_viz_phys_field:n { 1 } } { \semio_viz_phys_field:n { 3 } }
      }
    \clist_map_inline:Nn \l_semio_viz_phys_props_clist
      {
        \semio_viz_phys_record:n {##1}
        \semio_viz_phys_propagator:
      }
    \clist_map_inline:Nn \l_semio_viz_phys_vertices_clist
      {
        \semio_viz_phys_record:n {##1}
        \tl_set:Nx \l_semio_viz_phys_style_tl { \semio_viz_phys_field:n { 4 } }
        \tl_if_empty:NF \l_semio_viz_phys_style_tl
          {
            \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , inner~sep=0.8mm ,
                    fill=semio-chrome-base ]
              at ( \semio_viz_phys_field:n { 2 } , \semio_viz_phys_field:n { 3 } )
              { \semio_viz_phys_field:n { 4 } } ;
          }
      }
  }
% 🎽 Looks up the two endpoint vertices of the pending propagator record and strokes it in its own style: wavy photon, coiled gluon, dashed scalar, dotted ghost, or a fermion arrow that reverses for an antifermion.
\cs_new_protected:Npn \semio_viz_phys_propagator:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \prop_item:Ne \l_semio_viz_phys_vx_prop { \semio_viz_phys_field:n { 1 } } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \prop_item:Ne \l_semio_viz_phys_vy_prop { \semio_viz_phys_field:n { 1 } } }
    \fp_set:Nn \l_semio_viz_sci_c_fp
      { \prop_item:Ne \l_semio_viz_phys_vx_prop { \semio_viz_phys_field:n { 2 } } }
    \fp_set:Nn \l_semio_viz_sci_d_fp
      { \prop_item:Ne \l_semio_viz_phys_vy_prop { \semio_viz_phys_field:n { 2 } } }
    \tl_set:Nx \l_semio_viz_phys_style_tl { \semio_viz_phys_field:n { 3 } }
    \str_case:VnF \l_semio_viz_phys_style_tl
      {
        { photon } { \semio_viz_phys_wave_edge:n { 1 } }
        { gluon }  { \semio_viz_phys_wave_edge:n { 2 } }
        { scalar }
          {
            \draw [ semio~sci~thin , dash~pattern=on~1.4pt~off~1.2pt ]
              ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
              ( \fp_eval:n { \l_semio_viz_sci_c_fp } , \fp_eval:n { \l_semio_viz_sci_d_fp } ) ;
          }
        { ghost }
          {
            \draw [ semio~sci~thin , dotted ]
              ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
              ( \fp_eval:n { \l_semio_viz_sci_c_fp } , \fp_eval:n { \l_semio_viz_sci_d_fp } ) ;
          }
        { antifermion }
          {
            \draw [ semio~sci~arrow ]
              ( \fp_eval:n { \l_semio_viz_sci_c_fp } , \fp_eval:n { \l_semio_viz_sci_d_fp } ) --
              ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) ;
          }
      }
      {
        \draw [ semio~sci~arrow ]
          ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
          ( \fp_eval:n { \l_semio_viz_sci_c_fp } , \fp_eval:n { \l_semio_viz_sci_d_fp } ) ;
      }
    \semio_viz_sci_report_values:nn { feynman/propagator }
      { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp ,
        \fp_to_decimal:N \l_semio_viz_sci_c_fp , \fp_to_decimal:N \l_semio_viz_sci_d_fp }
  }
% ⚛️ Wavy (`#1`=1) and coiled (`#1`=2) propagators, sampled along the edge and drawn as a polyline.
\cs_new_protected:Npn \semio_viz_phys_wave_edge:n #1
  {
    \tl_clear:N \l_semio_viz_sci_path_tl
    \int_step_inline:nnnn { 0 } { 1 } { 80 }
      {
        \fp_set:Nn \l_semio_viz_sci_e_fp { ##1 / 80 }
        \fp_set:Nn \l_semio_viz_sci_f_fp
          {
            \l_semio_viz_phys_wiggle_fp
            * sin ( 2 * pi * \l_semio_viz_phys_coils_int * \l_semio_viz_sci_e_fp )
          }
        \fp_set:Nn \l_semio_viz_sci_g_fp
          {
            atand ( \l_semio_viz_sci_d_fp - \l_semio_viz_sci_b_fp ,
                    \l_semio_viz_sci_c_fp - \l_semio_viz_sci_a_fp ) + 90
          }
        \tl_if_empty:NF \l_semio_viz_sci_path_tl { \tl_put_right:Nn \l_semio_viz_sci_path_tl { -- } }
        \tl_put_right:Nx \l_semio_viz_sci_path_tl
          {
            (
              \fp_to_decimal:n
                { \l_semio_viz_sci_a_fp + ( \l_semio_viz_sci_c_fp - \l_semio_viz_sci_a_fp ) * \l_semio_viz_sci_e_fp
                  + \l_semio_viz_sci_f_fp * cosd ( \l_semio_viz_sci_g_fp )
                  + ( #1 == 2 ? \l_semio_viz_phys_wiggle_fp * ( 1 - cos ( 2 * pi * \l_semio_viz_phys_coils_int * \l_semio_viz_sci_e_fp ) ) * 0.3 : 0 ) } ,
              \fp_to_decimal:n
                { \l_semio_viz_sci_b_fp + ( \l_semio_viz_sci_d_fp - \l_semio_viz_sci_b_fp ) * \l_semio_viz_sci_e_fp
                  + \l_semio_viz_sci_f_fp * sind ( \l_semio_viz_sci_g_fp ) }
            )
          }
      }
    \use:x { \exp_not:N \draw [ semio~sci~thin ] \exp_not:V \l_semio_viz_sci_path_tl ; }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-levels` (§30 level and band diagrams):
%    mode (energy-level|potential|band, energy-level).
%    levels (clist of `energy/label`): the level ladder, energies in the plotted unit.
%    transitions (clist of `from/to/label`): arrows between level indices.
%    expr (l3fp over \SemioX): the potential curve of the `potential` mode.
%    bands (clist of `bottom/top/label`): the band edges of the `band` mode.
\int_new:N \l_semio_viz_phys_levels_int
\clist_new:N \l_semio_viz_phys_levels_clist
\clist_new:N \l_semio_viz_phys_trans_clist
\clist_new:N \l_semio_viz_phys_bands_clist
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-levels }
% 🧗 Binds the `sci-levels` option names onto the level ladder, transition list, band edges and potential expression.
\keys_define:nn { semio / viz / family / sci-levels }
  {
    mode        .tl_set:N    = \l_semio_viz_phys_mode_tl ,
    levels      .clist_set:N = \l_semio_viz_phys_levels_clist ,
    transitions .clist_set:N = \l_semio_viz_phys_trans_clist ,
    bands       .clist_set:N = \l_semio_viz_phys_bands_clist ,
    expr        .tl_set:N    = \l_semio_viz_phys_expr_tl ,
