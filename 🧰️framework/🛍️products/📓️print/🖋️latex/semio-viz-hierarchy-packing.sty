%region 🔖️LayoutPack
% 🎲 d3-hierarchy `lcg`: the linear congruential generator seeded with 1 that
% makes circle packing deterministic. The shuffle index is evaluated as
% floor(s*m / 2^32) so the integer arithmetic stays exact in l3fp's 16 digits.
\fp_new:N \g_semio_viz_hierarchy_lcg_fp
\fp_new:N \l_semio_viz_hierarchy_lcg_hi_fp
\fp_new:N \l_semio_viz_hierarchy_lcg_lo_fp

\cs_new_protected:Npn \semio_viz_hierarchy_lcg_reset: {
  \fp_gset:Nn \g_semio_viz_hierarchy_lcg_fp { 1 }
}

% 🎲 s := (1664525 s + 1013904223) mod 2^32, split into 16-bit halves so that every
% intermediate stays well inside l3fp's 16 exact digits.
\cs_new_protected:Npn \semio_viz_hierarchy_lcg_step: {
  \fp_set:Nn \l_semio_viz_hierarchy_lcg_hi_fp { trunc ( \g_semio_viz_hierarchy_lcg_fp / 65536 ) }
  \fp_set:Nn \l_semio_viz_hierarchy_lcg_lo_fp
    { \g_semio_viz_hierarchy_lcg_fp - \l_semio_viz_hierarchy_lcg_hi_fp * 65536 }
  \fp_set:Nn \l_semio_viz_hierarchy_lcg_lo_fp { 1664525 * \l_semio_viz_hierarchy_lcg_lo_fp + 1013904223 }
  \fp_set:Nn \l_semio_viz_hierarchy_lcg_hi_fp { 1664525 * \l_semio_viz_hierarchy_lcg_hi_fp }
  \fp_set:Nn \l_semio_viz_hierarchy_lcg_hi_fp
    { \l_semio_viz_hierarchy_lcg_hi_fp - trunc ( \l_semio_viz_hierarchy_lcg_hi_fp / 65536 ) * 65536 }
  \fp_gset:Nn \g_semio_viz_hierarchy_lcg_fp
    { \l_semio_viz_hierarchy_lcg_hi_fp * 65536 + \l_semio_viz_hierarchy_lcg_lo_fp }
  \fp_gset:Nn \g_semio_viz_hierarchy_lcg_fp
    { \g_semio_viz_hierarchy_lcg_fp
      - trunc ( \g_semio_viz_hierarchy_lcg_fp / 4294967296 ) * 4294967296 }
}

