% ♻️ Puts every axis key back to its documented default before an option list is read.
\cs_new_protected:Npn \semio_viz_guide_keys_reset: {
  \tl_set:Nn \l_semio_viz_axis_scale_tl { x }
  \tl_set:Nn \l_semio_viz_axis_orient_tl { bottom }
  \tl_clear:N \l_semio_viz_axis_at_tl
  \tl_clear:N \l_semio_viz_axis_from_tl
  \tl_clear:N \l_semio_viz_axis_to_tl
  \tl_clear:N \l_semio_viz_axis_center_tl
  \tl_clear:N \l_semio_viz_axis_title_tl
  \tl_set:Nn \l_semio_viz_axis_title_anchor_tl { middle }
  \tl_clear:N \l_semio_viz_axis_tick_format_tl
  \tl_set:Nn \l_semio_viz_axis_label_align_tl { auto }
  \tl_clear:N \l_semio_viz_axis_grid_length_tl
  \clist_clear:N \l_semio_viz_axis_tick_values_clist
  \clist_clear:N \l_semio_viz_axis_broken_clist
  \int_set:Nn \l_semio_viz_axis_ticks_int { 5 }
  \int_set:Nn \l_semio_viz_axis_minor_ticks_int { 4 }
  \fp_zero:N \l_semio_viz_axis_offset_fp
  \fp_set:Nn \l_semio_viz_axis_tick_size_fp { 1.4 }
  \fp_set:Nn \l_semio_viz_axis_tick_size_outer_fp { 1.4 }
  \fp_set:Nn \l_semio_viz_axis_tick_padding_fp { 0.8 }
  \fp_set:Nn \l_semio_viz_axis_minor_size_fp { 0.7 }
  \fp_set:Nn \l_semio_viz_axis_title_gap_fp { 5 }
  \fp_zero:N \l_semio_viz_axis_label_rotate_fp
  \fp_zero:N \l_semio_viz_axis_inner_radius_fp
  \fp_set:Nn \l_semio_viz_axis_outer_radius_fp
    { max( 1 , min( \l_semio_viz_width_fp , \l_semio_viz_height_fp ) / 2 - \l_semio_viz_pad_fp ) }
  \fp_zero:N \l_semio_viz_axis_start_angle_fp
  \fp_set:Nn \l_semio_viz_axis_end_angle_fp { 360 }
  \fp_set:Nn \l_semio_viz_axis_angle_fp { 90 }
  \fp_set:Nn \l_semio_viz_axis_break_gap_fp { 2 }
  \int_set:Nn \l_semio_viz_axis_break_marks_int { 2 }
  \bool_set_false:N \l_semio_viz_axis_minor_bool
  \bool_set_false:N \l_semio_viz_axis_grid_bool
  \bool_set_true:N \l_semio_viz_axis_domain_bool
  \bool_set_true:N \l_semio_viz_axis_labels_bool
}
%endregion 🔖️Keys

