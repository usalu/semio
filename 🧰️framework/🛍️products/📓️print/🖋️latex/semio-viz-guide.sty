\fp_new:N \l_semio_viz_guide_ax_fp
\fp_new:N \l_semio_viz_guide_ay_fp
\fp_new:N \l_semio_viz_guide_bx_fp
\fp_new:N \l_semio_viz_guide_by_fp
\fp_new:N \l_semio_viz_guide_nx_fp
\fp_new:N \l_semio_viz_guide_ny_fp
\fp_new:N \l_semio_viz_guide_rangelo_fp
\fp_new:N \l_semio_viz_guide_rangehi_fp
\fp_new:N \l_semio_viz_guide_cx_fp
\fp_new:N \l_semio_viz_guide_cy_fp
