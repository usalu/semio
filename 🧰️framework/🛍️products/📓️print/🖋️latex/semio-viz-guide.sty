\ExplSyntaxOn

%region 🔖️Diagnostics
\msg_new:nnn { semio-viz } { unknown-guide-orient }
  { Unknown~viz~axis~orient~'#1'~(bottom,~top,~left,~right,~segment,~angular,~radial). }
\msg_new:nnn { semio-viz } { unknown-legend-kind }
  { Unknown~viz~legend~kind~'#1'~(swatch,~line,~symbol,~gradient,~size,~pattern). }
%endregion 🔖️Diagnostics

%region 🔖️Frame
% 📐 Plot-area inset in millimetres: the distance from the VizFigure edge to the
% axis lines. Frame state lives with the guides because the guides are what
% turns a bare canvas into a plot area.
\fp_new:N \l_semio_viz_pad_fp
\fp_set:Nn \l_semio_viz_pad_fp { 8 }

% 🖼️ Default canvas width of a VizFigure in millimetres, used when the figure declares no width.
\tl_const:Nn \c_semio_viz_frame_width_tl { 80 }
% 🖼️ Default canvas height of a VizFigure in millimetres, used when the figure declares no height.
\tl_const:Nn \c_semio_viz_frame_height_tl { 40 }
% ↕️ Vertical air between one VizSection band and the next.
\tl_const:Nn \c_semio_viz_section_gap_tl { 2.5mm }
% ↕️ Vertical air between a VizSection title rule and the content below it.
\tl_const:Nn \c_semio_viz_section_content_gap_tl { 4.5mm }
% ↕️ Vertical air a caption note reserves before the content it introduces.
\tl_const:Nn \c_semio_viz_section_note_gap_tl { 4mm }
% ↔️ Horizontal air between two VizColumn slots of one section.
\tl_const:Nn \c_semio_viz_column_gutter_tl { 4mm }

% 📏 The enclosing figure's extent in millimetres, owned here because every guide,
% frame and family reads it: VizFigure sets it, a renderer never redeclares it.
\fp_new:N \l_semio_viz_width_fp
\fp_new:N \l_semio_viz_height_fp

% 🖼️ Hairline rectangle around the plot area.
\cs_new_protected:Npn \semio_viz_plot_frame:nn #1#2 {
  \semio_viz_guide_style:nN { grid } \l_semio_viz_guide_style_tl
  \use:x {
    \exp_not:N \draw [ \exp_not:V \l_semio_viz_guide_style_tl ]
      ( \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_pad_fp } )
      rectangle ( \fp_eval:n { #1 - 2 } , \fp_eval:n { #2 - 2 } ) ;
  }
  \semio_viz_probe_geometry:nx { frame } {
    \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_pad_fp } ,
    \fp_eval:n { #1 - 2 } , \fp_eval:n { #2 - 2 }
  }
}
%endregion 🔖️Frame

%region 🔖️Style
\tl_new:N \l_semio_viz_guide_chrome_tl

% 🖌️ TikZ style of a guide role, built from the theme's colours, strokes and fonts.
% Roles: domain, tick, tick-minor, grid, grid-minor, label, title.
\tl_new:N \l_semio_viz_guide_style_tl

\cs_new_protected:Npn \semio_viz_guide_style:nN #1#2 {
  \str_case:nnF {#1} {
    { domain } {
      \semio_viz_theme_chrome:nN { border-emphasized } \l_semio_viz_guide_chrome_tl
      \tl_set:Nx #2 { \l_semio_viz_guide_chrome_tl , line~width=\semio_viz_theme_stroke:n { hairline } }
    }
    { tick } {
      \semio_viz_theme_chrome:nN { border-emphasized } \l_semio_viz_guide_chrome_tl
      \tl_set:Nx #2 { \l_semio_viz_guide_chrome_tl , line~width=\semio_viz_theme_stroke:n { hairline } }
    }
    { tick-minor } {
      \semio_viz_theme_chrome:nN { border-normal } \l_semio_viz_guide_chrome_tl
      \tl_set:Nx #2 { \l_semio_viz_guide_chrome_tl , line~width=\semio_viz_theme_stroke:n { hairline } ,
                      draw~opacity=0.6 }
    }
    { grid } {
      \semio_viz_theme_chrome:nN { border-normal } \l_semio_viz_guide_chrome_tl
      \tl_set:Nx #2 { \l_semio_viz_guide_chrome_tl , line~width=\semio_viz_theme_stroke:n { hairline } ,
                      draw~opacity=0.45 }
    }
    { grid-minor } {
      \semio_viz_theme_chrome:nN { border-normal } \l_semio_viz_guide_chrome_tl
      \tl_set:Nx #2 { \l_semio_viz_guide_chrome_tl , line~width=\semio_viz_theme_stroke:n { hairline } ,
                      draw~opacity=0.22 }
    }
    { label } {
      \semio_viz_theme_chrome:nN { foreground } \l_semio_viz_guide_chrome_tl
      \tl_set:Nx #2 { font=\exp_not:N \c_semio_viz_theme_font_label_tl ,
                      text=\l_semio_viz_guide_chrome_tl }
    }
    { title } {
      \semio_viz_theme_chrome:nN { foreground } \l_semio_viz_guide_chrome_tl
      \tl_set:Nx #2 { font=\exp_not:N \c_semio_viz_theme_font_title_tl ,
                      text=\l_semio_viz_guide_chrome_tl }
    }
  } {
    \semio_viz_theme_chrome:nN { border-normal } \l_semio_viz_guide_chrome_tl
    \tl_set_eq:NN #2 \l_semio_viz_guide_chrome_tl
  }
}
%endregion 🔖️Style

%region 🔖️TickText
% 🔢 Tick and legend text: the value through semio-viz-format's specifier grammar,
% or the bare value when no specifier was given -- an empty spec is not the same
% as the specifier `` and must not go through the formatter.
\cs_new_protected:Npn \semio_viz_guide_format:nnN #1#2#3 {
  \tl_if_empty:nTF {#1}
    { \tl_set:Nn #3 {#2} }
    { \semio_viz_format:nnN {#1} {#2} #3 }
}
\cs_generate_variant:Nn \semio_viz_guide_format:nnN { VnN , VVN }
%endregion 🔖️TickText

%region 🔖️ScaleReads
\fp_new:N \l_semio_viz_guide_lo_fp
\fp_new:N \l_semio_viz_guide_hi_fp
\int_new:N \l_semio_viz_guide_i_int

% 🎚️ Tick values of any named scale, straight from semio-viz-scale: it already knows the
% discrete kinds, the log decades, the temporal intervals and an explicit `tickValues`
% option, so a guide never generates its own ticks.
\cs_new_protected:Npn \semio_viz_guide_scale_ticks:nnN #1#2#3
  { \semio_viz_scale_ticks_count:nnN {#1} {#2} #3 }
\cs_generate_variant:Nn \semio_viz_guide_scale_ticks:nnN { VnN , VVN }

% 🏷️ The categories a discrete scale's domain lists, in declaration order.
\cs_new_protected:Npn \semio_viz_guide_domain_items:nN #1#2 {
  \clist_map_inline:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist }
    { \seq_put_right:Nn #2 {##1} }
}

% 📐 First and last domain value of a scale.
\cs_new_protected:Npn \semio_viz_guide_domain_bounds:nNN #1#2#3 {
  \fp_set:Nn #2 { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 1 } }
  \fp_set:Nn #3 { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { -1 } }
}

% 📐 First and last range value of a scale, in figure millimetres.
\cs_new_protected:Npn \semio_viz_guide_range_bounds:nNN #1#2#3 {
  \fp_set:Nn #2 { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } { 1 } }
  \fp_set:Nn #3 { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } { -1 } }
}
\cs_generate_variant:Nn \semio_viz_guide_range_bounds:nNN { VNN }
\cs_generate_variant:Nn \semio_viz_guide_domain_bounds:nNN { VNN }
%endregion 🔖️ScaleReads


%region 🔖️Keys
% 🔑 semio / viz / axis keys, all optional, defaults in \semio_viz_guide_keys_reset:
%   scale        (name)   scale whose domain the axis describes, default `x`
%   orient       (choice) bottom|top|left|right|segment|angular|radial, default bottom
%   at           (mm)     cross-axis position of the axis line; empty = frame edge
%   offset       (mm)     outward shift of the axis line, for dual axes, default 0
%   from,to      (x,y)    segment endpoints when orient=segment
%   center       (x,y)    polar centre when orient=angular|radial, default frame centre
%   innerRadius  (mm)     polar inner radius, default 0
%   outerRadius  (mm)     polar outer radius, default half the smaller frame side minus pad
%   startAngle   (deg)    angular sweep start, default 0
%   endAngle     (deg)    angular sweep end, default 360
%   angle        (deg)    direction of a radial axis, default 90
%   title        (text)   axis title
%   titleAnchor  (choice) start|middle|end, default middle
%   titleGap     (mm)     distance from the tick labels to the title, default 5
%   ticks        (int)    target tick count for continuous scales, default 5
%   tickValues   (clist)  explicit tick values, overrides ticks
%   tickFormat   (spec)   semio-viz-format spec for tick labels, default empty
%   tickSize     (mm)     inner tick length, default 1.4
%   tickSizeOuter(mm)     length of the domain line's end caps, default 1.4
%   tickPadding  (mm)     gap between tick end and label, default 0.8
%   minor        (bool)   draw minor ticks, default false
%   minorTicks   (int)    minor subdivisions per major interval, default 4
%   minorSize    (mm)     minor tick length, default 0.7
%   grid         (bool)   draw a grid line at every major tick, default false
%   gridLength   (mm)     grid line length; empty = across the plot area
%   domainLine   (bool)   draw the axis line itself, default true
%   labelRotate  (deg)    tick label rotation, default 0
%   labelAlign   (choice) auto|start|middle|end, default auto
%   labels       (bool)   draw tick labels, default true
%   broken       (lo,hi)  data interval removed from the axis, default empty
%   breakGap     (mm)     width the removed interval collapses to, default 2
%   breakMarks   (int)    slashes drawn across the break, default 2
\tl_new:N \l_semio_viz_axis_scale_tl
\tl_new:N \l_semio_viz_axis_orient_tl
\tl_new:N \l_semio_viz_axis_at_tl
\tl_new:N \l_semio_viz_axis_from_tl
\tl_new:N \l_semio_viz_axis_to_tl
\tl_new:N \l_semio_viz_axis_center_tl
\tl_new:N \l_semio_viz_axis_title_tl
\tl_new:N \l_semio_viz_axis_title_anchor_tl
\tl_new:N \l_semio_viz_axis_tick_format_tl
\tl_new:N \l_semio_viz_axis_label_align_tl
\tl_new:N \l_semio_viz_axis_grid_length_tl
\clist_new:N \l_semio_viz_axis_tick_values_clist
\clist_new:N \l_semio_viz_axis_broken_clist
\int_new:N \l_semio_viz_axis_ticks_int
\int_new:N \l_semio_viz_axis_minor_ticks_int
\int_new:N \l_semio_viz_axis_break_marks_int
\fp_new:N \l_semio_viz_axis_offset_fp
\fp_new:N \l_semio_viz_axis_tick_size_fp
\fp_new:N \l_semio_viz_axis_tick_size_outer_fp
\fp_new:N \l_semio_viz_axis_tick_padding_fp
\fp_new:N \l_semio_viz_axis_minor_size_fp
\fp_new:N \l_semio_viz_axis_title_gap_fp
\fp_new:N \l_semio_viz_axis_label_rotate_fp
\fp_new:N \l_semio_viz_axis_inner_radius_fp
\fp_new:N \l_semio_viz_axis_outer_radius_fp
\fp_new:N \l_semio_viz_axis_start_angle_fp
\fp_new:N \l_semio_viz_axis_end_angle_fp
\fp_new:N \l_semio_viz_axis_angle_fp
\fp_new:N \l_semio_viz_axis_break_gap_fp
