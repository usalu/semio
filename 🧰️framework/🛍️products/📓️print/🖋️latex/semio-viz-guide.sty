\cs_new_protected:Npn \semio_viz_guide_pair:nNN #1#2#3 {
  \fp_set:Nn #2 { \clist_item:nn {#1} { 1 } }
  \fp_set:Nn #3 { \clist_item:nn {#1} { 2 } }
}
\cs_generate_variant:Nn \semio_viz_guide_pair:nNN { VNN }

% ✂️ A broken axis collapses [lo,hi] to breakGap: every position beyond hi moves
% back by the removed length, and the axis end r1 moves with it.
\cs_new_protected:Npn \semio_viz_guide_break_prep: {
  \bool_set_false:N \l_semio_viz_guide_broken_bool
  \fp_zero:N \l_semio_viz_guide_break_shift_fp
  \int_compare:nNnT { \clist_count:N \l_semio_viz_axis_broken_clist } = { 2 } {
    \bool_set_true:N \l_semio_viz_guide_broken_bool
    \semio_viz_scale_map:VnN \l_semio_viz_axis_scale_tl
      { \clist_item:Nn \l_semio_viz_axis_broken_clist { 1 } } \l_semio_viz_guide_break_lo_fp
    \semio_viz_scale_map:VnN \l_semio_viz_axis_scale_tl
      { \clist_item:Nn \l_semio_viz_axis_broken_clist { 2 } } \l_semio_viz_guide_break_hi_fp
    \fp_set:Nn \l_semio_viz_guide_break_shift_fp
      { \l_semio_viz_guide_break_hi_fp - \l_semio_viz_guide_break_lo_fp - \l_semio_viz_axis_break_gap_fp }
  }
}

% 📍 Scale position of a value, corrected for the break.
\cs_new_protected:Npn \semio_viz_guide_pos:nN #1#2 {
  \semio_viz_scale_map:VnN \l_semio_viz_axis_scale_tl {#1} #2
  \bool_if:NT \l_semio_viz_guide_broken_bool {
    \fp_compare:nNnT {#2} > { \l_semio_viz_guide_break_hi_fp }
      { \fp_sub:Nn #2 { \l_semio_viz_guide_break_shift_fp } }
  }
}

% 🧱 Resolves orient into segment, normal and range; true when the axis is polar.
\cs_new_protected:Npn \semio_viz_guide_frame_resolve: {
  \semio_viz_guide_range_bounds:VNN \l_semio_viz_axis_scale_tl
    \l_semio_viz_guide_rangelo_fp \l_semio_viz_guide_rangehi_fp
  \bool_if:NT \l_semio_viz_guide_broken_bool
    { \fp_sub:Nn \l_semio_viz_guide_rangehi_fp { \l_semio_viz_guide_break_shift_fp } }
  \bool_set_false:N \l_semio_viz_guide_polar_bool
  \tl_if_empty:NTF \l_semio_viz_axis_center_tl
    {
      \fp_set:Nn \l_semio_viz_guide_cx_fp { \l_semio_viz_width_fp / 2 }
      \fp_set:Nn \l_semio_viz_guide_cy_fp { \l_semio_viz_height_fp / 2 }
    }
    { \semio_viz_guide_pair:VNN \l_semio_viz_axis_center_tl \l_semio_viz_guide_cx_fp \l_semio_viz_guide_cy_fp }
  \str_case:VnF \l_semio_viz_axis_orient_tl {
    { bottom } {
      \fp_set:Nn \l_semio_viz_guide_ay_fp
        { \tl_if_empty:NTF \l_semio_viz_axis_at_tl { \l_semio_viz_pad_fp } { \l_semio_viz_axis_at_tl } - \l_semio_viz_axis_offset_fp }
      \fp_set_eq:NN \l_semio_viz_guide_by_fp \l_semio_viz_guide_ay_fp
      \fp_set_eq:NN \l_semio_viz_guide_ax_fp \l_semio_viz_guide_rangelo_fp
      \fp_set_eq:NN \l_semio_viz_guide_bx_fp \l_semio_viz_guide_rangehi_fp
      \fp_zero:N \l_semio_viz_guide_nx_fp
      \fp_set:Nn \l_semio_viz_guide_ny_fp { -1 }
      \fp_set:Nn \l_semio_viz_guide_gridlen_fp { \l_semio_viz_height_fp - 2 - \l_semio_viz_guide_ay_fp }
    }
    { top } {
      \fp_set:Nn \l_semio_viz_guide_ay_fp
        { \tl_if_empty:NTF \l_semio_viz_axis_at_tl { \l_semio_viz_height_fp - 2 } { \l_semio_viz_axis_at_tl } + \l_semio_viz_axis_offset_fp }
      \fp_set_eq:NN \l_semio_viz_guide_by_fp \l_semio_viz_guide_ay_fp
      \fp_set_eq:NN \l_semio_viz_guide_ax_fp \l_semio_viz_guide_rangelo_fp
      \fp_set_eq:NN \l_semio_viz_guide_bx_fp \l_semio_viz_guide_rangehi_fp
      \fp_zero:N \l_semio_viz_guide_nx_fp
      \fp_set:Nn \l_semio_viz_guide_ny_fp { 1 }
      \fp_set:Nn \l_semio_viz_guide_gridlen_fp { \l_semio_viz_guide_ay_fp - \l_semio_viz_pad_fp }
    }
    { left } {
      \fp_set:Nn \l_semio_viz_guide_ax_fp
        { \tl_if_empty:NTF \l_semio_viz_axis_at_tl { \l_semio_viz_pad_fp } { \l_semio_viz_axis_at_tl } - \l_semio_viz_axis_offset_fp }
      \fp_set_eq:NN \l_semio_viz_guide_bx_fp \l_semio_viz_guide_ax_fp
      \fp_set_eq:NN \l_semio_viz_guide_ay_fp \l_semio_viz_guide_rangelo_fp
      \fp_set_eq:NN \l_semio_viz_guide_by_fp \l_semio_viz_guide_rangehi_fp
      \fp_set:Nn \l_semio_viz_guide_nx_fp { -1 }
      \fp_zero:N \l_semio_viz_guide_ny_fp
      \fp_set:Nn \l_semio_viz_guide_gridlen_fp { \l_semio_viz_width_fp - 2 - \l_semio_viz_guide_ax_fp }
    }
    { right } {
      \fp_set:Nn \l_semio_viz_guide_ax_fp
        { \tl_if_empty:NTF \l_semio_viz_axis_at_tl { \l_semio_viz_width_fp - 2 } { \l_semio_viz_axis_at_tl } + \l_semio_viz_axis_offset_fp }
      \fp_set_eq:NN \l_semio_viz_guide_bx_fp \l_semio_viz_guide_ax_fp
      \fp_set_eq:NN \l_semio_viz_guide_ay_fp \l_semio_viz_guide_rangelo_fp
      \fp_set_eq:NN \l_semio_viz_guide_by_fp \l_semio_viz_guide_rangehi_fp
      \fp_set:Nn \l_semio_viz_guide_nx_fp { 1 }
      \fp_zero:N \l_semio_viz_guide_ny_fp
      \fp_set:Nn \l_semio_viz_guide_gridlen_fp { \l_semio_viz_guide_ax_fp - \l_semio_viz_pad_fp }
    }
    { segment } {
      \semio_viz_guide_pair:VNN \l_semio_viz_axis_from_tl \l_semio_viz_guide_ax_fp \l_semio_viz_guide_ay_fp
      \semio_viz_guide_pair:VNN \l_semio_viz_axis_to_tl \l_semio_viz_guide_bx_fp \l_semio_viz_guide_by_fp
      \fp_set:Nn \l_semio_viz_guide_a_fp
        { max( 1e-9 , sqrt( ( \l_semio_viz_guide_bx_fp - \l_semio_viz_guide_ax_fp ) ^ 2 + ( \l_semio_viz_guide_by_fp - \l_semio_viz_guide_ay_fp ) ^ 2 ) ) }
      \fp_set:Nn \l_semio_viz_guide_nx_fp { ( \l_semio_viz_guide_by_fp - \l_semio_viz_guide_ay_fp ) / \l_semio_viz_guide_a_fp }
      \fp_set:Nn \l_semio_viz_guide_ny_fp { - ( \l_semio_viz_guide_bx_fp - \l_semio_viz_guide_ax_fp ) / \l_semio_viz_guide_a_fp }
      \fp_set_eq:NN \l_semio_viz_guide_gridlen_fp \l_semio_viz_guide_a_fp
    }
    { angular } {
      \bool_set_true:N \l_semio_viz_guide_polar_bool
      \fp_set_eq:NN \l_semio_viz_guide_gridlen_fp \l_semio_viz_axis_outer_radius_fp
    }
    { radial } {
      \fp_set:Nn \l_semio_viz_guide_ax_fp
        { \l_semio_viz_guide_cx_fp + \l_semio_viz_axis_inner_radius_fp * cosd( \l_semio_viz_axis_angle_fp ) }
      \fp_set:Nn \l_semio_viz_guide_ay_fp
        { \l_semio_viz_guide_cy_fp + \l_semio_viz_axis_inner_radius_fp * sind( \l_semio_viz_axis_angle_fp ) }
      \fp_set:Nn \l_semio_viz_guide_bx_fp
        { \l_semio_viz_guide_cx_fp + \l_semio_viz_axis_outer_radius_fp * cosd( \l_semio_viz_axis_angle_fp ) }
      \fp_set:Nn \l_semio_viz_guide_by_fp
        { \l_semio_viz_guide_cy_fp + \l_semio_viz_axis_outer_radius_fp * sind( \l_semio_viz_axis_angle_fp ) }
      \fp_set:Nn \l_semio_viz_guide_nx_fp { sind( \l_semio_viz_axis_angle_fp ) }
      \fp_set:Nn \l_semio_viz_guide_ny_fp { - cosd( \l_semio_viz_axis_angle_fp ) }
      \fp_set_eq:NN \l_semio_viz_guide_gridlen_fp \l_semio_viz_axis_outer_radius_fp
    }
  } { \msg_error:nnx { semio-viz } { unknown-guide-orient } { \tl_use:N \l_semio_viz_axis_orient_tl } }
  \tl_if_empty:NF \l_semio_viz_axis_grid_length_tl
    { \fp_set:Nn \l_semio_viz_guide_gridlen_fp { \l_semio_viz_axis_grid_length_tl } }
}

% 🎯 Point on the axis for a scale position, along the resolved segment.
\cs_new_protected:Npn \semio_viz_guide_point:n #1 {
  \bool_if:NTF \l_semio_viz_guide_polar_bool
    {
      \fp_set:Nn \l_semio_viz_guide_px_fp
        { \l_semio_viz_guide_cx_fp + \l_semio_viz_axis_outer_radius_fp * cosd(#1) }
      \fp_set:Nn \l_semio_viz_guide_py_fp
        { \l_semio_viz_guide_cy_fp + \l_semio_viz_axis_outer_radius_fp * sind(#1) }
      \fp_set:Nn \l_semio_viz_guide_nx_fp { cosd(#1) }
      \fp_set:Nn \l_semio_viz_guide_ny_fp { sind(#1) }
    }
    {
      \fp_set:Nn \l_semio_viz_guide_frac_fp
        { ( (#1) - \l_semio_viz_guide_rangelo_fp ) / ( \l_semio_viz_guide_rangehi_fp - \l_semio_viz_guide_rangelo_fp + 1e-12 ) }
      \fp_set:Nn \l_semio_viz_guide_px_fp
        { \l_semio_viz_guide_ax_fp + \l_semio_viz_guide_frac_fp * ( \l_semio_viz_guide_bx_fp - \l_semio_viz_guide_ax_fp ) }
      \fp_set:Nn \l_semio_viz_guide_py_fp
        { \l_semio_viz_guide_ay_fp + \l_semio_viz_guide_frac_fp * ( \l_semio_viz_guide_by_fp - \l_semio_viz_guide_ay_fp ) }
    }
}
