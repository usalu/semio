\cs_new_protected:Npn \semio_viz_net_canvas: {
  \cs_if_exist:NTF \l_semio_viz_width_fp
    { \fp_set_eq:NN \l_semio_viz_net_w_fp \l_semio_viz_width_fp }
    { \fp_set:Nn \l_semio_viz_net_w_fp { 80 } }
  \cs_if_exist:NTF \l_semio_viz_height_fp
    { \fp_set_eq:NN \l_semio_viz_net_h_fp \l_semio_viz_height_fp }
    { \fp_set:Nn \l_semio_viz_net_h_fp { 40 } }
  \fp_compare:nNnT \l_semio_viz_net_w_fp < { 4 } { \fp_set:Nn \l_semio_viz_net_w_fp { 80 } }
  \fp_compare:nNnT \l_semio_viz_net_h_fp < { 4 } { \fp_set:Nn \l_semio_viz_net_h_fp { 40 } }
  \fp_set_eq:NN \l_semio_viz_net_xlo_fp \l_semio_viz_net_pad_l_fp
  \fp_set_eq:NN \l_semio_viz_net_ylo_fp \l_semio_viz_net_pad_b_fp
  \fp_set:Nn \l_semio_viz_net_xhi_fp { \l_semio_viz_net_w_fp - \l_semio_viz_net_pad_r_fp }
  \fp_set:Nn \l_semio_viz_net_yhi_fp { \l_semio_viz_net_h_fp - \l_semio_viz_net_pad_t_fp }
}

% 🔎 Uniform fit of the bound graph's layout coordinates into the drawing rectangle, aspect preserved
% and inset by #1 millimetres so node glyphs of that radius stay inside.
\cs_new_protected:Npn \semio_viz_net_fit:n #1 {
  \fp_set:Nn \l_semio_viz_net_bx_lo_fp { \semio_viz_network_f:nn { x } { 1 } }
  \fp_set_eq:NN \l_semio_viz_net_bx_hi_fp \l_semio_viz_net_bx_lo_fp
  \fp_set:Nn \l_semio_viz_net_by_lo_fp { \semio_viz_network_f:nn { y } { 1 } }
  \fp_set_eq:NN \l_semio_viz_net_by_hi_fp \l_semio_viz_net_by_lo_fp
  \int_step_inline:nn { \l_semio_viz_network_n_int } {
    \fp_set:Nn \l_semio_viz_net_bx_lo_fp
      { min( \l_semio_viz_net_bx_lo_fp , \semio_viz_network_f:nn { x } {##1} ) }
    \fp_set:Nn \l_semio_viz_net_bx_hi_fp
      { max( \l_semio_viz_net_bx_hi_fp , \semio_viz_network_f:nn { x } {##1} ) }
    \fp_set:Nn \l_semio_viz_net_by_lo_fp
      { min( \l_semio_viz_net_by_lo_fp , \semio_viz_network_f:nn { y } {##1} ) }
    \fp_set:Nn \l_semio_viz_net_by_hi_fp
      { max( \l_semio_viz_net_by_hi_fp , \semio_viz_network_f:nn { y } {##1} ) }
  }
  \fp_set:Nn \l_semio_viz_net_fit_k_fp
    {
      min(
        ( \l_semio_viz_net_xhi_fp - \l_semio_viz_net_xlo_fp - 2 * (#1) )
        / max( 1e-6 , \l_semio_viz_net_bx_hi_fp - \l_semio_viz_net_bx_lo_fp ) ,
        ( \l_semio_viz_net_yhi_fp - \l_semio_viz_net_ylo_fp - 2 * (#1) )
        / max( 1e-6 , \l_semio_viz_net_by_hi_fp - \l_semio_viz_net_by_lo_fp ) )
    }
  \fp_set:Nn \l_semio_viz_net_fit_dx_fp
    {
      ( \l_semio_viz_net_xlo_fp + \l_semio_viz_net_xhi_fp
        - \l_semio_viz_net_fit_k_fp * ( \l_semio_viz_net_bx_lo_fp + \l_semio_viz_net_bx_hi_fp ) ) / 2
    }
  \fp_set:Nn \l_semio_viz_net_fit_dy_fp
    {
      ( \l_semio_viz_net_ylo_fp + \l_semio_viz_net_yhi_fp
        - \l_semio_viz_net_fit_k_fp * ( \l_semio_viz_net_by_lo_fp + \l_semio_viz_net_by_hi_fp ) ) / 2
    }
}
% ↔️ A layout x carried through the fit into millimetres on the drawing rectangle.
\cs_new:Npn \semio_viz_net_px:n #1
  { \l_semio_viz_net_fit_k_fp * (#1) + \l_semio_viz_net_fit_dx_fp }
% ↕️ A layout y carried through the same fit, sharing the scale so the aspect survives.
\cs_new:Npn \semio_viz_net_py:n #1
  { \l_semio_viz_net_fit_k_fp * (#1) + \l_semio_viz_net_fit_dy_fp }
% 🎯 Millimetre x of node #1, read out of the kernel's x array and fitted.
\cs_new:Npn \semio_viz_net_nx:n #1 { \semio_viz_net_px:n { \semio_viz_network_f:nn { x } {#1} } }
% 🎯 Millimetre y of node #1, read out of the kernel's y array and fitted.
\cs_new:Npn \semio_viz_net_ny:n #1 { \semio_viz_net_py:n { \semio_viz_network_f:nn { y } {#1} } }
%endregion 🔖️Canvas

%region 🔖️Primitives
% ⚫ One node glyph in the current shape, fill and size, with its probe record.
\cs_new_protected:Npn \semio_viz_net_draw_node:nnn #1#2#3 {
  \str_case:VnF \l_semio_viz_net_shape_tl
    {
      { square }
        {
          \draw [ draw=semio-chrome-border-emphasized , fill=\l_semio_viz_net_fill_tl ,
                  line~width=\semio@stroke@hairline ]
            ( \fp_eval:n { (#1) - (#3) } , \fp_eval:n { (#2) - (#3) } )
            rectangle ( \fp_eval:n { (#1) + (#3) } , \fp_eval:n { (#2) + (#3) } ) ;
        }
      { diamond }
        {
          \draw [ draw=semio-chrome-border-emphasized , fill=\l_semio_viz_net_fill_tl ,
                  line~width=\semio@stroke@hairline ]
            ( \fp_eval:n { (#1) - 1.3 * (#3) } , \fp_eval:n {#2} )
            -- ( \fp_eval:n {#1} , \fp_eval:n { (#2) + 1.3 * (#3) } )
            -- ( \fp_eval:n { (#1) + 1.3 * (#3) } , \fp_eval:n {#2} )
            -- ( \fp_eval:n {#1} , \fp_eval:n { (#2) - 1.3 * (#3) } ) -- cycle ;
        }
      { accept }
        {
          \draw [ draw=semio-chrome-border-emphasized , fill=\l_semio_viz_net_fill_tl ,
                  line~width=\semio@stroke@hairline ]
            ( \fp_eval:n {#1} , \fp_eval:n {#2} ) circle [ radius=\fp_eval:n {#3} mm ] ;
          \draw [ draw=semio-chrome-border-emphasized , line~width=\semio@stroke@hairline ]
            ( \fp_eval:n {#1} , \fp_eval:n {#2} ) circle [ radius=\fp_eval:n { 0.72 * (#3) } mm ] ;
        }
      { box }
        {
          \draw [ draw=semio-chrome-border-emphasized , fill=\l_semio_viz_net_fill_tl ,
                  line~width=\semio@stroke@hairline , rounded~corners=0.4mm ]
            ( \fp_eval:n { (#1) - 2.1 * (#3) } , \fp_eval:n { (#2) - (#3) } )
            rectangle ( \fp_eval:n { (#1) + 2.1 * (#3) } , \fp_eval:n { (#2) + (#3) } ) ;
        }
    }
    {
      \draw [ draw=semio-chrome-border-emphasized , fill=\l_semio_viz_net_fill_tl ,
              line~width=\semio@stroke@hairline ]
        ( \fp_eval:n {#1} , \fp_eval:n {#2} ) circle [ radius=\fp_eval:n {#3} mm ] ;
    }
  \semio_viz_probe_geometry:nx { node }
    { \fp_eval:n { round(#1,4) } , \fp_eval:n { round(#2,4) } , \fp_eval:n { round(#3,4) } ,
      \l_semio_viz_net_shape_tl , \l_semio_viz_net_fill_tl }
}

% ➖ One straight link, optionally arrowed, at the current stroke colour and width.
\cs_new_protected:Npn \semio_viz_net_draw_link:nnnnn #1#2#3#4#5 {
  \use:x {
    \exp_not:N \draw [ draw=\l_semio_viz_net_stroke_tl ,
        line~width=\fp_eval:n { max( 0.05 , #5 ) } mm ,
        \bool_if:NT \l_semio_viz_net_directed_bool { -{Latex[length=1.1mm,width=0.9mm]} } ]
      ( \fp_eval:n {#1} , \fp_eval:n {#2} ) -- ( \fp_eval:n {#3} , \fp_eval:n {#4} ) ;
  }
  \semio_viz_probe_geometry:nx { link }
    { \fp_eval:n { round(#1,4) } , \fp_eval:n { round(#2,4) } ,
      \fp_eval:n { round(#3,4) } , \fp_eval:n { round(#4,4) } , \fp_eval:n { round(#5,4) } ,
      \l_semio_viz_net_stroke_tl , \bool_if:NTF \l_semio_viz_net_directed_bool { arrow } { plain } }
}

% ➰ One quadratic link bent by `curvature` times its length, used for multigraph offsets and digraphs.
\cs_new_protected:Npn \semio_viz_net_draw_curve:nnnnnn #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_net_a_fp { ( (#1) + (#3) ) / 2 - (#6) * ( (#4) - (#2) ) }
  \fp_set:Nn \l_semio_viz_net_b_fp { ( (#2) + (#4) ) / 2 + (#6) * ( (#3) - (#1) ) }
  \use:x {
    \exp_not:N \draw [ draw=\l_semio_viz_net_stroke_tl ,
        line~width=\fp_eval:n { max( 0.05 , #5 ) } mm ,
        \bool_if:NT \l_semio_viz_net_directed_bool { -{Latex[length=1.1mm,width=0.9mm]} } ]
      ( \fp_eval:n {#1} , \fp_eval:n {#2} )
      .. controls ( \fp_use:N \l_semio_viz_net_a_fp , \fp_use:N \l_semio_viz_net_b_fp ) ..
      ( \fp_eval:n {#3} , \fp_eval:n {#4} ) ;
  }
  \semio_viz_probe_geometry:nx { curve }
    { \fp_eval:n { round(#1,4) } , \fp_eval:n { round(#2,4) } ,
      \fp_eval:n { round( \l_semio_viz_net_a_fp , 4 ) } ,
      \fp_eval:n { round( \l_semio_viz_net_b_fp , 4 ) } ,
      \fp_eval:n { round(#3,4) } , \fp_eval:n { round(#4,4) } , \fp_eval:n { round(#5,4) } ,
      \l_semio_viz_net_stroke_tl , \bool_if:NTF \l_semio_viz_net_directed_bool { arrow } { plain } }
}

% 🔤 One caption at a point, in the label font; the text is expanded once so callers can
% pass an accessor such as \semio_viz_network_id:n.
\tl_new:N \l_semio_viz_net_caption_tl
\cs_new_protected:Npn \semio_viz_net_draw_text:nnn #1#2#3 {
  \tl_set:Nx \l_semio_viz_net_caption_tl {#3}
  \node [ anchor=center , font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground ,
          inner~sep=0pt ]
    at ( \fp_eval:n {#1} , \fp_eval:n {#2} ) { \l_semio_viz_net_caption_tl } ;
  \semio_viz_probe_geometry:nx { text }
    { \fp_eval:n { round(#1,4) } , \fp_eval:n { round(#2,4) } ,
      \l_semio_viz_net_caption_tl }
}

% 🎀 One filled polygon; #1 is the TikZ point path, #2 the flat coordinate list for the probe.
\cs_new_protected:Npn \semio_viz_net_draw_poly:nn #1#2 {
  \use:x {
    \exp_not:N \fill [ \l_semio_viz_net_fill_tl , draw=semio-chrome-border-normal ,
        line~width=\semio@stroke@hairline ]
      \exp_not:n {#1} -- cycle ;
  }
  \semio_viz_probe_geometry:nx { poly } { #2 , \l_semio_viz_net_fill_tl }
}
\cs_generate_variant:Nn \semio_viz_net_draw_poly:nn { xx }

