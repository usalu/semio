\fp_new:N \l_semio_viz_net_pad_t_fp
\fp_new:N \l_semio_viz_net_pad_b_fp
\fp_new:N \l_semio_viz_net_fit_k_fp
\fp_new:N \l_semio_viz_net_fit_dx_fp
\fp_new:N \l_semio_viz_net_fit_dy_fp
\fp_new:N \l_semio_viz_net_bx_lo_fp
