  \tl_if_empty:NF \l_semio_viz_net_source_tl
    { \tl_put_right:Nx \l_semio_viz_net_bind_tl { source = \l_semio_viz_net_source_tl , } }
  \tl_if_empty:NF \l_semio_viz_net_target_tl
