%region 🔖️Chrome
% 🌈 Categorical colour of a node, group or series of the network and flow namespaces. Their data
%    numbers series from one, the theme's categorical slots from zero.
\cs_new_protected:Npn \semio_viz_net_color:nN #1#2
  { \semio_viz_theme_color:nN { \int_eval:n { (#1) - 1 } } #2 }
\cs_generate_variant:Nn \semio_viz_net_color:nN { VN, xN }

% 🌡️ Sequential shade of one hue: 0 fades into the canvas, 1 is the full hue.
\cs_new_protected:Npn \semio_viz_net_shade:nnN #1#2#3
  { \semio_viz_theme_shade:nnN {#1} {#2} #3 }
\cs_generate_variant:Nn \semio_viz_net_shade:nnN { VnN, VxN, nxN }
%endregion 🔖️Chrome

