% 🧭 The active coordinate system, sized to the plot rectangle and given the two data domains,
% so a polar or parallel plot reads the very same rows as a cartesian one.
\cs_new_protected:Npn \semio_viz_plot_coordinate: {
  \semio_viz_coordinate_reset:
  \bool_set_true:N \l_semio_viz_coord_plot_bool
  \tl_set_eq:NN \l_semio_viz_coord_kind_tl \l_semio_viz_plot_coordinate_tl
  \fp_set:Nn \l_semio_viz_coord_width_fp { \l_semio_viz_plot_xb_fp - \l_semio_viz_plot_xa_fp }
  \fp_set:Nn \l_semio_viz_coord_height_fp { \l_semio_viz_plot_yb_fp - \l_semio_viz_plot_ya_fp }
  \fp_set_eq:NN \l_semio_viz_coord_ox_fp \l_semio_viz_plot_xa_fp
  \fp_set_eq:NN \l_semio_viz_coord_oy_fp \l_semio_viz_plot_ya_fp
  \bool_set_true:N \l_semio_viz_coord_flip_bool
  \bool_lazy_or:nnT
    { \str_if_eq_p:Vn \l_semio_viz_coord_kind_tl { polar } }
    { \str_if_eq_p:Vn \l_semio_viz_coord_kind_tl { logpolar } }
    {
      \fp_set:Nn \l_semio_viz_coord_ox_fp
        { ( \l_semio_viz_plot_xa_fp + \l_semio_viz_plot_xb_fp ) / 2 }
      \fp_set:Nn \l_semio_viz_coord_oy_fp
        { ( \l_semio_viz_plot_ya_fp + \l_semio_viz_plot_yb_fp ) / 2 }
      \fp_set:Nn \l_semio_viz_coord_outer_fp
        { min ( \l_semio_viz_coord_width_fp , \l_semio_viz_coord_height_fp ) / 2 }
    }
  \clist_set:Nx \l_semio_viz_coord_dx_clist
    { \fp_to_decimal:N \l_semio_viz_plot_xlo_fp , \fp_to_decimal:N \l_semio_viz_plot_xhi_fp }
  \clist_set:Nx \l_semio_viz_coord_dy_clist
    { \fp_to_decimal:N \l_semio_viz_plot_ylo_fp , \fp_to_decimal:N \l_semio_viz_plot_yhi_fp }
  \int_set:Nn \l_semio_viz_coord_axes_int
    { \int_max:nn { 2 } { \l_semio_viz_plot_levels_int } }
  \tl_if_empty:NF \l_semio_viz_plot_coordinate_options_tl {\exp_args:NnV \keys_set:nn {semio/viz/coordinate}\l_semio_viz_plot_coordinate_options_tl}
}

