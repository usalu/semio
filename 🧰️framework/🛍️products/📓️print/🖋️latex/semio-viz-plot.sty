    {line}{\tl_put_right:Nx \l_semio_viz_plot_style_tl {fill=none,stroke={\exp_not:V\l_semio_viz_plot_fill_tl},}}
    {path}{\tl_put_right:Nx \l_semio_viz_plot_style_tl {fill=none,stroke={\exp_not:V\l_semio_viz_plot_fill_tl},}}
    {trail}{\tl_put_right:Nx \l_semio_viz_plot_style_tl {fill=none,stroke={\exp_not:V\l_semio_viz_plot_fill_tl},}}
    {rule}{\tl_put_right:Nx \l_semio_viz_plot_style_tl {fill=none,stroke={\exp_not:V\l_semio_viz_plot_fill_tl},}}
    {link}{\tl_put_right:Nx \l_semio_viz_plot_style_tl {fill=none,stroke={\exp_not:V\l_semio_viz_plot_fill_tl},}}
  }
  \clist_map_inline:nn {fill,stroke,size,opacity,dash,innerRadius,endAngle} {
    \prop_get:NnN \l_semio_viz_plot_values_prop {##1}\l_tmpa_tl
    \tl_if_empty:NF \l_tmpa_tl {\tl_put_right:Nx \l_semio_viz_plot_style_tl {##1={\exp_not:V\l_tmpa_tl},}}
  }
  \prop_get:NnN \l_semio_viz_plot_values_prop {dash}\l_tmpa_tl
  \exp_args:NnV \regex_match:nnT {\A\s*\d+(?:\.\d+)?(?:\s*,\s*\d+(?:\.\d+)?)*\s*\Z}\l_tmpa_tl {
    \clist_set:NV \l_semio_viz_plot_dash_clist \l_tmpa_tl
    \tl_clear:N \l_semio_viz_plot_dash_tl
    \clist_map_indexed_inline:Nn \l_semio_viz_plot_dash_clist {\tl_put_right:Nx \l_semio_viz_plot_dash_tl {\int_if_odd:nTF{##1}{on}{off}~##2mm~}}
