% 🎚️ Resolves an encoded row cell or scalar and applies only an explicitly authored scale.
\cs_new_protected:Npn \semio_viz_plot_value:nnN #1#2#3 {
  \tl_clear:N #3
  \prop_get:NnNTF \l_semio_viz_plot_channel_column_prop {#1}\l_semio_viz_plot_column_tl
    {
      \prop_if_in:NnTF \l_semio_viz_plot_channel_binding_prop {#1}
        {\semio_viz_table_col_exist:nnTF{\l_semio_viz_plot_data_tl}{\l_semio_viz_plot_column_tl}{\semio_viz_table_cell:nnnN {\l_semio_viz_plot_data_tl}{#2}{\l_semio_viz_plot_column_tl}#3}{\tl_set:Nn#3{\SemioVizUndefined{}}}}
        {\semio_viz_table_col_exist:nnTF {\l_semio_viz_plot_data_tl}{\l_semio_viz_plot_column_tl}
        {\semio_viz_table_col_exist:nnTF{\l_semio_viz_plot_data_tl}{\l_semio_viz_plot_column_tl}{\semio_viz_table_cell:nnnN {\l_semio_viz_plot_data_tl}{#2}{\l_semio_viz_plot_column_tl}#3}{\tl_set:Nn#3{\SemioVizUndefined{}}}}
        {\tl_set_eq:NN #3\l_semio_viz_plot_column_tl}}
    }
    {\semio_viz_table_col_exist:nnT {\l_semio_viz_plot_data_tl}{#1}{\semio_viz_table_cell:nnnN {\l_semio_viz_plot_data_tl}{#2}{#1}#3}}
  \prop_if_in:NnT \l_semio_viz_plot_channel_explicit_prop {#1}
    {
      \prop_get:NnN \l_semio_viz_plot_channel_scale_prop {#1}\l_semio_viz_plot_scale_tl
            \tl_set_eq:NN \l_semio_viz_plot_raw_cell_tl #3
      \semio_viz_scale_value:VVN \l_semio_viz_plot_scale_tl #3#3
      \clist_if_in:nnT{x,y}{#1}{
        \bool_set_false:N\l_tmpa_bool
        \tl_if_eq:VnT\l_semio_viz_plot_raw_cell_tl{\SemioVizNull{}}{\bool_set_true:N\l_tmpa_bool}
        \tl_if_eq:VnT\l_semio_viz_plot_raw_cell_tl{\SemioVizUndefined{}}{\bool_set_true:N\l_tmpa_bool}
        \bool_if:NT\l_tmpa_bool{\exp_args:NV\semio_viz_scale_opt:nnN\l_semio_viz_plot_scale_tl{unknown}#3}
        \tl_if_head_eq_meaning:VNTF#3\SemioVizBoolean{\tl_set:Nn#3{\SemioVizUndefined{}}}{}
        \tl_if_head_eq_meaning:VNTF#3\SemioVizString{\tl_set:Nn#3{\SemioVizUndefined{}}}{}
        \tl_if_eq:VnT#3{\SemioVizNaN{}}{\tl_set:Nn#3{\SemioVizUndefined{}}}
      }
      \clist_if_in:nnT{fill,stroke}{#1}{\tl_if_eq:VnT#3{\SemioVizNull{}}{\tl_set:Nn#3{none}}\tl_if_eq:VnT#3{\SemioVizUndefined{}}{\tl_set:Nn#3{none}}\tl_if_head_eq_meaning:VNTF#3\SemioVizBoolean{\tl_set:Nn#3{none}}{}}
    }
}

% 📐 Resolves one position through its authored scale or the inferred positional scale.
\cs_new_protected:Npn \semio_viz_plot_position:nnnN #1#2#3#4 {
  \semio_viz_plot_value:nnN {#1}{#2}\l_semio_viz_plot_cell_tl
