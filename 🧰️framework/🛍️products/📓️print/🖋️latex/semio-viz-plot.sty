  }
  \prop_get:NnN \l_semio_viz_plot_values_prop {strokeWidth}\l_tmpa_tl
  \tl_if_empty:NF \l_tmpa_tl {\tl_put_right:Nx \l_semio_viz_plot_style_tl {strokeWidth={\exp_not:V\l_tmpa_tl mm},}}
  \prop_get:NnN \l_semio_viz_plot_values_prop {rotation}\l_tmpa_tl
  \tl_if_empty:NF \l_tmpa_tl {\tl_put_right:Nx \l_semio_viz_plot_style_tl {rotate={\exp_not:V\l_tmpa_tl},}}
  \prop_get:NnN \l_semio_viz_plot_values_prop {radius}\l_tmpa_tl
  \tl_if_empty:NF \l_tmpa_tl {\tl_put_right:Nx \l_semio_viz_plot_style_tl {radius={\exp_not:V\l_tmpa_tl},outerRadius={\exp_not:V\l_tmpa_tl},}}
  \prop_get:NnN \l_semio_viz_plot_values_prop {angle}\l_tmpa_tl
