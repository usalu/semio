    {
      \prop_if_in:NnTF \l_semio_viz_plot_channel_explicit_prop {#1}
        {\fp_set:Nn #4{\l_semio_viz_plot_cell_tl}}
        {
          \tl_set:Nn \l_semio_viz_plot_scale_tl {plot-x}
          \str_if_eq:nnT {#1}{y}{\tl_set:Nn \l_semio_viz_plot_scale_tl {plot-y}}
          \str_if_eq:nnT {#1}{y2}{\tl_set:Nn \l_semio_viz_plot_scale_tl {plot-y}}
          \str_if_eq:nnTF {#1}{x2}
            {\prop_get:NnNT \l_semio_viz_plot_channel_explicit_prop {x}\l_tmpa_tl {\prop_get:NnN \l_semio_viz_plot_channel_scale_prop {x}\l_semio_viz_plot_scale_tl}}
            {\str_if_eq:nnT {#1}{y2}{\prop_get:NnNT \l_semio_viz_plot_channel_explicit_prop {y}\l_tmpa_tl {\prop_get:NnN \l_semio_viz_plot_channel_scale_prop {y}\l_semio_viz_plot_scale_tl}}}
          \bool_lazy_or:nnTF {\prop_if_in_p:Nn \l_semio_viz_plot_channel_binding_prop {#1}}{!\prop_if_in_p:Nn \l_semio_viz_plot_channel_column_prop {#1}}
            {\fp_set:Nn #4{\l_semio_viz_plot_cell_tl}}
            {\semio_viz_scale_map:VVN \l_semio_viz_plot_scale_tl \l_semio_viz_plot_cell_tl #4}
        }
    }
}

% 🧭 Projects mapped millimetre channels into the declared coordinate geometry.
\cs_new_protected:Npn \semio_viz_plot_normalize:nN #1#2 {
  \tl_set:Nn \l_semio_viz_plot_scale_tl {#1}
  \str_if_eq:nnT {#1}{x2}{\tl_set:Nn\l_semio_viz_plot_scale_tl{x}}
  \str_if_eq:nnT {#1}{y2}{\tl_set:Nn\l_semio_viz_plot_scale_tl{y}}
  \prop_if_in:NnTF \l_semio_viz_plot_channel_explicit_prop {#1}
    {\prop_get:NnN\l_semio_viz_plot_channel_scale_prop{#1}\l_semio_viz_plot_scale_tl}
    {
      \exp_args:NNV \prop_if_in:NnTF \l_semio_viz_plot_channel_explicit_prop \l_semio_viz_plot_scale_tl
        {\prop_get:NVN\l_semio_viz_plot_channel_scale_prop\l_semio_viz_plot_scale_tl\l_semio_viz_plot_scale_tl}
        {\tl_clear:N \l_semio_viz_plot_scale_tl}
    }
  \tl_if_empty:NF \l_semio_viz_plot_scale_tl {
    \fp_set:Nn \l_semio_viz_plot_range_a_fp {\clist_item:cn{g_semio_viz_scale_\l_semio_viz_plot_scale_tl _range_clist}{1}}
    \fp_set:Nn \l_semio_viz_plot_range_b_fp {\clist_item:cn{g_semio_viz_scale_\l_semio_viz_plot_scale_tl _range_clist}{-1}}
    \fp_compare:nNnTF {\l_semio_viz_plot_range_a_fp}={\l_semio_viz_plot_range_b_fp}
      {\fp_set:Nn #2{0.5}}
      {\fp_set:Nn #2{(#2-\l_semio_viz_plot_range_a_fp)/(\l_semio_viz_plot_range_b_fp-\l_semio_viz_plot_range_a_fp)}}
  }
}
