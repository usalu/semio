\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-plot}[2026/09/05 v0.3.0 semio viz grammar entry point and chart-kind catalogue dispatch]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-data}
\RequirePackage{semio-viz-scale}
\RequirePackage{semio-viz-mark}
\RequirePackage{semio-viz-family}
\RequirePackage{semio-viz-shape}
\RequirePackage{semio-viz-coordinate}
\RequirePackage{semio-viz-guide}
\RequirePackage{semio-viz-annotation}
\RequirePackage{semio-viz-facet}
\RequirePackage{semio-viz-composition}
\RequirePackage{semio-viz-transform}
\RequirePackage{semio-viz-theme}

\ExplSyntaxOn

%region 🔖️Diagnostics
\msg_new:nnn { semio-viz } { unknown-kind }
  { Unknown~viz~chart~kind~'#1'.~It~is~not~in~🖼️assets/🔣️viz-catalog.json. }
\msg_new:nnn { semio-viz } { duplicate-kind }
  { Viz~chart~kind~'#1'~is~registered~twice;~the~catalogue~holds~one~entry~per~slug. }
%endregion 🔖️Diagnostics

%region 🔖️Catalogue
% 📇 The generated semio-viz-catalog.sty fills these three registers, one entry per chart kind.
\seq_new:N \g_semio_viz_kind_names_seq
\prop_new:N \g_semio_viz_kind_family_prop
\prop_new:N \g_semio_viz_kind_options_prop
\prop_new:N \g_semio_viz_kind_covers_prop
\tl_new:N \l_semio_viz_kind_family_tl
\tl_new:N \l_semio_viz_kind_options_tl

\cs_new_protected:Npn \semio_viz_kind_define:nnn #1#2#3 {
  \seq_if_in:NnTF \g_semio_viz_kind_names_seq {#1}
    { \msg_error:nnn { semio-viz } { duplicate-kind } {#1} }
    {
      \seq_gput_right:Nn \g_semio_viz_kind_names_seq {#1}
      \prop_gput:Nnn \g_semio_viz_kind_family_prop {#1} {#2}
      \prop_gput:Nnn \g_semio_viz_kind_options_prop {#1} {#3}
    }
}

% ❓ True when #1 names a registered catalogue kind.
\prg_new_protected_conditional:Npnn \semio_viz_kind_if_exist:n #1 { T, F, TF } {
  \seq_if_in:NnTF \g_semio_viz_kind_names_seq {#1} { \prg_return_true: } { \prg_return_false: }
}

% ▶️ Resolves a catalogue entry and runs its family with the entry defaults plus the call-site overrides.
\cs_new_protected:Npn \semio_viz_kind_run:nn #1#2 {
  \semio_viz_kind_if_exist:nTF {#1}
    {
      \prop_get:NnN \g_semio_viz_kind_family_prop {#1} \l_semio_viz_kind_family_tl
      \prop_get:NnN \g_semio_viz_kind_options_prop {#1} \l_semio_viz_kind_options_tl
      \tl_if_empty:nF {#2} { \tl_put_right:Nn \l_semio_viz_kind_options_tl { , #2 } }
      \semio_viz_family_run:VV \l_semio_viz_kind_family_tl \l_semio_viz_kind_options_tl
    }
    { \msg_error:nnn { semio-viz } { unknown-kind } {#1} }
}

% 🏷️ \SemioVizChartKind{slug}{family}{options}: one generated catalogue registration.
\NewDocumentCommand \SemioVizChartKind { m m m } { \semio_viz_kind_define:nnn {#1} {#2} {#3} }
% 🍃 \SemioVizKindCovers{slug}{leaf ids}: the taxonomy leaves one kind stands for.
\NewDocumentCommand \SemioVizKindCovers { m m } { \prop_gput:Nnn \g_semio_viz_kind_covers_prop {#1} {#2} }
% 📊 \SemioVizChart{slug}[overrides]: renders a catalogue chart kind inside the current VizFigure.
\NewDocumentCommand \SemioVizChart { m O{} } { \semio_viz_kind_run:nn {#1} {#2} }
% 📇 Maps a callback over every registered chart kind.
\cs_new_protected:Npn \semio_viz_kind_map_inline:n #1 { \seq_map_inline:Nn \g_semio_viz_kind_names_seq {#1} }
%endregion 🔖️Catalogue

%region 🔖️Encodings
% 🎨 Every grammar channel of taxonomy §74; each takes a column name or `{ column, scale=<name> }`.
\clist_const:Nn \c_semio_viz_plot_channels_clist
  { x , y , x2 , y2 , angle , radius , size , shape , fill , stroke , opacity , text , dash , width , order , detail }

\prop_new:N \l_semio_viz_plot_channel_column_prop
\prop_new:N \l_semio_viz_plot_channel_scale_prop
\tl_new:N \l_semio_viz_plot_channel_tl
\tl_new:N \l_semio_viz_plot_column_tl
\tl_new:N \l_semio_viz_plot_scale_tl

% 🔑 One encoding channel, `semio / viz / plot / channel`: which column it reads and which named
% scale maps it. Both default to empty, meaning the channel is unset.
\keys_define:nn { semio / viz / plot / channel } {
  column .tl_set:N = \l_semio_viz_plot_column_tl ,
  scale  .tl_set:N = \l_semio_viz_plot_scale_tl ,
  column .initial:n = { } ,
  scale  .initial:n = { } ,
}

% 🎚️ Stores one channel binding; a bare value is the column, a braced list may name a scale.
\cs_new_protected:Npn \semio_viz_plot_channel_set:nn #1#2 {
  \tl_clear:N \l_semio_viz_plot_column_tl
  \tl_set:Nn \l_semio_viz_plot_scale_tl {#1}
  \tl_if_in:nnTF {#2} { = }
    { \keys_set:nn { semio / viz / plot / channel } {#2} }
    { \tl_set:Nn \l_semio_viz_plot_column_tl {#2} }
  \prop_put:NnV \l_semio_viz_plot_channel_column_prop {#1} \l_semio_viz_plot_column_tl
  \prop_put:NnV \l_semio_viz_plot_channel_scale_prop {#1} \l_semio_viz_plot_scale_tl
}

% ❓ True when the plot binds a channel to a column.
\prg_new_protected_conditional:Npnn \semio_viz_plot_channel_if_bound:n #1 { T, F, TF } {
  \prop_get:NnNTF \l_semio_viz_plot_channel_column_prop {#1} \l_semio_viz_plot_column_tl
    { \tl_if_empty:NTF \l_semio_viz_plot_column_tl { \prg_return_false: } { \prg_return_true: } }
    { \prg_return_false: }
}
%endregion 🔖️Encodings

%region 🔖️Keys
\tl_new:N \l_semio_viz_plot_data_tl
\tl_new:N \l_semio_viz_plot_mark_tl
\tl_new:N \l_semio_viz_plot_coordinate_tl
\tl_new:N \l_semio_viz_plot_transform_tl
\tl_new:N \l_semio_viz_plot_layout_tl
\tl_new:N \l_semio_viz_plot_guide_tl
\tl_new:N \l_semio_viz_plot_annotation_tl
\tl_new:N \l_semio_viz_plot_theme_tl
\tl_new:N \l_semio_viz_plot_curve_tl
\seq_new:N \l_semio_viz_plot_layers_seq
\bool_new:N \l_semio_viz_plot_in_environment_bool

% 🔑 The plot grammar, `semio / viz / plot`: one key per stage of the pipeline. Every key an
% option list does not name is an encoding channel, and reaches `semio / viz / plot / channel`.
\keys_define:nn { semio / viz / plot } {
  data       .tl_set:N = \l_semio_viz_plot_data_tl ,
  mark       .tl_set:N = \l_semio_viz_plot_mark_tl ,
  coordinate .tl_set:N = \l_semio_viz_plot_coordinate_tl ,
  transform  .tl_set:N = \l_semio_viz_plot_transform_tl ,
  layout     .tl_set:N = \l_semio_viz_plot_layout_tl ,
  guide      .tl_set:N = \l_semio_viz_plot_guide_tl ,
  annotation .tl_set:N = \l_semio_viz_plot_annotation_tl ,
  theme      .tl_set:N = \l_semio_viz_plot_theme_tl ,
  curve      .tl_set:N = \l_semio_viz_plot_curve_tl ,
  unknown    .code:n   = { \exp_args:NV \semio_viz_plot_channel_set:nn \l_keys_key_str {#1} } ,
}

% ♻️ Puts every plot key and every encoding channel back to its documented default.
\cs_new_protected:Npn \semio_viz_plot_keys_reset: {
  \tl_set:Nn \l_semio_viz_plot_data_tl { demo }
  \tl_set:Nn \l_semio_viz_plot_mark_tl { point }
  \tl_set:Nn \l_semio_viz_plot_coordinate_tl { cartesian }
  \tl_clear:N \l_semio_viz_plot_transform_tl
  \tl_clear:N \l_semio_viz_plot_layout_tl
  \tl_clear:N \l_semio_viz_plot_guide_tl
  \tl_clear:N \l_semio_viz_plot_annotation_tl
  \tl_clear:N \l_semio_viz_plot_theme_tl
  \tl_set:Nn \l_semio_viz_plot_curve_tl { linear }
  \prop_clear:N \l_semio_viz_plot_channel_column_prop
  \prop_clear:N \l_semio_viz_plot_channel_scale_prop
}
%endregion 🔖️Keys

%region 🔖️Pipeline
% 🧮 Runs the declared transforms, then the layout algorithm, on the plot's own table.
\cs_new_protected:Npn \semio_viz_plot_prepare: {
  \tl_if_empty:NF \l_semio_viz_plot_transform_tl
    {
      \use:x
        {
          \exp_not:N \semio_viz_transform:nnn { \exp_not:V \l_semio_viz_plot_data_tl }
            { \exp_not:V \l_semio_viz_plot_data_tl } { \exp_not:V \l_semio_viz_plot_transform_tl }
        }
    }
  \tl_if_empty:NF \l_semio_viz_plot_layout_tl
    {
      \use:x
        {
          \exp_not:N \semio_viz_layout_run:nnnn
            { \exp_not:V \l_semio_viz_plot_layout_tl } { \exp_not:V \l_semio_viz_plot_data_tl }
            { \exp_not:V \l_semio_viz_plot_data_tl } { }
        }
    }
}
%endregion 🔖️Pipeline

%region 🔖️Frame
% 📐 The plot rectangle: the figure's own millimetre extent inset by the guide package's plot pad,
% so an axis drawn by semio-viz-guide and a mark drawn here land on the same geometry.
\fp_new:N \l_semio_viz_plot_xa_fp
\fp_new:N \l_semio_viz_plot_ya_fp
\fp_new:N \l_semio_viz_plot_xb_fp
\fp_new:N \l_semio_viz_plot_yb_fp

\cs_new_protected:Npn \semio_viz_plot_frame: {
  \fp_set_eq:NN \l_semio_viz_plot_xa_fp \l_semio_viz_pad_fp
  \fp_set_eq:NN \l_semio_viz_plot_ya_fp \l_semio_viz_pad_fp
  \fp_set:Nn \l_semio_viz_plot_xb_fp { \l_semio_viz_width_fp - 2 }
  \fp_set:Nn \l_semio_viz_plot_yb_fp { \l_semio_viz_height_fp - 2 }
}
%endregion 🔖️Frame

%region 🔖️Channels
\bool_new:N \l_semio_viz_plot_numeric_bool
\int_new:N \l_semio_viz_plot_rows_int
\int_new:N \l_semio_viz_plot_levels_int
\tl_new:N \l_semio_viz_plot_cell_tl
\seq_new:N \l_semio_viz_plot_levels_seq

% 🎚️ The column a channel is bound to, empty when the channel is unbound.
\cs_new_protected:Npn \semio_viz_plot_column:nN #1#2 {
  \prop_get:NnNF \l_semio_viz_plot_channel_column_prop {#1} #2 { \tl_clear:N #2 }
}

% ❓ True when every cell of a column is a number, which is what decides between a continuous
% and a band scale on that channel.
\prg_new_protected_conditional:Npnn \semio_viz_plot_if_numeric:nn #1#2 { TF } {
  \bool_set_true:N \l_semio_viz_plot_numeric_bool
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_plot_rows_int
  \int_step_inline:nn { \l_semio_viz_plot_rows_int }
    {
      \semio_viz_table_cell:nnnN {#1} {##1} {#2} \l_semio_viz_plot_cell_tl
      \exp_args:NnV \regex_match:nnF { \A \s* [-+]? [0-9] [0-9.eE+-]* \s* \Z }
        \l_semio_viz_plot_cell_tl { \bool_set_false:N \l_semio_viz_plot_numeric_bool }
    }
  \bool_if:NTF \l_semio_viz_plot_numeric_bool { \prg_return_true: } { \prg_return_false: }
}

% 🏷️ The distinct values of a column, in first-appearance order.
\cs_new_protected:Npn \semio_viz_plot_levels:nnN #1#2#3 {
  \seq_clear:N #3
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_plot_rows_int
  \int_step_inline:nn { \l_semio_viz_plot_rows_int }
    {
      \semio_viz_table_cell:nnnN {#1} {##1} {#2} \l_semio_viz_plot_cell_tl
      \seq_if_in:NVF #3 \l_semio_viz_plot_cell_tl
        { \seq_put_right:NV #3 \l_semio_viz_plot_cell_tl }
    }
}
\prg_generate_conditional_variant:Nnn \semio_viz_plot_if_numeric:nn { VV } { TF }
\cs_generate_variant:Nn \semio_viz_plot_levels:nnN { VVN }
%endregion 🔖️Channels

%region 🔖️Scales
% 📏 The two positional scales of the plot, registered under `plot-x` and `plot-y` so that
% \SemioVizAxis, \SemioVizGrid and \SemioVizLegend describe exactly what the marks drew.
\fp_new:N \l_semio_viz_plot_xlo_fp
\fp_new:N \l_semio_viz_plot_xhi_fp
\fp_new:N \l_semio_viz_plot_ylo_fp
\fp_new:N \l_semio_viz_plot_yhi_fp
\bool_new:N \l_semio_viz_plot_xband_bool
\tl_new:N \l_semio_viz_plot_xcol_tl
\tl_new:N \l_semio_viz_plot_ycol_tl

\cs_new_protected:Npn \semio_viz_plot_scales: {
  \semio_viz_plot_column:nN { x } \l_semio_viz_plot_xcol_tl
  \semio_viz_plot_column:nN { y } \l_semio_viz_plot_ycol_tl
  \semio_viz_plot_scale_x:
  \semio_viz_plot_scale_y:
}

% 📏 The horizontal scale: continuous over a numeric column, a band over anything else. A band
% domain becomes the half-open index interval the coordinate system maps, so index i lands on
% the centre of band i and the axis ticks and the marks agree by construction.
\cs_new_protected:Npn \semio_viz_plot_scale_x: {
  \bool_set_false:N \l_semio_viz_plot_xband_bool
  \int_zero:N \l_semio_viz_plot_levels_int
  \tl_if_empty:NTF \l_semio_viz_plot_xcol_tl
    {
      \fp_set:Nn \l_semio_viz_plot_xlo_fp { 0 }
      \fp_set:Nn \l_semio_viz_plot_xhi_fp { 1 }
      \semio_viz_plot_scale_x_linear:
    }
    {
      \semio_viz_plot_if_numeric:VVTF \l_semio_viz_plot_data_tl \l_semio_viz_plot_xcol_tl
        {
          \semio_viz_table_col_min:VVN \l_semio_viz_plot_data_tl
            \l_semio_viz_plot_xcol_tl \l_semio_viz_plot_xlo_fp
          \semio_viz_table_col_max:VVN \l_semio_viz_plot_data_tl
            \l_semio_viz_plot_xcol_tl \l_semio_viz_plot_xhi_fp
          \fp_compare:nNnT { \l_semio_viz_plot_xhi_fp } = { \l_semio_viz_plot_xlo_fp }
            { \fp_add:Nn \l_semio_viz_plot_xhi_fp { 1 } }
          \semio_viz_plot_scale_x_linear:
        }
        { \semio_viz_plot_scale_x_band: }
    }
}

% 📏 Registers the plot's x scale as `plot-x`, linear from the data extent onto the frame width.
\cs_new_protected:Npn \semio_viz_plot_scale_x_linear: {
  \semio_viz_scale_define:nnxx { plot-x } { linear }
    { \fp_to_decimal:N \l_semio_viz_plot_xlo_fp , \fp_to_decimal:N \l_semio_viz_plot_xhi_fp }
    { \fp_to_decimal:N \l_semio_viz_plot_xa_fp , \fp_to_decimal:N \l_semio_viz_plot_xb_fp }
}

% 📊 Registers the plot's x scale as `plot-x`, one band per distinct level of the x column.
\cs_new_protected:Npn \semio_viz_plot_scale_x_band: {
  \bool_set_true:N \l_semio_viz_plot_xband_bool
  \semio_viz_plot_levels:VVN \l_semio_viz_plot_data_tl
    \l_semio_viz_plot_xcol_tl \l_semio_viz_plot_levels_seq
  \int_set:Nn \l_semio_viz_plot_levels_int { \seq_count:N \l_semio_viz_plot_levels_seq }
  \fp_set:Nn \l_semio_viz_plot_xlo_fp { 0.5 }
  \fp_set:Nn \l_semio_viz_plot_xhi_fp { \l_semio_viz_plot_levels_int + 0.5 }
  \use:x
    {
      \exp_not:N \semio_viz_scale_define:nnnn { plot-x } { band }
        { \seq_use:Nn \l_semio_viz_plot_levels_seq { , } }
        { \fp_to_decimal:N \l_semio_viz_plot_xa_fp , \fp_to_decimal:N \l_semio_viz_plot_xb_fp }
    }
}

% 📏 The vertical scale: always continuous, anchored at zero when the data does not cross it.
\cs_new_protected:Npn \semio_viz_plot_scale_y: {
  \tl_if_empty:NTF \l_semio_viz_plot_ycol_tl
    {
      \fp_set:Nn \l_semio_viz_plot_ylo_fp { 0 }
      \fp_set:Nn \l_semio_viz_plot_yhi_fp { 1 }
    }
    {
      \semio_viz_table_col_min:VVN \l_semio_viz_plot_data_tl
        \l_semio_viz_plot_ycol_tl \l_semio_viz_plot_ylo_fp
      \semio_viz_table_col_max:VVN \l_semio_viz_plot_data_tl
        \l_semio_viz_plot_ycol_tl \l_semio_viz_plot_yhi_fp
      \fp_set:Nn \l_semio_viz_plot_ylo_fp { min ( 0 , \l_semio_viz_plot_ylo_fp ) }
    }
  \fp_compare:nNnT { \l_semio_viz_plot_yhi_fp } = { \l_semio_viz_plot_ylo_fp }
    { \fp_add:Nn \l_semio_viz_plot_yhi_fp { 1 } }
  \semio_viz_scale_define:nnxx { plot-y } { linear }
    { \fp_to_decimal:N \l_semio_viz_plot_ylo_fp , \fp_to_decimal:N \l_semio_viz_plot_yhi_fp }
    { \fp_to_decimal:N \l_semio_viz_plot_ya_fp , \fp_to_decimal:N \l_semio_viz_plot_yb_fp }
}
%endregion 🔖️Scales

%region 🔖️Coordinate
% 🧭 The active coordinate system, sized to the plot rectangle and given the two data domains,
% so a polar or parallel plot reads the very same rows as a cartesian one.
\cs_new_protected:Npn \semio_viz_plot_coordinate: {
  \semio_viz_coordinate_reset:
  \tl_set_eq:NN \l_semio_viz_coord_kind_tl \l_semio_viz_plot_coordinate_tl
  \fp_set:Nn \l_semio_viz_coord_width_fp { \l_semio_viz_plot_xb_fp - \l_semio_viz_plot_xa_fp }
  \fp_set:Nn \l_semio_viz_coord_height_fp { \l_semio_viz_plot_yb_fp - \l_semio_viz_plot_ya_fp }
  \fp_set_eq:NN \l_semio_viz_coord_ox_fp \l_semio_viz_plot_xa_fp
  \fp_set_eq:NN \l_semio_viz_coord_oy_fp \l_semio_viz_plot_ya_fp
  \bool_lazy_or:nnT
    { \str_if_eq_p:Vn \l_semio_viz_coord_kind_tl { polar } }
    { \str_if_eq_p:Vn \l_semio_viz_coord_kind_tl { logpolar } }
    {
      \fp_set:Nn \l_semio_viz_coord_ox_fp
        { ( \l_semio_viz_plot_xa_fp + \l_semio_viz_plot_xb_fp ) / 2 }
      \fp_set:Nn \l_semio_viz_coord_oy_fp
        { ( \l_semio_viz_plot_ya_fp + \l_semio_viz_plot_yb_fp ) / 2 }
      \fp_set:Nn \l_semio_viz_coord_outer_fp
        { min ( \l_semio_viz_coord_width_fp , \l_semio_viz_coord_height_fp ) / 2 }
    }
  \clist_set:Nx \l_semio_viz_coord_dx_clist
    { \fp_to_decimal:N \l_semio_viz_plot_xlo_fp , \fp_to_decimal:N \l_semio_viz_plot_xhi_fp }
  \clist_set:Nx \l_semio_viz_coord_dy_clist
    { \fp_to_decimal:N \l_semio_viz_plot_ylo_fp , \fp_to_decimal:N \l_semio_viz_plot_yhi_fp }
  \int_set:Nn \l_semio_viz_coord_axes_int
    { \int_max:nn { 2 } { \l_semio_viz_plot_levels_int } }
}

% 🧭 The x channel as the coordinate system reads it: the level index for a band, the value
% itself for a continuous domain.
\cs_new_protected:Npn \semio_viz_plot_xdatum:nN #1#2 {
  \bool_if:NTF \l_semio_viz_plot_xband_bool
    {
      \fp_zero:N #2
      \seq_map_indexed_inline:Nn \l_semio_viz_plot_levels_seq
        { \str_if_eq:nnT {##2} {#1} { \fp_set:Nn #2 { ##1 } } }
    }
    { \fp_set:Nn #2 {#1} }
}
%endregion 🔖️Coordinate

%region 🔖️Layers
% 🖊️ One layer: every row of the table mapped through the coordinate system and painted by the
% mark kernel. A path mark collects the whole series first, every other mark paints row by row.
\fp_new:N \l_semio_viz_plot_px_fp
\fp_new:N \l_semio_viz_plot_py_fp
\fp_new:N \l_semio_viz_plot_bx_fp
\fp_new:N \l_semio_viz_plot_by_fp
\fp_new:N \l_semio_viz_plot_xdata_fp
\fp_new:N \l_semio_viz_plot_step_fp
\tl_new:N \l_semio_viz_plot_points_tl
\tl_new:N \l_semio_viz_plot_base_tl
\tl_new:N \l_semio_viz_plot_size_tl
\tl_new:N \l_semio_viz_plot_area_tl
\tl_new:N \l_semio_viz_plot_fill_tl

\cs_new_protected:Npn \semio_viz_plot_draw_layer: {
  \semio_viz_frame_require:n { SemioVizPlot }
  \semio_viz_plot_frame:
  \semio_viz_plot_scales:
  \semio_viz_plot_coordinate:
  \semio_viz_theme_color:nN { 0 } \l_semio_viz_plot_fill_tl
  \tl_clear:N \l_semio_viz_plot_points_tl
  \tl_clear:N \l_semio_viz_plot_base_tl
  \semio_viz_plot_column:nN { size } \l_semio_viz_plot_size_tl
  \fp_set:Nn \l_semio_viz_plot_step_fp
    {
      ( \l_semio_viz_plot_xb_fp - \l_semio_viz_plot_xa_fp )
      / max ( 1 , \l_semio_viz_plot_xhi_fp - \l_semio_viz_plot_xlo_fp )
    }
  \semio_viz_table_nrows:VN \l_semio_viz_plot_data_tl \l_semio_viz_plot_rows_int
  \int_step_inline:nn { \l_semio_viz_plot_rows_int } { \semio_viz_plot_row:n {##1} }
  \semio_viz_plot_paint_path:
}

% 📍 One row: its two positional channels mapped, then painted or collected.
\cs_new_protected:Npn \semio_viz_plot_row:n #1 {
  \semio_viz_table_cell:VnVN \l_semio_viz_plot_data_tl {#1}
    \l_semio_viz_plot_xcol_tl \l_semio_viz_plot_cell_tl
  \exp_args:NV \semio_viz_plot_xdatum:nN \l_semio_viz_plot_cell_tl \l_semio_viz_plot_xdata_fp
  \semio_viz_table_cell:VnVN \l_semio_viz_plot_data_tl {#1}
    \l_semio_viz_plot_ycol_tl \l_semio_viz_plot_cell_tl
  \tl_if_empty:NT \l_semio_viz_plot_cell_tl { \tl_set:Nn \l_semio_viz_plot_cell_tl { 0 } }
  \semio_viz_coordinate_map:nVNN { \l_semio_viz_plot_xdata_fp } \l_semio_viz_plot_cell_tl
    \l_semio_viz_plot_px_fp \l_semio_viz_plot_py_fp
  \semio_viz_coordinate_map:nnNN { \l_semio_viz_plot_xdata_fp }
    { max ( \l_semio_viz_plot_ylo_fp , 0 ) }
    \l_semio_viz_plot_bx_fp \l_semio_viz_plot_by_fp
  \semio_viz_probe_geometry:nx { plot/point }
    { \fp_eval:n { round ( \l_semio_viz_plot_px_fp , 4 ) } ,
      \fp_eval:n { round ( \l_semio_viz_plot_py_fp , 4 ) } }
  \tl_put_right:Nx \l_semio_viz_plot_points_tl
    {
      \tl_if_empty:NF \l_semio_viz_plot_points_tl { ; }
      \fp_to_decimal:N \l_semio_viz_plot_px_fp , \fp_to_decimal:N \l_semio_viz_plot_py_fp
    }
  \tl_put_right:Nx \l_semio_viz_plot_base_tl
    {
      \tl_if_empty:NF \l_semio_viz_plot_base_tl { ; }
      \fp_to_decimal:N \l_semio_viz_plot_bx_fp , \fp_to_decimal:N \l_semio_viz_plot_by_fp
    }
  \semio_viz_plot_paint_row:n {#1}
}

% 🎨 The per-row paint of every non-path mark: a bar as a rectangle standing on the baseline,
% anything else as the section 0 mark of that name at the mapped point.
\cs_new_protected:Npn \semio_viz_plot_paint_row:n #1 {
  \str_case:VnF \l_semio_viz_plot_mark_tl
    {
      { line } { }
      { area } { }
      { bar } { \semio_viz_plot_paint_bar: }
    }
    { \semio_viz_plot_paint_mark:n {#1} }
}

% 🧱 One bar: the rectangle mark carries an area and a width-to-height ratio, so the bar is
% expressed in the mark kernel's own vocabulary instead of a raw TikZ rectangle.
\cs_new_protected:Npn \semio_viz_plot_paint_bar: {
  \fp_set:Nn \l_semio_viz_plot_xdata_fp
    { max ( 0.05 , abs ( \l_semio_viz_plot_py_fp - \l_semio_viz_plot_by_fp ) ) }
  \use:x
    {
      \exp_not:N \semio_viz_mark_draw:nnn { rectangle }
        {
          fill = \exp_not:V \l_semio_viz_plot_fill_tl ,
          size = \fp_to_decimal:n
            { \l_semio_viz_plot_xdata_fp * \l_semio_viz_plot_step_fp * 0.7 } ,
          aspect = \fp_to_decimal:n
            { \l_semio_viz_plot_step_fp * 0.7 / \l_semio_viz_plot_xdata_fp }
        }
        {
          \fp_to_decimal:N \l_semio_viz_plot_px_fp ,
          \fp_to_decimal:n { ( \l_semio_viz_plot_py_fp + \l_semio_viz_plot_by_fp ) / 2 }
        }
    }
}

% ⚫ The section 0 primitive a grammar mark name stands for: the grammar speaks of a `point`,
% section 0 calls that primitive a `dot`, and every other name is already a primitive.
\tl_new:N \l_semio_viz_plot_primitive_tl
\cs_new_protected:Npn \semio_viz_plot_primitive: {
  \str_if_eq:VnTF \l_semio_viz_plot_mark_tl { point }
    { \tl_set:Nn \l_semio_viz_plot_primitive_tl { dot } }
    { \tl_set_eq:NN \l_semio_viz_plot_primitive_tl \l_semio_viz_plot_mark_tl }
}

% ⚫ A point-like mark, its area taken from the `size` channel when one is bound.
\cs_new_protected:Npn \semio_viz_plot_paint_mark:n #1 {
  \semio_viz_plot_primitive:
  \tl_if_empty:NTF \l_semio_viz_plot_size_tl
    { \tl_set:Nn \l_semio_viz_plot_area_tl { 6 } }
    {
      \semio_viz_table_cell:VnVN \l_semio_viz_plot_data_tl {#1}
        \l_semio_viz_plot_size_tl \l_semio_viz_plot_area_tl
    }
  \use:x
    {
      \exp_not:N \semio_viz_mark_draw:nnn { \exp_not:V \l_semio_viz_plot_primitive_tl }
        {
          fill = \exp_not:V \l_semio_viz_plot_fill_tl ,
          size = \fp_to_decimal:n { \l_semio_viz_plot_area_tl }
        }
        {
          \fp_to_decimal:N \l_semio_viz_plot_px_fp ,
          \fp_to_decimal:N \l_semio_viz_plot_py_fp
        }
    }
}

% 〰️ The path marks, painted once the whole series is collected: a line as a polyline through
% the points, an area as the band between the series and its baseline.
\cs_new_protected:Npn \semio_viz_plot_paint_path: {
  \str_case:Vn \l_semio_viz_plot_mark_tl
    {
      { line }
        {
          \use:x
            {
              \exp_not:N \semio_viz_path_draw:nn { polyline }
                {
                  points = { \exp_not:V \l_semio_viz_plot_points_tl } ,
                  curve = \exp_not:V \l_semio_viz_plot_curve_tl ,
                  stroke = \exp_not:V \l_semio_viz_plot_fill_tl
                }
            }
        }
      { area }
        {
          \use:x
            {
              \exp_not:N \semio_viz_path_draw:nn { band }
                {
                  points = { \exp_not:V \l_semio_viz_plot_points_tl } ,
                  points2 = { \exp_not:V \l_semio_viz_plot_base_tl } ,
                  curve = \exp_not:V \l_semio_viz_plot_curve_tl ,
                  fill = \exp_not:V \l_semio_viz_plot_fill_tl
                }
            }
        }
    }
}
%endregion 🔖️Layers

%region 🔖️Chrome
% 🧭 The guides and annotations declared once for the whole plot. `guide` is a list of
% `axis=<channel>`, `grid` and `legend` items, each drawn against the plot's own scales.
\cs_new_protected:Npn \semio_viz_plot_draw_chrome: {
  \tl_if_empty:NF \l_semio_viz_plot_guide_tl
    {
      \exp_args:NV \clist_map_inline:nn \l_semio_viz_plot_guide_tl
        { \semio_viz_plot_guide_item:n {##1} }
    }
  \tl_if_empty:NF \l_semio_viz_plot_annotation_tl
    {
      \exp_args:NV \clist_map_inline:nn \l_semio_viz_plot_annotation_tl
        { \SemioVizAnnotate {##1} }
    }
}

% 🧭 One item of the `guide` list.
\cs_new_protected:Npn \semio_viz_plot_guide_item:n #1 {
  \str_case:nnF {#1}
    {
      { grid } { \SemioVizGrid }
      { axis=x } { \SemioVizAxis [ scale = plot-x , orient = bottom ] }
      { axis=y } { \SemioVizAxis [ scale = plot-y , orient = left ] }
      { legend } { \SemioVizLegend [ scale = plot-x ] }
    }
    { }
}

% 🎨 Applies the plot theme before anything is painted.
\cs_new_protected:Npn \semio_viz_plot_apply_theme: {
  \tl_if_empty:NF \l_semio_viz_plot_theme_tl
    { \exp_args:NV \semio_viz_theme_use:n \l_semio_viz_plot_theme_tl }
}
%endregion 🔖️Chrome

%region 🔖️Run
% ▶️ One complete plot: keys, transforms, one layer, chrome.
\cs_new_protected:Npn \semio_viz_plot_run:n #1 {
  \group_begin:
  \semio_viz_plot_keys_reset:
  \keys_set:nn { semio / viz / plot } {#1}
  \semio_viz_plot_apply_theme:
  \semio_viz_plot_prepare:
  \semio_viz_plot_draw_layer:
  \semio_viz_plot_draw_chrome:
  \group_end:
}

% 🥞 One extra layer inside a VizPlot environment; it inherits the environment keys it does not override.
\cs_new_protected:Npn \semio_viz_plot_layer:n #1 {
  \group_begin:
  \keys_set:nn { semio / viz / plot } {#1}
  \semio_viz_plot_prepare:
  \semio_viz_plot_draw_layer:
  \group_end:
}
%endregion 🔖️Run

%region 🔖️PublicApi
% 📈 \SemioVizPlot[grammar keys]: the ultimate API of taxonomy §79 in one call.
\NewDocumentCommand \SemioVizPlot { O{} } { \semio_viz_plot_run:n {#1} }
% 🥞 \SemioVizLayer[keys]: one additional layer inside a VizPlot environment. Architecture §3 gives the
% name to the plot grammar; semio-viz-composition still carries a same-named command form of its
% VizLayer environment, so this declaration claims the name and that command form is withdrawn there
% (the VizLayer environment and \SemioVizOverlay already cover figure-level layering).
\NewDocumentCommand \SemioVizLayer { O{} } { \semio_viz_plot_layer:n {#1} }

% 📈 VizPlot: the layered form of \SemioVizPlot; the environment keys are the shared defaults.
\NewDocumentEnvironment { VizPlot } { O{} }
  {
    \group_begin:
    \semio_viz_plot_keys_reset:
    \keys_set:nn { semio / viz / plot } {#1}
    \bool_set_true:N \l_semio_viz_plot_in_environment_bool
    \semio_viz_plot_apply_theme:
    \semio_viz_plot_prepare:
  }
  { \semio_viz_plot_draw_chrome: \group_end: }
%endregion 🔖️PublicApi

\ExplSyntaxOff
