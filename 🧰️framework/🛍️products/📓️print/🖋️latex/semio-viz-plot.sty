      \exp_args:Nnx \keys_set:nn {semio/viz/mark}{##1={\exp_not:V\l_tmpa_tl}}
    }
  }
  \bool_if:NF \l_semio_viz_mark_tradius_set_bool {\fp_set_eq:NN\l_semio_viz_mark_tradius_fp\l_semio_viz_mark_radius_fp}
  \semio_viz_mark_local:
  \semio_viz_ribbon_path:nnnnnnn {\l_semio_viz_mark_radius_fp}{\l_semio_viz_mark_start_fp}{\l_semio_viz_mark_end_fp}{\l_semio_viz_mark_tradius_fp}{\l_semio_viz_mark_tstart_fp}{\l_semio_viz_mark_tend_fp}{\l_semio_viz_mark_pad_fp}
  \semio_viz_mark_emit:n {plot/ribbon}
}
\cs_new_protected:Npn \semio_viz_plot_text: {
  \prop_get:NnN \l_semio_viz_plot_values_prop {text}\l_tmpa_tl
  \str_case:Vn \l_semio_viz_plot_anchor_tl {{start}{\tl_set:Nn\l_semio_viz_plot_anchor_tl{west}}{middle}{\tl_set:Nn\l_semio_viz_plot_anchor_tl{center}}{end}{\tl_set:Nn\l_semio_viz_plot_anchor_tl{east}}}
  \semio_viz_probe_geometry:nx {plot/text}{\fp_to_decimal:N\l_semio_viz_plot_px_fp,\fp_to_decimal:N\l_semio_viz_plot_py_fp}
  \use:x {\exp_not:N\node[anchor={\exp_not:V\l_semio_viz_plot_anchor_tl},text={\exp_not:V\l_semio_viz_mark_fill_tl},opacity=\fp_eval:n{\l_semio_viz_mark_opacity_fp*\semio_viz_color_alpha:n{\l_semio_viz_mark_fill_tl}},rotate=\fp_to_decimal:N\l_semio_viz_mark_rotate_fp,font={\exp_not:N\SemioSans\exp_not:N\fontsize{\fp_to_decimal:N\l_semio_viz_mark_size_fp}{\fp_eval:n{1.2*\l_semio_viz_mark_size_fp}}\exp_not:N\selectfont}] at(\fp_to_decimal:N\l_semio_viz_plot_px_fp,\fp_to_decimal:N\l_semio_viz_plot_py_fp){\exp_not:V\l_tmpa_tl};}
}
\cs_new_protected:Npn \semio_viz_plot_trail: {
  \tl_if_empty:NF \l_semio_viz_plot_previous_tl {
    \use:x {\exp_not:N\semio_viz_path_draw:nn {polyline}{\exp_not:V\l_semio_viz_plot_previous_style_tl,points={\exp_not:V\l_semio_viz_plot_previous_tl;\fp_to_decimal:N\l_semio_viz_plot_px_fp,\fp_to_decimal:N\l_semio_viz_plot_py_fp}}}
  }
  \tl_set:Nx \l_semio_viz_plot_previous_tl {\fp_to_decimal:N\l_semio_viz_plot_px_fp,\fp_to_decimal:N\l_semio_viz_plot_py_fp}
  \tl_set:Nx \l_semio_viz_plot_previous_style_tl {\exp_not:V\l_semio_viz_plot_style_tl,strokeWidth=\fp_to_decimal:N\l_semio_viz_mark_size_fp mm}
}

% 〰️ Draws each series with its configured curve and both area boundaries.
\cs_new_protected:Npn \semio_viz_plot_paint_path: {
  \tl_set:Nn \l_semio_viz_plot_path_kind_tl {polyline}
  \str_case:Vn \l_semio_viz_plot_mark_tl {{area}{\tl_set:Nn\l_semio_viz_plot_path_kind_tl{band}}{band}{\tl_set:Nn\l_semio_viz_plot_path_kind_tl{band}}{polygon}{\tl_set:Nn\l_semio_viz_plot_path_kind_tl{polygon}}}
  \clist_if_in:nVT {line,path,area,band,polygon}\l_semio_viz_plot_mark_tl {
    \bool_set_false:N \l_semio_viz_plot_varied_bool
    \seq_map_inline:Nn \l_semio_viz_plot_styles_seq {\tl_if_eq:NnF \l_semio_viz_plot_group_style_tl {##1}{\bool_set_true:N\l_semio_viz_plot_varied_bool}}
    \str_if_eq:VnT \l_semio_viz_plot_mark_tl {polygon}{\bool_set_false:N \l_semio_viz_plot_varied_bool}
    \bool_if:NTF \l_semio_viz_plot_varied_bool
      {
        \seq_set_split:NnV \l_semio_viz_plot_point_pairs_seq {;}\l_semio_viz_plot_points_tl
        \seq_set_split:NnV \l_semio_viz_plot_base_pairs_seq {;}\l_semio_viz_plot_base_tl
        \int_step_inline:nnnn {2}{1}{\seq_count:N\l_semio_viz_plot_point_pairs_seq} {
          \use:x {\exp_not:N\semio_viz_path_draw:nn {\exp_not:V\l_semio_viz_plot_path_kind_tl}{\seq_item:Nn\l_semio_viz_plot_styles_seq{##1-1},points={\seq_item:Nn\l_semio_viz_plot_point_pairs_seq{##1-1};\seq_item:Nn\l_semio_viz_plot_point_pairs_seq{##1}},points2={\seq_item:Nn\l_semio_viz_plot_base_pairs_seq{##1-1};\seq_item:Nn\l_semio_viz_plot_base_pairs_seq{##1}}}}
        }
      }
      {\use:x {\exp_not:N\semio_viz_path_draw:nn {\exp_not:V\l_semio_viz_plot_path_kind_tl}{\exp_not:V\l_semio_viz_plot_group_style_tl,points={\exp_not:V\l_semio_viz_plot_points_tl},points2={\exp_not:V\l_semio_viz_plot_base_tl}}}}
  }
}%endregion 🔖️Layers

%region 🔖️Chrome
% 🧭 The guides and annotations declared once for the whole plot. `guide` is a list of
% `axis=<channel>`, `grid` and `legend` items, each drawn against the plot's own scales.
\cs_new_protected:Npn \semio_viz_plot_draw_chrome: {
  \tl_if_empty:NF \l_semio_viz_plot_guide_tl
    {
      \exp_args:NV \clist_map_inline:nn \l_semio_viz_plot_guide_tl
        { \semio_viz_plot_guide_item:n {##1} }
    }
  \tl_if_empty:NF \l_semio_viz_plot_annotation_tl
    {
      \exp_args:NV \clist_map_inline:nn \l_semio_viz_plot_annotation_tl
        { \SemioVizAnnotate {##1} }
    }
}

% 🧭 One item of the `guide` list.
\cs_new_protected:Npn \semio_viz_plot_guide_item:n #1 {
  \str_case:nnF {#1}
    {
      { grid } { \SemioVizGrid [ x = plot-x , y = plot-y ] }
      { axis=x } { \SemioVizAxis [ scale = plot-x , orient = bottom ] }
      { axis=y } { \SemioVizAxis [ scale = plot-y , orient = left ] }
      { legend } { \SemioVizLegend [ scale = plot-x ] }
    }
    { }
}

% 🎨 Applies the plot theme before anything is painted.
\cs_new_protected:Npn \semio_viz_plot_apply_theme: {
  \tl_if_empty:NF \l_semio_viz_plot_theme_tl
    { \exp_args:NV \semio_viz_theme_use:n \l_semio_viz_plot_theme_tl }
}
%endregion 🔖️Chrome

%region 🔖️Run
% ▶️ One complete plot: keys, transforms, one layer, chrome.
\cs_new_protected:Npn \semio_viz_plot_run:n #1 {
  \group_begin:
  \semio_viz_plot_keys_reset:
  \keys_set:nn { semio / viz / plot } {#1}
  \semio_viz_plot_apply_theme:
  \semio_viz_plot_prepare:
  \semio_viz_plot_draw_layer:
  \semio_viz_plot_draw_chrome:
  \group_end:
}

% 🥞 One extra layer inside a VizPlot environment; it inherits the environment keys it does not override.
\cs_new_protected:Npn \semio_viz_plot_layer:n #1 {
  \group_begin:
  \keys_set:nn { semio / viz / plot } {#1}
  \semio_viz_plot_prepare:
  \semio_viz_plot_draw_layer:
  \group_end:
}
%endregion 🔖️Run

%region 🔖️PublicApi
% 📈 \SemioVizPlot[grammar keys]: the ultimate API of taxonomy §79 in one call.
\NewDocumentCommand \SemioVizPlot { O{} } { \semio_viz_plot_run:n {#1} }
% 🥞 \SemioVizLayer[keys]: one additional layer inside a VizPlot environment. Architecture §3 gives the
% name to the plot grammar; semio-viz-composition still carries a same-named command form of its
% VizLayer environment, so this declaration claims the name and that command form is withdrawn there
% (the VizLayer environment and \SemioVizOverlay already cover figure-level layering).
\NewDocumentCommand \SemioVizLayer { O{} } { \semio_viz_plot_layer:n {#1} }

% 📈 VizPlot: the layered form of \SemioVizPlot; the environment keys are the shared defaults.
\NewDocumentEnvironment { VizPlot } { O{} }
  {
    \group_begin:
    \semio_viz_plot_keys_reset:
    \keys_set:nn { semio / viz / plot } {#1}
    \bool_set_true:N \l_semio_viz_plot_in_environment_bool
    \semio_viz_plot_apply_theme:
    \semio_viz_plot_prepare:
  }
  { \semio_viz_plot_draw_chrome: \group_end: }
%endregion 🔖️PublicApi

