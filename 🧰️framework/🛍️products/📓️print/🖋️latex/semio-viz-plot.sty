      {\tl_put_right:Nn \l_tmpa_tl {,##1}}
      {\seq_put_right:NV \l_semio_viz_plot_groups_seq \l_semio_viz_plot_group_tl \tl_set:Nn \l_tmpa_tl {##1}}
    \prop_put:NVV \l_semio_viz_plot_groups_prop \l_semio_viz_plot_group_tl \l_tmpa_tl
