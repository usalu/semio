  \tl_set:Nx \l_semio_viz_plot_style_tl {fill={\exp_not:V\l_semio_viz_plot_fill_tl},stroke=none,size=16,curve={\exp_not:V\l_semio_viz_plot_curve_tl},\exp_not:V\l_semio_viz_plot_options_tl}
