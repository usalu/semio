\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-plot}[2026/09/05 v0.3.0 semio viz grammar entry point and chart-kind catalogue dispatch]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-data}
\RequirePackage{semio-viz-scale}
\RequirePackage{semio-viz-mark}
\RequirePackage{semio-viz-family}
\RequirePackage{semio-viz-shape}
\RequirePackage{semio-viz-coordinate}
\RequirePackage{semio-viz-guide}
\RequirePackage{semio-viz-annotation}
\RequirePackage{semio-viz-facet}
\RequirePackage{semio-viz-composition}
