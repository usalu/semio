    \use:x {\exp_not:N\clip (\fp_to_decimal:N\l_semio_viz_plot_xa_fp,\fp_to_decimal:N\l_semio_viz_plot_ya_fp) rectangle (\fp_to_decimal:N\l_semio_viz_plot_xb_fp,\fp_to_decimal:N\l_semio_viz_plot_yb_fp);}
  }
  \seq_map_inline:Nn \l_semio_viz_plot_groups_seq {
