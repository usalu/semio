}

% 🏷️ Leaves the id of node #1 of the bound graph.
\cs_new:Npn \semio_viz_network_id:n #1 { \seq_item:Nn \l_semio_viz_network_ids_seq {#1} }
% 🎨 Leaves the group of node #1 of the bound graph.
