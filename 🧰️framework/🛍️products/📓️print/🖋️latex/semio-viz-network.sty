\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-network}[2026/09/05 v0.3.0 semio viz network kernel: graph store, graph algorithms, deterministic layouts]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-data}
\RequirePackage{semio-viz-layout}
\RequirePackage{semio-viz-probe}

\ExplSyntaxOn

%region 🔖️Diagnostics
\msg_new:nnn { semio-viz } { unknown-force }
  { Unknown~force~'#1'~(link,~many-body,~center,~collide,~x,~y,~radial). }
%endregion 🔖️Diagnostics

%region 🔖️Keys
% ⚙️ Applies a family's documented defaults and then the caller's options, so no layout call inherits
% the option state of the previous one.
\tl_new:N \l_semio_viz_network_rest_tl
\cs_new_protected:Npn \semio_viz_network_keys:nNn #1#2#3 {
  \keys_set:nV { semio / viz / #1 } #2
  \keys_set_known:nnN { semio / viz / graph / bind } {#3} \l_semio_viz_network_rest_tl
  \keys_set:nV { semio / viz / #1 } \l_semio_viz_network_rest_tl
}
%endregion 🔖️Keys

%region 🔖️GraphStore
% 🔁 Argument variants the l3 kernel does not ship; guarded so a later kernel definition wins.
\cs_if_exist:NF \prop_item:cV { \cs_generate_variant:Nn \prop_item:Nn { cV } }
\cs_if_exist:NF \prop_gput:cVn { \cs_generate_variant:Nn \prop_gput:Nnn { cVn } }
\cs_if_exist:NF \seq_map_indexed_inline:cn { \cs_generate_variant:Nn \seq_map_indexed_inline:Nn { c } }
\cs_if_exist:NF \seq_map_function:cN { \cs_generate_variant:Nn \seq_map_function:NN { c } }
\cs_if_exist:NF \clist_if_in:cnTF { \prg_generate_conditional_variant:Nnn \clist_if_in:Nn { cn } { T, F, TF } }

% 🕸️ Column bindings of the graph currently being read; they follow the roles declared by \SemioVizGraph
% in semio-viz-data, and fall back to the conventional column names when a role is missing.
\tl_new:N \l_semio_viz_network_nodes_tl
\tl_new:N \l_semio_viz_network_edges_tl
\tl_new:N \l_semio_viz_network_id_tl
\tl_new:N \l_semio_viz_network_source_tl
\tl_new:N \l_semio_viz_network_target_tl
\tl_new:N \l_semio_viz_network_weight_tl
\tl_new:N \l_semio_viz_network_group_tl
\tl_new:N \l_semio_viz_network_name_tl
\tl_new:N \l_semio_viz_network_cell_tl
\tl_new:N \l_semio_viz_network_cell_two_tl
\tl_new:N \l_semio_viz_network_cell_three_tl
\tl_new:N \l_semio_viz_network_kind_tl
\bool_new:N \l_semio_viz_network_has_group_bool
\bool_new:N \l_semio_viz_network_has_weight_bool
\int_new:N \l_semio_viz_network_scan_int
\seq_new:N \g_semio_viz_graph_names_seq

% ❓ True when table #1 declares column #2.
\prg_new_protected_conditional:Npnn \semio_viz_network_column_if:nn #1#2 { T, F, TF } {
  \clist_if_in:cnTF { g_semio_viz_table_ #1 _cols_clist } {#2}
    { \prg_return_true: } { \prg_return_false: }
}
\prg_generate_conditional_variant:Nnn \semio_viz_network_column_if:nn { VV } { T, F, TF }

% 🎭 Reads role #2 of table #1 into #3, leaving #3 empty when the table carries no role map.
\cs_new_protected:Npn \semio_viz_network_role:nnN #1#2#3 {
  \prop_if_exist:cTF { g_semio_viz_table_ #1 _roles_prop }
    { \tl_set:Nx #3 { \prop_item:cn { g_semio_viz_table_ #1 _roles_prop } {#2} } }
    { \tl_clear:N #3 }
}
\cs_generate_variant:Nn \semio_viz_network_role:nnN { VnN }

% 🎭 Resolves every column binding of graph table #1: node and edge tables, id, source, target, weight, group.
\cs_new_protected:Npn \semio_viz_network_roles_read:n #1 {
  \semio_viz_network_role:nnN {#1} { nodes } \l_semio_viz_network_nodes_tl
  \semio_viz_network_role:nnN {#1} { edges } \l_semio_viz_network_edges_tl
  \semio_viz_network_role:nnN {#1} { source } \l_semio_viz_network_source_tl
  \semio_viz_network_role:nnN {#1} { target } \l_semio_viz_network_target_tl
  \semio_viz_network_role:nnN {#1} { weight } \l_semio_viz_network_weight_tl
  \tl_if_empty:NT \l_semio_viz_network_edges_tl { \tl_set:Nn \l_semio_viz_network_edges_tl {#1} }
  \tl_if_empty:NT \l_semio_viz_network_source_tl { \tl_set:Nn \l_semio_viz_network_source_tl { source } }
  \tl_if_empty:NT \l_semio_viz_network_target_tl { \tl_set:Nn \l_semio_viz_network_target_tl { target } }
  \tl_if_empty:NT \l_semio_viz_network_weight_tl { \tl_set:Nn \l_semio_viz_network_weight_tl { weight } }
  \tl_if_empty:NTF \l_semio_viz_network_nodes_tl
    {
      \tl_set:Nn \l_semio_viz_network_id_tl { id }
      \tl_set:Nn \l_semio_viz_network_group_tl { group }
    }
    {
      \semio_viz_network_role:VnN \l_semio_viz_network_nodes_tl { id } \l_semio_viz_network_id_tl
      \semio_viz_network_role:VnN \l_semio_viz_network_nodes_tl { group } \l_semio_viz_network_group_tl
      \tl_if_empty:NT \l_semio_viz_network_id_tl { \tl_set:Nn \l_semio_viz_network_id_tl { id } }
      \tl_if_empty:NT \l_semio_viz_network_group_tl { \tl_set:Nn \l_semio_viz_network_group_tl { group } }
    }
  \semio_viz_network_column_if:VVTF \l_semio_viz_network_edges_tl \l_semio_viz_network_weight_tl
    { \bool_set_true:N \l_semio_viz_network_has_weight_bool }
    { \bool_set_false:N \l_semio_viz_network_has_weight_bool }
}

% 🔵 Registers node id #2 of graph #1 if it is new, keeping first-appearance order.
\cs_new_protected:Npn \semio_viz_network_node_add:nn #1#2 {
  \prop_if_in:cnF { g_semio_viz_graph_ #1 _index_prop } {#2} {
    \seq_gput_right:cn { g_semio_viz_graph_ #1 _nodes_seq } {#2}
    \prop_gput:cnx { g_semio_viz_graph_ #1 _index_prop } {#2}
      { \int_eval:n { \seq_count:c { g_semio_viz_graph_ #1 _nodes_seq } } }
    \seq_gput_right:cn { g_semio_viz_graph_ #1 _groups_seq } { }
  }
}

% 🔵 Appends row #2 of the node table to graph #1, with its group label when the column exists.
\cs_new_protected:Npn \semio_viz_network_node_read:nn #1#2 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_network_nodes_tl } {#2}
    { \l_semio_viz_network_id_tl } \l_semio_viz_network_cell_tl
  \seq_gput_right:cV { g_semio_viz_graph_ #1 _nodes_seq } \l_semio_viz_network_cell_tl
  \prop_gput:cVn { g_semio_viz_graph_ #1 _index_prop } \l_semio_viz_network_cell_tl {#2}
  \bool_if:NTF \l_semio_viz_network_has_group_bool
    {
      \semio_viz_table_cell:nnnN { \l_semio_viz_network_nodes_tl } {#2}
        { \l_semio_viz_network_group_tl } \l_semio_viz_network_cell_two_tl
    }
    { \tl_clear:N \l_semio_viz_network_cell_two_tl }
  \seq_gput_right:cV { g_semio_viz_graph_ #1 _groups_seq } \l_semio_viz_network_cell_two_tl
}

% ➖ Appends edge row #2 as the index triple {source}{target}{weight} to graph #1.
\cs_new_protected:Npn \semio_viz_network_edge_read:nn #1#2 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_network_edges_tl } {#2}
    { \l_semio_viz_network_source_tl } \l_semio_viz_network_cell_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_network_edges_tl } {#2}
    { \l_semio_viz_network_target_tl } \l_semio_viz_network_cell_two_tl
  \bool_if:NTF \l_semio_viz_network_has_weight_bool
    {
      \semio_viz_table_cell:nnnN { \l_semio_viz_network_edges_tl } {#2}
        { \l_semio_viz_network_weight_tl } \l_semio_viz_network_cell_three_tl
    }
    { \tl_set:Nn \l_semio_viz_network_cell_three_tl { 1 } }
  \tl_if_empty:NT \l_semio_viz_network_cell_three_tl { \tl_set:Nn \l_semio_viz_network_cell_three_tl { 1 } }
  \seq_gput_right:cx { g_semio_viz_graph_ #1 _edges_seq }
    {
      { \prop_item:cV { g_semio_viz_graph_ #1 _index_prop } \l_semio_viz_network_cell_tl }
      { \prop_item:cV { g_semio_viz_graph_ #1 _index_prop } \l_semio_viz_network_cell_two_tl }
      { \tl_use:N \l_semio_viz_network_cell_three_tl }
    }
}

% 🔵 Registers both endpoints of edge row #2, used when the graph has no separate node table.
\cs_new_protected:Npn \semio_viz_network_endpoints_read:nn #1#2 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_network_edges_tl } {#2}
    { \l_semio_viz_network_source_tl } \l_semio_viz_network_cell_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_network_edges_tl } {#2}
    { \l_semio_viz_network_target_tl } \l_semio_viz_network_cell_two_tl
  \exp_args:NnV \semio_viz_network_node_add:nn {#1} \l_semio_viz_network_cell_tl
  \exp_args:NnV \semio_viz_network_node_add:nn {#1} \l_semio_viz_network_cell_two_tl
}

% 🎭 Per-call overrides of the column bindings, for callers whose table carries no roles or
% other ones (`\SemioVizLayout{sankey}{demo-flow}{out}[...]` with `weight=value`, say).
\keys_define:nn { semio / viz / graph / bind } {
  nodes  .tl_set:N = \l_semio_viz_network_nodes_tl,
  edges  .tl_set:N = \l_semio_viz_network_edges_tl,
  id     .tl_set:N = \l_semio_viz_network_id_tl,
  source .tl_set:N = \l_semio_viz_network_source_tl,
  target .tl_set:N = \l_semio_viz_network_target_tl,
  weight .tl_set:N = \l_semio_viz_network_weight_tl,
  group  .tl_set:N = \l_semio_viz_network_group_tl,
}

% 🧱 Reads graph table #1 into the global node/edge structures; nodes come from the node table when the
% `nodes` role names one, otherwise from the first appearance of every endpoint in the edge list.
\cs_new_protected:Npn \semio_viz_network_graph_build:nn #1#2 {
  \tl_set:Nn \l_semio_viz_network_name_tl {#1}
  \seq_if_in:NnF \g_semio_viz_graph_names_seq {#1} { \seq_gput_right:Nn \g_semio_viz_graph_names_seq {#1} }
  \seq_clear_new:c { g_semio_viz_graph_ #1 _nodes_seq }
  \seq_clear_new:c { g_semio_viz_graph_ #1 _groups_seq }
  \seq_clear_new:c { g_semio_viz_graph_ #1 _edges_seq }
  \prop_clear_new:c { g_semio_viz_graph_ #1 _index_prop }
  \semio_viz_network_roles_read:n {#1}
  \keys_set_known:nn { semio / viz / graph / bind } {#2}
  \semio_viz_network_column_if:VVTF \l_semio_viz_network_edges_tl \l_semio_viz_network_weight_tl
    { \bool_set_true:N \l_semio_viz_network_has_weight_bool }
    { \bool_set_false:N \l_semio_viz_network_has_weight_bool }
  \tl_if_empty:NTF \l_semio_viz_network_nodes_tl
    {
      \semio_viz_table_nrows:nN { \l_semio_viz_network_edges_tl } \l_semio_viz_network_scan_int
      \int_step_inline:nn { \l_semio_viz_network_scan_int } { \semio_viz_network_endpoints_read:nn {#1} {##1} }
    }
    {
      \semio_viz_network_column_if:VVTF \l_semio_viz_network_nodes_tl \l_semio_viz_network_group_tl
        { \bool_set_true:N \l_semio_viz_network_has_group_bool }
        { \bool_set_false:N \l_semio_viz_network_has_group_bool }
      \semio_viz_table_nrows:nN { \l_semio_viz_network_nodes_tl } \l_semio_viz_network_scan_int
      \int_step_inline:nn { \l_semio_viz_network_scan_int } { \semio_viz_network_node_read:nn {#1} {##1} }
    }
  \semio_viz_table_nrows:nN { \l_semio_viz_network_edges_tl } \l_semio_viz_network_scan_int
  \int_step_inline:nn { \l_semio_viz_network_scan_int } { \semio_viz_network_edge_read:nn {#1} {##1} }
}
%endregion 🔖️GraphStore


%region 🔖️Arrays
% 🧮 Indexed working arrays: fp for reals, tl for integers (no register pressure), seq for adjacency lists.
\cs_new_protected:Npn \semio_viz_network_fp_ensure:nn #1#2 {
  \int_step_inline:nn {#2}
    { \cs_if_exist:cF { l_semio_viz_network_ #1 _ ##1 _fp } { \fp_new:c { l_semio_viz_network_ #1 _ ##1 _fp } } }
}
% 🧮 Declares and empties the integer array #1 for #2 nodes.
\cs_new_protected:Npn \semio_viz_network_n_ensure:nn #1#2 {
  \int_step_inline:nn {#2} { \tl_clear_new:c { l_semio_viz_network_ #1 _ ##1 _tl } }
}
% 🧮 Declares and empties the adjacency array #1 for #2 nodes.
\cs_new_protected:Npn \semio_viz_network_seq_ensure:nn #1#2 {
  \int_step_inline:nn {#2} { \seq_clear_new:c { l_semio_viz_network_ #1 _ ##1 _seq } }
}

% 🔎 Entry #2 of the real array #1.
\cs_new:Npn \semio_viz_network_f:nn #1#2 { \use:c { l_semio_viz_network_ #1 _ \int_eval:n {#2} _fp } }
% 🔎 Entry #2 of the integer array #1.
\cs_new:Npn \semio_viz_network_n:nn #1#2 { \use:c { l_semio_viz_network_ #1 _ \int_eval:n {#2} _tl } }
% ✏️ Sets entry #2 of the real array #1 to #3.
\cs_new_protected:Npn \semio_viz_network_fset:nnn #1#2#3
  { \fp_set:cn { l_semio_viz_network_ #1 _ \int_eval:n {#2} _fp } {#3} }
% ➕ Adds #3 to entry #2 of the real array #1.
\cs_new_protected:Npn \semio_viz_network_fadd:nnn #1#2#3
  { \fp_add:cn { l_semio_viz_network_ #1 _ \int_eval:n {#2} _fp } {#3} }
% ✏️ Sets entry #2 of the integer array #1 to #3.
\cs_new_protected:Npn \semio_viz_network_nset:nnn #1#2#3
  { \tl_set:cx { l_semio_viz_network_ #1 _ \int_eval:n {#2} _tl } { \int_eval:n {#3} } }
% ➕ Appends #3 to entry #2 of the adjacency array #1.
\cs_new_protected:Npn \semio_viz_network_sput:nnn #1#2#3
  { \seq_put_right:cn { l_semio_viz_network_ #1 _ \int_eval:n {#2} _seq } {#3} }
%endregion 🔖️Arrays

%region 🔖️Random
% 🎲 d3's linear congruential generator, seed s=1, a=1664525, c=1013904223, m=2^32; the only randomness in this kernel.
\fp_new:N \g_semio_viz_network_lcg_fp
\fp_gset:Nn \g_semio_viz_network_lcg_fp { 1 }
\fp_new:N \l_semio_viz_network_rand_fp

% 🎲 Resets the generator state; the documented default seed is 1, exactly d3-force's.
\cs_new_protected:Npn \semio_viz_network_seed:n #1 { \fp_gset:Nn \g_semio_viz_network_lcg_fp {#1} }

% 🎲 Advances the generator; the next value in [0,1) lands in \l_semio_viz_network_rand_fp.
\fp_new:N \l_semio_viz_network_lcg_hi_fp
\fp_new:N \l_semio_viz_network_lcg_lo_fp
\cs_new_protected:Npn \semio_viz_network_random: {
  \fp_set:Nn \l_semio_viz_network_lcg_hi_fp { floor( \g_semio_viz_network_lcg_fp / 65536 ) }
  \fp_set:Nn \l_semio_viz_network_lcg_lo_fp
    { \g_semio_viz_network_lcg_fp - 65536 * \l_semio_viz_network_lcg_hi_fp }
  \fp_set:Nn \l_semio_viz_network_lcg_hi_fp
    {
      1664525 * \l_semio_viz_network_lcg_hi_fp
      - 65536 * floor( 1664525 * \l_semio_viz_network_lcg_hi_fp / 65536 )
    }
  \fp_gset:Nn \g_semio_viz_network_lcg_fp
    { \l_semio_viz_network_lcg_hi_fp * 65536 + 1664525 * \l_semio_viz_network_lcg_lo_fp + 1013904223 }
  \fp_gset:Nn \g_semio_viz_network_lcg_fp
    { \g_semio_viz_network_lcg_fp - 4294967296 * floor( \g_semio_viz_network_lcg_fp / 4294967296 ) }
  \fp_set:Nn \l_semio_viz_network_rand_fp { \g_semio_viz_network_lcg_fp / 4294967296 }
}

% 🎲 d3-force's jiggle: (random() - 0.5) * 1e-6, used only when a coordinate difference is exactly zero.
\cs_new_protected:Npn \semio_viz_network_jiggle:N #1 {
  \semio_viz_network_random:
  \fp_set:Nn #1 { ( \l_semio_viz_network_rand_fp - 0.5 ) * 1e-6 }
}
%endregion 🔖️Random

%region 🔖️Binding
\int_new:N \l_semio_viz_network_n_int
\int_new:N \l_semio_viz_network_m_int
\int_new:N \l_semio_viz_network_i_int
\int_new:N \l_semio_viz_network_j_int
\int_new:N \l_semio_viz_network_k_int
\int_new:N \l_semio_viz_network_layers_int
\int_new:N \l_semio_viz_network_components_int
\tl_new:N \l_semio_viz_network_bound_tl
\seq_new:N \l_semio_viz_network_ids_seq
\seq_new:N \l_semio_viz_network_group_seq
\seq_new:N \l_semio_viz_network_queue_seq
\seq_new:N \l_semio_viz_network_stack_seq
\seq_new:N \l_semio_viz_network_scratch_seq
\seq_new:N \l_semio_viz_network_order_seq

% 🔗 Stores edge #1 as source/target/weight arrays and extends the degree and adjacency structures.
\cs_new_protected:Npn \semio_viz_network_edge_set:nnnn #1#2#3#4 {
  \semio_viz_network_nset:nnn { es } {#1} {#2}
  \semio_viz_network_nset:nnn { et } {#1} {#3}
  \semio_viz_network_fset:nnn { ew } {#1} {#4}
  \semio_viz_network_nset:nnn { erev } {#1} { 0 }
  \semio_viz_network_sput:nnn { adj } {#2} {#3}
  \semio_viz_network_sput:nnn { adj } {#3} {#2}
  \semio_viz_network_sput:nnn { outadj } {#2} {#3}
  \semio_viz_network_sput:nnn { inadj } {#3} {#2}
  \semio_viz_network_sput:nnn { inc } {#2} {#1}
  \semio_viz_network_sput:nnn { inc } {#3} {#1}
  \semio_viz_network_nset:nnn { deg } {#2} { \semio_viz_network_n:nn { deg } {#2} + 1 }
  \semio_viz_network_nset:nnn { deg } {#3} { \semio_viz_network_n:nn { deg } {#3} + 1 }
  \semio_viz_network_nset:nnn { outdeg } {#2} { \semio_viz_network_n:nn { outdeg } {#2} + 1 }
  \semio_viz_network_nset:nnn { indeg } {#3} { \semio_viz_network_n:nn { indeg } {#3} + 1 }
}
% 📥 Unwraps one braced edge record #2 into the four arguments the edge setter expects.
\cs_new_protected:Npn \semio_viz_network_edge_load:nn #1#2 { \semio_viz_network_edge_set:nnnn {#1} #2 }

% 🧷 Loads graph #1 into the working arrays: ids, groups, edges, weights, degrees, adjacency lists.
\cs_new_protected:Npn \semio_viz_network_use:nn #1#2 {
  \semio_viz_network_graph_build:nn {#1} {#2}
  \tl_set:Nn \l_semio_viz_network_bound_tl {#1}
  \seq_set_eq:Nc \l_semio_viz_network_ids_seq { g_semio_viz_graph_ #1 _nodes_seq }
  \seq_set_eq:Nc \l_semio_viz_network_group_seq { g_semio_viz_graph_ #1 _groups_seq }
  \int_set:Nn \l_semio_viz_network_n_int { \seq_count:N \l_semio_viz_network_ids_seq }
  \int_set:Nn \l_semio_viz_network_m_int { \seq_count:c { g_semio_viz_graph_ #1 _edges_seq } }
  \semio_viz_network_n_ensure:nn { es } { \l_semio_viz_network_m_int }
  \semio_viz_network_n_ensure:nn { et } { \l_semio_viz_network_m_int }
  \semio_viz_network_n_ensure:nn { erev } { \l_semio_viz_network_m_int }
  \semio_viz_network_fp_ensure:nn { ew } { \l_semio_viz_network_m_int }
  \semio_viz_network_n_ensure:nn { deg } { \l_semio_viz_network_n_int }
  \semio_viz_network_n_ensure:nn { indeg } { \l_semio_viz_network_n_int }
  \semio_viz_network_n_ensure:nn { outdeg } { \l_semio_viz_network_n_int }
  \semio_viz_network_seq_ensure:nn { adj } { \l_semio_viz_network_n_int }
  \semio_viz_network_seq_ensure:nn { outadj } { \l_semio_viz_network_n_int }
