%region 🔖️Algorithms
% 🚿 Clears the visit marks and BFS depths of the bound graph.
\cs_new_protected:Npn \semio_viz_network_visit_reset: {
  \semio_viz_network_n_ensure:nn { seen } { \l_semio_viz_network_n_int }
  \semio_viz_network_n_ensure:nn { depth } { \l_semio_viz_network_n_int }
  \int_step_inline:nn { \l_semio_viz_network_n_int } {
    \semio_viz_network_nset:nnn { seen } {##1} { 0 }
    \semio_viz_network_nset:nnn { depth } {##1} { 0 }
  }
}

% ➕ Queues node #1, discovered from #2, once, and records its depth one below #2's.
\cs_new_protected:Npn \semio_viz_network_bfs_push:nn #1#2 {
  \int_compare:nNnF { \semio_viz_network_n:nn { seen } {#1} } = { 1 } {
    \semio_viz_network_nset:nnn { seen } {#1} { 1 }
    \semio_viz_network_nset:nnn { depth } {#1} { \semio_viz_network_n:nn { depth } {#2} + 1 }
    \seq_put_right:Nn \l_semio_viz_network_queue_seq {#1}
  }
}
% 🌊 Queues every neighbour of node #1 along the adjacency the walk was opened with.
\cs_new_protected:Npn \semio_viz_network_bfs_expand:n #1 {
  \seq_map_inline:cn { l_semio_viz_network_ \l_semio_viz_network_walk_tl _ #1 _seq }
    { \semio_viz_network_bfs_push:nn {##1} {#1} }
}
\tl_new:N \l_semio_viz_network_walk_tl

% 🌊 Breadth-first traversal from node #1 over adjacency #2 (adj, outadj, inadj), appending to \l_semio_viz_network_order_seq.
\cs_new_protected:Npn \semio_viz_network_bfs_from:nn #1#2 {
  \tl_set:Nn \l_semio_viz_network_walk_tl {#2}
  \int_compare:nNnF { \semio_viz_network_n:nn { seen } {#1} } = { 1 } {
    \seq_clear:N \l_semio_viz_network_queue_seq
    \seq_put_right:Nn \l_semio_viz_network_queue_seq {#1}
    \semio_viz_network_nset:nnn { seen } {#1} { 1 }
    \bool_until_do:nn { \seq_if_empty_p:N \l_semio_viz_network_queue_seq } {
      \seq_pop_left:NN \l_semio_viz_network_queue_seq \l_semio_viz_network_cell_tl
      \seq_put_right:NV \l_semio_viz_network_order_seq \l_semio_viz_network_cell_tl
      \exp_args:NV \semio_viz_network_bfs_expand:n \l_semio_viz_network_cell_tl
    }
  }
}

% 🪜 Pushes the neighbours of node #1 in reverse, so the stack pops them in declaration order.
\cs_new_protected:Npn \semio_viz_network_dfs_expand:n #1 {
  \seq_set_eq:Nc \l_semio_viz_network_scratch_seq { l_semio_viz_network_ \l_semio_viz_network_walk_tl _ #1 _seq }
  \seq_reverse:N \l_semio_viz_network_scratch_seq
  \seq_map_inline:Nn \l_semio_viz_network_scratch_seq { \seq_put_left:Nn \l_semio_viz_network_stack_seq {##1} }
}

% 🪜 Depth-first preorder traversal from node #1 over adjacency #2, neighbours in declaration order.
\cs_new_protected:Npn \semio_viz_network_dfs_from:nn #1#2 {
  \tl_set:Nn \l_semio_viz_network_walk_tl {#2}
  \seq_clear:N \l_semio_viz_network_stack_seq
  \seq_put_left:Nn \l_semio_viz_network_stack_seq {#1}
  \bool_until_do:nn { \seq_if_empty_p:N \l_semio_viz_network_stack_seq } {
    \seq_pop_left:NN \l_semio_viz_network_stack_seq \l_semio_viz_network_cell_tl
    \int_compare:nNnF { \semio_viz_network_n:nn { seen } { \l_semio_viz_network_cell_tl } } = { 1 } {
      \semio_viz_network_nset:nnn { seen } { \l_semio_viz_network_cell_tl } { 1 }
      \seq_put_right:NV \l_semio_viz_network_order_seq \l_semio_viz_network_cell_tl
      \exp_args:NV \semio_viz_network_dfs_expand:n \l_semio_viz_network_cell_tl
    }
  }
}

% 🏷️ Labels node #1 with the component number currently being discovered.
\cs_new_protected:Npn \semio_viz_network_component_mark:n #1
  { \semio_viz_network_nset:nnn { comp } {#1} { \l_semio_viz_network_components_int } }

% 🧩 Labels every node with its connected component, discovered in index order and numbered from 1.
\cs_new_protected:Npn \semio_viz_network_components: {
  \semio_viz_network_visit_reset:
  \semio_viz_network_n_ensure:nn { comp } { \l_semio_viz_network_n_int }
  \int_zero:N \l_semio_viz_network_components_int
  \int_step_inline:nn { \l_semio_viz_network_n_int } {
    \int_compare:nNnF { \semio_viz_network_n:nn { seen } {##1} } = { 1 } {
      \int_incr:N \l_semio_viz_network_components_int
      \seq_clear:N \l_semio_viz_network_order_seq
      \semio_viz_network_bfs_from:nn {##1} { adj }
      \seq_map_function:NN \l_semio_viz_network_order_seq \semio_viz_network_component_mark:n
    }
  }
}

% ➖ Takes one incoming edge off node #1's pending count, as its predecessor is emitted.
\cs_new_protected:Npn \semio_viz_network_topo_relax:n #1
  { \semio_viz_network_nset:nnn { pend } {#1} { \semio_viz_network_n:nn { pend } {#1} - 1 } }

% 🪢 One Kahn round: the first node with nothing pending is emitted and its successors relaxed;
% no such node means the graph has a cycle, and the walk stops.
\cs_new_protected:Npn \semio_viz_network_topo_step: {
  \int_zero:N \l_semio_viz_network_k_int
  \int_step_inline:nn { \l_semio_viz_network_n_int } {
    \int_compare:nNnT \l_semio_viz_network_k_int = { 0 } {
      \int_compare:nNnT { \semio_viz_network_n:nn { done } {##1} } = { 0 } {
        \int_compare:nNnT { \semio_viz_network_n:nn { pend } {##1} } = { 0 }
          { \int_set:Nn \l_semio_viz_network_k_int {##1} }
      }
    }
  }
  \int_compare:nNnF \l_semio_viz_network_k_int = { 0 } {
    \semio_viz_network_nset:nnn { done } { \l_semio_viz_network_k_int } { 1 }
    \seq_put_right:Nx \l_semio_viz_network_order_seq { \int_use:N \l_semio_viz_network_k_int }
    \seq_map_function:cN { l_semio_viz_network_outadj_ \int_use:N \l_semio_viz_network_k_int _seq }
      \semio_viz_network_topo_relax:n
  }
}

% 🪢 Kahn topological order of the bound digraph, ties broken by node index; result in \l_semio_viz_network_order_seq.
\cs_new_protected:Npn \semio_viz_network_topological: {
  \semio_viz_network_n_ensure:nn { pend } { \l_semio_viz_network_n_int }
  \semio_viz_network_n_ensure:nn { done } { \l_semio_viz_network_n_int }
  \seq_clear:N \l_semio_viz_network_order_seq
  \int_step_inline:nn { \l_semio_viz_network_n_int } {
    \semio_viz_network_nset:nnn { pend } {##1} { \semio_viz_network_n:nn { indeg } {##1} }
    \semio_viz_network_nset:nnn { done } {##1} { 0 }
  }
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_network_topo_step: }
}

% ✂️ One outgoing edge #2 of node #1 in the cycle-breaking walk: an unseen head is descended into,
% a head still on the stack means #2 is a back edge and is marked reversed.
\cs_new_protected:Npn \semio_viz_network_acyclic_edge:nn #1#2 {
  \int_compare:nNnT { \semio_viz_network_n:nn { es } {#2} } = {#1} {
    \int_case:nnF { \semio_viz_network_n:nn { state } { \semio_viz_network_n:nn { et } {#2} } }
      {
        { 0 } { \semio_viz_network_acyclic_visit:n { \semio_viz_network_n:nn { et } {#2} } }
        { 1 } { \semio_viz_network_nset:nnn { erev } {#2} { 1 } }
      }
      { }
  }
}
% 🪜 Visits node #1 in that walk: on the stack while its edges are followed, finished afterwards.
\cs_new_protected:Npn \semio_viz_network_acyclic_visit:n #1 {
  \semio_viz_network_nset:nnn { state } {#1} { 1 }
  \seq_map_inline:cn { l_semio_viz_network_inc_ \int_eval:n {#1} _seq }
    { \semio_viz_network_acyclic_edge:nn {#1} {##1} }
  \semio_viz_network_nset:nnn { state } {#1} { 2 }
}

% ✂️ Marks the back edges found by a DFS in index order as reversed, making the bound digraph acyclic.
\cs_new_protected:Npn \semio_viz_network_acyclic: {
  \semio_viz_network_n_ensure:nn { state } { \l_semio_viz_network_n_int }
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_network_nset:nnn { state } {##1} { 0 } }
  \int_step_inline:nn { \l_semio_viz_network_m_int } { \semio_viz_network_nset:nnn { erev } {##1} { 0 } }
  \int_step_inline:nn { \l_semio_viz_network_n_int } {
    \int_compare:nNnT { \semio_viz_network_n:nn { state } {##1} } = { 0 }
      { \semio_viz_network_acyclic_visit:n {##1} }
  }
}

% 🪜 Pushes node #2 one layer past node #1, when it is not already at least that far.
\cs_new_protected:Npn \semio_viz_network_layer_push:nn #1#2 {
  \int_compare:nNnT { \semio_viz_network_n:nn { layer } {#2} } < { \semio_viz_network_n:nn { layer } {#1} + 1 }
    { \semio_viz_network_nset:nnn { layer } {#2} { \semio_viz_network_n:nn { layer } {#1} + 1 } }
}
% ➡️ Applies edge #1 in its effective direction, which is the other way round for a reversed edge.
\cs_new_protected:Npn \semio_viz_network_layer_edge:n #1 {
  \int_compare:nNnTF { \semio_viz_network_n:nn { erev } {#1} } = { 1 }
    { \semio_viz_network_layer_push:nn { \semio_viz_network_n:nn { et } {#1} } { \semio_viz_network_n:nn { es } {#1} } }
    { \semio_viz_network_layer_push:nn { \semio_viz_network_n:nn { es } {#1} } { \semio_viz_network_n:nn { et } {#1} } }
}
% 🔁 One relaxation sweep over every edge; repeating it until nothing moves gives the longest-path
% layering.
\cs_new_protected:Npn \semio_viz_network_layer_relax:
  { \int_step_inline:nn { \l_semio_viz_network_m_int } { \semio_viz_network_layer_edge:n {##1} } }

% 🪜 Longest-path layering after cycle removal; the layer count lands in \l_semio_viz_network_layers_int.
\cs_new_protected:Npn \semio_viz_network_layering: {
  \semio_viz_network_acyclic:
  \semio_viz_network_n_ensure:nn { layer } { \l_semio_viz_network_n_int }
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_network_nset:nnn { layer } {##1} { 0 } }
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_network_layer_relax: }
  \int_set:Nn \l_semio_viz_network_layers_int { 1 }
  \int_step_inline:nn { \l_semio_viz_network_n_int } {
    \int_compare:nNnT { \semio_viz_network_n:nn { layer } {##1} + 1 } > \l_semio_viz_network_layers_int
      { \int_set:Nn \l_semio_viz_network_layers_int { \semio_viz_network_n:nn { layer } {##1} + 1 } }
  }
}
%endregion 🔖️Algorithms

