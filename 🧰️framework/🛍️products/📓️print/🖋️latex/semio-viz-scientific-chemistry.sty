    azimuth   .fp_set:N   = \l_semio_viz_chem_azimuth_fp ,
    elevation .fp_set:N   = \l_semio_viz_chem_elevation_fp ,
    radius    .fp_set:N   = \l_semio_viz_chem_radius_fp ,
    bonds     .bool_set:N = \l_semio_viz_chem_bonds_bool ,
  }

% 🧊 §33 unit cells: the eight corner sites plus the body or face sites of the chosen Bravais lattice, in an axonometric view.
\SemioVizFamily { sci-crystal }
  {
    \semio_viz_sci_enter:nnn { sci-crystal }
      {
        lattice=face-centred , cell=22 , azimuth=45 , elevation=30 , radius=1.6 , bonds=true ,
        axes=false , grid=false
      }
      {#1}
    \bool_if:NT \l_semio_viz_chem_bonds_bool { \semio_viz_chem_cell_edges: }
    \int_step_inline:nnnn { 0 } { 1 } { 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { 1 }
          { \semio_viz_chem_corner_column:nn {##1} {####1} }
      }
    \str_case:VnF \l_semio_viz_chem_lattice_tl
      {
        { body-centred } { \semio_viz_chem_site:nnn { 0.5 } { 0.5 } { 0.5 } }
        { face-centred }
          {
            \semio_viz_chem_site:nnn { 0.5 } { 0.5 } { 0 }
            \semio_viz_chem_site:nnn { 0.5 } { 0.5 } { 1 }
            \semio_viz_chem_site:nnn { 0.5 } { 0 } { 0.5 }
            \semio_viz_chem_site:nnn { 0.5 } { 1 } { 0.5 }
            \semio_viz_chem_site:nnn { 0 } { 0.5 } { 0.5 }
            \semio_viz_chem_site:nnn { 1 } { 0.5 } { 0.5 }
          }
        { hexagonal }
          {
            \semio_viz_chem_site:nnn { 0.3333 } { 0.6667 } { 0.5 }
            \semio_viz_chem_site:nnn { 0.6667 } { 0.3333 } { 0.5 }
          }
      }
      { }
  }
% 🏗️ Places the two corner sites above each other at cell column (#1,#2), one at the bottom face and one at the top.
\cs_new_protected:Npn \semio_viz_chem_corner_column:nn #1#2
  {
    \semio_viz_chem_site:nnn {#1} {#2} { 0 }
    \semio_viz_chem_site:nnn {#1} {#2} { 1 }
  }
% 🧊 Local axonometric projection: chemistry loads before the 3D package, so the unit cell carries its own camera.
\cs_new_protected:Npn \semio_viz_chem_project:nnn #1#2#3
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      {
        \l_semio_viz_chem_cell_fp
        * ( - ( #1 ) * sind ( \l_semio_viz_chem_azimuth_fp ) + ( #2 ) * cosd ( \l_semio_viz_chem_azimuth_fp ) )
      }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      {
        \l_semio_viz_chem_cell_fp
        * ( - ( ( #1 ) * cosd ( \l_semio_viz_chem_azimuth_fp ) + ( #2 ) * sind ( \l_semio_viz_chem_azimuth_fp ) )
              * sind ( \l_semio_viz_chem_elevation_fp )
            + ( #3 ) * cosd ( \l_semio_viz_chem_elevation_fp ) )
      }
  }
% 🔵 Projects fractional site (#1,#2,#3), fills an atom of the configured radius there and reports its screen position.
\cs_new_protected:Npn \semio_viz_chem_site:nnn #1#2#3
  {
    \semio_viz_chem_project:nnn {#1} {#2} {#3}
    \draw [ semio~sci~glyph , fill=semio-primary ]
      ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } )
      circle [ radius=\fp_eval:n { \l_semio_viz_chem_radius_fp } ] ;
    \semio_viz_sci_report_values:nn { crystal/site }
      { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp }
  }
% 🕸️ Draws the twelve edges of the unit cell, four along each of the three axes.
\cs_new_protected:Npn \semio_viz_chem_cell_edges:
  {
    \int_step_inline:nnnn { 0 } { 1 } { 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { 1 }
          {
            \semio_viz_chem_edge:nnnnnn {##1} {####1} { 0 } {##1} {####1} { 1 }
            \semio_viz_chem_edge:nnnnnn {##1} { 0 } {####1} {##1} { 1 } {####1}
            \semio_viz_chem_edge:nnnnnn { 0 } {##1} {####1} { 1 } {##1} {####1}
          }
      }
  }
% 📎 Projects both ends of the cell edge from (#1,#2,#3) to (#4,#5,#6) and strokes it in the border colour.
\cs_new_protected:Npn \semio_viz_chem_edge:nnnnnn #1#2#3#4#5#6
  {
    \semio_viz_chem_project:nnn {#1} {#2} {#3}
    \fp_set:Nn \l_semio_viz_sci_c_fp { \l_semio_viz_sci_a_fp }
    \fp_set:Nn \l_semio_viz_sci_d_fp { \l_semio_viz_sci_b_fp }
    \semio_viz_chem_project:nnn {#4} {#5} {#6}
    \draw [ semio~sci~thin , draw=semio-chrome-border-normal ]
      ( \fp_eval:n { \l_semio_viz_sci_c_fp } , \fp_eval:n { \l_semio_viz_sci_d_fp } ) --
      ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) ;
  }
%endregion 🔖️Families

\ExplSyntaxOff
