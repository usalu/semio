% 📈 §33 spectroscopy: NMR, IR, mass, UV–Vis spectra and chromatograms, each a Lorentzian or bar profile of the same peak table.
\SemioVizFamily { sci-spectrum-peaks }
  {
    \semio_viz_sci_enter:nnn { sci-spectrum-peaks }
      {
        kind=nmr , reversed=true , samples=300 , domain={0,10} , range={} ,
