      }
      {#1}
    \str_if_eq:VnTF \l_semio_viz_chem_kind_tl { ms }
      { \semio_viz_chem_bars: }
      { \semio_viz_chem_profile: }
  }
% 🏔️ Samples the spectrum across the domain as the sum of one Lorentzian per peak, then frames, strokes and labels it.
\cs_new_protected:Npn \semio_viz_chem_profile:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_chem_samples_int }
      {
        \fp_set:Nn \SemioX
          {
            \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 }
            + ( \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 }
                - \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } )
              * ##1 / \l_semio_viz_chem_samples_int
          }
        \fp_zero:N \l_semio_viz_sci_a_fp
        \clist_map_inline:Nn \l_semio_viz_chem_peaks_clist
          {
            \seq_set_split:Nnn \l_tmpb_seq { / } {####1}
            \fp_add:Nn \l_semio_viz_sci_a_fp
              {
                \seq_item:Nn \l_tmpb_seq { 2 }
                / ( 1 + ( ( \SemioX - \seq_item:Nn \l_tmpb_seq { 1 } )
                    / \seq_item:Nn \l_tmpb_seq { 3 } ) ^ 2 )
              }
          }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \SemioX } { \l_semio_viz_sci_a_fp }
      }
    \semio_viz_chem_frame_directed:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \semio_viz_chem_peak_labels:
  }
% 🎋 Renders a mass spectrum as one bar per peak rising from the baseline, then reports the peak set and labels it.
\cs_new_protected:Npn \semio_viz_chem_bars:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \clist_map_inline:Nn \l_semio_viz_chem_peaks_clist
      {
        \semio_viz_chem_record:n {##1}
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \semio_viz_chem_field:n { 1 } } { \semio_viz_chem_field:n { 2 } }
      }
    \semio_viz_chem_frame_directed:
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      {
        \draw [ semio~sci~curve ]
          ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { 0 } ) --
          ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { \semio_viz_points_y:n {##1} } ) ;
      }
    \semio_viz_sci_report:Nn \l_semio_viz_sci_pts_seq { peak }
    \semio_viz_chem_peak_labels:
  }
% 📈 The frame, with the x axis reversed when the technique plots decreasing shift or wavenumber.
\cs_new_protected:Npn \semio_viz_chem_frame_directed:
  {
    \semio_viz_sci_extent:N \l_semio_viz_sci_pts_seq
    \bool_if:NTF \l_semio_viz_chem_reversed_bool
      {
        \semio_viz_sci_window:nnnn
          { \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 } }
          { \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } }
          { 0 } { \l_semio_viz_sci_ymax_fp * 1.15 }
      }
      {
        \semio_viz_sci_window:nnnn
          { \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } }
          { \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 } }
          { 0 } { \l_semio_viz_sci_ymax_fp * 1.15 }
      }
    \int_compare:nNnT { \clist_count:N \l_semio_viz_sci_range_clist } = { 2 }
      { \semio_viz_sci_window_keys: }
    \semio_viz_sci_frame:
  }
% 🏷️ Sets the name of every peak that carries one upright above its tip, rotated a quarter turn.
\cs_new_protected:Npn \semio_viz_chem_peak_labels:
  {
    \clist_map_inline:Nn \l_semio_viz_chem_peaks_clist
      {
        \semio_viz_chem_record:n {##1}
        \tl_set:Nx \l_semio_viz_chem_key_tl { \semio_viz_chem_field:n { 4 } }
        \tl_if_empty:NF \l_semio_viz_chem_key_tl
          {
            \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=south , rotate=90 ]
              at ( \semio_viz_sci_mx:n { \semio_viz_chem_field:n { 1 } } ,
                   \fp_eval:n { \semio_viz_sci_my:n { \semio_viz_chem_field:n { 2 } } + 1.2 } )
              { \tl_use:N \l_semio_viz_chem_key_tl } ;
          }
      }
  }

