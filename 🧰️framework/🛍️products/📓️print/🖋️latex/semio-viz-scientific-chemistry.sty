% 🔺 Draws the equilateral composition triangle and dots each point after converting its barycentric fractions into triangle coordinates.
\cs_new_protected:Npn \semio_viz_chem_ternary:
  {
    \draw [ semio~sci~axis ]
      ( 0 , 0 ) -- ( \fp_eval:n { \l_semio_viz_chem_side_fp } , 0 ) --
      ( \fp_eval:n { \l_semio_viz_chem_side_fp / 2 } ,
        \fp_eval:n { \l_semio_viz_chem_side_fp * sqrt (3) / 2 } ) -- cycle ;
    \clist_map_inline:Nn \l_semio_viz_chem_points_clist
      {
        \semio_viz_chem_record:n {##1}
        \fp_set:Nn \l_semio_viz_sci_a_fp
          {
            \l_semio_viz_chem_side_fp
            * ( \semio_viz_chem_field:n { 2 } + ( 1 - \semio_viz_chem_field:n { 1 }
                - \semio_viz_chem_field:n { 2 } ) / 2 )
          }
        \fp_set:Nn \l_semio_viz_sci_b_fp
          {
            \l_semio_viz_chem_side_fp * sqrt (3) / 2
            * ( 1 - \semio_viz_chem_field:n { 1 } - \semio_viz_chem_field:n { 2 } )
          }
        \fill [ fill=semio-primary ]
          ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } )
          circle [ radius=1 ] ;
      }
  }

