\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-scientific-chemistry}[2026/09/05 v0.2.0 semio viz namespace scientific-chemistry families]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-scientific-field}

\ExplSyntaxOn

%region 🔖️Parsing
\cs_generate_variant:Nn \seq_set_split:Nnn { Nnx }
\cs_generate_variant:Nn \prop_put:Nnn { Nxx }
\cs_generate_variant:Nn \prop_item:Nn { Ne }
\tl_new:N \l_semio_viz_chem_key_tl
\seq_new:N \l_semio_viz_chem_rec_seq
% ✂️ Splits one slash-separated record #1 into the shared field sequence.
\cs_new_protected:Npn \semio_viz_chem_record:n #1
  { \seq_set_split:Nnx \l_semio_viz_chem_rec_seq { / } {#1} }
% 🔢 Expands to field #1 of the record most recently split.
\cs_new:Npn \semio_viz_chem_field:n #1
  { \seq_item:Nn \l_semio_viz_chem_rec_seq {#1} }
%endregion 🔖️Parsing

%region 🔖️Families

%region 🔖️Keys
% 🔑 Keys of `sci-molecule` (§33 structural formulae):
%    mode (skeletal|lewis|reaction, skeletal).
%    atoms (clist of `id/x/y/element`): an empty element is an implicit carbon vertex.
%    bonds (clist of `from/to/order/style`): order 1–3, style plain, wedge, dash, aromatic.
%    lonePairs (clist of `atom/count`): the Lewis dots drawn around an atom.
%    arrow (clist of `x1/y1/x2/y2/label`): the reaction arrow of the reaction mode.
%    bondGap (fp, 0.7): the offset of the second and third bond lines in millimetres.
\tl_new:N \l_semio_viz_chem_mode_tl
\clist_new:N \l_semio_viz_chem_atoms_clist
\clist_new:N \l_semio_viz_chem_bonds_clist
\clist_new:N \l_semio_viz_chem_pairs_clist
\clist_new:N \l_semio_viz_chem_arrow_clist
\fp_new:N \l_semio_viz_chem_gap_fp
\prop_new:N \l_semio_viz_chem_ax_prop
\prop_new:N \l_semio_viz_chem_ay_prop
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-molecule }
% 🧪 Binds the `sci-molecule` option names onto the atom, bond, lone-pair and reaction-arrow lists and the multiple-bond gap.
\keys_define:nn { semio / viz / family / sci-molecule }
  {
    mode      .tl_set:N    = \l_semio_viz_chem_mode_tl ,
    atoms     .clist_set:N = \l_semio_viz_chem_atoms_clist ,
    bonds     .clist_set:N = \l_semio_viz_chem_bonds_clist ,
    lonePairs .clist_set:N = \l_semio_viz_chem_pairs_clist ,
    arrow     .clist_set:N = \l_semio_viz_chem_arrow_clist ,
    bondGap   .fp_set:N    = \l_semio_viz_chem_gap_fp ,
  }

% ⚗️ §33 structural formulae: skeletal and Lewis structures and reaction schemes, drawn from an atom and bond table.
\SemioVizFamily { sci-molecule }
  {
    \semio_viz_sci_enter:nnn { sci-molecule }
      {
        mode=skeletal , bondGap=0.7 , axes=false , grid=false ,
        atoms={ a1/0/0/ , a2/7/4/ , a3/14/0/ , a4/21/4/ , a5/28/0/O , a6/14/-8/N } ,
        bonds={ a1/a2/1/plain , a2/a3/2/plain , a3/a4/1/plain , a4/a5/2/plain , a3/a6/1/wedge } ,
        lonePairs={ a5/2 , a6/1 } ,
        arrow={ 34/0/48/0/Δ }
      }
      {#1}
    \prop_clear:N \l_semio_viz_chem_ax_prop
    \prop_clear:N \l_semio_viz_chem_ay_prop
    \clist_map_inline:Nn \l_semio_viz_chem_atoms_clist
      {
        \semio_viz_chem_record:n {##1}
        \prop_put:Nxx \l_semio_viz_chem_ax_prop
          { \semio_viz_chem_field:n { 1 } } { \semio_viz_chem_field:n { 2 } }
        \prop_put:Nxx \l_semio_viz_chem_ay_prop
          { \semio_viz_chem_field:n { 1 } } { \semio_viz_chem_field:n { 3 } }
      }
    \clist_map_inline:Nn \l_semio_viz_chem_bonds_clist
      {
        \semio_viz_chem_record:n {##1}
        \semio_viz_chem_bond:
      }
    \clist_map_inline:Nn \l_semio_viz_chem_atoms_clist
      {
        \semio_viz_chem_record:n {##1}
        \tl_set:Nx \l_semio_viz_chem_key_tl { \semio_viz_chem_field:n { 4 } }
        \tl_if_empty:NF \l_semio_viz_chem_key_tl
          {
            \node [ font=\c_semio_viz_theme_font_title_tl , text=semio-chrome-foreground ,
                    fill=semio-chrome-base , inner~sep=0.5mm ]
              at ( \semio_viz_chem_field:n { 2 } , \semio_viz_chem_field:n { 3 } )
              { \tl_use:N \l_semio_viz_chem_key_tl } ;
          }
      }
    \str_if_eq:VnT \l_semio_viz_chem_mode_tl { lewis } { \semio_viz_chem_pairs: }
    \str_if_eq:VnT \l_semio_viz_chem_mode_tl { reaction } { \semio_viz_chem_arrow: }
  }
% 🔗 Looks up the two atoms of the pending bond record and draws it as a solid wedge, a widening hash ladder, or plain parallel lines, then reports its endpoints and order.
\cs_new_protected:Npn \semio_viz_chem_bond:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \prop_item:Ne \l_semio_viz_chem_ax_prop { \semio_viz_chem_field:n { 1 } } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \prop_item:Ne \l_semio_viz_chem_ay_prop { \semio_viz_chem_field:n { 1 } } }
    \fp_set:Nn \l_semio_viz_sci_c_fp
      { \prop_item:Ne \l_semio_viz_chem_ax_prop { \semio_viz_chem_field:n { 2 } } }
    \fp_set:Nn \l_semio_viz_sci_d_fp
      { \prop_item:Ne \l_semio_viz_chem_ay_prop { \semio_viz_chem_field:n { 2 } } }
    \fp_set:Nn \l_semio_viz_sci_e_fp
      {
        atand ( \l_semio_viz_sci_d_fp - \l_semio_viz_sci_b_fp ,
                \l_semio_viz_sci_c_fp - \l_semio_viz_sci_a_fp ) + 90
      }
    \tl_set:Nx \l_semio_viz_chem_key_tl { \semio_viz_chem_field:n { 4 } }
    \str_case:VnF \l_semio_viz_chem_key_tl
      {
        { wedge }
          {
            \fill [ fill=semio-chrome-foreground ]
              ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
              ( \fp_eval:n { \l_semio_viz_sci_c_fp + 1.1 * cosd ( \l_semio_viz_sci_e_fp ) } ,
                \fp_eval:n { \l_semio_viz_sci_d_fp + 1.1 * sind ( \l_semio_viz_sci_e_fp ) } ) --
              ( \fp_eval:n { \l_semio_viz_sci_c_fp - 1.1 * cosd ( \l_semio_viz_sci_e_fp ) } ,
                \fp_eval:n { \l_semio_viz_sci_d_fp - 1.1 * sind ( \l_semio_viz_sci_e_fp ) } ) -- cycle ;
          }
        { dash }
          {
            \int_step_inline:nnnn { 1 } { 1 } { 5 }
              {
                \draw [ semio~sci~thin ]
                  ( \fp_eval:n { \l_semio_viz_sci_a_fp
                      + ( \l_semio_viz_sci_c_fp - \l_semio_viz_sci_a_fp ) * ##1 / 5
                      + 0.24 * ##1 * cosd ( \l_semio_viz_sci_e_fp ) } ,
                    \fp_eval:n { \l_semio_viz_sci_b_fp
                      + ( \l_semio_viz_sci_d_fp - \l_semio_viz_sci_b_fp ) * ##1 / 5
                      + 0.24 * ##1 * sind ( \l_semio_viz_sci_e_fp ) } ) --
                  ( \fp_eval:n { \l_semio_viz_sci_a_fp
                      + ( \l_semio_viz_sci_c_fp - \l_semio_viz_sci_a_fp ) * ##1 / 5
                      - 0.24 * ##1 * cosd ( \l_semio_viz_sci_e_fp ) } ,
                    \fp_eval:n { \l_semio_viz_sci_b_fp
                      + ( \l_semio_viz_sci_d_fp - \l_semio_viz_sci_b_fp ) * ##1 / 5
                      - 0.24 * ##1 * sind ( \l_semio_viz_sci_e_fp ) } ) ;
              }
          }
      }
      { \semio_viz_chem_bond_lines: }
    \semio_viz_sci_report_values:nn { molecule/bond }
      { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp ,
        \fp_to_decimal:N \l_semio_viz_sci_c_fp , \fp_to_decimal:N \l_semio_viz_sci_d_fp ,
        \semio_viz_chem_field:n { 3 } }
  }
% ⏸️ Strokes as many parallel bond lines as the bond order, spread symmetrically about the atom-to-atom axis by the configured gap.
\cs_new_protected:Npn \semio_viz_chem_bond_lines:
  {
    \int_set:Nn \l_tmpa_int { \semio_viz_chem_field:n { 3 } }
    \int_step_inline:nnnn { 1 } { 1 } { \l_tmpa_int }
      {
        \fp_set:Nn \l_semio_viz_sci_f_fp
          { \l_semio_viz_chem_gap_fp * ( ##1 - ( \l_tmpa_int + 1 ) / 2 ) * 2 }
        \draw [ semio~sci~thin ]
          ( \fp_eval:n { \l_semio_viz_sci_a_fp + \l_semio_viz_sci_f_fp * cosd ( \l_semio_viz_sci_e_fp ) } ,
            \fp_eval:n { \l_semio_viz_sci_b_fp + \l_semio_viz_sci_f_fp * sind ( \l_semio_viz_sci_e_fp ) } ) --
          ( \fp_eval:n { \l_semio_viz_sci_c_fp + \l_semio_viz_sci_f_fp * cosd ( \l_semio_viz_sci_e_fp ) } ,
            \fp_eval:n { \l_semio_viz_sci_d_fp + \l_semio_viz_sci_f_fp * sind ( \l_semio_viz_sci_e_fp ) } ) ;
      }
  }
% 👥 Looks up each lone-pair owner's position and draws the requested number of pairs around it.
\cs_new_protected:Npn \semio_viz_chem_pairs:
  {
    \clist_map_inline:Nn \l_semio_viz_chem_pairs_clist
      {
        \semio_viz_chem_record:n {##1}
        \fp_set:Nn \l_semio_viz_sci_a_fp
          { \prop_item:Ne \l_semio_viz_chem_ax_prop { \semio_viz_chem_field:n { 1 } } }
        \fp_set:Nn \l_semio_viz_sci_b_fp
          { \prop_item:Ne \l_semio_viz_chem_ay_prop { \semio_viz_chem_field:n { 1 } } }
        \int_step_inline:nnnn { 1 } { 1 } { \semio_viz_chem_field:n { 2 } }
          { \semio_viz_chem_pair:n {####1} }
      }
  }
% ⚫ Places one Lewis pair as two small dots on side #1 of the current atom, offset perpendicular to that direction.
\cs_new_protected:Npn \semio_viz_chem_pair:n #1
  {
    \int_step_inline:nnnn { -1 } { 2 } { 1 }
      {
        \fill [ fill=semio-chrome-foreground ]
          ( \fp_eval:n { \l_semio_viz_sci_a_fp + 2.6 * cosd ( 90 * (#1) ) + 0.7 * ##1 * cosd ( 90 * (#1) + 90 ) } ,
            \fp_eval:n { \l_semio_viz_sci_b_fp + 2.6 * sind ( 90 * (#1) ) + 0.7 * ##1 * sind ( 90 * (#1) + 90 ) } )
          circle [ radius=0.32 ] ;
      }
  }
% ➡️ Draws each reaction arrow between its two endpoints with the condition text set above the shaft.
\cs_new_protected:Npn \semio_viz_chem_arrow:
  {
    \clist_map_inline:Nn \l_semio_viz_chem_arrow_clist
      {
        \semio_viz_chem_record:n {##1}
        \draw [ semio~sci~arrow ]
          ( \semio_viz_chem_field:n { 1 } , \semio_viz_chem_field:n { 2 } ) --
          node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , above ]
            { \semio_viz_chem_field:n { 5 } }
          ( \semio_viz_chem_field:n { 3 } , \semio_viz_chem_field:n { 4 } ) ;
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-energy-profile` (§33 reaction coordinate):
%    states (clist of `coordinate/energy/label`): minima and maxima along the reaction coordinate.
%    smooth (bool, true): interpolate the profile with a cosine ramp between consecutive states.
%    labels (bool, true), barriers (bool, true): print state labels and the activation barriers.
\clist_new:N \l_semio_viz_chem_states_clist
\bool_new:N \l_semio_viz_chem_smooth_bool
\bool_new:N \l_semio_viz_chem_labels_bool
\bool_new:N \l_semio_viz_chem_barriers_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-energy-profile }
% 🎢 Binds the `sci-energy-profile` option names onto the stationary-point list and the smoothing, labelling and barrier switches.
\keys_define:nn { semio / viz / family / sci-energy-profile }
  {
    states   .clist_set:N = \l_semio_viz_chem_states_clist ,
    smooth   .bool_set:N  = \l_semio_viz_chem_smooth_bool ,
    labels   .bool_set:N  = \l_semio_viz_chem_labels_bool ,
    barriers .bool_set:N  = \l_semio_viz_chem_barriers_bool ,
  }

% ⚗️ §33 reaction coordinate: the energy profile interpolated between its stationary points, with the activation barrier measured.
\SemioVizFamily { sci-energy-profile }
  {
    \semio_viz_sci_enter:nnn { sci-energy-profile }
      {
        smooth=true , labels=true , barriers=true , domain={} , range={} ,
        states={ 0/0/R , 1.4/62/TS1 , 2.6/18/I , 3.8/44/TS2 , 5/-24/P }
      }
      {#1}
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \clist_map_inline:Nn \l_semio_viz_chem_states_clist
      {
        \semio_viz_chem_record:n {##1}
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \semio_viz_chem_field:n { 1 } } { \semio_viz_chem_field:n { 2 } }
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.1 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \bool_if:NTF \l_semio_viz_chem_smooth_bool
      { \semio_viz_chem_profile_smooth: }
      { \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve } }
    \bool_if:NT \l_semio_viz_chem_labels_bool
      {
        \clist_map_inline:Nn \l_semio_viz_chem_states_clist
          {
            \semio_viz_chem_record:n {##1}
            \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=south ]
              at ( \semio_viz_sci_mx:n { \semio_viz_chem_field:n { 1 } } ,
                   \fp_eval:n { \semio_viz_sci_my:n { \semio_viz_chem_field:n { 2 } } + 1 } )
              { \semio_viz_chem_field:n { 3 } } ;
          }
      }
    \bool_if:NT \l_semio_viz_chem_barriers_bool { \semio_viz_chem_barrier: }
  }
% 🪶 Rebuilds the profile as a dense point sequence by ramping every consecutive pair of states, then strokes it as one curve.
\cs_new_protected:Npn \semio_viz_chem_profile_smooth:
  {
    \seq_clear:N \l_semio_viz_sci_pts_b_seq
    \int_step_inline:nnnn { 1 } { 1 } { \seq_count:N \l_semio_viz_sci_pts_seq - 1 }
      { \semio_viz_chem_profile_segment:n {##1} }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq { semio~sci~curve }
  }
% 🌗 Emits twenty samples between state #1 and its successor, linear in the reaction coordinate and cosine-eased in energy.
\cs_new_protected:Npn \semio_viz_chem_profile_segment:n #1
  {
    \int_step_inline:nnnn { 0 } { 1 } { 20 }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq
          {
            \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq {#1} }
            + ( \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { #1 + 1 } }
              - \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq {#1} } ) * ##1 / 20
          }
          {
            \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq {#1} }
            + ( \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { #1 + 1 } }
              - \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq {#1} } )
              * ( 1 - cos ( pi * ##1 / 20 ) ) / 2
          }
      }
  }
% 📊 Measures the first activation barrier as a vertical rule from the reactant energy up to the first transition state and reports its height.
\cs_new_protected:Npn \semio_viz_chem_barrier:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { 1 } } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { 2 } } }
    \draw [ semio~sci~aux , draw=semio-secondary ]
      ( \semio_viz_sci_mx:n { \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { 2 } } } ,
        \semio_viz_sci_my:n { \l_semio_viz_sci_a_fp } ) --
      ( \semio_viz_sci_mx:n { \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { 2 } } } ,
        \semio_viz_sci_my:n { \l_semio_viz_sci_b_fp } ) ;
    \semio_viz_sci_report_values:nn { profile/barrier }
      { \fp_to_decimal:n { \l_semio_viz_sci_b_fp - \l_semio_viz_sci_a_fp } }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-orbital` (§33 electronic structure):
%    mode (molecular-orbital|configuration|orbital, molecular-orbital).
%    levels (clist of `side/energy/label/electrons`): side -1 left fragment, 0 molecular, 1 right fragment.
%    shells (clist of `label/electrons/capacity`): the configuration boxes.
%    lobes (int, 2): lobe count of the sketched orbital.
\clist_new:N \l_semio_viz_chem_levels_clist
\clist_new:N \l_semio_viz_chem_shells_clist
\int_new:N \l_semio_viz_chem_lobes_int
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-orbital }
% 🌀 Binds the `sci-orbital` option names onto the correlation-level list, the configuration shells and the lobe count.
\keys_define:nn { semio / viz / family / sci-orbital }
  {
    mode   .tl_set:N    = \l_semio_viz_chem_mode_tl ,
    levels .clist_set:N = \l_semio_viz_chem_levels_clist ,
    shells .clist_set:N = \l_semio_viz_chem_shells_clist ,
    lobes  .int_set:N   = \l_semio_viz_chem_lobes_int ,
  }

% ⚛️ §33 electronic structure: molecular-orbital correlation diagrams, electron configurations and sketched orbital lobes.
\SemioVizFamily { sci-orbital }
  {
    \semio_viz_sci_enter:nnn { sci-orbital }
      {
        mode=molecular-orbital , lobes=2 , domain={-1,1} , range={-8,8} , axes=false , grid=false ,
        levels={ -1/-2/1s/1 , 1/-2/1s/1 , 0/-5/σ/2 , 0/4/σ*/0 } ,
        shells={ 1s/2/2 , 2s/2/2 , 2p/4/6 , 3s/1/2 }
      }
      {#1}
    \str_case:VnF \l_semio_viz_chem_mode_tl
      {
        { configuration } { \semio_viz_chem_configuration: }
        { orbital }       { \semio_viz_chem_lobes: }
      }
      { \semio_viz_chem_mo: }
  }
% 🪟 Draws the correlation diagram: each level as a short rung in its own column (left fragment, molecular, right fragment), captioned and filled with its electrons.
\cs_new_protected:Npn \semio_viz_chem_mo:
  {
    \semio_viz_sci_window_keys:
    \clist_map_inline:Nn \l_semio_viz_chem_levels_clist
      {
        \semio_viz_chem_record:n {##1}
        \fp_set:Nn \l_semio_viz_sci_a_fp
          { ( \semio_viz_chem_field:n { 1 } + 1 ) * \l_semio_viz_sci_w_fp / 2 }
        \draw [ semio~sci~curve ]
          ( \fp_eval:n { \l_semio_viz_sci_a_fp - 6 } ,
            \semio_viz_sci_my:n { \semio_viz_chem_field:n { 2 } } ) --
          ( \fp_eval:n { \l_semio_viz_sci_a_fp + 6 } ,
            \semio_viz_sci_my:n { \semio_viz_chem_field:n { 2 } } ) ;
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=south ]
          at ( \fp_eval:n { \l_semio_viz_sci_a_fp } ,
               \fp_eval:n { \semio_viz_sci_my:n { \semio_viz_chem_field:n { 2 } } + 0.6 } )
          { \semio_viz_chem_field:n { 3 } } ;
        \semio_viz_chem_electrons:
      }
  }
% ⬆️ Draws one spin arrow per electron occupying the current level, spaced left and right of its centre.
\cs_new_protected:Npn \semio_viz_chem_electrons:
  {
    \int_step_inline:nnnn { 1 } { 1 } { \semio_viz_chem_field:n { 4 } }
      {
        \draw [ semio~sci~arrow ]
          ( \fp_eval:n { \l_semio_viz_sci_a_fp + ( 2 * ##1 - 3 ) * 1.6 } ,
            \fp_eval:n { \semio_viz_sci_my:n { \semio_viz_chem_field:n { 2 } } - 1.6 } ) --
          ( \fp_eval:n { \l_semio_viz_sci_a_fp + ( 2 * ##1 - 3 ) * 1.6 } ,
            \fp_eval:n { \semio_viz_sci_my:n { \semio_viz_chem_field:n { 2 } } + 1.6 } ) ;
      }
  }
% 📚 Stacks the shells downwards, naming each on the left and drawing one orbital box per pair of its capacity.
\cs_new_protected:Npn \semio_viz_chem_configuration:
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_chem_shells_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_chem_record:n {##1}
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=east ]
          at ( -1 , \fp_eval:n { - \l_tmpa_int * 7 } ) { \semio_viz_chem_field:n { 1 } } ;
        \int_step_inline:nnnn { 1 } { 1 } { \semio_viz_chem_field:n { 3 } / 2 }
          { \semio_viz_chem_orbital_box:n {####1} }
      }
  }
% 🔲 Draws orbital box #1 of the current shell and fills it with up to two opposed spin arrows, as far as the shell's electron count reaches.
\cs_new_protected:Npn \semio_viz_chem_orbital_box:n #1
  {
    \draw [ semio~sci~box ]
      ( \fp_eval:n { ( #1 - 1 ) * 6 } , \fp_eval:n { - \l_tmpa_int * 7 - 2.4 } ) rectangle
      ( \fp_eval:n { #1 * 6 - 1 } , \fp_eval:n { - \l_tmpa_int * 7 + 2.4 } ) ;
    \int_step_inline:nnnn { 1 } { 1 } { 2 }
      {
        \int_compare:nNnT { 2 * ( #1 - 1 ) + ##1 } < { \semio_viz_chem_field:n { 2 } + 1 }
          {
            \draw [ semio~sci~arrow ]
              ( \fp_eval:n { ( #1 - 1 ) * 6 + 1.4 + 2.2 * ( ##1 - 1 ) } ,
                \fp_eval:n { - \l_tmpa_int * 7 + ( ##1 == 1 ? -1.8 : 1.8 ) } ) --
              ( \fp_eval:n { ( #1 - 1 ) * 6 + 1.4 + 2.2 * ( ##1 - 1 ) } ,
                \fp_eval:n { - \l_tmpa_int * 7 + ( ##1 == 1 ? 1.8 : -1.8 ) } ) ;
          }
      }
  }
% 🎈 Sketches an orbital as translucent hue-cycled teardrop lobes fanned evenly about the nucleus dot.
\cs_new_protected:Npn \semio_viz_chem_lobes:
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_chem_lobes_int - 1 }
      {
        \fill [ fill=\semio_viz_sci_hue:n { ##1 + 1 } , fill~opacity=0.35 ,
                rotate=\fp_eval:n { 360 * ##1 / \l_semio_viz_chem_lobes_int } ]
          ( 0 , 0 ) .. controls ( 12 , 9 ) and ( 12 , -9 ) .. ( 0 , 0 ) ;
      }
    \fill [ fill=semio-chrome-foreground ] ( 0 , 0 ) circle [ radius=0.8 ] ;
  }

