        \clist_map_inline:Nn \l_semio_viz_chem_points_clist
          {
            \semio_viz_chem_record:n {##1}
            \semio_viz_sci_dot:nnn { \semio_viz_chem_field:n { 1 } } { \semio_viz_chem_field:n { 2 } }
              { semio-primary }
            \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=south~west ]
