    \int_incr:N \l_semio_viz_layout_index_int
    \prop_put:Nnx \l_semio_viz_layout_row_prop {##1}
      {\clist_item:Nn \l_semio_viz_layout_cells_clist {\l_semio_viz_layout_index_int}}
  }
}
