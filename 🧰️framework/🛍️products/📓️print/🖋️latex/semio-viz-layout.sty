\cs_new_protected:Npn \semio_viz_layout_validate_option:nn #1#2 {
  \clist_if_in:NnF \l_semio_viz_layout_allowed_clist {#1}
    {\msg_fatal:nnn {semio-viz} {authored-layout-option} {#1}}
}
\cs_new_protected:Npn \semio_viz_layout_validate_flag:n #1 {\semio_viz_layout_validate_option:nn {#1} {true}}
\cs_new_protected:Npn \semio_viz_layout_validate:nn #1#2 {
  \clist_set:Nx \l_semio_viz_layout_allowed_clist {width,height,\prop_item:Nn \l_semio_viz_layout_vocabulary_prop {#1}}
  \keyval_parse:NNn \semio_viz_layout_validate_flag:n \semio_viz_layout_validate_option:nn {#2}
}
\cs_new_protected:Npn \semio_viz_layout_positive:n #1 {
  \fp_compare:nNnF {\semio_viz_layout_option:n {#1}} > {0}
    {\msg_fatal:nnn {semio-viz} {authored-layout-control} {#1}}
}
\cs_new_protected:Npn \semio_viz_layout_column:n #1 {
  \clist_if_in:NeF \l_semio_viz_layout_cols_clist {\semio_viz_layout_option:n {#1}}
    {\msg_fatal:nnn {semio-viz} {authored-layout-column} {#1}}
}
