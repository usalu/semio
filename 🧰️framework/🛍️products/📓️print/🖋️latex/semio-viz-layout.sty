\ExplSyntaxOn
\cs_if_exist:NF \clist_if_in:NeF {\prg_generate_conditional_variant:Nnn \clist_if_in:Nn {Ne} {T,F,TF}}

%region 🔖️Diagnostics
\msg_new:nnn { semio-viz } { unknown-layout }
  { Unknown~viz~layout~algorithm~'#1'.~Registered:~#2. }
\msg_new:nnn { semio-viz } { duplicate-layout }
  { Viz~layout~algorithm~'#1'~is~already~registered. }
%endregion 🔖️Diagnostics

%region 🔖️Registry
% 🗂️ One flat namespace of layout algorithms (taxonomy 75 and 78). Every domain kernel --
% hierarchy, network, flow, geo, spatial and the transform kernel -- registers its own
% algorithms here, so a caller never needs to know which package implements one.
\seq_new:N \g_semio_viz_layout_names_seq

% 📝 Registers algorithm #1; inside #2 the arguments are `#1` input, `#2` output, `#3` options.
\cs_new_protected:Npn \semio_viz_layout_define:nn #1#2 {
  \seq_if_in:NnTF \g_semio_viz_layout_names_seq {#1}
    { \msg_error:nnn { semio-viz } { duplicate-layout } {#1} }
    {
      \seq_gput_right:Nn \g_semio_viz_layout_names_seq {#1}
      \cs_gset_protected:cpn { semio_viz_layout_ \tl_to_str:n {#1} :nnn } ##1##2##3 {#2}
    }
}

% ❓ True when #1 names a registered algorithm.
\prg_new_protected_conditional:Npnn \semio_viz_layout_exist:n #1 { T, F, TF } {
  \seq_if_in:NnTF \g_semio_viz_layout_names_seq {#1}
    { \prg_return_true: } { \prg_return_false: }
}

% ▶️ Runs algorithm #1 over input table or structure #2 into output #3 with option list #4.
\cs_new_protected:Npn \semio_viz_layout_run:nnnn #1#2#3#4 {
  \cs_if_exist:cTF { semio_viz_layout_table_#1:nnn }
    {
      \seq_if_in:NnTF \g_semio_viz_table_names_seq {#2}
        { \semio_viz_layout_validate:nn {#1} {#4} \use:c { semio_viz_layout_table_#1:nnn } {#2} {#3} {#4} }
        { \semio_viz_layout_structure:nnnn {#1} {#2} {#3} {#4} }
    }
    { \semio_viz_layout_structure:nnnn {#1} {#2} {#3} {#4} }
}
\cs_new_protected:Npn \semio_viz_layout_structure:nnnn #1#2#3#4 {
  \seq_if_in:NnTF \g_semio_viz_layout_names_seq {#1}
    { \use:c { semio_viz_layout_ \tl_to_str:n {#1} :nnn } {#2} {#3} {#4} }
    {
      \msg_error:nnnn { semio-viz } { unknown-layout } {#1}
        { \seq_use:Nnnn \g_semio_viz_layout_names_seq { ,~ } { ,~ } { ,~ } }
    }
}
\cs_generate_variant:Nn \semio_viz_layout_run:nnnn { nVnV , VVnV , nnnV , VnnV }
\cs_generate_variant:Nn \semio_viz_layout_structure:nnnn { nVnV , VVnV }
%endregion 🔖️Registry

