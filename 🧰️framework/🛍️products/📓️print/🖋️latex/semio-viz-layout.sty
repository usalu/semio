\cs_new_protected:Npn \semio_viz_layout_table_load:nn #1#2 {
  \semio_viz_table_require:n {#1}
  \clist_set_eq:Nc \l_semio_viz_layout_cols_clist {g_semio_viz_table_\l_semio_viz_tab_tl _cols_clist}
  \seq_set_eq:Nc \l_semio_viz_layout_rows_seq {g_semio_viz_table_\l_semio_viz_tab_tl _rows_seq}
  \clist_set_eq:NN \l_semio_viz_layout_output_cols_clist \l_semio_viz_layout_cols_clist
  \seq_clear:N \l_semio_viz_layout_output_seq
  \prop_clear:N \l_semio_viz_layout_options_prop
  \keyval_parse:NNn \semio_viz_layout_flag:n \semio_viz_layout_option:nn
    {width=80,height=40,x=x,y=y,value=value,id=id,parent=parent,source=source,target=target,sort=none,leaves=false,output={}}
  \keyval_parse:NNn \semio_viz_layout_flag:n \semio_viz_layout_option:nn {#2}
  \semio_viz_layout_positive:n {width}
  \semio_viz_layout_positive:n {height}
}
