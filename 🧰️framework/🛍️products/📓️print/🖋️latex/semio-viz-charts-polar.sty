% 🧭 Centre and outer radius of the current frame.
\cs_new_protected:Npn \semio_viz_pol_centre: {
  \fp_set:Nn \l_semio_viz_pol_cx_fp { ( \l_semio_viz_cb_xa_fp + \l_semio_viz_cb_xb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_pol_cy_fp { ( \l_semio_viz_cb_ya_fp + \l_semio_viz_cb_yb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_pol_r_fp
    {
      min ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp ,
            \l_semio_viz_cb_yb_fp - \l_semio_viz_cb_ya_fp ) / 2
    }
}

% 📍 Cartesian x of a polar point (angle in radians, zero at twelve o'clock, clockwise).
\cs_new:Npn \semio_viz_pol_x:nn #1#2 {
  \fp_eval:n { \l_semio_viz_pol_cx_fp + (#2) * sin (#1) }
}

% 📍 Cartesian y of a polar point.
\cs_new:Npn \semio_viz_pol_y:nn #1#2 {
  \fp_eval:n { \l_semio_viz_pol_cy_fp + (#2) * cos (#1) }
}
%endregion 🔖️Radial

%region 🔖️Families
% 🥧 Pie and donut: d3-shape pie angles rendered as annular sectors, exploded, nested or as a gauge.
\SemioVizFamily { pie } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-parts }
  \tl_set:Nn \l_semio_viz_cb_value_tl { share }
  \tl_set:Nn \l_semio_viz_cb_label_tl { part }
  \fp_zero:N \l_semio_viz_piechart_inner_fp
  \fp_zero:N \l_semio_viz_piechart_outer_fp
  \fp_zero:N \l_semio_viz_piechart_start_fp
  \fp_set:Nn \l_semio_viz_piechart_end_fp { 2 * pi }
  \fp_zero:N \l_semio_viz_piechart_pad_fp
  \tl_set:Nn \l_semio_viz_piechart_sort_tl { descending }
  \fp_zero:N \l_semio_viz_piechart_explode_fp
  \int_set:Nn \l_semio_viz_piechart_rings_int { 1 }
  \bool_set_false:N \l_semio_viz_piechart_gauge_bool
  \bool_set_false:N \l_semio_viz_piechart_labels_bool
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / pie } {#1}
  \semio_viz_cb_frame:
  \semio_viz_pol_centre:
  \semio_viz_pie_render:
}

% 🥧 Runs the pie family once its keys are set.
\cs_new_protected:Npn \semio_viz_pie_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_cb_value_tl }
  \semio_viz_tr_stat_labels_from_table:Nnn \l_semio_viz_pol_labels_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_cb_label_tl }
  \fp_compare:nT { \l_semio_viz_piechart_outer_fp <= 0 }
    { \fp_set_eq:NN \l_semio_viz_piechart_outer_fp \l_semio_viz_pol_r_fp }
  \bool_if:NTF \l_semio_viz_piechart_gauge_bool
    { \semio_viz_pie_gauge: }
    { \semio_viz_pie_rings: }
}

% 🥧 Concentric pie rings; ring #1 shrinks the radius band by the ring count.
\cs_new_protected:Npn \semio_viz_pie_rings: {
  \int_step_inline:nn { \l_semio_viz_piechart_rings_int } {
    \semio_viz_pie_from_seq:Nnnnn \l_semio_viz_pol_values_seq
      { \l_semio_viz_piechart_start_fp + ( ##1 - 1 ) * 0.35 }
      { \l_semio_viz_piechart_end_fp } { \l_semio_viz_piechart_pad_fp } { \l_semio_viz_piechart_sort_tl }
    \fp_set:Nn \l_semio_viz_cb_a_fp
      {
        \l_semio_viz_piechart_outer_fp
        * ( \l_semio_viz_piechart_inner_fp
            + ( 1 - \l_semio_viz_piechart_inner_fp ) * ( ##1 - 1 ) / \l_semio_viz_piechart_rings_int )
      }
    \fp_set:Nn \l_semio_viz_cb_b_fp
      {
        \l_semio_viz_piechart_outer_fp
        * ( \l_semio_viz_piechart_inner_fp
            + ( 1 - \l_semio_viz_piechart_inner_fp ) * ##1 / \l_semio_viz_piechart_rings_int )
      }
    \semio_viz_pie_slices:nnn { \l_semio_viz_cb_a_fp } { \l_semio_viz_cb_b_fp } {##1}
  }
}

% 🥧 One ring of slices between the inner radius #1 and the outer radius #2 of ring #3.
\cs_new_protected:Npn \semio_viz_pie_slices:nnn #1#2#3 {
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \g_semio_viz_pie_start_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp
      { ( ##1 + \seq_item:Nn \g_semio_viz_pie_end_seq { \l_semio_viz_cb_j_int } ) / 2 }
    \semio_viz_g_arc:nnnnnnn
      { \l_semio_viz_pol_cx_fp + \l_semio_viz_piechart_explode_fp * sin ( \l_semio_viz_cb_t_fp ) }
      { \l_semio_viz_pol_cy_fp + \l_semio_viz_piechart_explode_fp * cos ( \l_semio_viz_cb_t_fp ) }
      {#1} {#2} {##1} { \seq_item:Nn \g_semio_viz_pie_end_seq { \l_semio_viz_cb_j_int } }
      { fill = \semio_viz_palette:n { \l_semio_viz_cb_j_int + (#3) - 1 } ,
        draw = semio-chrome-canvas , line~width = \semio@stroke@hairline }
    \bool_if:NT \l_semio_viz_piechart_labels_bool {
      \semio_viz_g_text:nnnn
        { \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { (#2) + 2 } }
        { \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { (#2) + 2 } } { center }
        { \seq_item:Nn \l_semio_viz_pol_labels_seq { \l_semio_viz_cb_j_int } }
    }
  }
}

% 🎛️ Gauge donut: the first value as a filled arc over a muted track.
\cs_new_protected:Npn \semio_viz_pie_gauge: {
  \semio_viz_tr_stat_sum:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_c_fp
  \fp_compare:nT { \l_semio_viz_cb_c_fp <= 0 } { \fp_set:Nn \l_semio_viz_cb_c_fp { 1 } }
  \fp_set:Nn \l_semio_viz_cb_a_fp
    { \l_semio_viz_piechart_outer_fp * max ( 0.05 , \l_semio_viz_piechart_inner_fp ) }
  \semio_viz_g_arc:nnnnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
    { \l_semio_viz_cb_a_fp } { \l_semio_viz_piechart_outer_fp }
    { \l_semio_viz_piechart_start_fp } { \l_semio_viz_piechart_end_fp }
    { fill = semio-chrome-panel , draw = none }
  \fp_set:Nn \l_semio_viz_cb_b_fp
    {
      \l_semio_viz_piechart_start_fp
      + ( \l_semio_viz_piechart_end_fp - \l_semio_viz_piechart_start_fp )
        * \seq_item:Nn \l_semio_viz_pol_values_seq { 1 } / \l_semio_viz_cb_c_fp
    }
  \semio_viz_g_arc:nnnnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
    { \l_semio_viz_cb_a_fp } { \l_semio_viz_piechart_outer_fp }
    { \l_semio_viz_piechart_start_fp } { \l_semio_viz_cb_b_fp }
    { fill = \semio_viz_palette:n { 1 } , draw = none }
}

% 🌀 Polar: scatter, line, area, radial bar, stacked radial bar, radial heatmap and circumplex.
\SemioVizFamily { polar } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-direction }
  \tl_set:Nn \l_semio_viz_polar_mark_tl { scatter }
  \tl_set:Nn \l_semio_viz_polar_angle_tl { sector }
  \tl_set:Nn \l_semio_viz_polar_radius_tl { speed }
  \fp_set:Nn \l_semio_viz_polar_inner_fp { 0.15 }
  \fp_zero:N \l_semio_viz_polar_start_fp
  \fp_set:Nn \l_semio_viz_polar_end_fp { 2 * pi }
  \int_set:Nn \l_semio_viz_polar_rings_int { 4 }
  \bool_set_true:N \l_semio_viz_polar_grid_bool
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / polar } {#1}
  \semio_viz_cb_frame:
  \semio_viz_pol_centre:
  \semio_viz_polar_render:
}

% 🌀 Runs the polar family once its keys are set.
\cs_new_protected:Npn \semio_viz_polar_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_polar_radius_tl }
  \semio_viz_tr_stat_labels_from_table:Nnn \l_semio_viz_pol_labels_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_polar_angle_tl }
  \semio_viz_tr_stat_max:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_c_fp
  \fp_compare:nT { \l_semio_viz_cb_c_fp <= 0 } { \fp_set:Nn \l_semio_viz_cb_c_fp { 1 } }
  \bool_if:NT \l_semio_viz_polar_grid_bool { \semio_viz_polar_grid: }
  \int_set:Nn \l_semio_viz_cb_i_int { \seq_count:N \l_semio_viz_pol_values_seq }
  \str_case:VnF \l_semio_viz_polar_mark_tl
    {
      { line } { \semio_viz_polar_path:n { 0 } }
      { area } { \semio_viz_polar_path:n { 1 } }
      { bar } { \semio_viz_polar_bars:n { 0 } }
      { stacked-bar } { \semio_viz_polar_bars:n { 1 } }
      { heatmap } { \semio_viz_polar_cells: }
      { calendar } { \semio_viz_polar_cells: }
      { circumplex } { \semio_viz_polar_circumplex: }
    }
    { \semio_viz_polar_points: }
}

% 🕸️ Radial grid rings and spokes.
\cs_new_protected:Npn \semio_viz_polar_grid: {
  \int_step_inline:nn { \l_semio_viz_polar_rings_int } {
    \semio_viz_g_circle:nnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
      { \l_semio_viz_pol_r_fp * ##1 / \l_semio_viz_polar_rings_int }
      { draw = semio-chrome-border-normal , fill = none , line~width = \semio@stroke@hairline ,
        draw~opacity = 0.4 }
  }
}

% 📍 Radius in millimetres of a value, honouring the inner radius fraction.
\cs_new:Npn \semio_viz_polar_radius:n #1 {
  \fp_eval:n
    {
      \l_semio_viz_pol_r_fp
      * ( \l_semio_viz_polar_inner_fp
          + ( 1 - \l_semio_viz_polar_inner_fp ) * (#1) / \l_semio_viz_cb_c_fp )
    }
}

% 📐 Angle in radians of the one-based item #1.
\cs_new:Npn \semio_viz_polar_angle:n #1 {
  \fp_eval:n
    {
      \l_semio_viz_polar_start_fp
      + ( \l_semio_viz_polar_end_fp - \l_semio_viz_polar_start_fp )
        * ( (#1) - 1 ) / \l_semio_viz_cb_i_int
    }
}

% 🔵 Polar scatter points.
\cs_new_protected:Npn \semio_viz_polar_points: {
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp { \semio_viz_polar_angle:n { \l_semio_viz_cb_j_int } }
    \fp_set:Nn \l_semio_viz_cb_u_fp { \semio_viz_polar_radius:n {##1} }
    \semio_viz_g_circle:nnnn
      { \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } }
      { \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } }
      { 0.9 } { fill = \semio_viz_palette:n { 1 } , draw = none }
  }
}

% 〰️ Polar line (#1 = 0) or filled polar area (#1 = 1).
\cs_new_protected:Npn \semio_viz_polar_path:n #1 {
  \tl_clear:N \l_semio_viz_cb_points_tl
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp { \semio_viz_polar_angle:n { \l_semio_viz_cb_j_int } }
    \fp_set:Nn \l_semio_viz_cb_u_fp { \semio_viz_polar_radius:n {##1} }
    \tl_put_right:Nx \l_semio_viz_cb_points_tl
      {
        \tl_if_empty:NF \l_semio_viz_cb_points_tl { , }
        \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } ,
        \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
      }
  }
  \int_compare:nNnTF {#1} = { 1 }
    {
      \semio_viz_g_polygon:Vn \l_semio_viz_cb_points_tl
        { fill = \semio_viz_palette:n { 2 } , fill~opacity = 0.4 ,
          draw = \semio_viz_palette:n { 2 } , line~width = \semio@stroke@hairline }
    }
    {
      \semio_viz_g_polygon:Vn \l_semio_viz_cb_points_tl
        { fill = none , draw = \semio_viz_palette:n { 2 } , line~width = \semio@stroke@default }
    }
}

% 📊 Radial bars; #1 = 1 stacks the value on an inner base ring.
\cs_new_protected:Npn \semio_viz_polar_bars:n #1 {
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp { \semio_viz_polar_angle:n { \l_semio_viz_cb_j_int } }
    \fp_set:Nn \l_semio_viz_cb_u_fp { \semio_viz_polar_angle:n { \l_semio_viz_cb_j_int + 1 } }
    \fp_set:Nn \l_semio_viz_cb_a_fp
      { \l_semio_viz_pol_r_fp * \l_semio_viz_polar_inner_fp }
    \fp_set:Nn \l_semio_viz_cb_b_fp { \semio_viz_polar_radius:n {##1} }
    \int_compare:nNnT {#1} = { 1 } {
      \fp_set:Nn \l_semio_viz_cb_a_fp
        { \l_semio_viz_cb_a_fp + ( \l_semio_viz_cb_b_fp - \l_semio_viz_cb_a_fp ) / 2 }
    }
    \semio_viz_g_arc:nnnnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
      { \l_semio_viz_cb_a_fp } { \l_semio_viz_cb_b_fp }
      { \l_semio_viz_cb_t_fp + 0.03 } { \l_semio_viz_cb_u_fp - 0.03 }
      { fill = \semio_viz_palette:n { \l_semio_viz_cb_j_int } , draw = none , fill~opacity = 0.85 }
  }
}

% 🔥 Radial heatmap: every item becomes a full-height sector shaded by its value.
\cs_new_protected:Npn \semio_viz_polar_cells: {
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp { \semio_viz_polar_angle:n { \l_semio_viz_cb_j_int } }
    \fp_set:Nn \l_semio_viz_cb_u_fp { \semio_viz_polar_angle:n { \l_semio_viz_cb_j_int + 1 } }
    \semio_viz_g_arc:nnnnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
      { \l_semio_viz_pol_r_fp * \l_semio_viz_polar_inner_fp } { \l_semio_viz_pol_r_fp }
      { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
      {
        fill = \semio_viz_palette:n { 1 } ,
        fill~opacity = \fp_eval:n { 0.15 + 0.8 * ##1 / \l_semio_viz_cb_c_fp } ,
        draw = semio-chrome-canvas , line~width = \semio@stroke@hairline
      }
  }
}

% 🧭 Circumplex: labelled spokes with the value marked on each.
\cs_new_protected:Npn \semio_viz_polar_circumplex: {
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp { \semio_viz_polar_angle:n { \l_semio_viz_cb_j_int } }
    \semio_viz_g_line:nnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
      { \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_pol_r_fp } }
      { \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_pol_r_fp } }
      { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline ,
        draw~opacity = 0.5 }
    \fp_set:Nn \l_semio_viz_cb_u_fp { \semio_viz_polar_radius:n {##1} }
    \semio_viz_g_circle:nnnn
      { \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } }
      { \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } }
      { 1.1 } { fill = \semio_viz_palette:n { \l_semio_viz_cb_j_int } , draw = none }
  }
}

% 🌹 Coxcomb, rose, polar-area, nightingale and wind rose: equal-angle, value-scaled sectors.
\SemioVizFamily { coxcomb } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-direction }
  \bool_set_true:N \l_semio_viz_cox_area_bool
  \tl_set:Nn \l_semio_viz_cox_radius_tl { count }
  \fp_zero:N \l_semio_viz_cox_inner_fp
  \bool_set_false:N \l_semio_viz_cox_stacked_bool
  \tl_set:Nn \l_semio_viz_cox_second_tl { speed }
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / coxcomb } {#1}
  \semio_viz_cb_frame:
  \semio_viz_pol_centre:
  \semio_viz_cox_render:
}

% 🌹 Runs the coxcomb family once its keys are set.
\cs_new_protected:Npn \semio_viz_cox_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_cox_radius_tl }
  \bool_if:NT \l_semio_viz_cox_stacked_bool {
    \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_second_seq
      { \l_semio_viz_cb_data_tl } { \l_semio_viz_cox_second_tl }
  }
  \semio_viz_tr_stat_max:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_c_fp
  \fp_compare:nT { \l_semio_viz_cb_c_fp <= 0 } { \fp_set:Nn \l_semio_viz_cb_c_fp { 1 } }
  \int_set:Nn \l_semio_viz_cb_i_int { \seq_count:N \l_semio_viz_pol_values_seq }
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp
      { 2 * pi * ( \l_semio_viz_cb_j_int - 1 ) / \l_semio_viz_cb_i_int }
    \fp_set:Nn \l_semio_viz_cb_u_fp
      { 2 * pi * \l_semio_viz_cb_j_int / \l_semio_viz_cb_i_int }
    \fp_set:Nn \l_semio_viz_cb_a_fp
      { \l_semio_viz_pol_r_fp * \l_semio_viz_cox_inner_fp }
    \fp_set:Nn \l_semio_viz_cb_b_fp
      {
        \l_semio_viz_pol_r_fp
        * \bool_if:NTF \l_semio_viz_cox_area_bool
            { sqrt ( ##1 / \l_semio_viz_cb_c_fp ) } { ##1 / \l_semio_viz_cb_c_fp }
      }
    \semio_viz_g_arc:nnnnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
      { \l_semio_viz_cb_a_fp } { \l_semio_viz_cb_b_fp }
      { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
      { fill = \semio_viz_palette:n { \l_semio_viz_cb_j_int } , fill~opacity = 0.8 ,
        draw = semio-chrome-canvas , line~width = \semio@stroke@hairline }
    \bool_if:NT \l_semio_viz_cox_stacked_bool {
      \fp_set:Nn \l_semio_viz_cb_a_fp
        {
          \l_semio_viz_cb_b_fp
          + \l_semio_viz_pol_r_fp * 0.25
            * \seq_item:Nn \l_semio_viz_pol_second_seq { \l_semio_viz_cb_j_int }
            / \l_semio_viz_cb_c_fp
        }
      \semio_viz_g_arc:nnnnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
        { \l_semio_viz_cb_b_fp } { \l_semio_viz_cb_a_fp }
        { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
        { fill = \semio_viz_palette:n { \l_semio_viz_cb_j_int + 3 } , fill~opacity = 0.7 ,
          draw = semio-chrome-canvas , line~width = \semio@stroke@hairline }
    }
  }
}

% 🕸️ Radar, spider, star and polar profile: one closed profile per series column.
\SemioVizFamily { radar } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-profile }
  \tl_set:Nn \l_semio_viz_radar_axis_tl { axis }
  \clist_set:Nn \l_semio_viz_radar_series_clist { s1 }
  \tl_set:Nn \l_semio_viz_radar_shape_tl { polygon }
  \int_set:Nn \l_semio_viz_radar_levels_int { 4 }
  \bool_set_true:N \l_semio_viz_radar_filled_bool
  \bool_set_false:N \l_semio_viz_radar_star_bool
  \bool_set_true:N \l_semio_viz_radar_labels_bool
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / radar } {#1}
  \semio_viz_cb_frame:
  \semio_viz_pol_centre:
  \semio_viz_radar_render:
}

% 🕸️ Runs the radar family once its keys are set.
\cs_new_protected:Npn \semio_viz_radar_render: {
  \semio_viz_tr_stat_labels_from_table:Nnn \l_semio_viz_pol_labels_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_radar_axis_tl }
  \int_set:Nn \l_semio_viz_cb_i_int { \seq_count:N \l_semio_viz_pol_labels_seq }
  \fp_set:Nn \l_semio_viz_cb_c_fp { 0 }
  \clist_map_inline:Nn \l_semio_viz_radar_series_clist {
    \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq { \l_semio_viz_cb_data_tl } {##1}
    \semio_viz_tr_stat_max:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_a_fp
    \fp_set:Nn \l_semio_viz_cb_c_fp { max ( \l_semio_viz_cb_c_fp , \l_semio_viz_cb_a_fp ) }
  }
  \fp_compare:nT { \l_semio_viz_cb_c_fp <= 0 } { \fp_set:Nn \l_semio_viz_cb_c_fp { 1 } }
  \semio_viz_radar_grid:
  \int_zero:N \l_semio_viz_cb_series_int
  \clist_map_inline:Nn \l_semio_viz_radar_series_clist {
    \int_incr:N \l_semio_viz_cb_series_int
    \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq { \l_semio_viz_cb_data_tl } {##1}
    \semio_viz_radar_profile:n { \l_semio_viz_cb_series_int }
  }
  \bool_if:NT \l_semio_viz_radar_labels_bool { \semio_viz_radar_labels: }
}

% 🕸️ Grid rings, as concentric circles or as concentric polygons.
\cs_new_protected:Npn \semio_viz_radar_grid: {
  \int_step_inline:nn { \l_semio_viz_radar_levels_int } {
    \fp_set:Nn \l_semio_viz_cb_a_fp
      { \l_semio_viz_pol_r_fp * ##1 / \l_semio_viz_radar_levels_int }
    \str_if_eq:VnTF \l_semio_viz_radar_shape_tl { circle }
      {
        \semio_viz_g_circle:nnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
          { \l_semio_viz_cb_a_fp }
          { draw = semio-chrome-border-normal , fill = none ,
            line~width = \semio@stroke@hairline , draw~opacity = 0.4 }
      }
      { \semio_viz_radar_ring:n { \l_semio_viz_cb_a_fp } }
  }
  \int_step_inline:nn { \l_semio_viz_cb_i_int } {
    \fp_set:Nn \l_semio_viz_cb_t_fp { 2 * pi * ( ##1 - 1 ) / \l_semio_viz_cb_i_int }
    \semio_viz_g_line:nnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
      { \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_pol_r_fp } }
      { \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_pol_r_fp } }
      { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline ,
        draw~opacity = 0.4 }
  }
}

% 🕸️ One polygonal grid ring of radius #1.
\cs_new_protected:Npn \semio_viz_radar_ring:n #1 {
  \tl_clear:N \l_semio_viz_cb_points_tl
  \int_step_inline:nn { \l_semio_viz_cb_i_int } {
    \fp_set:Nn \l_semio_viz_cb_t_fp { 2 * pi * ( ##1 - 1 ) / \l_semio_viz_cb_i_int }
    \tl_put_right:Nx \l_semio_viz_cb_points_tl
      {
        \tl_if_empty:NF \l_semio_viz_cb_points_tl { , }
        \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } {#1} ,
        \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } {#1}
      }
  }
  \semio_viz_g_polygon:Vn \l_semio_viz_cb_points_tl
    { fill = none , draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline ,
      draw~opacity = 0.4 }
}

% 🕸️ One profile of the current value sequence as series #1.
\cs_new_protected:Npn \semio_viz_radar_profile:n #1 {
  \tl_clear:N \l_semio_viz_cb_points_tl
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp
      { 2 * pi * ( \l_semio_viz_cb_j_int - 1 ) / \l_semio_viz_cb_i_int }
    \fp_set:Nn \l_semio_viz_cb_u_fp
      { \l_semio_viz_pol_r_fp * ##1 / \l_semio_viz_cb_c_fp }
    \bool_if:NTF \l_semio_viz_radar_star_bool
      {
        \semio_viz_g_line:nnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
          { \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } }
          { \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } }
          { draw = \semio_viz_palette:n {#1} , line~width = \semio@stroke@default }
      }
      {
        \tl_put_right:Nx \l_semio_viz_cb_points_tl
          {
            \tl_if_empty:NF \l_semio_viz_cb_points_tl { , }
            \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } ,
            \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
          }
      }
  }
  \bool_if:NF \l_semio_viz_radar_star_bool {
    \bool_if:NTF \l_semio_viz_radar_filled_bool
      {
        \semio_viz_g_polygon:Vn \l_semio_viz_cb_points_tl
          { fill = \semio_viz_palette:n {#1} , fill~opacity = 0.3 ,
            draw = \semio_viz_palette:n {#1} , line~width = \semio@stroke@default }
      }
      {
        \semio_viz_g_polygon:Vn \l_semio_viz_cb_points_tl
          { fill = none , draw = \semio_viz_palette:n {#1} , line~width = \semio@stroke@default }
      }
  }
}

% 🏷️ Axis names outside the outer ring.
\cs_new_protected:Npn \semio_viz_radar_labels: {
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_pol_labels_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_set:Nn \l_semio_viz_cb_t_fp
      { 2 * pi * ( \l_semio_viz_cb_j_int - 1 ) / \l_semio_viz_cb_i_int }
    \semio_viz_g_text:nnnn
      { \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_pol_r_fp + 2.4 } }
      { \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_pol_r_fp + 2.4 } }
      { center } {##1}
  }
}

% 🏛️ Parliament and seat charts: concentric hemicycle rows of individual seats.
\SemioVizFamily { parliament } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-parts }
