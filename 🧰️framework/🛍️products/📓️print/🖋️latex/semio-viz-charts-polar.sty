\fp_new:N \l_semio_viz_pol_cx_fp
\fp_new:N \l_semio_viz_pol_cy_fp
\fp_new:N \l_semio_viz_pol_r_fp
\seq_new:N \l_semio_viz_pol_values_seq
\seq_new:N \l_semio_viz_pol_labels_seq
\seq_new:N \l_semio_viz_pol_second_seq
