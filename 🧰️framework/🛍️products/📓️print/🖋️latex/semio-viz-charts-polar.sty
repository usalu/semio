% ☀️ Runs the sunburst family once its keys are set.
\cs_new_protected:Npn \semio_viz_sun_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_sun_depth_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_sun_depth_tl }
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_sun_value_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_sun_amount_tl }
  \int_step_inline:nn { \l_semio_viz_sun_levels_int } { \semio_viz_sun_ring:n {##1} }
}

% ☀️ One ring of the partition at depth #1.
\cs_new_protected:Npn \semio_viz_sun_ring:n #1 {
  \seq_clear:N \l_semio_viz_sun_ring_seq
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_sun_depth_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \fp_compare:nT { ##1 == #1 }
      {
        \seq_put_right:Nx \l_semio_viz_sun_ring_seq
          { \seq_item:Nn \l_semio_viz_sun_value_seq { \l_semio_viz_cb_j_int } }
      }
  }
  \semio_viz_pie_from_seq:Nnnnn \l_semio_viz_sun_ring_seq { 0 } { 2 * pi } { 0 } { none }
  \fp_set:Nn \l_semio_viz_cb_a_fp
    {
      \l_semio_viz_pol_r_fp
      * ( \l_semio_viz_sun_inner_fp
          + ( 1 - \l_semio_viz_sun_inner_fp ) * ( (#1) - 1 ) / \l_semio_viz_sun_levels_int )
    }
  \fp_set:Nn \l_semio_viz_cb_b_fp
    {
      \l_semio_viz_pol_r_fp
      * ( \l_semio_viz_sun_inner_fp
          + ( 1 - \l_semio_viz_sun_inner_fp ) * (#1) / \l_semio_viz_sun_levels_int )
      - \l_semio_viz_sun_ringgap_fp
    }
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \g_semio_viz_pie_start_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \semio_viz_g_arc:nnnnnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
      { \l_semio_viz_cb_a_fp } { \l_semio_viz_cb_b_fp }
      {##1} { \seq_item:Nn \g_semio_viz_pie_end_seq { \l_semio_viz_cb_j_int } }
      { fill = \semio_viz_palette:n { \l_semio_viz_cb_j_int + (#1) - 1 } ,
        fill~opacity = \fp_eval:n { 1 - 0.15 * (#1) } ,
        draw = semio-chrome-canvas , line~width = \semio@stroke@hairline }
  }
}

% 🧵 Parallel coordinates: one vertical axis per column, one polyline per row.
\SemioVizFamily { parallel } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-profile }
  \clist_set:Nn \l_semio_viz_par_axes_clist { s1, s2, s3 }
  \bool_set_false:N \l_semio_viz_par_curve_bool
  \int_set:Nn \l_semio_viz_par_ticks_int { 3 }
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / parallel } {#1}
  \semio_viz_cb_frame:
  \semio_viz_par_render:
}

\seq_new:N \l_semio_viz_par_min_seq
\seq_new:N \l_semio_viz_par_max_seq

% 🧵 Runs the parallel family once its keys are set.
\cs_new_protected:Npn \semio_viz_par_render: {
  \seq_clear:N \l_semio_viz_par_min_seq
  \seq_clear:N \l_semio_viz_par_max_seq
  \clist_map_inline:Nn \l_semio_viz_par_axes_clist {
    \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq { \l_semio_viz_cb_data_tl } {##1}
    \semio_viz_tr_stat_min:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_a_fp
    \semio_viz_tr_stat_max:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_b_fp
    \seq_put_right:Nx \l_semio_viz_par_min_seq { \fp_eval:n { \l_semio_viz_cb_a_fp } }
    \seq_put_right:Nx \l_semio_viz_par_max_seq { \fp_eval:n { \l_semio_viz_cb_b_fp } }
  }
  \int_set:Nn \l_semio_viz_cb_i_int { \clist_count:N \l_semio_viz_par_axes_clist }
  \int_step_inline:nn { \l_semio_viz_cb_i_int } {
    \fp_set:Nn \l_semio_viz_cb_t_fp
      {
        \l_semio_viz_cb_xa_fp
        + ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp ) * ( ##1 - 1 )
          / max ( 1 , \l_semio_viz_cb_i_int - 1 )
      }
    \semio_viz_g_line:nnnnn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_ya_fp }
      { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_yb_fp }
      { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline }
    \semio_viz_par_axis_ticks:
  }
  \semio_viz_table_nrows:nN { \l_semio_viz_cb_data_tl } \l_semio_viz_cb_series_int
  \int_step_inline:nn { \l_semio_viz_cb_series_int } { \semio_viz_par_line:n {##1} }
}

% 🎚️ The `ticks` marks of the axis standing at the current abscissa, evenly over its own range.
\cs_new_protected:Npn \semio_viz_par_axis_ticks: {
  \int_step_inline:nn { \l_semio_viz_par_ticks_int } {
    \fp_set:Nn \l_semio_viz_cb_u_fp
      {
        \l_semio_viz_cb_ya_fp
        + ( \l_semio_viz_cb_yb_fp - \l_semio_viz_cb_ya_fp ) * ( ##1 - 1 )
          / max ( 1 , \l_semio_viz_par_ticks_int - 1 )
      }
    \semio_viz_g_line:nnnnn { \l_semio_viz_cb_t_fp - 0.7 } { \l_semio_viz_cb_u_fp }
      { \l_semio_viz_cb_t_fp + 0.7 } { \l_semio_viz_cb_u_fp }
      { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline }
  }
}

% 🧵 One polyline across every axis for table row #1.
\cs_new_protected:Npn \semio_viz_par_line:n #1 {
  \tl_clear:N \l_semio_viz_cb_points_tl
  \int_zero:N \l_semio_viz_cb_j_int
  \clist_map_inline:Nn \l_semio_viz_par_axes_clist {
    \int_incr:N \l_semio_viz_cb_j_int
    \semio_viz_table_cell:nnnN { \l_semio_viz_cb_data_tl } {#1} {##1} \l_semio_viz_tr_stat_cell_tl
    \fp_set:Nn \l_semio_viz_cb_t_fp
      {
        \l_semio_viz_cb_xa_fp
        + ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp ) * ( \l_semio_viz_cb_j_int - 1 )
          / max ( 1 , \l_semio_viz_cb_i_int - 1 )
      }
    \semio_viz_scale_linear:nnnnnN { \l_semio_viz_tr_stat_cell_tl }
      { \seq_item:Nn \l_semio_viz_par_min_seq { \l_semio_viz_cb_j_int } }
      { \seq_item:Nn \l_semio_viz_par_max_seq { \l_semio_viz_cb_j_int } }
      { \l_semio_viz_cb_ya_fp } { \l_semio_viz_cb_yb_fp } \l_semio_viz_cb_u_fp
    \tl_put_right:Nx \l_semio_viz_cb_points_tl
      {
        \tl_if_empty:NF \l_semio_viz_cb_points_tl { , }
        \fp_eval:n { \l_semio_viz_cb_t_fp } , \fp_eval:n { \l_semio_viz_cb_u_fp }
      }
  }
  \bool_if:NTF \l_semio_viz_par_curve_bool
    {
      \semio_viz_g_polyline:Vn \l_semio_viz_cb_points_tl
        { draw = \semio_viz_palette:n {#1} , line~width = \semio@stroke@hairline ,
          opacity = 0.85 , smooth }
    }
    {
      \semio_viz_g_polyline:Vn \l_semio_viz_cb_points_tl
        { draw = \semio_viz_palette:n {#1} , line~width = \semio@stroke@hairline ,
          opacity = 0.85 }
    }
}

% 🎭 Glyph plots: star glyphs, simplified Chernoff faces, Andrews curves and profile glyphs.
\SemioVizFamily { glyph } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-profile }
  \tl_set:Nn \l_semio_viz_glyph_kind_tl { star }
  \clist_set:Nn \l_semio_viz_glyph_axes_clist { s1, s2, s3 }
  \int_set:Nn \l_semio_viz_glyph_columns_int { 3 }
  \int_set:Nn \l_semio_viz_glyph_samples_int { 32 }
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / glyph } {#1}
  \semio_viz_cb_frame:
  \semio_viz_glyph_render:
}

% 🎭 Runs the glyph family once its keys are set.
\cs_new_protected:Npn \semio_viz_glyph_render: {
  \semio_viz_table_nrows:nN { \l_semio_viz_cb_data_tl } \l_semio_viz_cb_series_int
  \str_if_eq:VnTF \l_semio_viz_glyph_kind_tl { andrews }
    { \int_step_inline:nn { \l_semio_viz_cb_series_int } { \semio_viz_glyph_andrews:n {##1} } }
    {
      \int_set:Nn \l_semio_viz_cb_i_int { \l_semio_viz_glyph_columns_int }
      \fp_set:Nn \l_semio_viz_cb_w_fp
        { ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp ) / \l_semio_viz_cb_i_int }
      \fp_set:Nn \l_semio_viz_cb_h_fp
        {
          ( \l_semio_viz_cb_yb_fp - \l_semio_viz_cb_ya_fp )
          / max ( 1 , ceil ( \l_semio_viz_cb_series_int / \l_semio_viz_cb_i_int ) )
        }
      \int_step_inline:nn { \l_semio_viz_cb_series_int } { \semio_viz_glyph_cell:n {##1} }
    }
}

% 🎭 One glyph cell for table row #1.
\cs_new_protected:Npn \semio_viz_glyph_cell:n #1 {
  \fp_set:Nn \l_semio_viz_pol_cx_fp
    {
      \l_semio_viz_cb_xa_fp
      + ( \int_mod:nn { (#1) - 1 } { \l_semio_viz_cb_i_int } + 0.5 ) * \l_semio_viz_cb_w_fp
    }
  \fp_set:Nn \l_semio_viz_pol_cy_fp
    {
      \l_semio_viz_cb_ya_fp
      + ( \int_div_truncate:nn { (#1) - 1 } { \l_semio_viz_cb_i_int } + 0.5 )
        * \l_semio_viz_cb_h_fp
    }
  \fp_set:Nn \l_semio_viz_pol_r_fp
    { min ( \l_semio_viz_cb_w_fp , \l_semio_viz_cb_h_fp ) * 0.4 }
  \seq_clear:N \l_semio_viz_pol_values_seq
  \clist_map_inline:Nn \l_semio_viz_glyph_axes_clist {
    \semio_viz_table_cell:nnnN { \l_semio_viz_cb_data_tl } {#1} {##1} \l_semio_viz_tr_stat_cell_tl
    \seq_put_right:Nx \l_semio_viz_pol_values_seq { \fp_eval:n { \l_semio_viz_tr_stat_cell_tl } }
  }
  \semio_viz_tr_stat_max:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_c_fp
  \fp_compare:nT { \l_semio_viz_cb_c_fp <= 0 } { \fp_set:Nn \l_semio_viz_cb_c_fp { 1 } }
  \str_if_eq:VnTF \l_semio_viz_glyph_kind_tl { chernoff }
    { \semio_viz_glyph_face:n {#1} }
    { \semio_viz_glyph_star:n {#1} }
}

% ⭐ Star or profile glyph: spokes proportional to each value.
\cs_new_protected:Npn \semio_viz_glyph_star:n #1 {
  \int_set:Nn \l_semio_viz_cb_j_int { \seq_count:N \l_semio_viz_pol_values_seq }
  \tl_clear:N \l_semio_viz_cb_points_tl
  \int_step_inline:nn { \l_semio_viz_cb_j_int } {
    \fp_set:Nn \l_semio_viz_cb_t_fp { 2 * pi * ( ##1 - 1 ) / \l_semio_viz_cb_j_int }
    \fp_set:Nn \l_semio_viz_cb_u_fp
      {
        \l_semio_viz_pol_r_fp
        * \seq_item:Nn \l_semio_viz_pol_values_seq {##1} / \l_semio_viz_cb_c_fp
      }
    \tl_put_right:Nx \l_semio_viz_cb_points_tl
      {
        \tl_if_empty:NF \l_semio_viz_cb_points_tl { , }
        \semio_viz_pol_x:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp } ,
        \semio_viz_pol_y:nn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
      }
  }
  \semio_viz_g_polygon:Vn \l_semio_viz_cb_points_tl
    { fill = \semio_viz_palette:n {#1} , fill~opacity = 0.4 ,
      draw = \semio_viz_palette:n {#1} , line~width = \semio@stroke@hairline }
}

% 🙂 Simplified Chernoff face: head size, eye separation and mouth curvature carry three values.
\cs_new_protected:Npn \semio_viz_glyph_face:n #1 {
  \fp_set:Nn \l_semio_viz_cb_a_fp
    {
      \l_semio_viz_pol_r_fp
      * ( 0.6 + 0.4 * \seq_item:Nn \l_semio_viz_pol_values_seq { 1 } / \l_semio_viz_cb_c_fp )
    }
  \semio_viz_g_circle:nnnn { \l_semio_viz_pol_cx_fp } { \l_semio_viz_pol_cy_fp }
    { \l_semio_viz_cb_a_fp }
    { fill = \semio_viz_palette:n {#1} , fill~opacity = 0.25 ,
      draw = semio-chrome-border-emphasized , line~width = \semio@stroke@hairline }
  \fp_set:Nn \l_semio_viz_cb_b_fp
    {
      \l_semio_viz_cb_a_fp
      * ( 0.25 + 0.3 * \seq_item:Nn \l_semio_viz_pol_values_seq { 2 } / \l_semio_viz_cb_c_fp )
    }
  \semio_viz_g_circle:nnnn { \l_semio_viz_pol_cx_fp - \l_semio_viz_cb_b_fp }
    { \l_semio_viz_pol_cy_fp + \l_semio_viz_cb_a_fp * 0.3 } { 0.35 }
    { fill = semio-chrome-border-emphasized , draw = none }
  \semio_viz_g_circle:nnnn { \l_semio_viz_pol_cx_fp + \l_semio_viz_cb_b_fp }
    { \l_semio_viz_pol_cy_fp + \l_semio_viz_cb_a_fp * 0.3 } { 0.35 }
    { fill = semio-chrome-border-emphasized , draw = none }
  \fp_set:Nn \l_semio_viz_cb_t_fp
    {
      \l_semio_viz_cb_a_fp * 0.35
      * ( 2 * \seq_item:Nn \l_semio_viz_pol_values_seq { 3 } / \l_semio_viz_cb_c_fp - 1 )
    }
  \semio_viz_g_polyline:xn
    {
      \fp_eval:n { \l_semio_viz_pol_cx_fp - \l_semio_viz_cb_a_fp * 0.4 } ,
      \fp_eval:n { \l_semio_viz_pol_cy_fp - \l_semio_viz_cb_a_fp * 0.35 } ,
      \fp_eval:n { \l_semio_viz_pol_cx_fp } ,
      \fp_eval:n { \l_semio_viz_pol_cy_fp - \l_semio_viz_cb_a_fp * 0.35 + \l_semio_viz_cb_t_fp } ,
      \fp_eval:n { \l_semio_viz_pol_cx_fp + \l_semio_viz_cb_a_fp * 0.4 } ,
      \fp_eval:n { \l_semio_viz_pol_cy_fp - \l_semio_viz_cb_a_fp * 0.35 }
    }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@hairline }
}

% 〰️ Andrews curve of table row #1: f(t) = x1/sqrt(2) + x2 sin t + x3 cos t + ...
\cs_new_protected:Npn \semio_viz_glyph_andrews:n #1 {
  \seq_clear:N \l_semio_viz_pol_values_seq
  \clist_map_inline:Nn \l_semio_viz_glyph_axes_clist {
    \semio_viz_table_cell:nnnN { \l_semio_viz_cb_data_tl } {#1} {##1} \l_semio_viz_tr_stat_cell_tl
    \seq_put_right:Nx \l_semio_viz_pol_values_seq { \fp_eval:n { \l_semio_viz_tr_stat_cell_tl } }
  }
  \tl_clear:N \l_semio_viz_cb_points_tl
  \int_step_inline:nnn { 0 } { \l_semio_viz_glyph_samples_int } {
    \fp_set:Nn \l_semio_viz_cb_t_fp
      { -pi + 2 * pi * ##1 / \l_semio_viz_glyph_samples_int }
    \fp_set:Nn \l_semio_viz_cb_u_fp
      { \seq_item:Nn \l_semio_viz_pol_values_seq { 1 } / sqrt ( 2 ) }
    \int_zero:N \l_semio_viz_cb_j_int
    \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
      \int_incr:N \l_semio_viz_cb_j_int
      \int_compare:nNnT { \l_semio_viz_cb_j_int } > { 1 } {
        \fp_add:Nn \l_semio_viz_cb_u_fp
          {
            ####1
            * ( \int_mod:nn { \l_semio_viz_cb_j_int } { 2 } == 0
                ? sin ( \int_div_truncate:nn { \l_semio_viz_cb_j_int } { 2 } * \l_semio_viz_cb_t_fp )
                : cos ( \int_div_truncate:nn { \l_semio_viz_cb_j_int } { 2 } * \l_semio_viz_cb_t_fp ) )
          }
      }
    }
    \semio_viz_probe_geometry:nx { andrews }
      { \fp_eval:n { \l_semio_viz_cb_t_fp }, \fp_eval:n { \l_semio_viz_cb_u_fp } }
    \tl_put_right:Nx \l_semio_viz_cb_points_tl
      {
        \tl_if_empty:NF \l_semio_viz_cb_points_tl { , }
        \fp_eval:n
          {
            \l_semio_viz_cb_xa_fp
            + ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp ) * ( ##1 / \l_semio_viz_glyph_samples_int )
          } ,
        \fp_eval:n
          {
            ( \l_semio_viz_cb_ya_fp + \l_semio_viz_cb_yb_fp ) / 2
            + \l_semio_viz_cb_u_fp / 40 * ( \l_semio_viz_cb_yb_fp - \l_semio_viz_cb_ya_fp )
          }
      }
  }
  \semio_viz_g_polyline:Vn \l_semio_viz_cb_points_tl
    { draw = \semio_viz_palette:n {#1} , line~width = \semio@stroke@hairline }
}

% 🔺 Ternary: barycentric scatter, density and contour inside an equilateral simplex.
\SemioVizFamily { ternary } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-simplex }
  \tl_set:Nn \l_semio_viz_tern_mark_tl { scatter }
  \tl_set:Nn \l_semio_viz_tern_pa_tl { pa }
  \tl_set:Nn \l_semio_viz_tern_pb_tl { pb }
  \tl_set:Nn \l_semio_viz_tern_pc_tl { pc }
  \int_set:Nn \l_semio_viz_tern_grid_int { 4 }
  \fp_set:Nn \l_semio_viz_tern_radius_fp { 0.9 }
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / ternary } {#1}
  \semio_viz_cb_frame:
  \semio_viz_tern_render:
}

\seq_new:N \l_semio_viz_tern_a_seq
\seq_new:N \l_semio_viz_tern_b_seq
\seq_new:N \l_semio_viz_tern_c_seq

% 🔺 Runs the ternary family once its keys are set.
\cs_new_protected:Npn \semio_viz_tern_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_tern_a_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_tern_pa_tl }
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_tern_b_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_tern_pb_tl }
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_tern_c_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_tern_pc_tl }
  \fp_set:Nn \l_semio_viz_cb_w_fp { \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp }
  \fp_set:Nn \l_semio_viz_cb_h_fp { \l_semio_viz_cb_yb_fp - \l_semio_viz_cb_ya_fp }
  \semio_viz_g_polygon:xn
    {
      \fp_eval:n { \l_semio_viz_cb_xa_fp } , \fp_eval:n { \l_semio_viz_cb_ya_fp } ,
      \fp_eval:n { \l_semio_viz_cb_xb_fp } , \fp_eval:n { \l_semio_viz_cb_ya_fp } ,
      \fp_eval:n { ( \l_semio_viz_cb_xa_fp + \l_semio_viz_cb_xb_fp ) / 2 } ,
      \fp_eval:n { \l_semio_viz_cb_yb_fp }
    }
    { fill = none , draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline }
  \int_step_inline:nn { \l_semio_viz_tern_grid_int - 1 } {
    \fp_set:Nn \l_semio_viz_cb_a_fp { ##1 / \l_semio_viz_tern_grid_int }
    \semio_viz_g_line:nnnnn
      { \l_semio_viz_cb_xa_fp + \l_semio_viz_cb_w_fp * \l_semio_viz_cb_a_fp / 2 }
      { \l_semio_viz_cb_ya_fp + \l_semio_viz_cb_h_fp * \l_semio_viz_cb_a_fp }
      { \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_w_fp * \l_semio_viz_cb_a_fp / 2 }
      { \l_semio_viz_cb_ya_fp + \l_semio_viz_cb_h_fp * \l_semio_viz_cb_a_fp }
      { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline ,
        draw~opacity = 0.35 }
  }
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_tern_a_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \semio_viz_tern_point:n { \l_semio_viz_cb_j_int }
  }
}

% 🔺 One barycentric point of the simplex.
\cs_new_protected:Npn \semio_viz_tern_point:n #1 {
  \fp_set:Nn \l_semio_viz_cb_a_fp { \seq_item:Nn \l_semio_viz_tern_a_seq {#1} }
  \fp_set:Nn \l_semio_viz_cb_b_fp { \seq_item:Nn \l_semio_viz_tern_b_seq {#1} }
  \fp_set:Nn \l_semio_viz_cb_c_fp { \seq_item:Nn \l_semio_viz_tern_c_seq {#1} }
  \fp_set:Nn \l_semio_viz_cb_t_fp
    { \l_semio_viz_cb_a_fp + \l_semio_viz_cb_b_fp + \l_semio_viz_cb_c_fp }
  \fp_compare:nT { \l_semio_viz_cb_t_fp <= 0 } { \fp_set:Nn \l_semio_viz_cb_t_fp { 1 } }
  \fp_set:Nn \l_semio_viz_cb_u_fp
    {
      \l_semio_viz_cb_xa_fp
      + \l_semio_viz_cb_w_fp
        * ( \l_semio_viz_cb_b_fp / \l_semio_viz_cb_t_fp
            + 0.5 * \l_semio_viz_cb_c_fp / \l_semio_viz_cb_t_fp )
    }
  \fp_set:Nn \l_semio_viz_cb_w_fp { \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp }
  \semio_viz_probe_geometry:nx { ternary }
    {
      \fp_eval:n { \l_semio_viz_cb_b_fp / \l_semio_viz_cb_t_fp
                   + 0.5 * \l_semio_viz_cb_c_fp / \l_semio_viz_cb_t_fp },
      \fp_eval:n { \l_semio_viz_cb_c_fp / \l_semio_viz_cb_t_fp }
    }
  \str_if_eq:VnTF \l_semio_viz_tern_mark_tl { scatter }
    {
      \semio_viz_g_circle:nnnn { \l_semio_viz_cb_u_fp }
        { \l_semio_viz_cb_ya_fp + \l_semio_viz_cb_h_fp * \l_semio_viz_cb_c_fp / \l_semio_viz_cb_t_fp }
        { \l_semio_viz_tern_radius_fp }
        { fill = \semio_viz_palette:n {#1} , draw = none , fill~opacity = 0.85 }
    }
    {
      \semio_viz_g_circle:nnnn { \l_semio_viz_cb_u_fp }
        { \l_semio_viz_cb_ya_fp + \l_semio_viz_cb_h_fp * \l_semio_viz_cb_c_fp / \l_semio_viz_cb_t_fp }
        { \l_semio_viz_tern_radius_fp * 2.6 }
        { fill = \semio_viz_palette:n { 1 } , draw = none , fill~opacity = 0.22 }
    }
}

% 🧬 Embedding, biplot, PCA and cluster projections: a projected scatter with optional loadings.
\SemioVizFamily { embedding } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-embedding }
  \tl_set:Nn \l_semio_viz_emb_ex_tl { ex }
  \tl_set:Nn \l_semio_viz_emb_ey_tl { ey }
  \tl_set:Nn \l_semio_viz_emb_cluster_tl { cluster }
  \tl_set:Nn \l_semio_viz_emb_loading_tl { load }
  \bool_set_false:N \l_semio_viz_emb_arrows_bool
  \bool_set_false:N \l_semio_viz_emb_hulls_bool
  \fp_set:Nn \l_semio_viz_emb_radius_fp { 1 }
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / embedding } {#1}
  \semio_viz_cb_frame:
  \semio_viz_emb_render:
}

\seq_new:N \l_semio_viz_emb_x_seq
\seq_new:N \l_semio_viz_emb_y_seq
\seq_new:N \l_semio_viz_emb_g_seq
\seq_new:N \l_semio_viz_emb_l_seq
\seq_new:N \l_semio_viz_emb_levels_seq

% 🧬 Runs the embedding family once its keys are set.
\cs_new_protected:Npn \semio_viz_emb_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_emb_x_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_emb_ex_tl }
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_emb_y_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_emb_ey_tl }
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_emb_l_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_emb_loading_tl }
  \semio_viz_tr_stat_labels_from_table:Nnn \l_semio_viz_emb_g_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_emb_cluster_tl }
  \seq_clear:N \l_semio_viz_emb_levels_seq
  \seq_map_inline:Nn \l_semio_viz_emb_g_seq {
    \seq_if_in:NnF \l_semio_viz_emb_levels_seq {##1}
      { \seq_put_right:Nn \l_semio_viz_emb_levels_seq {##1} }
  }
  \semio_viz_tr_stat_min:NN \l_semio_viz_emb_x_seq \l_semio_viz_cb_a_fp
  \semio_viz_tr_stat_max:NN \l_semio_viz_emb_x_seq \l_semio_viz_cb_b_fp
  \semio_viz_tr_stat_min:NN \l_semio_viz_emb_y_seq \l_semio_viz_cb_c_fp
  \semio_viz_tr_stat_max:NN \l_semio_viz_emb_y_seq \l_semio_viz_cb_h_fp
  \bool_if:NT \l_semio_viz_emb_hulls_bool { \semio_viz_emb_hulls: }
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_emb_x_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \semio_viz_emb_point:n { \l_semio_viz_cb_j_int }
  }
  \bool_if:NT \l_semio_viz_emb_arrows_bool { \semio_viz_emb_arrows: }
}

% 🪢 The convex hull of every cluster, drawn behind its own points so a cluster reads as a region
% and not only as a colour. The hull itself is `semio-viz-spatial`'s monotone chain.
\cs_new_protected:Npn \semio_viz_emb_hulls: {
  \int_zero:N \l_semio_viz_cb_i_int
  \seq_map_inline:Nn \l_semio_viz_emb_levels_seq {
    \int_incr:N \l_semio_viz_cb_i_int
    \semio_viz_emb_hull_one:nn {##1} { \l_semio_viz_cb_i_int }
  }
}

% 🪢 The hull of cluster #1, drawn in the palette colour of its index #2; a cluster of fewer than
% three points has no hull and is skipped rather than drawn as a degenerate polygon.
\cs_new_protected:Npn \semio_viz_emb_hull_one:nn #1#2 {
  \tl_clear:N \l_semio_viz_cb_points_tl
  \int_zero:N \l_semio_viz_cb_j_int
  \int_zero:N \l_semio_viz_cb_series_int
  \seq_map_inline:Nn \l_semio_viz_emb_x_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \str_if_eq:eeT { \seq_item:Nn \l_semio_viz_emb_g_seq { \l_semio_viz_cb_j_int } } {#1} {
      \int_incr:N \l_semio_viz_cb_series_int
      \semio_viz_scale_linear:nnnnnN {##1}
        { \l_semio_viz_cb_a_fp } { \l_semio_viz_cb_b_fp }
        { \l_semio_viz_cb_xa_fp } { \l_semio_viz_cb_xb_fp } \l_semio_viz_cb_t_fp
      \semio_viz_scale_linear:nnnnnN
        { \seq_item:Nn \l_semio_viz_emb_y_seq { \l_semio_viz_cb_j_int } }
        { \l_semio_viz_cb_c_fp } { \l_semio_viz_cb_h_fp }
        { \l_semio_viz_cb_ya_fp } { \l_semio_viz_cb_yb_fp } \l_semio_viz_cb_u_fp
      \tl_put_right:Nx \l_semio_viz_cb_points_tl
        {
          \tl_if_empty:NF \l_semio_viz_cb_points_tl { ; }
          \fp_eval:n { \l_semio_viz_cb_t_fp } , \fp_eval:n { \l_semio_viz_cb_u_fp }
        }
    }
  }
  \int_compare:nNnT { \l_semio_viz_cb_series_int } > { 2 } {
    \use:x
      {
        \exp_not:N \semio_viz_points_new:nn { semio-viz-embedding-cluster }
          { \exp_not:V \l_semio_viz_cb_points_tl }
      }
    \semio_viz_spatial_hull:n { semio-viz-embedding-cluster }
    \tl_clear:N \l_semio_viz_cb_points_tl
    \seq_map_inline:Nn \g_semio_viz_spatial_hull_seq {
      \tl_put_right:Nx \l_semio_viz_cb_points_tl
        {
          \tl_if_empty:NF \l_semio_viz_cb_points_tl { , }
          \fp_eval:n { \semio_viz_spatial_x:n {##1} } ,
          \fp_eval:n { \semio_viz_spatial_y:n {##1} }
        }
    }
    \semio_viz_g_polygon:Vn \l_semio_viz_cb_points_tl
      { fill = \semio_viz_palette:n {#2} , fill~opacity = 0.12 ,
        draw = \semio_viz_palette:n {#2} , line~width = \semio@stroke@hairline ,
        draw~opacity = 0.5 }
  }
}

% 🧬 One projected point coloured by its cluster level.
\cs_new_protected:Npn \semio_viz_emb_point:n #1 {
  \semio_viz_scale_linear:nnnnnN { \seq_item:Nn \l_semio_viz_emb_x_seq {#1} }
    { \l_semio_viz_cb_a_fp } { \l_semio_viz_cb_b_fp }
    { \l_semio_viz_cb_xa_fp } { \l_semio_viz_cb_xb_fp } \l_semio_viz_cb_t_fp
  \semio_viz_scale_linear:nnnnnN { \seq_item:Nn \l_semio_viz_emb_y_seq {#1} }
    { \l_semio_viz_cb_c_fp } { \l_semio_viz_cb_h_fp }
    { \l_semio_viz_cb_ya_fp } { \l_semio_viz_cb_yb_fp } \l_semio_viz_cb_u_fp
  \int_zero:N \l_semio_viz_cb_series_int
  \int_zero:N \l_semio_viz_cb_i_int
  \seq_map_inline:Nn \l_semio_viz_emb_levels_seq {
    \int_incr:N \l_semio_viz_cb_i_int
    \str_if_eq:eeT { \seq_item:Nn \l_semio_viz_emb_g_seq {#1} } {##1}
      { \int_set_eq:NN \l_semio_viz_cb_series_int \l_semio_viz_cb_i_int }
  }
  \semio_viz_g_circle:nnnn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
    { \l_semio_viz_emb_radius_fp }
    { fill = \semio_viz_palette:n { \l_semio_viz_cb_series_int } , draw = none ,
      fill~opacity = 0.85 }
}

% ➡️ Loading arrows of a biplot, from the projection centre outwards.
\cs_new_protected:Npn \semio_viz_emb_arrows: {
  \semio_viz_tr_stat_max:NN \l_semio_viz_emb_l_seq \l_semio_viz_cb_w_fp
  \fp_compare:nT { \l_semio_viz_cb_w_fp <= 0 } { \fp_set:Nn \l_semio_viz_cb_w_fp { 1 } }
  \int_set:Nn \l_semio_viz_cb_i_int { \seq_count:N \l_semio_viz_emb_l_seq }
  \int_step_inline:nn { \l_semio_viz_cb_i_int } {
    \fp_set:Nn \l_semio_viz_cb_t_fp { 2 * pi * ( ##1 - 1 ) / \l_semio_viz_cb_i_int }
    \fp_set:Nn \l_semio_viz_cb_u_fp
      {
        min ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp ,
              \l_semio_viz_cb_yb_fp - \l_semio_viz_cb_ya_fp ) / 2
        * \seq_item:Nn \l_semio_viz_emb_l_seq {##1} / \l_semio_viz_cb_w_fp
      }
    \semio_viz_g_line:nnnnn
      { ( \l_semio_viz_cb_xa_fp + \l_semio_viz_cb_xb_fp ) / 2 }
      { ( \l_semio_viz_cb_ya_fp + \l_semio_viz_cb_yb_fp ) / 2 }
      {
        ( \l_semio_viz_cb_xa_fp + \l_semio_viz_cb_xb_fp ) / 2
        + \l_semio_viz_cb_u_fp * sin ( \l_semio_viz_cb_t_fp )
      }
      {
        ( \l_semio_viz_cb_ya_fp + \l_semio_viz_cb_yb_fp ) / 2
        + \l_semio_viz_cb_u_fp * cos ( \l_semio_viz_cb_t_fp )
      }
      { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@hairline ,
        -{Latex} }
  }
}
%endregion 🔖️Families

\ExplSyntaxOff
