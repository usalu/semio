  \fp_set:Nn \l_semio_viz_parl_inner_fp { 0.45 }
  \fp_set:Nn \l_semio_viz_parl_seat_fp { 1.1 }
  \tl_set:Nn \l_semio_viz_parl_seats_tl { share }
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / parliament } {#1}
  \semio_viz_cb_frame:
  \semio_viz_pol_centre:
  \semio_viz_parl_render:
}

\seq_new:N \l_semio_viz_parl_block_seq

% 🏛️ Runs the parliament family once its keys are set.
\cs_new_protected:Npn \semio_viz_parl_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_parl_seats_tl }
  \seq_clear:N \l_semio_viz_parl_block_seq
  \int_zero:N \l_semio_viz_cb_series_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_series_int
    \int_step_inline:nn { \fp_to_int:n { round (##1) } }
      { \seq_put_right:Nx \l_semio_viz_parl_block_seq { \int_use:N \l_semio_viz_cb_series_int } }
  }
  \int_set:Nn \l_semio_viz_parl_total_int { \seq_count:N \l_semio_viz_parl_block_seq }
  \int_zero:N \l_semio_viz_parl_seat_int
  \seq_map_inline:Nn \l_semio_viz_parl_block_seq {
    \int_incr:N \l_semio_viz_parl_seat_int
    \semio_viz_parl_seat:nn { \l_semio_viz_parl_seat_int } {##1}
  }
}
\int_new:N \l_semio_viz_parl_total_int
\int_new:N \l_semio_viz_parl_seat_int
\int_new:N \l_semio_viz_parl_row_int
\int_new:N \l_semio_viz_parl_percol_int

% 🪑 One seat: index #1 of the total, coloured by party #2.
\cs_new_protected:Npn \semio_viz_parl_seat:nn #1#2 {
  \int_set:Nn \l_semio_viz_parl_percol_int
    {
      \fp_to_int:n
        { ceil ( \l_semio_viz_parl_total_int / \l_semio_viz_parl_rows_int ) }
    }
  \int_set:Nn \l_semio_viz_parl_row_int
    { \int_div_truncate:nn { (#1) - 1 } { \l_semio_viz_parl_percol_int } }
  \fp_set:Nn \l_semio_viz_cb_a_fp
    {
      \l_semio_viz_pol_r_fp
      * ( \l_semio_viz_parl_inner_fp
          + ( 1 - \l_semio_viz_parl_inner_fp ) * \l_semio_viz_parl_row_int
            / max ( 1 , \l_semio_viz_parl_rows_int - 1 ) )
    }
  \fp_set:Nn \l_semio_viz_cb_b_fp
    {
      - \l_semio_viz_parl_spread_fp / 2
      + \l_semio_viz_parl_spread_fp
        * ( \int_mod:nn { (#1) - 1 } { \l_semio_viz_parl_percol_int } )
        / max ( 1 , \l_semio_viz_parl_percol_int - 1 )
    }
  \semio_viz_g_circle:nnnn
    { \semio_viz_pol_x:nn { \l_semio_viz_cb_b_fp } { \l_semio_viz_cb_a_fp } }
    { \semio_viz_pol_y:nn { \l_semio_viz_cb_b_fp } { \l_semio_viz_cb_a_fp } }
    { \l_semio_viz_parl_seat_fp }
    { fill = \semio_viz_palette:n {#2} , draw = semio-chrome-canvas ,
      line~width = \semio@stroke@hairline }
}

% 🧇 Waffle, unit, icon array and pictogram: one cell per unit of the value.
\SemioVizFamily { waffle } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-parts }
  \int_set:Nn \l_semio_viz_waffle_rows_int { 5 }
  \int_set:Nn \l_semio_viz_waffle_cols_int { 20 }
  \tl_set:Nn \l_semio_viz_waffle_shape_tl { square }
  \fp_zero:N \l_semio_viz_waffle_unit_fp
  \tl_set:Nn \l_semio_viz_waffle_amount_tl { share }
  \fp_set:Nn \l_semio_viz_waffle_gap_fp { 0.5 }
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / waffle } {#1}
  \semio_viz_cb_frame:
  \semio_viz_waffle_render:
}

% 🧇 Runs the waffle family once its keys are set.
\cs_new_protected:Npn \semio_viz_waffle_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_waffle_amount_tl }
  \semio_viz_tr_stat_sum:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_c_fp
  \fp_compare:nT { \l_semio_viz_waffle_unit_fp <= 0 } {
    \fp_set:Nn \l_semio_viz_waffle_unit_fp
      {
        \l_semio_viz_cb_c_fp
        / max ( 1 , \l_semio_viz_waffle_rows_int * \l_semio_viz_waffle_cols_int )
      }
  }
  \fp_set:Nn \l_semio_viz_cb_w_fp
    {
      ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp ) / \l_semio_viz_waffle_cols_int
    }
  \fp_set:Nn \l_semio_viz_cb_h_fp
    {
      ( \l_semio_viz_cb_yb_fp - \l_semio_viz_cb_ya_fp ) / \l_semio_viz_waffle_rows_int
    }
  \int_zero:N \l_semio_viz_cb_i_int
  \int_zero:N \l_semio_viz_cb_series_int
  \seq_map_inline:Nn \l_semio_viz_pol_values_seq {
    \int_incr:N \l_semio_viz_cb_series_int
    \int_step_inline:nn
      { \fp_to_int:n { round ( ##1 / \l_semio_viz_waffle_unit_fp ) } }
      { \semio_viz_waffle_cell:n { \l_semio_viz_cb_series_int } }
  }
}

% 🧇 Draws the next waffle cell in the colour of part #1.
\cs_new_protected:Npn \semio_viz_waffle_cell:n #1 {
  \int_compare:nNnF { \l_semio_viz_cb_i_int } >
    { \l_semio_viz_waffle_rows_int * \l_semio_viz_waffle_cols_int - 1 }
    {
      \fp_set:Nn \l_semio_viz_cb_t_fp
        {
          \l_semio_viz_cb_xa_fp
          + \int_mod:nn { \l_semio_viz_cb_i_int } { \l_semio_viz_waffle_cols_int }
            * \l_semio_viz_cb_w_fp
        }
      \fp_set:Nn \l_semio_viz_cb_u_fp
        {
          \l_semio_viz_cb_ya_fp
          + \int_div_truncate:nn { \l_semio_viz_cb_i_int } { \l_semio_viz_waffle_cols_int }
            * \l_semio_viz_cb_h_fp
        }
      \str_if_eq:VnTF \l_semio_viz_waffle_shape_tl { circle }
        {
          \semio_viz_g_circle:nnnn
            { \l_semio_viz_cb_t_fp + \l_semio_viz_cb_w_fp / 2 }
            { \l_semio_viz_cb_u_fp + \l_semio_viz_cb_h_fp / 2 }
            { min ( \l_semio_viz_cb_w_fp , \l_semio_viz_cb_h_fp ) / 2
              - \l_semio_viz_waffle_gap_fp / 2 }
            { fill = \semio_viz_palette:n {#1} , draw = none }
        }
        {
          \semio_viz_g_rect:nnnnn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
            { \l_semio_viz_cb_w_fp - \l_semio_viz_waffle_gap_fp }
            { \l_semio_viz_cb_h_fp - \l_semio_viz_waffle_gap_fp }
            { fill = \semio_viz_palette:n {#1} , draw = none }
        }
      \int_incr:N \l_semio_viz_cb_i_int
    }
}

% 🟫 Marimekko, mekko, mosaic and spine: column widths from the block totals, heights from the shares.
\SemioVizFamily { marimekko } {
  \semio_viz_cb_reset:
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-parts }
  \tl_set:Nn \l_semio_viz_mek_mode_tl { marimekko }
  \tl_set:Nn \l_semio_viz_mek_column_tl { group }
  \tl_set:Nn \l_semio_viz_mek_amount_tl { share }
  \fp_set:Nn \l_semio_viz_mek_gap_fp { 0.4 }
  \keys_set:nn { semio / viz / family / common } {#1}
  \keys_set:nn { semio / viz / family / marimekko } {#1}
  \semio_viz_cb_frame:
  \semio_viz_mek_render:
}

\seq_new:N \l_semio_viz_mek_groups_seq
\seq_new:N \l_semio_viz_mek_levels_seq

% 🟫 Runs the marimekko family once its keys are set.
\cs_new_protected:Npn \semio_viz_mek_render: {
  \semio_viz_tr_stat_from_table:Nnn \l_semio_viz_pol_values_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_mek_amount_tl }
  \semio_viz_tr_stat_labels_from_table:Nnn \l_semio_viz_mek_groups_seq
    { \l_semio_viz_cb_data_tl } { \l_semio_viz_mek_column_tl }
  \seq_clear:N \l_semio_viz_mek_levels_seq
  \seq_map_inline:Nn \l_semio_viz_mek_groups_seq {
    \seq_if_in:NnF \l_semio_viz_mek_levels_seq {##1}
      { \seq_put_right:Nn \l_semio_viz_mek_levels_seq {##1} }
  }
  \semio_viz_tr_stat_sum:NN \l_semio_viz_pol_values_seq \l_semio_viz_cb_c_fp
  \fp_compare:nT { \l_semio_viz_cb_c_fp <= 0 } { \fp_set:Nn \l_semio_viz_cb_c_fp { 1 } }
  \fp_set_eq:NN \l_semio_viz_cb_t_fp \l_semio_viz_cb_xa_fp
  \int_zero:N \l_semio_viz_cb_series_int
  \seq_map_inline:Nn \l_semio_viz_mek_levels_seq {
    \int_incr:N \l_semio_viz_cb_series_int
    \semio_viz_mek_column:n {##1}
  }
}

% 🟫 One block column of the mosaic: width from the block total, stacked segments inside.
\cs_new_protected:Npn \semio_viz_mek_column:n #1 {
  \fp_zero:N \l_semio_viz_cb_a_fp
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_mek_groups_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \str_if_eq:nnT {##1} {#1}
      {
        \fp_add:Nn \l_semio_viz_cb_a_fp
          { \seq_item:Nn \l_semio_viz_pol_values_seq { \l_semio_viz_cb_j_int } }
      }
  }
  \str_if_eq:VnTF \l_semio_viz_mek_mode_tl { spine }
    {
      \fp_set:Nn \l_semio_viz_cb_w_fp
        {
          ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp )
          / \seq_count:N \l_semio_viz_mek_levels_seq
        }
    }
    {
      \fp_set:Nn \l_semio_viz_cb_w_fp
        {
          ( \l_semio_viz_cb_xb_fp - \l_semio_viz_cb_xa_fp )
          * \l_semio_viz_cb_a_fp / \l_semio_viz_cb_c_fp
        }
    }
  \fp_set_eq:NN \l_semio_viz_cb_u_fp \l_semio_viz_cb_ya_fp
  \int_zero:N \l_semio_viz_cb_j_int
  \seq_map_inline:Nn \l_semio_viz_mek_groups_seq {
    \int_incr:N \l_semio_viz_cb_j_int
    \str_if_eq:nnT {##1} {#1} { \semio_viz_mek_segment:n { \l_semio_viz_cb_j_int } }
  }
  \fp_set:Nn \l_semio_viz_cb_t_fp { \l_semio_viz_cb_t_fp + \l_semio_viz_cb_w_fp }
}

% 🟫 One stacked segment of the current mosaic column.
\cs_new_protected:Npn \semio_viz_mek_segment:n #1 {
  \fp_set:Nn \l_semio_viz_cb_h_fp
    {
      ( \l_semio_viz_cb_yb_fp - \l_semio_viz_cb_ya_fp )
      * \seq_item:Nn \l_semio_viz_pol_values_seq {#1}
      / max ( 1e-9 , \l_semio_viz_cb_a_fp )
    }
  \semio_viz_g_rect:nnnnn { \l_semio_viz_cb_t_fp } { \l_semio_viz_cb_u_fp }
    { \l_semio_viz_cb_w_fp - \l_semio_viz_mek_gap_fp } { \l_semio_viz_cb_h_fp }
    { fill = \semio_viz_palette:n {#1} , fill~opacity = 0.85 , draw = semio-chrome-canvas ,
      line~width = \semio@stroke@hairline }
  \fp_set:Nn \l_semio_viz_cb_u_fp { \l_semio_viz_cb_u_fp + \l_semio_viz_cb_h_fp }
}

