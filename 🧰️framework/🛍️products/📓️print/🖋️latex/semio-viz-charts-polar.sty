% 🔑 Pie keys, `semio / viz / family / pie`.
% inner      (fp, default 0)        inner radius as a fraction of the outer radius
% outer      (mm, default 0)        outer radius; 0 fits the frame
% start      (fp, default 0)        start angle in radians, zero at twelve o'clock
% end        (fp, default 6.283185307179586) end angle in radians
% pad        (fp, default 0)        pad angle in radians
% sort       (choice `descending|ascending|none`, default descending)
% explode    (mm, default 0)        radial offset of every slice from the centre
% rings      (int, default 1)       concentric rings; ring r uses the r-th value column
% gauge      (bool, default false)  draw only the first value as a filled gauge arc
% labels     (bool, default false)  print the label column beside each slice
\fp_new:N \l_semio_viz_piechart_inner_fp
\fp_new:N \l_semio_viz_piechart_outer_fp
