}
\int_new:N \l_semio_viz_tr_peak_int
\fp_new:N \l_semio_viz_tr_peak_fp
% 🥇 The x position at which the series at order position #1 is largest.
\cs_new:Npn \semio_viz_tr_series_peak:n #1
  { \semio_viz_tr_series_peak_do:n {#1} \int_use:N \l_semio_viz_tr_peak_int }
% 🔎 The scan behind `\semio_viz_tr_series_peak:n`; it leaves its answer in the peak integer.
\cs_new_protected:Npn \semio_viz_tr_series_peak_do:n #1 {
