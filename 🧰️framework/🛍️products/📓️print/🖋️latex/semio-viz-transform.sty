  { Unknown~window~'#1'~(known:~movingAverage,~cumulativeSum,~rank,~lag). }
\msg_new:nnn { semio-viz } { unknown-regression }
  { Unknown~regression~'#1'~(known:~linear,~poly,~exp,~log,~pow). }
