}

% ➕ Orders the series by their total, ascending.
\cs_new_protected:Npn \semio_viz_tr_order_sums: {
  \seq_sort:Nn \l_semio_viz_tr_order_seq
    {
      \fp_compare:nNnTF { \semio_viz_tr_series_sum:n {##1} } > { \semio_viz_tr_series_sum:n {##2} }
        { \sort_return_swapped: } { \sort_return_same: }
    }
}
% ➕ Total of the series at order position #1 over every x position.
\cs_new:Npn \semio_viz_tr_series_sum:n #1
  { \fp_eval:n { \seq_use:cn { l_semio_viz_tr_col_ \int_eval:n {#1} _seq } { + } } }

% 🥇 Orders the series by the x position of their largest value.
\cs_new_protected:Npn \semio_viz_tr_order_appearance: {
  \seq_sort:Nn \l_semio_viz_tr_order_seq
    {
      \int_compare:nNnTF { \semio_viz_tr_series_peak:n {##1} }
        > { \semio_viz_tr_series_peak:n {##2} }
        { \sort_return_swapped: } { \sort_return_same: }
