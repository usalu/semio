  \int_zero:N \l_semio_viz_tr_row_int
  \seq_map_inline:Nn \l_semio_viz_tr_rows_seq
    {
      \int_incr:N \l_semio_viz_tr_row_int
      \semio_viz_tr_window_value:nnN {#1} {#3} \l_semio_viz_tr_value_fp
      \seq_put_right:Nx \l_semio_viz_tr_out_rows_seq
        {
