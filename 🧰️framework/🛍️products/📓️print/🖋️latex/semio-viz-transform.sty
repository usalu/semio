\fp_new:N \l_semio_viz_tr_xhi_fp
\seq_new:N \l_semio_viz_tr_edges_seq

% 🪣 Bins a numeric column into the columns `x0`, `x1` and `count`, following d3-array's bin.
\cs_new_protected:Npn \semio_viz_tr_bin:n #1 {
  \semio_viz_tr_column_values:nN {#1} \l_semio_viz_tr_values_seq
  \int_set:Nn \l_semio_viz_tr_n_int { \seq_count:N \l_semio_viz_tr_values_seq }
  \fp_set:Nn \l_semio_viz_tr_xlo_fp { \seq_item:Nn \l_semio_viz_tr_values_seq { 1 } }
  \fp_set_eq:NN \l_semio_viz_tr_xhi_fp \l_semio_viz_tr_xlo_fp
  \seq_map_inline:Nn \l_semio_viz_tr_values_seq
    {
      \fp_set:Nn \l_semio_viz_tr_xlo_fp { min( \l_semio_viz_tr_xlo_fp , ##1 ) }
      \fp_set:Nn \l_semio_viz_tr_xhi_fp { max( \l_semio_viz_tr_xhi_fp , ##1 ) }
    }
  \semio_viz_tr_bin_edges:
  \clist_set:Nn \l_semio_viz_tr_out_cols_clist { x0, x1, count }
  \seq_clear:N \l_semio_viz_tr_out_rows_seq
  \int_step_inline:nn { \seq_count:N \l_semio_viz_tr_edges_seq - 1 }
    {
      \int_zero:N \l_semio_viz_tr_count_int
      \seq_map_inline:Nn \l_semio_viz_tr_values_seq
        {
          \fp_compare:nT
            {
              \seq_item:Nn \l_semio_viz_tr_edges_seq { ##1 } <= ####1
            }
            {
              \bool_lazy_or:nnT
                {
                  \fp_compare_p:nNn { ####1 }
                    < { \seq_item:Nn \l_semio_viz_tr_edges_seq { ##1 + 1 } }
                }
                {
                  \int_compare_p:nNn { ##1 } = { \seq_count:N \l_semio_viz_tr_edges_seq - 1 }
                }
                { \int_incr:N \l_semio_viz_tr_count_int }
            }
        }
      \seq_put_right:Nx \l_semio_viz_tr_out_rows_seq
        {
          { \seq_item:Nn \l_semio_viz_tr_edges_seq { ##1 } } ,
          { \seq_item:Nn \l_semio_viz_tr_edges_seq { ##1 + 1 } } ,
          { \int_use:N \l_semio_viz_tr_count_int }
        }
    }
  \semio_viz_tr_commit:
}
\int_new:N \l_semio_viz_tr_count_int

% 🪜 Builds the bin edges from the `thresholds` key: sturges, count:n, width:w or an explicit list.
\cs_new_protected:Npn \semio_viz_tr_bin_edges: {
  \semio_viz_tr_args:N \l_semio_viz_tr_thresholds_tl
  \str_case:VnF \l_semio_viz_tr_arga_tl
    {
      { sturges }
        {
          \int_set:Nn \l_semio_viz_tr_bins_int
            { \fp_to_int:n { ceil( ln( \l_semio_viz_tr_n_int ) / ln(2) ) } + 1 }
          \semio_viz_tr_bin_ticks:
        }
      { count }
        {
          \int_set:Nn \l_semio_viz_tr_bins_int { \l_semio_viz_tr_argb_tl }
          \semio_viz_tr_bin_ticks:
        }
      { width }
        {
          \seq_clear:N \l_semio_viz_tr_edges_seq
          \fp_set:Nn \l_semio_viz_tr_step_fp { \l_semio_viz_tr_argb_tl }
          \fp_set:Nn \l_semio_viz_tr_pos_fp
            {
              floor( \l_semio_viz_tr_xlo_fp / \l_semio_viz_tr_step_fp ) * \l_semio_viz_tr_step_fp
            }
          \bool_while_do:nn
            { \fp_compare_p:n { \l_semio_viz_tr_pos_fp <= \l_semio_viz_tr_xhi_fp } }
            {
              \seq_put_right:Nx \l_semio_viz_tr_edges_seq
                { \fp_to_decimal:n { round( \l_semio_viz_tr_pos_fp , 6 ) } }
              \fp_add:Nn \l_semio_viz_tr_pos_fp { \l_semio_viz_tr_step_fp }
            }
          \seq_put_right:Nx \l_semio_viz_tr_edges_seq
            { \fp_to_decimal:n { round( \l_semio_viz_tr_pos_fp , 6 ) } }
        }
    }
    {
      \seq_set_split:NnV \l_semio_viz_tr_edges_seq { ; } \l_semio_viz_tr_thresholds_tl
      \seq_put_left:Nx \l_semio_viz_tr_edges_seq
        { \fp_to_decimal:n { \l_semio_viz_tr_xlo_fp } }
      \seq_put_right:Nx \l_semio_viz_tr_edges_seq
        { \fp_to_decimal:n { \l_semio_viz_tr_xhi_fp } }
    }
}
\int_new:N \l_semio_viz_tr_bins_int
\fp_new:N \l_semio_viz_tr_step_fp
\fp_new:N \l_semio_viz_tr_pos_fp
\fp_new:N \l_semio_viz_tr_max_fp

% 🪜 d3-array's bin edges for a bin count: nice the extent, take ticks, then trim and cap.
\cs_new_protected:Npn \semio_viz_tr_bin_ticks: {
  \fp_set_eq:NN \l_semio_viz_tr_max_fp \l_semio_viz_tr_xhi_fp
  \semio_viz_scale_nice_pair:nnnNN { \l_semio_viz_tr_xlo_fp } { \l_semio_viz_tr_xhi_fp }
    { \l_semio_viz_tr_bins_int } \l_semio_viz_tr_xlo_fp \l_semio_viz_tr_xhi_fp
  \semio_viz_scale_tick_values:nnnN { \l_semio_viz_tr_xlo_fp } { \l_semio_viz_tr_xhi_fp }
    { \l_semio_viz_tr_bins_int } \l_semio_viz_tr_edges_seq
  \fp_compare:nT
    { \seq_item:Nn \l_semio_viz_tr_edges_seq { -1 } >= \l_semio_viz_tr_xhi_fp }
    {
      \fp_compare:nTF { \l_semio_viz_tr_max_fp >= \l_semio_viz_tr_xhi_fp }
        {
          \semio_viz_scale_tick_increment:nnnN { \l_semio_viz_tr_xlo_fp }
            { \l_semio_viz_tr_xhi_fp } { \l_semio_viz_tr_bins_int } \l_semio_viz_tr_step_fp
          \fp_compare:nNnTF { \l_semio_viz_tr_step_fp } > { 0 }
            {
              \fp_set:Nn \l_semio_viz_tr_xhi_fp
                {
                  ( floor( \l_semio_viz_tr_xhi_fp / \l_semio_viz_tr_step_fp ) + 1 )
                    * \l_semio_viz_tr_step_fp
                }
            }
            {
              \fp_compare:nNnT { \l_semio_viz_tr_step_fp } < { 0 }
                {
                  \fp_set:Nn \l_semio_viz_tr_xhi_fp
                    {
                      ( ceil( \l_semio_viz_tr_xhi_fp * -\l_semio_viz_tr_step_fp ) + 1 )
                        / -\l_semio_viz_tr_step_fp
                    }
                }
            }
        }
        { \seq_pop_right:NN \l_semio_viz_tr_edges_seq \l_tmpa_tl }
    }
  \bool_while_do:nn
    {
      ! \seq_if_empty_p:N \l_semio_viz_tr_edges_seq &&
      \fp_compare_p:n
        { \seq_item:Nn \l_semio_viz_tr_edges_seq { 1 } <= \l_semio_viz_tr_xlo_fp }
    }
    { \seq_pop_left:NN \l_semio_viz_tr_edges_seq \l_tmpa_tl }
  \bool_while_do:nn
    {
      ! \seq_if_empty_p:N \l_semio_viz_tr_edges_seq &&
      \fp_compare_p:n
        { \seq_item:Nn \l_semio_viz_tr_edges_seq { -1 } > \l_semio_viz_tr_xhi_fp }
    }
    { \seq_pop_right:NN \l_semio_viz_tr_edges_seq \l_tmpa_tl }
  \seq_put_left:Nx \l_semio_viz_tr_edges_seq { \fp_to_decimal:n { \l_semio_viz_tr_xlo_fp } }
  \seq_put_right:Nx \l_semio_viz_tr_edges_seq { \fp_to_decimal:n { \l_semio_viz_tr_xhi_fp } }
}
