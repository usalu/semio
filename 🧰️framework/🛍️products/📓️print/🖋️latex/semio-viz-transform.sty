% 🌀 d3's inside-out order: appearance order, then alternately stacked from the middle outwards.
\cs_new_protected:Npn \semio_viz_tr_order_inside_out: {
  \semio_viz_tr_order_appearance:
  \seq_clear:N \l_semio_viz_tr_top_seq
  \seq_clear:N \l_semio_viz_tr_bottom_seq
  \fp_zero:N \l_semio_viz_tr_top_fp
  \fp_zero:N \l_semio_viz_tr_bottom_fp
  \seq_map_inline:Nn \l_semio_viz_tr_order_seq
    {
      \fp_compare:nNnTF { \l_semio_viz_tr_top_fp } < { \l_semio_viz_tr_bottom_fp }
        {
          \fp_add:Nn \l_semio_viz_tr_top_fp { \semio_viz_tr_series_sum:n {##1} }
          \seq_put_right:Nn \l_semio_viz_tr_top_seq {##1}
        }
        {
          \fp_add:Nn \l_semio_viz_tr_bottom_fp { \semio_viz_tr_series_sum:n {##1} }
          \seq_put_right:Nn \l_semio_viz_tr_bottom_seq {##1}
        }
    }
  \seq_reverse:N \l_semio_viz_tr_bottom_seq
  \seq_set_eq:NN \l_semio_viz_tr_order_seq \l_semio_viz_tr_bottom_seq
  \seq_concat:NNN \l_semio_viz_tr_order_seq \l_semio_viz_tr_order_seq \l_semio_viz_tr_top_seq
}
\seq_new:N \l_semio_viz_tr_top_seq
\seq_new:N \l_semio_viz_tr_bottom_seq
\fp_new:N \l_semio_viz_tr_top_fp
\fp_new:N \l_semio_viz_tr_bottom_fp

% 📐 Baselines: none, expand, diverging, silhouette or wiggle, exactly as d3-shape.
\cs_new_protected:Npn \semio_viz_tr_stack_offset: {
  \int_step_inline:nn { \seq_count:N \l_semio_viz_tr_order_seq }
    {
