  \fp_set:Nn \l_semio_viz_tr_peak_fp { \semio_viz_tr_v:nn {#1} { 1 } }
  \int_step_inline:nn { \seq_count:N \l_semio_viz_tr_xs_seq }
    {
      \fp_compare:nNnT { \semio_viz_tr_v:nn {#1} {##1} } > { \l_semio_viz_tr_peak_fp }
        {
          \fp_set:Nn \l_semio_viz_tr_peak_fp { \semio_viz_tr_v:nn {#1} {##1} }
