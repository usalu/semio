%region 🔖️Distributions
\fp_new:N \l_semio_viz_sci_a_fp
\fp_new:N \l_semio_viz_sci_b_fp
\fp_new:N \l_semio_viz_sci_c_fp
\fp_new:N \l_semio_viz_sci_d_fp
\fp_new:N \l_semio_viz_sci_e_fp
\fp_new:N \l_semio_viz_sci_f_fp
\fp_new:N \l_semio_viz_sci_g_fp
\fp_new:N \l_semio_viz_sci_h_step_fp
\fp_new:N \SemioX
\fp_new:N \SemioY
\fp_new:N \SemioT

% ✅ True when an fp expression is finite and inside the plottable magnitude window.
\prg_new_conditional:Npnn \semio_viz_tr_finite:n #1 { T, F, TF }
  {
    \fp_compare:nNnTF {#1} = {#1}
      { \fp_compare:nNnTF { abs (#1) } < { 1e8 } { \prg_return_true: } { \prg_return_false: } }
      { \prg_return_false: }
  }

% 📐 Error function, Abramowitz–Stegun 7.1.26 (|error| < 1.5e-7), the base of every normal-law value.
\cs_new:Npn \semio_viz_tr_dist_erf:n #1
  {
    \fp_eval:n
      {
        ( #1 < 0 ? -1 : 1 ) *
        ( 1 - ( ( ( ( ( 1.061405429 * ( 1 / ( 1 + 0.3275911 * abs (#1) ) ) - 1.453152027 )
          * ( 1 / ( 1 + 0.3275911 * abs (#1) ) ) + 1.421413741 )
          * ( 1 / ( 1 + 0.3275911 * abs (#1) ) ) - 0.284496736 )
          * ( 1 / ( 1 + 0.3275911 * abs (#1) ) ) + 0.254829592 )
          * ( 1 / ( 1 + 0.3275911 * abs (#1) ) ) ) * exp ( - abs (#1) * abs (#1) ) )
      }
  }

% 📐 Log-gamma of a positive argument by the Lanczos approximation (g=7, n=9), the base of every factorial-bearing mass function.
\cs_new:Npn \semio_viz_tr_dist_lgamma:n #1
  { \fp_eval:n { \semio_viz_tr_dist_lgamma_series:n {#1} } }
% 📐 The bare Lanczos expression, so the fp evaluation happens once in the caller.
\cs_new:Npn \semio_viz_tr_dist_lgamma_series:n #1
  {
    ( 0.5 * ln ( 2 * pi ) + ( #1 - 0.5 ) * ln ( #1 - 1 + 7.5 ) - ( #1 - 1 + 7.5 )
      + ln ( 0.99999999999980993
        + 676.5203681218851 / ( #1 - 1 + 1 )
        - 1259.1392167224028 / ( #1 - 1 + 2 )
        + 771.32342877765313 / ( #1 - 1 + 3 )
        - 176.61502916214059 / ( #1 - 1 + 4 )
        + 12.507343278686905 / ( #1 - 1 + 5 )
        - 0.13857109526572012 / ( #1 - 1 + 6 )
        + 9.9843695780195716e-6 / ( #1 - 1 + 7 )
        + 1.5056327351493116e-7 / ( #1 - 1 + 8 ) ) )
  }

% 📐 Log binomial coefficient ln C(n,k).
\cs_new:Npn \semio_viz_tr_dist_lchoose:nn #1#2
  { \fp_eval:n { \semio_viz_tr_dist_lgamma:n { #1 + 1 } - \semio_viz_tr_dist_lgamma:n { #2 + 1 } - \semio_viz_tr_dist_lgamma:n { #1 - #2 + 1 } } }

% 📐 Regularised incomplete beta I_x(a,b) by the Lentz continued fraction (200 terms, 1e-12 target).
\fp_new:N \l_semio_viz_sci_ib_c_fp
\fp_new:N \l_semio_viz_sci_ib_d_fp
\fp_new:N \l_semio_viz_sci_ib_h_fp
\fp_new:N \l_semio_viz_sci_ib_num_fp
\int_new:N \l_semio_viz_sci_ib_int
\cs_new_protected:Npn \semio_viz_tr_dist_ibeta:nnnN #1#2#3#4
  {
    \fp_compare:nNnTF {#3} > { ( #1 + 1 ) / ( #1 + #2 + 2 ) }
      {
        \semio_viz_tr_dist_ibeta_cf:nnnN {#2} {#1} { \fp_eval:n { 1 - #3 } } #4
        \fp_set:Nn #4 { 1 - #4 }
      }
      { \semio_viz_tr_dist_ibeta_cf:nnnN {#1} {#2} {#3} #4 }
  }
% 🪜 Lentz's continued fraction for the regularised incomplete beta I_#3(#1,#2), 120 terms into #4.
\cs_new_protected:Npn \semio_viz_tr_dist_ibeta_cf:nnnN #1#2#3#4
  {
    \fp_compare:nNnTF {#3} = { 0 }
      { \fp_zero:N #4 }
      {
        \fp_set:Nn \l_semio_viz_sci_ib_c_fp { 1 }
        \fp_set:Nn \l_semio_viz_sci_ib_d_fp { 1 / ( 1 - ( #1 + #2 ) * #3 / ( #1 + 1 ) ) }
        \fp_set_eq:NN \l_semio_viz_sci_ib_h_fp \l_semio_viz_sci_ib_d_fp
        \int_step_inline:nnnn { 1 } { 1 } { 120 }
          {
            \fp_set:Nn \l_semio_viz_sci_ib_num_fp
              { ##1 * ( #2 - ##1 ) * #3 / ( ( #1 + 2 * ##1 - 1 ) * ( #1 + 2 * ##1 ) ) }
            \semio_viz_tr_dist_ibeta_step:
            \fp_set:Nn \l_semio_viz_sci_ib_num_fp
              { - ( #1 + ##1 ) * ( #1 + #2 + ##1 ) * #3 / ( ( #1 + 2 * ##1 ) * ( #1 + 2 * ##1 + 1 ) ) }
            \semio_viz_tr_dist_ibeta_step:
          }
        \fp_set:Nn #4
          {
            exp ( #1 * ln (#3) + #2 * ln ( 1 - #3 )
              + \semio_viz_tr_dist_lgamma:n { #1 + #2 } - \semio_viz_tr_dist_lgamma:n {#1} - \semio_viz_tr_dist_lgamma:n {#2} )
            * \l_semio_viz_sci_ib_h_fp / #1
          }
      }
  }
% ↪️ One Lentz iteration over the numerator already in place: update d, c and the running product.
\cs_new_protected:Npn \semio_viz_tr_dist_ibeta_step:
  {
    \fp_set:Nn \l_semio_viz_sci_ib_d_fp { 1 / ( 1 + \l_semio_viz_sci_ib_num_fp * \l_semio_viz_sci_ib_d_fp ) }
    \fp_set:Nn \l_semio_viz_sci_ib_c_fp { 1 + \l_semio_viz_sci_ib_num_fp / \l_semio_viz_sci_ib_c_fp }
    \fp_set:Nn \l_semio_viz_sci_ib_h_fp { \l_semio_viz_sci_ib_h_fp * \l_semio_viz_sci_ib_c_fp * \l_semio_viz_sci_ib_d_fp }
  }

% 🎲 Density (pdf for continuous laws, pmf for discrete ones) of `#1` with parameters `#2`,`#3` at `#4`.
\cs_new_protected:Npn \semio_viz_tr_dist_pdf:nnnnN #1#2#3#4#5
  {
    \str_case:nnF {#1}
      {
        { normal }      { \fp_set:Nn #5 { exp ( -0.5 * ( ( #4 - #2 ) / #3 ) ^ 2 ) / ( #3 * sqrt ( 2 * pi ) ) } }
        { exponential } { \fp_set:Nn #5 { #4 < 0 ? 0 : #2 * exp ( - #2 * #4 ) } }
        { uniform }     { \fp_set:Nn #5 { ( #4 < #2 || #4 > #3 ) ? 0 : 1 / ( #3 - #2 ) } }
        { beta }        { \fp_set:Nn #5 { ( #4 <= 0 || #4 >= 1 ) ? 0 : exp (
                            ( #2 - 1 ) * ln ( max ( 1e-12 , min ( 1 , #4 ) ) )
                            + ( #3 - 1 ) * ln ( max ( 1e-12 , 1 - min ( 1 , max ( 0 , #4 ) ) ) )
                            + \semio_viz_tr_dist_lgamma:n { #2 + #3 } - \semio_viz_tr_dist_lgamma:n {#2} - \semio_viz_tr_dist_lgamma:n {#3} ) } }
        { binomial }    { \fp_set:Nn #5 { ( #4 < 0 || #4 > #2 ) ? 0 : exp (
                            \semio_viz_tr_dist_lchoose:nn {#2} { min ( #2 , max ( 0 , #4 ) ) }
                            + min ( #2 , max ( 0 , #4 ) ) * ln (#3)
                            + ( #2 - min ( #2 , max ( 0 , #4 ) ) ) * ln ( 1 - #3 ) ) } }
        { poisson }     { \fp_set:Nn #5 { #4 < 0 ? 0 : exp ( - #2 + max ( 0 , #4 ) * ln (#2)
                            - \semio_viz_tr_dist_lgamma:n { max ( 0 , #4 ) + 1 } ) } }
      }
      { \fp_zero:N #5 }
  }

% 🎲 Cumulative distribution function of `#1` with parameters `#2`,`#3` at `#4`.
\fp_new:N \l_semio_viz_sci_cdf_acc_fp
\cs_new_protected:Npn \semio_viz_tr_dist_cdf:nnnnN #1#2#3#4#5
  {
    \str_case:nnF {#1}
      {
        { normal }      { \fp_set:Nn #5 { 0.5 * ( 1 + \semio_viz_tr_dist_erf:n { ( #4 - #2 ) / ( #3 * sqrt (2) ) } ) } }
        { exponential } { \fp_set:Nn #5 { #4 < 0 ? 0 : 1 - exp ( - #2 * #4 ) } }
        { uniform }     { \fp_set:Nn #5 { #4 < #2 ? 0 : ( #4 > #3 ? 1 : ( #4 - #2 ) / ( #3 - #2 ) ) } }
        { beta }        { \semio_viz_tr_dist_ibeta:nnnN {#2} {#3} { \fp_eval:n { min ( 1 , max ( 0 , #4 ) ) } } #5 }
        { binomial }    { \semio_viz_tr_dist_cdf_sum:nnnnN { binomial } {#2} {#3} {#4} #5 }
        { poisson }     { \semio_viz_tr_dist_cdf_sum:nnnnN { poisson } {#2} {#3} {#4} #5 }
      }
      { \fp_zero:N #5 }
  }
% 🧮 Distribution function of a discrete law: the mass function of `#1` summed up to #4, into #5.
\cs_new_protected:Npn \semio_viz_tr_dist_cdf_sum:nnnnN #1#2#3#4#5
  {
    \fp_zero:N \l_semio_viz_sci_cdf_acc_fp
    \int_step_inline:nnnn { 0 } { 1 } { \fp_eval:n { max ( 0 , floor (#4) ) } }
      {
        \semio_viz_tr_dist_pdf:nnnnN {#1} {#2} {#3} {##1} \l_semio_viz_sci_a_fp
        \fp_add:Nn \l_semio_viz_sci_cdf_acc_fp { \l_semio_viz_sci_a_fp }
      }
    \fp_set:Nn #5 { #4 < 0 ? 0 : \l_semio_viz_sci_cdf_acc_fp }
  }

\cs_generate_variant:Nn \semio_viz_tr_dist_pdf:nnnnN { VnnnN }
\cs_generate_variant:Nn \semio_viz_tr_dist_cdf:nnnnN { VnnnN }
\cs_generate_variant:Nn \semio_viz_tr_dist_cdf_sum:nnnnN { VnnnN }

% 🎲 Quantile by 60 bisection steps on the cdf over the given search bracket.
\fp_new:N \l_semio_viz_sci_q_lo_fp
\fp_new:N \l_semio_viz_sci_q_hi_fp
\fp_new:N \l_semio_viz_sci_q_mid_fp
\tl_new:N \l_semio_viz_sci_law_tl
\cs_new_protected:Npn \semio_viz_tr_dist_quantile:nnnnnnN #1#2#3#4#5#6#7
  {
    \tl_set:Nn \l_semio_viz_sci_law_tl {#1}
    \fp_set:Nn \l_semio_viz_sci_q_lo_fp {#5}
    \fp_set:Nn \l_semio_viz_sci_q_hi_fp {#6}
    \int_step_inline:nnnn { 1 } { 1 } { 60 }
      {
        \fp_set:Nn \l_semio_viz_sci_q_mid_fp { ( \l_semio_viz_sci_q_lo_fp + \l_semio_viz_sci_q_hi_fp ) / 2 }
        \semio_viz_tr_dist_cdf:VnnnN \l_semio_viz_sci_law_tl {#2} {#3} { \l_semio_viz_sci_q_mid_fp } \l_semio_viz_sci_a_fp
        \fp_compare:nNnTF { \l_semio_viz_sci_a_fp } < {#4}
          { \fp_set_eq:NN \l_semio_viz_sci_q_lo_fp \l_semio_viz_sci_q_mid_fp }
          { \fp_set_eq:NN \l_semio_viz_sci_q_hi_fp \l_semio_viz_sci_q_mid_fp }
      }
    \fp_set:Nn #7 { ( \l_semio_viz_sci_q_lo_fp + \l_semio_viz_sci_q_hi_fp ) / 2 }
  }
%endregion 🔖️Distributions

%region 🔖️LayoutRegistry
% 📐 `stack` and `bin` are transforms in this kernel and layout algorithms in taxonomy 75, so the
% layout dispatcher reaches them under their own names. The option list is the transform's own:
% `\SemioVizLayout{stack}{in}{out}[stack={x,series,value}, order=…, offset=…]`.
\semio_viz_layout_define:nn { stack }
  { \semio_viz_transform:nnn {#2} {#1} {#3} }
% 🪣 The same for `bin`: `\SemioVizLayout{bin}{in}{out}[bin=<column>, thresholds=…]`.
\semio_viz_layout_define:nn { bin }
  { \semio_viz_transform:nnn {#2} {#1} {#3} }
%endregion 🔖️LayoutRegistry

