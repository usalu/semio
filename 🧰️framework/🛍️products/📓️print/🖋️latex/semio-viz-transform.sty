%region 🔖️Variants
\prg_generate_conditional_variant:Nnn \regex_match:nn { nV } { TF }
\prg_generate_conditional_variant:Nnn \str_compare:nNn { eNe } { p }
\cs_generate_variant:Nn \seq_set_split:Nnn { NVV }
%endregion 🔖️Variants

%region 🔖️Diagnostics
