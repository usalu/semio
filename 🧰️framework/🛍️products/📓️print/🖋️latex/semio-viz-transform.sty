% 🪟 The windowed value at the current row index.
\cs_new_protected:Npn \semio_viz_tr_window_value:nnN #1#2#3 {
  \str_case:nnF {#1}
    {
      { movingAverage }
        {
          \int_set:Nn \l_semio_viz_tr_lo_int
            { \int_max:nn { 1 } { \l_semio_viz_tr_row_int - (#2) + 1 } }
          \fp_zero:N #3
          \int_step_inline:nnn { \l_semio_viz_tr_lo_int } { \l_semio_viz_tr_row_int }
            { \fp_add:Nn #3 { \seq_item:Nn \l_semio_viz_tr_values_seq { ##1 } } }
          \fp_set:Nn #3 { #3 / ( \l_semio_viz_tr_row_int - \l_semio_viz_tr_lo_int + 1 ) }
        }
      { cumulativeSum }
        {
          \fp_zero:N #3
          \int_step_inline:nn { \l_semio_viz_tr_row_int }
            { \fp_add:Nn #3 { \seq_item:Nn \l_semio_viz_tr_values_seq { ##1 } } }
        }
      { rank }
        {
          \fp_set:Nn #3 { 1 }
          \int_step_inline:nn { \l_semio_viz_tr_n_int }
            {
              \fp_compare:nNnT
                { \seq_item:Nn \l_semio_viz_tr_values_seq { ##1 } }
                < { \seq_item:Nn \l_semio_viz_tr_values_seq { \l_semio_viz_tr_row_int } }
                { \fp_add:Nn #3 { 1 } }
            }
        }
      { lag }
        {
          \int_compare:nNnTF { \l_semio_viz_tr_row_int - (#2) } < { 1 }
            { \fp_zero:N #3 }
            {
              \fp_set:Nn #3
                { \seq_item:Nn \l_semio_viz_tr_values_seq { \l_semio_viz_tr_row_int - (#2) } }
            }
        }
    }
    { \msg_error:nnn { semio-viz } { unknown-window } {#1} }
}
