% 🧺 Every value of a column of the working table, in row order.
\cs_new_protected:Npn \semio_viz_tr_column_values:nN #1#2 {
  \seq_clear:N #2
  \seq_map_inline:Nn \l_semio_viz_tr_rows_seq
    {
