    {
      \seq_if_exist:cF { l_semio_viz_tr_col_ ##1 _seq }
        { \seq_new:c { l_semio_viz_tr_col_ ##1 _seq } }
      \seq_clear:c { l_semio_viz_tr_col_ ##1 _seq }
      \tl_set:Nx \l_semio_viz_tr_series_tl { \seq_item:Nn \l_semio_viz_tr_series_seq { ##1 } }
      \seq_map_inline:Nn \l_semio_viz_tr_xs_seq
        {
          \semio_viz_tr_lookup:nVnnN {#2} \l_semio_viz_tr_series_tl {#1} {####1}
            \l_semio_viz_tr_cell_tl
          \tl_if_empty:NT \l_semio_viz_tr_cell_tl { \tl_set:Nn \l_semio_viz_tr_cell_tl { 0 } }
          \seq_put_right:cV { l_semio_viz_tr_col_ ##1 _seq } \l_semio_viz_tr_cell_tl
