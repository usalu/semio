%endregion 🔖️Diagnostics

%region 🔖️WorkingTable
% 🧰 Transforms run on a working table held in memory: a column list plus a sequence of rows.
% Every operation reads the working table and replaces it, so operations compose in one call.
\clist_new:N \l_semio_viz_tr_cols_clist
\seq_new:N \l_semio_viz_tr_rows_seq
\clist_new:N \l_semio_viz_tr_out_cols_clist
\seq_new:N \l_semio_viz_tr_out_rows_seq
\clist_new:N \l_semio_viz_tr_row_clist
\tl_new:N \l_semio_viz_tr_cell_tl
\int_new:N \l_semio_viz_tr_index_int

% 📥 Loads a registered table into the working table.
\cs_new_protected:Npn \semio_viz_tr_load:n #1 {
  \semio_viz_table_require:n {#1}
  \clist_set_eq:Nc \l_semio_viz_tr_cols_clist
    { g_semio_viz_table_ \l_semio_viz_tab_tl _cols_clist }
  \seq_set_eq:Nc \l_semio_viz_tr_rows_seq
    { g_semio_viz_table_ \l_semio_viz_tab_tl _rows_seq }
}

% 📤 Writes the working table out under a name.
\cs_new_protected:Npn \semio_viz_tr_store:n #1 {
  \semio_viz_table_new:nx {#1} { \clist_use:Nn \l_semio_viz_tr_cols_clist { , } }
  \seq_map_inline:Nn \l_semio_viz_tr_rows_seq { \semio_viz_table_row:nn {#1} {##1} }
}

% 🔁 Promotes the freshly built output table to the working table.
\cs_new_protected:Npn \semio_viz_tr_commit: {
  \clist_set_eq:NN \l_semio_viz_tr_cols_clist \l_semio_viz_tr_out_cols_clist
  \seq_set_eq:NN \l_semio_viz_tr_rows_seq \l_semio_viz_tr_out_rows_seq
}

% 🔢 One-based index of a column of the working table; zero when it is absent.
\cs_new_protected:Npn \semio_viz_tr_colindex:nN #1#2 {
  \int_zero:N #2
  \int_zero:N \l_semio_viz_tr_index_int
  \clist_map_inline:Nn \l_semio_viz_tr_cols_clist
    {
      \int_incr:N \l_semio_viz_tr_index_int
      \str_if_eq:nnT {##1} {#1} { \int_set_eq:NN #2 \l_semio_viz_tr_index_int }
    }
}
\cs_generate_variant:Nn \semio_viz_tr_colindex:nN { VN }

% 🧾 Cell of the row #1 in column #2 of the working table.
\cs_new_protected:Npn \semio_viz_tr_get:nnN #1#2#3 {
  \semio_viz_tr_colindex:nN {#2} \l_semio_viz_tr_col_int
  \clist_set:Nn \l_semio_viz_tr_row_clist {#1}
  \tl_set:Nx #3 { \clist_item:Nn \l_semio_viz_tr_row_clist { \l_semio_viz_tr_col_int } }
}
\int_new:N \l_semio_viz_tr_col_int
\cs_generate_variant:Nn \semio_viz_tr_get:nnN { nVN , VnN , VVN }

% 🧱 Appends a row built from the sequence #1 to the output table, brace-wrapping every field.
\cs_new_protected:Npn \semio_viz_tr_put:N #1 {
  \tl_clear:N \l_semio_viz_tr_text_tl
  \bool_set_true:N \l_semio_viz_tr_first_bool
  \seq_map_inline:Nn #1
    {
      \bool_if:NTF \l_semio_viz_tr_first_bool
        { \bool_set_false:N \l_semio_viz_tr_first_bool }
        { \tl_put_right:Nn \l_semio_viz_tr_text_tl { , } }
      \tl_put_right:Nn \l_semio_viz_tr_text_tl { {##1} }
    }
  \seq_put_right:NV \l_semio_viz_tr_out_rows_seq \l_semio_viz_tr_text_tl
}
\tl_new:N \l_semio_viz_tr_text_tl
\bool_new:N \l_semio_viz_tr_first_bool
\seq_new:N \l_semio_viz_tr_build_seq

% 🧮 Distinct values of a column of the working table, in order of first appearance.
\cs_new_protected:Npn \semio_viz_tr_distinct:nN #1#2 {
  \seq_clear:N #2
  \seq_map_inline:Nn \l_semio_viz_tr_rows_seq
    {
      \semio_viz_tr_get:nnN {##1} {#1} \l_semio_viz_tr_cell_tl
      \seq_if_in:NVF #2 \l_semio_viz_tr_cell_tl
        { \seq_put_right:NV #2 \l_semio_viz_tr_cell_tl }
    }
}
\cs_generate_variant:Nn \semio_viz_tr_distinct:nN { VN }
%endregion 🔖️WorkingTable

%region 🔖️Keys
% ⚙️ Transform vocabulary. Operations are applied in this fixed, documented order:
%   filter → sort → bin → group/rollup → fold → pivot → join → window → stack →
%   normalize → quantile → kde → regression
%   filter        fp predicate over bare column names, e.g. `val > 4 && val2 < 6`
%   sort          column to sort by; `descending` reverses the order
%   descending    boolean, default false
%   group         column whose distinct values become the groups
%   rollup        `<agg>:<column>`; agg is sum, mean, min, max, count or median
%   pivot         `<keyColumn>:<valueColumn>`; the group column stays as the row key
%   fold          `<idColumn>:<c1>;<c2>;…` long form with the columns `key` and `value`
%   join          `<table>:<leftColumn>:<rightColumn>` inner join on equal keys
%   window        `<kind>:<column>:<size>`; kind is movingAverage, cumulativeSum, rank or lag
%   bin           `<column>` binned into the columns `x0`, `x1`, `count`
%   thresholds    `sturges`, `count:<n>`, `width:<w>` or an explicit `a;b;c` list
%   stack         `<xColumn>:<seriesColumn>:<valueColumn>` into `x`, `series`, `y0`, `y1`
%   order         none, ascending, descending, inside-out, reverse or appearance
%   offset        none, expand, diverging, silhouette or wiggle
%   normalize     column divided by the sum of its values
%   quantile      column reduced to the columns `p` and `value`
%   probabilities the probabilities of the quantile operation, default `0,0.25,0.5,0.75,1`
%   kde           column estimated into the columns `x` and `density`
%   bandwidth     kernel bandwidth; `0` selects Silverman's rule of thumb
%   kernel        gaussian or epanechnikov
%   samples       sample count of the kde and function grids, default 50
%   regression    `<kind>:<xColumn>:<yColumn>`; kind is linear, poly, exp, log or pow
%   degree        polynomial degree, default 2
\keys_define:nn { semio / viz / transform }
  {
    filter .tl_set:N = \l_semio_viz_tr_filter_tl,
    sort .tl_set:N = \l_semio_viz_tr_sort_tl,
    descending .bool_set:N = \l_semio_viz_tr_descending_bool,
    descending .default:n = { true },
    group .tl_set:N = \l_semio_viz_tr_group_tl,
    rollup .tl_set:N = \l_semio_viz_tr_rollup_tl,
    pivot .tl_set:N = \l_semio_viz_tr_pivot_tl,
    fold .tl_set:N = \l_semio_viz_tr_fold_tl,
    join .tl_set:N = \l_semio_viz_tr_join_tl,
    window .tl_set:N = \l_semio_viz_tr_window_tl,
    bin .tl_set:N = \l_semio_viz_tr_bin_tl,
    thresholds .tl_set:N = \l_semio_viz_tr_thresholds_tl,
    stack .tl_set:N = \l_semio_viz_tr_stack_tl,
    order .tl_set:N = \l_semio_viz_tr_order_tl,
    offset .tl_set:N = \l_semio_viz_tr_offset_tl,
    normalize .tl_set:N = \l_semio_viz_tr_normalize_tl,
    quantile .tl_set:N = \l_semio_viz_tr_quantile_tl,
    probabilities .clist_set:N = \l_semio_viz_tr_probs_clist,
    kde .tl_set:N = \l_semio_viz_tr_kde_tl,
    bandwidth .tl_set:N = \l_semio_viz_tr_bandwidth_tl,
    kernel .tl_set:N = \l_semio_viz_tr_kernel_tl,
    samples .int_set:N = \l_semio_viz_tr_samples_int,
    regression .tl_set:N = \l_semio_viz_tr_regression_tl,
    degree .int_set:N = \l_semio_viz_tr_degree_int,
  }

% 🧹 Resets every transform key to its documented default.
\cs_new_protected:Npn \semio_viz_tr_keys_reset: {
  \tl_clear:N \l_semio_viz_tr_filter_tl
  \tl_clear:N \l_semio_viz_tr_sort_tl
  \bool_set_false:N \l_semio_viz_tr_descending_bool
  \tl_clear:N \l_semio_viz_tr_group_tl
  \tl_clear:N \l_semio_viz_tr_rollup_tl
  \tl_clear:N \l_semio_viz_tr_pivot_tl
  \tl_clear:N \l_semio_viz_tr_fold_tl
  \tl_clear:N \l_semio_viz_tr_join_tl
  \tl_clear:N \l_semio_viz_tr_window_tl
  \tl_clear:N \l_semio_viz_tr_bin_tl
  \tl_set:Nn \l_semio_viz_tr_thresholds_tl { sturges }
  \tl_clear:N \l_semio_viz_tr_stack_tl
  \tl_set:Nn \l_semio_viz_tr_order_tl { none }
  \tl_set:Nn \l_semio_viz_tr_offset_tl { none }
  \tl_clear:N \l_semio_viz_tr_normalize_tl
  \tl_clear:N \l_semio_viz_tr_quantile_tl
  \clist_set:Nn \l_semio_viz_tr_probs_clist { 0, 0.25, 0.5, 0.75, 1 }
  \tl_clear:N \l_semio_viz_tr_kde_tl
  \tl_set:Nn \l_semio_viz_tr_bandwidth_tl { 0 }
  \tl_set:Nn \l_semio_viz_tr_kernel_tl { gaussian }
  \int_set:Nn \l_semio_viz_tr_samples_int { 50 }
  \tl_clear:N \l_semio_viz_tr_regression_tl
  \int_set:Nn \l_semio_viz_tr_degree_int { 2 }
}

\seq_new:N \l_semio_viz_tr_args_seq

% ✂️ Splits an operation argument `a:b:c` into three ready-to-use token lists. The value arrives
% with the catcodes of the calling document, so it is stringified before the colon is looked for.
\cs_new_protected:Npn \semio_viz_tr_args:N #1 {
  \str_set:Nx \l_semio_viz_tr_argstr_str { \tl_to_str:N #1 }
  \seq_set_split:NVV \l_semio_viz_tr_args_seq \c_colon_str \l_semio_viz_tr_argstr_str
  \tl_set:Nx \l_semio_viz_tr_arga_tl { \seq_item:Nn \l_semio_viz_tr_args_seq { 1 } }
  \tl_set:Nx \l_semio_viz_tr_argb_tl { \seq_item:Nn \l_semio_viz_tr_args_seq { 2 } }
  \tl_set:Nx \l_semio_viz_tr_argc_tl { \seq_item:Nn \l_semio_viz_tr_args_seq { 3 } }
}
% 🔎 Argument #1 of the most recently split operation argument.
\cs_new:Npn \semio_viz_tr_arg:n #1 { \seq_item:Nn \l_semio_viz_tr_args_seq {#1} }
\str_new:N \l_semio_viz_tr_argstr_str
\tl_new:N \l_semio_viz_tr_arga_tl
\tl_new:N \l_semio_viz_tr_argb_tl
\tl_new:N \l_semio_viz_tr_argc_tl
%endregion 🔖️Keys

%region 🔖️Predicate
% 🔗 Binds every bare column name in an fp predicate to the value of that column in the row #1.
% Neighbouring characters are consumed by the match, so the substitution loops until stable.
\cs_new_protected:Npn \semio_viz_tr_predicate:nnN #1#2#3 {
  \tl_set:Nn \l_semio_viz_tr_expr_tl { ( #2 ) }
  \clist_map_inline:Nn \l_semio_viz_tr_cols_clist
    {
      \semio_viz_tr_get:nnN {#1} {##1} \l_semio_viz_tr_cell_tl
      \tl_if_empty:NF \l_semio_viz_tr_cell_tl
        { \semio_viz_tr_bind:nV {##1} \l_semio_viz_tr_cell_tl }
    }
  \fp_set:Nn #3 { \l_semio_viz_tr_expr_tl }
}
\tl_new:N \l_semio_viz_tr_expr_tl
\tl_new:N \l_semio_viz_tr_before_tl
\bool_new:N \l_semio_viz_tr_changed_bool
\int_new:N \l_semio_viz_tr_pass_int

% 🔗 Replaces every standalone occurrence of the identifier #1 in the predicate by the value #2.
\cs_new_protected:Npn \semio_viz_tr_bind:nn #1#2 {
  \bool_set_true:N \l_semio_viz_tr_changed_bool
  \int_zero:N \l_semio_viz_tr_pass_int
  \bool_while_do:nn
    {
      \l_semio_viz_tr_changed_bool &&
      \int_compare_p:nNn { \l_semio_viz_tr_pass_int } < { 16 }
    }
    {
      \tl_set_eq:NN \l_semio_viz_tr_before_tl \l_semio_viz_tr_expr_tl
      \regex_replace_all:nnN { ([^a-zA-Z0-9_]) #1 ([^a-zA-Z0-9_]) }
        { \1 (#2) \2 } \l_semio_viz_tr_expr_tl
      \bool_set:Nn \l_semio_viz_tr_changed_bool
        { ! \tl_if_eq_p:NN \l_semio_viz_tr_before_tl \l_semio_viz_tr_expr_tl }
      \int_incr:N \l_semio_viz_tr_pass_int
    }
}
\cs_generate_variant:Nn \semio_viz_tr_bind:nn { nV }
%endregion 🔖️Predicate

%region 🔖️Reshape
% 🧹 Keeps only the rows whose predicate evaluates to a non-zero value.
\cs_new_protected:Npn \semio_viz_tr_filter:n #1 {
  \clist_set_eq:NN \l_semio_viz_tr_out_cols_clist \l_semio_viz_tr_cols_clist
  \seq_clear:N \l_semio_viz_tr_out_rows_seq
  \seq_map_inline:Nn \l_semio_viz_tr_rows_seq
    {
      \semio_viz_tr_predicate:nnN {##1} {#1} \l_semio_viz_tr_value_fp
      \fp_compare:nNnF { \l_semio_viz_tr_value_fp } = { 0 }
        { \seq_put_right:Nn \l_semio_viz_tr_out_rows_seq {##1} }
    }
  \semio_viz_tr_commit:
}
\fp_new:N \l_semio_viz_tr_value_fp

% 🔃 Sorts the rows by a column, numerically when both cells are numbers.
\cs_new_protected:Npn \semio_viz_tr_sort:n #1 {
  \semio_viz_tr_colindex:nN {#1} \l_semio_viz_tr_sort_col_int
  \seq_sort:Nn \l_semio_viz_tr_rows_seq
    {
      \semio_viz_tr_compare:nn {##1} {##2}
      \bool_if:NTF \l_semio_viz_tr_after_bool
        { \sort_return_swapped: } { \sort_return_same: }
    }
  \bool_if:NT \l_semio_viz_tr_descending_bool { \seq_reverse:N \l_semio_viz_tr_rows_seq }
}
\int_new:N \l_semio_viz_tr_sort_col_int
\bool_new:N \l_semio_viz_tr_after_bool

% ⚖️ Sets \l_semio_viz_tr_after_bool when the row #1 must sort after the row #2.
\cs_new_protected:Npn \semio_viz_tr_compare:nn #1#2 {
  \clist_set:Nn \l_semio_viz_tr_row_clist {#1}
  \tl_set:Nx \l_semio_viz_tr_left_tl
    { \clist_item:Nn \l_semio_viz_tr_row_clist { \l_semio_viz_tr_sort_col_int } }
  \clist_set:Nn \l_semio_viz_tr_row_clist {#2}
  \tl_set:Nx \l_semio_viz_tr_right_tl
    { \clist_item:Nn \l_semio_viz_tr_row_clist { \l_semio_viz_tr_sort_col_int } }
  \regex_match:nVTF { \A [-+]? [0-9]* \.? [0-9]+ ([eE][-+]?[0-9]+)? \Z }
    \l_semio_viz_tr_left_tl
    {
      \bool_set:Nn \l_semio_viz_tr_after_bool
        {
          \fp_compare_p:nNn { \l_semio_viz_tr_left_tl } > { \l_semio_viz_tr_right_tl }
        }
    }
    {
      \bool_set:Nn \l_semio_viz_tr_after_bool
        {
          \str_compare_p:eNe { \l_semio_viz_tr_left_tl } > { \l_semio_viz_tr_right_tl }
        }
    }
}
\tl_new:N \l_semio_viz_tr_left_tl
\tl_new:N \l_semio_viz_tr_right_tl

% 🧺 Reduces the rows to one row per group, applying an aggregate to a value column.
\cs_new_protected:Npn \semio_viz_tr_rollup:nnn #1#2#3 {
  \semio_viz_tr_distinct:nN {#1} \l_semio_viz_tr_groups_seq
  \clist_set:Nn \l_semio_viz_tr_out_cols_clist { #1, value }
  \seq_clear:N \l_semio_viz_tr_out_rows_seq
  \seq_map_inline:Nn \l_semio_viz_tr_groups_seq
    {
      \semio_viz_tr_group_values:nnn {#1} {##1} {#3}
      \semio_viz_tr_aggregate:nN {#2} \l_semio_viz_tr_value_fp
      \seq_clear:N \l_semio_viz_tr_build_seq
      \seq_put_right:Nn \l_semio_viz_tr_build_seq {##1}
      \seq_put_right:Nx \l_semio_viz_tr_build_seq
        { \fp_to_decimal:n { round( \l_semio_viz_tr_value_fp , 6 ) } }
      \semio_viz_tr_put:N \l_semio_viz_tr_build_seq
    }
  \semio_viz_tr_commit:
}
\seq_new:N \l_semio_viz_tr_groups_seq
\seq_new:N \l_semio_viz_tr_values_seq

% 🧺 Collects the values of column #3 for the rows whose column #1 equals #2.
\cs_new_protected:Npn \semio_viz_tr_group_values:nnn #1#2#3 {
  \seq_clear:N \l_semio_viz_tr_values_seq
  \seq_map_inline:Nn \l_semio_viz_tr_rows_seq
    {
      \semio_viz_tr_get:nnN {##1} {#1} \l_semio_viz_tr_cell_tl
      \str_if_eq:VnT \l_semio_viz_tr_cell_tl {#2}
        {
          \semio_viz_tr_get:nnN {##1} {#3} \l_semio_viz_tr_cell_tl
          \seq_put_right:NV \l_semio_viz_tr_values_seq \l_semio_viz_tr_cell_tl
        }
    }
}

% 📊 Applies the aggregate #1 to \l_semio_viz_tr_values_seq.
\cs_new_protected:Npn \semio_viz_tr_aggregate:nN #1#2 {
  \str_case:nnF {#1}
    {
      { count } { \fp_set:Nn #2 { \seq_count:N \l_semio_viz_tr_values_seq } }
      { sum } { \semio_viz_tr_sum:N #2 }
      { mean }
        {
          \semio_viz_tr_sum:N #2
          \fp_set:Nn #2 { #2 / \seq_count:N \l_semio_viz_tr_values_seq }
        }
      { min }
        {
          \fp_set:Nn #2 { \seq_item:Nn \l_semio_viz_tr_values_seq { 1 } }
          \seq_map_inline:Nn \l_semio_viz_tr_values_seq { \fp_set:Nn #2 { min( #2 , ##1 ) } }
        }
      { max }
        {
          \fp_set:Nn #2 { \seq_item:Nn \l_semio_viz_tr_values_seq { 1 } }
          \seq_map_inline:Nn \l_semio_viz_tr_values_seq { \fp_set:Nn #2 { max( #2 , ##1 ) } }
        }
      { median } { \semio_viz_tr_quantile_of:nN { 0.5 } #2 }
    }
    { \msg_error:nnn { semio-viz } { unknown-rollup } {#1} }
}

% ➕ Sum of \l_semio_viz_tr_values_seq.
\cs_new_protected:Npn \semio_viz_tr_sum:N #1 {
  \fp_zero:N #1
  \seq_map_inline:Nn \l_semio_viz_tr_values_seq { \fp_add:Nn #1 { ##1 } }
}

% 📈 R-7 quantile of \l_semio_viz_tr_values_seq at probability #1.
\cs_new_protected:Npn \semio_viz_tr_quantile_of:nN #1#2 {
  \seq_set_eq:NN \l_semio_viz_tr_sorted_seq \l_semio_viz_tr_values_seq
  \seq_sort:Nn \l_semio_viz_tr_sorted_seq
    { \fp_compare:nNnTF {##1} > {##2} { \sort_return_swapped: } { \sort_return_same: } }
  \int_set:Nn \l_semio_viz_tr_n_int { \seq_count:N \l_semio_viz_tr_sorted_seq }
  \fp_set:Nn \l_semio_viz_tr_h_fp { ( \l_semio_viz_tr_n_int - 1 ) * (#1) }
  \int_set:Nn \l_semio_viz_tr_lo_int { \fp_to_int:n { floor( \l_semio_viz_tr_h_fp ) } }
  \fp_set:Nn #2
    {
      \seq_item:Nn \l_semio_viz_tr_sorted_seq { \l_semio_viz_tr_lo_int + 1 }
        + ( \l_semio_viz_tr_h_fp - \l_semio_viz_tr_lo_int )
          * ( \seq_item:Nn \l_semio_viz_tr_sorted_seq
                { \int_min:nn { \l_semio_viz_tr_lo_int + 2 } { \l_semio_viz_tr_n_int } }
              - \seq_item:Nn \l_semio_viz_tr_sorted_seq { \l_semio_viz_tr_lo_int + 1 } )
    }
}
