}

% 🔢 Series order: none, reverse, ascending, descending, appearance or inside-out.
\cs_new_protected:Npn \semio_viz_tr_stack_order: {
  \seq_clear:N \l_semio_viz_tr_order_seq
  \int_step_inline:nn { \seq_count:N \l_semio_viz_tr_series_seq }
    { \seq_put_right:Nn \l_semio_viz_tr_order_seq {##1} }
  \str_case:VnF \l_semio_viz_tr_order_tl
    {
      { reverse } { \seq_reverse:N \l_semio_viz_tr_order_seq }
      { ascending } { \semio_viz_tr_order_sums: }
      { descending } { \semio_viz_tr_order_sums: \seq_reverse:N \l_semio_viz_tr_order_seq }
      { appearance } { \semio_viz_tr_order_appearance: }
      { inside-out } { \semio_viz_tr_order_inside_out: }
