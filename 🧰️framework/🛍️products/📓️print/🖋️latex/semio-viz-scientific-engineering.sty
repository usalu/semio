% 📐 Offsets one dimension perpendicular to its own measured segment, draws the two witness lines and the double-headed dimension arrow, and sets the text on it.
\cs_new_protected:Npn \semio_viz_eng_dimension:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp { \semio_viz_eng_field:n { 1 } }
    \fp_set:Nn \l_semio_viz_sci_b_fp { \semio_viz_eng_field:n { 2 } }
