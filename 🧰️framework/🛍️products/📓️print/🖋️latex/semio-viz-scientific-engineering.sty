    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=north~east ]
      at ( 0 , -4.4 ) { \semio_viz_sci_num:nn { \l_semio_viz_eng_reactiona_fp } { 2 } } ;
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=north~west ]
