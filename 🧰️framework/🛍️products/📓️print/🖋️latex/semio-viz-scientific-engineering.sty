                  b/f/5 , f/c/-6 , f/g/-11 , c/g/4 , g/d/-12 }
      }
      {#1}
    \str_if_eq:VnTF \l_semio_viz_eng_mode_tl { mesh }
      { \semio_viz_eng_mesh: }
      { \semio_viz_eng_truss: }
  }
% 🕸️ Indexes the node coordinates by id, strokes every member between them and finally caps each joint with a pin dot.
\cs_new_protected:Npn \semio_viz_eng_truss:
  {
    \prop_clear:N \l_semio_viz_eng_nx_prop
    \prop_clear:N \l_semio_viz_eng_ny_prop
    \clist_map_inline:Nn \l_semio_viz_eng_nodes_clist
      {
        \semio_viz_eng_record:n {##1}
        \prop_put:Nxx \l_semio_viz_eng_nx_prop
          { \semio_viz_eng_field:n { 1 } } { \semio_viz_eng_field:n { 2 } }
        \prop_put:Nxx \l_semio_viz_eng_ny_prop
          { \semio_viz_eng_field:n { 1 } } { \semio_viz_eng_field:n { 3 } }
      }
    \clist_map_inline:Nn \l_semio_viz_eng_members_clist
      {
        \semio_viz_eng_record:n {##1}
        \semio_viz_eng_member:
      }
    \clist_map_inline:Nn \l_semio_viz_eng_nodes_clist
      {
        \semio_viz_eng_record:n {##1}
        \fill [ fill=semio-chrome-foreground ]
          ( \semio_viz_eng_field:n { 2 } , \semio_viz_eng_field:n { 3 } ) circle [ radius=0.9 ] ;
      }
  }
% 🪝 Strokes one member between its two nodes, colouring it by the sign of its force and thickening it with the magnitude, then reports that force.
\cs_new_protected:Npn \semio_viz_eng_member:
  {
    \fp_set:Nn \l_semio_viz_sci_g_fp { \semio_viz_eng_field:n { 3 } }
    \tl_set:Nx \l_semio_viz_eng_key_tl
      {
        \fp_compare:nNnTF { \l_semio_viz_sci_g_fp } < { 0 } { semio-secondary } { semio-primary }
      }
    \use:x
      {
        \exp_not:N \draw
          [ semio~sci~thin , draw=\l_semio_viz_eng_key_tl ,
            line~width=\fp_eval:n { 0.4 + 0.06 * abs ( \l_semio_viz_sci_g_fp ) } pt ]
          ( \prop_item:Ne \l_semio_viz_eng_nx_prop { \semio_viz_eng_field:n { 1 } } ,
            \prop_item:Ne \l_semio_viz_eng_ny_prop { \semio_viz_eng_field:n { 1 } } ) --
          ( \prop_item:Ne \l_semio_viz_eng_nx_prop { \semio_viz_eng_field:n { 2 } } ,
            \prop_item:Ne \l_semio_viz_eng_ny_prop { \semio_viz_eng_field:n { 2 } } ) ;
      }
    \semio_viz_sci_report_values:nn { truss/member } { \fp_to_decimal:N \l_semio_viz_sci_g_fp }
  }
% 🧱 Walks the column-by-row lattice and emits one analysis cell at each position.
\cs_new_protected:Npn \semio_viz_eng_mesh:
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_eng_cols_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_eng_rows_int - 1 }
          { \semio_viz_eng_mesh_cell:nn {##1} {####1} }
      }
  }
% 🔻 Evaluates the mesh field at lattice cell (#1,#2) and fills its two triangles from the diverging ramp with opposite signs, then reports the element value.
\cs_new_protected:Npn \semio_viz_eng_mesh_cell:nn #1#2
  {
    \fp_set:Nn \SemioX { #1 * 7 }
    \fp_set:Nn \SemioY { #2 * 7 }
    \fp_set:Nn \l_semio_viz_sci_g_fp { \l_semio_viz_eng_field_tl }
    \draw [ semio~sci~thin , fill=\semio_viz_sci_ramp_diverging:n { \l_semio_viz_sci_g_fp } ]
      ( \fp_eval:n { \SemioX } , \fp_eval:n { \SemioY } ) --
      ( \fp_eval:n { \SemioX + 7 } , \fp_eval:n { \SemioY } ) --
      ( \fp_eval:n { \SemioX + 7 } , \fp_eval:n { \SemioY + 7 } ) -- cycle ;
    \draw [ semio~sci~thin , fill=\semio_viz_sci_ramp_diverging:n { - \l_semio_viz_sci_g_fp } ]
      ( \fp_eval:n { \SemioX } , \fp_eval:n { \SemioY } ) --
      ( \fp_eval:n { \SemioX + 7 } , \fp_eval:n { \SemioY + 7 } ) --
      ( \fp_eval:n { \SemioX } , \fp_eval:n { \SemioY + 7 } ) -- cycle ;
    \semio_viz_sci_report_values:nn { mesh/element }
      { #1 , #2 , \fp_to_decimal:N \l_semio_viz_sci_g_fp }
  }

