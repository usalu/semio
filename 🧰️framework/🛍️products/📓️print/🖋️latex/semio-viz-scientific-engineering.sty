          ( \fp_eval:n { \semio_viz_eng_field:n { 1 } } , 0.6 ) ;
      }
    \clist_map_inline:Nn \l_semio_viz_eng_dist_clist
      {
        \semio_viz_eng_record:n {##1}
        \fill [ fill=semio-secondary , fill~opacity=0.3 ]
          ( \fp_eval:n { \semio_viz_eng_field:n { 1 } } , 1 ) rectangle
          ( \fp_eval:n { \semio_viz_eng_field:n { 2 } } ,
            \fp_eval:n { 1 + 40 * \semio_viz_eng_field:n { 3 } } ) ;
