%region 🔖️Keys
% 🔑 Keys of `sci-mohr` (§36 stress state):
%    sigmaX, sigmaY, tauXY (fp, 80/20/30): the plane stress state.
%    principal (bool, true): mark the principal stresses and the maximum shear.
%    pole (bool, false): draw the pole construction.
\fp_new:N \l_semio_viz_eng_sigmax_fp
\fp_new:N \l_semio_viz_eng_sigmay_fp
\fp_new:N \l_semio_viz_eng_tau_fp
\bool_new:N \l_semio_viz_eng_principal_bool
\bool_new:N \l_semio_viz_eng_pole_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-mohr }
% 🔩 Binds the `sci-mohr` option names onto the three plane-stress components and the principal-marker and pole switches.
\keys_define:nn { semio / viz / family / sci-mohr }
  {
    sigmaX    .fp_set:N   = \l_semio_viz_eng_sigmax_fp ,
    sigmaY    .fp_set:N   = \l_semio_viz_eng_sigmay_fp ,
    tauXY     .fp_set:N   = \l_semio_viz_eng_tau_fp ,
    principal .bool_set:N = \l_semio_viz_eng_principal_bool ,
    pole      .bool_set:N = \l_semio_viz_eng_pole_bool ,
  }

% 🔩 §36 Mohr's circle: the centre, radius and principal stresses solved from the plane stress state.
\SemioVizFamily { sci-mohr }
  {
    \semio_viz_sci_enter:nnn { sci-mohr }
      { sigmaX=80 , sigmaY=20 , tauXY=30 , principal=true , pole=false , domain={} , range={} }
      {#1}
    \fp_set:Nn \l_semio_viz_sci_a_fp { ( \l_semio_viz_eng_sigmax_fp + \l_semio_viz_eng_sigmay_fp ) / 2 }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      {
        sqrt ( ( ( \l_semio_viz_eng_sigmax_fp - \l_semio_viz_eng_sigmay_fp ) / 2 ) ^ 2
             + \l_semio_viz_eng_tau_fp ^ 2 )
      }
    \semio_viz_sci_window:nnnn
      { \l_semio_viz_sci_a_fp - 1.25 * \l_semio_viz_sci_b_fp }
      { \l_semio_viz_sci_a_fp + 1.25 * \l_semio_viz_sci_b_fp }
      { - 1.25 * \l_semio_viz_sci_b_fp } { 1.25 * \l_semio_viz_sci_b_fp }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { 120 }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \l_semio_viz_sci_a_fp + \l_semio_viz_sci_b_fp * cos ( 2 * pi * ##1 / 120 ) }
          { \l_semio_viz_sci_b_fp * sin ( 2 * pi * ##1 / 120 ) }
      }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \bool_if:NT \l_semio_viz_eng_principal_bool
      {
        \semio_viz_sci_dot:nnn { \l_semio_viz_sci_a_fp - \l_semio_viz_sci_b_fp } { 0 } { semio-primary }
        \semio_viz_sci_dot:nnn { \l_semio_viz_sci_a_fp + \l_semio_viz_sci_b_fp } { 0 } { semio-primary }
        \semio_viz_sci_dot:nnn { \l_semio_viz_eng_sigmax_fp } { \l_semio_viz_eng_tau_fp } { semio-secondary }
        \semio_viz_sci_dot:nnn { \l_semio_viz_eng_sigmay_fp } { - \l_semio_viz_eng_tau_fp } { semio-secondary }
        \semio_viz_sci_arrow:nnnnn
          { \l_semio_viz_eng_sigmax_fp } { \l_semio_viz_eng_tau_fp }
          { \l_semio_viz_eng_sigmay_fp } { - \l_semio_viz_eng_tau_fp } { semio~sci~aux }
      }
    \semio_viz_sci_report_values:nn { mohr/state }
      {
        \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp ,
        \fp_to_decimal:n { \l_semio_viz_sci_a_fp + \l_semio_viz_sci_b_fp } ,
        \fp_to_decimal:n { \l_semio_viz_sci_a_fp - \l_semio_viz_sci_b_fp }
      }
  }

%region 🔖️Keys
