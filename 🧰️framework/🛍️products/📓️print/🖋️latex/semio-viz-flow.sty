\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-flow}[2026/09/05 v0.3.0 semio viz flow kernel: sankey, alluvial, parallel sets]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-network}

\ExplSyntaxOn

%region 🔖️Diagnostics
\msg_if_exist:nnF { semio-viz } { flow-cycle } {
  \msg_new:nnn { semio-viz } { flow-cycle }
    { Flow~table~'#1'~contains~a~circular~link;~sankey~needs~an~acyclic~flow. }
}
\msg_if_exist:nnF { semio-viz } { unknown-align } {
  \msg_new:nnn { semio-viz } { unknown-align }
    { Unknown~node~alignment~'#1'~(left,~right,~center,~justify). }
}
%endregion 🔖️Diagnostics

%region 🔖️Keys
% 🔑 semio / viz / layout / sankey — the options of the `sankey`, `alluvial` and
% `parallel-sets` layouts. Every default is d3-sankey's own, so a bare call reproduces
% `d3.sankey()`; `alluvial` presets `node-align=left` and `node-sort=none`, and
% `parallel-sets` additionally presets `node-padding=0`.
%   node-width   (number, default 24)      width of a node rectangle, in layout units
%   node-padding (number, default 8)       vertical gap between the nodes of one column
%   node-align   (left|right|center|justify, default justify)  the column assignment rule
%   node-sort    (auto|none, default auto) auto is d3's "sort each column by y0"
%   link-sort    (auto|none, default auto) auto is d3's link ordering by partner breadth
%   iterations   (integer, default 6)      relaxation passes
%   x0, y0       (number, default 0)       the extent the layout writes into
%   x1, y1       (number, default 1)
\fp_new:N \l_semio_viz_flow_node_width_fp
\fp_new:N \l_semio_viz_flow_node_padding_fp
\fp_new:N \l_semio_viz_flow_x_zero_fp
\fp_new:N \l_semio_viz_flow_y_zero_fp
\fp_new:N \l_semio_viz_flow_x_one_fp
\fp_new:N \l_semio_viz_flow_y_one_fp
\fp_new:N \l_semio_viz_flow_py_fp
\fp_new:N \l_semio_viz_flow_kx_fp
\fp_new:N \l_semio_viz_flow_ky_fp
\fp_new:N \l_semio_viz_flow_alpha_fp
\fp_new:N \l_semio_viz_flow_beta_fp
\fp_new:N \l_semio_viz_flow_top_fp
\fp_new:N \l_semio_viz_flow_acc_fp
\fp_new:N \l_semio_viz_flow_weight_fp
\fp_new:N \l_semio_viz_flow_shift_fp
\fp_new:N \l_semio_viz_flow_cursor_fp
\fp_new:N \l_semio_viz_flow_delta_fp
\int_new:N \l_semio_viz_flow_iterations_int
\int_new:N \l_semio_viz_flow_layers_int
\int_new:N \l_semio_viz_flow_depth_int
\int_new:N \l_semio_viz_flow_wide_int
\int_new:N \l_semio_viz_flow_col_int
\int_new:N \l_semio_viz_flow_pivot_int
\tl_new:N \l_semio_viz_flow_align_tl
\tl_new:N \l_semio_viz_flow_node_sort_tl
\tl_new:N \l_semio_viz_flow_link_sort_tl
\seq_new:N \l_semio_viz_flow_current_seq
\seq_new:N \l_semio_viz_flow_next_seq
\seq_new:N \l_semio_viz_flow_column_seq
\bool_new:N \l_semio_viz_flow_grow_bool

\keys_define:nn { semio / viz / layout / sankey } {
  node-width   .fp_set:N = \l_semio_viz_flow_node_width_fp,
  node-padding .fp_set:N = \l_semio_viz_flow_node_padding_fp,
  node-align   .tl_set:N = \l_semio_viz_flow_align_tl,
  node-sort    .tl_set:N = \l_semio_viz_flow_node_sort_tl,
  link-sort    .tl_set:N = \l_semio_viz_flow_link_sort_tl,
  iterations   .int_set:N = \l_semio_viz_flow_iterations_int,
  x0           .fp_set:N = \l_semio_viz_flow_x_zero_fp,
  y0           .fp_set:N = \l_semio_viz_flow_y_zero_fp,
  x1           .fp_set:N = \l_semio_viz_flow_x_one_fp,
  y1           .fp_set:N = \l_semio_viz_flow_y_one_fp,
}

\tl_const:Nn \c_semio_viz_flow_sankey_defaults_tl
  { node-width = 24, node-padding = 8, node-align = justify, node-sort = auto, link-sort = auto, iterations = 6, x0 = 0, y0 = 0, x1 = 1, y1 = 1 }
%endregion 🔖️Keys

%region 🔖️NodeLinks
% 🔗 Splits the incident edges of every node into outgoing and incoming link index lists, in link order.
\cs_new_protected:Npn \semio_viz_flow_node_links: {
  \semio_viz_network_seq_ensure:nn { slink } { \l_semio_viz_network_n_int }
  \semio_viz_network_seq_ensure:nn { tlink } { \l_semio_viz_network_n_int }
  \semio_viz_network_fp_ensure:nn { nv } { \l_semio_viz_network_n_int }
  \semio_viz_network_fp_ensure:nn { nx } { \l_semio_viz_network_n_int }
  \semio_viz_network_fp_ensure:nn { nxb } { \l_semio_viz_network_n_int }
  \semio_viz_network_fp_ensure:nn { ny } { \l_semio_viz_network_n_int }
  \semio_viz_network_fp_ensure:nn { nyb } { \l_semio_viz_network_n_int }
  \semio_viz_network_fp_ensure:nn { lw } { \l_semio_viz_network_m_int }
  \semio_viz_network_fp_ensure:nn { ly } { \l_semio_viz_network_m_int }
  \semio_viz_network_fp_ensure:nn { lyb } { \l_semio_viz_network_m_int }
  \semio_viz_network_n_ensure:nn { nd } { \l_semio_viz_network_n_int }
  \semio_viz_network_n_ensure:nn { nh } { \l_semio_viz_network_n_int }
  \semio_viz_network_n_ensure:nn { nl } { \l_semio_viz_network_n_int }
  \semio_viz_network_n_ensure:nn { mark } { \l_semio_viz_network_n_int }
  \int_step_inline:nn { \l_semio_viz_network_m_int } {
    \semio_viz_network_sput:nnn { slink } { \semio_viz_network_n:nn { es } {##1} } {##1}
    \semio_viz_network_sput:nnn { tlink } { \semio_viz_network_n:nn { et } {##1} } {##1}
  }
}

% 💧 d3's computeNodeValues: a node carries the larger of its outgoing and incoming totals.
\cs_new_protected:Npn \semio_viz_flow_node_values: {
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_flow_node_value:n {##1} }
}
% 💧 The value of node #1: the larger of what leaves it and what enters it.
\cs_new_protected:Npn \semio_viz_flow_node_value:n #1 {
  \fp_zero:N \l_semio_viz_flow_acc_fp
  \seq_map_inline:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq }
    { \fp_add:Nn \l_semio_viz_flow_acc_fp { \semio_viz_network_f:nn { ew } {##1} } }
  \fp_zero:N \l_semio_viz_flow_weight_fp
  \seq_map_inline:cn { l_semio_viz_network_tlink_ \int_eval:n {#1} _seq }
    { \fp_add:Nn \l_semio_viz_flow_weight_fp { \semio_viz_network_f:nn { ew } {##1} } }
  \semio_viz_network_fset:nnn { nv } {#1}
    { max( \l_semio_viz_flow_acc_fp , \l_semio_viz_flow_weight_fp ) }
}
%endregion 🔖️NodeLinks

%region 🔖️Depths
% 🌊 d3's computeNodeDepths / computeNodeHeights: every node starts in the frontier, so the final value is
% the longest path from any source (depth) respectively to any sink (height).
\cs_new_protected:Npn \semio_viz_flow_levels:nnn #1#2#3 {
  \seq_clear:N \l_semio_viz_flow_current_seq
  \int_step_inline:nn { \l_semio_viz_network_n_int }
    { \seq_put_right:Nn \l_semio_viz_flow_current_seq {##1} }
  \int_zero:N \l_semio_viz_flow_depth_int
  \bool_set_true:N \l_semio_viz_flow_grow_bool
  \bool_while_do:Nn \l_semio_viz_flow_grow_bool { \semio_viz_flow_level_step:nnn {#1} {#2} {#3} }
}
% 🪜 One breadth-first round: the frontier is written into field #1, then expanded along the link
% list #2 to the node end #3; a round past the node count means the graph has a cycle.
\cs_new_protected:Npn \semio_viz_flow_level_step:nnn #1#2#3 {
  \seq_map_inline:Nn \l_semio_viz_flow_current_seq
    { \semio_viz_network_nset:nnn {#1} {##1} { \l_semio_viz_flow_depth_int } }
  \seq_clear:N \l_semio_viz_flow_next_seq
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_network_nset:nnn { mark } {##1} { 0 } }
  \seq_map_inline:Nn \l_semio_viz_flow_current_seq { \semio_viz_flow_level_expand:nnn {##1} {#2} {#3} }
  \seq_set_eq:NN \l_semio_viz_flow_current_seq \l_semio_viz_flow_next_seq
  \int_incr:N \l_semio_viz_flow_depth_int
  \int_compare:nNnT \l_semio_viz_flow_depth_int > { \l_semio_viz_network_n_int }
    { \msg_error:nnn { semio-viz } { flow-cycle } { \l_semio_viz_network_bound_tl } }
  \seq_if_empty:NT \l_semio_viz_flow_current_seq { \bool_set_false:N \l_semio_viz_flow_grow_bool }
}
% ↪️ Puts every neighbour of node #1 reachable along link list #2 through end #3 into the next frontier.
\cs_new_protected:Npn \semio_viz_flow_level_expand:nnn #1#2#3 {
  \seq_map_inline:cn { l_semio_viz_network_ #2 _ \int_eval:n {#1} _seq }
    { \semio_viz_flow_level_push:n { \semio_viz_network_n:nn {#3} {##1} } }
}
% ➕ Adds node #1 to the next frontier, once per round.
\cs_new_protected:Npn \semio_viz_flow_level_push:n #1 {
  \int_compare:nNnF { \semio_viz_network_n:nn { mark } {#1} } = { 1 } {
    \semio_viz_network_nset:nnn { mark } {#1} { 1 }
    \seq_put_right:Nx \l_semio_viz_flow_next_seq { \int_eval:n {#1} }
  }
}
%endregion 🔖️Depths

%region 🔖️Layers
% 🪜 d3's four node alignments; `center` reads the smallest depth among the targets of a source-only node.
\cs_new_protected:Npn \semio_viz_flow_align:n #1
  { \exp_args:NnV \semio_viz_flow_align_do:nn {#1} \l_semio_viz_flow_align_tl }
% 🪜 Sets the column of node #1 under alignment #2; an unknown alignment is an error, not a default.
\cs_new_protected:Npn \semio_viz_flow_align_do:nn #1#2 {
  \str_case:nnF {#2}
    {
      { left }  { \int_set:Nn \l_semio_viz_flow_col_int { \semio_viz_network_n:nn { nd } {#1} } }
      { right }
        {
          \int_set:Nn \l_semio_viz_flow_col_int
            { \l_semio_viz_flow_layers_int - 1 - \semio_viz_network_n:nn { nh } {#1} }
        }
      { justify } { \semio_viz_flow_align_justify:n {#1} }
      { center }  { \semio_viz_flow_align_center:n {#1} }
    }
    { \msg_error:nnx { semio-viz } { unknown-align } { \tl_use:N \l_semio_viz_flow_align_tl } }
}
% 🪜 `justify`: a sink is pulled to the last column, every other node keeps its own depth.
\cs_new_protected:Npn \semio_viz_flow_align_justify:n #1 {
  \seq_if_empty:cTF { l_semio_viz_network_slink_ \int_eval:n {#1} _seq }
    { \int_set:Nn \l_semio_viz_flow_col_int { \l_semio_viz_flow_layers_int - 1 } }
    { \int_set:Nn \l_semio_viz_flow_col_int { \semio_viz_network_n:nn { nd } {#1} } }
}
% 🪜 `center`: a source-only node moves in front of the earliest of its own targets.
\cs_new_protected:Npn \semio_viz_flow_align_center:n #1 {
  \seq_if_empty:cTF { l_semio_viz_network_tlink_ \int_eval:n {#1} _seq }
    {
      \seq_if_empty:cTF { l_semio_viz_network_slink_ \int_eval:n {#1} _seq }
        { \int_zero:N \l_semio_viz_flow_col_int }
        {
          \int_set:Nn \l_semio_viz_flow_col_int { \l_semio_viz_network_n_int }
          \seq_map_inline:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq }
            {
              \int_compare:nNnT { \semio_viz_network_n:nn { nd } { \semio_viz_network_n:nn { et } {##1} } }
                < \l_semio_viz_flow_col_int
                {
                  \int_set:Nn \l_semio_viz_flow_col_int
                    { \semio_viz_network_n:nn { nd } { \semio_viz_network_n:nn { et } {##1} } }
                }
            }
          \int_decr:N \l_semio_viz_flow_col_int
        }
    }
    { \int_set:Nn \l_semio_viz_flow_col_int { \semio_viz_network_n:nn { nd } {#1} } }
}

% 🪜 d3's computeNodeLayers: horizontal extent per layer plus the column membership lists, in node order.
\cs_new_protected:Npn \semio_viz_flow_layers: {
  \int_set:Nn \l_semio_viz_flow_layers_int { 1 }
  \int_step_inline:nn { \l_semio_viz_network_n_int } {
    \int_compare:nNnT { \semio_viz_network_n:nn { nd } {##1} + 1 } > \l_semio_viz_flow_layers_int
      { \int_set:Nn \l_semio_viz_flow_layers_int { \semio_viz_network_n:nn { nd } {##1} + 1 } }
  }
  \fp_set:Nn \l_semio_viz_flow_kx_fp
    {
      ( \l_semio_viz_flow_x_one_fp - \l_semio_viz_flow_x_zero_fp - \l_semio_viz_flow_node_width_fp )
      / max( 1 , \l_semio_viz_flow_layers_int - 1 )
    }
  \semio_viz_network_seq_ensure:nn { col } { \l_semio_viz_flow_layers_int }
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_flow_layer_assign:n {##1} }
}
% 🪜 Puts node #1 in its column: the alignment's answer clipped to the columns that exist, then
% the node's abscissae and its membership of that column's list.
\cs_new_protected:Npn \semio_viz_flow_layer_assign:n #1 {
  \semio_viz_flow_align:n {#1}
  \int_compare:nNnT \l_semio_viz_flow_col_int < { 0 } { \int_zero:N \l_semio_viz_flow_col_int }
  \int_compare:nNnT \l_semio_viz_flow_col_int > { \l_semio_viz_flow_layers_int - 1 }
    { \int_set:Nn \l_semio_viz_flow_col_int { \l_semio_viz_flow_layers_int - 1 } }
  \semio_viz_network_nset:nnn { nl } {#1} { \l_semio_viz_flow_col_int }
  \semio_viz_network_fset:nnn { nx } {#1}
    { \l_semio_viz_flow_x_zero_fp + \l_semio_viz_flow_col_int * \l_semio_viz_flow_kx_fp }
  \semio_viz_network_fset:nnn { nxb } {#1}
    { \semio_viz_network_f:nn { nx } {#1} + \l_semio_viz_flow_node_width_fp }
  \semio_viz_network_sput:nnn { col } { \l_semio_viz_flow_col_int + 1 } {#1}
}
%endregion 🔖️Layers

%region 🔖️LinkOrder
% 🔗 d3's ascendingTargetBreadth / ascendingSourceBreadth: by the partner's y0, ties by link index.
\cs_new_protected:Npn \semio_viz_flow_sort_source_links:n #1 {
  \str_if_eq:VnF \l_semio_viz_flow_link_sort_tl { none } {
    \seq_sort:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq }
      {
        \fp_compare:nNnTF
          { \semio_viz_network_f:nn { ny } { \semio_viz_network_n:nn { et } {##1} } }
          > { \semio_viz_network_f:nn { ny } { \semio_viz_network_n:nn { et } {##2} } }
          { \sort_return_swapped: }
          {
            \fp_compare:nNnTF
              { \semio_viz_network_f:nn { ny } { \semio_viz_network_n:nn { et } {##1} } }
              < { \semio_viz_network_f:nn { ny } { \semio_viz_network_n:nn { et } {##2} } }
              { \sort_return_same: }
              {
                \int_compare:nNnTF {##1} > {##2}
                  { \sort_return_swapped: } { \sort_return_same: }
              }
          }
      }
  }
}
% 🔗 Sorts the incoming links of node #1 by their source's ordinate, ties by link index.
\cs_new_protected:Npn \semio_viz_flow_sort_target_links:n #1 {
  \str_if_eq:VnF \l_semio_viz_flow_link_sort_tl { none } {
    \seq_sort:cn { l_semio_viz_network_tlink_ \int_eval:n {#1} _seq }
      {
        \fp_compare:nNnTF
          { \semio_viz_network_f:nn { ny } { \semio_viz_network_n:nn { es } {##1} } }
          > { \semio_viz_network_f:nn { ny } { \semio_viz_network_n:nn { es } {##2} } }
          { \sort_return_swapped: }
          {
            \fp_compare:nNnTF
              { \semio_viz_network_f:nn { ny } { \semio_viz_network_n:nn { es } {##1} } }
              < { \semio_viz_network_f:nn { ny } { \semio_viz_network_n:nn { es } {##2} } }
              { \sort_return_same: }
              {
                \int_compare:nNnTF {##1} > {##2}
                  { \sort_return_swapped: } { \sort_return_same: }
              }
          }
      }
  }
}
% 🔗 Re-sorts both link lists of node #1, which is what keeps its ribbons from crossing.
\cs_new_protected:Npn \semio_viz_flow_reorder_links:n #1 {
  \semio_viz_flow_sort_source_links:n {#1}
  \semio_viz_flow_sort_target_links:n {#1}
}
% 🔗 d3's reorderNodeLinks: re-sorts the link lists of every neighbour of a node that just moved.
\cs_new_protected:Npn \semio_viz_flow_reorder_node_links:n #1 {
  \str_if_eq:VnF \l_semio_viz_flow_link_sort_tl { none } {
    \seq_map_inline:cn { l_semio_viz_network_tlink_ \int_eval:n {#1} _seq }
      { \semio_viz_flow_sort_source_links:n { \semio_viz_network_n:nn { es } {##1} } }
    \seq_map_inline:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq }
      { \semio_viz_flow_sort_target_links:n { \semio_viz_network_n:nn { et } {##1} } }
  }
}
%endregion 🔖️LinkOrder

%region 🔖️Breadths
% 💧 d3's initializeNodeBreadths: one common value scale, then each column is packed and centred.
\cs_new_protected:Npn \semio_viz_flow_initial_breadths: {
  \fp_set:Nn \l_semio_viz_flow_ky_fp { inf }
  \int_step_inline:nn { \l_semio_viz_flow_layers_int } { \semio_viz_flow_column_scale:n {##1} }
  \int_step_inline:nn { \l_semio_viz_flow_layers_int } { \semio_viz_flow_column_place:n {##1} }
}
% 📏 Lowers the common value-to-height factor to what column #1 can afford once its padding is off.
\cs_new_protected:Npn \semio_viz_flow_column_scale:n #1 {
  \fp_zero:N \l_semio_viz_flow_acc_fp
  \seq_map_inline:cn { l_semio_viz_network_col_ \int_eval:n {#1} _seq }
    { \fp_add:Nn \l_semio_viz_flow_acc_fp { \semio_viz_network_f:nn { nv } {##1} } }
  \fp_compare:nNnT \l_semio_viz_flow_acc_fp > { 0 } {
    \fp_set:Nn \l_semio_viz_flow_ky_fp
      {
        min( \l_semio_viz_flow_ky_fp ,
          ( \l_semio_viz_flow_y_one_fp - \l_semio_viz_flow_y_zero_fp
            - ( \seq_count:c { l_semio_viz_network_col_ \int_eval:n {#1} _seq } - 1 )
              * \l_semio_viz_flow_py_fp )
          / \l_semio_viz_flow_acc_fp )
      }
  }
}
% 📐 Stacks column #1 from the top, then spreads the slack evenly so the column reads centred.
\cs_new_protected:Npn \semio_viz_flow_column_place:n #1 {
  \fp_set_eq:NN \l_semio_viz_flow_cursor_fp \l_semio_viz_flow_y_zero_fp
  \seq_map_inline:cn { l_semio_viz_network_col_ \int_eval:n {#1} _seq }
    { \semio_viz_flow_column_stack:n {##1} }
  \fp_set:Nn \l_semio_viz_flow_shift_fp
    {
      ( \l_semio_viz_flow_y_one_fp - \l_semio_viz_flow_cursor_fp + \l_semio_viz_flow_py_fp )
      / ( \seq_count:c { l_semio_viz_network_col_ \int_eval:n {#1} _seq } + 1 )
    }
  \seq_map_indexed_inline:cn { l_semio_viz_network_col_ \int_eval:n {#1} _seq } {
    \semio_viz_network_fadd:nnn { ny } {##2} { \l_semio_viz_flow_shift_fp * ##1 }
    \semio_viz_network_fadd:nnn { nyb } {##2} { \l_semio_viz_flow_shift_fp * ##1 }
  }
  \seq_map_inline:cn { l_semio_viz_network_col_ \int_eval:n {#1} _seq }
    { \semio_viz_flow_reorder_links:n {##1} }
}
% 📥 Places node #1 at the running cursor, its height its value times the common factor.
\cs_new_protected:Npn \semio_viz_flow_column_stack:n #1 {
  \semio_viz_network_fset:nnn { ny } {#1} { \l_semio_viz_flow_cursor_fp }
  \semio_viz_network_fset:nnn { nyb } {#1}
    { \l_semio_viz_flow_cursor_fp + \semio_viz_network_f:nn { nv } {#1} * \l_semio_viz_flow_ky_fp }
  \fp_set:Nn \l_semio_viz_flow_cursor_fp
    { \semio_viz_network_f:nn { nyb } {#1} + \l_semio_viz_flow_py_fp }
  \seq_map_inline:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq }
    {
      \semio_viz_network_fset:nnn { lw } {##1}
        { \semio_viz_network_f:nn { ew } {##1} * \l_semio_viz_flow_ky_fp }
    }
}
%endregion 🔖️Breadths

%region 🔖️Relaxation
% 💧 d3's targetTop and sourceTop: where a link would sit if the partner node's stack were followed exactly.
\cs_new_protected:Npn \semio_viz_flow_target_top:nn #1#2 {
  \fp_set:Nn \l_semio_viz_flow_top_fp
    {
      \semio_viz_network_f:nn { ny } {#1}
      - ( \seq_count:c { l_semio_viz_network_slink_ \int_eval:n {#1} _seq } - 1 )
        * \l_semio_viz_flow_py_fp / 2
    }
  \seq_map_inline:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq } {
    \int_compare:nNnTF { \semio_viz_network_n:nn { et } {##1} } = {#2}
      { \seq_map_break: }
      {
        \fp_add:Nn \l_semio_viz_flow_top_fp
          { \semio_viz_network_f:nn { lw } {##1} + \l_semio_viz_flow_py_fp }
      }
  }
  \seq_map_inline:cn { l_semio_viz_network_tlink_ \int_eval:n {#2} _seq } {
    \int_compare:nNnTF { \semio_viz_network_n:nn { es } {##1} } = {#1}
      { \seq_map_break: }
      { \fp_sub:Nn \l_semio_viz_flow_top_fp { \semio_viz_network_f:nn { lw } {##1} } }
  }
}
% 💧 The mirror of `target_top`: where the link from #1 to #2 would sit if #2's incoming stack
% were followed exactly.
\cs_new_protected:Npn \semio_viz_flow_source_top:nn #1#2 {
  \fp_set:Nn \l_semio_viz_flow_top_fp
    {
      \semio_viz_network_f:nn { ny } {#2}
      - ( \seq_count:c { l_semio_viz_network_tlink_ \int_eval:n {#2} _seq } - 1 )
        * \l_semio_viz_flow_py_fp / 2
    }
  \seq_map_inline:cn { l_semio_viz_network_tlink_ \int_eval:n {#2} _seq } {
    \int_compare:nNnTF { \semio_viz_network_n:nn { es } {##1} } = {#1}
      { \seq_map_break: }
      {
        \fp_add:Nn \l_semio_viz_flow_top_fp
          { \semio_viz_network_f:nn { lw } {##1} + \l_semio_viz_flow_py_fp }
      }
  }
  \seq_map_inline:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq } {
    \int_compare:nNnTF { \semio_viz_network_n:nn { et } {##1} } = {#2}
      { \seq_map_break: }
      { \fp_sub:Nn \l_semio_viz_flow_top_fp { \semio_viz_network_f:nn { lw } {##1} } }
  }
}

% 💧 Moves a node by a precomputed delta; the delta is evaluated once, before y0 changes.
\cs_new_protected:Npn \semio_viz_flow_node_move:nn #1#2 {
  \fp_set:Nn \l_semio_viz_flow_delta_fp {#2}
  \semio_viz_network_fadd:nnn { ny } {#1} { \l_semio_viz_flow_delta_fp }
  \semio_viz_network_fadd:nnn { nyb } {#1} { \l_semio_viz_flow_delta_fp }
  \semio_viz_flow_reorder_node_links:n {#1}
}

% ⚖️ Pulls node #1 towards the weighted mean of where its incoming links would like it, damped by
% the relaxation's own alpha.
\cs_new_protected:Npn \semio_viz_flow_relax_target:n #1 {
  \fp_zero:N \l_semio_viz_flow_acc_fp
  \fp_zero:N \l_semio_viz_flow_weight_fp
  \seq_map_inline:cn { l_semio_viz_network_tlink_ \int_eval:n {#1} _seq }
    { \semio_viz_flow_relax_target_term:nn {#1} {##1} }
  \fp_compare:nNnT \l_semio_viz_flow_weight_fp > { 0 }
    {
      \semio_viz_flow_node_move:nn {#1}
        {
          ( \l_semio_viz_flow_acc_fp / \l_semio_viz_flow_weight_fp
            - \semio_viz_network_f:nn { ny } {#1} ) * \l_semio_viz_flow_alpha_fp
        }
    }
}
% ➕ One term of that mean: link #2's own preferred top for node #1, weighted by the link's value
% and by how many columns it spans.
\cs_new_protected:Npn \semio_viz_flow_relax_target_term:nn #1#2 {
  \fp_set:Nn \l_semio_viz_flow_shift_fp
    {
      \semio_viz_network_f:nn { ew } {#2}
      * ( \semio_viz_network_n:nn { nl } {#1}
        - \semio_viz_network_n:nn { nl } { \semio_viz_network_n:nn { es } {#2} } )
    }
  \semio_viz_flow_target_top:nn { \semio_viz_network_n:nn { es } {#2} } {#1}
  \fp_add:Nn \l_semio_viz_flow_acc_fp { \l_semio_viz_flow_top_fp * \l_semio_viz_flow_shift_fp }
  \fp_add:Nn \l_semio_viz_flow_weight_fp { \l_semio_viz_flow_shift_fp }
}

% ⚖️ The mirror pass: node #1 pulled towards where its outgoing links would like it.
\cs_new_protected:Npn \semio_viz_flow_relax_source:n #1 {
  \fp_zero:N \l_semio_viz_flow_acc_fp
  \fp_zero:N \l_semio_viz_flow_weight_fp
  \seq_map_inline:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq }
    { \semio_viz_flow_relax_source_term:nn {#1} {##1} }
  \fp_compare:nNnT \l_semio_viz_flow_weight_fp > { 0 }
    {
      \semio_viz_flow_node_move:nn {#1}
        {
          ( \l_semio_viz_flow_acc_fp / \l_semio_viz_flow_weight_fp
            - \semio_viz_network_f:nn { ny } {#1} ) * \l_semio_viz_flow_alpha_fp
        }
    }
}
% ➕ One term of that mirror mean, weighted the same way.
\cs_new_protected:Npn \semio_viz_flow_relax_source_term:nn #1#2 {
  \fp_set:Nn \l_semio_viz_flow_shift_fp
    {
      \semio_viz_network_f:nn { ew } {#2}
      * ( \semio_viz_network_n:nn { nl } { \semio_viz_network_n:nn { et } {#2} }
        - \semio_viz_network_n:nn { nl } {#1} )
    }
  \semio_viz_flow_source_top:nn {#1} { \semio_viz_network_n:nn { et } {#2} }
  \fp_add:Nn \l_semio_viz_flow_acc_fp { \l_semio_viz_flow_top_fp * \l_semio_viz_flow_shift_fp }
  \fp_add:Nn \l_semio_viz_flow_weight_fp { \l_semio_viz_flow_shift_fp }
}

% 💧 d3's ascendingBreadth column sort, applied only when `node-sort` keeps d3's default behaviour.
\cs_new_protected:Npn \semio_viz_flow_sort_column:n #1 {
  \str_if_eq:VnT \l_semio_viz_flow_node_sort_tl { auto } {
    \seq_sort:cn { l_semio_viz_network_col_ \int_eval:n {#1} _seq }
      {
        \fp_compare:nNnTF { \semio_viz_network_f:nn { ny } {##1} } > { \semio_viz_network_f:nn { ny } {##2} }
          { \sort_return_swapped: } { \sort_return_same: }
      }
  }
}

% 💧 d3's resolveCollisions: push apart from the middle node outwards, then clamp against both extents.
\cs_new_protected:Npn \semio_viz_flow_resolve:n #1 {
  \seq_set_eq:Nc \l_semio_viz_flow_column_seq { l_semio_viz_network_col_ \int_eval:n {#1} _seq }
  \int_set:Nn \l_semio_viz_flow_pivot_int
    { \fp_to_int:n { floor( \seq_count:N \l_semio_viz_flow_column_seq / 2 ) } + 1 }
  \semio_viz_flow_up:nn
    { \semio_viz_network_f:nn { ny } { \seq_item:Nn \l_semio_viz_flow_column_seq { \l_semio_viz_flow_pivot_int } }
      - \l_semio_viz_flow_py_fp }
    { \l_semio_viz_flow_pivot_int - 1 }
  \semio_viz_flow_down:nn
    { \semio_viz_network_f:nn { nyb } { \seq_item:Nn \l_semio_viz_flow_column_seq { \l_semio_viz_flow_pivot_int } }
      + \l_semio_viz_flow_py_fp }
    { \l_semio_viz_flow_pivot_int + 1 }
  \semio_viz_flow_up:nn { \l_semio_viz_flow_y_one_fp } { \seq_count:N \l_semio_viz_flow_column_seq }
  \semio_viz_flow_down:nn { \l_semio_viz_flow_y_zero_fp } { 1 }
}
% ⬇️ Pushes the column's nodes from index #2 downwards, starting the cursor at #1.
\cs_new_protected:Npn \semio_viz_flow_down:nn #1#2 {
  \fp_set:Nn \l_semio_viz_flow_cursor_fp {#1}
  \int_step_inline:nnn {#2} { \seq_count:N \l_semio_viz_flow_column_seq }
    { \semio_viz_flow_down_one:n { \seq_item:Nn \l_semio_viz_flow_column_seq {##1} } }
}
% ⬇️ Moves node #1 down onto the cursor when it overlaps, damped by beta, and advances the cursor.
\cs_new_protected:Npn \semio_viz_flow_down_one:n #1 {
  \fp_set:Nn \l_semio_viz_flow_shift_fp
    { ( \l_semio_viz_flow_cursor_fp - \semio_viz_network_f:nn { ny } {#1} ) * \l_semio_viz_flow_beta_fp }
  \fp_compare:nNnT \l_semio_viz_flow_shift_fp > { 1e-6 } {
    \semio_viz_network_fadd:nnn { ny } {#1} { \l_semio_viz_flow_shift_fp }
    \semio_viz_network_fadd:nnn { nyb } {#1} { \l_semio_viz_flow_shift_fp }
  }
  \fp_set:Nn \l_semio_viz_flow_cursor_fp
    { \semio_viz_network_f:nn { nyb } {#1} + \l_semio_viz_flow_py_fp }
}
% ⬆️ The mirror walk: the column's nodes from index #2 upwards, cursor starting at #1.
\cs_new_protected:Npn \semio_viz_flow_up:nn #1#2 {
  \fp_set:Nn \l_semio_viz_flow_cursor_fp {#1}
  \int_step_inline:nnnn {#2} { -1 } { 1 }
    { \semio_viz_flow_up_one:n { \seq_item:Nn \l_semio_viz_flow_column_seq {##1} } }
}
% ⬆️ Moves node #1 up onto the cursor when it overlaps, damped by beta, and advances the cursor.
\cs_new_protected:Npn \semio_viz_flow_up_one:n #1 {
  \fp_set:Nn \l_semio_viz_flow_shift_fp
    { ( \semio_viz_network_f:nn { nyb } {#1} - \l_semio_viz_flow_cursor_fp ) * \l_semio_viz_flow_beta_fp }
  \fp_compare:nNnT \l_semio_viz_flow_shift_fp > { 1e-6 } {
    \semio_viz_network_fadd:nnn { ny } {#1} { - \l_semio_viz_flow_shift_fp }
    \semio_viz_network_fadd:nnn { nyb } {#1} { - \l_semio_viz_flow_shift_fp }
  }
  \fp_set:Nn \l_semio_viz_flow_cursor_fp
    { \semio_viz_network_f:nn { ny } {#1} - \l_semio_viz_flow_py_fp }
}

% ◀️ One right-to-left pass over column #1: relax against the incoming links, sort, resolve overlaps.
\cs_new_protected:Npn \semio_viz_flow_relax_left:n #1 {
  \seq_map_inline:cn { l_semio_viz_network_col_ \int_eval:n {#1} _seq }
    { \semio_viz_flow_relax_target:n {##1} }
  \semio_viz_flow_sort_column:n {#1}
  \semio_viz_flow_resolve:n {#1}
}
% ▶️ The mirror pass over column #1: relax against the outgoing links, sort, resolve overlaps.
\cs_new_protected:Npn \semio_viz_flow_relax_right:n #1 {
  \seq_map_inline:cn { l_semio_viz_network_col_ \int_eval:n {#1} _seq }
    { \semio_viz_flow_relax_source:n {##1} }
  \semio_viz_flow_sort_column:n {#1}
  \semio_viz_flow_resolve:n {#1}
}

% 💧 d3's computeNodeBreadths loop: alpha decays as 0.99^i, beta grows, right-to-left then left-to-right.
\cs_new_protected:Npn \semio_viz_flow_relax: {
  \int_step_inline:nn { \l_semio_viz_flow_iterations_int } {
    \fp_set:Nn \l_semio_viz_flow_alpha_fp { 0.99 ** ( ##1 - 1 ) }
    \fp_set:Nn \l_semio_viz_flow_beta_fp
      { max( 1 - \l_semio_viz_flow_alpha_fp , ##1 / \l_semio_viz_flow_iterations_int ) }
    \int_step_inline:nnn { 1 } { \l_semio_viz_flow_layers_int - 1 }
      { \semio_viz_flow_relax_right:n { \l_semio_viz_flow_layers_int - ####1 } }
    \int_step_inline:nnn { 2 } { \l_semio_viz_flow_layers_int }
      { \semio_viz_flow_relax_left:n {####1} }
  }
}

% 💧 d3's computeLinkBreadths: link centres stack in the node's own link order.
\cs_new_protected:Npn \semio_viz_flow_link_breadths: {
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_flow_link_breadth:n {##1} }
}
% 🎗️ Stacks the ribbons on node #1: the outgoing ones down its right edge, the incoming ones down
% its left edge, each as thick as its own value.
\cs_new_protected:Npn \semio_viz_flow_link_breadth:n #1 {
  \fp_set:Nn \l_semio_viz_flow_cursor_fp { \semio_viz_network_f:nn { ny } {#1} }
  \seq_map_inline:cn { l_semio_viz_network_slink_ \int_eval:n {#1} _seq } {
    \semio_viz_network_fset:nnn { ly } {##1}
      { \l_semio_viz_flow_cursor_fp + \semio_viz_network_f:nn { lw } {##1} / 2 }
    \fp_add:Nn \l_semio_viz_flow_cursor_fp { \semio_viz_network_f:nn { lw } {##1} }
  }
  \fp_set:Nn \l_semio_viz_flow_cursor_fp { \semio_viz_network_f:nn { ny } {#1} }
  \seq_map_inline:cn { l_semio_viz_network_tlink_ \int_eval:n {#1} _seq } {
    \semio_viz_network_fset:nnn { lyb } {##1}
      { \l_semio_viz_flow_cursor_fp + \semio_viz_network_f:nn { lw } {##1} / 2 }
    \fp_add:Nn \l_semio_viz_flow_cursor_fp { \semio_viz_network_f:nn { lw } {##1} }
  }
}
%endregion 🔖️Relaxation

%region 🔖️Sankey
% 💧 Runs the whole d3-sankey pipeline on the bound graph. O(iterations * layers * (n + m log m)).
\cs_new_protected:Npn \semio_viz_flow_sankey_run: {
  \semio_viz_flow_node_links:
  \semio_viz_flow_node_values:
  \semio_viz_flow_levels:nnn { nd } { slink } { et }
  \semio_viz_flow_levels:nnn { nh } { tlink } { es }
  \semio_viz_flow_layers:
  \int_set:Nn \l_semio_viz_flow_wide_int { 1 }
  \int_step_inline:nn { \l_semio_viz_flow_layers_int } {
    \int_compare:nNnT { \seq_count:c { l_semio_viz_network_col_ ##1 _seq } } > \l_semio_viz_flow_wide_int
      { \int_set:Nn \l_semio_viz_flow_wide_int { \seq_count:c { l_semio_viz_network_col_ ##1 _seq } } }
  }
  \fp_set:Nn \l_semio_viz_flow_py_fp
    {
      min( \l_semio_viz_flow_node_padding_fp ,
        ( \l_semio_viz_flow_y_one_fp - \l_semio_viz_flow_y_zero_fp )
        / max( 1 , \l_semio_viz_flow_wide_int - 1 ) )
    }
  \semio_viz_flow_initial_breadths:
  \semio_viz_flow_relax:
  \semio_viz_flow_link_breadths:
}

% 📤 Writes the sankey geometry: one `node` row per node, one `link` row per link, in input order.
\cs_new_protected:Npn \semio_viz_flow_emit:n #1 {
  \semio_viz_network_out_new:nn {#1} { kind, i, j, id, value, x0, y0, x1, y1, width, layer }
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_flow_emit_node:nn {#1} {##1} }
  \int_step_inline:nn { \l_semio_viz_network_m_int } { \semio_viz_flow_emit_link:nn {#1} {##1} }
}
% 📤 One `node` row of the output table #1 for node #2, and its probe record.
\cs_new_protected:Npn \semio_viz_flow_emit_node:nn #1#2 {
  \semio_viz_network_out_row:nn {#1}
    {
      node , #2 , #2 , \semio_viz_network_id:n {#2} ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nv } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nx } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { ny } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nxb } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nyb } {#2} } ,
      0 , \semio_viz_network_n:nn { nl } {#2}
    }
  \semio_viz_probe_geometry:nx { layout/sankey-node }
    {
      #2 ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nx } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { ny } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nxb } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nyb } {#2} }
    }
}
% 📤 One `link` row of the output table #1 for link #2, and its probe record.
\cs_new_protected:Npn \semio_viz_flow_emit_link:nn #1#2 {
  \semio_viz_network_out_row:nn {#1}
    {
      link , \semio_viz_network_n:nn { es } {#2} , \semio_viz_network_n:nn { et } {#2} , #2 ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { ew } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nxb } { \semio_viz_network_n:nn { es } {#2} } } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { ly } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { nx } { \semio_viz_network_n:nn { et } {#2} } } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { lyb } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { lw } {#2} } ,
      0
    }
  \semio_viz_probe_geometry:nx { layout/sankey-link }
    {
      #2 ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { ly } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { lyb } {#2} } ,
      \fp_to_decimal:n { \semio_viz_network_f:nn { lw } {#2} }
    }
}

% 💧 The `sankey` layout algorithm: `\SemioVizLayout{sankey}{in}{out}[align=…, iterations=…]`,
% d3-sankey's own pipeline from the link table #1 into the geometry table #2.
\semio_viz_layout_define:nn { sankey } {
  \semio_viz_network_use:nn {#1} {#3}
  \semio_viz_network_keys:nNn { layout / sankey } \c_semio_viz_flow_sankey_defaults_tl {#3}
  \semio_viz_flow_sankey_run:
  \semio_viz_flow_emit:n {#2}
}
%endregion 🔖️Sankey

%region 🔖️Alluvial
% 🌊 Alluvial: a sankey whose layers are the ordered categorical axes of the data, so nodes never move
% between columns; the stratum order inside an axis is fixed by `node-sort=none` unless asked otherwise.
\semio_viz_layout_define:nn { alluvial } {
  \semio_viz_network_use:nn {#1} {#3}
  \semio_viz_network_keys:nNn { layout / sankey } \c_semio_viz_flow_sankey_defaults_tl
    { node-align = left, node-sort = none, #3 }
  \semio_viz_flow_sankey_run:
  \semio_viz_flow_emit:n {#2}
}
%endregion 🔖️Alluvial

%region 🔖️ParallelSets
% 🎏 Parallel sets: an alluvial with zero node padding and full-height strata, so each axis is a
% complete partition of the population rather than a set of separated blocks.
\semio_viz_layout_define:nn { parallel-sets } {
  \semio_viz_network_use:nn {#1} {#3}
  \semio_viz_network_keys:nNn { layout / sankey } \c_semio_viz_flow_sankey_defaults_tl
    { node-align = left, node-sort = none, node-padding = 0, #3 }
  \semio_viz_flow_sankey_run:
  \semio_viz_flow_emit:n {#2}
}
%endregion 🔖️ParallelSets

\ExplSyntaxOff
