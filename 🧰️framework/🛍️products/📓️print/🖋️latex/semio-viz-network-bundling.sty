\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-network-bundling}[2026/09/05 v0.3.0 semio viz namespace network-bundling families]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-format}
\RequirePackage{semio-viz-network-graph}

\ExplSyntaxOn

%region 🔖️Keys
% 🔑 semio / viz / family / edge-bundled — hierarchical edge bundling (taxonomy §8).
%   data        (table, default demo-graph-community)  graph table whose node `group` column is the hierarchy
%   beta        (number, default 0.85)  bundle tension: 1 follows the hierarchy, 0 is the straight chord
%   order       (index|name|degree|group|component|cluster, default group)  order of the leaves on the ring
%   hubRadius   (fraction of the leaf radius, default 0.45)  radius of the group hubs
%   samples     (integer, default 24)   points sampled on the B-spline through the control polygon
%   labels      (boolean, default true) leaf captions outside the ring
%   linkWidth, weightWidth, colorBy, size, padding as in `graph`
\fp_new:N \l_semio_viz_bun_beta_fp
\fp_new:N \l_semio_viz_bun_hub_fp
\int_new:N \l_semio_viz_bun_samples_int
\int_new:N \l_semio_viz_bun_rows_int
\int_new:N \l_semio_viz_bun_from_int
\tl_new:N \l_semio_viz_bun_edge_tl
\seq_new:N \l_semio_viz_bun_px_seq
\seq_new:N \l_semio_viz_bun_py_seq
\seq_new:N \l_semio_viz_bun_path_seq
\seq_new:N \l_semio_viz_bun_probe_seq

\cs_new_protected:Npn \semio_viz_bun_keys_add:n #1 {
  \semio_viz_net_keys_add:n {#1}
  \keys_define:nn {#1} {
    beta      .fp_set:N = \l_semio_viz_bun_beta_fp,
    hubRadius .fp_set:N = \l_semio_viz_bun_hub_fp,
    samples   .int_set:N = \l_semio_viz_bun_samples_int,
  }
}
% ♻️ Restores beta, hub radius, sample count and the `group` leaf order over the network reset.
\cs_new_protected:Npn \semio_viz_bun_keys_reset: {
  \semio_viz_net_keys_reset:
  \fp_set:Nn \l_semio_viz_bun_beta_fp { 0.85 }
  \fp_set:Nn \l_semio_viz_bun_hub_fp { 0.45 }
  \int_set:Nn \l_semio_viz_bun_samples_int { 24 }
  \tl_set:Nn \l_semio_viz_net_order_tl { group }
  \bool_set_true:N \l_semio_viz_net_labels_bool
}
%endregion 🔖️Keys

%region 🔖️Spline
% 〰️ Uniform cubic B-spline through the control polygon in \l_semio_viz_bun_px_seq / _py_seq, with the
% first and last control point tripled so the curve starts and ends on them. This is the `bundle`
% curve of taxonomy §0 evaluated point by point: the mark kernel's own `bundle` interpolator
% (\semio_viz_c_basis_*) emits Bezier path syntax, while edge bundling needs the sampled polyline
% both for the drawn path and for the numeric probe record it is compared on.
\fp_new:N \l_semio_viz_bun_x_fp
\fp_new:N \l_semio_viz_bun_y_fp
\int_new:N \l_semio_viz_bun_n_int

\cs_new:Npn \semio_viz_bun_ctrl:Nn #1#2
  { \seq_item:Nn #1 { \int_max:nn { 1 } { \int_min:nn { \seq_count:N #1 } { \int_eval:n {#2} } } } }

% ✏️ Evaluates the four B-spline basis weights at parameter #2 of segment #1 into the point registers.
\cs_new_protected:Npn \semio_viz_bun_spline_point:nn #1#2 {
  \fp_set:Nn \l_semio_viz_bun_x_fp
    {
      ( ( 1 - (#2) ) ** 3 * \semio_viz_bun_ctrl:Nn \l_semio_viz_bun_px_seq { (#1) - 1 }
        + ( 3 * (#2) ** 3 - 6 * (#2) ** 2 + 4 )
          * \semio_viz_bun_ctrl:Nn \l_semio_viz_bun_px_seq { #1 }
        + ( - 3 * (#2) ** 3 + 3 * (#2) ** 2 + 3 * (#2) + 1 )
          * \semio_viz_bun_ctrl:Nn \l_semio_viz_bun_px_seq { (#1) + 1 }
        + (#2) ** 3 * \semio_viz_bun_ctrl:Nn \l_semio_viz_bun_px_seq { (#1) + 2 } ) / 6
    }
  \fp_set:Nn \l_semio_viz_bun_y_fp
    {
      ( ( 1 - (#2) ) ** 3 * \semio_viz_bun_ctrl:Nn \l_semio_viz_bun_py_seq { (#1) - 1 }
        + ( 3 * (#2) ** 3 - 6 * (#2) ** 2 + 4 )
          * \semio_viz_bun_ctrl:Nn \l_semio_viz_bun_py_seq { #1 }
        + ( - 3 * (#2) ** 3 + 3 * (#2) ** 2 + 3 * (#2) + 1 )
          * \semio_viz_bun_ctrl:Nn \l_semio_viz_bun_py_seq { (#1) + 1 }
        + (#2) ** 3 * \semio_viz_bun_ctrl:Nn \l_semio_viz_bun_py_seq { (#1) + 2 } ) / 6
    }
}

% 🖌️ Samples every segment of the control polygon, strokes the resulting polyline and files the probe.
\cs_new_protected:Npn \semio_viz_bun_spline_draw: {
  \seq_clear:N \l_semio_viz_bun_path_seq
  \seq_clear:N \l_semio_viz_bun_probe_seq
  \int_set:Nn \l_semio_viz_bun_n_int { \seq_count:N \l_semio_viz_bun_px_seq }
  \int_step_inline:nn { \l_semio_viz_bun_n_int - 1 } { \semio_viz_bun_segment:n {##1} }
  \use:x {
    \exp_not:N \draw [ draw=\l_semio_viz_net_stroke_tl ,
        line~width=\fp_eval:n { max( 0.05 , \l_semio_viz_net_e_fp ) } mm , line~cap=round ]
      \seq_use:Nn \l_semio_viz_bun_path_seq { } ;
  }
  \semio_viz_probe_geometry:nx { bundle }
    { \seq_use:Nn \l_semio_viz_bun_probe_seq { , } }
}
% 🧵 Emits the `samples` points of spline segment #1.
\cs_new_protected:Npn \semio_viz_bun_segment:n #1 {
  \int_step_inline:nn { \l_semio_viz_bun_samples_int } { \semio_viz_bun_sample:nn {#1} {##1} }
}
% 📌 One sampled point: appended to the TikZ path (with the `--` skipped on the very first) and to the probe.
\cs_new_protected:Npn \semio_viz_bun_sample:nn #1#2 {
  \semio_viz_bun_spline_point:nn {#1} { ( #2 - 1 ) / ( \l_semio_viz_bun_samples_int - 1 ) }
  \seq_put_right:Nx \l_semio_viz_bun_path_seq
    {
      \int_compare:nNnTF { #1 + #2 } = { 2 } { } { -- }
      ( \fp_to_decimal:n { \l_semio_viz_bun_x_fp } ,
        \fp_to_decimal:n { \l_semio_viz_bun_y_fp } )
    }
  \seq_put_right:Nx \l_semio_viz_bun_probe_seq { \semio_viz_format_mm:n { \l_semio_viz_bun_x_fp } }
  \seq_put_right:Nx \l_semio_viz_bun_probe_seq { \semio_viz_format_mm:n { \l_semio_viz_bun_y_fp } }
}
%endregion 🔖️Spline

%region 🔖️Bundling
% 🎋 Collects the control polygon rows of one edge from the layout output and draws its bundled path.
\tl_new:N \l_semio_viz_bun_x_tl
\tl_new:N \l_semio_viz_bun_y_tl
\cs_new_protected:Npn \semio_viz_bun_edge_draw:nn #1#2 {
  \seq_clear:N \l_semio_viz_bun_px_seq
  \seq_clear:N \l_semio_viz_bun_py_seq
  \int_step_inline:nn { #2 - #1 + 1 } { \semio_viz_bun_edge_point:n { #1 + ##1 - 1 } }
  \seq_put_left:Nx \l_semio_viz_bun_px_seq { \seq_item:Nn \l_semio_viz_bun_px_seq { 1 } }
  \seq_put_left:Nx \l_semio_viz_bun_py_seq { \seq_item:Nn \l_semio_viz_bun_py_seq { 1 } }
  \seq_put_right:Nx \l_semio_viz_bun_px_seq { \seq_item:Nn \l_semio_viz_bun_px_seq { -1 } }
  \seq_put_right:Nx \l_semio_viz_bun_py_seq { \seq_item:Nn \l_semio_viz_bun_py_seq { -1 } }
  \semio_viz_bun_spline_draw:
}
% 📥 Reads control-point row #1 of the layout output and appends it, in canvas millimetres, to the polygon.
\cs_new_protected:Npn \semio_viz_bun_edge_point:n #1 {
  \semio_viz_table_cell:nnnN { semio-net-bundle } {#1} { x } \l_semio_viz_bun_x_tl
  \semio_viz_table_cell:nnnN { semio-net-bundle } {#1} { y } \l_semio_viz_bun_y_tl
  \seq_put_right:Nx \l_semio_viz_bun_px_seq
    { \fp_to_decimal:n { \semio_viz_net_px:n { \l_semio_viz_bun_x_tl } } }
  \seq_put_right:Nx \l_semio_viz_bun_py_seq
    { \fp_to_decimal:n { \semio_viz_net_py:n { \l_semio_viz_bun_y_tl } } }
}

% 🎋 Walks the layout output, one control-point block per edge, in edge order.
\cs_new_protected:Npn \semio_viz_bun_edges_draw: {
  \semio_viz_table_nrows:nN { semio-net-bundle } \l_semio_viz_bun_rows_int
  \int_set:Nn \l_semio_viz_bun_from_int { 1 }
  \int_step_inline:nn { \l_semio_viz_bun_rows_int } { \semio_viz_bun_scan:n {##1} }
}
% 🔍 Row #1 of the scan: a `step` of zero closes the previous block, and the last row closes the final one.
\cs_new_protected:Npn \semio_viz_bun_scan:n #1 {
  \semio_viz_table_cell:nnnN { semio-net-bundle } {#1} { step } \l_semio_viz_bun_edge_tl
  \int_compare:nNnT { \l_semio_viz_bun_edge_tl } = { 0 } {
    \int_compare:nNnT {#1} > { 1 } {
      \semio_viz_bun_flush:nn { \l_semio_viz_bun_from_int } { #1 - 1 }
      \int_set:Nn \l_semio_viz_bun_from_int {#1}
    }
  }
  \int_compare:nNnT {#1} = \l_semio_viz_bun_rows_int
    { \semio_viz_bun_flush:nn { \l_semio_viz_bun_from_int } {#1} }
}
% 🚿 Draws the block of rows #1..#2 as one edge, styled by the edge id carried on its first row.
\cs_new_protected:Npn \semio_viz_bun_flush:nn #1#2 {
  \semio_viz_table_cell:nnnN { semio-net-bundle } {#1} { edge } \l_semio_viz_bun_edge_tl
  \semio_viz_net_link_style:n { \l_semio_viz_bun_edge_tl }
  \semio_viz_bun_edge_draw:nn {#1} {#2}
}

% 🎋 edge-bundled — the leaves on a ring, the links bundled along the group hierarchy.
\cs_new_protected:Npn \semio_viz_bun_render:n #1 {
  \semio_viz_frame_require:n { SemioVizRunFamily }
  \semio_viz_bun_keys_reset:
  \keys_set:nn { semio / viz / family / edge-bundled } {#1}
  \semio_viz_net_bind_build:
  \tl_set:Nx \l_semio_viz_net_layopts_tl
    {
      \l_semio_viz_net_bind_tl
      order = \l_semio_viz_net_order_tl ,
      beta = \fp_use:N \l_semio_viz_bun_beta_fp ,
      radius = 1 ,
      inner-radius = \fp_use:N \l_semio_viz_bun_hub_fp
    }
  \semio_viz_layout_run:VVnV \c_semio_viz_bun_layout_tl \l_semio_viz_net_data_tl
    { semio-net-bundle } \l_semio_viz_net_layopts_tl
  \semio_viz_network_components:
  \semio_viz_net_groups_build:
  \semio_viz_net_extremes:
  \semio_viz_net_canvas:
  \semio_viz_net_fit:n { \fp_eval:n { 2.4 * \l_semio_viz_net_size_fp } }
  \semio_viz_bun_edges_draw:
  \int_step_inline:nn { \l_semio_viz_network_n_int } { \semio_viz_bun_leaf_draw:n {##1} }
}
% 🍃 One leaf on the ring: its node mark and, when labels are on, its caption pushed just outside.
\cs_new_protected:Npn \semio_viz_bun_leaf_draw:n #1 {
  \semio_viz_net_node_fill_pick:n {#1}
  \semio_viz_net_draw_node:nnn
    { \semio_viz_net_nx:n {#1} } { \semio_viz_net_ny:n {#1} } { \l_semio_viz_net_size_fp }
  \bool_if:NT \l_semio_viz_net_labels_bool {
    \semio_viz_net_draw_text:nnn
      { \semio_viz_net_px:n { 1.14 * \semio_viz_network_f:nn { x } {#1} } }
      { \semio_viz_net_py:n { 1.14 * \semio_viz_network_f:nn { y } {#1} } }
      { \semio_viz_network_id:n {#1} }
  }
}
\tl_const:Nn \c_semio_viz_bun_layout_tl { bundling }

\semio_viz_bun_keys_add:n { semio / viz / family / edge-bundled }
% 🎋 Registers the `edge-bundled` catalogue entry on the bundling renderer.
\SemioVizFamily { edge-bundled } { \semio_viz_bun_render:n {#1} }
%endregion 🔖️Bundling

\ExplSyntaxOff
