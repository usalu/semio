% 🧹 d3-array's nice(start, stop, count): the rounded interval lands in #4 and #5.
\cs_new_protected:Npn \semio_viz_scale_nice_pair:nnnNN #1#2#3#4#5 {
  \fp_set:Nn \l_semio_viz_scale_a_fp {#1}
  \fp_set:Nn \l_semio_viz_scale_b_fp {#2}
  \bool_set:Nn \l_semio_viz_scale_reverse_bool
    { \fp_compare_p:nNn { \l_semio_viz_scale_b_fp } < { \l_semio_viz_scale_a_fp } }
  \bool_if:NT \l_semio_viz_scale_reverse_bool
    {
      \fp_set_eq:NN \l_semio_viz_scale_x_fp \l_semio_viz_scale_a_fp
      \fp_set_eq:NN \l_semio_viz_scale_a_fp \l_semio_viz_scale_b_fp
      \fp_set_eq:NN \l_semio_viz_scale_b_fp \l_semio_viz_scale_x_fp
    }
  \fp_set:Nn \l_semio_viz_scale_prestep_fp { nan }
  \int_step_inline:nn { \l_semio_viz_scale_nice_iterations_int }
    {
      \semio_viz_scale_tick_increment:nnnN { \l_semio_viz_scale_a_fp }
        { \l_semio_viz_scale_b_fp } {#3} \l_semio_viz_scale_step_fp
      \fp_compare:nNnF { \l_semio_viz_scale_step_fp } = { \l_semio_viz_scale_prestep_fp }
        {
          \fp_compare:nNnTF { \l_semio_viz_scale_step_fp } > { 0 }
            {
              \fp_set:Nn \l_semio_viz_scale_a_fp
                {
                  floor( \l_semio_viz_scale_a_fp / \l_semio_viz_scale_step_fp )
                    * \l_semio_viz_scale_step_fp
                }
              \fp_set:Nn \l_semio_viz_scale_b_fp
                {
                  ceil( \l_semio_viz_scale_b_fp / \l_semio_viz_scale_step_fp )
                    * \l_semio_viz_scale_step_fp
                }
            }
            {
              \fp_set:Nn \l_semio_viz_scale_a_fp
                {
                  ceil( \l_semio_viz_scale_a_fp * \l_semio_viz_scale_step_fp )
                    / \l_semio_viz_scale_step_fp
                }
              \fp_set:Nn \l_semio_viz_scale_b_fp
                {
                  floor( \l_semio_viz_scale_b_fp * \l_semio_viz_scale_step_fp )
                    / \l_semio_viz_scale_step_fp
                }
            }
          \fp_set_eq:NN \l_semio_viz_scale_prestep_fp \l_semio_viz_scale_step_fp
        }
    }
  \bool_if:NT \l_semio_viz_scale_reverse_bool
    {
      \fp_set_eq:NN \l_semio_viz_scale_x_fp \l_semio_viz_scale_a_fp
      \fp_set_eq:NN \l_semio_viz_scale_a_fp \l_semio_viz_scale_b_fp
      \fp_set_eq:NN \l_semio_viz_scale_b_fp \l_semio_viz_scale_x_fp
    }
  \fp_set_eq:NN #4 \l_semio_viz_scale_a_fp
  \fp_set_eq:NN #5 \l_semio_viz_scale_b_fp
}
\fp_new:N \l_semio_viz_scale_prestep_fp

% 🪵 d3's log tick generator: every integer multiple of each power of the base inside the domain.
\cs_new_protected:Npn \semio_viz_scale_log_ticks:nnN #1#2#3 {
  \seq_clear:N #3
  \semio_viz_scale_numeric_prep:n {#1}
  \fp_set:Nn \l_semio_viz_scale_a_fp
    { min( \l_semio_viz_domain_lo_fp , \l_semio_viz_domain_hi_fp ) }
  \fp_set:Nn \l_semio_viz_scale_b_fp
    { max( \l_semio_viz_domain_lo_fp , \l_semio_viz_domain_hi_fp ) }
  \fp_set:Nn \l_semio_viz_scale_base_fp { \semio_viz_scale_num:nn {#1} { base } }
  \int_set:Nn \l_semio_viz_scale_ione_int
    {
      \fp_to_int:n
        { floor( ln( abs( \l_semio_viz_scale_a_fp ) ) / ln( \l_semio_viz_scale_base_fp ) ) }
    }
  \int_set:Nn \l_semio_viz_scale_itwo_int
    {
      \fp_to_int:n
        { ceil( ln( abs( \l_semio_viz_scale_b_fp ) ) / ln( \l_semio_viz_scale_base_fp ) ) }
    }
  \int_step_inline:nnn { \l_semio_viz_scale_ione_int } { \l_semio_viz_scale_itwo_int }
    {
      \int_step_inline:nnn { 1 } { \fp_to_int:n { \l_semio_viz_scale_base_fp } - 1 }
        {
          \fp_set:Nn \l_semio_viz_scale_x_fp
            { ####1 * \l_semio_viz_scale_base_fp ** ##1 }
          \fp_compare:nT
            { \l_semio_viz_scale_a_fp <= \l_semio_viz_scale_x_fp <= \l_semio_viz_scale_b_fp }
            { \seq_put_right:Nx #3 { \fp_to_decimal:n { \l_semio_viz_scale_x_fp } } }
        }
    }
  \int_compare:nNnT { 2 * \seq_count:N #3 } < {#2}
    {
      \semio_viz_scale_tick_values:nnnN { \l_semio_viz_scale_a_fp }
        { \l_semio_viz_scale_b_fp } {#2} #3
    }
  \fp_compare:nNnT { \l_semio_viz_domain_hi_fp } < { \l_semio_viz_domain_lo_fp }
    { \seq_reverse:N #3 }
}
\fp_new:N \l_semio_viz_scale_base_fp

% ⏱️ Temporal ticks at a fixed calendar interval between the domain bounds.
\cs_new_protected:Npn \semio_viz_scale_temporal_ticks:nnN #1#2#3 {
  \seq_clear:N #3
  \semio_viz_scale_epoch_set:xN
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 1 } }
    \l_semio_viz_scale_a_fp
  \semio_viz_scale_epoch_set:xN
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { -1 } }
    \l_semio_viz_scale_b_fp
  \int_set:Nn \l_semio_viz_scale_ione_int
    { \fp_to_int:n { ceil( \l_semio_viz_scale_a_fp / 86400000 ) } }
  \int_set:Nn \l_semio_viz_scale_itwo_int
    { \fp_to_int:n { floor( \l_semio_viz_scale_b_fp / 86400000 ) } }
  \str_case:nnF {#2}
    {
      { day }
        {
          \int_step_inline:nnn { \l_semio_viz_scale_ione_int } { \l_semio_viz_scale_itwo_int }
            { \semio_viz_scale_temporal_put:nN {##1} #3 }
        }
      { week }
        {
          \int_step_inline:nnn { \l_semio_viz_scale_ione_int } { \l_semio_viz_scale_itwo_int }
            {
              \int_compare:nNnT { \int_mod:nn { ##1 + 4 } { 7 } } = { 0 }
                { \semio_viz_scale_temporal_put:nN {##1} #3 }
            }
        }
      { month }
        {
          \int_step_inline:nnn { \l_semio_viz_scale_ione_int } { \l_semio_viz_scale_itwo_int }
            {
              \semio_viz_scale_civil:nN {##1} \l_semio_viz_scale_iso_str
              \str_if_eq:eeT { \str_range:Nnn \l_semio_viz_scale_iso_str { -2 } { -1 } } { 01 }
                { \semio_viz_scale_temporal_put:nN {##1} #3 }
            }
        }
      { year }
        {
          \int_step_inline:nnn { \l_semio_viz_scale_ione_int } { \l_semio_viz_scale_itwo_int }
            {
              \semio_viz_scale_civil:nN {##1} \l_semio_viz_scale_iso_str
              \str_if_eq:eeT { \str_range:Nnn \l_semio_viz_scale_iso_str { -5 } { -1 } } { 01-01 }
                { \semio_viz_scale_temporal_put:nN {##1} #3 }
            }
        }
    }
    {
      \int_step_inline:nnn { \l_semio_viz_scale_ione_int } { \l_semio_viz_scale_itwo_int }
        { \semio_viz_scale_temporal_put:nN {##1} #3 }
    }
}
\str_new:N \l_semio_viz_scale_iso_str

% 📥 Appends the ISO date of a day number to the tick sequence.
\cs_new_protected:Npn \semio_viz_scale_temporal_put:nN #1#2 {
  \semio_viz_scale_civil:nN {#1} \l_semio_viz_scale_iso_str
