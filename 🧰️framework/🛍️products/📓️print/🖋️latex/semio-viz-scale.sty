% 🌗 Normalized position of #2 on a diverging scale with a three-point domain.
\cs_new_protected:Npn \semio_viz_scale_diverging_norm:nnN #1#2#3 {
  \fp_set:Nn \l_semio_viz_scale_a_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 1 } }
  \fp_set:Nn \l_semio_viz_scale_x_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 2 } }
  \fp_set:Nn \l_semio_viz_scale_b_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 3 } }
  \fp_compare:nNnTF {#2} < { \l_semio_viz_scale_x_fp }
    {
      \fp_set:Nn #3
        {
          0.5 * ( (#2) - \l_semio_viz_scale_a_fp )
            / ( \l_semio_viz_scale_x_fp - \l_semio_viz_scale_a_fp )
        }
    }
    {
      \fp_set:Nn #3
        {
          0.5 + 0.5 * ( (#2) - \l_semio_viz_scale_x_fp )
            / ( \l_semio_viz_scale_b_fp - \l_semio_viz_scale_x_fp )
        }
    }
