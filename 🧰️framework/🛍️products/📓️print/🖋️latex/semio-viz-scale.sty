% 🌈 Interpolates two `#RRGGBB` colours at #4 in the colour space #1 (rgb, lab, hcl, oklab).
\cs_new_protected:Npn \semio_viz_color_interpolate:nnnnN #1#2#3#4#5 {
  \semio_viz_color_parse:nNNN {#2} \l_semio_viz_color_ra_fp \l_semio_viz_color_ga_fp
    \l_semio_viz_color_ba_fp
  \semio_viz_color_parse:nNNN {#3} \l_semio_viz_color_rb_fp \l_semio_viz_color_gb_fp
    \l_semio_viz_color_bb_fp
  \str_case:nnF {#1}
    {
      { rgb }
        {
          \semio_viz_color_hex:nnnN
            {
              \l_semio_viz_color_ra_fp
                + (#4) * ( \l_semio_viz_color_rb_fp - \l_semio_viz_color_ra_fp )
            }
            {
              \l_semio_viz_color_ga_fp
                + (#4) * ( \l_semio_viz_color_gb_fp - \l_semio_viz_color_ga_fp )
            }
            {
              \l_semio_viz_color_ba_fp
                + (#4) * ( \l_semio_viz_color_bb_fp - \l_semio_viz_color_ba_fp )
            }
            #5
        }
      { lab }
        {
          \semio_viz_color_to_lab:NNNNNN \l_semio_viz_color_ra_fp \l_semio_viz_color_ga_fp
            \l_semio_viz_color_ba_fp \l_semio_viz_color_la_fp \l_semio_viz_color_aa_fp
            \l_semio_viz_color_bba_fp
          \semio_viz_color_to_lab:NNNNNN \l_semio_viz_color_rb_fp \l_semio_viz_color_gb_fp
            \l_semio_viz_color_bb_fp \l_semio_viz_color_lb_fp \l_semio_viz_color_ab_fp
            \l_semio_viz_color_bbb_fp
          \semio_viz_color_mix_lab:nN {#4} #5
        }
      { hcl }
        {
          \semio_viz_color_to_lab:NNNNNN \l_semio_viz_color_ra_fp \l_semio_viz_color_ga_fp
            \l_semio_viz_color_ba_fp \l_semio_viz_color_la_fp \l_semio_viz_color_aa_fp
            \l_semio_viz_color_bba_fp
          \semio_viz_color_to_lab:NNNNNN \l_semio_viz_color_rb_fp \l_semio_viz_color_gb_fp
            \l_semio_viz_color_bb_fp \l_semio_viz_color_lb_fp \l_semio_viz_color_ab_fp
            \l_semio_viz_color_bbb_fp
          \semio_viz_color_mix_hcl:nN {#4} #5
        }
      { oklab }
        {
          \semio_viz_color_to_oklab:NNNNNN \l_semio_viz_color_ra_fp \l_semio_viz_color_ga_fp
            \l_semio_viz_color_ba_fp \l_semio_viz_color_la_fp \l_semio_viz_color_aa_fp
            \l_semio_viz_color_bba_fp
          \semio_viz_color_to_oklab:NNNNNN \l_semio_viz_color_rb_fp \l_semio_viz_color_gb_fp
            \l_semio_viz_color_bb_fp \l_semio_viz_color_lb_fp \l_semio_viz_color_ab_fp
            \l_semio_viz_color_bbb_fp
          \fp_set:Nn \l_semio_viz_color_lt_fp
            { \l_semio_viz_color_la_fp + (#4) * ( \l_semio_viz_color_lb_fp - \l_semio_viz_color_la_fp ) }
          \fp_set:Nn \l_semio_viz_color_at_fp
            { \l_semio_viz_color_aa_fp + (#4) * ( \l_semio_viz_color_ab_fp - \l_semio_viz_color_aa_fp ) }
          \fp_set:Nn \l_semio_viz_color_bt_fp
            { \l_semio_viz_color_bba_fp + (#4) * ( \l_semio_viz_color_bbb_fp - \l_semio_viz_color_bba_fp ) }
          \semio_viz_color_from_oklab:NNNNNN \l_semio_viz_color_lt_fp \l_semio_viz_color_at_fp
            \l_semio_viz_color_bt_fp \l_semio_viz_color_r_fp \l_semio_viz_color_g_fp
            \l_semio_viz_color_b_fp
          \semio_viz_color_hex:nnnN { \l_semio_viz_color_r_fp } { \l_semio_viz_color_g_fp }
            { \l_semio_viz_color_b_fp } #5
        }
    }
    { \msg_error:nnn { semio-viz } { unknown-interpolator } {#1} }
}
\cs_generate_variant:Nn \semio_viz_color_interpolate:nnnnN { VnnnN , VVVnN , nVVnN }

% 🎚️ Channel-wise Lab mix at #1 written as hex into #2.
\cs_new_protected:Npn \semio_viz_color_mix_lab:nN #1#2 {
  \fp_set:Nn \l_semio_viz_color_lt_fp
    { \l_semio_viz_color_la_fp + (#1) * ( \l_semio_viz_color_lb_fp - \l_semio_viz_color_la_fp ) }
  \fp_set:Nn \l_semio_viz_color_at_fp
    { \l_semio_viz_color_aa_fp + (#1) * ( \l_semio_viz_color_ab_fp - \l_semio_viz_color_aa_fp ) }
  \fp_set:Nn \l_semio_viz_color_bt_fp
    { \l_semio_viz_color_bba_fp + (#1) * ( \l_semio_viz_color_bbb_fp - \l_semio_viz_color_bba_fp ) }
  \semio_viz_color_from_lab:NNNNNN \l_semio_viz_color_lt_fp \l_semio_viz_color_at_fp
    \l_semio_viz_color_bt_fp \l_semio_viz_color_r_fp \l_semio_viz_color_g_fp
    \l_semio_viz_color_b_fp
  \semio_viz_color_hex:nnnN { \l_semio_viz_color_r_fp } { \l_semio_viz_color_g_fp }
    { \l_semio_viz_color_b_fp } #2
}

% 🎡 HCL mix at #1 with shortest-path hue interpolation, written as hex into #2.
\cs_new_protected:Npn \semio_viz_color_mix_hcl:nN #1#2 {
  \fp_set:Nn \l_semio_viz_color_ha_fp
    {
      atand( \l_semio_viz_color_bba_fp , \l_semio_viz_color_aa_fp ) < 0
        ? atand( \l_semio_viz_color_bba_fp , \l_semio_viz_color_aa_fp ) + 360
        : atand( \l_semio_viz_color_bba_fp , \l_semio_viz_color_aa_fp )
    }
  \fp_set:Nn \l_semio_viz_color_hb_fp
    {
      atand( \l_semio_viz_color_bbb_fp , \l_semio_viz_color_ab_fp ) < 0
        ? atand( \l_semio_viz_color_bbb_fp , \l_semio_viz_color_ab_fp ) + 360
        : atand( \l_semio_viz_color_bbb_fp , \l_semio_viz_color_ab_fp )
    }
  \fp_set:Nn \l_semio_viz_color_ca_fp
    { sqrt( \l_semio_viz_color_aa_fp ** 2 + \l_semio_viz_color_bba_fp ** 2 ) }
  \fp_set:Nn \l_semio_viz_color_cb_fp
    { sqrt( \l_semio_viz_color_ab_fp ** 2 + \l_semio_viz_color_bbb_fp ** 2 ) }
  \fp_set:Nn \l_semio_viz_color_dh_fp { \l_semio_viz_color_hb_fp - \l_semio_viz_color_ha_fp }
  \bool_lazy_or:nnT
    { \fp_compare_p:nNn { \l_semio_viz_color_dh_fp } > { 180 } }
    { \fp_compare_p:nNn { \l_semio_viz_color_dh_fp } < { -180 } }
    {
      \fp_set:Nn \l_semio_viz_color_dh_fp
        { \l_semio_viz_color_dh_fp - 360 * floor( \l_semio_viz_color_dh_fp / 360 + 0.5 ) }
    }
  \fp_set:Nn \l_semio_viz_color_ht_fp
    { \l_semio_viz_color_ha_fp + (#1) * \l_semio_viz_color_dh_fp }
  \fp_set:Nn \l_semio_viz_color_ct_fp
    { \l_semio_viz_color_ca_fp + (#1) * ( \l_semio_viz_color_cb_fp - \l_semio_viz_color_ca_fp ) }
  \fp_set:Nn \l_semio_viz_color_lt_fp
    { \l_semio_viz_color_la_fp + (#1) * ( \l_semio_viz_color_lb_fp - \l_semio_viz_color_la_fp ) }
  \fp_set:Nn \l_semio_viz_color_at_fp
    { \l_semio_viz_color_ct_fp * cosd( \l_semio_viz_color_ht_fp ) }
  \fp_set:Nn \l_semio_viz_color_bt_fp
    { \l_semio_viz_color_ct_fp * sind( \l_semio_viz_color_ht_fp ) }
  \semio_viz_color_from_lab:NNNNNN \l_semio_viz_color_lt_fp \l_semio_viz_color_at_fp
    \l_semio_viz_color_bt_fp \l_semio_viz_color_r_fp \l_semio_viz_color_g_fp
    \l_semio_viz_color_b_fp
  \semio_viz_color_hex:nnnN { \l_semio_viz_color_r_fp } { \l_semio_viz_color_g_fp }
    { \l_semio_viz_color_b_fp } #2
}
\fp_new:N \l_semio_viz_color_ha_fp
\fp_new:N \l_semio_viz_color_hb_fp
\fp_new:N \l_semio_viz_color_ca_fp
\fp_new:N \l_semio_viz_color_cb_fp
\fp_new:N \l_semio_viz_color_dh_fp
\fp_new:N \l_semio_viz_color_ht_fp
\fp_new:N \l_semio_viz_color_ct_fp

% 🌈 Samples the multi-stop ramp #2 (a comma list of hex colours) at #3 in colour space #1.
\cs_new_protected:Npn \semio_viz_color_ramp:nnnN #1#2#3#4 {
  \seq_set_from_clist:Nn \l_semio_viz_color_stops_seq {#2}
  \int_set:Nn \l_semio_viz_color_stops_int { \seq_count:N \l_semio_viz_color_stops_seq }
  \int_compare:nNnTF { \l_semio_viz_color_stops_int } < { 2 }
    { \str_set:Nx #4 { \seq_item:Nn \l_semio_viz_color_stops_seq { 1 } } }
    {
      \fp_set:Nn \l_semio_viz_color_t_fp
        { min( max( #3 , 0 ) , 1 ) * ( \l_semio_viz_color_stops_int - 1 ) }
      \int_set:Nn \l_semio_viz_color_seg_int
        {
          \int_min:nn { \fp_to_int:n { floor( \l_semio_viz_color_t_fp ) } }
            { \l_semio_viz_color_stops_int - 2 }
        }
      \tl_set:Nx \l_semio_viz_color_stop_a_tl
        { \seq_item:Nn \l_semio_viz_color_stops_seq { \l_semio_viz_color_seg_int + 1 } }
      \tl_set:Nx \l_semio_viz_color_stop_b_tl
        { \seq_item:Nn \l_semio_viz_color_stops_seq { \l_semio_viz_color_seg_int + 2 } }
      \semio_viz_color_interpolate:nVVnN {#1}
        \l_semio_viz_color_stop_a_tl \l_semio_viz_color_stop_b_tl
        { \l_semio_viz_color_t_fp - \l_semio_viz_color_seg_int } #4
    }
}
\seq_new:N \l_semio_viz_color_stops_seq
\int_new:N \l_semio_viz_color_stops_int
\int_new:N \l_semio_viz_color_seg_int
\fp_new:N \l_semio_viz_color_t_fp
\tl_new:N \l_semio_viz_color_stop_a_tl
\tl_new:N \l_semio_viz_color_stop_b_tl
\cs_generate_variant:Nn \semio_viz_color_ramp:nnnN { VVnN , VnnN , nVnN }
%endregion 🔖️Color

%region 🔖️BandGeometry
% ↕️ Band-scale edges: d3's band scale exposes bandwidth() and each band's own start and end,
% not just its centre. Every span bar, matrix cell and grid box needs an edge, not a point.
\fp_new:N \l_semio_viz_band_lo_fp
\fp_new:N \l_semio_viz_band_hi_fp

% 📏 Width of one band of a band, point or ordinal scale.
\cs_new_protected:Npn \semio_viz_scale_band_width:nN #1#2 {
  \semio_viz_scale_band_geometry:n {#1}
  \fp_set_eq:NN #2 \l_semio_viz_scale_bandwidth_fp
}

% 📐 Distance between two neighbouring band starts.
\cs_new_protected:Npn \semio_viz_scale_band_step:nN #1#2 {
  \semio_viz_scale_band_geometry:n {#1}
  \fp_set_eq:NN #2 \l_semio_viz_scale_step_fp
}

% 📦 Left and right edge of one named band.
\cs_new_protected:Npn \semio_viz_scale_band_edges:nnNN #1#2#3#4 {
  \semio_viz_scale_band_index:nnN {#1} {#2} \l_semio_viz_band_int
  \semio_viz_scale_band_geometry:n {#1}
  \semio_viz_scale_band_position:nnN {#1} { \l_semio_viz_band_int } #3
  \fp_set:Nn #4 { #3 + \l_semio_viz_scale_bandwidth_fp }
}

% ↔️ Left edge of the "from" band through the right edge of the "to" band.
\cs_new_protected:Npn \semio_viz_scale_band_span:nnnNN #1#2#3#4#5 {
  \semio_viz_scale_band_edges:nnNN {#1} {#2} #4 \l_semio_viz_band_hi_fp
  \semio_viz_scale_band_edges:nnNN {#1} {#3} \l_semio_viz_band_lo_fp #5
}

% A scale name and a category name almost always arrive from a key (a tl variable) rather than
% as a literal, so every edge finder needs a variant expanding its tl arguments first.
\cs_generate_variant:Nn \semio_viz_scale_band_edges:nnNN { VVNN }
\cs_generate_variant:Nn \semio_viz_scale_band_span:nnnNN { VVVNN }
\cs_generate_variant:Nn \semio_viz_scale_band_width:nN { V }
\cs_generate_variant:Nn \semio_viz_scale_band_step:nN { V }
%endregion 🔖️BandGeometry

%region 🔖️AnonymousBand
% 🎚️ The same d3 geometry as the named scales above, computed for a bare count instead of a
% registered scale: a family that lays out n slots inside a millimetre span -- box plots per
% category, histogram bins, matrix rows -- needs the step and the bandwidth without paying for
% a scale registration and its domain. https://github.com/d3/d3-scale/blob/main/src/band.js
\fp_new:N \g_semio_viz_band_step_fp
\fp_new:N \g_semio_viz_band_width_fp
\fp_new:N \g_semio_viz_band_start_fp

% 📐 Linear interpolation of #1 from the domain [#2,#3] into the range [#4,#5].
\cs_new_protected:Npn \semio_viz_scale_linear:nnnnnN #1#2#3#4#5#6 {
  \fp_compare:nNnTF { (#3) - (#2) } = { 0 }
    { \fp_set:Nn #6 {#4} }
    { \fp_set:Nn #6 { (#4) + ( (#1) - (#2) ) / ( (#3) - (#2) ) * ( (#5) - (#4) ) } }
}

% 🎚️ Band geometry: #1 count, #2 r0, #3 r1, #4 paddingInner, #5 paddingOuter, #6 align.
\cs_new_protected:Npn \semio_viz_scale_band:nnnnnn #1#2#3#4#5#6 {
  \fp_gset:Nn \g_semio_viz_band_step_fp
    { ( (#3) - (#2) ) / max ( 1 , (#1) - (#4) + (#5) * 2 ) }
  \fp_gset:Nn \g_semio_viz_band_start_fp
    { (#2) + ( (#3) - (#2) - \g_semio_viz_band_step_fp * ( (#1) - (#4) ) ) * (#6) }
  \fp_gset:Nn \g_semio_viz_band_width_fp { \g_semio_viz_band_step_fp * ( 1 - (#4) ) }
}

% 📍 Left edge of band #1 (one-based) after \semio_viz_scale_band:nnnnnn.
\cs_new_protected:Npn \semio_viz_scale_band_at:nN #1#2 {
  \fp_set:Nn #2 { \g_semio_viz_band_start_fp + \g_semio_viz_band_step_fp * ( (#1) - 1 ) }
}
%endregion 🔖️AnonymousBand

%region 🔖️Interpolate
% 🔀 The interpolator kinds `\SemioVizInterpolate` dispatches on. `number` and `round` are the two
% numeric ones d3-interpolate names; `rgb`, `lab`, `hcl` and `oklab` are the colour spaces the ramp
% kernel already converts through; `array` walks two equally long comma lists element by element.
\clist_const:Nn \c_semio_viz_interpolate_kinds_clist
  { number , round , rgb , lab , hcl , oklab , array }

\str_new:N \l_semio_viz_interpolate_hex_str
\tl_new:N \l_semio_viz_interpolate_result_tl
\seq_new:N \l_semio_viz_interpolate_a_seq
\seq_new:N \l_semio_viz_interpolate_b_seq
\seq_new:N \l_semio_viz_interpolate_out_seq

% 🔢 One number between #1 and #2 at #3, on the emission grid the caller asked for.
\cs_new:Npn \semio_viz_interpolate_number:nnn #1#2#3
  { \fp_eval:n { (#1) + (#3) * ( (#2) - (#1) ) } }

% 🔢 The same value rounded to the nearest integer, which is d3-interpolate's `interpolateRound`.
\cs_new:Npn \semio_viz_interpolate_round:nnn #1#2#3
  { \fp_eval:n { round ( (#1) + (#3) * ( (#2) - (#1) ) ) } }

% 🧮 Two equally long comma lists interpolated element by element, into the comma list #4.
\cs_new_protected:Npn \semio_viz_interpolate_array:nnnN #1#2#3#4 {
  \seq_set_from_clist:Nn \l_semio_viz_interpolate_a_seq {#1}
  \seq_set_from_clist:Nn \l_semio_viz_interpolate_b_seq {#2}
  \seq_clear:N \l_semio_viz_interpolate_out_seq
  \int_step_inline:nn { \seq_count:N \l_semio_viz_interpolate_a_seq }
    {
      \seq_put_right:Nx \l_semio_viz_interpolate_out_seq
        {
          \semio_viz_interpolate_number:nnn
            { \seq_item:Nn \l_semio_viz_interpolate_a_seq {##1} }
            { \seq_item:Nn \l_semio_viz_interpolate_b_seq {##1} } {#3}
        }
    }
  \tl_set:Nx #4 { \seq_use:Nn \l_semio_viz_interpolate_out_seq { , } }
}

% 🔀 Interpolates #2 and #3 at #4 under the kind #1, into the token list #5. A colour comes back as
% `#RRGGBB`, an array as a comma list, a number as an expl3 fixed-point decimal.
\cs_new_protected:Npn \semio_viz_interpolate:nnnnN #1#2#3#4#5 {
  \str_case:nnF {#1}
    {
      { number } { \tl_set:Nx #5 { \semio_viz_interpolate_number:nnn {#2} {#3} {#4} } }
      { round }  { \tl_set:Nx #5 { \semio_viz_interpolate_round:nnn {#2} {#3} {#4} } }
      { array }  { \semio_viz_interpolate_array:nnnN {#2} {#3} {#4} #5 }
    }
    {
      \clist_if_in:NnTF \c_semio_viz_interpolate_kinds_clist {#1}
        {
          \semio_viz_color_interpolate:nnnnN {#1} {#2} {#3} {#4} \l_semio_viz_interpolate_hex_str
          \tl_set:Nx #5 { \str_use:N \l_semio_viz_interpolate_hex_str }
        }
        { \msg_error:nnn { semio-viz } { unknown-interpolator } {#1} }
    }
}
%endregion 🔖️Interpolate

%region 🔖️PublicApi
% 📐 \SemioVizScale{name}{kind}{domain}{range}[options]: declares a named scale.
\NewDocumentCommand \SemioVizScale { m m m m O{} }
  { \semio_viz_scale_define:nnnnn {#1} {#2} {#3} {#4} {#5} }
% 🔀 \SemioVizInterpolate{kind}{a}{b}{t}: typesets the value between `a` and `b` at `t`. The kind is
% `number`, `round`, one of the colour spaces `rgb`, `lab`, `hcl`, `oklab`, or `array` for two
% equally long comma lists of numbers.
\NewDocumentCommand \SemioVizInterpolate { m m m m }
  {
    \semio_viz_interpolate:nnnnN {#1} {#2} {#3} {#4} \l_semio_viz_interpolate_result_tl
    \tl_use:N \l_semio_viz_interpolate_result_tl
  }
%endregion 🔖️PublicApi

\ExplSyntaxOff
