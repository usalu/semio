    \int_incr:N \l_tmpa_int
    \tl_if_eq:nnT {##1} {#2} { \int_set_eq:NN #3 \l_tmpa_int }
  }
  \int_compare:nNnT #3 = { 0 } { \int_set:Nn #3 { 1 } }
}

% 📊 Computes step, start and bandwidth of a band or point scale exactly as d3's rescale().
\cs_new_protected:Npn \semio_viz_scale_band_geometry:n #1 {
  \int_set:Nn \l_semio_viz_scale_count_int
    { \clist_count:c { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } }
  \fp_set:Nn \l_semio_viz_range_lo_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } { 1 } }
  \fp_set:Nn \l_semio_viz_range_hi_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } { -1 } }
  \bool_set:Nn \l_semio_viz_scale_reverse_bool
    { \fp_compare_p:nNn { \l_semio_viz_range_hi_fp } < { \l_semio_viz_range_lo_fp } }
  \fp_set:Nn \l_semio_viz_scale_a_fp
    {
      min( \l_semio_viz_range_lo_fp , \l_semio_viz_range_hi_fp )
    }
  \fp_set:Nn \l_semio_viz_scale_b_fp
    {
      max( \l_semio_viz_range_lo_fp , \l_semio_viz_range_hi_fp )
    }
  \semio_viz_scale_band_padding:n {#1}
  \fp_set:Nn \l_semio_viz_scale_step_fp
    {
      ( \l_semio_viz_scale_b_fp - \l_semio_viz_scale_a_fp )
        / max( 1 , \l_semio_viz_scale_count_int - \l_semio_viz_scale_pad_in_fp
          + \l_semio_viz_scale_pad_out_fp * 2 )
    }
  \semio_viz_scale_flag:nnT {#1} { round }
    { \fp_set:Nn \l_semio_viz_scale_step_fp { floor( \l_semio_viz_scale_step_fp ) } }
  \fp_set:Nn \l_semio_viz_scale_start_fp
    {
      \l_semio_viz_scale_a_fp
        + ( \l_semio_viz_scale_b_fp - \l_semio_viz_scale_a_fp
            - \l_semio_viz_scale_step_fp
              * ( \l_semio_viz_scale_count_int - \l_semio_viz_scale_pad_in_fp ) )
          * ( \semio_viz_scale_num:nn {#1} { align } )
    }
  \fp_set:Nn \l_semio_viz_scale_bandwidth_fp
    { \l_semio_viz_scale_step_fp * ( 1 - \l_semio_viz_scale_pad_in_fp ) }
  \semio_viz_scale_flag:nnT {#1} { round }
    {
      \fp_set:Nn \l_semio_viz_scale_start_fp { floor( \l_semio_viz_scale_start_fp + 0.5 ) }
      \fp_set:Nn \l_semio_viz_scale_bandwidth_fp { floor( \l_semio_viz_scale_bandwidth_fp + 0.5 ) }
    }
}
\fp_new:N \l_semio_viz_scale_pad_in_fp
\fp_new:N \l_semio_viz_scale_pad_out_fp

% 🧮 Resolves the inner and outer padding: `point` fixes the inner padding at one, `padding` sets both.
\cs_new_protected:Npn \semio_viz_scale_band_padding:n #1 {
  \tl_set:Nx \l_semio_viz_scale_kind_tl
    { \tl_use:c { g_semio_viz_scale_ \tl_to_str:n {#1} _kind_tl } }
