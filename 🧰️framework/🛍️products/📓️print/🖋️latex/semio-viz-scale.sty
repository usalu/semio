%region 🔖️Keys
% ⚙️ Option vocabulary of every scale, mirroring the d3 accessors of the same names.
%   nice          integer|true   default false   extend the domain to round tick values
%   clamp         boolean        default false   clamp inputs to the domain extent
%   padding       number         default 0       point/band outer padding (band: both paddings)
%   paddingInner  number         default 0       band inner padding, fraction of the step
%   paddingOuter  number         default 0       band outer padding, fraction of the step
%   align         number         default 0.5     band/point alignment of the leftover space
%   base          number         default 10      log base, used by the tick generator
%   exponent      number         default 1       pow exponent (sqrt fixes it to 0.5)
%   constant      number         default 1       symlog linear-region constant
%   ticks         integer        default 10      default tick count
%   tickValues    clist          default empty   explicit tick values, overriding the generator
%   tickFormat    spec           default empty   d3-format specifier for tick labels
%   interpolator  name           default oklab   colour space of sequential/diverging ramps
%   scheme        name           default empty   named colour scheme resolved by semio-viz-theme
%   reverse       boolean        default false   reverse the range
%   round         boolean        default false   round band positions to whole millimetres
%   interval      name           default auto    temporal tick interval: auto|day|week|month|year
\prop_new:N \g_semio_viz_scale_defaults_prop
\clist_const:Nn \c_semio_viz_scale_keys_clist
  {
    nice, clamp, padding, paddingInner, paddingOuter, align, base, exponent, constant,
    ticks, tickValues, tickFormat, interpolator, scheme, reverse, round, interval
  }

\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { nice } { 0 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { clamp } { false }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { padding } { 0 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { paddingInner } { 0 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { paddingOuter } { 0 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { align } { 0.5 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { base } { 10 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { exponent } { 1 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { constant } { 1 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { ticks } { 10 }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { tickValues } { }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { tickFormat } { }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { interpolator } { oklab }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { scheme } { }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { reverse } { false }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { round } { false }
\prop_gput:Nnn \g_semio_viz_scale_defaults_prop { interval } { auto }

\prop_new:N \l_semio_viz_scale_opts_prop

% ⚙️ The option vocabulary of \SemioVizScale. Every key only records its value in the pending
% option property list, so a scale keeps exactly what its call site named and reads everything else
% from \g_semio_viz_scale_defaults_prop above, which is where each default is documented.
\keys_define:nn { semio / viz / scale }
  {
    nice .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { nice } {#1} },
    nice .default:n = { 10 },
    clamp .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { clamp } {#1} },
    clamp .default:n = { true },
    padding .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { padding } {#1} },
    paddingInner .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { paddingInner } {#1} },
    paddingOuter .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { paddingOuter } {#1} },
    align .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { align } {#1} },
    base .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { base } {#1} },
    exponent .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { exponent } {#1} },
    constant .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { constant } {#1} },
    ticks .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { ticks } {#1} },
    tickValues .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { tickValues } {#1} },
    tickFormat .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { tickFormat } {#1} },
    interpolator .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { interpolator } {#1} },
    scheme .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { scheme } {#1} },
    reverse .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { reverse } {#1} },
    reverse .default:n = { true },
    round .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { round } {#1} },
    round .default:n = { true },
    interval .code:n = { \prop_put:Nnn \l_semio_viz_scale_opts_prop { interval } {#1} },
  }

% 🔍 Reads option #2 of scale #1 into the tl variable #3, falling back to the documented default.
\cs_new_protected:Npn \semio_viz_scale_opt:nnN #1#2#3 {
  \prop_get:cnNF { g_semio_viz_scale_ \tl_to_str:n {#1} _opts_prop } {#2} #3
    { \prop_get:NnN \g_semio_viz_scale_defaults_prop {#2} #3 }
}

% ❓ True when option #2 of scale #1 is the string `true`.
\prg_new_protected_conditional:Npnn \semio_viz_scale_flag:nn #1#2 { T, F, TF } {
  \semio_viz_scale_opt:nnN {#1} {#2} \l_semio_viz_scale_opt_tl
  \str_if_eq:VnTF \l_semio_viz_scale_opt_tl { true } { \prg_return_true: } { \prg_return_false: }
}

% 🔢 Numeric value of option #2 of scale #1, expandable for use inside fp expressions.
\cs_new:Npn \semio_viz_scale_num:nn #1#2 {
  \str_if_eq:eeTF { \prop_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _opts_prop } {#2} } { }
    { \prop_item:Nn \g_semio_viz_scale_defaults_prop {#2} }
    { \prop_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _opts_prop } {#2} }
}

% 🏷️ Kind of scale #1, expandable.
\cs_new:Npn \semio_viz_scale_kind:n #1
  { \tl_use:c { g_semio_viz_scale_ \tl_to_str:n {#1} _kind_tl } }
%endregion 🔖️Keys

%region 🔖️Definition
% 📐 Registers a named scale: kind, domain, range and its option list.
\cs_new_protected:Npn \semio_viz_scale_define:nnnnn #1#2#3#4#5 {
  \seq_if_in:NnF \g_semio_viz_scale_kinds_seq {#2}
    { \msg_error:nnn { semio-viz } { unknown-scale-kind } {#2} }
  \seq_if_in:NnF \g_semio_viz_scale_names_seq {#1}
    { \seq_gput_right:Nn \g_semio_viz_scale_names_seq {#1} }
  \tl_if_exist:cF { g_semio_viz_scale_ \tl_to_str:n {#1} _kind_tl }
    { \tl_new:c { g_semio_viz_scale_ \tl_to_str:n {#1} _kind_tl } }
  \tl_gset:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _kind_tl } {#2}
  \clist_if_exist:cF { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist }
    { \clist_new:c { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } }
  \clist_gset:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } {#3}
  \clist_if_exist:cF { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist }
    { \clist_new:c { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } }
  \clist_gset:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } {#4}
  \prop_if_exist:cF { g_semio_viz_scale_ \tl_to_str:n {#1} _opts_prop }
    { \prop_new:c { g_semio_viz_scale_ \tl_to_str:n {#1} _opts_prop } }
  \prop_clear:N \l_semio_viz_scale_opts_prop
  \keys_set:nn { semio / viz / scale } {#5}
  \prop_gset_eq:cN { g_semio_viz_scale_ \tl_to_str:n {#1} _opts_prop } \l_semio_viz_scale_opts_prop
  \prop_gput:Nnn \g_semio_viz_scale_kind_prop {#1} {#2}
  \clist_set:Nn \l_semio_viz_scale_pack_clist {#3}
  \tl_set:Nx \l_tmpa_tl { \clist_use:Nn \l_semio_viz_scale_pack_clist , }
  \prop_gput:NnV \g_semio_viz_scale_domain_prop {#1} \l_tmpa_tl
  \clist_set:Nn \l_semio_viz_scale_pack_clist {#4}
  \tl_set:Nx \l_tmpa_tl { \clist_use:Nn \l_semio_viz_scale_pack_clist , }
  \prop_gput:NnV \g_semio_viz_scale_range_prop {#1} \l_tmpa_tl
  \semio_viz_scale_flag:nnT {#1} { reverse } { \semio_viz_scale_range_reverse:n {#1} }
  \semio_viz_scale_opt:nnN {#1} { nice } \l_semio_viz_scale_opt_tl
  \str_if_eq:VnT \l_semio_viz_scale_opt_tl { true }
    { \tl_set:Nn \l_semio_viz_scale_opt_tl { 10 } }
  \int_compare:nNnT { 0 \l_semio_viz_scale_opt_tl } > { 0 }
    { \semio_viz_scale_nice:nn {#1} { \l_semio_viz_scale_opt_tl } }
}

% ↩️ Reverses the stored range list in place.
\cs_new_protected:Npn \semio_viz_scale_range_reverse:n #1 {
  \seq_set_from_clist:Nc \l_semio_viz_scale_rev_seq
    { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist }
  \seq_reverse:N \l_semio_viz_scale_rev_seq
  \clist_gset:cx { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist }
    { \seq_use:Nn \l_semio_viz_scale_rev_seq { , } }
}
\seq_new:N \l_semio_viz_scale_rev_seq

% 📐 Backwards-compatible four-argument definition used by the families still on the legacy layout.
\cs_new_protected:Npn \semio_viz_scale_define:nnnn #1#2#3#4
  { \semio_viz_scale_define:nnnnn {#1} {#2} {#3} {#4} { } }
\cs_generate_variant:Nn \semio_viz_scale_define:nnnn { nnxx , nnVV }
\cs_generate_variant:Nn \semio_viz_scale_define:nnnnn { nnxxn , nnVVn , nnxxV }

% 🛡️ Raises `unknown-scale` unless #1 names a scale that was defined; every reader calls it first.
\cs_new_protected:Npn \semio_viz_scale_require:n #1 {
  \seq_if_in:NnF \g_semio_viz_scale_names_seq {#1}
    { \msg_error:nnn { semio-viz } { unknown-scale } {#1} }
}

% ❓ True when a scale name is registered.
\prg_new_protected_conditional:Npnn \semio_viz_scale_if_exist:n #1 { T, F, TF } {
  \seq_if_in:NnTF \g_semio_viz_scale_names_seq {#1} { \prg_return_true: } { \prg_return_false: }
}

% 🎚️ Loads the first and last domain/range entries into the shared lo/hi registers;
% a temporal domain is converted to epoch milliseconds on the way in.
\cs_new_protected:Npn \semio_viz_scale_numeric_prep:n #1 {
  \semio_viz_scale_require:n {#1}
  \str_if_eq:eeTF { \semio_viz_scale_kind:n {#1} } { temporal }
    {
      \semio_viz_scale_epoch_set:xN
        { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 1 } }
        \l_semio_viz_domain_lo_fp
      \semio_viz_scale_epoch_set:xN
        { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { -1 } }
        \l_semio_viz_domain_hi_fp
    }
    {
      \fp_set:Nn \l_semio_viz_domain_lo_fp
        { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 1 } }
      \fp_set:Nn \l_semio_viz_domain_hi_fp
        { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { -1 } }
    }
  \fp_set:Nn \l_semio_viz_range_lo_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } { 1 } }
  \fp_set:Nn \l_semio_viz_range_hi_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } { -1 } }
  \fp_compare:nNnT { \l_semio_viz_domain_hi_fp } = { \l_semio_viz_domain_lo_fp }
    { \fp_add:Nn \l_semio_viz_domain_hi_fp { 1 } }
}
%endregion 🔖️Definition

%region 🔖️Temporal
\fp_new:N \l_semio_viz_scale_epoch_fp

% ⏱️ Epoch milliseconds of an ISO timestamp, matching `new Date(iso)` in UTC.
\cs_new_protected:Npn \semio_viz_scale_epoch_set:nN #1#2 {
  \semio_viz_time_parse:n {#1}
  \fp_set:Nn #2
    {
      ( \l_semio_viz_time_epoch_int * 86400 + \l_semio_viz_time_hour_int * 3600
        + \l_semio_viz_time_minute_int * 60 + \l_semio_viz_time_second_int ) * 1000
    }
}

\cs_generate_variant:Nn \semio_viz_scale_epoch_set:nN { xN , VN }

% 📅 ISO date `YYYY-MM-DD` of an epoch-millisecond value (UTC).
\cs_new_protected:Npn \semio_viz_scale_epoch_iso:nN #1#2 {
  \int_set:Nn \l_semio_viz_scale_days_int
    { \fp_to_int:n { floor( (#1) / 86400000 ) } }
  \semio_viz_scale_civil:nN { \l_semio_viz_scale_days_int } #2
}
\int_new:N \l_semio_viz_scale_days_int
\int_new:N \l_semio_viz_scale_civil_y_int
\int_new:N \l_semio_viz_scale_civil_m_int
\int_new:N \l_semio_viz_scale_civil_d_int
\int_new:N \l_semio_viz_scale_civil_e_int
\int_new:N \l_semio_viz_scale_civil_doe_int
\int_new:N \l_semio_viz_scale_civil_yoe_int
\int_new:N \l_semio_viz_scale_civil_doy_int
\int_new:N \l_semio_viz_scale_civil_mp_int

% 🗓️ Civil date of a day number since the epoch (Howard Hinnant's `civil_from_days`).
\cs_new_protected:Npn \semio_viz_scale_civil:nN #1#2 {
  \int_set:Nn \l_semio_viz_scale_civil_e_int { #1 + 719468 }
  \int_set:Nn \l_semio_viz_scale_civil_doe_int
    { \l_semio_viz_scale_civil_e_int - 146097 * \semio_viz_scale_floor_div:nn { \l_semio_viz_scale_civil_e_int } { 146097 } }
  \int_set:Nn \l_semio_viz_scale_civil_yoe_int
    {
      \int_div_truncate:nn
        {
          \l_semio_viz_scale_civil_doe_int
            - \int_div_truncate:nn { \l_semio_viz_scale_civil_doe_int } { 1460 }
            + \int_div_truncate:nn { \l_semio_viz_scale_civil_doe_int } { 36524 }
            - \int_div_truncate:nn { \l_semio_viz_scale_civil_doe_int } { 146096 }
        }
        { 365 }
    }
  \int_set:Nn \l_semio_viz_scale_civil_doy_int
    {
      \l_semio_viz_scale_civil_doe_int
        - ( 365 * \l_semio_viz_scale_civil_yoe_int
            + \int_div_truncate:nn { \l_semio_viz_scale_civil_yoe_int } { 4 }
            - \int_div_truncate:nn { \l_semio_viz_scale_civil_yoe_int } { 100 } )
    }
  \int_set:Nn \l_semio_viz_scale_civil_mp_int
    { \int_div_truncate:nn { 5 * \l_semio_viz_scale_civil_doy_int + 2 } { 153 } }
  \int_set:Nn \l_semio_viz_scale_civil_d_int
    {
      \l_semio_viz_scale_civil_doy_int
        - \int_div_truncate:nn { 153 * \l_semio_viz_scale_civil_mp_int + 2 } { 5 } + 1
    }
  \int_set:Nn \l_semio_viz_scale_civil_m_int
    {
      \l_semio_viz_scale_civil_mp_int
        + \int_compare:nNnTF { \l_semio_viz_scale_civil_mp_int } < { 10 } { 3 } { -9 }
    }
  \int_set:Nn \l_semio_viz_scale_civil_y_int
    {
      \l_semio_viz_scale_civil_yoe_int
        + 400 * \semio_viz_scale_floor_div:nn { \l_semio_viz_scale_civil_e_int } { 146097 }
        + \int_compare:nTF { \l_semio_viz_scale_civil_m_int <= 2 } { 1 } { 0 }
    }
  \str_set:Nx #2
    {
      \semio_viz_time_pad:nn { 4 } { \l_semio_viz_scale_civil_y_int } -
      \semio_viz_time_pad:nn { 2 } { \l_semio_viz_scale_civil_m_int } -
      \semio_viz_time_pad:nn { 2 } { \l_semio_viz_scale_civil_d_int }
    }
}

% ⬇️ Floor division for possibly negative numerators.
\cs_new:Npn \semio_viz_scale_floor_div:nn #1#2
  {
    \int_div_truncate:nn
      { #1 - \int_compare:nNnTF {#1} < { 0 } { #2 - 1 } { 0 } } {#2}
  }
%endregion 🔖️Temporal

%region 🔖️Transforms
\fp_new:N \l_semio_viz_scale_tx_fp

% ➡️ Forward transform of the continuous kind of scale #1 applied to #2.
\cs_new_protected:Npn \semio_viz_scale_tx:nnN #1#2#3 {
  \tl_set:Nx \l_semio_viz_scale_kind_tl
    { \tl_use:c { g_semio_viz_scale_ \tl_to_str:n {#1} _kind_tl } }
  \str_case:VnF \l_semio_viz_scale_kind_tl
    {
      { log }
        {
          \fp_compare:nNnTF { \l_semio_viz_domain_lo_fp } < { 0 }
            { \fp_set:Nn #3 { -ln( -(#2) ) } }
            { \fp_set:Nn #3 { ln( #2 ) } }
        }
      { pow }
        {
          \fp_set:Nn #3
            {
              ( (#2) < 0 ? -1 : 1 ) * abs(#2) ** ( \semio_viz_scale_num:nn {#1} { exponent } )
            }
        }
      { sqrt } { \fp_set:Nn #3 { ( (#2) < 0 ? -1 : 1 ) * sqrt( abs(#2) ) } }
      { symlog }
        {
          \fp_set:Nn #3
            {
              ( (#2) < 0 ? -1 : 1 )
                * ln( 1 + abs( (#2) / ( \semio_viz_scale_num:nn {#1} { constant } ) ) )
            }
        }
    }
    { \fp_set:Nn #3 { #2 } }
}

% ⬅️ Inverse transform of the continuous kind of scale #1 applied to #2.
\cs_new_protected:Npn \semio_viz_scale_utx:nnN #1#2#3 {
  \tl_set:Nx \l_semio_viz_scale_kind_tl
    { \tl_use:c { g_semio_viz_scale_ \tl_to_str:n {#1} _kind_tl } }
  \str_case:VnF \l_semio_viz_scale_kind_tl
    {
      { log }
        {
          \fp_compare:nNnTF { \l_semio_viz_domain_lo_fp } < { 0 }
            { \fp_set:Nn #3 { -exp( -(#2) ) } }
            { \fp_set:Nn #3 { exp( #2 ) } }
        }
      { pow }
        {
          \fp_set:Nn #3
            {
              ( (#2) < 0 ? -1 : 1 )
                * abs(#2) ** ( 1 / ( \semio_viz_scale_num:nn {#1} { exponent } ) )
            }
        }
      { sqrt } { \fp_set:Nn #3 { ( (#2) < 0 ? -1 : 1 ) * (#2) * (#2) } }
      { symlog }
        {
          \fp_set:Nn #3
            {
              ( (#2) < 0 ? -1 : 1 ) * ( \semio_viz_scale_num:nn {#1} { constant } )
                * ( exp( abs(#2) ) - 1 )
            }
        }
    }
    { \fp_set:Nn #3 { #2 } }
}
%endregion 🔖️Transforms

%region 🔖️Continuous
\fp_new:N \l_semio_viz_scale_t_fp
\fp_new:N \l_semio_viz_scale_a_fp
\fp_new:N \l_semio_viz_scale_b_fp
\fp_new:N \l_semio_viz_scale_x_fp

% 📏 Normalized position of #2 inside the domain of the continuous scale #1.
\cs_new_protected:Npn \semio_viz_scale_norm:nnN #1#2#3 {
  \semio_viz_scale_numeric_prep:n {#1}
  \fp_set:Nn \l_semio_viz_scale_x_fp {#2}
  \semio_viz_scale_flag:nnT {#1} { clamp }
    {
      \fp_compare:nNnTF { \l_semio_viz_domain_lo_fp } < { \l_semio_viz_domain_hi_fp }
        {
          \fp_set:Nn \l_semio_viz_scale_x_fp
            {
              min( max( \l_semio_viz_scale_x_fp , \l_semio_viz_domain_lo_fp ) ,
                \l_semio_viz_domain_hi_fp )
            }
        }
        {
          \fp_set:Nn \l_semio_viz_scale_x_fp
            {
              min( max( \l_semio_viz_scale_x_fp , \l_semio_viz_domain_hi_fp ) ,
                \l_semio_viz_domain_lo_fp )
            }
        }
    }
  \semio_viz_scale_tx:nnN {#1} { \l_semio_viz_scale_x_fp } \l_semio_viz_scale_t_fp
  \semio_viz_scale_tx:nnN {#1} { \l_semio_viz_domain_lo_fp } \l_semio_viz_scale_a_fp
  \semio_viz_scale_tx:nnN {#1} { \l_semio_viz_domain_hi_fp } \l_semio_viz_scale_b_fp
  \fp_set:Nn #3
    {
      ( \l_semio_viz_scale_t_fp - \l_semio_viz_scale_a_fp )
        / ( \l_semio_viz_scale_b_fp - \l_semio_viz_scale_a_fp )
    }
}

% 📐 Maps #2 through the continuous scale #1 onto its range.
\cs_new_protected:Npn \semio_viz_scale_continuous_map:nnN #1#2#3 {
  \semio_viz_scale_norm:nnN {#1} {#2} \l_semio_viz_scale_t_fp
  \fp_set:Nn #3
    {
      \l_semio_viz_range_lo_fp
        + \l_semio_viz_scale_t_fp * ( \l_semio_viz_range_hi_fp - \l_semio_viz_range_lo_fp )
    }
  \semio_viz_scale_flag:nnT {#1} { round } { \fp_set:Nn #3 { round(#3) } }
}

% ↩️ Inverts a range position back into the domain of the continuous scale #1.
\cs_new_protected:Npn \semio_viz_scale_invert:nnN #1#2#3 {
  \semio_viz_scale_numeric_prep:n {#1}
  \semio_viz_scale_tx:nnN {#1} { \l_semio_viz_domain_lo_fp } \l_semio_viz_scale_a_fp
  \semio_viz_scale_tx:nnN {#1} { \l_semio_viz_domain_hi_fp } \l_semio_viz_scale_b_fp
  \fp_set:Nn \l_semio_viz_scale_t_fp
    {
      \l_semio_viz_scale_a_fp
        + ( (#2) - \l_semio_viz_range_lo_fp )
          / ( \l_semio_viz_range_hi_fp - \l_semio_viz_range_lo_fp )
          * ( \l_semio_viz_scale_b_fp - \l_semio_viz_scale_a_fp )
    }
  \semio_viz_scale_utx:nnN {#1} { \l_semio_viz_scale_t_fp } #3
  \semio_viz_scale_flag:nnT {#1} { clamp }
    {
      \fp_compare:nNnTF { \l_semio_viz_domain_lo_fp } < { \l_semio_viz_domain_hi_fp }
        {
          \fp_set:Nn #3
            { min( max( #3 , \l_semio_viz_domain_lo_fp ) , \l_semio_viz_domain_hi_fp ) }
        }
        {
          \fp_set:Nn #3
            { min( max( #3 , \l_semio_viz_domain_hi_fp ) , \l_semio_viz_domain_lo_fp ) }
        }
    }
}
\cs_generate_variant:Nn \semio_viz_scale_invert:nnN { VnN , VVN }

% 🧭 Legacy linear application against the prepared lo/hi registers.
\cs_new_protected:Npn \semio_viz_scale_linear_apply:nN #1#2 {
  \fp_set:Nn #2
    {
      \l_semio_viz_range_lo_fp + ( (#1) - \l_semio_viz_domain_lo_fp )
        / ( \l_semio_viz_domain_hi_fp - \l_semio_viz_domain_lo_fp )
        * ( \l_semio_viz_range_hi_fp - \l_semio_viz_range_lo_fp )
    }
}
