% 🔢 One-based index of the category #2 in the domain of scale #1; zero when absent.
\cs_new_protected:Npn \semio_viz_scale_band_index:nnN #1#2#3 {
  \int_zero:N #3
  \int_zero:N \l_tmpa_int
