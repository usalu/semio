% 🎨 Splits `#RRGGBB` (or `RRGGBB`) into three channels on 0..255.
\cs_new_protected:Npn \semio_viz_color_parse:nNNN #1#2#3#4 {
  \str_set:Nn \l_semio_viz_color_hex_str {#1}
  \int_compare:nNnF { \str_count:N \l_semio_viz_color_hex_str } > { 5 }
    { \msg_error:nnn { semio-viz } { bad-color } {#1} }
  \str_set:Nx \l_semio_viz_color_hex_str
    { \str_range:Nnn \l_semio_viz_color_hex_str { -6 } { -1 } }
  \fp_set:Nn #2
    { \int_from_hex:e { \str_range:Nnn \l_semio_viz_color_hex_str { 1 } { 2 } } }
  \fp_set:Nn #3
    { \int_from_hex:e { \str_range:Nnn \l_semio_viz_color_hex_str { 3 } { 4 } } }
  \fp_set:Nn #4
    { \int_from_hex:e { \str_range:Nnn \l_semio_viz_color_hex_str { 5 } { 6 } } }
}
\cs_generate_variant:Nn \semio_viz_color_parse:nNNN { VNNN , xNNN }
\cs_generate_variant:Nn \int_from_hex:n { e }

% 🎨 Renders three 0..255 channels as a lowercase `#rrggbb` string.
\cs_new_protected:Npn \semio_viz_color_hex:nnnN #1#2#3#4 {
  \str_set:Nx #4
    {
      \c_hash_str
      \semio_viz_color_byte:n {#1}
      \semio_viz_color_byte:n {#2}
      \semio_viz_color_byte:n {#3}
    }
}

% 🔡 One clamped, rounded channel as two lowercase hexadecimal digits.
\cs_new:Npn \semio_viz_color_byte:n #1 {
  \int_compare:nNnT { \fp_to_int:n { min( max( floor( (#1) + 0.5 ) , 0 ) , 255 ) } } < { 16 } { 0 }
  \int_to_hex:n { \fp_to_int:n { min( max( floor( (#1) + 0.5 ) , 0 ) , 255 ) } }
}

% 📉 sRGB channel (0..255) to linear light.
\cs_new:Npn \semio_viz_color_linear:n #1
  { ( (#1) / 255 <= 0.04045 ? (#1) / 255 / 12.92 : ( ( (#1) / 255 + 0.055 ) / 1.055 ) ** 2.4 ) }

% 📈 Linear light back to an sRGB channel on 0..255.
\cs_new:Npn \semio_viz_color_gamma:n #1
  { ( 255 * ( (#1) <= 0.0031308 ? 12.92 * (#1) : 1.055 * abs(#1) ** ( 1 / 2.4 ) - 0.055 ) ) }

% 🧪 sRGB to OKLab (Björn Ottosson's matrices).
\cs_new_protected:Npn \semio_viz_color_to_oklab:NNNNNN #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_color_l_fp
    {
      ( 0.4122214708 * \semio_viz_color_linear:n {#1}
        + 0.5363325363 * \semio_viz_color_linear:n {#2}
        + 0.0514459929 * \semio_viz_color_linear:n {#3} ) ** ( 1 / 3 )
    }
  \fp_set:Nn \l_semio_viz_color_m_fp
    {
      ( 0.2119034982 * \semio_viz_color_linear:n {#1}
        + 0.6806995451 * \semio_viz_color_linear:n {#2}
        + 0.1073969566 * \semio_viz_color_linear:n {#3} ) ** ( 1 / 3 )
    }
  \fp_set:Nn \l_semio_viz_color_s_fp
    {
      ( 0.0883024619 * \semio_viz_color_linear:n {#1}
        + 0.2817188376 * \semio_viz_color_linear:n {#2}
        + 0.6299787005 * \semio_viz_color_linear:n {#3} ) ** ( 1 / 3 )
    }
  \fp_set:Nn #4
    {
      0.2104542553 * \l_semio_viz_color_l_fp + 0.7936177850 * \l_semio_viz_color_m_fp
        - 0.0040720468 * \l_semio_viz_color_s_fp
    }
  \fp_set:Nn #5
    {
      1.9779984951 * \l_semio_viz_color_l_fp - 2.4285922050 * \l_semio_viz_color_m_fp
        + 0.4505937099 * \l_semio_viz_color_s_fp
    }
  \fp_set:Nn #6
    {
      0.0259040371 * \l_semio_viz_color_l_fp + 0.7827717662 * \l_semio_viz_color_m_fp
        - 0.8086757660 * \l_semio_viz_color_s_fp
    }
}

% 🧪 OKLab back to sRGB channels on 0..255.
\cs_new_protected:Npn \semio_viz_color_from_oklab:NNNNNN #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_color_l_fp
    { ( #1 + 0.3963377774 * #2 + 0.2158037573 * #3 ) ** 3 }
  \fp_set:Nn \l_semio_viz_color_m_fp
    { ( #1 - 0.1055613458 * #2 - 0.0638541728 * #3 ) ** 3 }
  \fp_set:Nn \l_semio_viz_color_s_fp
    { ( #1 - 0.0894841775 * #2 - 1.2914855480 * #3 ) ** 3 }
  \fp_set:Nn #4
    {
      \semio_viz_color_gamma:n
        {
          4.0767416621 * \l_semio_viz_color_l_fp - 3.3077115913 * \l_semio_viz_color_m_fp
            + 0.2309699292 * \l_semio_viz_color_s_fp
        }
    }
  \fp_set:Nn #5
    {
      \semio_viz_color_gamma:n
        {
          -1.2684380046 * \l_semio_viz_color_l_fp + 2.6097574011 * \l_semio_viz_color_m_fp
            - 0.3413193965 * \l_semio_viz_color_s_fp
        }
    }
  \fp_set:Nn #6
    {
      \semio_viz_color_gamma:n
        {
          -0.0041960863 * \l_semio_viz_color_l_fp - 0.7034186147 * \l_semio_viz_color_m_fp
            + 1.7076147010 * \l_semio_viz_color_s_fp
        }
    }
}

\fp_const:Nn \c_semio_viz_color_xn_fp { 0.96422 }
\fp_const:Nn \c_semio_viz_color_zn_fp { 0.82521 }
\fp_const:Nn \c_semio_viz_color_tone_fp { 6 / 29 }
\fp_const:Nn \c_semio_viz_color_ttwo_fp { 3 * ( 6 / 29 ) ** 2 }
\fp_const:Nn \c_semio_viz_color_tthree_fp { ( 6 / 29 ) ** 3 }
\fp_const:Nn \c_semio_viz_color_tzero_fp { 4 / 29 }

% 📐 The CIE Lab companding function used by d3-color.
\cs_new:Npn \semio_viz_color_xyz2lab:n #1
  {
    ( (#1) > \c_semio_viz_color_tthree_fp ? (#1) ** ( 1 / 3 )
      : (#1) / \c_semio_viz_color_ttwo_fp + \c_semio_viz_color_tzero_fp )
  }

% 📐 The inverse CIE Lab companding function used by d3-color.
\cs_new:Npn \semio_viz_color_lab2xyz:n #1
  {
    ( (#1) > \c_semio_viz_color_tone_fp ? (#1) ** 3
      : \c_semio_viz_color_ttwo_fp * ( (#1) - \c_semio_viz_color_tzero_fp ) )
  }

% 🧪 sRGB to CIE Lab on the D50 white point, matching d3-color.
\cs_new_protected:Npn \semio_viz_color_to_lab:NNNNNN #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_color_m_fp
    {
      \semio_viz_color_xyz2lab:n
        {
          0.2225045 * \semio_viz_color_linear:n {#1}
            + 0.7168786 * \semio_viz_color_linear:n {#2}
            + 0.0606169 * \semio_viz_color_linear:n {#3}
        }
    }
  \fp_set:Nn \l_semio_viz_color_l_fp
    {
      \semio_viz_color_xyz2lab:n
        {
          ( 0.4360747 * \semio_viz_color_linear:n {#1}
            + 0.3850649 * \semio_viz_color_linear:n {#2}
            + 0.1430804 * \semio_viz_color_linear:n {#3} ) / \c_semio_viz_color_xn_fp
        }
    }
  \fp_set:Nn \l_semio_viz_color_s_fp
    {
      \semio_viz_color_xyz2lab:n
        {
          ( 0.0139322 * \semio_viz_color_linear:n {#1}
            + 0.0971045 * \semio_viz_color_linear:n {#2}
            + 0.7141733 * \semio_viz_color_linear:n {#3} ) / \c_semio_viz_color_zn_fp
        }
    }
  \fp_set:Nn #4 { 116 * \l_semio_viz_color_m_fp - 16 }
  \fp_set:Nn #5 { 500 * ( \l_semio_viz_color_l_fp - \l_semio_viz_color_m_fp ) }
  \fp_set:Nn #6 { 200 * ( \l_semio_viz_color_m_fp - \l_semio_viz_color_s_fp ) }
}

% 🧪 CIE Lab back to sRGB channels on 0..255.
\cs_new_protected:Npn \semio_viz_color_from_lab:NNNNNN #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_color_m_fp { ( #1 + 16 ) / 116 }
  \fp_set:Nn \l_semio_viz_color_l_fp { \l_semio_viz_color_m_fp + #2 / 500 }
  \fp_set:Nn \l_semio_viz_color_s_fp { \l_semio_viz_color_m_fp - #3 / 200 }
  \fp_set:Nn \l_semio_viz_color_l_fp
    { \c_semio_viz_color_xn_fp * \semio_viz_color_lab2xyz:n { \l_semio_viz_color_l_fp } }
  \fp_set:Nn \l_semio_viz_color_m_fp
    { \semio_viz_color_lab2xyz:n { \l_semio_viz_color_m_fp } }
  \fp_set:Nn \l_semio_viz_color_s_fp
    { \c_semio_viz_color_zn_fp * \semio_viz_color_lab2xyz:n { \l_semio_viz_color_s_fp } }
  \fp_set:Nn #4
    {
      \semio_viz_color_gamma:n
        {
          3.1338561 * \l_semio_viz_color_l_fp - 1.6168667 * \l_semio_viz_color_m_fp
            - 0.4906146 * \l_semio_viz_color_s_fp
        }
    }
  \fp_set:Nn #5
    {
      \semio_viz_color_gamma:n
        {
          -0.9787684 * \l_semio_viz_color_l_fp + 1.9161415 * \l_semio_viz_color_m_fp
            + 0.0334540 * \l_semio_viz_color_s_fp
        }
    }
  \fp_set:Nn #6
    {
      \semio_viz_color_gamma:n
        {
          0.0719453 * \l_semio_viz_color_l_fp - 0.2289914 * \l_semio_viz_color_m_fp
            + 1.4052427 * \l_semio_viz_color_s_fp
        }
    }
}

