% 📏 Tick values of scale #1 at #2 requested steps, into the sequence #3.
\cs_new_protected:Npn \semio_viz_scale_ticks_count:nnN #1#2#3 {
  \semio_viz_scale_require:n {#1}
  \semio_viz_scale_opt:nnN {#1} { tickValues } \l_semio_viz_scale_opt_tl
  \tl_if_empty:NTF \l_semio_viz_scale_opt_tl
    {
      \tl_set:Nx \l_semio_viz_scale_kind_tl
        { \tl_use:c { g_semio_viz_scale_ \tl_to_str:n {#1} _kind_tl } }
      \str_case:VnF \l_semio_viz_scale_kind_tl
        {
          { band } { \seq_set_from_clist:Nc #3 { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } }
          { point } { \seq_set_from_clist:Nc #3 { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } }
          { ordinal } { \seq_set_from_clist:Nc #3 { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } }
          { threshold } { \semio_viz_scale_thresholds:n {#1} \seq_set_eq:NN #3 \l_semio_viz_scale_thresholds_seq }
          { quantile } { \semio_viz_scale_thresholds:n {#1} \seq_set_eq:NN #3 \l_semio_viz_scale_thresholds_seq }
          { quantize } { \semio_viz_scale_thresholds:n {#1} \seq_set_eq:NN #3 \l_semio_viz_scale_thresholds_seq }
          { log } { \semio_viz_scale_log_ticks:nnN {#1} {#2} #3 }
          { temporal }
            {
              \semio_viz_scale_opt:nnN {#1} { interval } \l_semio_viz_scale_opt_tl
              \semio_viz_scale_temporal_ticks:VnN \l_semio_viz_scale_opt_tl {#1} #3
            }
        }
        {
          \semio_viz_scale_numeric_prep:n {#1}
          \semio_viz_scale_tick_values:nnnN { \l_semio_viz_domain_lo_fp }
            { \l_semio_viz_domain_hi_fp } {#2} #3
        }
    }
    { \seq_set_from_clist:NV #3 \l_semio_viz_scale_opt_tl }
}

