  \int_zero:N #3
  \seq_map_inline:Nn #2
    { \fp_compare:nT { #1 >= ##1 } { \int_incr:N #3 } }
}

% 🧊 Threshold list of a quantize scale: d3's ((i+1)*x1 - (i-n)*x0) / (n+1).
\cs_new_protected:Npn \semio_viz_scale_quantize_thresholds:n #1 {
  \fp_set:Nn \l_semio_viz_domain_lo_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 1 } }
  \fp_set:Nn \l_semio_viz_domain_hi_fp
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { -1 } }
  \int_set:Nn \l_semio_viz_scale_count_int
    { \clist_count:c { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } - 1 }
  \seq_clear:N \l_semio_viz_scale_thresholds_seq
  \int_step_inline:nn { \l_semio_viz_scale_count_int }
    {
      \seq_put_right:Nx \l_semio_viz_scale_thresholds_seq
        {
          \fp_to_decimal:n
            {
              ( ##1 * \l_semio_viz_domain_hi_fp
                - ( ##1 - 1 - \l_semio_viz_scale_count_int ) * \l_semio_viz_domain_lo_fp )
                / ( \l_semio_viz_scale_count_int + 1 )
            }
        }
    }
}

% 🧊 Threshold list of a quantile scale: the R-7 quantiles of the sorted domain sample.
\cs_new_protected:Npn \semio_viz_scale_quantile_thresholds:n #1 {
  \seq_set_from_clist:Nc \l_semio_viz_scale_sorted_seq
    { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist }
  \seq_sort:Nn \l_semio_viz_scale_sorted_seq
    { \fp_compare:nNnTF {##1} > {##2} { \sort_return_swapped: } { \sort_return_same: } }
  \int_set:Nn \l_semio_viz_scale_count_int
    { \clist_count:c { g_semio_viz_scale_ \tl_to_str:n {#1} _range_clist } }
  \seq_clear:N \l_semio_viz_scale_thresholds_seq
  \int_step_inline:nn { \l_semio_viz_scale_count_int - 1 }
    {
      \semio_viz_scale_quantile_sorted:NnN \l_semio_viz_scale_sorted_seq
        { ##1 / ( \l_semio_viz_scale_count_int ) } \l_semio_viz_scale_a_fp
      \seq_put_right:Nx \l_semio_viz_scale_thresholds_seq
        { \fp_to_decimal:n { \l_semio_viz_scale_a_fp } }
    }
}

% 📈 R-7 quantile of the pre-sorted numeric sequence #1 at probability #2.
\cs_new_protected:Npn \semio_viz_scale_quantile_sorted:NnN #1#2#3 {
  \int_set:Nn \l_tmpa_int { \seq_count:N #1 }
  \fp_set:Nn \l_semio_viz_scale_t_fp { ( \l_tmpa_int - 1 ) * (#2) }
