  \int_compare:nNnTF { \l_semio_viz_scale_power_int } < { 0 }
    {
      \bool_set_true:N \l_semio_viz_scale_negpow_bool
      \fp_set:Nn \l_semio_viz_scale_inc_fp
        { 10 ** ( -\l_semio_viz_scale_power_int ) / \l_semio_viz_scale_factor_fp }
      \int_set:Nn \l_semio_viz_scale_ione_int
        { \fp_to_int:n { floor( \l_semio_viz_scale_lo_fp * \l_semio_viz_scale_inc_fp + 0.5 ) } }
      \int_set:Nn \l_semio_viz_scale_itwo_int
        { \fp_to_int:n { floor( \l_semio_viz_scale_hi_fp * \l_semio_viz_scale_inc_fp + 0.5 ) } }
      \fp_compare:nNnT { \l_semio_viz_scale_ione_int / \l_semio_viz_scale_inc_fp }
        < { \l_semio_viz_scale_lo_fp }
        { \int_incr:N \l_semio_viz_scale_ione_int }
      \fp_compare:nNnT { \l_semio_viz_scale_itwo_int / \l_semio_viz_scale_inc_fp }
        > { \l_semio_viz_scale_hi_fp }
        { \int_decr:N \l_semio_viz_scale_itwo_int }
    }
    {
      \bool_set_false:N \l_semio_viz_scale_negpow_bool
      \fp_set:Nn \l_semio_viz_scale_inc_fp
        { 10 ** \l_semio_viz_scale_power_int * \l_semio_viz_scale_factor_fp }
      \int_set:Nn \l_semio_viz_scale_ione_int
        { \fp_to_int:n { floor( \l_semio_viz_scale_lo_fp / \l_semio_viz_scale_inc_fp + 0.5 ) } }
      \int_set:Nn \l_semio_viz_scale_itwo_int
        { \fp_to_int:n { floor( \l_semio_viz_scale_hi_fp / \l_semio_viz_scale_inc_fp + 0.5 ) } }
      \fp_compare:nNnT { \l_semio_viz_scale_ione_int * \l_semio_viz_scale_inc_fp }
        < { \l_semio_viz_scale_lo_fp }
        { \int_incr:N \l_semio_viz_scale_ione_int }
      \fp_compare:nNnT { \l_semio_viz_scale_itwo_int * \l_semio_viz_scale_inc_fp }
        > { \l_semio_viz_scale_hi_fp }
        { \int_decr:N \l_semio_viz_scale_itwo_int }
    }
}
\fp_new:N \l_semio_viz_scale_lo_fp
\fp_new:N \l_semio_viz_scale_hi_fp
\fp_new:N \l_semio_viz_scale_err_fp

% 🔟 Shared head of tickSpec and tickIncrement: the decimal power and the 1-2-5-10 factor.
\cs_new_protected:Npn \semio_viz_scale_tick_factor:nnn #1#2#3 {
  \fp_set:Nn \l_semio_viz_scale_step_fp { ( (#2) - (#1) ) / max( 0 , #3 ) }
  \int_set:Nn \l_semio_viz_scale_power_int
    { \fp_to_int:n { floor( ln( \l_semio_viz_scale_step_fp ) / ln(10) ) } }
  \fp_set:Nn \l_semio_viz_scale_err_fp
    { \l_semio_viz_scale_step_fp / 10 ** \l_semio_viz_scale_power_int }
  \fp_set:Nn \l_semio_viz_scale_factor_fp
    {
      \l_semio_viz_scale_err_fp >= \c_semio_viz_scale_eten_fp ? 10 :
        ( \l_semio_viz_scale_err_fp >= \c_semio_viz_scale_efive_fp ? 5 :
          ( \l_semio_viz_scale_err_fp >= \c_semio_viz_scale_etwo_fp ? 2 : 1 ) )
    }
}

% 📏 d3-array's ticks(start, stop, count) into the sequence #4.
\cs_new_protected:Npn \semio_viz_scale_tick_values:nnnN #1#2#3#4 {
  \seq_clear:N #4
  \int_compare:nNnT {#3} > { 0 }
    {
      \fp_compare:nNnTF {#1} = {#2}
        { \seq_put_right:Nx #4 { \fp_to_decimal:n {#1} } }
        {
          \fp_compare:nNnTF {#2} < {#1}
            {
              \semio_viz_scale_tick_spec:nnn {#2} {#1} {#3}
              \semio_viz_scale_tick_emit:NN #4 \c_true_bool
            }
            {
              \semio_viz_scale_tick_spec:nnn {#1} {#2} {#3}
              \semio_viz_scale_tick_emit:NN #4 \c_false_bool
            }
        }
    }
}

% 📤 Emits the tick values between the computed indices, reversed when the domain descends.
\cs_new_protected:Npn \semio_viz_scale_tick_emit:NN #1#2 {
  \int_compare:nT { \l_semio_viz_scale_itwo_int >= \l_semio_viz_scale_ione_int }
    {
      \int_step_inline:nnn { \l_semio_viz_scale_ione_int } { \l_semio_viz_scale_itwo_int }
        {
          \bool_if:NTF \l_semio_viz_scale_negpow_bool
            { \seq_put_right:Nx #1 { \fp_to_decimal:n { ##1 / \l_semio_viz_scale_inc_fp } } }
            { \seq_put_right:Nx #1 { \fp_to_decimal:n { ##1 * \l_semio_viz_scale_inc_fp } } }
        }
      \bool_if:NT #2 { \seq_reverse:N #1 }
    }
}

% 📐 d3-array's tickIncrement(start, stop, count).
\cs_new_protected:Npn \semio_viz_scale_tick_increment:nnnN #1#2#3#4 {
  \semio_viz_scale_tick_factor:nnn {#1} {#2} {#3}
  \int_compare:nNnTF { \l_semio_viz_scale_power_int } < { 0 }
    {
      \fp_set:Nn #4
        { -( 10 ** ( -\l_semio_viz_scale_power_int ) ) / \l_semio_viz_scale_factor_fp }
    }
    {
      \fp_set:Nn #4
        { \l_semio_viz_scale_factor_fp * 10 ** \l_semio_viz_scale_power_int }
    }
}

% 🧹 Extends the domain of scale #1 to round tick values at #2 steps, as d3's nice().
\cs_new_protected:Npn \semio_viz_scale_nice:nn #1#2 {
  \semio_viz_scale_nice_pair:nnnNN
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { 1 } }
    { \clist_item:cn { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist } { -1 } }
    {#2} \l_semio_viz_scale_a_fp \l_semio_viz_scale_b_fp
  \seq_set_from_clist:Nc \l_semio_viz_scale_rev_seq
    { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist }
  \seq_pop_left:NN \l_semio_viz_scale_rev_seq \l_tmpa_tl
  \seq_pop_right:NN \l_semio_viz_scale_rev_seq \l_tmpa_tl
  \seq_put_left:Nx \l_semio_viz_scale_rev_seq { \fp_to_decimal:n { \l_semio_viz_scale_a_fp } }
  \seq_put_right:Nx \l_semio_viz_scale_rev_seq { \fp_to_decimal:n { \l_semio_viz_scale_b_fp } }
  \clist_gset:cx { g_semio_viz_scale_ \tl_to_str:n {#1} _domain_clist }
    { \seq_use:Nn \l_semio_viz_scale_rev_seq { , } }
}

