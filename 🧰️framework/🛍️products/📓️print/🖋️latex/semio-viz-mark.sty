\fp_new:N \l_semio_viz_mark_tradius_fp
\fp_new:N \l_semio_viz_mark_tstart_fp
\fp_new:N \l_semio_viz_mark_tend_fp
\bool_new:N \l_semio_viz_mark_tradius_set_bool
