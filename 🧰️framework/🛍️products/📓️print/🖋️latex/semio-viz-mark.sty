\fp_new:N \l_semio_viz_c_ha_fp \fp_new:N \l_semio_viz_c_hb_fp
\fp_new:N \l_semio_viz_c_sa_fp \fp_new:N \l_semio_viz_c_sb_fp
\fp_new:N \l_semio_viz_c_p_fp \fp_new:N \l_semio_viz_c_slope_fp
