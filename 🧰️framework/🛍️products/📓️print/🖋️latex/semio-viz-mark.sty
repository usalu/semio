%endregion 🔖️Render

%region 🔖️Hull
% 🪢 Andrew's monotone chain: the convex hull of the loaded points, counter-clockwise in figure space.
\seq_new:N \l_semio_viz_hull_order_seq
\seq_new:N \l_semio_viz_hull_seq
\seq_new:N \l_semio_viz_hull_lower_seq
\seq_new:N \l_semio_viz_hull_upper_seq
\cs_new:Npn \semio_viz_cross:nnn #1#2#3 {
  \fp_to_decimal:n {
    ( \semio_viz_px:n {#2} - \semio_viz_px:n {#1} ) * ( \semio_viz_py:n {#3} - \semio_viz_py:n {#1} )
    - ( \semio_viz_py:n {#2} - \semio_viz_py:n {#1} ) * ( \semio_viz_px:n {#3} - \semio_viz_px:n {#1} ) }
}
% 🪝 One half of the monotone chain over the point order #1: pop while the last turn is not a left
% turn, then append.
\cs_new_protected:Npn \semio_viz_hull_chain:N #1 {
  \seq_map_inline:Nn #1 {
    \bool_while_do:nn {
      \bool_lazy_and_p:nn
        { \int_compare_p:nNn { \seq_count:N \l_semio_viz_hull_seq } > { 1 } }
        { \fp_compare_p:nNn { \semio_viz_cross:nnn
          { \seq_item:Nn \l_semio_viz_hull_seq { \seq_count:N \l_semio_viz_hull_seq - 1 } }
          { \seq_item:Nn \l_semio_viz_hull_seq { \seq_count:N \l_semio_viz_hull_seq } } {##1} } < { 1e-12 } }
    } { \seq_pop_right:NN \l_semio_viz_hull_seq \l_tmpa_tl }
    \seq_put_right:Nn \l_semio_viz_hull_seq {##1}
  }
}
% 🪢 The convex hull: the points sorted, then the lower and upper chains joined into one ring.
\cs_new_protected:Npn \semio_viz_hull_convex: {
  \seq_clear:N \l_semio_viz_hull_order_seq
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int }
    { \seq_put_right:Nn \l_semio_viz_hull_order_seq {##1} }
  \seq_sort:Nn \l_semio_viz_hull_order_seq {
    \bool_lazy_or:nnTF
      { \fp_compare_p:nNn { \semio_viz_px:n {##1} } > { \semio_viz_px:n {##2} } }
      { \bool_lazy_and_p:nn
          { \fp_compare_p:nNn { \semio_viz_px:n {##1} } = { \semio_viz_px:n {##2} } }
          { \fp_compare_p:nNn { \semio_viz_py:n {##1} } > { \semio_viz_py:n {##2} } } }
      { \sort_return_swapped: } { \sort_return_same: }
  }
  \seq_clear:N \l_semio_viz_hull_seq
  \semio_viz_hull_chain:N \l_semio_viz_hull_order_seq
  \seq_pop_right:NN \l_semio_viz_hull_seq \l_tmpa_tl
  \seq_set_eq:NN \l_semio_viz_hull_lower_seq \l_semio_viz_hull_seq
  \seq_clear:N \l_semio_viz_hull_seq
  \seq_reverse:N \l_semio_viz_hull_order_seq
  \semio_viz_hull_chain:N \l_semio_viz_hull_order_seq
  \seq_pop_right:NN \l_semio_viz_hull_seq \l_tmpa_tl
  \seq_set_eq:NN \l_semio_viz_hull_upper_seq \l_semio_viz_hull_seq
  \seq_concat:NNN \l_semio_viz_hull_seq \l_semio_viz_hull_lower_seq \l_semio_viz_hull_upper_seq
}

% 🪝 Chi-shape digging: every hull edge longer than `concavity` adopts the nearest
% interior point whose two new edges cross nothing, until nothing more can be dug.
\bool_new:N \l_semio_viz_hull_dug_bool
\int_new:N \l_semio_viz_hull_best_int
\fp_new:N \l_semio_viz_hull_bestd_fp
\cs_new:Npn \semio_viz_dist:nn #1#2 {
  \fp_to_decimal:n { sqrt( ( \semio_viz_px:n {#1} - \semio_viz_px:n {#2} )**2
    + ( \semio_viz_py:n {#1} - \semio_viz_py:n {#2} )**2 ) }
}
% 🕳️ The concave hull: the convex one, then dug in repeatedly until nothing more can be adopted.
\cs_new_protected:Npn \semio_viz_hull_concave: {
  \semio_viz_hull_convex:
  \bool_set_true:N \l_semio_viz_hull_dug_bool
  \bool_do_while:nn { \l_semio_viz_hull_dug_bool } {
    \bool_set_false:N \l_semio_viz_hull_dug_bool
    \int_step_inline:nnnn { 1 } { 1 } { \seq_count:N \l_semio_viz_hull_seq } {
      \bool_if:NF \l_semio_viz_hull_dug_bool { \semio_viz_hull_dig:n {##1} }
    }
  }
}
% 🪝 Digs hull edge #1 in, when it is longer than `concavity`, towards the nearest interior point
% whose two new edges are both shorter than the edge it replaces.
\cs_new_protected:Npn \semio_viz_hull_dig:n #1 {
  \int_set:Nn \l_tmpa_int { \seq_item:Nn \l_semio_viz_hull_seq {#1} }
  \int_set:Nn \l_semio_viz_c_i_int
    { \seq_item:Nn \l_semio_viz_hull_seq
      { \int_compare:nNnTF {#1} = { \seq_count:N \l_semio_viz_hull_seq } { 1 } { #1 + 1 } } }
  \fp_compare:nNnT { \semio_viz_dist:nn { \l_tmpa_int } { \l_semio_viz_c_i_int } }
    > { \l_semio_viz_mark_concavity_fp } {
    \int_zero:N \l_semio_viz_hull_best_int
    \fp_set:Nn \l_semio_viz_hull_bestd_fp { inf }
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int } {
      \seq_if_in:NnF \l_semio_viz_hull_seq {##1} {
        \bool_lazy_all:nT {
          { \fp_compare_p:nNn
            { max( \semio_viz_dist:nn { \l_tmpa_int } {##1} , \semio_viz_dist:nn {##1} { \l_semio_viz_c_i_int } ) }
            < { \l_semio_viz_hull_bestd_fp } }
          { \fp_compare_p:nNn { \semio_viz_dist:nn { \l_tmpa_int } {##1} }
            < { \semio_viz_dist:nn { \l_tmpa_int } { \l_semio_viz_c_i_int } } }
          { \fp_compare_p:nNn { \semio_viz_dist:nn {##1} { \l_semio_viz_c_i_int } }
            < { \semio_viz_dist:nn { \l_tmpa_int } { \l_semio_viz_c_i_int } } }
        } {
          \int_set:Nn \l_semio_viz_hull_best_int {##1}
          \fp_set:Nn \l_semio_viz_hull_bestd_fp
            { max( \semio_viz_dist:nn { \l_tmpa_int } {##1} , \semio_viz_dist:nn {##1} { \l_semio_viz_c_i_int } ) }
        }
      }
    }
    \int_compare:nNnT { \l_semio_viz_hull_best_int } > { 0 } {
      \semio_viz_hull_insert:nn {#1} { \l_semio_viz_hull_best_int }
      \bool_set_true:N \l_semio_viz_hull_dug_bool
    }
  }
}
% ➕ Inserts point #2 into the hull ring just after position #1.
\cs_new_protected:Npn \semio_viz_hull_insert:nn #1#2 {
  \seq_clear:N \l_tmpb_seq
  \int_step_inline:nnnn { 1 } { 1 } { \seq_count:N \l_semio_viz_hull_seq } {
    \seq_put_right:Nx \l_tmpb_seq { \seq_item:Nn \l_semio_viz_hull_seq {##1} }
    \int_compare:nNnT {##1} = {#1} { \seq_put_right:Nx \l_tmpb_seq { \int_eval:n {#2} } }
  }
  \seq_set_eq:NN \l_semio_viz_hull_seq \l_tmpb_seq
}
% 🧵 Feeds an index sequence of loaded points through the active curve.
\cs_new_protected:Npn \semio_viz_hull_emit:N #1 {
  \semio_viz_curve_begin:nn { linear-closed } { }
  \seq_map_inline:Nn #1
    { \semio_viz_curve_point:nn { \semio_viz_px:n {##1} } { \semio_viz_py:n {##1} } }
  \semio_viz_curve_end:
}
%endregion 🔖️Hull

%region 🔖️MarkRegistry
% ⚫ Every taxonomy section 0 primitive, one entry per leaf. A kind sets its own
% defaults (an unfilled circle, a stroked connector, a translucent region) before
% the caller's options are applied, so two kinds of the same shape family still
% render differently.
