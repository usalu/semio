\fp_new:N \l_semio_viz_ag_ri_fp \fp_new:N \l_semio_viz_ag_ro_fp
\fp_new:N \l_semio_viz_ag_aa_fp \fp_new:N \l_semio_viz_ag_ab_fp
\fp_new:N \l_semio_viz_ag_da_fp \fp_new:N \l_semio_viz_ag_ap_fp
\fp_new:N \l_semio_viz_ag_rp_fp \fp_new:N \l_semio_viz_ag_rc_fp
\fp_new:N \l_semio_viz_ag_rci_fp \fp_new:N \l_semio_viz_ag_rco_fp
\fp_new:N \l_semio_viz_ag_dai_fp \fp_new:N \l_semio_viz_ag_dao_fp
\fp_new:N \l_semio_viz_ag_aoa_fp \fp_new:N \l_semio_viz_ag_aob_fp
\fp_new:N \l_semio_viz_ag_aia_fp \fp_new:N \l_semio_viz_ag_aib_fp
\fp_new:N \l_semio_viz_ag_xoa_fp \fp_new:N \l_semio_viz_ag_yoa_fp
\fp_new:N \l_semio_viz_ag_xob_fp \fp_new:N \l_semio_viz_ag_yob_fp
\fp_new:N \l_semio_viz_ag_xia_fp \fp_new:N \l_semio_viz_ag_yia_fp
\fp_new:N \l_semio_viz_ag_xib_fp \fp_new:N \l_semio_viz_ag_yib_fp
\fp_new:N \l_semio_viz_ag_pi_fp \fp_new:N \l_semio_viz_ag_po_fp
\bool_new:N \l_semio_viz_ag_cw_bool
\fp_new:N \l_semio_viz_ct_cx_fp \fp_new:N \l_semio_viz_ct_cy_fp
\fp_new:N \l_semio_viz_ct_ax_fp \fp_new:N \l_semio_viz_ct_ay_fp
\fp_new:N \l_semio_viz_ct_bx_fp \fp_new:N \l_semio_viz_ct_by_fp
\clist_map_inline:nn { ta, tb } {
  \fp_new:c { l_semio_viz_ #1 _cx_fp } \fp_new:c { l_semio_viz_ #1 _cy_fp }
  \fp_new:c { l_semio_viz_ #1 _ax_fp } \fp_new:c { l_semio_viz_ #1 _ay_fp }
  \fp_new:c { l_semio_viz_ #1 _bx_fp } \fp_new:c { l_semio_viz_ #1 _by_fp }
}
\fp_new:N \l_semio_viz_ix_fp \fp_new:N \l_semio_viz_iy_fp
\bool_new:N \l_semio_viz_ihit_bool

% ✚ d3-arc's `intersect`: the crossing of the two corner-defining chords, or nothing when they are parallel.
\cs_new_protected:Npn \semio_viz_arc_intersect:nnnnnnnn #1#2#3#4#5#6#7#8 {
  \fp_set:Nn \l_tmpa_fp { ( (#8) - (#6) ) * ( (#3) - (#1) ) - ( (#7) - (#5) ) * ( (#4) - (#2) ) }
  \fp_compare:nNnTF { \l_tmpa_fp * \l_tmpa_fp } < { 1e-12 }
    { \bool_set_false:N \l_semio_viz_ihit_bool }
    {
      \bool_set_true:N \l_semio_viz_ihit_bool
      \fp_set:Nn \l_tmpb_fp
        { ( ( (#7) - (#5) ) * ( (#2) - (#6) ) - ( (#8) - (#6) ) * ( (#1) - (#5) ) ) / \l_tmpa_fp }
      \fp_set:Nn \l_semio_viz_ix_fp { (#1) + \l_tmpb_fp * ( (#3) - (#1) ) }
      \fp_set:Nn \l_semio_viz_iy_fp { (#2) + \l_tmpb_fp * ( (#4) - (#2) ) }
    }
}

% ⌒ d3-arc's `cornerTangents`: centre and the two tangent offsets of one rounded corner.
\cs_new_protected:Npn \semio_viz_arc_corner:nnnnnnn #1#2#3#4#5#6#7 {
  \fp_set:Nn \l_semio_viz_cta_fp { (#1) - (#3) }
  \fp_set:Nn \l_semio_viz_ctb_fp { (#2) - (#4) }
  \fp_set:Nn \l_semio_viz_ctl_fp { \bool_if:nTF {#7} { (#6) } { -(#6) }
    / sqrt( \l_semio_viz_cta_fp * \l_semio_viz_cta_fp + \l_semio_viz_ctb_fp * \l_semio_viz_ctb_fp ) }
  \fp_set:Nn \l_semio_viz_ctox_fp { \l_semio_viz_ctl_fp * \l_semio_viz_ctb_fp }
  \fp_set:Nn \l_semio_viz_ctoy_fp { - \l_semio_viz_ctl_fp * \l_semio_viz_cta_fp }
  \fp_set:Nn \l_semio_viz_ctxa_fp { (#1) + \l_semio_viz_ctox_fp }
  \fp_set:Nn \l_semio_viz_ctya_fp { (#2) + \l_semio_viz_ctoy_fp }
  \fp_set:Nn \l_semio_viz_ctxb_fp { (#3) + \l_semio_viz_ctox_fp }
  \fp_set:Nn \l_semio_viz_ctyb_fp { (#4) + \l_semio_viz_ctoy_fp }
  \fp_set:Nn \l_semio_viz_ctmx_fp { ( \l_semio_viz_ctxa_fp + \l_semio_viz_ctxb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_ctmy_fp { ( \l_semio_viz_ctya_fp + \l_semio_viz_ctyb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_ctdx_fp { \l_semio_viz_ctxb_fp - \l_semio_viz_ctxa_fp }
  \fp_set:Nn \l_semio_viz_ctdy_fp { \l_semio_viz_ctyb_fp - \l_semio_viz_ctya_fp }
  \fp_set:Nn \l_semio_viz_ctdd_fp
    { \l_semio_viz_ctdx_fp * \l_semio_viz_ctdx_fp + \l_semio_viz_ctdy_fp * \l_semio_viz_ctdy_fp }
  \fp_set:Nn \l_semio_viz_ctr_fp { (#5) - (#6) }
  \fp_set:Nn \l_semio_viz_ctcap_fp
    { \l_semio_viz_ctxa_fp * \l_semio_viz_ctyb_fp - \l_semio_viz_ctxb_fp * \l_semio_viz_ctya_fp }
  \fp_set:Nn \l_semio_viz_ctd_fp
    { \fp_compare:nNnTF { \l_semio_viz_ctdy_fp } < { 0 } { -1 } { 1 }
      * sqrt( max( 0 , \l_semio_viz_ctr_fp * \l_semio_viz_ctr_fp * \l_semio_viz_ctdd_fp
        - \l_semio_viz_ctcap_fp * \l_semio_viz_ctcap_fp ) ) }
  \fp_set:Nn \l_semio_viz_ctpx_fp
    { ( \l_semio_viz_ctcap_fp * \l_semio_viz_ctdy_fp - \l_semio_viz_ctdx_fp * \l_semio_viz_ctd_fp ) / \l_semio_viz_ctdd_fp }
  \fp_set:Nn \l_semio_viz_ctpy_fp
    { ( - \l_semio_viz_ctcap_fp * \l_semio_viz_ctdx_fp - \l_semio_viz_ctdy_fp * \l_semio_viz_ctd_fp ) / \l_semio_viz_ctdd_fp }
  \fp_set:Nn \l_semio_viz_ctqx_fp
    { ( \l_semio_viz_ctcap_fp * \l_semio_viz_ctdy_fp + \l_semio_viz_ctdx_fp * \l_semio_viz_ctd_fp ) / \l_semio_viz_ctdd_fp }
  \fp_set:Nn \l_semio_viz_ctqy_fp
    { ( - \l_semio_viz_ctcap_fp * \l_semio_viz_ctdx_fp + \l_semio_viz_ctdy_fp * \l_semio_viz_ctd_fp ) / \l_semio_viz_ctdd_fp }
  \fp_compare:nNnT
    { ( \l_semio_viz_ctpx_fp - \l_semio_viz_ctmx_fp )**2 + ( \l_semio_viz_ctpy_fp - \l_semio_viz_ctmy_fp )**2 }
    > { ( \l_semio_viz_ctqx_fp - \l_semio_viz_ctmx_fp )**2 + ( \l_semio_viz_ctqy_fp - \l_semio_viz_ctmy_fp )**2 }
    {
      \fp_set_eq:NN \l_semio_viz_ctpx_fp \l_semio_viz_ctqx_fp
      \fp_set_eq:NN \l_semio_viz_ctpy_fp \l_semio_viz_ctqy_fp
    }
  \fp_set_eq:NN \l_semio_viz_ct_cx_fp \l_semio_viz_ctpx_fp
  \fp_set_eq:NN \l_semio_viz_ct_cy_fp \l_semio_viz_ctpy_fp
  \fp_set:Nn \l_semio_viz_ct_ax_fp { - \l_semio_viz_ctox_fp }
  \fp_set:Nn \l_semio_viz_ct_ay_fp { - \l_semio_viz_ctoy_fp }
  \fp_set:Nn \l_semio_viz_ct_bx_fp { \l_semio_viz_ctpx_fp * ( (#5) / \l_semio_viz_ctr_fp - 1 ) }
  \fp_set:Nn \l_semio_viz_ct_by_fp { \l_semio_viz_ctpy_fp * ( (#5) / \l_semio_viz_ctr_fp - 1 ) }
}
\clist_map_inline:nn { cta, ctb, ctl, ctox, ctoy, ctxa, ctya, ctxb, ctyb, ctmx, ctmy,
  ctdx, ctdy, ctdd, ctr, ctcap, ctd, ctpx, ctpy, ctqx, ctqy }
  { \fp_new:c { l_semio_viz_ #1 _fp } }

