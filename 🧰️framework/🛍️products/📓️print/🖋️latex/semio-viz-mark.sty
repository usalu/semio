%region 🔖️ArcPath
% 🧮 d3's clamped inverse trigonometry: out-of-range arguments saturate instead of erroring.
\cs_new:Npn \semio_viz_asin:n #1 {
  \fp_compare:nNnTF {#1} > { 1 } { pi/2 }
    { \fp_compare:nNnTF {#1} < { -1 } { -pi/2 } { asin(#1) } }
}
% 🧮 The clamped arc cosine of the same family.
\cs_new:Npn \semio_viz_acos:n #1 {
  \fp_compare:nNnTF {#1} > { 1 } { 0 }
    { \fp_compare:nNnTF {#1} < { -1 } { pi } { acos(#1) } }
}
% 🔄 The reverse of the arc's own sweep, for the boundary that runs back along it.
\cs_new:Npn \semio_viz_not_cw: { \bool_if:NTF \l_semio_viz_ag_cw_bool { \c_false_bool } { \c_true_bool } }

\fp_new:N \l_semio_viz_ag_kc_fp \fp_new:N \l_semio_viz_ag_lc_fp

% 🥧 Fills the current path buffer with one d3 arc; angles are radians clockwise from twelve o'clock.
\cs_new_protected:Npn \semio_viz_arc_path:nnnnnnn #1#2#3#4#5#6#7 {
  \fp_set:Nn \l_semio_viz_ag_ri_fp { min( (#1) , (#2) ) }
  \fp_set:Nn \l_semio_viz_ag_ro_fp { max( (#1) , (#2) ) }
  \fp_set:Nn \l_semio_viz_ag_aa_fp { (#3) - pi/2 }
  \fp_set:Nn \l_semio_viz_ag_ab_fp { (#4) - pi/2 }
  \fp_set:Nn \l_semio_viz_ag_da_fp { abs( \l_semio_viz_ag_ab_fp - \l_semio_viz_ag_aa_fp ) }
  \bool_set:Nn \l_semio_viz_ag_cw_bool
    { \fp_compare_p:nNn { \l_semio_viz_ag_ab_fp } > { \l_semio_viz_ag_aa_fp } }
  \fp_compare:nNnTF { \l_semio_viz_ag_ro_fp } > { 1e-12 }
    {
      \fp_compare:nNnTF { \l_semio_viz_ag_da_fp } > { 2*pi - 1e-12 }
        { \semio_viz_arc_ring: }
        { \semio_viz_arc_sector:nnn {#5} {#6} {#7} }
    }
    { \semio_viz_path_move_to:nn { 0 } { 0 } }
  \semio_viz_path_close:
}

\cs_generate_variant:Nn \semio_viz_arc_path:nnnnnnn { nnnnnVn }

% 💍 The full-turn case: the outer circle, and the inner one back the other way when there is one.
\cs_new_protected:Npn \semio_viz_arc_ring: {
  \semio_viz_path_move_to:nn { \l_semio_viz_ag_ro_fp * cos( \l_semio_viz_ag_aa_fp ) }
    { \l_semio_viz_ag_ro_fp * sin( \l_semio_viz_ag_aa_fp ) }
  \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_ag_ro_fp }
    { \l_semio_viz_ag_aa_fp } { \l_semio_viz_ag_ab_fp } { \semio_viz_not_cw: }
  \fp_compare:nNnT { \l_semio_viz_ag_ri_fp } > { 1e-12 } {
    \semio_viz_path_move_to:nn { \l_semio_viz_ag_ri_fp * cos( \l_semio_viz_ag_ab_fp ) }
      { \l_semio_viz_ag_ri_fp * sin( \l_semio_viz_ag_ab_fp ) }
    \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_ag_ri_fp }
      { \l_semio_viz_ag_ab_fp } { \l_semio_viz_ag_aa_fp } { \l_semio_viz_ag_cw_bool }
  }
}

% 🍰 The circular or annular sector, with padding and rounded corners applied as d3 applies them.
\cs_new_protected:Npn \semio_viz_arc_sector:nnn #1#2#3 {
  \fp_set_eq:NN \l_semio_viz_ag_aoa_fp \l_semio_viz_ag_aa_fp
  \fp_set_eq:NN \l_semio_viz_ag_aob_fp \l_semio_viz_ag_ab_fp
  \fp_set_eq:NN \l_semio_viz_ag_aia_fp \l_semio_viz_ag_aa_fp
  \fp_set_eq:NN \l_semio_viz_ag_aib_fp \l_semio_viz_ag_ab_fp
  \fp_set_eq:NN \l_semio_viz_ag_dai_fp \l_semio_viz_ag_da_fp
  \fp_set_eq:NN \l_semio_viz_ag_dao_fp \l_semio_viz_ag_da_fp
  \fp_set:Nn \l_semio_viz_ag_ap_fp { (#1) / 2 }
  \fp_set:Nn \l_semio_viz_ag_rp_fp
    { \tl_if_blank:nTF {#2}
        { sqrt( \l_semio_viz_ag_ri_fp * \l_semio_viz_ag_ri_fp + \l_semio_viz_ag_ro_fp * \l_semio_viz_ag_ro_fp ) }
        { #2 } }
  \fp_compare:nNnF { \l_semio_viz_ag_ap_fp } > { 1e-12 } { \fp_zero:N \l_semio_viz_ag_rp_fp }
  \fp_set:Nn \l_semio_viz_ag_rc_fp { min( abs( \l_semio_viz_ag_ro_fp - \l_semio_viz_ag_ri_fp ) / 2 , (#3) ) }
  \fp_set_eq:NN \l_semio_viz_ag_rci_fp \l_semio_viz_ag_rc_fp
  \fp_set_eq:NN \l_semio_viz_ag_rco_fp \l_semio_viz_ag_rc_fp
  \fp_compare:nNnT { \l_semio_viz_ag_rp_fp } > { 1e-12 } { \semio_viz_arc_pad: }
  \fp_set:Nn \l_semio_viz_ag_xoa_fp { \l_semio_viz_ag_ro_fp * cos( \l_semio_viz_ag_aoa_fp ) }
  \fp_set:Nn \l_semio_viz_ag_yoa_fp { \l_semio_viz_ag_ro_fp * sin( \l_semio_viz_ag_aoa_fp ) }
  \fp_set:Nn \l_semio_viz_ag_xib_fp { \l_semio_viz_ag_ri_fp * cos( \l_semio_viz_ag_aib_fp ) }
  \fp_set:Nn \l_semio_viz_ag_yib_fp { \l_semio_viz_ag_ri_fp * sin( \l_semio_viz_ag_aib_fp ) }
  \fp_compare:nNnT { \l_semio_viz_ag_rc_fp } > { 1e-12 } { \semio_viz_arc_corner_limit: }
  \fp_compare:nNnTF { \l_semio_viz_ag_dao_fp } > { 1e-12 }
    {
      \fp_compare:nNnTF { \l_semio_viz_ag_rco_fp } > { 1e-12 }
        { \semio_viz_arc_outer_round: }
        {
          \semio_viz_path_move_to:nn { \l_semio_viz_ag_xoa_fp } { \l_semio_viz_ag_yoa_fp }
          \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_ag_ro_fp }
            { \l_semio_viz_ag_aoa_fp } { \l_semio_viz_ag_aob_fp } { \semio_viz_not_cw: }
        }
    }
    { \semio_viz_path_move_to:nn { \l_semio_viz_ag_xoa_fp } { \l_semio_viz_ag_yoa_fp } }
  \bool_lazy_and:nnTF
    { \fp_compare_p:nNn { \l_semio_viz_ag_ri_fp } > { 1e-12 } }
    { \fp_compare_p:nNn { \l_semio_viz_ag_dai_fp } > { 1e-12 } }
    {
      \fp_compare:nNnTF { \l_semio_viz_ag_rci_fp } > { 1e-12 }
        { \semio_viz_arc_inner_round: }
        {
          \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_ag_ri_fp }
            { \l_semio_viz_ag_aib_fp } { \l_semio_viz_ag_aia_fp } { \l_semio_viz_ag_cw_bool }
        }
    }
    { \semio_viz_path_line_to:nn { \l_semio_viz_ag_xib_fp } { \l_semio_viz_ag_yib_fp } }
}

% ↔️ d3's padding step: the inner and outer edges lose the angle a gap of `padRadius` subtends.
\cs_new_protected:Npn \semio_viz_arc_pad: {
  \fp_set:Nn \l_semio_viz_ag_pi_fp
    { \fp_compare:nNnTF { \l_semio_viz_ag_ri_fp } > { 1e-12 }
        { \semio_viz_asin:n { \l_semio_viz_ag_rp_fp / \l_semio_viz_ag_ri_fp * sin( \l_semio_viz_ag_ap_fp ) } }
        { pi/2 } }
  \fp_set:Nn \l_semio_viz_ag_po_fp
    { \semio_viz_asin:n { \l_semio_viz_ag_rp_fp / \l_semio_viz_ag_ro_fp * sin( \l_semio_viz_ag_ap_fp ) } }
  \fp_set:Nn \l_semio_viz_ag_dai_fp { \l_semio_viz_ag_dai_fp - 2 * \l_semio_viz_ag_pi_fp }
  \fp_compare:nNnTF { \l_semio_viz_ag_dai_fp } > { 1e-12 }
    {
      \bool_if:NF \l_semio_viz_ag_cw_bool { \fp_set:Nn \l_semio_viz_ag_pi_fp { - \l_semio_viz_ag_pi_fp } }
      \fp_add:Nn \l_semio_viz_ag_aia_fp { \l_semio_viz_ag_pi_fp }
      \fp_sub:Nn \l_semio_viz_ag_aib_fp { \l_semio_viz_ag_pi_fp }
    }
    {
      \fp_zero:N \l_semio_viz_ag_dai_fp
      \fp_set:Nn \l_semio_viz_ag_aia_fp { ( \l_semio_viz_ag_aa_fp + \l_semio_viz_ag_ab_fp ) / 2 }
      \fp_set_eq:NN \l_semio_viz_ag_aib_fp \l_semio_viz_ag_aia_fp
    }
  \fp_set:Nn \l_semio_viz_ag_dao_fp { \l_semio_viz_ag_dao_fp - 2 * \l_semio_viz_ag_po_fp }
  \fp_compare:nNnTF { \l_semio_viz_ag_dao_fp } > { 1e-12 }
    {
      \bool_if:NF \l_semio_viz_ag_cw_bool { \fp_set:Nn \l_semio_viz_ag_po_fp { - \l_semio_viz_ag_po_fp } }
      \fp_add:Nn \l_semio_viz_ag_aoa_fp { \l_semio_viz_ag_po_fp }
      \fp_sub:Nn \l_semio_viz_ag_aob_fp { \l_semio_viz_ag_po_fp }
    }
    {
      \fp_zero:N \l_semio_viz_ag_dao_fp
      \fp_set:Nn \l_semio_viz_ag_aoa_fp { ( \l_semio_viz_ag_aa_fp + \l_semio_viz_ag_ab_fp ) / 2 }
      \fp_set_eq:NN \l_semio_viz_ag_aob_fp \l_semio_viz_ag_aoa_fp
    }
}

% 📏 Shrinks the corner radius to what the sector's own angle admits; d3 disables it when the chords do not meet.
\cs_new_protected:Npn \semio_viz_arc_corner_limit: {
  \fp_set:Nn \l_semio_viz_ag_xob_fp { \l_semio_viz_ag_ro_fp * cos( \l_semio_viz_ag_aob_fp ) }
  \fp_set:Nn \l_semio_viz_ag_yob_fp { \l_semio_viz_ag_ro_fp * sin( \l_semio_viz_ag_aob_fp ) }
  \fp_set:Nn \l_semio_viz_ag_xia_fp { \l_semio_viz_ag_ri_fp * cos( \l_semio_viz_ag_aia_fp ) }
  \fp_set:Nn \l_semio_viz_ag_yia_fp { \l_semio_viz_ag_ri_fp * sin( \l_semio_viz_ag_aia_fp ) }
  \fp_compare:nNnT { \l_semio_viz_ag_da_fp } < { pi } {
    \semio_viz_arc_intersect:nnnnnnnn
      { \l_semio_viz_ag_xoa_fp } { \l_semio_viz_ag_yoa_fp } { \l_semio_viz_ag_xia_fp } { \l_semio_viz_ag_yia_fp }
      { \l_semio_viz_ag_xob_fp } { \l_semio_viz_ag_yob_fp } { \l_semio_viz_ag_xib_fp } { \l_semio_viz_ag_yib_fp }
    \bool_if:NTF \l_semio_viz_ihit_bool {
      \fp_set:Nn \l_semio_viz_ag_kc_fp { 1 / sin( \semio_viz_acos:n {
        ( ( \l_semio_viz_ag_xoa_fp - \l_semio_viz_ix_fp ) * ( \l_semio_viz_ag_xob_fp - \l_semio_viz_ix_fp )
        + ( \l_semio_viz_ag_yoa_fp - \l_semio_viz_iy_fp ) * ( \l_semio_viz_ag_yob_fp - \l_semio_viz_iy_fp ) ) /
        ( sqrt( ( \l_semio_viz_ag_xoa_fp - \l_semio_viz_ix_fp )**2 + ( \l_semio_viz_ag_yoa_fp - \l_semio_viz_iy_fp )**2 )
        * sqrt( ( \l_semio_viz_ag_xob_fp - \l_semio_viz_ix_fp )**2 + ( \l_semio_viz_ag_yob_fp - \l_semio_viz_iy_fp )**2 ) ) }
        / 2 ) }
      \fp_set:Nn \l_semio_viz_ag_lc_fp
        { sqrt( \l_semio_viz_ix_fp * \l_semio_viz_ix_fp + \l_semio_viz_iy_fp * \l_semio_viz_iy_fp ) }
      \fp_set:Nn \l_semio_viz_ag_rci_fp { min( \l_semio_viz_ag_rc_fp ,
        ( \l_semio_viz_ag_ri_fp - \l_semio_viz_ag_lc_fp ) / ( \l_semio_viz_ag_kc_fp - 1 ) ) }
      \fp_set:Nn \l_semio_viz_ag_rco_fp { min( \l_semio_viz_ag_rc_fp ,
        ( \l_semio_viz_ag_ro_fp - \l_semio_viz_ag_lc_fp ) / ( \l_semio_viz_ag_kc_fp + 1 ) ) }
    } {
      \fp_zero:N \l_semio_viz_ag_rci_fp
      \fp_zero:N \l_semio_viz_ag_rco_fp
    }
  }
}

% 🌗 The outer boundary with rounded corners: the two corner circles and the arc between them.
\cs_new_protected:Npn \semio_viz_arc_outer_round: {
  \semio_viz_arc_corner:nnnnnnn { \l_semio_viz_ag_xia_fp } { \l_semio_viz_ag_yia_fp }
    { \l_semio_viz_ag_xoa_fp } { \l_semio_viz_ag_yoa_fp }
    { \l_semio_viz_ag_ro_fp } { \l_semio_viz_ag_rco_fp } { \l_semio_viz_ag_cw_bool }
  \semio_viz_arc_corner_store:n { ta }
  \semio_viz_arc_corner:nnnnnnn { \l_semio_viz_ag_xob_fp } { \l_semio_viz_ag_yob_fp }
    { \l_semio_viz_ag_xib_fp } { \l_semio_viz_ag_yib_fp }
    { \l_semio_viz_ag_ro_fp } { \l_semio_viz_ag_rco_fp } { \l_semio_viz_ag_cw_bool }
  \semio_viz_arc_corner_store:n { tb }
  \semio_viz_path_move_to:nn { \semio_viz_ct:nn { ta } { cx } + \semio_viz_ct:nn { ta } { ax } }
    { \semio_viz_ct:nn { ta } { cy } + \semio_viz_ct:nn { ta } { ay } }
  \fp_compare:nNnTF { \l_semio_viz_ag_rco_fp } < { \l_semio_viz_ag_rc_fp }
    {
      \semio_viz_path_arc:nnnnnn { \semio_viz_ct:nn { ta } { cx } } { \semio_viz_ct:nn { ta } { cy } }
        { \l_semio_viz_ag_rco_fp }
        { atan( \semio_viz_ct:nn { ta } { ay } , \semio_viz_ct:nn { ta } { ax } ) }
        { atan( \semio_viz_ct:nn { tb } { ay } , \semio_viz_ct:nn { tb } { ax } ) } { \semio_viz_not_cw: }
    }
    {
      \semio_viz_path_arc:nnnnnn { \semio_viz_ct:nn { ta } { cx } } { \semio_viz_ct:nn { ta } { cy } }
        { \l_semio_viz_ag_rco_fp }
        { atan( \semio_viz_ct:nn { ta } { ay } , \semio_viz_ct:nn { ta } { ax } ) }
        { atan( \semio_viz_ct:nn { ta } { by } , \semio_viz_ct:nn { ta } { bx } ) } { \semio_viz_not_cw: }
      \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_ag_ro_fp }
        { atan( \semio_viz_ct:nn { ta } { cy } + \semio_viz_ct:nn { ta } { by } ,
                \semio_viz_ct:nn { ta } { cx } + \semio_viz_ct:nn { ta } { bx } ) }
        { atan( \semio_viz_ct:nn { tb } { cy } + \semio_viz_ct:nn { tb } { by } ,
                \semio_viz_ct:nn { tb } { cx } + \semio_viz_ct:nn { tb } { bx } ) } { \semio_viz_not_cw: }
      \semio_viz_path_arc:nnnnnn { \semio_viz_ct:nn { tb } { cx } } { \semio_viz_ct:nn { tb } { cy } }
        { \l_semio_viz_ag_rco_fp }
        { atan( \semio_viz_ct:nn { tb } { by } , \semio_viz_ct:nn { tb } { bx } ) }
        { atan( \semio_viz_ct:nn { tb } { ay } , \semio_viz_ct:nn { tb } { ax } ) } { \semio_viz_not_cw: }
    }
}

% 🌘 The inner boundary with rounded corners, run back the other way to close the sector.
\cs_new_protected:Npn \semio_viz_arc_inner_round: {
  \semio_viz_arc_corner:nnnnnnn { \l_semio_viz_ag_xib_fp } { \l_semio_viz_ag_yib_fp }
    { \l_semio_viz_ag_xob_fp } { \l_semio_viz_ag_yob_fp }
    { \l_semio_viz_ag_ri_fp } { - \l_semio_viz_ag_rci_fp } { \l_semio_viz_ag_cw_bool }
  \semio_viz_arc_corner_store:n { ta }
  \semio_viz_arc_corner:nnnnnnn { \l_semio_viz_ag_xoa_fp } { \l_semio_viz_ag_yoa_fp }
    { \l_semio_viz_ag_xia_fp } { \l_semio_viz_ag_yia_fp }
    { \l_semio_viz_ag_ri_fp } { - \l_semio_viz_ag_rci_fp } { \l_semio_viz_ag_cw_bool }
  \semio_viz_arc_corner_store:n { tb }
  \semio_viz_path_line_to:nn { \semio_viz_ct:nn { ta } { cx } + \semio_viz_ct:nn { ta } { ax } }
    { \semio_viz_ct:nn { ta } { cy } + \semio_viz_ct:nn { ta } { ay } }
  \fp_compare:nNnTF { \l_semio_viz_ag_rci_fp } < { \l_semio_viz_ag_rc_fp }
    {
      \semio_viz_path_arc:nnnnnn { \semio_viz_ct:nn { ta } { cx } } { \semio_viz_ct:nn { ta } { cy } }
        { \l_semio_viz_ag_rci_fp }
        { atan( \semio_viz_ct:nn { ta } { ay } , \semio_viz_ct:nn { ta } { ax } ) }
        { atan( \semio_viz_ct:nn { tb } { ay } , \semio_viz_ct:nn { tb } { ax } ) } { \semio_viz_not_cw: }
    }
    {
      \semio_viz_path_arc:nnnnnn { \semio_viz_ct:nn { ta } { cx } } { \semio_viz_ct:nn { ta } { cy } }
        { \l_semio_viz_ag_rci_fp }
        { atan( \semio_viz_ct:nn { ta } { ay } , \semio_viz_ct:nn { ta } { ax } ) }
        { atan( \semio_viz_ct:nn { ta } { by } , \semio_viz_ct:nn { ta } { bx } ) } { \semio_viz_not_cw: }
      \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_ag_ri_fp }
        { atan( \semio_viz_ct:nn { ta } { cy } + \semio_viz_ct:nn { ta } { by } ,
                \semio_viz_ct:nn { ta } { cx } + \semio_viz_ct:nn { ta } { bx } ) }
        { atan( \semio_viz_ct:nn { tb } { cy } + \semio_viz_ct:nn { tb } { by } ,
                \semio_viz_ct:nn { tb } { cx } + \semio_viz_ct:nn { tb } { bx } ) } { \l_semio_viz_ag_cw_bool }
      \semio_viz_path_arc:nnnnnn { \semio_viz_ct:nn { tb } { cx } } { \semio_viz_ct:nn { tb } { cy } }
        { \l_semio_viz_ag_rci_fp }
        { atan( \semio_viz_ct:nn { tb } { by } , \semio_viz_ct:nn { tb } { bx } ) }
        { atan( \semio_viz_ct:nn { tb } { ay } , \semio_viz_ct:nn { tb } { ax } ) } { \semio_viz_not_cw: }
    }
}

% 🎯 d3's arc centroid: the midpoint in both radius and angle.
\cs_new:Npn \semio_viz_arc_centroid_x:nnnn #1#2#3#4
  { \fp_to_decimal:n { cos( ( (#3) + (#4) ) / 2 - pi/2 ) * ( (#1) + (#2) ) / 2 } }
% 🎯 The ordinate of that centroid.
\cs_new:Npn \semio_viz_arc_centroid_y:nnnn #1#2#3#4
  { \fp_to_decimal:n { sin( ( (#3) + (#4) ) / 2 - pi/2 ) * ( (#1) + (#2) ) / 2 } }
%endregion 🔖️ArcPath

%region 🔖️Pie
% 🥧 d3-pie: start and end angle per datum, in the data's own order, with the
% pad angle taken out of the available turn before the values are scaled.
\seq_new:N \g_semio_viz_pie_start_seq
\seq_new:N \g_semio_viz_pie_end_seq
\seq_new:N \g_semio_viz_pie_index_seq
\seq_new:N \l_semio_viz_pie_values_seq
\seq_new:N \l_semio_viz_pie_order_seq
\fp_new:N \l_semio_viz_pie_sum_fp \fp_new:N \l_semio_viz_pie_da_fp
\fp_new:N \l_semio_viz_pie_pad_fp \fp_new:N \l_semio_viz_pie_k_fp
\fp_new:N \l_semio_viz_pie_cursor_fp \fp_new:N \l_semio_viz_pie_pa_fp
\prop_new:N \l_semio_viz_pie_start_prop
\prop_new:N \l_semio_viz_pie_end_prop

% 🥧 #1 values (clist), #2 startAngle, #3 endAngle, #4 padAngle, #5 sort: none|descending|ascending.
\cs_new_protected:Npn \semio_viz_pie_compute:nnnnn #1#2#3#4#5 {
  \seq_set_from_clist:Nn \l_semio_viz_pie_values_seq {#1}
  \int_set:Nn \l_semio_viz_c_n_int { \seq_count:N \l_semio_viz_pie_values_seq }
  \fp_zero:N \l_semio_viz_pie_sum_fp
  \seq_map_inline:Nn \l_semio_viz_pie_values_seq
    { \fp_compare:nNnT {##1} > { 0 } { \fp_add:Nn \l_semio_viz_pie_sum_fp {##1} } }
  \fp_set:Nn \l_semio_viz_pie_cursor_fp {#2}
  \fp_set:Nn \l_semio_viz_pie_da_fp { min( 2*pi , max( -2*pi , (#3) - (#2) ) ) }
  \fp_set:Nn \l_semio_viz_pie_pad_fp
    { min( abs( \l_semio_viz_pie_da_fp ) / \l_semio_viz_c_n_int , (#4) ) }
  \fp_set:Nn \l_semio_viz_pie_pa_fp
    { \fp_compare:nNnTF { \l_semio_viz_pie_da_fp } < { 0 } { - \l_semio_viz_pie_pad_fp } { \l_semio_viz_pie_pad_fp } }
  \fp_set:Nn \l_semio_viz_pie_k_fp
    { \fp_compare:nNnTF { \l_semio_viz_pie_sum_fp } = { 0 } { 0 }
      { ( \l_semio_viz_pie_da_fp - \l_semio_viz_c_n_int * \l_semio_viz_pie_pa_fp ) / \l_semio_viz_pie_sum_fp } }
  \semio_viz_pie_order:n {#5}
  \prop_clear:N \l_semio_viz_pie_start_prop
  \prop_clear:N \l_semio_viz_pie_end_prop
  \seq_map_inline:Nn \l_semio_viz_pie_order_seq {
    \prop_put:Nnx \l_semio_viz_pie_start_prop {##1} { \fp_to_decimal:N \l_semio_viz_pie_cursor_fp }
    \fp_add:Nn \l_semio_viz_pie_cursor_fp {
      \fp_compare:nNnTF { \seq_item:Nn \l_semio_viz_pie_values_seq {##1} } > { 0 }
        { \seq_item:Nn \l_semio_viz_pie_values_seq {##1} * \l_semio_viz_pie_k_fp } { 0 }
      + \l_semio_viz_pie_pa_fp }
    \prop_put:Nnx \l_semio_viz_pie_end_prop {##1} { \fp_to_decimal:N \l_semio_viz_pie_cursor_fp }
  }
  \seq_gclear:N \g_semio_viz_pie_start_seq
  \seq_gclear:N \g_semio_viz_pie_end_seq
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_c_n_int } {
    \seq_gput_right:Nx \g_semio_viz_pie_start_seq { \prop_item:Nn \l_semio_viz_pie_start_prop {##1} }
    \seq_gput_right:Nx \g_semio_viz_pie_end_seq { \prop_item:Nn \l_semio_viz_pie_end_prop {##1} }
  }
}

% 🔢 The order the arcs are laid out in; d3 sorts the INDEX, not the data, so the results stay in input order.
\cs_new_protected:Npn \semio_viz_pie_order:n #1 {
  \seq_clear:N \l_semio_viz_pie_order_seq
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_c_n_int }
    { \seq_put_right:Nn \l_semio_viz_pie_order_seq {##1} }
  \str_case:nn {#1} {
    { descending } {
      \seq_sort:Nn \l_semio_viz_pie_order_seq {
        \fp_compare:nNnTF { \seq_item:Nn \l_semio_viz_pie_values_seq {##1} }
          < { \seq_item:Nn \l_semio_viz_pie_values_seq {##2} }
          { \sort_return_swapped: } { \sort_return_same: }
      }
    }
    { ascending } {
      \seq_sort:Nn \l_semio_viz_pie_order_seq {
        \fp_compare:nNnTF { \seq_item:Nn \l_semio_viz_pie_values_seq {##1} }
          > { \seq_item:Nn \l_semio_viz_pie_values_seq {##2} }
          { \sort_return_swapped: } { \sort_return_same: }
      }
    }
  }
}
% 🥧 The same generator on a sequence: a family that has already pulled its value column into a
% seq (pie rings, sunburst rings) hands it over without rebuilding a comma list at the call site.
\cs_new_protected:Npn \semio_viz_pie_from_seq:Nnnnn #1#2#3#4#5 {
  \use:x
    {
      \exp_not:N \semio_viz_pie_compute:nnnnn { \seq_use:Nn #1 { , } }
        { \fp_to_decimal:n {#2} } { \fp_to_decimal:n {#3} } { \fp_to_decimal:n {#4} } {#5}
    }
}
%endregion 🔖️Pie

%region 🔖️Link
% 🔗 d3-shape's link generators: a single bump between two points, horizontal,
% vertical or radial. The radial form maps (angle, radius) through d3's own
% pointRadial, which measures the angle clockwise from twelve o'clock.
\cs_new:Npn \semio_viz_point_radial_x:nn #1#2 { \fp_to_decimal:n { (#2) * cos( (#1) - pi/2 ) } }
% 🧭 The ordinate of the same polar point.
\cs_new:Npn \semio_viz_point_radial_y:nn #1#2 { \fp_to_decimal:n { (#2) * sin( (#1) - pi/2 ) } }

% 🔗 #1 kind (horizontal|vertical|radial), then source x/y and target x/y (angle/radius when radial).
\cs_new_protected:Npn \semio_viz_link_path:nnnnn #1#2#3#4#5 {
  \str_case:nnF {#1} {
    { horizontal } {
      \semio_viz_path_move_to:nn {#2} {#3}
      \semio_viz_path_bezier_to:nnnnnn { ( (#2) + (#4) ) / 2 } {#3} { ( (#2) + (#4) ) / 2 } {#5} {#4} {#5}
    }
    { vertical } {
      \semio_viz_path_move_to:nn {#2} {#3}
      \semio_viz_path_bezier_to:nnnnnn {#2} { ( (#3) + (#5) ) / 2 } {#4} { ( (#3) + (#5) ) / 2 } {#4} {#5}
    }
    { radial } {
      \semio_viz_path_move_to:nn { \semio_viz_point_radial_x:nn {#2} {#3} }
        { \semio_viz_point_radial_y:nn {#2} {#3} }
      \semio_viz_path_bezier_to:nnnnnn
        { \semio_viz_point_radial_x:nn {#2} { ( (#3) + (#5) ) / 2 } }
        { \semio_viz_point_radial_y:nn {#2} { ( (#3) + (#5) ) / 2 } }
        { \semio_viz_point_radial_x:nn {#4} { ( (#3) + (#5) ) / 2 } }
        { \semio_viz_point_radial_y:nn {#4} { ( (#3) + (#5) ) / 2 } }
        { \semio_viz_point_radial_x:nn {#4} {#5} } { \semio_viz_point_radial_y:nn {#4} {#5} }
    }
  } { \msg_error:nnn { semio-viz } { unknown-mark } { link/#1 } }
}
%endregion 🔖️Link

%region 🔖️Ribbon
% 🎀 d3-chord's ribbon: two arcs on the same circle joined by quadratics through
% the centre. #1 source radius, #2 source start, #3 source end, #4 target radius,
% #5 target start, #6 target end, #7 pad angle.
\fp_new:N \l_semio_viz_rb_sa_fp \fp_new:N \l_semio_viz_rb_sb_fp
\fp_new:N \l_semio_viz_rb_taa_fp \fp_new:N \l_semio_viz_rb_tab_fp
\fp_new:N \l_semio_viz_rb_ap_fp
\cs_new_protected:Npn \semio_viz_ribbon_path:nnnnnnn #1#2#3#4#5#6#7 {
  \fp_set:Nn \l_semio_viz_rb_ap_fp { (#7) / 2 }
  \fp_set:Nn \l_semio_viz_rb_sa_fp { (#2) - pi/2 }
  \fp_set:Nn \l_semio_viz_rb_sb_fp { (#3) - pi/2 }
  \fp_set:Nn \l_semio_viz_rb_taa_fp { (#5) - pi/2 }
  \fp_set:Nn \l_semio_viz_rb_tab_fp { (#6) - pi/2 }
  \fp_compare:nNnT { \l_semio_viz_rb_ap_fp } > { 1e-12 } {
    \semio_viz_ribbon_pad:NN \l_semio_viz_rb_sa_fp \l_semio_viz_rb_sb_fp
    \semio_viz_ribbon_pad:NN \l_semio_viz_rb_taa_fp \l_semio_viz_rb_tab_fp
  }
  \semio_viz_path_move_to:nn { (#1) * cos( \l_semio_viz_rb_sa_fp ) } { (#1) * sin( \l_semio_viz_rb_sa_fp ) }
  \semio_viz_path_arc:nnnnnn { 0 } { 0 } {#1}
    { \l_semio_viz_rb_sa_fp } { \l_semio_viz_rb_sb_fp } { \c_false_bool }
  \bool_lazy_and:nnF
    { \fp_compare_p:nNn { \l_semio_viz_rb_sa_fp } = { \l_semio_viz_rb_taa_fp } }
    { \fp_compare_p:nNn { \l_semio_viz_rb_sb_fp } = { \l_semio_viz_rb_tab_fp } }
    {
      \semio_viz_path_quad_to:nnnn { 0 } { 0 }
        { (#4) * cos( \l_semio_viz_rb_taa_fp ) } { (#4) * sin( \l_semio_viz_rb_taa_fp ) }
      \semio_viz_path_arc:nnnnnn { 0 } { 0 } {#4}
        { \l_semio_viz_rb_taa_fp } { \l_semio_viz_rb_tab_fp } { \c_false_bool }
    }
  \semio_viz_path_quad_to:nnnn { 0 } { 0 }
    { (#1) * cos( \l_semio_viz_rb_sa_fp ) } { (#1) * sin( \l_semio_viz_rb_sa_fp ) }
  \semio_viz_path_close:
}
% ↔️ Takes the pad angle out of the span from #1 to #2, collapsing it to its midpoint when the span
% is too narrow to pad — which is what keeps a hairline ribbon from turning inside out.
\cs_new_protected:Npn \semio_viz_ribbon_pad:NN #1#2 {
  \fp_compare:nNnTF { abs( #2 - #1 ) } > { 2 * \l_semio_viz_rb_ap_fp + 1e-12 }
    {
      \fp_compare:nNnTF {#2} > {#1}
        { \fp_add:Nn #1 { \l_semio_viz_rb_ap_fp } \fp_sub:Nn #2 { \l_semio_viz_rb_ap_fp } }
        { \fp_sub:Nn #1 { \l_semio_viz_rb_ap_fp } \fp_add:Nn #2 { \l_semio_viz_rb_ap_fp } }
    }
    {
      \fp_set:Nn \l_tmpa_fp { ( #1 + #2 ) / 2 }
      \fp_set_eq:NN #1 \l_tmpa_fp
      \fp_set_eq:NN #2 \l_tmpa_fp
    }
}
%endregion 🔖️Ribbon

%region 🔖️Points
% 📍 The `points` vocabulary: `x,y; x,y; …` in figure millimetres, parsed once
% into two parallel fp sequences so every consumer indexes instead of re-parsing.
\seq_new:N \l_semio_viz_pt_x_seq
\seq_new:N \l_semio_viz_pt_y_seq
\seq_new:N \l_semio_viz_pt_ax_seq
\seq_new:N \l_semio_viz_pt_ay_seq
\int_new:N \l_semio_viz_pt_n_int
\seq_new:N \l_semio_viz_pt_raw_seq

\cs_new_protected:Npn \semio_viz_points_parse:nNN #1#2#3 {
  \seq_clear:N #2
  \seq_clear:N #3
  \seq_set_split:Nnn \l_semio_viz_pt_raw_seq { ; } {#1}
  \seq_map_inline:Nn \l_semio_viz_pt_raw_seq {
    \tl_set:Nn \l_tmpa_tl {##1}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_if_empty:NF \l_tmpa_tl {
      \seq_put_right:Nx #2 { \fp_to_decimal:n { \clist_item:Nn \l_tmpa_tl { 1 } } }
      \seq_put_right:Nx #3 { \fp_to_decimal:n { \clist_item:Nn \l_tmpa_tl { 2 } } }
    }
  }
}
\cs_generate_variant:Nn \semio_viz_points_parse:nNN { VNN }

% 📥 Parses the mark's `points` and `points2` lists into the indexed coordinate sequences.
\cs_new_protected:Npn \semio_viz_points_load: {
  \semio_viz_points_parse:VNN \l_semio_viz_mark_points_tl \l_semio_viz_pt_x_seq \l_semio_viz_pt_y_seq
  \int_set:Nn \l_semio_viz_pt_n_int { \seq_count:N \l_semio_viz_pt_x_seq }
  \semio_viz_points_parse:VNN \l_semio_viz_mark_points_alt_tl \l_semio_viz_pt_ax_seq \l_semio_viz_pt_ay_seq
}
% 📐 Abscissa of the loaded point #1.
\cs_new:Npn \semio_viz_px:n #1 { \seq_item:Nn \l_semio_viz_pt_x_seq {#1} }
% 📐 Ordinate of the loaded point #1.
\cs_new:Npn \semio_viz_py:n #1 { \seq_item:Nn \l_semio_viz_pt_y_seq {#1} }

%endregion 🔖️Points

%region 🔖️Keys
% 🎛️ Mark keys, all with documented defaults.
%   size (fp, 6)                mark AREA in square millimetres, d3-symbol semantics
%   fill (tl, theme~slot~0)     fill colour, or `none` for an unfilled mark
%   stroke (tl, semio-chrome-border-emphasized)  stroke colour, or `none`
%   strokeWidth (tl, \semio@stroke@default)      stroke width, a TeX dimension
%   opacity (fp, 1)             draw opacity of the whole mark
%   rotate (fp, 0)              rotation in degrees about the mark's own point
%   pattern (tl, none)          none|hatch|crosshatch|dots|grid, a grayscale-safe fill
%   points (tl, empty)          `x,y; x,y; …` in figure millimetres
%   points2 (tl, empty)         the second boundary of a band, envelope or ribbon
%   curve (tl, linear)          interpolator name, see the Curves region
%   tension / alpha / beta (fp) curve parameters (0, 0.5, 0.85)
%   closed (bool, false)        close the path after the last point
%   dash (tl, none)             none|dashed|dotted|dash-dot, or an explicit dash pattern
%   arrow (tl, none)            none|end|start|both
%   arrowSize (tl, 1.6mm)       arrowhead length
%   radius / rx / ry (fp)       arc radii; rx and ry default to radius
%   innerRadius / outerRadius (fp)  annulus radii (0, radius)
%   startAngle / endAngle (fp)  radians clockwise from twelve o'clock (0, pi/2)
%   padAngle / padRadius / cornerRadius  d3-arc padding and rounding (0, empty, 0)
%   route (tl, hv)              orthogonal connector order: hv or vh
%   curvature (fp, 0.4)         curved connector bow, as a fraction of the span
%   via (tl, empty)             waypoints of a bundled connector
%   concavity (fp, 20)          longest edge a concave hull will not dig into
%   aspect (fp, 2)              width-to-height ratio of the rectangle mark
%   symbol (tl, circle)         d3 symbol drawn inside an icon mark
%   file (tl, empty)            image file of an image mark
%   extent (tl, empty)          `lo,hi` span of a reference band, bracket or brace
\tl_new:N \l_semio_viz_mark_fill_tl
\tl_new:N \l_semio_viz_mark_stroke_tl
\tl_new:N \l_semio_viz_mark_width_tl
\tl_new:N \l_semio_viz_mark_pattern_tl
\tl_new:N \l_semio_viz_mark_points_tl
\tl_new:N \l_semio_viz_mark_points_alt_tl
\tl_new:N \l_semio_viz_mark_curve_tl
\tl_new:N \l_semio_viz_mark_dash_tl
\tl_new:N \l_semio_viz_mark_arrow_tl
\tl_new:N \l_semio_viz_mark_arrow_size_tl
\tl_new:N \l_semio_viz_mark_route_tl
\tl_new:N \l_semio_viz_mark_via_tl
\tl_new:N \l_semio_viz_mark_symbol_tl
\tl_new:N \l_semio_viz_mark_file_tl
\tl_new:N \l_semio_viz_mark_extent_tl
\tl_new:N \l_semio_viz_mark_padradius_tl
\fp_new:N \l_semio_viz_mark_size_fp
\fp_new:N \l_semio_viz_mark_opacity_fp
\fp_new:N \l_semio_viz_mark_rotate_fp
\fp_new:N \l_semio_viz_mark_tension_fp
\fp_new:N \l_semio_viz_mark_alpha_fp
\fp_new:N \l_semio_viz_mark_beta_fp
\fp_new:N \l_semio_viz_mark_radius_fp
\fp_new:N \l_semio_viz_mark_rx_fp
\fp_new:N \l_semio_viz_mark_ry_fp
\fp_new:N \l_semio_viz_mark_inner_fp
\fp_new:N \l_semio_viz_mark_outer_fp
\fp_new:N \l_semio_viz_mark_start_fp
\fp_new:N \l_semio_viz_mark_end_fp
\fp_new:N \l_semio_viz_mark_pad_fp
\fp_new:N \l_semio_viz_mark_corner_fp
\fp_new:N \l_semio_viz_mark_curvature_fp
\fp_new:N \l_semio_viz_mark_concavity_fp
\fp_new:N \l_semio_viz_mark_aspect_fp
\bool_new:N \l_semio_viz_mark_closed_bool
\bool_new:N \l_semio_viz_mark_rx_set_bool
\bool_new:N \l_semio_viz_mark_ry_set_bool
\bool_new:N \l_semio_viz_mark_outer_set_bool

\keys_define:nn { semio / viz / mark } {
  size        .fp_set:N   = \l_semio_viz_mark_size_fp,
  fill        .tl_set:N   = \l_semio_viz_mark_fill_tl,
  stroke      .tl_set:N   = \l_semio_viz_mark_stroke_tl,
  strokeWidth .tl_set:N   = \l_semio_viz_mark_width_tl,
  opacity     .fp_set:N   = \l_semio_viz_mark_opacity_fp,
  rotate      .fp_set:N   = \l_semio_viz_mark_rotate_fp,
  pattern     .tl_set:N   = \l_semio_viz_mark_pattern_tl,
  points      .tl_set:N   = \l_semio_viz_mark_points_tl,
  points2     .tl_set:N   = \l_semio_viz_mark_points_alt_tl,
  curve       .tl_set:N   = \l_semio_viz_mark_curve_tl,
  tension     .fp_set:N   = \l_semio_viz_mark_tension_fp,
  alpha       .fp_set:N   = \l_semio_viz_mark_alpha_fp,
  beta        .fp_set:N   = \l_semio_viz_mark_beta_fp,
  closed      .bool_set:N = \l_semio_viz_mark_closed_bool,
  dash        .tl_set:N   = \l_semio_viz_mark_dash_tl,
  arrow       .tl_set:N   = \l_semio_viz_mark_arrow_tl,
  arrowSize   .tl_set:N   = \l_semio_viz_mark_arrow_size_tl,
  radius      .code:n     = {
    \fp_set:Nn \l_semio_viz_mark_radius_fp {#1}
    \bool_if:NF \l_semio_viz_mark_outer_set_bool { \fp_set:Nn \l_semio_viz_mark_outer_fp {#1} }
    \bool_if:NF \l_semio_viz_mark_rx_set_bool { \fp_set:Nn \l_semio_viz_mark_rx_fp {#1} }
    \bool_if:NF \l_semio_viz_mark_ry_set_bool { \fp_set:Nn \l_semio_viz_mark_ry_fp {#1} }
  },
  rx          .code:n     = { \fp_set:Nn \l_semio_viz_mark_rx_fp {#1} \bool_set_true:N \l_semio_viz_mark_rx_set_bool },
  ry          .code:n     = { \fp_set:Nn \l_semio_viz_mark_ry_fp {#1} \bool_set_true:N \l_semio_viz_mark_ry_set_bool },
  innerRadius .fp_set:N   = \l_semio_viz_mark_inner_fp,
  outerRadius .code:n     = { \fp_set:Nn \l_semio_viz_mark_outer_fp {#1} \bool_set_true:N \l_semio_viz_mark_outer_set_bool },
  startAngle  .fp_set:N   = \l_semio_viz_mark_start_fp,
  endAngle    .fp_set:N   = \l_semio_viz_mark_end_fp,
  padAngle    .fp_set:N   = \l_semio_viz_mark_pad_fp,
  padRadius   .tl_set:N   = \l_semio_viz_mark_padradius_tl,
  cornerRadius .fp_set:N  = \l_semio_viz_mark_corner_fp,
  route       .tl_set:N   = \l_semio_viz_mark_route_tl,
  curvature   .fp_set:N   = \l_semio_viz_mark_curvature_fp,
  via         .tl_set:N   = \l_semio_viz_mark_via_tl,
  concavity   .fp_set:N   = \l_semio_viz_mark_concavity_fp,
  aspect      .fp_set:N   = \l_semio_viz_mark_aspect_fp,
  symbol      .tl_set:N   = \l_semio_viz_mark_symbol_tl,
  file        .tl_set:N   = \l_semio_viz_mark_file_tl,
  extent      .tl_set:N   = \l_semio_viz_mark_extent_tl,
}

% ♻️ Puts every mark key back to its documented default before an option list is read.
\cs_new_protected:Npn \semio_viz_mark_keys_reset: {
  \fp_set:Nn \l_semio_viz_mark_size_fp { 6 }
  \tl_set:Nn \l_semio_viz_mark_fill_tl { \semio_viz_theme_color:n { 0 } }
  \tl_set:Nn \l_semio_viz_mark_stroke_tl { semio-chrome-border-emphasized }
  \tl_set:Nn \l_semio_viz_mark_width_tl { \semio@stroke@default }
  \fp_set:Nn \l_semio_viz_mark_opacity_fp { 1 }
  \fp_zero:N \l_semio_viz_mark_rotate_fp
  \tl_set:Nn \l_semio_viz_mark_pattern_tl { none }
  \tl_clear:N \l_semio_viz_mark_points_tl
  \tl_clear:N \l_semio_viz_mark_points_alt_tl
  \tl_set:Nn \l_semio_viz_mark_curve_tl { linear }
  \fp_zero:N \l_semio_viz_mark_tension_fp
  \fp_set:Nn \l_semio_viz_mark_alpha_fp { 0.5 }
  \fp_set:Nn \l_semio_viz_mark_beta_fp { 0.85 }
  \bool_set_false:N \l_semio_viz_mark_closed_bool
  \tl_set:Nn \l_semio_viz_mark_dash_tl { none }
  \tl_set:Nn \l_semio_viz_mark_arrow_tl { none }
  \tl_set:Nn \l_semio_viz_mark_arrow_size_tl { 1.6mm }
  \fp_set:Nn \l_semio_viz_mark_radius_fp { 8 }
  \fp_set:Nn \l_semio_viz_mark_rx_fp { 8 }
  \fp_set:Nn \l_semio_viz_mark_ry_fp { 5 }
  \fp_zero:N \l_semio_viz_mark_inner_fp
  \fp_set:Nn \l_semio_viz_mark_outer_fp { 8 }
  \fp_zero:N \l_semio_viz_mark_start_fp
  \fp_set:Nn \l_semio_viz_mark_end_fp { pi/2 }
  \fp_zero:N \l_semio_viz_mark_pad_fp
  \tl_clear:N \l_semio_viz_mark_padradius_tl
  \fp_zero:N \l_semio_viz_mark_corner_fp
  \tl_set:Nn \l_semio_viz_mark_route_tl { hv }
  \fp_set:Nn \l_semio_viz_mark_curvature_fp { 0.4 }
  \tl_clear:N \l_semio_viz_mark_via_tl
  \fp_set:Nn \l_semio_viz_mark_concavity_fp { 20 }
  \fp_set:Nn \l_semio_viz_mark_aspect_fp { 2 }
  \tl_set:Nn \l_semio_viz_mark_symbol_tl { circle }
  \tl_clear:N \l_semio_viz_mark_file_tl
  \tl_clear:N \l_semio_viz_mark_extent_tl
  \bool_set_false:N \l_semio_viz_mark_rx_set_bool
  \bool_set_false:N \l_semio_viz_mark_ry_set_bool
  \bool_set_false:N \l_semio_viz_mark_outer_set_bool
}
% 🎚️ The mark's curve parameters as one option list for the interpolator.
\cs_new:Npn \semio_viz_mark_curve_opts: {
  tension = \fp_use:N \l_semio_viz_mark_tension_fp ,
  alpha = \fp_use:N \l_semio_viz_mark_alpha_fp ,
  beta = \fp_use:N \l_semio_viz_mark_beta_fp
}
%endregion 🔖️Keys

%region 🔖️Render
% 🖌️ Turns the recorded path into one TikZ operation, honouring fill, stroke,
% pattern, dash and arrowheads. `none` on fill or stroke removes that half.
\tl_new:N \l_semio_viz_mark_opts_tl
\bool_new:N \l_semio_viz_in_figure_bool

\cs_new_protected:Npn \semio_viz_frame_require:n #1 {
  \bool_if:NF \l_semio_viz_in_figure_bool
    { \msg_error:nnn { semio-viz } { outside-figure } {#1} }
}

% 🎨 The TikZ option list of the current mark: fill, pattern, stroke, width, dash, arrow tips and
% opacity, each read from the mark keys and never written into a renderer.
\cs_new_protected:Npn \semio_viz_mark_options: {
  \tl_clear:N \l_semio_viz_mark_opts_tl
  \str_if_eq:VnF \l_semio_viz_mark_stroke_tl { none }
    { \tl_put_right:Nx \l_semio_viz_mark_opts_tl
        { draw= \l_semio_viz_mark_stroke_tl , line~width= \exp_not:V \l_semio_viz_mark_width_tl , } }
  \str_if_eq:VnF \l_semio_viz_mark_fill_tl { none }
    { \tl_put_right:Nx \l_semio_viz_mark_opts_tl { fill= \l_semio_viz_mark_fill_tl , } }
  \str_case:Vn \l_semio_viz_mark_pattern_tl {
    { hatch }      { \tl_put_right:Nx \l_semio_viz_mark_opts_tl
                       { pattern=north~east~lines , pattern~color= \l_semio_viz_mark_fill_tl , } }
    { crosshatch } { \tl_put_right:Nx \l_semio_viz_mark_opts_tl
                       { pattern=crosshatch , pattern~color= \l_semio_viz_mark_fill_tl , } }
    { dots }       { \tl_put_right:Nx \l_semio_viz_mark_opts_tl
                       { pattern=dots , pattern~color= \l_semio_viz_mark_fill_tl , } }
    { grid }       { \tl_put_right:Nx \l_semio_viz_mark_opts_tl
                       { pattern=grid , pattern~color= \l_semio_viz_mark_fill_tl , } }
  }
  \str_case:Vn \l_semio_viz_mark_dash_tl {
    { dashed }   { \tl_put_right:Nn \l_semio_viz_mark_opts_tl { dashed , } }
    { dotted }   { \tl_put_right:Nn \l_semio_viz_mark_opts_tl { dotted , } }
    { dash-dot } { \tl_put_right:Nn \l_semio_viz_mark_opts_tl { dash~pattern=on~2pt~off~1pt~on~0.4pt~off~1pt , } }
    { none }     { }
  }
  \str_if_eq:VnF \l_semio_viz_mark_dash_tl { none }
    { \str_case:VnF \l_semio_viz_mark_dash_tl { { dashed } { } { dotted } { } { dash-dot } { } }
        { \tl_put_right:Nx \l_semio_viz_mark_opts_tl { dash~pattern= \l_semio_viz_mark_dash_tl , } } }
  \str_case:Vn \l_semio_viz_mark_arrow_tl {
    { end }   { \tl_put_right:Nx \l_semio_viz_mark_opts_tl
                  { -{Latex[length=\exp_not:V \l_semio_viz_mark_arrow_size_tl]} , } }
    { start } { \tl_put_right:Nx \l_semio_viz_mark_opts_tl
                  { {Latex[length=\exp_not:V \l_semio_viz_mark_arrow_size_tl]}- , } }
    { both }  { \tl_put_right:Nx \l_semio_viz_mark_opts_tl
                  { {Latex[length=\exp_not:V \l_semio_viz_mark_arrow_size_tl]}-{Latex[length=\exp_not:V \l_semio_viz_mark_arrow_size_tl]} , } }
  }
  \tl_put_right:Nx \l_semio_viz_mark_opts_tl { opacity= \fp_to_decimal:N \l_semio_viz_mark_opacity_fp }
}

% 🌀 The `rotate around` option of the current mark, built with a catcode-12 colon so that
% TikZ still splits the angle from the pivot when the option is assembled under `\ExplSyntaxOn`.
\tl_new:N \l_semio_viz_mark_rotate_tl

% 🔄 Opens a TikZ scope carrying the already-expanded option text #1.
\cs_new_protected:Npn \semio_viz_mark_scope_begin:n #1 { \begin{scope} [#1] }
\cs_generate_variant:Nn \semio_viz_mark_scope_begin:n { V }

% 🖼️ Draws the buffered path and, when probing, emits its geometry.
\cs_new_protected:Npn \semio_viz_mark_emit:n #1 {
