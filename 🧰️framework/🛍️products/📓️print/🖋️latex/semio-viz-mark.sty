                          \tl_set:Nn \l_semio_viz_mark_dash_tl { dashed } }
    { circular-region } { \fp_set:Nn \l_semio_viz_mark_opacity_fp { 0.2 }
                          \tl_set:Nn \l_semio_viz_mark_dash_tl { dashed } }
    { polygonal-region } { \fp_set:Nn \l_semio_viz_mark_opacity_fp { 0.2 } }
