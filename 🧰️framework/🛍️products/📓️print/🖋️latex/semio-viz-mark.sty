  \fp_set_eq:NN \l_semio_viz_c_cxa_fp \l_semio_viz_c_xb_fp
  \fp_set_eq:NN \l_semio_viz_c_cya_fp \l_semio_viz_c_yb_fp
  \fp_set_eq:NN \l_semio_viz_c_cxb_fp \l_semio_viz_c_xc_fp
  \fp_set_eq:NN \l_semio_viz_c_cyb_fp \l_semio_viz_c_yc_fp
  \fp_compare:nNnT { \l_semio_viz_c_laa_fp } > { 1e-12 } {
    \fp_set:Nn \l_semio_viz_c_ga_fp { 2 * \l_semio_viz_c_lab_fp
      + 3 * \l_semio_viz_c_laa_fp * \l_semio_viz_c_lba_fp + \l_semio_viz_c_lbb_fp }
    \fp_set:Nn \l_semio_viz_c_gb_fp { 3 * \l_semio_viz_c_laa_fp * ( \l_semio_viz_c_laa_fp + \l_semio_viz_c_lba_fp ) }
    \fp_set:Nn \l_semio_viz_c_cxa_fp { ( \l_semio_viz_c_xb_fp * \l_semio_viz_c_ga_fp
      - \l_semio_viz_c_xa_fp * \l_semio_viz_c_lbb_fp + \l_semio_viz_c_xc_fp * \l_semio_viz_c_lab_fp ) / \l_semio_viz_c_gb_fp }
    \fp_set:Nn \l_semio_viz_c_cya_fp { ( \l_semio_viz_c_yb_fp * \l_semio_viz_c_ga_fp
      - \l_semio_viz_c_ya_fp * \l_semio_viz_c_lbb_fp + \l_semio_viz_c_yc_fp * \l_semio_viz_c_lab_fp ) / \l_semio_viz_c_gb_fp }
  }
  \fp_compare:nNnT { \l_semio_viz_c_lca_fp } > { 1e-12 } {
    \fp_set:Nn \l_semio_viz_c_ga_fp { 2 * \l_semio_viz_c_lcb_fp
      + 3 * \l_semio_viz_c_lca_fp * \l_semio_viz_c_lba_fp + \l_semio_viz_c_lbb_fp }
    \fp_set:Nn \l_semio_viz_c_gb_fp { 3 * \l_semio_viz_c_lca_fp * ( \l_semio_viz_c_lca_fp + \l_semio_viz_c_lba_fp ) }
    \fp_set:Nn \l_semio_viz_c_cxb_fp { ( \l_semio_viz_c_xc_fp * \l_semio_viz_c_ga_fp
      + \l_semio_viz_c_xb_fp * \l_semio_viz_c_lcb_fp - (#1) * \l_semio_viz_c_lbb_fp ) / \l_semio_viz_c_gb_fp }
    \fp_set:Nn \l_semio_viz_c_cyb_fp { ( \l_semio_viz_c_yc_fp * \l_semio_viz_c_ga_fp
      + \l_semio_viz_c_yb_fp * \l_semio_viz_c_lcb_fp - (#2) * \l_semio_viz_c_lbb_fp ) / \l_semio_viz_c_gb_fp }
  }
  \semio_viz_c_bez:nnnnnn { \l_semio_viz_c_cxa_fp } { \l_semio_viz_c_cya_fp }
    { \l_semio_viz_c_cxb_fp } { \l_semio_viz_c_cyb_fp }
    { \l_semio_viz_c_xc_fp } { \l_semio_viz_c_yc_fp }
}
