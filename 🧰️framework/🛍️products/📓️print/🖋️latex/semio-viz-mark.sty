    { \fp_set_eq:NN \l_semio_viz_mark_tradius_fp \l_semio_viz_mark_radius_fp }
  \semio_viz_xy:n {#3}
  \semio_viz_points_load:
  \semio_viz_mark_probe:nx { mark/#1/at }
    { \fp_to_decimal:N \l_semio_viz_mx_fp , \fp_to_decimal:N \l_semio_viz_my_fp ,
      \fp_to_decimal:N \l_semio_viz_mark_rotate_fp , \fp_to_decimal:N \l_semio_viz_mark_size_fp }
  \semio_viz_mark_probe:nx { mark/#1/style }
    { \exp_not:V \l_semio_viz_mark_fill_tl , \exp_not:V \l_semio_viz_mark_stroke_tl ,
      \exp_not:V \l_semio_viz_mark_dash_tl , \exp_not:V \l_semio_viz_mark_arrow_tl ,
      \exp_not:V \l_semio_viz_mark_pattern_tl , \fp_to_decimal:N \l_semio_viz_mark_opacity_fp }
  \semio_viz_mark_body:n {#1}
}

% 🧭 Centred geometry (symbols, arcs, ribbons) is built in d3 space and flipped onto the mark's point.
\cs_new_protected:Npn \semio_viz_mark_local: {
  \semio_viz_path_begin:nnn { \l_semio_viz_mx_fp } { \l_semio_viz_my_fp } { \c_true_bool }
}
% 🗺️ Point-list geometry is already in figure space, so it is recorded and drawn unchanged.
\cs_new_protected:Npn \semio_viz_mark_global: {
  \semio_viz_path_begin:nnn { 0 } { 0 } { \c_false_bool }
}
% 🧵 Runs the caller's curve over the loaded points, closing when asked.
\cs_new_protected:Npn \semio_viz_mark_curve_points: {
  \semio_viz_curve_begin:VV \l_semio_viz_mark_curve_tl \l_semio_viz_mark_curve_opts_tl
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int }
    { \semio_viz_curve_point:nn { \semio_viz_px:n {##1} } { \semio_viz_py:n {##1} } }
  \semio_viz_curve_end:
  \bool_if:NT \l_semio_viz_mark_closed_bool { \semio_viz_path_close: }
}
\tl_new:N \l_semio_viz_mark_curve_opts_tl
\cs_generate_variant:Nn \semio_viz_curve_begin:nn { nV, VV, Vn }

% 🧱 The body of mark kind #1: the one branch table that maps every registered §0 kind to the
% geometry it draws, so a new kind is a row here and nowhere else.
\cs_new_protected:Npn \semio_viz_mark_body:n #1 {
  \tl_set:Nx \l_semio_viz_mark_curve_opts_tl { \semio_viz_mark_curve_opts: }
  \str_case:nnF {#1} {
    { dot }         { \semio_viz_mark_symbolic:nn { circle } { dot } }
    { circle }      { \semio_viz_mark_symbolic:nn { circle } { circle } }
    { square }      { \semio_viz_mark_symbolic:nn { square } { square } }
    { triangle }    { \semio_viz_mark_symbolic:nn { triangle } { triangle } }
    { diamond }     { \semio_viz_mark_symbolic:nn { diamond } { diamond } }
    { cross }       { \semio_viz_mark_symbolic:nn { times } { cross } }
    { plus }        { \semio_viz_mark_symbolic:nn { plus } { plus } }
    { star }        { \semio_viz_mark_symbolic:nn { star } { star } }
    { rectangle }   { \semio_viz_mark_rectangle: }
    { custom-glyph } { \semio_viz_mark_glyph: }
    { icon-mark }   { \semio_viz_mark_icon: }
    { image-mark }  { \semio_viz_mark_image: }
    { text-mark }   { \semio_viz_mark_anchor: }
    { polygon }        { \semio_viz_mark_global: \semio_viz_curve_begin:nn { linear-closed } { }
                         \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int }
                           { \semio_viz_curve_point:nn { \semio_viz_px:n {##1} } { \semio_viz_py:n {##1} } }
                         \semio_viz_curve_end: \semio_viz_mark_emit:n { mark/#1 } }
    { filled-path }    { \semio_viz_mark_global: \bool_set_true:N \l_semio_viz_mark_closed_bool
                         \semio_viz_mark_curve_points: \semio_viz_mark_emit:n { mark/#1 } }
    { band }           { \semio_viz_mark_area:n { mark/#1 } }
    { envelope }       { \semio_viz_mark_envelope: }
    { ribbon }         { \semio_viz_mark_ribbon: }
    { circular-arc }   { \semio_viz_mark_local:
                         \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_mark_radius_fp }
                           { \l_semio_viz_mark_start_fp - pi/2 } { \l_semio_viz_mark_end_fp - pi/2 } { \c_false_bool }
                         \semio_viz_mark_emit:n { mark/#1 } }
    { elliptical-arc } { \semio_viz_mark_local:
                         \semio_viz_mark_ellipse_radii:
                         \semio_viz_path_ellipse_arc:nnnnnn { 0 } { 0 }
                           { \l_semio_viz_mark_rx_fp } { \l_semio_viz_mark_ry_fp }
                           { \l_semio_viz_mark_start_fp - pi/2 } { \l_semio_viz_mark_end_fp - pi/2 }
                         \semio_viz_mark_emit:n { mark/#1 } }
    { annular-arc }    { \semio_viz_mark_arc:n { mark/#1 } }
    { sector }         { \fp_zero:N \l_semio_viz_mark_inner_fp \semio_viz_mark_arc:n { mark/#1 } }
    { wedge }          { \fp_zero:N \l_semio_viz_mark_inner_fp \semio_viz_mark_arc:n { mark/#1 } }
    { straight-connector }   { \semio_viz_mark_ends:n { mark/#1 } \semio_viz_mark_terminals: }
    { arrow }                { \semio_viz_mark_ends:n { mark/#1 } }
    { bidirectional-arrow }  { \semio_viz_mark_ends:n { mark/#1 } }
    { orthogonal-connector } { \semio_viz_mark_orthogonal:nn { mark/#1 } { 2 } }
    { elbow-connector }      { \semio_viz_mark_orthogonal:nn { mark/#1 } { 3 } }
    { curved-connector }     { \semio_viz_mark_curved: }
    { bundled-connector }    { \semio_viz_mark_bundled: }
    { rectangular-region }   { \semio_viz_mark_box:n { mark/#1 } }
    { highlight-region }     { \semio_viz_mark_box:n { mark/#1 } }
    { circular-region }      { \semio_viz_mark_local:
                               \semio_viz_path_move_to:nn { \l_semio_viz_mark_radius_fp } { 0 }
                               \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_mark_radius_fp }
                                 { 0 } { 2*pi } { \c_false_bool }
                               \semio_viz_mark_emit:n { mark/#1 } }
    { polygonal-region }     { \semio_viz_mark_global: \semio_viz_hull_ring: \semio_viz_mark_emit:n { mark/#1 } }
    { voronoi-region }       { \semio_viz_mark_global: \semio_viz_hull_ring: \semio_viz_mark_emit:n { mark/#1 }
                               \semio_viz_mark_site: }
    { convex-hull }          { \semio_viz_mark_global: \semio_viz_hull_convex:
                               \semio_viz_hull_emit:N \l_semio_viz_hull_seq
                               \semio_viz_mark_emit:n { mark/#1 } }
    { concave-hull }         { \semio_viz_mark_global: \semio_viz_hull_concave:
                               \semio_viz_hull_emit:N \l_semio_viz_hull_seq
                               \semio_viz_mark_emit:n { mark/#1 } }
    { label }                { \semio_viz_mark_tick: }
    { callout }              { \semio_viz_mark_callout: }
    { leader-line }          { \semio_viz_mark_global: \semio_viz_curve_begin:nn { linear } { }
                               \semio_viz_curve_point:nn { \l_semio_viz_mx_fp } { \l_semio_viz_my_fp }
                               \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int }
                                 { \semio_viz_curve_point:nn { \semio_viz_px:n {##1} } { \semio_viz_py:n {##1} } }
                               \semio_viz_curve_end: \semio_viz_mark_emit:n { mark/#1 } }
    { bracket }              { \semio_viz_mark_bracket: }
    { brace }                { \semio_viz_mark_brace: }
    { reference-line }       { \semio_viz_mark_reference_line: }
    { reference-band }       { \semio_viz_mark_reference_band: }
    { reference-point }      { \semio_viz_mark_reference_point: }
  } { \semio_viz_mark_global: \semio_viz_mark_curve_points: \semio_viz_mark_emit:n { mark/#1 } }
}
%endregion 🔖️MarkRegistry

%region 🔖️MarkBodies
% ⚫ A d3 symbol #1 of the mark's own area, recorded under the kind name #2.
\cs_new_protected:Npn \semio_viz_mark_symbolic:nn #1#2 {
  \semio_viz_mark_local:
  \semio_viz_symbol_draw:nn {#1} { \l_semio_viz_mark_size_fp }
  \semio_viz_mark_emit:n { mark/#2 }
}
% ▭ A rectangle of the mark's area at the mark's own aspect ratio.
\cs_new_protected:Npn \semio_viz_mark_rectangle: {
  \semio_viz_mark_local:
  \fp_set:Nn \l_semio_viz_sym_x_fp { sqrt( \l_semio_viz_mark_size_fp * \l_semio_viz_mark_aspect_fp ) }
  \fp_set:Nn \l_semio_viz_sym_y_fp { \l_semio_viz_mark_size_fp / \l_semio_viz_sym_x_fp }
  \semio_viz_path_rect:nnnn { - \l_semio_viz_sym_x_fp / 2 } { - \l_semio_viz_sym_y_fp / 2 }
    { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
  \semio_viz_mark_emit:n { mark/rectangle }
}
% 🖋️ A caller-supplied outline, scaled so its bounding box carries the mark's area.
\cs_new_protected:Npn \semio_viz_mark_glyph: {
  \semio_viz_mark_local:
  \int_compare:nNnTF { \l_semio_viz_pt_n_int } > { 2 } {
    \fp_set:Nn \l_semio_viz_sym_x_fp { \semio_viz_px:n { 1 } }
    \fp_set:Nn \l_semio_viz_sym_y_fp { \semio_viz_px:n { 1 } }
    \fp_set:Nn \l_semio_viz_sym_t_fp { \semio_viz_py:n { 1 } }
    \fp_set:Nn \l_semio_viz_sym_u_fp { \semio_viz_py:n { 1 } }
    \int_step_inline:nnnn { 2 } { 1 } { \l_semio_viz_pt_n_int } {
      \fp_set:Nn \l_semio_viz_sym_x_fp { min( \l_semio_viz_sym_x_fp , \semio_viz_px:n {##1} ) }
      \fp_set:Nn \l_semio_viz_sym_y_fp { max( \l_semio_viz_sym_y_fp , \semio_viz_px:n {##1} ) }
      \fp_set:Nn \l_semio_viz_sym_t_fp { min( \l_semio_viz_sym_t_fp , \semio_viz_py:n {##1} ) }
      \fp_set:Nn \l_semio_viz_sym_u_fp { max( \l_semio_viz_sym_u_fp , \semio_viz_py:n {##1} ) }
    }
    \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( \l_semio_viz_mark_size_fp /
      max( 1e-9 , ( \l_semio_viz_sym_y_fp - \l_semio_viz_sym_x_fp )
        * ( \l_semio_viz_sym_u_fp - \l_semio_viz_sym_t_fp ) ) ) }
    \semio_viz_curve_begin:nn { linear-closed } { }
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int } {
      \semio_viz_curve_point:nn
        { ( \semio_viz_px:n {##1} - ( \l_semio_viz_sym_x_fp + \l_semio_viz_sym_y_fp ) / 2 ) * \l_semio_viz_sym_r_fp }
        { - ( \semio_viz_py:n {##1} - ( \l_semio_viz_sym_t_fp + \l_semio_viz_sym_u_fp ) / 2 ) * \l_semio_viz_sym_r_fp }
    }
    \semio_viz_curve_end:
  } { \semio_viz_symbol_draw:nn { diamond2 } { \l_semio_viz_mark_size_fp } }
  \semio_viz_mark_emit:n { mark/custom-glyph }
}
% 🏷️ A badge frame with a d3 symbol inside it, so an icon set is data, not a font.
\cs_new_protected:Npn \semio_viz_mark_icon: {
  \semio_viz_mark_local:
  \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( \l_semio_viz_mark_size_fp ) }
  \semio_viz_path_rect:nnnn { - \l_semio_viz_sym_r_fp / 2 } { - \l_semio_viz_sym_r_fp / 2 }
    { \l_semio_viz_sym_r_fp } { \l_semio_viz_sym_r_fp }
  \exp_args:NV \semio_viz_symbol_draw:nn \l_semio_viz_mark_symbol_tl { 0.36 * \l_semio_viz_mark_size_fp }
  \semio_viz_mark_emit:n { mark/icon-mark }
}
% 🖼️ The image frame is geometry; the picture itself is a node so it scales with the figure.
% 🖼️ An image mark: the picture at the mark's point when `file` names one, its placeholder box
% with a cross through it when it does not, so the figure still says an image belongs there.
\cs_new_protected:Npn \semio_viz_mark_image: {
  \semio_viz_mark_local:
  \fp_set:Nn \l_semio_viz_sym_x_fp { sqrt( \l_semio_viz_mark_size_fp * \l_semio_viz_mark_aspect_fp ) }
  \fp_set:Nn \l_semio_viz_sym_y_fp { \l_semio_viz_mark_size_fp / \l_semio_viz_sym_x_fp }
  \semio_viz_path_rect:nnnn { - \l_semio_viz_sym_x_fp / 2 } { - \l_semio_viz_sym_y_fp / 2 }
    { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
  \tl_if_empty:NT \l_semio_viz_mark_file_tl {
    \semio_viz_path_move_to:nn { - \l_semio_viz_sym_x_fp / 2 } { - \l_semio_viz_sym_y_fp / 2 }
    \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp / 2 } { \l_semio_viz_sym_y_fp / 2 }
    \semio_viz_path_move_to:nn { - \l_semio_viz_sym_x_fp / 2 } { \l_semio_viz_sym_y_fp / 2 }
    \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp / 2 } { - \l_semio_viz_sym_y_fp / 2 }
  }
  \semio_viz_mark_emit:n { mark/image-mark }
  \tl_if_empty:NF \l_semio_viz_mark_file_tl {
    \node at ( \fp_to_decimal:N \l_semio_viz_mx_fp mm , \fp_to_decimal:N \l_semio_viz_my_fp mm )
      { \includegraphics [ width= \fp_to_decimal:N \l_semio_viz_sym_x_fp mm ] { \l_semio_viz_mark_file_tl } } ;
  }
}
% ⌖ A text mark carries no ink of its own; its geometry is the anchor \SemioVizText will set the node on.
\cs_new_protected:Npn \semio_viz_mark_anchor: {
  \semio_viz_mark_local:
  \semio_viz_path_move_to:nn { 0 } { 0 }
  \semio_viz_mark_probe:nx { mark/text-mark } { \l_semio_viz_path_cmd_tl }
}
% 🥧 An annular sector recorded under the kind name #1, from the mark's radii, angles, pad and
% corner radius.
\cs_new_protected:Npn \semio_viz_mark_arc:n #1 {
  \semio_viz_mark_local:
  \semio_viz_arc_path:nnnnnVn { \l_semio_viz_mark_inner_fp } { \l_semio_viz_mark_outer_fp }
    { \l_semio_viz_mark_start_fp } { \l_semio_viz_mark_end_fp } { \l_semio_viz_mark_pad_fp }
    { \l_semio_viz_mark_padradius_tl } { \l_semio_viz_mark_corner_fp }
  \semio_viz_mark_emit:n {#1}
}
% 🎗️ A chord ribbon between the mark's two angular spans, on its source and target radii.
\cs_new_protected:Npn \semio_viz_mark_ribbon: {
  \semio_viz_mark_local:
  \semio_viz_ribbon_path:nnnnnnn { \l_semio_viz_mark_radius_fp }
    { \l_semio_viz_mark_start_fp } { \l_semio_viz_mark_end_fp }
    { \l_semio_viz_mark_tradius_fp } { \l_semio_viz_mark_tstart_fp } { \l_semio_viz_mark_tend_fp }
    { \l_semio_viz_mark_pad_fp }
  \semio_viz_mark_emit:n { mark/ribbon }
}
% 🎗️ The closed area between the two boundaries, each drawn with the caller's curve.
\cs_new_protected:Npn \semio_viz_mark_area:n #1 {
  \semio_viz_mark_global:
  \semio_viz_curve_begin:VV \l_semio_viz_mark_curve_tl \l_semio_viz_mark_curve_opts_tl
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int }
    { \semio_viz_curve_point:nn { \semio_viz_px:n {##1} } { \semio_viz_py:n {##1} } }
  \semio_viz_curve_end:
  \int_step_inline:nnnn { \seq_count:N \l_semio_viz_pt_ax_seq } { -1 } { 1 }
    { \semio_viz_path_line_to:nn { \seq_item:Nn \l_semio_viz_pt_ax_seq {##1} }
        { \seq_item:Nn \l_semio_viz_pt_ay_seq {##1} } }
  \semio_viz_path_close:
  \semio_viz_mark_emit:n {#1}
}
% 〰️ An envelope: the two point lists as two open curves, not joined into a closed area.
\cs_new_protected:Npn \semio_viz_mark_envelope: {
  \semio_viz_mark_global:
  \semio_viz_curve_begin:VV \l_semio_viz_mark_curve_tl \l_semio_viz_mark_curve_opts_tl
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int }
    { \semio_viz_curve_point:nn { \semio_viz_px:n {##1} } { \semio_viz_py:n {##1} } }
  \semio_viz_curve_end:
  \semio_viz_curve_begin:VV \l_semio_viz_mark_curve_tl \l_semio_viz_mark_curve_opts_tl
  \int_step_inline:nnnn { 1 } { 1 } { \seq_count:N \l_semio_viz_pt_ax_seq }
    { \semio_viz_curve_point:nn { \seq_item:Nn \l_semio_viz_pt_ax_seq {##1} }
        { \seq_item:Nn \l_semio_viz_pt_ay_seq {##1} } }
  \semio_viz_curve_end:
  \semio_viz_mark_emit:n { mark/envelope }
}
% ➖ A straight run from the first loaded point to the last, recorded under the kind name #1.
\cs_new_protected:Npn \semio_viz_mark_ends:n #1 {
  \semio_viz_mark_global:
  \semio_viz_path_move_to:nn { \semio_viz_px:n { 1 } } { \semio_viz_py:n { 1 } }
  \semio_viz_path_line_to:nn { \semio_viz_px:n { \l_semio_viz_pt_n_int } }
    { \semio_viz_py:n { \l_semio_viz_pt_n_int } }
  \semio_viz_mark_emit:n {#1}
}
% 📐 Two-segment (orthogonal) or three-segment (elbow) right-angled routing.
\cs_new_protected:Npn \semio_viz_mark_orthogonal:nn #1#2 {
  \semio_viz_mark_global:
  \fp_set:Nn \l_semio_viz_sym_x_fp { \semio_viz_px:n { 1 } }
  \fp_set:Nn \l_semio_viz_sym_y_fp { \semio_viz_py:n { 1 } }
  \fp_set:Nn \l_semio_viz_sym_t_fp { \semio_viz_px:n { \l_semio_viz_pt_n_int } }
  \fp_set:Nn \l_semio_viz_sym_u_fp { \semio_viz_py:n { \l_semio_viz_pt_n_int } }
  \semio_viz_path_move_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
  \int_compare:nNnTF {#2} = { 2 }
    {
      \str_if_eq:VnTF \l_semio_viz_mark_route_tl { hv }
        { \semio_viz_path_line_to:nn { \l_semio_viz_sym_t_fp } { \l_semio_viz_sym_y_fp } }
        { \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_u_fp } }
    }
    {
      \str_if_eq:VnTF \l_semio_viz_mark_route_tl { hv }
        {
          \semio_viz_path_line_to:nn { ( \l_semio_viz_sym_x_fp + \l_semio_viz_sym_t_fp ) / 2 } { \l_semio_viz_sym_y_fp }
          \semio_viz_path_line_to:nn { ( \l_semio_viz_sym_x_fp + \l_semio_viz_sym_t_fp ) / 2 } { \l_semio_viz_sym_u_fp }
        }
        {
          \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp } { ( \l_semio_viz_sym_y_fp + \l_semio_viz_sym_u_fp ) / 2 }
          \semio_viz_path_line_to:nn { \l_semio_viz_sym_t_fp } { ( \l_semio_viz_sym_y_fp + \l_semio_viz_sym_u_fp ) / 2 }
        }
    }
  \semio_viz_path_line_to:nn { \l_semio_viz_sym_t_fp } { \l_semio_viz_sym_u_fp }
  \semio_viz_mark_emit:n {#1}
}
% ⤳ A quadratic bow whose sagitta is `curvature` times the span, normal to the chord.
% 〰️ A curved connector: one cubic between the two ends, bulging by `curvature`.
\cs_new_protected:Npn \semio_viz_mark_curved: {
  \semio_viz_mark_global:
  \fp_set:Nn \l_semio_viz_sym_x_fp { \semio_viz_px:n { 1 } }
  \fp_set:Nn \l_semio_viz_sym_y_fp { \semio_viz_py:n { 1 } }
  \fp_set:Nn \l_semio_viz_sym_t_fp { \semio_viz_px:n { \l_semio_viz_pt_n_int } }
  \fp_set:Nn \l_semio_viz_sym_u_fp { \semio_viz_py:n { \l_semio_viz_pt_n_int } }
  \semio_viz_path_move_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
  \semio_viz_path_quad_to:nnnn
    { ( \l_semio_viz_sym_x_fp + \l_semio_viz_sym_t_fp ) / 2
      - \l_semio_viz_mark_curvature_fp * ( \l_semio_viz_sym_u_fp - \l_semio_viz_sym_y_fp ) }
    { ( \l_semio_viz_sym_y_fp + \l_semio_viz_sym_u_fp ) / 2
      + \l_semio_viz_mark_curvature_fp * ( \l_semio_viz_sym_t_fp - \l_semio_viz_sym_x_fp ) }
    { \l_semio_viz_sym_t_fp } { \l_semio_viz_sym_u_fp }
  \semio_viz_mark_emit:n { mark/curved-connector }
}
% 🎋 A basis spline through the endpoints and the caller's waypoints, d3's edge-bundling shape.
\cs_new_protected:Npn \semio_viz_mark_bundled: {
  \semio_viz_mark_global:
  \semio_viz_points_parse:VNN \l_semio_viz_mark_via_tl \l_semio_viz_pt_ax_seq \l_semio_viz_pt_ay_seq
  \semio_viz_curve_begin:nx { bundle } { beta = \fp_use:N \l_semio_viz_mark_beta_fp }
  \semio_viz_curve_point:nn { \semio_viz_px:n { 1 } } { \semio_viz_py:n { 1 } }
  \int_step_inline:nnnn { 1 } { 1 } { \seq_count:N \l_semio_viz_pt_ax_seq }
    { \semio_viz_curve_point:nn { \seq_item:Nn \l_semio_viz_pt_ax_seq {##1} }
        { \seq_item:Nn \l_semio_viz_pt_ay_seq {##1} } }
  \semio_viz_curve_point:nn { \semio_viz_px:n { \l_semio_viz_pt_n_int } }
    { \semio_viz_py:n { \l_semio_viz_pt_n_int } }
  \semio_viz_curve_end:
  \semio_viz_mark_emit:n { mark/bundled-connector }
}
\cs_generate_variant:Nn \semio_viz_curve_begin:nn { nx }
% ▭ A box from two opposite corners in `points`, or from the mark's point and its radius.
\cs_new_protected:Npn \semio_viz_mark_box:n #1 {
  \semio_viz_mark_global:
  \int_compare:nNnTF { \l_semio_viz_pt_n_int } > { 1 }
    {
      \semio_viz_path_rect:nnnn { \semio_viz_px:n { 1 } } { \semio_viz_py:n { 1 } }
        { \semio_viz_px:n { \l_semio_viz_pt_n_int } - \semio_viz_px:n { 1 } }
        { \semio_viz_py:n { \l_semio_viz_pt_n_int } - \semio_viz_py:n { 1 } }
    }
    {
      \semio_viz_path_rect:nnnn
        { \l_semio_viz_mx_fp - \l_semio_viz_mark_rx_fp } { \l_semio_viz_my_fp - \l_semio_viz_mark_ry_fp }
        { 2 * \l_semio_viz_mark_rx_fp } { 2 * \l_semio_viz_mark_ry_fp }
    }
  \semio_viz_mark_emit:n {#1}
}
% 🪢 The hull indices as one closed ring in the path buffer, in the order the chain produced.
\cs_new_protected:Npn \semio_viz_hull_ring: {
  \semio_viz_curve_begin:nn { linear-closed } { }
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int }
    { \semio_viz_curve_point:nn { \semio_viz_px:n {##1} } { \semio_viz_py:n {##1} } }
  \semio_viz_curve_end:
}
% ⏺️ The generating site of a Voronoi cell, drawn as a small solid dot at the mark's point.
\cs_new_protected:Npn \semio_viz_mark_site: {
  \semio_viz_mark_local:
  \semio_viz_symbol_draw:nn { circle } { 0.6 }
  \tl_set:Nn \l_semio_viz_mark_stroke_tl { none }
  \fp_set:Nn \l_semio_viz_mark_opacity_fp { 1 }
  \semio_viz_mark_emit:n { mark/voronoi-region }
}
% ⌐ A short right-angled tick at the labelled point; the text itself is a \SemioVizText node.
\cs_new_protected:Npn \semio_viz_mark_tick: {
  \semio_viz_mark_local:
  \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( \l_semio_viz_mark_size_fp ) }
  \semio_viz_path_move_to:nn { 0 } { 0 }
  \semio_viz_path_line_to:nn { \l_semio_viz_sym_r_fp } { 0 }
  \semio_viz_mark_emit:n { mark/label }
}
% 💬 A leader from the point to a box of `extent` (width, height) offset by the first `points` entry.
\cs_new_protected:Npn \semio_viz_mark_callout: {
  \semio_viz_mark_global:
  \fp_set:Nn \l_semio_viz_sym_x_fp
    { \int_compare:nNnTF { \l_semio_viz_pt_n_int } > { 0 } { \semio_viz_px:n { 1 } }
      { \l_semio_viz_mx_fp + 10 } }
  \fp_set:Nn \l_semio_viz_sym_y_fp
    { \int_compare:nNnTF { \l_semio_viz_pt_n_int } > { 0 } { \semio_viz_py:n { 1 } }
      { \l_semio_viz_my_fp + 10 } }
  \fp_set:Nn \l_semio_viz_sym_t_fp
    { \tl_if_empty:NTF \l_semio_viz_mark_extent_tl { 18 }
      { \clist_item:Nn \l_semio_viz_mark_extent_tl { 1 } } }
  \fp_set:Nn \l_semio_viz_sym_u_fp
    { \tl_if_empty:NTF \l_semio_viz_mark_extent_tl { 8 }
      { \clist_item:Nn \l_semio_viz_mark_extent_tl { 2 } } }
  \semio_viz_path_move_to:nn { \l_semio_viz_mx_fp } { \l_semio_viz_my_fp }
  \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
  \semio_viz_path_rect:nnnn { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
    { \l_semio_viz_sym_t_fp } { \l_semio_viz_sym_u_fp }
  \semio_viz_mark_emit:n { mark/callout }
}
% ⎡ A square bracket spanning `extent` along `route`'s axis, with a depth of `radius`.
\cs_new_protected:Npn \semio_viz_mark_bracket: {
  \semio_viz_mark_global:
  \semio_viz_mark_extent_pair:
  \str_if_eq:VnTF \l_semio_viz_mark_route_tl { hv }
    {
      \semio_viz_path_move_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_my_fp - \l_semio_viz_mark_radius_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_my_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_y_fp } { \l_semio_viz_my_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_y_fp } { \l_semio_viz_my_fp - \l_semio_viz_mark_radius_fp }
    }
    {
      \semio_viz_path_move_to:nn { \l_semio_viz_mx_fp - \l_semio_viz_mark_radius_fp } { \l_semio_viz_sym_x_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_mx_fp } { \l_semio_viz_sym_x_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_mx_fp } { \l_semio_viz_sym_y_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_mx_fp - \l_semio_viz_mark_radius_fp } { \l_semio_viz_sym_y_fp }
    }
  \semio_viz_mark_emit:n { mark/bracket }
}
% ⏝ TikZ's own brace decoration over the same span; the geometry record is the span it decorates.
\cs_new_protected:Npn \semio_viz_mark_brace: {
  \semio_viz_mark_global:
  \semio_viz_mark_extent_pair:
  \semio_viz_path_move_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_my_fp }
  \semio_viz_path_line_to:nn { \l_semio_viz_sym_y_fp } { \l_semio_viz_my_fp }
  \semio_viz_mark_options:
  \semio_viz_mark_probe:nx { mark/brace } { \l_semio_viz_path_cmd_tl }
  \use:x {
    \exp_not:N \draw [ \exp_not:V \l_semio_viz_mark_opts_tl , decorate ,
      decoration={ brace , amplitude= \fp_to_decimal:N \l_semio_viz_mark_radius_fp mm } ]
    \exp_not:V \l_semio_viz_path_tikz_tl ;
  }
}
% 📏 Reads the mark's `extent` as the two ends of a span into the two scratch coordinates.
\cs_new_protected:Npn \semio_viz_mark_extent_pair: {
  \fp_set:Nn \l_semio_viz_sym_x_fp
    { \tl_if_empty:NTF \l_semio_viz_mark_extent_tl { \l_semio_viz_mx_fp - 12 }
      { \clist_item:Nn \l_semio_viz_mark_extent_tl { 1 } } }
  \fp_set:Nn \l_semio_viz_sym_y_fp
    { \tl_if_empty:NTF \l_semio_viz_mark_extent_tl { \l_semio_viz_mx_fp + 12 }
      { \clist_item:Nn \l_semio_viz_mark_extent_tl { 2 } } }
}
% ┈ A rule across `extent`, horizontal for route hv and vertical for vh.
\cs_new_protected:Npn \semio_viz_mark_reference_line: {
  \semio_viz_mark_global:
  \semio_viz_mark_extent_pair:
  \str_if_eq:VnTF \l_semio_viz_mark_route_tl { hv }
    {
      \semio_viz_path_move_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_my_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_y_fp } { \l_semio_viz_my_fp }
    }
    {
      \semio_viz_path_move_to:nn { \l_semio_viz_mx_fp } { \l_semio_viz_sym_x_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_mx_fp } { \l_semio_viz_sym_y_fp }
    }
  \semio_viz_mark_emit:n { mark/reference-line }
}
% ▤ The band between two reference values; `radius` is its half-thickness across the span.
\cs_new_protected:Npn \semio_viz_mark_reference_band: {
  \semio_viz_mark_global:
  \semio_viz_mark_extent_pair:
  \str_if_eq:VnTF \l_semio_viz_mark_route_tl { hv }
    {
      \semio_viz_path_rect:nnnn { \l_semio_viz_sym_x_fp } { \l_semio_viz_my_fp - \l_semio_viz_mark_radius_fp }
        { \l_semio_viz_sym_y_fp - \l_semio_viz_sym_x_fp } { 2 * \l_semio_viz_mark_radius_fp }
    }
    {
      \semio_viz_path_rect:nnnn { \l_semio_viz_mx_fp - \l_semio_viz_mark_radius_fp } { \l_semio_viz_sym_x_fp }
        { 2 * \l_semio_viz_mark_radius_fp } { \l_semio_viz_sym_y_fp - \l_semio_viz_sym_x_fp }
    }
  \semio_viz_mark_emit:n { mark/reference-band }
}
% ◉ A filled dot inside an open ring, the classic "this one" annotation.
\cs_new_protected:Npn \semio_viz_mark_reference_point: {
  \semio_viz_mark_local:
  \semio_viz_symbol_draw:nn { circle } { \l_semio_viz_mark_size_fp / 3 }
  \semio_viz_symbol_draw:nn { circle } { \l_semio_viz_mark_size_fp }
  \semio_viz_mark_emit:n { mark/reference-point }
}
% ⏺️ The terminal discs that tell a connector from a plain line.
\cs_new_protected:Npn \semio_viz_mark_terminals: {
  \semio_viz_path_begin:nnn { \semio_viz_px:n { 1 } } { \semio_viz_py:n { 1 } } { \c_true_bool }
  \semio_viz_symbol_draw:nn { circle } { 0.8 }
  \semio_viz_mark_emit:n { mark/straight-connector }
  \semio_viz_path_begin:nnn { \semio_viz_px:n { \l_semio_viz_pt_n_int } }
    { \semio_viz_py:n { \l_semio_viz_pt_n_int } } { \c_true_bool }
  \semio_viz_symbol_draw:nn { circle } { 0.8 }
  \semio_viz_mark_emit:n { mark/straight-connector }
}
% 🥚 An elliptical arc given only a radius is flattened, so it never coincides with the circular one.
\cs_new_protected:Npn \semio_viz_mark_ellipse_radii: {
  \bool_if:NF \l_semio_viz_mark_ry_set_bool
    { \fp_set:Nn \l_semio_viz_mark_ry_fp { 0.6 * \l_semio_viz_mark_rx_fp } }
}
%endregion 🔖️MarkBodies

%region 🔖️PathApi
% 〰️ \SemioVizPath{kind}[options]: the line, area and connector primitives of
% section 0 driven entirely by `points` and `curve`.
\cs_new_protected:Npn \semio_viz_path_draw:nn #1#2 {
  \semio_viz_frame_require:n { SemioVizPath }
  \seq_if_in:NnF \g_semio_viz_mark_kinds_seq {#1}
    { \msg_error:nnn { semio-viz } { unknown-mark } {#1} }
  \semio_viz_mark_keys_reset:
  \semio_viz_mark_defaults:n {#1}
  \keys_set:nn { semio / viz / mark } {#2}
  \bool_if:NF \l_semio_viz_mark_tradius_set_bool
    { \fp_set_eq:NN \l_semio_viz_mark_tradius_fp \l_semio_viz_mark_radius_fp }
  \semio_viz_points_load:
  \int_compare:nNnTF { \l_semio_viz_pt_n_int } > { 0 }
    {
      \fp_set:Nn \l_semio_viz_mx_fp { \semio_viz_px:n { 1 } }
      \fp_set:Nn \l_semio_viz_my_fp { \semio_viz_py:n { 1 } }
    }
    { \fp_zero:N \l_semio_viz_mx_fp \fp_zero:N \l_semio_viz_my_fp }
  \str_if_eq:nnTF {#1} { straight-line }
    { \semio_viz_mark_ends:n { mark/straight-line } }
    { \semio_viz_mark_body:n {#1} }
}
%endregion 🔖️PathApi

%region 🔖️TextMarks
% 🔠 Text-carrying marks: a SEPARATE command from \SemioVizMark, not a `text=`
% key on it -- l3keys splits key-value lists on commas, and German prose is
% nothing but commas ("Zusammenhang, keine Kausalität"); one missing brace and a
% value silently splits into two keys. Content is the mark's own trailing
% argument instead, never a key.
\tl_new:N \l_semio_viz_text_width_tl
\tl_new:N \l_semio_viz_text_height_tl
\tl_new:N \l_semio_viz_text_anchor_tl
\tl_new:N \l_semio_viz_text_align_tl
\tl_new:N \l_semio_viz_text_style_tl
\tl_new:N \l_semio_viz_text_font_tl
\tl_new:N \l_semio_viz_text_opts_tl

\seq_new:N \g_semio_viz_text_kinds_seq
\clist_map_inline:nn { cell, module, chip, label, title, value, callout, leader }
  { \seq_gput_right:Nn \g_semio_viz_text_kinds_seq {#1} }

% ♻️ Puts every text-mark key back to the default of kind #1: its node style, anchor, alignment
% and font, so a cell reads as a cell and a chip as a chip without the caller saying so.
\cs_new_protected:Npn \semio_viz_text_keys_reset:n #1 {
  \tl_clear:N \l_semio_viz_text_width_tl
  \tl_clear:N \l_semio_viz_text_height_tl
  \tl_set:Nn \l_semio_viz_text_anchor_tl { north~west }
  \tl_set:Nn \l_semio_viz_text_align_tl { left }
  \tl_set:Nn \l_semio_viz_text_font_tl { \c_semio_viz_theme_font_label_tl }
  \tl_clear:N \l_semio_viz_text_style_tl
  \str_case:nn {#1} {
    { cell }    { \tl_set:Nn \l_semio_viz_text_style_tl { semio~viz~cell } \tl_set:Nn \l_semio_viz_text_anchor_tl { center } \tl_set:Nn \l_semio_viz_text_align_tl { center } \tl_clear:N \l_semio_viz_text_font_tl }
    { module }  { \tl_set:Nn \l_semio_viz_text_style_tl { semio~viz~module } \tl_set:Nn \l_semio_viz_text_anchor_tl { center } \tl_set:Nn \l_semio_viz_text_align_tl { center } \tl_clear:N \l_semio_viz_text_font_tl }
    { chip }    { \tl_set:Nn \l_semio_viz_text_style_tl { semio~viz~chip } \tl_set:Nn \l_semio_viz_text_anchor_tl { center } \tl_clear:N \l_semio_viz_text_font_tl }
    { title }   { \tl_set:Nn \l_semio_viz_text_font_tl { \c_semio_viz_theme_font_title_tl } }
    { value }   { \tl_set:Nn \l_semio_viz_text_font_tl { \c_semio_viz_theme_font_value_tl } \tl_set:Nn \l_semio_viz_text_anchor_tl { east } }
    { callout } { \tl_set:Nn \l_semio_viz_text_style_tl { semio~viz~cell } \tl_set:Nn \l_semio_viz_text_anchor_tl { south~west } \tl_clear:N \l_semio_viz_text_font_tl }
    { leader }  { \tl_set:Nn \l_semio_viz_text_anchor_tl { west } }
  }
}

% 🔑 The text-mark keys, `semio / viz / text`: the node's box, its anchor, its alignment, its font
% and any further TikZ style. The content itself is never a key — see the note above.
\keys_define:nn { semio / viz / text } {
  width  .tl_set:N = \l_semio_viz_text_width_tl,
  height .tl_set:N = \l_semio_viz_text_height_tl,
  anchor .tl_set:N = \l_semio_viz_text_anchor_tl,
  align  .tl_set:N = \l_semio_viz_text_align_tl,
  style  .tl_set:N = \l_semio_viz_text_style_tl,
  font   .tl_set:N = \l_semio_viz_text_font_tl,
}

% 🔠 Sets the content #2 as a TikZ node with the option list #1 at the mark's own point.
\cs_new_protected:Npn \semio_viz_text_node:nn #1#2 {
  \node [#1] at ( \fp_eval:n { \l_semio_viz_mx_fp } , \fp_eval:n { \l_semio_viz_my_fp } ) {#2} ;
}
% 🔠 A text mark of kind #1 with the options #2 at the point #3, carrying the content #4, and its
% anchor recorded for the probe.
\cs_new_protected:Npn \semio_viz_text_draw:nnnn #1#2#3#4 {
  \semio_viz_frame_require:n { SemioVizText }
  \seq_if_in:NnF \g_semio_viz_text_kinds_seq {#1}
    { \msg_error:nnn { semio-viz } { unknown-text-kind } {#1} }
  \semio_viz_text_keys_reset:n {#1}
  \keys_set:nn { semio / viz / text } {#2}
  \semio_viz_xy:n {#3}
  \tl_clear:N \l_semio_viz_text_opts_tl
  \tl_if_empty:NF \l_semio_viz_text_style_tl
    { \tl_put_right:Nx \l_semio_viz_text_opts_tl { \l_semio_viz_text_style_tl , } }
  \tl_if_empty:NF \l_semio_viz_text_width_tl
    { \tl_put_right:Nx \l_semio_viz_text_opts_tl { text~width= \l_semio_viz_text_width_tl ~mm , } }
  \tl_if_empty:NF \l_semio_viz_text_height_tl
    { \tl_put_right:Nx \l_semio_viz_text_opts_tl { minimum~height= \l_semio_viz_text_height_tl ~mm , } }
  \tl_if_empty:NF \l_semio_viz_text_font_tl
    { \tl_put_right:Nx \l_semio_viz_text_opts_tl { font={ \exp_not:V \l_semio_viz_text_font_tl }, } }
  \tl_put_right:Nx \l_semio_viz_text_opts_tl {
    anchor= \l_semio_viz_text_anchor_tl , align= \l_semio_viz_text_align_tl , outer~sep=0pt,
  }
  \semio_viz_mark_probe:nx { text/#1 }
    { \fp_to_decimal:N \l_semio_viz_mx_fp , \fp_to_decimal:N \l_semio_viz_my_fp }
  \exp_args:NV \semio_viz_text_node:nn \l_semio_viz_text_opts_tl {#4}
}
%endregion 🔖️TextMarks

%region 🔖️PublicApi
% ⚫ Draws a section 0 mark at a millimetre point.
\NewDocumentCommand \SemioVizMark { m O{} m } { \semio_viz_mark_draw:nnn {#1} {#2} {#3} }
% 〰️ Draws a section 0 line, area, region or connector from its `points` list.
\NewDocumentCommand \SemioVizPath { m O{} } { \semio_viz_path_draw:nn {#1} {#2} }
% 🔠 Text-carrying mark: kind, keys, a millimetre point, and the content as its own argument.
\NewDocumentCommand \SemioVizText { m O{} m m } { \semio_viz_text_draw:nnnn {#1}{#2}{#3}{#4} }
%endregion 🔖️PublicApi

%region 🔖️MarkFamilies
% 🏷️ The seven renderers behind taxonomy section 0. Every one of them reads its
% bound table -- the marks sit where the data puts them -- and every variant of a
% family draws different geometry, which is what the distinctness test checks.
% Registration waits for the document because the family registry is loaded after
% the kernel; the loader order is fixed and nobody edits it.
%region 🔖️Keys
%   variant (tl, per family)   the section 0 slug this preset renders
%   data (tl, demo)            the table the family reads
%   x (tl, t) / y (tl, val)    the columns bound to the horizontal and vertical channel
%   every other key            forwarded to `semio / viz / mark`
\tl_new:N \l_semio_viz_fam_variant_tl
\tl_new:N \l_semio_viz_fam_data_tl
\tl_new:N \l_semio_viz_fam_x_tl
\tl_new:N \l_semio_viz_fam_y_tl
\fp_new:N \l_semio_viz_fam_w_fp
\fp_new:N \l_semio_viz_fam_h_fp
\fp_new:N \l_semio_viz_fam_pad_fp
\int_new:N \l_semio_viz_fam_rows_int
\fp_new:N \l_semio_viz_fam_xmin_fp \fp_new:N \l_semio_viz_fam_xmax_fp
\fp_new:N \l_semio_viz_fam_ymin_fp \fp_new:N \l_semio_viz_fam_ymax_fp
\tl_new:N \l_semio_viz_fam_cell_tl
\tl_new:N \l_semio_viz_fam_points_tl
\tl_new:N \l_semio_viz_fam_lower_tl

% 🔑 The mark-family keys, `semio / viz / family / mark`; every key the family does not name is
% forwarded to `semio / viz / mark`, so a catalogue entry can set any mark option.
\keys_define:nn { semio / viz / family / mark } {
  variant .tl_set:N = \l_semio_viz_fam_variant_tl,
  data    .tl_set:N = \l_semio_viz_fam_data_tl,
  x       .tl_set:N = \l_semio_viz_fam_x_tl,
  y       .tl_set:N = \l_semio_viz_fam_y_tl,
  unknown .code:n   = { \exp_args:Nnx \keys_set:nn { semio / viz / mark }
                         { \l_keys_key_str = { \exp_not:n {#1} } } },
}
%endregion 🔖️Keys

% 🚦 Opens a mark family run for variant #1 under the option list #2. The list is read twice on
% purpose: once for the variant, then again after the variant's own mark defaults, so an explicit
% option in a catalogue entry always wins over the default the variant brings with it.
\cs_new_protected:Npn \semio_viz_fam_begin:nn #1#2 {
  \semio_viz_mark_keys_reset:
  \tl_set:Nn \l_semio_viz_fam_variant_tl {#1}
  \tl_set:Nn \l_semio_viz_fam_data_tl { demo }
  \tl_set:Nn \l_semio_viz_fam_x_tl { t }
  \tl_set:Nn \l_semio_viz_fam_y_tl { val }
  \fp_set:Nn \l_semio_viz_fam_w_fp { 80 }
  \fp_set:Nn \l_semio_viz_fam_h_fp { 40 }
  \fp_set:Nn \l_semio_viz_fam_pad_fp { 6 }
  \keys_set:nn { semio / viz / family / mark } {#2}
  \exp_args:NV \semio_viz_mark_defaults:n \l_semio_viz_fam_variant_tl
  \keys_set:nn { semio / viz / family / mark } {#2}
  \semio_viz_fam_scan:
}

% 📊 Reads the bound table once: the row count, both column ranges, and the mapped point list.
\cs_generate_variant:Nn \semio_viz_mark_draw:nnn { Vxx }
\cs_generate_variant:Nn \semio_viz_path_draw:nn { Vx }
\seq_new:N \l_semio_viz_fam_vy_seq
\fp_new:N \l_semio_viz_fam_vx_fp \fp_new:N \l_semio_viz_fam_vy_fp
\cs_new_protected:Npn \semio_viz_fam_scan: {
  \semio_viz_table_nrows:VN \l_semio_viz_fam_data_tl \l_semio_viz_fam_rows_int
  \semio_viz_table_col_min:VVN \l_semio_viz_fam_data_tl \l_semio_viz_fam_x_tl \l_semio_viz_fam_xmin_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_fam_data_tl \l_semio_viz_fam_x_tl \l_semio_viz_fam_xmax_fp
  \semio_viz_table_col_min:VVN \l_semio_viz_fam_data_tl \l_semio_viz_fam_y_tl \l_semio_viz_fam_ymin_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_fam_data_tl \l_semio_viz_fam_y_tl \l_semio_viz_fam_ymax_fp
  \tl_clear:N \l_semio_viz_fam_points_tl
  \tl_clear:N \l_semio_viz_fam_lower_tl
  \seq_clear:N \l_semio_viz_fam_vy_seq
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_fam_rows_int } {
    \semio_viz_table_cell:VnVN \l_semio_viz_fam_data_tl {##1} \l_semio_viz_fam_x_tl \l_semio_viz_fam_cell_tl
    \fp_set:Nn \l_semio_viz_fam_vx_fp { \l_semio_viz_fam_pad_fp
      + ( \l_semio_viz_fam_cell_tl - \l_semio_viz_fam_xmin_fp )
        / max( 1e-9 , \l_semio_viz_fam_xmax_fp - \l_semio_viz_fam_xmin_fp )
        * ( \l_semio_viz_fam_w_fp - 2 * \l_semio_viz_fam_pad_fp ) }
    \semio_viz_table_cell:VnVN \l_semio_viz_fam_data_tl {##1} \l_semio_viz_fam_y_tl \l_semio_viz_fam_cell_tl
    \seq_put_right:Nx \l_semio_viz_fam_vy_seq { \fp_to_decimal:n { \l_semio_viz_fam_cell_tl } }
    \fp_set:Nn \l_semio_viz_fam_vy_fp { \l_semio_viz_fam_pad_fp
      + ( \l_semio_viz_fam_cell_tl - \l_semio_viz_fam_ymin_fp )
        / max( 1e-9 , \l_semio_viz_fam_ymax_fp - \l_semio_viz_fam_ymin_fp )
        * ( \l_semio_viz_fam_h_fp - 2 * \l_semio_viz_fam_pad_fp ) }
    \tl_if_empty:NF \l_semio_viz_fam_points_tl {
      \tl_put_right:Nn \l_semio_viz_fam_points_tl { ; }
      \tl_put_right:Nn \l_semio_viz_fam_lower_tl { ; }
    }
    \tl_put_right:Nx \l_semio_viz_fam_points_tl
      { \fp_to_decimal:N \l_semio_viz_fam_vx_fp , \fp_to_decimal:N \l_semio_viz_fam_vy_fp }
    \tl_put_right:Nx \l_semio_viz_fam_lower_tl
      { \fp_to_decimal:N \l_semio_viz_fam_vx_fp , \fp_to_decimal:N \l_semio_viz_fam_pad_fp }
  }
  \tl_set_eq:NN \l_semio_viz_mark_points_tl \l_semio_viz_fam_points_tl
  \tl_set_eq:NN \l_semio_viz_mark_points_alt_tl \l_semio_viz_fam_lower_tl
  \semio_viz_points_load:
}
% 🔢 The y value of one row, as read in the last scan.
\cs_new:Npn \semio_viz_fam_value:n #1 { \seq_item:Nn \l_semio_viz_fam_vy_seq {#1} }

%region 🔖️Renderers
% ⚫ Point marks: one glyph per row, at the row's own place.
\cs_new_protected:Npn \semio_viz_fam_points_render: {
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_pt_n_int } {
    \semio_viz_mark_draw:Vxx \l_semio_viz_fam_variant_tl
      { points = { \exp_not:V \l_semio_viz_mark_points_tl } , \exp_not:V \l_semio_viz_fam_style_tl }
      { \semio_viz_px:n {##1} , \semio_viz_py:n {##1} }
  }
}
\tl_new:N \l_semio_viz_fam_style_tl
% 🎨 The style the family collected, replayed onto each mark it draws.
\cs_new_protected:Npn \semio_viz_fam_style: {
  \tl_set:Nx \l_semio_viz_fam_style_tl {
    size = \fp_to_decimal:N \l_semio_viz_mark_size_fp ,
    fill = \exp_not:V \l_semio_viz_mark_fill_tl ,
    stroke = \exp_not:V \l_semio_viz_mark_stroke_tl ,
    strokeWidth = { \exp_not:V \l_semio_viz_mark_width_tl } ,
    opacity = \fp_to_decimal:N \l_semio_viz_mark_opacity_fp ,
    rotate = \fp_to_decimal:N \l_semio_viz_mark_rotate_fp ,
    pattern = \exp_not:V \l_semio_viz_mark_pattern_tl ,
    curve = \exp_not:V \l_semio_viz_mark_curve_tl ,
    radius = \fp_to_decimal:N \l_semio_viz_mark_radius_fp ,
    innerRadius = \fp_to_decimal:N \l_semio_viz_mark_inner_fp ,
    outerRadius = \fp_to_decimal:N \l_semio_viz_mark_outer_fp ,
    padAngle = \fp_to_decimal:N \l_semio_viz_mark_pad_fp ,
    cornerRadius = \fp_to_decimal:N \l_semio_viz_mark_corner_fp ,
    arrow = \exp_not:V \l_semio_viz_mark_arrow_tl ,
    dash = \exp_not:V \l_semio_viz_mark_dash_tl ,
    route = \exp_not:V \l_semio_viz_mark_route_tl
  }
}

% 〰️ Path marks: one path through every row of the table.
\cs_new_protected:Npn \semio_viz_fam_path_render: {
  \semio_viz_path_draw:Vx \l_semio_viz_fam_variant_tl {
    points = { \exp_not:V \l_semio_viz_fam_points_tl } ,
    points2 = { \exp_not:V \l_semio_viz_fam_lower_tl } ,
    via = { \exp_not:V \l_semio_viz_fam_points_tl } ,
    \exp_not:V \l_semio_viz_fam_style_tl
  }
}

% 🥧 Arc marks: one wedge per row, sized by the row's value.
\cs_new_protected:Npn \semio_viz_fam_arc_render: {
  \fp_set:Nn \l_semio_viz_fam_step_fp { 2 * pi / max( 1 , \l_semio_viz_fam_rows_int ) }
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_fam_rows_int } {
    \semio_viz_mark_draw:Vxx \l_semio_viz_fam_variant_tl
      {
        startAngle = \fp_to_decimal:n { ( ##1 - 1 ) * \l_semio_viz_fam_step_fp } ,
        endAngle = \fp_to_decimal:n { ##1 * \l_semio_viz_fam_step_fp } ,
        radius = \fp_to_decimal:n { 6 + 8 * ( \semio_viz_fam_value:n {##1}
          - \l_semio_viz_fam_ymin_fp ) / max( 1e-9 , \l_semio_viz_fam_ymax_fp - \l_semio_viz_fam_ymin_fp ) } ,
        outerRadius = \fp_to_decimal:n { 6 + 8 * ( \semio_viz_fam_value:n {##1}
          - \l_semio_viz_fam_ymin_fp ) / max( 1e-9 , \l_semio_viz_fam_ymax_fp - \l_semio_viz_fam_ymin_fp ) } ,
        \exp_not:V \l_semio_viz_fam_style_tl
      }
      { \fp_to_decimal:n { \l_semio_viz_fam_w_fp / 2 } , \fp_to_decimal:n { \l_semio_viz_fam_h_fp / 2 } }
  }
}
\fp_new:N \l_semio_viz_fam_step_fp

% 💬 Annotation marks: one annotation on the row that carries the extreme value.
\cs_new_protected:Npn \semio_viz_fam_annotation_render: {
  \int_zero:N \l_semio_viz_fam_peak_int
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_fam_rows_int } {
    \fp_compare:nNnT { \semio_viz_fam_value:n {##1} } = { \l_semio_viz_fam_ymax_fp }
      { \int_compare:nNnT { \l_semio_viz_fam_peak_int } = { 0 }
          { \int_set:Nn \l_semio_viz_fam_peak_int {##1} } }
  }
  \int_compare:nNnT { \l_semio_viz_fam_peak_int } = { 0 } { \int_set:Nn \l_semio_viz_fam_peak_int { 1 } }
  \semio_viz_mark_draw:Vxx \l_semio_viz_fam_variant_tl
    {
      points = { \exp_not:V \l_semio_viz_fam_points_tl } ,
      extent = { \fp_to_decimal:N \l_semio_viz_fam_pad_fp ,
        \fp_to_decimal:n { \l_semio_viz_fam_w_fp - \l_semio_viz_fam_pad_fp } } ,
      \exp_not:V \l_semio_viz_fam_style_tl
    }
    { \semio_viz_px:n { \l_semio_viz_fam_peak_int } , \semio_viz_py:n { \l_semio_viz_fam_peak_int } }
}
\int_new:N \l_semio_viz_fam_peak_int
%endregion 🔖️Renderers

% 🏷️ Registration, deferred to the point where the family registry exists.
\cs_new_protected:Npn \semio_viz_fam_run:nnn #1#2#3 {
  \semio_viz_fam_begin:nn {#2} {#3}
  \semio_viz_fam_style:
  \str_case:nnF {#1} {
    { point }      { \semio_viz_fam_points_render: }
    { arc }        { \semio_viz_fam_arc_render: }
    { annotation } { \semio_viz_fam_annotation_render: }
  } { \semio_viz_fam_path_render: }
}

\AddToHook{begindocument}{
  \cs_if_exist:NT \semio_viz_family_define:nn {
    \semio_viz_family_define:nn { mark-point }
      { \semio_viz_fam_run:nnn { point } { dot } {#1} }
    \semio_viz_family_define:nn { mark-line }
      { \semio_viz_fam_run:nnn { path } { polyline } {#1} }
    \semio_viz_family_define:nn { mark-area }
      { \semio_viz_fam_run:nnn { path } { band } {#1} }
    \semio_viz_family_define:nn { mark-arc }
      { \semio_viz_fam_run:nnn { arc } { sector } {#1} }
    \semio_viz_family_define:nn { mark-connector }
      { \semio_viz_fam_run:nnn { path } { straight-connector } {#1} }
    \semio_viz_family_define:nn { mark-region }
      { \semio_viz_fam_run:nnn { path } { polygonal-region } {#1} }
    \semio_viz_family_define:nn { mark-annotation }
      { \semio_viz_fam_run:nnn { annotation } { label } {#1} }
  }
}
%endregion 🔖️MarkFamilies

\ExplSyntaxOff
