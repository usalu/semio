%region 🔖️CurveMonotone
% 📈 Steffen's monotone Hermite tangents, expressed as cubic Bezier control points exactly as d3 does.
\cs_new:Npn \semio_viz_c_sign:n #1 { \fp_compare:nNnTF {#1} < { 0 } { -1 } { 1 } }
% 📐 Steffen's three-point slope at the window's middle point, clamped so the curve stays monotone.
\cs_new_protected:Npn \semio_viz_c_slope_three:nn #1#2 {
  \fp_set:Nn \l_semio_viz_c_ha_fp { \l_semio_viz_c_xb_fp - \l_semio_viz_c_xa_fp }
  \fp_set:Nn \l_semio_viz_c_hb_fp { (#1) - \l_semio_viz_c_xb_fp }
  \fp_set:Nn \l_semio_viz_c_sa_fp { ( \l_semio_viz_c_yb_fp - \l_semio_viz_c_ya_fp ) /
    \fp_compare:nNnTF { \l_semio_viz_c_ha_fp } = { 0 }
      { \fp_compare:nNnTF { \l_semio_viz_c_hb_fp } < { 0 } { -0 } { 0 } } { \l_semio_viz_c_ha_fp } }
  \fp_set:Nn \l_semio_viz_c_sb_fp { ( (#2) - \l_semio_viz_c_yb_fp ) /
    \fp_compare:nNnTF { \l_semio_viz_c_hb_fp } = { 0 }
      { \fp_compare:nNnTF { \l_semio_viz_c_ha_fp } < { 0 } { -0 } { 0 } } { \l_semio_viz_c_hb_fp } }
  \fp_set:Nn \l_semio_viz_c_p_fp { ( \l_semio_viz_c_sa_fp * \l_semio_viz_c_hb_fp
    + \l_semio_viz_c_sb_fp * \l_semio_viz_c_ha_fp ) / ( \l_semio_viz_c_ha_fp + \l_semio_viz_c_hb_fp ) }
  \fp_set:Nn \l_semio_viz_c_slope_fp { ( \semio_viz_c_sign:n { \l_semio_viz_c_sa_fp }
    + \semio_viz_c_sign:n { \l_semio_viz_c_sb_fp } )
    * min( abs( \l_semio_viz_c_sa_fp ) , abs( \l_semio_viz_c_sb_fp ) , 0.5 * abs( \l_semio_viz_c_p_fp ) ) }
  \fp_compare:nNnF { \l_semio_viz_c_slope_fp } = { \l_semio_viz_c_slope_fp }
    { \fp_zero:N \l_semio_viz_c_slope_fp }
