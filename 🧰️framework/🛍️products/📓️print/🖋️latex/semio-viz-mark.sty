    { cross } { \draw [ \l_semio_viz_mark_draw_tl , line~width=\semio@stroke@default ] ( \fp_eval:n { \l_semio_viz_mx_fp - \l_semio_viz_mark_size_fp } , \fp_eval:n { \l_semio_viz_my_fp - \l_semio_viz_mark_size_fp } ) -- ( \fp_eval:n { \l_semio_viz_mx_fp + \l_semio_viz_mark_size_fp } , \fp_eval:n { \l_semio_viz_my_fp + \l_semio_viz_mark_size_fp } ) ( \fp_eval:n { \l_semio_viz_mx_fp - \l_semio_viz_mark_size_fp } , \fp_eval:n { \l_semio_viz_my_fp + \l_semio_viz_mark_size_fp } ) -- ( \fp_eval:n { \l_semio_viz_mx_fp + \l_semio_viz_mark_size_fp } , \fp_eval:n { \l_semio_viz_my_fp - \l_semio_viz_mark_size_fp } ) ; }
