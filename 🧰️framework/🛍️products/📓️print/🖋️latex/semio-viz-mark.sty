% ⚫ Draws a registered mark at a millimetre xy point.
\NewDocumentCommand \SemioVizMark { m O{} m } { \semio_viz_mark_draw:nnn {#1} {#2} {#3} }
% 〰️ Draws a registered line, area, arc, or connector demo.
\NewDocumentCommand \SemioVizPath { m O{} } { \semio_viz_mark_keys_reset: \keys_set:nn { semio / viz / mark } {#2} \semio_viz_path_demo:n {#1} }
%endregion Registry

%region TextMarks
% 🔠 Text-carrying marks: a SEPARATE command from \SemioVizMark, not a
% `text=` key on it -- l3keys splits key-value lists on commas, and German
% prose is nothing but commas ("Zusammenhang, keine Kausalität"); one missing
% brace and a value silently splits into two keys. Content is the mark's own
% trailing argument instead, never a key.
\tl_new:N \l_semio_viz_text_width_tl
\tl_new:N \l_semio_viz_text_height_tl
\tl_new:N \l_semio_viz_text_anchor_tl
\tl_new:N \l_semio_viz_text_align_tl
\tl_new:N \l_semio_viz_text_style_tl
\tl_new:N \l_semio_viz_text_font_tl

\seq_new:N \g_semio_viz_text_kinds_seq
\clist_map_inline:nn { cell, module, chip, label, title, value }
  { \seq_gput_right:Nn \g_semio_viz_text_kinds_seq {#1} }

\cs_new_protected:Npn \semio_viz_text_keys_reset:n #1 { % kind -> its own defaults
  \tl_clear:N \l_semio_viz_text_width_tl
  \tl_clear:N \l_semio_viz_text_height_tl
  \tl_set:Nn \l_semio_viz_text_anchor_tl { north~west }
  \tl_set:Nn \l_semio_viz_text_align_tl { left }
  \tl_set:Nn \l_semio_viz_text_font_tl { \semio@viz@font@label }
  \tl_clear:N \l_semio_viz_text_style_tl
  \str_case:nn {#1} {
    { cell }   { \tl_set:Nn \l_semio_viz_text_style_tl { semio~viz~cell } \tl_set:Nn \l_semio_viz_text_anchor_tl { center } \tl_set:Nn \l_semio_viz_text_align_tl { center } \tl_clear:N \l_semio_viz_text_font_tl }
    { module } { \tl_set:Nn \l_semio_viz_text_style_tl { semio~viz~module } \tl_set:Nn \l_semio_viz_text_anchor_tl { center } \tl_set:Nn \l_semio_viz_text_align_tl { center } \tl_clear:N \l_semio_viz_text_font_tl }
    { chip }   { \tl_set:Nn \l_semio_viz_text_style_tl { semio~viz~chip } \tl_set:Nn \l_semio_viz_text_anchor_tl { center } \tl_clear:N \l_semio_viz_text_font_tl }
    { title }  { \tl_set:Nn \l_semio_viz_text_font_tl { \semio@viz@font@title } }
    { value }  { \tl_set:Nn \l_semio_viz_text_font_tl { \semio@viz@font@value } \tl_set:Nn \l_semio_viz_text_anchor_tl { east } }
  } { }
}

\keys_define:nn { semio / viz / text } {
  width  .tl_set:N = \l_semio_viz_text_width_tl,
  height .tl_set:N = \l_semio_viz_text_height_tl,
  anchor .tl_set:N = \l_semio_viz_text_anchor_tl,
  align  .tl_set:N = \l_semio_viz_text_align_tl,
  style  .tl_set:N = \l_semio_viz_text_style_tl,
  font   .tl_set:N = \l_semio_viz_text_font_tl,
}

\tl_new:N \l_semio_viz_text_opts_tl
\cs_new_protected:Npn \semio_viz_text_node:nn #1#2 {
  \node [#1] at ( \fp_eval:n { \l_semio_viz_mx_fp } , \fp_eval:n { \l_semio_viz_my_fp } ) {#2} ;
}
\cs_new_protected:Npn \semio_viz_text_draw:nnnn #1#2#3#4 { % kind, keys, xy, content
  \semio_viz_frame_require:n { SemioVizText }
  \seq_if_in:NnF \g_semio_viz_text_kinds_seq {#1}
    { \msg_error:nnn { semio-viz } { unknown-text-kind } {#1} }
  \semio_viz_text_keys_reset:n {#1}
  \keys_set:nn { semio / viz / text } {#2}
  \semio_viz_xy:n {#3}
  \tl_clear:N \l_semio_viz_text_opts_tl
  \tl_if_empty:NF \l_semio_viz_text_style_tl
    { \tl_put_right:Nx \l_semio_viz_text_opts_tl { \l_semio_viz_text_style_tl , } }
  \tl_if_empty:NF \l_semio_viz_text_width_tl
    { \tl_put_right:Nx \l_semio_viz_text_opts_tl { text~width= \l_semio_viz_text_width_tl ~mm , } }
  \tl_if_empty:NF \l_semio_viz_text_height_tl
    { \tl_put_right:Nx \l_semio_viz_text_opts_tl { minimum~height= \l_semio_viz_text_height_tl ~mm , } }
  \tl_if_empty:NF \l_semio_viz_text_font_tl
    { \tl_put_right:Nx \l_semio_viz_text_opts_tl { font={ \exp_not:V \l_semio_viz_text_font_tl }, } }
  \tl_put_right:Nx \l_semio_viz_text_opts_tl {
    anchor= \l_semio_viz_text_anchor_tl ,
    align= \l_semio_viz_text_align_tl ,
    outer~sep=0pt,
  }
  \exp_args:NV \semio_viz_text_node:nn \l_semio_viz_text_opts_tl {#4}
}

% 🔠 Text-carrying mark: kind (cell/module/chip/label/title/value), keys, a
% millimetre point, and the content as its own argument -- never a key, so
% prose commas and braces pass through untouched.
\NewDocumentCommand \SemioVizText { m O{} m m } { \semio_viz_text_draw:nnnn {#1}{#2}{#3}{#4} }
%endregion TextMarks

\ExplSyntaxOff
