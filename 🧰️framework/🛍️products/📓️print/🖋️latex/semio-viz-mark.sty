    { rectangle } { \draw [ \l_semio_viz_mark_draw_tl , fill=\l_semio_viz_mark_fill_tl , line~width=\semio@stroke@hairline ] ( \fp_eval:n { \l_semio_viz_mx_fp - 2*\l_semio_viz_mark_size_fp } , \fp_eval:n { \l_semio_viz_my_fp - \l_semio_viz_mark_size_fp } ) rectangle ( \fp_eval:n { \l_semio_viz_mx_fp + 2*\l_semio_viz_mark_size_fp } , \fp_eval:n { \l_semio_viz_my_fp + \l_semio_viz_mark_size_fp } ) ; }
    { triangle } { \draw [ \l_semio_viz_mark_draw_tl , fill=\l_semio_viz_mark_fill_tl , line~width=\semio@stroke@hairline ] ( \fp_eval:n { \l_semio_viz_mx_fp } , \fp_eval:n { \l_semio_viz_my_fp + \l_semio_viz_mark_size_fp } ) -- ( \fp_eval:n { \l_semio_viz_mx_fp - \l_semio_viz_mark_size_fp } , \fp_eval:n { \l_semio_viz_my_fp - \l_semio_viz_mark_size_fp } ) -- ( \fp_eval:n { \l_semio_viz_mx_fp + \l_semio_viz_mark_size_fp } , \fp_eval:n { \l_semio_viz_my_fp - \l_semio_viz_mark_size_fp } ) -- cycle ; }
