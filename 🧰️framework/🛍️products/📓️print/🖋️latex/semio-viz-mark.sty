  \str_case:nnF {#1} {
    { dot } { \fill [ \l_semio_viz_mark_fill_tl ] ( \fp_eval:n { \l_semio_viz_mx_fp } , \fp_eval:n { \l_semio_viz_my_fp } ) circle [ radius=\fp_eval:n { \l_semio_viz_mark_size_fp } ] ; }
