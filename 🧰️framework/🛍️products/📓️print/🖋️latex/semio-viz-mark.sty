    {
      \int_case:nnF { \l_semio_viz_c_point_int } {
        { 0 } { \int_set:Nn \l_semio_viz_c_point_int { 1 } \semio_viz_c_start:nn {#1} {#2}
                \fp_set:Nn \l_semio_viz_c_tb_fp { nan } }
        { 1 } { \int_set:Nn \l_semio_viz_c_point_int { 2 } \fp_set:Nn \l_semio_viz_c_tb_fp { nan } }
        { 2 } { \int_set:Nn \l_semio_viz_c_point_int { 3 }
                \semio_viz_c_slope_three:nn {#1} {#2}
                \fp_set_eq:NN \l_semio_viz_c_tb_fp \l_semio_viz_c_slope_fp
                \semio_viz_c_mono_emit:nn { \semio_viz_c_slope_two:n { \l_semio_viz_c_tb_fp } } { \l_semio_viz_c_tb_fp } }
      } {
        \semio_viz_c_slope_three:nn {#1} {#2}
        \fp_set_eq:NN \l_semio_viz_c_tb_fp \l_semio_viz_c_slope_fp
        \semio_viz_c_mono_emit:nn { \l_semio_viz_c_ta_fp } { \l_semio_viz_c_tb_fp }
      }
      \fp_set_eq:NN \l_semio_viz_c_xa_fp \l_semio_viz_c_xb_fp
      \fp_set:Nn \l_semio_viz_c_xb_fp {#1}
      \fp_set_eq:NN \l_semio_viz_c_ya_fp \l_semio_viz_c_yb_fp
      \fp_set:Nn \l_semio_viz_c_yb_fp {#2}
      \fp_set_eq:NN \l_semio_viz_c_ta_fp \l_semio_viz_c_tb_fp
    }
}
% 🔚 `monotone-x`'s line end: the closing segment with the one-sided slope at the last point.
\cs_new_protected:Npn \semio_viz_c_monotone_x_end: {
  \int_case:nn { \l_semio_viz_c_point_int } {
    { 2 } { \semio_viz_c_line:nn { \l_semio_viz_c_xb_fp } { \l_semio_viz_c_yb_fp } }
    { 3 } { \semio_viz_c_mono_emit:nn { \l_semio_viz_c_ta_fp }
              { \semio_viz_c_slope_two:n { \l_semio_viz_c_ta_fp } } }
  }
