  }
  \str_case:nn {#1} {
    { straight-line } { \tl_set:Nn \l_semio_viz_mark_fill_tl { none } }
    { polyline }      { \tl_set:Nn \l_semio_viz_mark_fill_tl { none } }
    { step-line }     { \tl_set:Nn \l_semio_viz_mark_fill_tl { none } }
    { curved-line }   { \tl_set:Nn \l_semio_viz_mark_fill_tl { none } }
    { bezier-curve }  { \tl_set:Nn \l_semio_viz_mark_fill_tl { none } }
    { spline }        { \tl_set:Nn \l_semio_viz_mark_fill_tl { none } }
