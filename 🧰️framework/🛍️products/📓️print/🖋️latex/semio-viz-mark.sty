\fp_new:N \l_semio_viz_c_cxb_fp \fp_new:N \l_semio_viz_c_cyb_fp

% 📏 The chord length from the window's last point to (#1,#2), raised to `alpha` and to `2 alpha`.
\cs_new_protected:Npn \semio_viz_c_cr_measure:nn #1#2 {
  \int_compare:nNnF \l_semio_viz_c_point_int = { 0 } {
