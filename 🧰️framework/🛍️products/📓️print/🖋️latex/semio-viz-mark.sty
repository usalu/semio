}
% 🔁 MonotoneY is MonotoneX with the arguments and every emission mirrored, exactly d3's ReflectContext.
\cs_new_protected:Npn \semio_viz_c_monotone_y_point:nn #1#2 { \semio_viz_c_monotone_x_point:nn {#2} {#1} }
\cs_new_eq:NN \semio_viz_c_monotone_y_end: \semio_viz_c_monotone_x_end:
%endregion 🔖️CurveMonotone

%region 🔖️CurveNatural
% 🌿 `natural`: the whole line is buffered, because a natural cubic spline is a global solve.
\cs_new_protected:Npn \semio_viz_c_natural_point:nn #1#2 {
  \seq_put_right:Nx \l_semio_viz_c_bx_seq { \fp_to_decimal:n {#1} }
  \seq_put_right:Nx \l_semio_viz_c_by_seq { \fp_to_decimal:n {#2} }
}
% 🗄️ Integer-keyed fp array over a prop: the key is evaluated, so a computed index and a literal one meet.
\cs_generate_variant:Nn \prop_put:Nnn { Nxx }
\cs_generate_variant:Nn \prop_item:Nn { Ne }
\cs_new_protected:Npn \semio_viz_c_arr_put:Nnn #1#2#3 {
  \prop_put:Nxx #1 { \int_eval:n {#2} } { \fp_to_decimal:n {#3} }
}
% 🔢 Entry #2 of the property list #1, used as a zero-based numeric array.
\cs_new:Npn \semio_viz_c_arr:Nn #1#2 { \prop_item:Ne #1 { \int_eval:n {#2} } }

% 🧮 Thomas-algorithm control points of the natural cubic spline (d3's controlPoints).
\cs_new_protected:Npn \semio_viz_c_natural_cp:N #1 {
  \int_set:Nn \l_semio_viz_c_m_int { \seq_count:N #1 - 1 }
  \prop_clear:N \l_semio_viz_c_a_prop
  \prop_clear:N \l_semio_viz_c_b_prop
  \prop_clear:N \l_semio_viz_c_r_prop
  \semio_viz_c_arr_put:Nnn \l_semio_viz_c_a_prop { 0 } { 0 }
  \semio_viz_c_arr_put:Nnn \l_semio_viz_c_b_prop { 0 } { 2 }
  \semio_viz_c_arr_put:Nnn \l_semio_viz_c_r_prop { 0 }
    { \seq_item:Nn #1 { 1 } + 2 * \seq_item:Nn #1 { 2 } }
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_c_m_int - 2 } {
    \semio_viz_c_arr_put:Nnn \l_semio_viz_c_a_prop {##1} { 1 }
    \semio_viz_c_arr_put:Nnn \l_semio_viz_c_b_prop {##1} { 4 }
    \semio_viz_c_arr_put:Nnn \l_semio_viz_c_r_prop {##1}
      { 4 * \seq_item:Nn #1 { ##1 + 1 } + 2 * \seq_item:Nn #1 { ##1 + 2 } }
  }
  \semio_viz_c_arr_put:Nnn \l_semio_viz_c_a_prop { \l_semio_viz_c_m_int - 1 } { 2 }
  \semio_viz_c_arr_put:Nnn \l_semio_viz_c_b_prop { \l_semio_viz_c_m_int - 1 } { 7 }
  \semio_viz_c_arr_put:Nnn \l_semio_viz_c_r_prop { \l_semio_viz_c_m_int - 1 }
    { 8 * \seq_item:Nn #1 { \l_semio_viz_c_m_int } + \seq_item:Nn #1 { \l_semio_viz_c_m_int + 1 } }
  \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_c_m_int - 1 } {
    \fp_set:Nn \l_tmpb_fp { \semio_viz_c_arr:Nn \l_semio_viz_c_a_prop {##1}
      / \semio_viz_c_arr:Nn \l_semio_viz_c_b_prop { ##1 - 1 } }
    \semio_viz_c_arr_put:Nnn \l_semio_viz_c_b_prop {##1}
      { \semio_viz_c_arr:Nn \l_semio_viz_c_b_prop {##1} - \l_tmpb_fp }
    \semio_viz_c_arr_put:Nnn \l_semio_viz_c_r_prop {##1}
      { \semio_viz_c_arr:Nn \l_semio_viz_c_r_prop {##1}
        - \l_tmpb_fp * \semio_viz_c_arr:Nn \l_semio_viz_c_r_prop { ##1 - 1 } }
  }
  \semio_viz_c_arr_put:Nnn \l_semio_viz_c_a_prop { \l_semio_viz_c_m_int - 1 }
    { \semio_viz_c_arr:Nn \l_semio_viz_c_r_prop { \l_semio_viz_c_m_int - 1 }
      / \semio_viz_c_arr:Nn \l_semio_viz_c_b_prop { \l_semio_viz_c_m_int - 1 } }
  \int_step_inline:nnnn { \l_semio_viz_c_m_int - 2 } { -1 } { 0 } {
    \semio_viz_c_arr_put:Nnn \l_semio_viz_c_a_prop {##1}
      { ( \semio_viz_c_arr:Nn \l_semio_viz_c_r_prop {##1}
        - \semio_viz_c_arr:Nn \l_semio_viz_c_a_prop { ##1 + 1 } )
        / \semio_viz_c_arr:Nn \l_semio_viz_c_b_prop {##1} }
  }
  \semio_viz_c_arr_put:Nnn \l_semio_viz_c_b_prop { \l_semio_viz_c_m_int - 1 }
    { ( \seq_item:Nn #1 { \l_semio_viz_c_m_int + 1 }
      + \semio_viz_c_arr:Nn \l_semio_viz_c_a_prop { \l_semio_viz_c_m_int - 1 } ) / 2 }
  \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_c_m_int - 2 } {
    \semio_viz_c_arr_put:Nnn \l_semio_viz_c_b_prop {##1}
      { 2 * \seq_item:Nn #1 { ##1 + 2 }
        - \semio_viz_c_arr:Nn \l_semio_viz_c_a_prop { ##1 + 1 } }
  }
}
\prop_new:N \l_semio_viz_c_ax_prop \prop_new:N \l_semio_viz_c_bx_prop
\prop_new:N \l_semio_viz_c_ay_prop \prop_new:N \l_semio_viz_c_by_prop
% 🔚 `natural`'s line end: the tridiagonal system solved once per axis, then one cubic per interval.
\cs_new_protected:Npn \semio_viz_c_natural_end: {
  \int_set:Nn \l_semio_viz_c_n_int { \seq_count:N \l_semio_viz_c_bx_seq }
  \int_compare:nNnT { \l_semio_viz_c_n_int } > { 0 } {
    \semio_viz_c_start:nn { \seq_item:Nn \l_semio_viz_c_bx_seq { 1 } }
      { \seq_item:Nn \l_semio_viz_c_by_seq { 1 } }
    \int_compare:nNnTF { \l_semio_viz_c_n_int } = { 2 }
      { \semio_viz_c_line:nn { \seq_item:Nn \l_semio_viz_c_bx_seq { 2 } }
          { \seq_item:Nn \l_semio_viz_c_by_seq { 2 } } }
      {
        \int_compare:nNnT { \l_semio_viz_c_n_int } > { 2 } {
          \semio_viz_c_natural_cp:N \l_semio_viz_c_bx_seq
          \prop_set_eq:NN \l_semio_viz_c_ax_prop \l_semio_viz_c_a_prop
          \prop_set_eq:NN \l_semio_viz_c_bx_prop \l_semio_viz_c_b_prop
          \semio_viz_c_natural_cp:N \l_semio_viz_c_by_seq
          \prop_set_eq:NN \l_semio_viz_c_ay_prop \l_semio_viz_c_a_prop
          \prop_set_eq:NN \l_semio_viz_c_by_prop \l_semio_viz_c_b_prop
          \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_c_n_int - 2 } {
            \semio_viz_c_bez:nnnnnn
              { \semio_viz_c_arr:Nn \l_semio_viz_c_ax_prop {##1} } { \semio_viz_c_arr:Nn \l_semio_viz_c_ay_prop {##1} }
              { \semio_viz_c_arr:Nn \l_semio_viz_c_bx_prop {##1} } { \semio_viz_c_arr:Nn \l_semio_viz_c_by_prop {##1} }
              { \seq_item:Nn \l_semio_viz_c_bx_seq { ##1 + 2 } } { \seq_item:Nn \l_semio_viz_c_by_seq { ##1 + 2 } }
          }
        }
      }
  }
  \int_compare:nNnTF \l_semio_viz_c_line_int = { 1 }
    { \semio_viz_path_close: }
    {
      \int_compare:nNnT \l_semio_viz_c_line_int = { 2 }
        { \int_compare:nNnT { \l_semio_viz_c_n_int } = { 1 } { \semio_viz_path_close: } }
    }
  \int_compare:nNnF \l_semio_viz_c_line_int = { 2 }
    { \int_set:Nn \l_semio_viz_c_line_int { 1 - \l_semio_viz_c_line_int } }
}
%endregion 🔖️CurveNatural

%region 🔖️CurveBezier
% ✒️ semio's own interpolator: the point list IS the cubic Bezier control polygon
% (anchor, then triples of control, control, anchor); a trailing pair degrades to
% a quadratic and a trailing single point to a line, so no control point is ever dropped.
\cs_new_eq:NN \semio_viz_c_bezier_point:nn \semio_viz_c_natural_point:nn
% 🔚 `bezier`'s line end: the buffered points read as explicit cubic control points, three at a time.
\cs_new_protected:Npn \semio_viz_c_bezier_end: {
  \int_set:Nn \l_semio_viz_c_n_int { \seq_count:N \l_semio_viz_c_bx_seq }
  \int_compare:nNnT { \l_semio_viz_c_n_int } > { 0 } {
    \semio_viz_c_start:nn { \seq_item:Nn \l_semio_viz_c_bx_seq { 1 } }
      { \seq_item:Nn \l_semio_viz_c_by_seq { 1 } }
    \int_set:Nn \l_semio_viz_c_i_int { 2 }
    \bool_do_while:nn { \int_compare_p:nNn { \l_semio_viz_c_i_int + 2 } < { \l_semio_viz_c_n_int + 1 } } {
      \semio_viz_c_bez:nnnnnn
        { \seq_item:Nn \l_semio_viz_c_bx_seq { \l_semio_viz_c_i_int } } { \seq_item:Nn \l_semio_viz_c_by_seq { \l_semio_viz_c_i_int } }
        { \seq_item:Nn \l_semio_viz_c_bx_seq { \l_semio_viz_c_i_int + 1 } } { \seq_item:Nn \l_semio_viz_c_by_seq { \l_semio_viz_c_i_int + 1 } }
        { \seq_item:Nn \l_semio_viz_c_bx_seq { \l_semio_viz_c_i_int + 2 } } { \seq_item:Nn \l_semio_viz_c_by_seq { \l_semio_viz_c_i_int + 2 } }
      \int_add:Nn \l_semio_viz_c_i_int { 3 }
    }
    \int_compare:nNnT { \l_semio_viz_c_n_int - \l_semio_viz_c_i_int } = { 1 } {
      \semio_viz_path_quad_to:nnnn
        { \seq_item:Nn \l_semio_viz_c_bx_seq { \l_semio_viz_c_i_int } } { \seq_item:Nn \l_semio_viz_c_by_seq { \l_semio_viz_c_i_int } }
        { \seq_item:Nn \l_semio_viz_c_bx_seq { \l_semio_viz_c_i_int + 1 } } { \seq_item:Nn \l_semio_viz_c_by_seq { \l_semio_viz_c_i_int + 1 } }
    }
    \int_compare:nNnT { \l_semio_viz_c_n_int - \l_semio_viz_c_i_int } = { 0 } {
      \semio_viz_c_line:nn { \seq_item:Nn \l_semio_viz_c_bx_seq { \l_semio_viz_c_i_int } }
        { \seq_item:Nn \l_semio_viz_c_by_seq { \l_semio_viz_c_i_int } }
    }
  }
  \semio_viz_c_finish:
}
%endregion 🔖️CurveBezier
%endregion 🔖️Curves

%region 🔖️Symbols
% 🔣 d3-symbol's thirteen draw routines, transcribed constant for constant.
% `size` is an AREA, exactly as in d3, so symbols of different types read as
% equally heavy; the geometry is centred on the origin and the caller's path
% offset places it.
\fp_const:Nn \c_semio_viz_sqrt_three_fp { sqrt(3) }
\fp_const:Nn \c_semio_viz_star_ka_fp { 0.89081309152928522810 }
\fp_const:Nn \c_semio_viz_star_kr_fp { sin(pi/10) / sin(7*pi/10) }
\fp_const:Nn \c_semio_viz_star_kx_fp { sin(2*pi/10) * sin(pi/10) / sin(7*pi/10) }
\fp_const:Nn \c_semio_viz_star_ky_fp { -cos(2*pi/10) * sin(pi/10) / sin(7*pi/10) }
\fp_const:Nn \c_semio_viz_diamond_tan_fp { sqrt(1/3) }
\fp_const:Nn \c_semio_viz_wye_k_fp { 1 / sqrt(12) }
\fp_const:Nn \c_semio_viz_wye_a_fp { ( 1/sqrt(12) / 2 + 1 ) * 3 }
\fp_const:Nn \c_semio_viz_wye_s_fp { sqrt(3) / 2 }

\fp_new:N \l_semio_viz_sym_r_fp
\fp_new:N \l_semio_viz_sym_x_fp
\fp_new:N \l_semio_viz_sym_y_fp
\fp_new:N \l_semio_viz_sym_t_fp
\fp_new:N \l_semio_viz_sym_u_fp
\fp_new:N \l_semio_viz_sym_a_fp
\fp_new:N \l_semio_viz_sym_c_fp
\fp_new:N \l_semio_viz_sym_s_fp
\seq_new:N \g_semio_viz_symbol_types_seq
\clist_map_inline:nn
  { circle, cross, diamond, diamond2, plus, square, square2, star, times, triangle, triangle2, wye, asterisk }
  { \seq_gput_right:Nn \g_semio_viz_symbol_types_seq {#1} }

% 🔣 Draws symbol type #1 of area #2 into the current path buffer.
\cs_new_protected:Npn \semio_viz_symbol_draw:nn #1#2 {
  \str_case:nnF {#1} {
    { circle } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( (#2) / pi ) }
      \semio_viz_path_move_to:nn { \l_semio_viz_sym_r_fp } { 0 }
      \semio_viz_path_arc:nnnnnn { 0 } { 0 } { \l_semio_viz_sym_r_fp } { 0 } { 2*pi } { \c_false_bool }
    }
    { cross } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( (#2) / 5 ) / 2 }
      \semio_viz_path_move_to:nn { -3 * \l_semio_viz_sym_r_fp } { - \l_semio_viz_sym_r_fp }
      \clist_map_inline:nn { {-1,-1}, {-1,-3}, {1,-3}, {1,-1}, {3,-1}, {3,1}, {1,1}, {1,3}, {-1,3}, {-1,1}, {-3,1} }
        { \semio_viz_path_line_to:nn { \clist_item:nn {##1} { 1 } * \l_semio_viz_sym_r_fp }
            { \clist_item:nn {##1} { 2 } * \l_semio_viz_sym_r_fp } }
      \semio_viz_path_close:
    }
    { diamond } {
      \fp_set:Nn \l_semio_viz_sym_y_fp { sqrt( (#2) / ( 2 * \c_semio_viz_diamond_tan_fp ) ) }
      \fp_set:Nn \l_semio_viz_sym_x_fp { \l_semio_viz_sym_y_fp * \c_semio_viz_diamond_tan_fp }
      \semio_viz_path_move_to:nn { 0 } { - \l_semio_viz_sym_y_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp } { 0 }
      \semio_viz_path_line_to:nn { 0 } { \l_semio_viz_sym_y_fp }
      \semio_viz_path_line_to:nn { - \l_semio_viz_sym_x_fp } { 0 }
      \semio_viz_path_close:
    }
    { diamond2 } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt(#2) * 0.62625 }
      \semio_viz_path_move_to:nn { 0 } { - \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_r_fp } { 0 }
      \semio_viz_path_line_to:nn { 0 } { \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { - \l_semio_viz_sym_r_fp } { 0 }
      \semio_viz_path_close:
    }
    { plus } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( (#2) - min( (#2) / 7 , 2 ) ) * 0.87559 }
      \semio_viz_path_move_to:nn { - \l_semio_viz_sym_r_fp } { 0 }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_r_fp } { 0 }
      \semio_viz_path_move_to:nn { 0 } { \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { 0 } { - \l_semio_viz_sym_r_fp }
    }
    { square } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt(#2) }
      \semio_viz_path_rect:nnnn { - \l_semio_viz_sym_r_fp / 2 } { - \l_semio_viz_sym_r_fp / 2 }
        { \l_semio_viz_sym_r_fp } { \l_semio_viz_sym_r_fp }
    }
    { square2 } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt(#2) * 0.4431 }
      \semio_viz_path_move_to:nn { \l_semio_viz_sym_r_fp } { \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_r_fp } { - \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { - \l_semio_viz_sym_r_fp } { - \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { - \l_semio_viz_sym_r_fp } { \l_semio_viz_sym_r_fp }
      \semio_viz_path_close:
    }
    { star } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( (#2) * \c_semio_viz_star_ka_fp ) }
      \fp_set:Nn \l_semio_viz_sym_x_fp { \c_semio_viz_star_kx_fp * \l_semio_viz_sym_r_fp }
      \fp_set:Nn \l_semio_viz_sym_y_fp { \c_semio_viz_star_ky_fp * \l_semio_viz_sym_r_fp }
      \semio_viz_path_move_to:nn { 0 } { - \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
      \int_step_inline:nnnn { 1 } { 1 } { 4 } {
        \fp_set:Nn \l_semio_viz_sym_a_fp { 2 * pi * ##1 / 5 }
        \fp_set:Nn \l_semio_viz_sym_c_fp { cos( \l_semio_viz_sym_a_fp ) }
        \fp_set:Nn \l_semio_viz_sym_s_fp { sin( \l_semio_viz_sym_a_fp ) }
        \semio_viz_path_line_to:nn { \l_semio_viz_sym_s_fp * \l_semio_viz_sym_r_fp }
          { - \l_semio_viz_sym_c_fp * \l_semio_viz_sym_r_fp }
        \semio_viz_path_line_to:nn
          { \l_semio_viz_sym_c_fp * \l_semio_viz_sym_x_fp - \l_semio_viz_sym_s_fp * \l_semio_viz_sym_y_fp }
          { \l_semio_viz_sym_s_fp * \l_semio_viz_sym_x_fp + \l_semio_viz_sym_c_fp * \l_semio_viz_sym_y_fp }
      }
      \semio_viz_path_close:
    }
    { times } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( (#2) - min( (#2) / 6 , 1.7 ) ) * 0.6189 }
      \semio_viz_path_move_to:nn { - \l_semio_viz_sym_r_fp } { - \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_r_fp } { \l_semio_viz_sym_r_fp }
      \semio_viz_path_move_to:nn { - \l_semio_viz_sym_r_fp } { \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_r_fp } { - \l_semio_viz_sym_r_fp }
    }
    { triangle } {
      \fp_set:Nn \l_semio_viz_sym_y_fp { - sqrt( (#2) / ( \c_semio_viz_sqrt_three_fp * 3 ) ) }
      \semio_viz_path_move_to:nn { 0 } { \l_semio_viz_sym_y_fp * 2 }
      \semio_viz_path_line_to:nn { - \c_semio_viz_sqrt_three_fp * \l_semio_viz_sym_y_fp } { - \l_semio_viz_sym_y_fp }
      \semio_viz_path_line_to:nn { \c_semio_viz_sqrt_three_fp * \l_semio_viz_sym_y_fp } { - \l_semio_viz_sym_y_fp }
      \semio_viz_path_close:
    }
    { triangle2 } {
      \fp_set:Nn \l_semio_viz_sym_s_fp { sqrt(#2) * 0.6824 }
      \fp_set:Nn \l_semio_viz_sym_t_fp { \l_semio_viz_sym_s_fp / 2 }
      \fp_set:Nn \l_semio_viz_sym_u_fp { \l_semio_viz_sym_s_fp * \c_semio_viz_sqrt_three_fp / 2 }
      \semio_viz_path_move_to:nn { 0 } { - \l_semio_viz_sym_s_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_u_fp } { \l_semio_viz_sym_t_fp }
      \semio_viz_path_line_to:nn { - \l_semio_viz_sym_u_fp } { \l_semio_viz_sym_t_fp }
      \semio_viz_path_close:
    }
    { wye } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( (#2) / \c_semio_viz_wye_a_fp ) }
      \fp_set:Nn \l_semio_viz_sym_x_fp { \l_semio_viz_sym_r_fp / 2 }
      \fp_set:Nn \l_semio_viz_sym_y_fp { \l_semio_viz_sym_r_fp * \c_semio_viz_wye_k_fp }
      \fp_set:Nn \l_semio_viz_sym_t_fp { \l_semio_viz_sym_r_fp * \c_semio_viz_wye_k_fp + \l_semio_viz_sym_r_fp }
      \semio_viz_path_move_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_t_fp }
      \semio_viz_path_line_to:nn { - \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_t_fp }
      \semio_viz_wye_spoke:nnn { -0.5 } { \c_semio_viz_wye_s_fp } { a }
      \semio_viz_wye_spoke:nnn { -0.5 } { \c_semio_viz_wye_s_fp } { b }
      \semio_viz_path_close:
    }
    { asterisk } {
      \fp_set:Nn \l_semio_viz_sym_r_fp { sqrt( (#2) + min( (#2) / 28 , 0.75 ) ) * 0.59436 }
      \fp_set:Nn \l_semio_viz_sym_t_fp { \l_semio_viz_sym_r_fp / 2 }
      \fp_set:Nn \l_semio_viz_sym_u_fp { \l_semio_viz_sym_t_fp * \c_semio_viz_sqrt_three_fp }
      \semio_viz_path_move_to:nn { 0 } { \l_semio_viz_sym_r_fp }
      \semio_viz_path_line_to:nn { 0 } { - \l_semio_viz_sym_r_fp }
      \semio_viz_path_move_to:nn { - \l_semio_viz_sym_u_fp } { - \l_semio_viz_sym_t_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_u_fp } { \l_semio_viz_sym_t_fp }
      \semio_viz_path_move_to:nn { - \l_semio_viz_sym_u_fp } { \l_semio_viz_sym_t_fp }
      \semio_viz_path_line_to:nn { \l_semio_viz_sym_u_fp } { - \l_semio_viz_sym_t_fp }
    }
  } { \msg_error:nnn { semio-viz } { unknown-symbol } {#1} }
}

% ⑂ One rotated arm of the wye: d3 rotates the three arm points by ±120 degrees.
\cs_new_protected:Npn \semio_viz_wye_spoke:nnn #1#2#3 {
  \fp_set:Nn \l_semio_viz_sym_c_fp {#1}
  \fp_set:Nn \l_semio_viz_sym_s_fp { \str_if_eq:nnTF {#3} { a } { #2 } { -(#2) } }
  \semio_viz_path_line_to:nn
    { \l_semio_viz_sym_c_fp * \l_semio_viz_sym_x_fp - \l_semio_viz_sym_s_fp * \l_semio_viz_sym_y_fp }
    { \l_semio_viz_sym_s_fp * \l_semio_viz_sym_x_fp + \l_semio_viz_sym_c_fp * \l_semio_viz_sym_y_fp }
  \semio_viz_path_line_to:nn
    { \l_semio_viz_sym_c_fp * \l_semio_viz_sym_x_fp - \l_semio_viz_sym_s_fp * \l_semio_viz_sym_t_fp }
    { \l_semio_viz_sym_s_fp * \l_semio_viz_sym_x_fp + \l_semio_viz_sym_c_fp * \l_semio_viz_sym_t_fp }
  \semio_viz_path_line_to:nn
    { \l_semio_viz_sym_c_fp * ( - \l_semio_viz_sym_x_fp ) - \l_semio_viz_sym_s_fp * \l_semio_viz_sym_t_fp }
    { \l_semio_viz_sym_s_fp * ( - \l_semio_viz_sym_x_fp ) + \l_semio_viz_sym_c_fp * \l_semio_viz_sym_t_fp }
}
