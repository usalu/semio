%region 🔖️StyleVocabulary
% 🎨 The Systemkarte's cell/chip/edge/bar vocabulary, formerly a \tikzset
% block re-declared in every document preamble under \makeatletter -- moved
% here so no report redeclares it, matching semio-graph.sty / semio-tree.sty.
% Its fonts, insets and stroke weights come from semio-viz-theme.
\tikzset{
  semio~viz~cell/.style={
    draw=semio-chrome-border-normal, line~width=\semio_viz_theme_stroke:n { hairline },
    fill=semio-chrome-canvas, align=left, anchor=center,
    inner~xsep=\c_semio_viz_theme_cell_inset_x_tl, inner~ysep=\c_semio_viz_theme_cell_inset_y_tl,
    font=\c_semio_viz_theme_font_cell_tl, text=semio-chrome-text-normal,
  },
  semio~viz~module/.style={ semio~viz~cell, fill=semio-chrome-window, text=semio-chrome-foreground },
  semio~viz~chip/.style={
    draw=semio-chrome-border-normal, line~width=\semio_viz_theme_stroke:n { hairline },
    fill=semio-chrome-panel, text=semio-chrome-foreground,
    font=\c_semio_viz_theme_font_chip_tl,
    inner~xsep=\c_semio_viz_theme_chip_inset_x_tl, inner~ysep=\c_semio_viz_theme_chip_inset_y_tl,
    rounded~corners=0.2em, anchor=center,
  },
}
%endregion 🔖️StyleVocabulary

%region 🔖️PathBuffer
% 📐 An expl3 twin of d3-path's `Path`: the same commands in the same order
% with the same arguments, so a probe record is literally the token stream of
% d3's own SVG path string and the oracle only has to tokenise it. Numbers are
% recorded in d3/SVG space (y down); the TikZ fragment is transformed on the
% fly by the offset (ox,oy) and the y sign, which is what turns d3 geometry
% into a right-way-up figure without ever touching the recorded numbers.
\tl_new:N \l_semio_viz_path_cmd_tl
\tl_new:N \l_semio_viz_path_tikz_tl
\fp_new:N \l_semio_viz_path_sx_fp
\fp_new:N \l_semio_viz_path_sy_fp
\fp_new:N \l_semio_viz_path_cx_fp
\fp_new:N \l_semio_viz_path_cy_fp
\fp_new:N \l_semio_viz_path_ox_fp
\fp_new:N \l_semio_viz_path_oy_fp
\fp_new:N \l_semio_viz_path_sgn_fp
\bool_new:N \l_semio_viz_path_empty_bool

% 🔢 Fixed-point decimal rendering; never scientific, so the probe's JSON stays a plain number.
\cs_new:Npn \semio_viz_num:n #1 { \fp_to_decimal:n {#1} }
% 📐 Figure-space x of a buffer x.
\cs_new:Npn \semio_viz_path_tx:n #1 { \fp_to_decimal:n { \l_semio_viz_path_ox_fp + (#1) } }
% 📐 Figure-space y of a buffer y.
\cs_new:Npn \semio_viz_path_ty:n #1 { \fp_to_decimal:n { \l_semio_viz_path_oy_fp + \l_semio_viz_path_sgn_fp * (#1) } }
% 📐 Figure-space angle in degrees of a buffer angle in radians.
\cs_new:Npn \semio_viz_path_ta:n #1 { \fp_to_decimal:n { \l_semio_viz_path_sgn_fp * (#1) * 180 / pi } }

% 📝 Appends the token #1 to the recorded d3 path, comma-separated.
\cs_new_protected:Npn \semio_viz_path_put:n #1 {
  \tl_if_empty:NTF \l_semio_viz_path_cmd_tl
    { \tl_set:Nn \l_semio_viz_path_cmd_tl {#1} }
    { \tl_put_right:Nn \l_semio_viz_path_cmd_tl { , #1 } }
}
\cs_generate_variant:Nn \semio_viz_path_put:n { x }

% 🧹 Starts a fresh path recorded in d3 space and rendered at (#1,#2) with the y axis flipped when #3 is true.
\cs_new_protected:Npn \semio_viz_path_begin:nnn #1#2#3 {
  \tl_clear:N \l_semio_viz_path_cmd_tl
  \tl_clear:N \l_semio_viz_path_tikz_tl
  \bool_set_true:N \l_semio_viz_path_empty_bool
  \fp_set:Nn \l_semio_viz_path_ox_fp {#1}
  \fp_set:Nn \l_semio_viz_path_oy_fp {#2}
  \fp_set:Nn \l_semio_viz_path_sgn_fp { \bool_if:nTF {#3} { -1 } { 1 } }
}

% ✒️ d3-path's `moveTo`: starts a subpath at (#1,#2) in d3 space.
\cs_new_protected:Npn \semio_viz_path_move_to:nn #1#2 {
  \fp_set:Nn \l_semio_viz_path_sx_fp {#1}
  \fp_set:Nn \l_semio_viz_path_sy_fp {#2}
  \fp_set:Nn \l_semio_viz_path_cx_fp {#1}
  \fp_set:Nn \l_semio_viz_path_cy_fp {#2}
  \bool_set_false:N \l_semio_viz_path_empty_bool
  \semio_viz_path_put:x { M , \semio_viz_num:n {#1} , \semio_viz_num:n {#2} }
  \tl_put_right:Nx \l_semio_viz_path_tikz_tl
    { ~ ( \semio_viz_path_tx:n {#1} mm , \semio_viz_path_ty:n {#2} mm ) }
}

% ✒️ d3-path's `lineTo`: a straight segment to (#1,#2).
\cs_new_protected:Npn \semio_viz_path_line_to:nn #1#2 {
  \fp_set:Nn \l_semio_viz_path_cx_fp {#1}
  \fp_set:Nn \l_semio_viz_path_cy_fp {#2}
  \semio_viz_path_put:x { L , \semio_viz_num:n {#1} , \semio_viz_num:n {#2} }
  \tl_put_right:Nx \l_semio_viz_path_tikz_tl
    { ~--~ ( \semio_viz_path_tx:n {#1} mm , \semio_viz_path_ty:n {#2} mm ) }
}

% ✒️ d3-path's `bezierCurveTo`: a cubic through the controls (#1,#2) and (#3,#4) to (#5,#6).
\cs_new_protected:Npn \semio_viz_path_bezier_to:nnnnnn #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_path_cx_fp {#5}
  \fp_set:Nn \l_semio_viz_path_cy_fp {#6}
  \semio_viz_path_put:x { C , \semio_viz_num:n {#1} , \semio_viz_num:n {#2} ,
    \semio_viz_num:n {#3} , \semio_viz_num:n {#4} , \semio_viz_num:n {#5} , \semio_viz_num:n {#6} }
  \tl_put_right:Nx \l_semio_viz_path_tikz_tl
    { ~..~controls~ ( \semio_viz_path_tx:n {#1} mm , \semio_viz_path_ty:n {#2} mm )
      ~and~ ( \semio_viz_path_tx:n {#3} mm , \semio_viz_path_ty:n {#4} mm )
      ~..~ ( \semio_viz_path_tx:n {#5} mm , \semio_viz_path_ty:n {#6} mm ) }
}

% 〰️ Quadratic segment; TikZ has cubics only, so the render arm raises the degree while the record keeps d3's Q.
\cs_new_protected:Npn \semio_viz_path_quad_to:nnnn #1#2#3#4 {
  \tl_put_right:Nx \l_semio_viz_path_tikz_tl
    { ~..~controls~ ( \semio_viz_path_tx:n { \l_semio_viz_path_cx_fp + 2 * ( (#1) - \l_semio_viz_path_cx_fp ) / 3 } mm ,
        \semio_viz_path_ty:n { \l_semio_viz_path_cy_fp + 2 * ( (#2) - \l_semio_viz_path_cy_fp ) / 3 } mm )
      ~and~ ( \semio_viz_path_tx:n { (#3) + 2 * ( (#1) - (#3) ) / 3 } mm ,
        \semio_viz_path_ty:n { (#4) + 2 * ( (#2) - (#4) ) / 3 } mm )
      ~..~ ( \semio_viz_path_tx:n {#3} mm , \semio_viz_path_ty:n {#4} mm ) }
  \fp_set:Nn \l_semio_viz_path_cx_fp {#3}
  \fp_set:Nn \l_semio_viz_path_cy_fp {#4}
  \semio_viz_path_put:x { Q , \semio_viz_num:n {#1} , \semio_viz_num:n {#2} ,
    \semio_viz_num:n {#3} , \semio_viz_num:n {#4} }
}

% 🔒 d3-path's `closePath`: joins back to the subpath's start, and does nothing on an empty path.
\cs_new_protected:Npn \semio_viz_path_close: {
  \bool_if:NF \l_semio_viz_path_empty_bool {
    \fp_set_eq:NN \l_semio_viz_path_cx_fp \l_semio_viz_path_sx_fp
    \fp_set_eq:NN \l_semio_viz_path_cy_fp \l_semio_viz_path_sy_fp
    \semio_viz_path_put:n { Z }
    \tl_put_right:Nn \l_semio_viz_path_tikz_tl { ~--~cycle }
  }
}

% ▭ d3-path's rect: one move plus the horizontal/vertical shorthands, recorded letter for letter.
\cs_new_protected:Npn \semio_viz_path_rect:nnnn #1#2#3#4 {
  \fp_set:Nn \l_semio_viz_path_sx_fp {#1}
  \fp_set:Nn \l_semio_viz_path_sy_fp {#2}
  \fp_set:Nn \l_semio_viz_path_cx_fp {#1}
  \fp_set:Nn \l_semio_viz_path_cy_fp {#2}
  \bool_set_false:N \l_semio_viz_path_empty_bool
  \semio_viz_path_put:x { M , \semio_viz_num:n {#1} , \semio_viz_num:n {#2} , h , \semio_viz_num:n {#3} ,
    v , \semio_viz_num:n {#4} , h , \semio_viz_num:n { -(#3) } , Z }
  \tl_put_right:Nx \l_semio_viz_path_tikz_tl
    { ~ ( \semio_viz_path_tx:n {#1} mm , \semio_viz_path_ty:n {#2} mm )
      ~rectangle~ ( \semio_viz_path_tx:n { (#1) + (#3) } mm , \semio_viz_path_ty:n { (#2) + (#4) } mm ) }
}

% ⭕ d3-path's arc, including its implicit move/line-to and its two-arc full circle.
\cs_new_protected:Npn \semio_viz_path_arc:nnnnnn #1#2#3#4#5#6 {
  \fp_set:Nn \l_tmpa_fp { (#3) * cos(#4) }
  \fp_set:Nn \l_tmpb_fp { (#3) * sin(#4) }
  \fp_set:Nn \l_semio_viz_arc_xa_fp { (#1) + \l_tmpa_fp }
  \fp_set:Nn \l_semio_viz_arc_ya_fp { (#2) + \l_tmpb_fp }
  \fp_set:Nn \l_semio_viz_arc_cw_fp { \bool_if:nTF {#6} { 0 } { 1 } }
  \fp_set:Nn \l_semio_viz_arc_da_fp { \bool_if:nTF {#6} { (#4) - (#5) } { (#5) - (#4) } }
  \bool_if:NTF \l_semio_viz_path_empty_bool
    { \semio_viz_path_move_to:nn { \l_semio_viz_arc_xa_fp } { \l_semio_viz_arc_ya_fp } }
    {
      \fp_compare:nNnTF { abs( \l_semio_viz_path_cx_fp - \l_semio_viz_arc_xa_fp ) } > { 1e-6 }
        { \semio_viz_path_line_to:nn { \l_semio_viz_arc_xa_fp } { \l_semio_viz_arc_ya_fp } }
        {
          \fp_compare:nNnT { abs( \l_semio_viz_path_cy_fp - \l_semio_viz_arc_ya_fp ) } > { 1e-6 }
            { \semio_viz_path_line_to:nn { \l_semio_viz_arc_xa_fp } { \l_semio_viz_arc_ya_fp } }
        }
    }
  \fp_compare:nNnF {#3} = { 0 } {
    \fp_compare:nNnT { \l_semio_viz_arc_da_fp } < { 0 }
      { \fp_set:Nn \l_semio_viz_arc_da_fp
          { \l_semio_viz_arc_da_fp - 2*pi*trunc( \l_semio_viz_arc_da_fp / (2*pi) ) + 2*pi } }
    \fp_compare:nNnTF { \l_semio_viz_arc_da_fp } > { 2*pi - 1e-6 }
      { \semio_viz_path_arc_full:nnnnn {#1} {#2} {#3} { \l_tmpa_fp } { \l_tmpb_fp } }
      {
        \fp_compare:nNnT { \l_semio_viz_arc_da_fp } > { 1e-6 }
          { \semio_viz_path_arc_part:nnnn {#1} {#2} {#3} {#5} }
      }
  }
}

\fp_new:N \l_semio_viz_arc_xa_fp
\fp_new:N \l_semio_viz_arc_ya_fp
\fp_new:N \l_semio_viz_arc_cw_fp
\fp_new:N \l_semio_viz_arc_da_fp

% ⭕ A whole circle of radius #3 about (#1,#2), recorded as d3's two half-turn arcs.
\cs_new_protected:Npn \semio_viz_path_arc_full:nnnnn #1#2#3#4#5 {
  \semio_viz_path_put:x { A , \semio_viz_num:n {#3} , \semio_viz_num:n {#3} , 0 , 1 ,
    \semio_viz_num:n { \l_semio_viz_arc_cw_fp } ,
    \semio_viz_num:n { (#1) - (#4) } , \semio_viz_num:n { (#2) - (#5) } ,
    A , \semio_viz_num:n {#3} , \semio_viz_num:n {#3} , 0 , 1 ,
    \semio_viz_num:n { \l_semio_viz_arc_cw_fp } ,
    \semio_viz_num:n { \l_semio_viz_arc_xa_fp } , \semio_viz_num:n { \l_semio_viz_arc_ya_fp } }
  \tl_put_right:Nx \l_semio_viz_path_tikz_tl {
    ~circle~ [ radius= \semio_viz_num:n {#3} mm ]
    ~ ( \semio_viz_path_tx:n { \l_semio_viz_arc_xa_fp } mm , \semio_viz_path_ty:n { \l_semio_viz_arc_ya_fp } mm )
  }
}

% 🌗 A partial arc of radius #3 about (#1,#2) ending at angle #4, with d3's own large-arc flag.
\cs_new_protected:Npn \semio_viz_path_arc_part:nnnn #1#2#3#4 {
  \semio_viz_path_put:x { A , \semio_viz_num:n {#3} , \semio_viz_num:n {#3} , 0 ,
    \fp_compare:nNnTF { \l_semio_viz_arc_da_fp } < { pi } { 0 } { 1 } ,
    \semio_viz_num:n { \l_semio_viz_arc_cw_fp } ,
    \semio_viz_num:n { (#1) + (#3) * cos(#4) } , \semio_viz_num:n { (#2) + (#3) * sin(#4) } }
  \fp_set:Nn \l_tmpa_fp { \l_semio_viz_arc_da_fp }
  \fp_compare:nNnT { \l_semio_viz_arc_cw_fp } = { 0 } { \fp_set:Nn \l_tmpa_fp { - \l_semio_viz_arc_da_fp } }
  \fp_set:Nn \l_semio_viz_path_cx_fp { (#1) + (#3) * cos(#4) }
  \fp_set:Nn \l_semio_viz_path_cy_fp { (#2) + (#3) * sin(#4) }
  \tl_put_right:Nx \l_semio_viz_path_tikz_tl {
    ~arc~ [ start~angle= \semio_viz_path_ta:n { atand( \l_semio_viz_arc_ya_fp - (#2) , \l_semio_viz_arc_xa_fp - (#1) ) * pi / 180 } ,
      end~angle= \semio_viz_path_ta:n { atand( \l_semio_viz_arc_ya_fp - (#2) , \l_semio_viz_arc_xa_fp - (#1) ) * pi / 180 + \l_tmpa_fp } ,
      radius= \semio_viz_num:n {#3} mm ]
  }
}

% 🥚 An SVG elliptical arc; d3-path has none, so this is the one command beyond the twin.
\cs_new_protected:Npn \semio_viz_path_ellipse_arc:nnnnnn #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_arc_xa_fp { (#1) + (#3) * cos(#5) }
  \fp_set:Nn \l_semio_viz_arc_ya_fp { (#2) + (#4) * sin(#5) }
  \bool_if:NT \l_semio_viz_path_empty_bool
    { \semio_viz_path_move_to:nn { \l_semio_viz_arc_xa_fp } { \l_semio_viz_arc_ya_fp } }
  \semio_viz_path_put:x { A , \semio_viz_num:n {#3} , \semio_viz_num:n {#4} , 0 ,
    \fp_compare:nNnTF { abs( (#6) - (#5) ) } < { pi } { 0 } { 1 } ,
    \fp_compare:nNnTF {#6} > {#5} { 1 } { 0 } ,
    \semio_viz_num:n { (#1) + (#3) * cos(#6) } , \semio_viz_num:n { (#2) + (#4) * sin(#6) } }
  \fp_set:Nn \l_semio_viz_path_cx_fp { (#1) + (#3) * cos(#6) }
  \fp_set:Nn \l_semio_viz_path_cy_fp { (#2) + (#4) * sin(#6) }
  \tl_put_right:Nx \l_semio_viz_path_tikz_tl {
    ~arc~ [ start~angle= \semio_viz_path_ta:n {#5} , end~angle= \semio_viz_path_ta:n {#6} ,
      x~radius= \semio_viz_num:n {#3} mm , y~radius= \semio_viz_num:n {#4} mm ]
  }
}
%endregion 🔖️PathBuffer


%region 🔖️Curves
% 〰️ Real d3-shape interpolators, transcribed state machine for state machine
% from d3-shape/src/curve: `lineStart`, `point`, `lineEnd` with d3's own
% `_point` counter and `_line` flag, so the emitted cubic control points are
% the numbers d3 would have written into its SVG path. `_line` is an integer:
% 0 and 1 are d3's own values, 2 stands for both `undefined` (a plain line
% generator) and `NaN` (after `areaEnd`) -- the two behave identically in every
% branch d3 tests, being falsy but not `=== 0`.
\int_new:N \l_semio_viz_c_point_int
\int_new:N \l_semio_viz_c_line_int
\fp_new:N \l_semio_viz_c_ga_fp
\fp_new:N \l_semio_viz_c_gb_fp
\int_new:N \l_semio_viz_c_n_int
\int_new:N \l_semio_viz_c_m_int
\int_new:N \l_semio_viz_c_i_int
\bool_new:N \l_semio_viz_c_reflect_bool
\fp_new:N \l_semio_viz_c_xa_fp \fp_new:N \l_semio_viz_c_ya_fp
\fp_new:N \l_semio_viz_c_xb_fp \fp_new:N \l_semio_viz_c_yb_fp
\fp_new:N \l_semio_viz_c_xc_fp \fp_new:N \l_semio_viz_c_yc_fp
\fp_new:N \l_semio_viz_c_xd_fp \fp_new:N \l_semio_viz_c_yd_fp
\fp_new:N \l_semio_viz_c_xe_fp \fp_new:N \l_semio_viz_c_ye_fp
\fp_new:N \l_semio_viz_c_xf_fp \fp_new:N \l_semio_viz_c_yf_fp
\fp_new:N \l_semio_viz_c_sx_fp \fp_new:N \l_semio_viz_c_sy_fp
\fp_new:N \l_semio_viz_c_k_fp
\fp_new:N \l_semio_viz_c_t_fp
\fp_new:N \l_semio_viz_c_alpha_fp
\fp_new:N \l_semio_viz_c_beta_fp
\fp_new:N \l_semio_viz_c_ta_fp
\fp_new:N \l_semio_viz_c_laa_fp \fp_new:N \l_semio_viz_c_lba_fp \fp_new:N \l_semio_viz_c_lca_fp
\fp_new:N \l_semio_viz_c_lab_fp \fp_new:N \l_semio_viz_c_lbb_fp \fp_new:N \l_semio_viz_c_lcb_fp
\seq_new:N \l_semio_viz_c_bx_seq
\seq_new:N \l_semio_viz_c_by_seq
\tl_new:N \l_semio_viz_c_name_tl
\prop_new:N \l_semio_viz_c_a_prop
\prop_new:N \l_semio_viz_c_b_prop
\prop_new:N \l_semio_viz_c_r_prop

\cs_new_protected:Npn \semio_viz_c_move:nn #1#2 {
  \bool_if:NTF \l_semio_viz_c_reflect_bool
    { \semio_viz_path_move_to:nn {#2} {#1} } { \semio_viz_path_move_to:nn {#1} {#2} }
}
% ✏️ `lineTo` through the interpolator's axis reflection, for the y-major curves.
\cs_new_protected:Npn \semio_viz_c_line:nn #1#2 {
  \bool_if:NTF \l_semio_viz_c_reflect_bool
    { \semio_viz_path_line_to:nn {#2} {#1} } { \semio_viz_path_line_to:nn {#1} {#2} }
}
% ✏️ `bezierCurveTo` through the same reflection.
\cs_new_protected:Npn \semio_viz_c_bez:nnnnnn #1#2#3#4#5#6 {
  \bool_if:NTF \l_semio_viz_c_reflect_bool
    { \semio_viz_path_bezier_to:nnnnnn {#2} {#1} {#4} {#3} {#6} {#5} }
    { \semio_viz_path_bezier_to:nnnnnn {#1} {#2} {#3} {#4} {#5} {#6} }
}
% ✏️ d3's `this._line ? lineTo : moveTo`.
\cs_new_protected:Npn \semio_viz_c_start:nn #1#2 {
  \int_compare:nNnTF \l_semio_viz_c_line_int = { 1 }
    { \semio_viz_c_line:nn {#1} {#2} } { \semio_viz_c_move:nn {#1} {#2} }
}
% 🔒 d3's `if (this._line || (this._line !== 0 && this._point === 1)) closePath()`, then `_line = 1 - _line`.
\cs_new_protected:Npn \semio_viz_c_finish: {
  \int_compare:nNnTF \l_semio_viz_c_line_int = { 1 }
    { \semio_viz_path_close: }
    {
      \int_compare:nNnT \l_semio_viz_c_line_int = { 2 }
        { \int_compare:nNnT \l_semio_viz_c_point_int = { 1 } { \semio_viz_path_close: } }
    }
  \int_compare:nNnF \l_semio_viz_c_line_int = { 2 }
    { \int_set:Nn \l_semio_viz_c_line_int { 1 - \l_semio_viz_c_line_int } }
}

% 🔑 The three interpolator parameters, `semio / viz / curve`: cardinal tension, Catmull-Rom
% alpha and bundle beta, each read only by the curves that define it.
\keys_define:nn { semio / viz / curve } {
  tension .fp_set:N = \l_semio_viz_c_tension_fp,
  alpha   .fp_set:N = \l_semio_viz_c_alpha_fp,
  beta    .fp_set:N = \l_semio_viz_c_beta_fp,
}

% 🎛️ Curve names: user vocabulary (hyphenated, taxonomy spelling) to internal id.
\prop_new:N \g_semio_viz_c_alias_prop
\clist_map_inline:nn {
  linear, linear-closed, step, step-before, step-after,
  basis, basis-open, basis-closed, bundle,
  cardinal, cardinal-open, cardinal-closed,
  catmull-rom, catmull-rom-open, catmull-rom-closed,
  monotone-x, monotone-y, natural, bezier
} { \prop_gput:Nnn \g_semio_viz_c_alias_prop {#1} {#1} }

% 🏷️ Internal id of the curve named #1 into #2; an unknown name is an error and falls back to linear.
\cs_new_protected:Npn \semio_viz_c_id:nN #1#2 {
  \prop_get:NnNF \g_semio_viz_c_alias_prop {#1} #2
    { \msg_error:nnn { semio-viz } { unknown-curve } {#1} \tl_set:Nn #2 { linear } }
  \tl_replace_all:Nnn #2 { - } { _ }
}

% 🧵 Opens a curve: #1 is the curve name, #2 its option list (tension, alpha, beta).
\cs_new_protected:Npn \semio_viz_curve_begin:nn #1#2 {
  \fp_set:Nn \l_semio_viz_c_tension_fp { 0 }
  \fp_set:Nn \l_semio_viz_c_alpha_fp { 0.5 }
  \fp_set:Nn \l_semio_viz_c_beta_fp { 0.85 }
  \keys_set:nn { semio / viz / curve } {#2}
  \semio_viz_c_id:nN {#1} \l_semio_viz_c_name_tl
  \fp_set:Nn \l_semio_viz_c_k_fp { ( 1 - \l_semio_viz_c_tension_fp ) / 6 }
  \bool_set_false:N \l_semio_viz_c_reflect_bool
  \int_set:Nn \l_semio_viz_c_point_int { 0 }
  \int_set:Nn \l_semio_viz_c_line_int { 2 }
  \seq_clear:N \l_semio_viz_c_bx_seq
  \seq_clear:N \l_semio_viz_c_by_seq
  \fp_zero:N \l_semio_viz_c_laa_fp \fp_zero:N \l_semio_viz_c_lba_fp \fp_zero:N \l_semio_viz_c_lca_fp
  \fp_zero:N \l_semio_viz_c_lab_fp \fp_zero:N \l_semio_viz_c_lbb_fp \fp_zero:N \l_semio_viz_c_lcb_fp
  \exp_args:NV \str_case:nnF \l_semio_viz_c_name_tl {
    { step }        { \fp_set:Nn \l_semio_viz_c_t_fp { 0.5 } }
    { step_before } { \fp_set:Nn \l_semio_viz_c_t_fp { 0 } }
    { step_after }  { \fp_set:Nn \l_semio_viz_c_t_fp { 1 } }
    { monotone_y }  { \bool_set_true:N \l_semio_viz_c_reflect_bool }
  } { }
  \fp_compare:nNnT { \l_semio_viz_c_alpha_fp } = { 0 } {
    \exp_args:NV \str_case:nnF \l_semio_viz_c_name_tl {
      { catmull_rom }        { \tl_set:Nn \l_semio_viz_c_name_tl { cardinal } }
      { catmull_rom_open }   { \tl_set:Nn \l_semio_viz_c_name_tl { cardinal_open } }
      { catmull_rom_closed } { \tl_set:Nn \l_semio_viz_c_name_tl { cardinal_closed } }
    } { }
    \fp_set:Nn \l_semio_viz_c_k_fp { 1 / 6 }
  }
  \semio_viz_curve_line_start:
}

% 🔄 d3's `lineStart`: the per-line state resets, the interpolator's own
% parameters and the area flag survive, which is what lets an area run its two
% boundaries through one and the same curve.
\cs_new_protected:Npn \semio_viz_curve_line_start: {
  \int_set:Nn \l_semio_viz_c_point_int { 0 }
  \seq_clear:N \l_semio_viz_c_bx_seq
  \seq_clear:N \l_semio_viz_c_by_seq
  \fp_zero:N \l_semio_viz_c_laa_fp \fp_zero:N \l_semio_viz_c_lba_fp \fp_zero:N \l_semio_viz_c_lca_fp
  \fp_zero:N \l_semio_viz_c_lab_fp \fp_zero:N \l_semio_viz_c_lbb_fp \fp_zero:N \l_semio_viz_c_lcb_fp
  \clist_map_inline:nn { xa, ya, xb, yb, xc, yc, xd, yd, xe, ye, xf, yf, sx, sy }
    { \fp_set:cn { l_semio_viz_c_ ##1 _fp } { nan } }
  \fp_set:Nn \l_semio_viz_c_ta_fp { nan }
}

% 🏔️ d3's `areaStart` / `areaEnd`: the flag that makes the second boundary a
% lineTo onto the first and closes the ring.
\cs_new_protected:Npn \semio_viz_curve_area_start: { \int_set:Nn \l_semio_viz_c_line_int { 0 } }
% 🏔️ The other half of that flag: the area is finished and the next line starts fresh.
\cs_new_protected:Npn \semio_viz_curve_area_end: { \int_set:Nn \l_semio_viz_c_line_int { 2 } }

% 📍 Feeds one point through the active interpolator.
\cs_new_protected:Npn \semio_viz_curve_point:nn #1#2 {
  \use:c { semio_viz_c_ \l_semio_viz_c_name_tl _point:nn } {#1} {#2}
}
% 🔚 Closes the active interpolator.
\cs_new_protected:Npn \semio_viz_curve_end: {
  \use:c { semio_viz_c_ \l_semio_viz_c_name_tl _end: }
}

%region 🔖️CurveLinear
% ➖ `linear`: the first point opens the subpath, every later one is a straight segment.
\cs_new_protected:Npn \semio_viz_c_linear_point:nn #1#2 {
  \int_compare:nNnTF \l_semio_viz_c_point_int = { 0 }
    { \int_set:Nn \l_semio_viz_c_point_int { 1 } \semio_viz_c_start:nn {#1} {#2} }
    { \int_set:Nn \l_semio_viz_c_point_int { 2 } \semio_viz_c_line:nn {#1} {#2} }
}
% 🔚 `linear`'s line end: nothing to flush, only the shared close-and-flip.
\cs_new_protected:Npn \semio_viz_c_linear_end: { \semio_viz_c_finish: }

% 🔁 `linear-closed`: the same, but every line is a ring, so the first point never becomes a `lineTo`.
\cs_new_protected:Npn \semio_viz_c_linear_closed_point:nn #1#2 {
  \int_compare:nNnTF \l_semio_viz_c_point_int = { 0 }
    { \int_set:Nn \l_semio_viz_c_point_int { 1 } \semio_viz_c_move:nn {#1} {#2} }
    { \semio_viz_c_line:nn {#1} {#2} }
}
% 🔚 `linear-closed`'s line end: the ring is closed unconditionally.
\cs_new_protected:Npn \semio_viz_c_linear_closed_end: {
  \int_compare:nNnF \l_semio_viz_c_point_int = { 0 } { \semio_viz_path_close: }
}
%endregion 🔖️CurveLinear

%region 🔖️CurveStep
% 🪜 `step`, `step-before` and `step-after`: the riser sits at the fraction `t` between the two
% points, which is what the three variants differ in.
\cs_new_protected:Npn \semio_viz_c_step_point:nn #1#2 {
  \int_compare:nNnTF \l_semio_viz_c_point_int = { 0 }
    { \int_set:Nn \l_semio_viz_c_point_int { 1 } \semio_viz_c_start:nn {#1} {#2} }
    {
      \int_set:Nn \l_semio_viz_c_point_int { 2 }
      \fp_compare:nNnTF { \l_semio_viz_c_t_fp } > { 0 }
        {
          \fp_set:Nn \l_tmpa_fp { \l_semio_viz_c_sx_fp * ( 1 - \l_semio_viz_c_t_fp ) + (#1) * \l_semio_viz_c_t_fp }
          \semio_viz_c_line:nn { \l_tmpa_fp } { \l_semio_viz_c_sy_fp }
          \semio_viz_c_line:nn { \l_tmpa_fp } {#2}
        }
        {
          \semio_viz_c_line:nn { \l_semio_viz_c_sx_fp } {#2}
          \semio_viz_c_line:nn {#1} {#2}
        }
    }
  \fp_set:Nn \l_semio_viz_c_sx_fp {#1}
  \fp_set:Nn \l_semio_viz_c_sy_fp {#2}
}
% 🔚 `step`'s line end: the last tread is flushed, and `t` is mirrored for an area's return boundary.
\cs_new_protected:Npn \semio_viz_c_step_end: {
  \fp_compare:nTF { 0 < \l_semio_viz_c_t_fp < 1 }
    { \int_compare:nNnT \l_semio_viz_c_point_int = { 2 }
        { \semio_viz_c_line:nn { \l_semio_viz_c_sx_fp } { \l_semio_viz_c_sy_fp } } }
    { }
  \semio_viz_c_finish:
  \int_compare:nNnF \l_semio_viz_c_line_int = { 2 }
    { \fp_set:Nn \l_semio_viz_c_t_fp { 1 - \l_semio_viz_c_t_fp } }
}
\cs_new_eq:cc { semio_viz_c_step_before_point:nn } { semio_viz_c_step_point:nn }
\cs_new_eq:cc { semio_viz_c_step_before_end: } { semio_viz_c_step_end: }
\cs_new_eq:cc { semio_viz_c_step_after_point:nn } { semio_viz_c_step_point:nn }
\cs_new_eq:cc { semio_viz_c_step_after_end: } { semio_viz_c_step_end: }
%endregion 🔖️CurveStep

%region 🔖️CurveBasis
% 🌀 The cubic B-spline segment over the two buffered points and the new point (#1,#2).
\cs_new_protected:Npn \semio_viz_c_basis_emit:nn #1#2 {
  \semio_viz_c_bez:nnnnnn
    { ( 2 * \l_semio_viz_c_xa_fp + \l_semio_viz_c_xb_fp ) / 3 }
    { ( 2 * \l_semio_viz_c_ya_fp + \l_semio_viz_c_yb_fp ) / 3 }
    { ( \l_semio_viz_c_xa_fp + 2 * \l_semio_viz_c_xb_fp ) / 3 }
    { ( \l_semio_viz_c_ya_fp + 2 * \l_semio_viz_c_yb_fp ) / 3 }
    { ( \l_semio_viz_c_xa_fp + 4 * \l_semio_viz_c_xb_fp + (#1) ) / 6 }
    { ( \l_semio_viz_c_ya_fp + 4 * \l_semio_viz_c_yb_fp + (#2) ) / 6 }
}
% ➡️ Slides the two-point window on by (#1,#2).
\cs_new_protected:Npn \semio_viz_c_basis_shift:nn #1#2 {
  \fp_set_eq:NN \l_semio_viz_c_xa_fp \l_semio_viz_c_xb_fp
  \fp_set_eq:NN \l_semio_viz_c_ya_fp \l_semio_viz_c_yb_fp
  \fp_set:Nn \l_semio_viz_c_xb_fp {#1}
  \fp_set:Nn \l_semio_viz_c_yb_fp {#2}
}
% 🌀 `basis`: the spline is pinned to the first point, so the opening segment is a straight run
% onto the first control point before the B-spline proper starts.
\cs_new_protected:Npn \semio_viz_c_basis_point:nn #1#2 {
  \int_case:nnF { \l_semio_viz_c_point_int } {
    { 0 } { \int_set:Nn \l_semio_viz_c_point_int { 1 } \semio_viz_c_start:nn {#1} {#2} }
    { 1 } { \int_set:Nn \l_semio_viz_c_point_int { 2 } }
    { 2 } {
      \int_set:Nn \l_semio_viz_c_point_int { 3 }
      \semio_viz_c_line:nn { ( 5 * \l_semio_viz_c_xa_fp + \l_semio_viz_c_xb_fp ) / 6 }
        { ( 5 * \l_semio_viz_c_ya_fp + \l_semio_viz_c_yb_fp ) / 6 }
      \semio_viz_c_basis_emit:nn {#1} {#2}
    }
  } { \semio_viz_c_basis_emit:nn {#1} {#2} }
  \semio_viz_c_basis_shift:nn {#1} {#2}
}
% 🔚 `basis`'s line end: the closing segment and the straight run onto the last point.
\cs_new_protected:Npn \semio_viz_c_basis_end: {
  \int_compare:nNnT \l_semio_viz_c_point_int = { 3 }
    { \semio_viz_c_basis_emit:nn { \l_semio_viz_c_xb_fp } { \l_semio_viz_c_yb_fp } }
  \int_compare:nNnT \l_semio_viz_c_point_int > { 1 }
    { \semio_viz_c_line:nn { \l_semio_viz_c_xb_fp } { \l_semio_viz_c_yb_fp } }
  \semio_viz_c_finish:
}

% 🌀 `basis-open`: the spline is not pinned, so it starts at the first control point and the two
% end points of the data are only tangents.
\cs_new_protected:Npn \semio_viz_c_basis_open_point:nn #1#2 {
  \int_case:nnF { \l_semio_viz_c_point_int } {
    { 0 } { \int_set:Nn \l_semio_viz_c_point_int { 1 } }
    { 1 } { \int_set:Nn \l_semio_viz_c_point_int { 2 } }
    { 2 } {
      \int_set:Nn \l_semio_viz_c_point_int { 3 }
      \semio_viz_c_start:nn { ( \l_semio_viz_c_xa_fp + 4 * \l_semio_viz_c_xb_fp + (#1) ) / 6 }
        { ( \l_semio_viz_c_ya_fp + 4 * \l_semio_viz_c_yb_fp + (#2) ) / 6 }
    }
    { 3 } { \int_set:Nn \l_semio_viz_c_point_int { 4 } \semio_viz_c_basis_emit:nn {#1} {#2} }
  } { \semio_viz_c_basis_emit:nn {#1} {#2} }
  \semio_viz_c_basis_shift:nn {#1} {#2}
}
% 🔚 `basis-open`'s line end: nothing is flushed, only the close-and-flip.
\cs_new_protected:Npn \semio_viz_c_basis_open_end: {
  \int_compare:nNnTF \l_semio_viz_c_line_int = { 1 }
    { \semio_viz_path_close: }
    {
      \int_compare:nNnT \l_semio_viz_c_line_int = { 2 }
        { \int_compare:nNnT \l_semio_viz_c_point_int = { 3 } { \semio_viz_path_close: } }
    }
  \int_compare:nNnF \l_semio_viz_c_line_int = { 2 }
    { \int_set:Nn \l_semio_viz_c_line_int { 1 - \l_semio_viz_c_line_int } }
}

% 🔁 `basis-closed`: the first three points are kept so the ring can be closed through them again.
\cs_new_protected:Npn \semio_viz_c_basis_closed_point:nn #1#2 {
  \int_case:nnF { \l_semio_viz_c_point_int } {
    { 0 } { \int_set:Nn \l_semio_viz_c_point_int { 1 }
            \fp_set:Nn \l_semio_viz_c_xc_fp {#1} \fp_set:Nn \l_semio_viz_c_yc_fp {#2} }
    { 1 } { \int_set:Nn \l_semio_viz_c_point_int { 2 }
            \fp_set:Nn \l_semio_viz_c_xd_fp {#1} \fp_set:Nn \l_semio_viz_c_yd_fp {#2} }
    { 2 } { \int_set:Nn \l_semio_viz_c_point_int { 3 }
            \fp_set:Nn \l_semio_viz_c_xe_fp {#1} \fp_set:Nn \l_semio_viz_c_ye_fp {#2}
            \semio_viz_c_move:nn { ( \l_semio_viz_c_xa_fp + 4 * \l_semio_viz_c_xb_fp + (#1) ) / 6 }
              { ( \l_semio_viz_c_ya_fp + 4 * \l_semio_viz_c_yb_fp + (#2) ) / 6 } }
  } { \semio_viz_c_basis_emit:nn {#1} {#2} }
  \semio_viz_c_basis_shift:nn {#1} {#2}
}
% 🔚 `basis-closed`'s line end: the three wrap-around segments back through the saved points.
\cs_new_protected:Npn \semio_viz_c_basis_closed_end: {
  \int_case:nn { \l_semio_viz_c_point_int } {
    { 1 } { \semio_viz_c_move:nn { \l_semio_viz_c_xc_fp } { \l_semio_viz_c_yc_fp } \semio_viz_path_close: }
    { 2 } {
      \semio_viz_c_move:nn { ( \l_semio_viz_c_xc_fp + 2 * \l_semio_viz_c_xd_fp ) / 3 }
        { ( \l_semio_viz_c_yc_fp + 2 * \l_semio_viz_c_yd_fp ) / 3 }
      \semio_viz_c_line:nn { ( \l_semio_viz_c_xd_fp + 2 * \l_semio_viz_c_xc_fp ) / 3 }
        { ( \l_semio_viz_c_yd_fp + 2 * \l_semio_viz_c_yc_fp ) / 3 }
      \semio_viz_path_close:
    }
    { 3 } {
      \fp_set:Nn \l_tmpa_fp { \l_semio_viz_c_xc_fp } \fp_set:Nn \l_tmpb_fp { \l_semio_viz_c_yc_fp }
      \semio_viz_c_basis_closed_point:nn { \l_tmpa_fp } { \l_tmpb_fp }
      \fp_set:Nn \l_tmpa_fp { \l_semio_viz_c_xd_fp } \fp_set:Nn \l_tmpb_fp { \l_semio_viz_c_yd_fp }
      \semio_viz_c_basis_closed_point:nn { \l_tmpa_fp } { \l_tmpb_fp }
      \fp_set:Nn \l_tmpa_fp { \l_semio_viz_c_xe_fp } \fp_set:Nn \l_tmpb_fp { \l_semio_viz_c_ye_fp }
      \semio_viz_c_basis_closed_point:nn { \l_tmpa_fp } { \l_tmpb_fp }
    }
  }
}
%endregion 🔖️CurveBasis

%region 🔖️CurveBundle
% 🎀 curveBundle(beta) buffers the whole line, straightens it towards its chord and replays it through basis.
\cs_new_protected:Npn \semio_viz_c_bundle_point:nn #1#2 {
  \seq_put_right:Nx \l_semio_viz_c_bx_seq { \fp_to_decimal:n {#1} }
  \seq_put_right:Nx \l_semio_viz_c_by_seq { \fp_to_decimal:n {#2} }
}
% 🎀 `bundle`'s line end: every buffered point is pulled `beta` of the way towards the chord from
% the first point to the last, and the straightened line is replayed through `basis`.
\cs_new_protected:Npn \semio_viz_c_bundle_end: {
  \int_set:Nn \l_tmpa_int { \seq_count:N \l_semio_viz_c_bx_seq - 1 }
  \int_compare:nNnT { \l_tmpa_int } > { 0 } {
    \fp_set:Nn \l_semio_viz_c_xa_fp { \seq_item:Nn \l_semio_viz_c_bx_seq { 1 } }
    \fp_set:Nn \l_semio_viz_c_ya_fp { \seq_item:Nn \l_semio_viz_c_by_seq { 1 } }
    \fp_set:Nn \l_semio_viz_c_xf_fp
      { \seq_item:Nn \l_semio_viz_c_bx_seq { \l_tmpa_int + 1 } - \l_semio_viz_c_xa_fp }
    \fp_set:Nn \l_semio_viz_c_yf_fp
      { \seq_item:Nn \l_semio_viz_c_by_seq { \l_tmpa_int + 1 } - \l_semio_viz_c_ya_fp }
    \seq_set_eq:NN \l_tmpa_seq \l_semio_viz_c_bx_seq
    \seq_set_eq:NN \l_tmpb_seq \l_semio_viz_c_by_seq
    \fp_set:Nn \l_semio_viz_c_xe_fp { \l_semio_viz_c_xa_fp }
    \fp_set:Nn \l_semio_viz_c_ye_fp { \l_semio_viz_c_ya_fp }
    \fp_set:Nn \l_semio_viz_c_xd_fp { \l_semio_viz_c_xf_fp }
    \fp_set:Nn \l_semio_viz_c_yd_fp { \l_semio_viz_c_yf_fp }
    \tl_set:Nn \l_semio_viz_c_name_tl { basis }
    \int_set:Nn \l_semio_viz_c_point_int { 0 }
    \int_step_inline:nnnn { 0 } { 1 } { \l_tmpa_int } {
      \fp_set:Nn \l_semio_viz_c_tt_fp { ##1 / \l_tmpa_int }
      \semio_viz_c_basis_point:nn
        { \l_semio_viz_c_beta_fp * \seq_item:Nn \l_tmpa_seq { ##1 + 1 }
          + ( 1 - \l_semio_viz_c_beta_fp ) * ( \l_semio_viz_c_xe_fp + \l_semio_viz_c_tt_fp * \l_semio_viz_c_xd_fp ) }
        { \l_semio_viz_c_beta_fp * \seq_item:Nn \l_tmpb_seq { ##1 + 1 }
          + ( 1 - \l_semio_viz_c_beta_fp ) * ( \l_semio_viz_c_ye_fp + \l_semio_viz_c_tt_fp * \l_semio_viz_c_yd_fp ) }
    }
  }
  \semio_viz_c_basis_end:
}
\fp_new:N \l_semio_viz_c_tt_fp
