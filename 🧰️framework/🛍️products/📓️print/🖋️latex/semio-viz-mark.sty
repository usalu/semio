\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-mark}[2026/08/18 v0.1.0 semio viz marks]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-tokens}

\ExplSyntaxOn

%region StyleVocabulary
% 🎨 The Systemkarte's cell/chip/edge/bar vocabulary, formerly a \tikzset
% block re-declared in every document preamble (forschungsbericht.tex,
% zwischenbericht.tex) under \makeatletter -- moved here so no report
% redeclares it, matching semio-graph.sty / semio-tree.sty. Namespaced
% `semio viz *` so it can never collide with a document's own `semio edge`
% (which historically carried plain -latex, not -{Latex}).
\providecommand{\semio@viz@cell@inset@x}{0.55em}
\providecommand{\semio@viz@cell@inset@y}{0.34em}
\providecommand{\semio@viz@chip@inset@x}{0.2em}
\providecommand{\semio@viz@chip@inset@y}{0.08em}
\providecommand{\semio@viz@guide@opacity}{0.28}
\providecommand{\semio@viz@rule@opacity}{0.55}
\providecommand{\semio@viz@font@cell}{\SemioSans\fontsize{7.2pt}{9.4pt}\selectfont}
\providecommand{\semio@viz@font@chip}{\SemioMono\fontsize{6.4pt}{7pt}\selectfont}
\providecommand{\semio@viz@font@title}{\SemioMono\fontsize{7.2pt}{8.4pt}\selectfont}
\providecommand{\semio@viz@font@label}{\SemioSans\fontsize{6.6pt}{7.6pt}\selectfont}
\providecommand{\semio@viz@font@value}{\SemioMono\fontsize{6.6pt}{7.6pt}\selectfont}

\tikzset{
  semio~viz~cell/.style={
    draw=semio-chrome-border-normal, line~width=\semio@stroke@hairline,
    fill=semio-chrome-canvas, align=left, anchor=center,
    inner~xsep=\semio@viz@cell@inset@x, inner~ysep=\semio@viz@cell@inset@y,
    font=\semio@viz@font@cell, text=semio-chrome-text-normal,
  },
  semio~viz~module/.style={ semio~viz~cell, fill=semio-chrome-window, text=semio-chrome-foreground },
  semio~viz~chip/.style={
    draw=semio-chrome-border-normal, line~width=\semio@stroke@hairline,
    fill=semio-chrome-panel, text=semio-chrome-foreground,
    font=\semio@viz@font@chip,
    inner~xsep=\semio@viz@chip@inset@x, inner~ysep=\semio@viz@chip@inset@y,
  },
  semio~viz~edge/.style={
    draw=semio-chrome-border-emphasized, line~width=\semio@stroke@hairline, -{Latex},
  },
  semio~viz~edge~analytic/.style={ semio~viz~edge, dash~pattern=on~2.25pt~off~1.5pt },
  semio~viz~bar/.style={
    draw=semio-chrome-border-normal, line~width=\semio@stroke@hairline, fill=semio-chrome-panel,
  },
  semio~viz~guide/.style={
    draw=semio-chrome-border-normal, line~width=\semio@stroke@hairline, draw~opacity=\semio@viz@guide@opacity,
  },
  semio~viz~rule/.style={
    draw=semio-chrome-border-normal, line~width=\semio@stroke@hairline, draw~opacity=\semio@viz@rule@opacity,
  },
}
%endregion StyleVocabulary

%region Diagnostics
\msg_new:nnn { semio-viz } { unknown-mark }
  { Unknown~viz~mark~'#1'. }
\msg_new:nnn { semio-viz } { outside-figure }
  { \iow_char:N\\#1~needs~an~enclosing~VizFigure. }
\msg_new:nnn { semio-viz } { unknown-text-kind }
  { Unknown~viz~text~kind~'#1'. }
%endregion Diagnostics

%region Registry
\seq_new:N \g_semio_viz_mark_kinds_seq
\bool_new:N \l_semio_viz_in_figure_bool
\fp_new:N \l_semio_viz_mx_fp
\fp_new:N \l_semio_viz_my_fp
\tl_new:N \l_semio_viz_mark_fill_tl
\tl_new:N \l_semio_viz_mark_draw_tl
\tl_new:N \l_semio_viz_points_tl
\fp_new:N \l_semio_viz_mark_size_fp

\cs_new_protected:Npn \semio_viz_mark_kind_define:n #1 {
  \seq_if_in:NnF \g_semio_viz_mark_kinds_seq {#1}
    { \seq_gput_right:Nn \g_semio_viz_mark_kinds_seq {#1} }
}

\clist_map_inline:nn {
  dot, circle, square, rectangle, triangle, diamond, cross, plus, star,
  custom-glyph, icon, icon-mark, image, image-mark, text, text-mark,
  straight-line, polyline, step-line, curved-line, bezier, bezier-curve, spline,
  catmull-rom, catmull-rom-spline, basis-spline, cardinal-spline, monotone-spline, closed-curve,
  polygon, filled-path, ribbon, band, envelope,
  circular-arc, elliptical-arc, annular-arc, sector, wedge,
  straight-connector, orthogonal-connector, curved-connector, elbow-connector,
  bundled-connector, arrow, bidirectional-arrow,
  rectangular-region, circular-region, polygonal-region, voronoi-region,
  convex-hull, concave-hull,
  label, callout, leader-line, bracket, brace, highlight-region,
  reference-line, reference-band, reference-point
} { \semio_viz_mark_kind_define:n {#1} }

\cs_new_protected:Npn \semio_viz_frame_require:n #1 {
  \bool_if:NF \l_semio_viz_in_figure_bool
    { \msg_error:nnn { semio-viz } { outside-figure } {#1} }
}

\cs_new_protected:Npn \semio_viz_mark_keys_reset: {
  \fp_set:Nn \l_semio_viz_mark_size_fp { 2.2 }
  \tl_set:Nn \l_semio_viz_mark_fill_tl { semio-primary }
  \tl_set:Nn \l_semio_viz_mark_draw_tl { semio-chrome-border-emphasized }
  \tl_set:Nn \l_semio_viz_points_tl { 8,8; 22,28; 40,12; 58,30; 72,16 }
}

\keys_define:nn { semio / viz / mark } {
  size .fp_set:N = \l_semio_viz_mark_size_fp,
  fill .tl_set:N = \l_semio_viz_mark_fill_tl,
  draw .tl_set:N = \l_semio_viz_mark_draw_tl,
  points .tl_set:N = \l_semio_viz_points_tl,
}

\cs_new_protected:Npn \semio_viz_xy:n #1 {
  \fp_set:Nn \l_semio_viz_mx_fp { \clist_item:nn {#1} { 1 } }
  \fp_set:Nn \l_semio_viz_my_fp { \clist_item:nn {#1} { 2 } }
}

\cs_new:Npn \semio_viz_polar:nn #1#2 {
  \fp_eval:n { (#2) * cosd(#1) } , \fp_eval:n { (#2) * sind(#1) }
}

\seq_new:N \l_semio_viz_points_seq
\tl_new:N \l_semio_viz_path_coords_tl

\cs_new_protected:Npn \semio_viz_points_parse: {
  \seq_clear:N \l_semio_viz_points_seq
  \exp_args:NV \semio_viz_points_parse_aux:n \l_semio_viz_points_tl
}
\cs_new_protected:Npn \semio_viz_points_parse_aux:n #1 {
  \seq_set_split:Nnn \l_semio_viz_points_seq { ; } {#1}
}

\cs_new_protected:Npn \semio_viz_points_coords: {
  \semio_viz_points_parse:
  \tl_clear:N \l_semio_viz_path_coords_tl
  \seq_map_inline:Nn \l_semio_viz_points_seq {
    \tl_set:Nn \l_tmpa_tl {##1}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_if_empty:NF \l_tmpa_tl {
      \tl_put_right:Nx \l_semio_viz_path_coords_tl { ( \clist_item:Nn \l_tmpa_tl { 1 } , \clist_item:Nn \l_tmpa_tl { 2 } ) }
    }
  }
}

\cs_new_protected:Npn \semio_viz_points_plot:n #1 {
  \semio_viz_points_coords:
  \tl_if_empty:nTF {#1} {
    \use:x { \exp_not:N \draw [ \l_semio_viz_mark_draw_tl , line~width=\semio@stroke@default ] plot coordinates { \l_semio_viz_path_coords_tl } ; }
  } {
    \use:x { \exp_not:N \draw [ \l_semio_viz_mark_draw_tl , line~width=\semio@stroke@default ] plot [ #1 ] coordinates { \l_semio_viz_path_coords_tl } ; }
  }
}

\tl_new:N \l_semio_viz_pta_tl
\tl_new:N \l_semio_viz_ptb_tl
\cs_new_protected:Npn \semio_viz_points_ends: { % first and last parsed point, for a 2-point connector
  \semio_viz_points_parse:
  \tl_set:Nx \l_semio_viz_pta_tl { \seq_item:Nn \l_semio_viz_points_seq { 1 } }
  \tl_set:Nx \l_semio_viz_ptb_tl { \seq_item:Nn \l_semio_viz_points_seq { \seq_count:N \l_semio_viz_points_seq } }
}

\cs_new_protected:Npn \semio_viz_points_step: {
  \semio_viz_points_parse:
  \tl_clear:N \l_semio_viz_path_coords_tl
  \int_zero:N \l_tmpa_int
  \seq_map_inline:Nn \l_semio_viz_points_seq {
    \tl_set:Nn \l_tmpa_tl {##1}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_if_empty:NF \l_tmpa_tl {
      \int_incr:N \l_tmpa_int
      \int_compare:nNnTF \l_tmpa_int = { 1 }
        { \tl_set:Nx \l_semio_viz_path_coords_tl { ( \clist_item:Nn \l_tmpa_tl { 1 } , \clist_item:Nn \l_tmpa_tl { 2 } ) } }
        { \tl_put_right:Nx \l_semio_viz_path_coords_tl { -| ( \clist_item:Nn \l_tmpa_tl { 1 } , \clist_item:Nn \l_tmpa_tl { 2 } ) } }
    }
  }
  \use:x { \exp_not:N \draw [ \l_semio_viz_mark_draw_tl , line~width=\semio@stroke@default ] \l_semio_viz_path_coords_tl ; }
}

\cs_new_protected:Npn \semio_viz_mark_draw:nnn #1#2#3 {
  \semio_viz_frame_require:n { SemioVizMark }
  \seq_if_in:NnF \g_semio_viz_mark_kinds_seq {#1}
    { \msg_error:nnn { semio-viz } { unknown-mark } {#1} }
  \semio_viz_mark_keys_reset:
  \keys_set:nn { semio / viz / mark } {#2}
  \semio_viz_xy:n {#3}
  \tl_set:Nn \l_tmpb_tl {#1}
  \str_case:nn {#1} {
    { icon-mark } { \tl_set:Nn \l_tmpb_tl { icon } }
    { image-mark } { \tl_set:Nn \l_tmpb_tl { image } }
    { text-mark } { \tl_set:Nn \l_tmpb_tl { text } }
    { bezier-curve } { \tl_set:Nn \l_tmpb_tl { bezier } }
    { catmull-rom-spline } { \tl_set:Nn \l_tmpb_tl { catmull-rom } }
  }
  \exp_args:NV \semio_viz_mark_draw_kind:n \l_tmpb_tl
}

