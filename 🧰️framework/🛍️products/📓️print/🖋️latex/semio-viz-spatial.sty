\fp_new:N \l_semio_viz_spatial_opt_ylo_fp
\fp_new:N \l_semio_viz_spatial_opt_xhi_fp
\fp_new:N \l_semio_viz_spatial_opt_yhi_fp
\fp_new:N \l_semio_viz_spatial_opt_radius_fp
\fp_new:N \l_semio_viz_spatial_opt_amount_fp
\fp_new:N \l_semio_viz_spatial_opt_threshold_fp
\fp_new:N \l_semio_viz_spatial_opt_bandwidth_fp
\fp_new:N \l_semio_viz_spatial_opt_cell_fp
\int_new:N \l_semio_viz_spatial_opt_w_int
\int_new:N \l_semio_viz_spatial_opt_h_int

\keys_define:nn { semio / viz / spatial / layout }
  {
