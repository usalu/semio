  {
    \fp_zero:N \l_semio_viz_spatial_opt_xlo_fp
    \fp_zero:N \l_semio_viz_spatial_opt_ylo_fp
    \fp_set:Nn \l_semio_viz_spatial_opt_xhi_fp { 100 }
    \fp_set:Nn \l_semio_viz_spatial_opt_yhi_fp { 100 }
