% 📤 Publishes the current planar result as the named point set #1, one `x,y` per item.
\cs_new_protected:Npn \semio_viz_spatial_publish_points:nN #1#2
  {
    \use:x
      {
        \exp_not:N \semio_viz_points_new:nn { \exp_not:n {#1} }
          { \seq_use:Nn #2 { ; } }
      }
  }

% 📤 Publishes ring geometry as the named collection #1, one part of kind #2 per ring.
\cs_new_protected:Npn \semio_viz_spatial_publish_rings:nnN #1#2#3
  {
    \semio_viz_geom_new:n {#1}
    \seq_map_inline:Nn #3
      { \semio_viz_geom_part:nnnn {#1} {#2} { } {##1} }
  }

% 🔺 Triangles as a ring geometry: each triangle becomes one polygon of its three vertices.
\cs_new_protected:Npn \semio_viz_spatial_publish_triangles:n #1
  {
    \semio_viz_geom_new:n {#1}
    \seq_map_inline:Nn \g_semio_viz_spatial_tri_seq
      { \semio_viz_spatial_publish_triangle:nnnn {#1} ##1 }
  }
% 🔺 One triangle of collection #1 from the vertices #2, #3, #4.
\cs_new_protected:Npn \semio_viz_spatial_publish_triangle:nnnn #1#2#3#4
  {
    \use:x
      {
        \exp_not:N \semio_viz_geom_part:nnnn { \exp_not:n {#1} } { polygon } { }
          {
            \fp_eval:n { \semio_viz_spatial_x:n {#2} } , \fp_eval:n { \semio_viz_spatial_y:n {#2} } ;
            \fp_eval:n { \semio_viz_spatial_x:n {#3} } , \fp_eval:n { \semio_viz_spatial_y:n {#3} } ;
            \fp_eval:n { \semio_viz_spatial_x:n {#4} } , \fp_eval:n { \semio_viz_spatial_y:n {#4} }
          }
      }
  }

% 🔶 Hull indices as one polygon of the named collection.
\cs_new_protected:Npn \semio_viz_spatial_publish_hull:n #1
  {
    \seq_clear:N \l_semio_viz_spatial_publish_seq
    \seq_map_inline:Nn \g_semio_viz_spatial_hull_seq
      {
        \seq_put_right:Nx \l_semio_viz_spatial_publish_seq
          {
            \fp_eval:n { \semio_viz_spatial_x:n {##1} } ,
            \fp_eval:n { \semio_viz_spatial_y:n {##1} }
          }
      }
    \semio_viz_geom_new:n {#1}
    \use:x
      {
        \exp_not:N \semio_viz_geom_part:nnnn { \exp_not:n {#1} } { polygon } { }
          { \seq_use:Nn \l_semio_viz_spatial_publish_seq { ; } }
      }
  }

% 🍯 Hexbin centres as a point set; the bin record is `{id}{cx}{cy}`.
\cs_new_protected:Npn \semio_viz_spatial_publish_bins:n #1
  {
    \seq_clear:N \l_semio_viz_spatial_publish_seq
    \seq_map_inline:Nn \g_semio_viz_spatial_bins_seq
      { \semio_viz_spatial_publish_bin:nnn ##1 }
    \semio_viz_spatial_publish_points:nN {#1} \l_semio_viz_spatial_publish_seq
  }
% 🍯 One bin centre (#2,#3) of the published point set.
\cs_new_protected:Npn \semio_viz_spatial_publish_bin:nnn #1#2#3
  { \seq_put_right:Nn \l_semio_viz_spatial_publish_seq { #2,#3 } }

% 🔷 Voronoi cells as polygons; the cell record is `{index}{x,y;…}`.
\cs_new_protected:Npn \semio_viz_spatial_publish_cells:n #1
  {
    \semio_viz_geom_new:n {#1}
    \seq_map_inline:Nn \g_semio_viz_spatial_cells_seq
      { \semio_viz_spatial_publish_cell:nnn {#1} ##1 }
  }
% 🔷 One Voronoi cell #2 of collection #1, from its vertex list #3.
\cs_new_protected:Npn \semio_viz_spatial_publish_cell:nnn #1#2#3
  { \semio_viz_geom_part:nnnn {#1} { polygon } { id = #2 } {#3} }

\seq_new:N \l_semio_viz_spatial_publish_seq

% 🔺 `delaunay`: the triangulation of a point set as a geometry collection of triangles.
\semio_viz_layout_define:nn { delaunay }
  {
    \semio_viz_spatial_layout_keys:n {#3}
    \semio_viz_spatial_delaunay:n {#1}
    \semio_viz_spatial_publish_triangles:n {#2}
  }
% 🔷 `voronoi`: the cells of a point set, clipped to the `x0`/`y0`/`x1`/`y1` rectangle.
\semio_viz_layout_define:nn { voronoi }
  {
    \semio_viz_spatial_layout_keys:n {#3}
    \semio_viz_spatial_voronoi:nnnnn {#1}
      { \fp_use:N \l_semio_viz_spatial_opt_xlo_fp } { \fp_use:N \l_semio_viz_spatial_opt_ylo_fp }
      { \fp_use:N \l_semio_viz_spatial_opt_xhi_fp } { \fp_use:N \l_semio_viz_spatial_opt_yhi_fp }
    \semio_viz_spatial_publish_cells:n {#2}
  }
% 🔶 `hull`: the convex hull of a point set as one polygon.
\semio_viz_layout_define:nn { hull }
  {
    \semio_viz_spatial_layout_keys:n {#3}
    \semio_viz_spatial_hull:n {#1}
    \semio_viz_spatial_publish_hull:n {#2}
  }
% 🍯 `hexbin`: the occupied bin centres of a point set under the `radius` lattice, as a point set.
\semio_viz_layout_define:nn { hexbin }
  {
    \semio_viz_spatial_layout_keys:n {#3}
    \semio_viz_spatial_hexbin:nn {#1} { \fp_use:N \l_semio_viz_spatial_opt_radius_fp }
    \semio_viz_spatial_publish_bins:n {#2}
  }
% 🐝 `beeswarm`: the point set spread off its axis so no two points come closer than `radius`.
\semio_viz_layout_define:nn { beeswarm }
  {
    \semio_viz_spatial_layout_keys:n {#3}
    \semio_viz_spatial_beeswarm:nn {#1} { \fp_use:N \l_semio_viz_spatial_opt_radius_fp }
    \semio_viz_spatial_publish_points:nN {#2} \g_semio_viz_spatial_swarm_seq
  }
% 🎲 `jitter`: the point set displaced deterministically by up to `amount`, so ties stop hiding.
\semio_viz_layout_define:nn { jitter }
  {
    \semio_viz_spatial_layout_keys:n {#3}
    \semio_viz_spatial_jitter:nn {#1} { \fp_use:N \l_semio_viz_spatial_opt_amount_fp }
    \semio_viz_spatial_publish_points:nN {#2} \g_semio_viz_spatial_swarm_seq
  }
% 〰️ `contour`: the isolines of a grid at `threshold`, as a geometry collection of rings.
\semio_viz_layout_define:nn { contour }
  {
    \semio_viz_spatial_layout_keys:n {#3}
    \semio_viz_spatial_contour:nn {#1} { \fp_use:N \l_semio_viz_spatial_opt_threshold_fp }
    \semio_viz_spatial_publish_rings:nnN {#2} { line } \g_semio_viz_spatial_rings_seq
  }
% 🌡️ `density`: a kernel density estimate of a point set on a `width` by `height` grid.
\semio_viz_layout_define:nn { density }
  {
    \semio_viz_spatial_layout_keys:n {#3}
    \semio_viz_spatial_density:nnnnnnn {#1}
      { \int_use:N \l_semio_viz_spatial_opt_w_int } { \int_use:N \l_semio_viz_spatial_opt_h_int }
      { \fp_use:N \l_semio_viz_spatial_opt_xlo_fp } { \fp_use:N \l_semio_viz_spatial_opt_ylo_fp }
      { \fp_use:N \l_semio_viz_spatial_opt_cell_fp }
      { \fp_use:N \l_semio_viz_spatial_opt_bandwidth_fp }
    \semio_viz_spatial_grid_alias:nn {#1} {#2}
  }

% 🔁 The density kernel writes the grid `<pointset>-density`; the dispatcher's `out` name aliases it.
\cs_new_protected:Npn \semio_viz_spatial_grid_alias:nn #1#2
  {
    \str_if_eq:eeF { #1-density } { \tl_to_str:n {#2} }
      {
        \semio_viz_grid_require:n { #1-density }
        \use:x
          {
            \exp_not:N \semio_viz_grid_new:nnnn { \exp_not:n {#2} }
              { \int_use:c { g_semio_viz_grid_ \tl_to_str:n {#1} -density _w_int } }
              { \int_use:c { g_semio_viz_grid_ \tl_to_str:n {#1} -density _h_int } }
              { \seq_use:cn { g_semio_viz_grid_ \tl_to_str:n {#1} -density _seq } { , } }
          }
      }
  }
%endregion 🔖️LayoutRegistry

%region 🔖️Quadtree
% 🌳 The spatial index the collision layouts stand on: d3-quadtree's tree, node for node. The square
% the tree covers is grown by doubling towards a point that falls outside it, exactly as d3's
% `cover` does, so two implementations reading the same points agree on the extent and not only on
% the answers. A node is empty, a leaf holding a chain of coincident points, or an internal node
% with four children; the quadrant of a point is `(y >= ym) * 2 + (x >= xm)`, d3's own numbering.
%
% Determinism: `find` walks the tree depth first, nearest quadrant first, and keeps a candidate only
% when it is *strictly* closer than the best so far, so the earliest point of a tie survives. d3
% also keeps the first it meets, but it meets them in its own traversal order, so the two agree on
% every input without two equidistant candidates — which is what the differential case measures.
%
% @see https://d3js.org/d3-quadtree
\int_new:N \g_semio_viz_qt_n_int
\int_new:N \g_semio_viz_qt_nodes_int
\int_new:N \g_semio_viz_qt_found_int
\int_new:N \l_semio_viz_qt_node_int
\int_new:N \l_semio_viz_qt_parent_int
\int_new:N \l_semio_viz_qt_quad_int
\int_new:N \l_semio_viz_qt_other_int
\int_new:N \l_semio_viz_qt_tail_int
\int_new:N \l_semio_viz_qt_kind_int
\bool_new:N \g_semio_viz_qt_covered_bool
\fp_new:N \l_semio_viz_qt_bxlo_fp
\fp_new:N \l_semio_viz_qt_bylo_fp
\fp_new:N \l_semio_viz_qt_bxhi_fp
\fp_new:N \l_semio_viz_qt_byhi_fp
\fp_new:N \g_semio_viz_qt_xlo_fp
\fp_new:N \g_semio_viz_qt_ylo_fp
\fp_new:N \g_semio_viz_qt_xhi_fp
\fp_new:N \g_semio_viz_qt_yhi_fp
\fp_new:N \g_semio_viz_qt_best_fp
\fp_new:N \l_semio_viz_qt_side_fp
\fp_new:N \l_semio_viz_qt_x_fp
\fp_new:N \l_semio_viz_qt_y_fp
\fp_new:N \l_semio_viz_qt_xm_fp
\fp_new:N \l_semio_viz_qt_ym_fp
\tl_new:N \l_semio_viz_qt_xcol_tl
\tl_new:N \l_semio_viz_qt_ycol_tl
\tl_new:N \l_semio_viz_qt_cell_tl

% 🔑 semio / viz / quadtree — which two columns of the table carry the coordinates.
% x  (column)  abscissa column, default `x`
% y  (column)  ordinate column, default `y`
\keys_define:nn { semio / viz / quadtree } {
  x .tl_set:N = \l_semio_viz_qt_xcol_tl,
  y .tl_set:N = \l_semio_viz_qt_ycol_tl,
}

% 🗄️ The indexed control sequence #1<index>#2, with the index evaluated to digits before the name
% is built: a `\the\numexpr` inside a `\csname` inside an `\edef` is exactly what the recursion
% would otherwise hand TeX, and TeX refuses it.
\cs_new:Npn \semio_viz_qt_slot:nnn #1#2#3
  { \exp_args:Nf \semio_viz_qt_slot_aux:nnn { \int_eval:n {#2} } {#1} {#3} }
% 🔗 The name half of that: with the index already digits, joins prefix, index and suffix into the cs.
\cs_new:Npn \semio_viz_qt_slot_aux:nnn #1#2#3 { \use:c { #2 #1 #3 } }

% 📐 Abscissa of the indexed point #1 of the active quadtree.
\cs_new:Npn \semio_viz_qt_x:n #1 { \semio_viz_qt_slot:nnn { g_semio_viz_qt_px_ } {#1} { _fp } }
% 📐 Ordinate of the indexed point #1 of the active quadtree.
\cs_new:Npn \semio_viz_qt_y:n #1 { \semio_viz_qt_slot:nnn { g_semio_viz_qt_py_ } {#1} { _fp } }
% 🏷️ Kind of node #1: 0 empty, 1 leaf, 2 internal.
\cs_new:Npn \semio_viz_qt_kind:n #1 { \semio_viz_qt_slot:nnn { g_semio_viz_qt_kind_ } {#1} { _int } }
% 🌿 First point of leaf #1; the rest of a coincident chain follows `next`.
\cs_new:Npn \semio_viz_qt_head:n #1 { \semio_viz_qt_slot:nnn { g_semio_viz_qt_head_ } {#1} { _int } }
% 🌿 Point after #1 in its leaf chain, 0 at the end.
\cs_new:Npn \semio_viz_qt_next:n #1 { \semio_viz_qt_slot:nnn { g_semio_viz_qt_next_ } {#1} { _int } }
% 🌲 Child #2 (0..3) of internal node #1, 0 when that quadrant is empty.
\cs_new:Npn \semio_viz_qt_child:nn #1#2
  { \exp_args:Nf \semio_viz_qt_child_aux:nn { \int_eval:n {#2} } {#1} }
% 🌲 The same in two steps: the quadrant number, already digits, becomes part of the slot prefix.
\cs_new:Npn \semio_viz_qt_child_aux:nn #1#2
  { \semio_viz_qt_slot:nnn { g_semio_viz_qt_c #1 _ } {#2} { _int } }

% 🧱 Declares one indexed control sequence of the tree, once.
\cs_new_protected:Npn \semio_viz_qt_int_new:n #1
  { \cs_if_exist:cF {#1} { \int_new:c {#1} } }
% 🧱 The same for a floating-point slot: allocated once, reused by every later tree.
\cs_new_protected:Npn \semio_viz_qt_fp_new:n #1
  { \cs_if_exist:cF {#1} { \fp_new:c {#1} } }

% 🌱 Allocates the next node and returns its index in \l_semio_viz_qt_node_int, empty to start with.
\cs_new_protected:Npn \semio_viz_qt_node_new: {
  \int_gincr:N \g_semio_viz_qt_nodes_int
  \int_set_eq:NN \l_semio_viz_qt_node_int \g_semio_viz_qt_nodes_int
  \semio_viz_qt_int_new:n { g_semio_viz_qt_kind_ \int_use:N \l_semio_viz_qt_node_int _int }
  \semio_viz_qt_int_new:n { g_semio_viz_qt_head_ \int_use:N \l_semio_viz_qt_node_int _int }
  \int_step_inline:nnn { 0 } { 3 }
    { \semio_viz_qt_int_new:n { g_semio_viz_qt_c ##1 _ \int_use:N \l_semio_viz_qt_node_int _int } }
  \int_gzero:c { g_semio_viz_qt_kind_ \int_use:N \l_semio_viz_qt_node_int _int }
  \int_gzero:c { g_semio_viz_qt_head_ \int_use:N \l_semio_viz_qt_node_int _int }
  \int_step_inline:nnn { 0 } { 3 }
    { \int_gzero:c { g_semio_viz_qt_c ##1 _ \int_use:N \l_semio_viz_qt_node_int _int } }
}

% 📏 Grows the covering square by doubling until it holds (#1, #2), d3-quadtree's `cover`.
\cs_new_protected:Npn \semio_viz_qt_cover:nn #1#2 {
  \bool_if:NTF \g_semio_viz_qt_covered_bool
    {
      \bool_do_while:nn
        {
          \fp_compare_p:n { \g_semio_viz_qt_xlo_fp > (#1) } ||
          \fp_compare_p:n { (#1) >= \g_semio_viz_qt_xhi_fp } ||
          \fp_compare_p:n { \g_semio_viz_qt_ylo_fp > (#2) } ||
          \fp_compare_p:n { (#2) >= \g_semio_viz_qt_yhi_fp }
        }
        { \semio_viz_qt_cover_step:nn {#1} {#2} }
    }
    {
      \bool_gset_true:N \g_semio_viz_qt_covered_bool
      \fp_gset:Nn \g_semio_viz_qt_xlo_fp { floor (#1) }
      \fp_gset:Nn \g_semio_viz_qt_ylo_fp { floor (#2) }
      \fp_gset:Nn \g_semio_viz_qt_xhi_fp { \g_semio_viz_qt_xlo_fp + 1 }
      \fp_gset:Nn \g_semio_viz_qt_yhi_fp { \g_semio_viz_qt_ylo_fp + 1 }
    }
}

% 📏 One doubling of the covering square towards (#1, #2).
\cs_new_protected:Npn \semio_viz_qt_cover_step:nn #1#2 {
  \fp_set:Nn \l_semio_viz_qt_side_fp
    { 2 * ( \g_semio_viz_qt_xhi_fp - \g_semio_viz_qt_xlo_fp ) }
  \int_set:Nn \l_semio_viz_qt_quad_int
    {
      \fp_compare:nNnTF {#2} < { \g_semio_viz_qt_ylo_fp } { 2 } { 0 }
      + \fp_compare:nNnTF {#1} < { \g_semio_viz_qt_xlo_fp } { 1 } { 0 }
    }
  \int_case:nn { \l_semio_viz_qt_quad_int }
    {
      { 0 }
        {
          \fp_gset:Nn \g_semio_viz_qt_xhi_fp { \g_semio_viz_qt_xlo_fp + \l_semio_viz_qt_side_fp }
          \fp_gset:Nn \g_semio_viz_qt_yhi_fp { \g_semio_viz_qt_ylo_fp + \l_semio_viz_qt_side_fp }
        }
      { 1 }
        {
          \fp_gset:Nn \g_semio_viz_qt_xlo_fp { \g_semio_viz_qt_xhi_fp - \l_semio_viz_qt_side_fp }
          \fp_gset:Nn \g_semio_viz_qt_yhi_fp { \g_semio_viz_qt_ylo_fp + \l_semio_viz_qt_side_fp }
        }
      { 2 }
        {
          \fp_gset:Nn \g_semio_viz_qt_xhi_fp { \g_semio_viz_qt_xlo_fp + \l_semio_viz_qt_side_fp }
          \fp_gset:Nn \g_semio_viz_qt_ylo_fp { \g_semio_viz_qt_yhi_fp - \l_semio_viz_qt_side_fp }
        }
      { 3 }
        {
          \fp_gset:Nn \g_semio_viz_qt_xlo_fp { \g_semio_viz_qt_xhi_fp - \l_semio_viz_qt_side_fp }
          \fp_gset:Nn \g_semio_viz_qt_ylo_fp { \g_semio_viz_qt_yhi_fp - \l_semio_viz_qt_side_fp }
        }
    }
}

% 📥 Reads the two coordinate columns of the table #1 into the indexed point arrays, recording the
% bounding box the cover is then grown from.
\cs_new_protected:Npn \semio_viz_qt_read:n #1 {
  \int_gzero:N \g_semio_viz_qt_n_int
  \fp_set:Nn \l_semio_viz_qt_bxlo_fp { inf }
  \fp_set:Nn \l_semio_viz_qt_bylo_fp { inf }
  \fp_set:Nn \l_semio_viz_qt_bxhi_fp { -inf }
  \fp_set:Nn \l_semio_viz_qt_byhi_fp { -inf }
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_spatial_i_int
  \int_step_inline:nn { \l_semio_viz_spatial_i_int } { \semio_viz_qt_read_row:nn {#1} {##1} }
}

% 📍 Stores one row of the table #1 as the next point of the tree and widens the bounding box.
\cs_new_protected:Npn \semio_viz_qt_read_row:nn #1#2 {
  \int_gincr:N \g_semio_viz_qt_n_int
  \semio_viz_qt_fp_new:n { g_semio_viz_qt_px_ \int_use:N \g_semio_viz_qt_n_int _fp }
  \semio_viz_qt_fp_new:n { g_semio_viz_qt_py_ \int_use:N \g_semio_viz_qt_n_int _fp }
  \semio_viz_qt_int_new:n { g_semio_viz_qt_next_ \int_use:N \g_semio_viz_qt_n_int _int }
  \int_gzero:c { g_semio_viz_qt_next_ \int_use:N \g_semio_viz_qt_n_int _int }
  \semio_viz_table_cell:nnVN {#1} {#2} \l_semio_viz_qt_xcol_tl \l_semio_viz_qt_cell_tl
  \fp_gset:cn { g_semio_viz_qt_px_ \int_use:N \g_semio_viz_qt_n_int _fp } { \l_semio_viz_qt_cell_tl }
  \semio_viz_table_cell:nnVN {#1} {#2} \l_semio_viz_qt_ycol_tl \l_semio_viz_qt_cell_tl
  \fp_gset:cn { g_semio_viz_qt_py_ \int_use:N \g_semio_viz_qt_n_int _fp } { \l_semio_viz_qt_cell_tl }
  \fp_set:Nn \l_semio_viz_qt_bxlo_fp
    { min ( \l_semio_viz_qt_bxlo_fp , \semio_viz_qt_x:n { \g_semio_viz_qt_n_int } ) }
  \fp_set:Nn \l_semio_viz_qt_bxhi_fp
    { max ( \l_semio_viz_qt_bxhi_fp , \semio_viz_qt_x:n { \g_semio_viz_qt_n_int } ) }
  \fp_set:Nn \l_semio_viz_qt_bylo_fp
    { min ( \l_semio_viz_qt_bylo_fp , \semio_viz_qt_y:n { \g_semio_viz_qt_n_int } ) }
  \fp_set:Nn \l_semio_viz_qt_byhi_fp
    { max ( \l_semio_viz_qt_byhi_fp , \semio_viz_qt_y:n { \g_semio_viz_qt_n_int } ) }
}

% 🧊 Calls #1 with the point index #2, the node index #3 and the box (#4,#5)-(#6,#7) frozen into
% literal numbers. Insertion recurses, and every one of those numbers would otherwise be an
% expression over the very scratch variables the recursion reassigns.
\cs_new_protected:Npn \semio_viz_qt_call:Nnnnnnn #1#2#3#4#5#6#7 {
  \use:x
    {
      \exp_not:N #1 { \int_eval:n {#2} } { \int_eval:n {#3} }
        { \fp_to_decimal:n {#4} } { \fp_to_decimal:n {#5} }
        { \fp_to_decimal:n {#6} } { \fp_to_decimal:n {#7} }
    }
}

% 🌱 Inserts point #1 into the tree, subdividing until it no longer shares a leaf with another.
\cs_new_protected:Npn \semio_viz_qt_add:n #1 {
  \semio_viz_qt_call:Nnnnnnn \semio_viz_qt_descend:nnnnnn {#1} { 1 }
    { \g_semio_viz_qt_xlo_fp } { \g_semio_viz_qt_ylo_fp }
    { \g_semio_viz_qt_xhi_fp } { \g_semio_viz_qt_yhi_fp }
}

% 🌱 Inserts point #1 under node #2 covering (#3,#4)-(#5,#6).
\cs_new_protected:Npn \semio_viz_qt_descend:nnnnnn #1#2#3#4#5#6 {
  \int_set:Nn \l_semio_viz_qt_kind_int { \semio_viz_qt_kind:n {#2} }
  \int_compare:nNnTF { \l_semio_viz_qt_kind_int } = { 0 }
    {
      \int_gset:cn { g_semio_viz_qt_kind_ \int_eval:n {#2} _int } { 1 }
      \int_gset:cn { g_semio_viz_qt_head_ \int_eval:n {#2} _int } {#1}
    }
    {
      \int_compare:nNnTF { \l_semio_viz_qt_kind_int } = { 1 }
        { \semio_viz_qt_split:nnnnnn {#1} {#2} {#3} {#4} {#5} {#6} }
        { \semio_viz_qt_into_child:nnnnnn {#1} {#2} {#3} {#4} {#5} {#6} }
    }
}

% 🌲 Sends point #1 into the quadrant of internal node #2 that holds it, creating it when empty.
\cs_new_protected:Npn \semio_viz_qt_into_child:nnnnnn #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_qt_x_fp { \semio_viz_qt_x:n {#1} }
  \fp_set:Nn \l_semio_viz_qt_y_fp { \semio_viz_qt_y:n {#1} }
  \fp_set:Nn \l_semio_viz_qt_xm_fp { ( (#3) + (#5) ) / 2 }
  \fp_set:Nn \l_semio_viz_qt_ym_fp { ( (#4) + (#6) ) / 2 }
  \int_set:Nn \l_semio_viz_qt_quad_int
    {
      \fp_compare:nNnTF { \l_semio_viz_qt_y_fp } < { \l_semio_viz_qt_ym_fp } { 0 } { 2 }
      + \fp_compare:nNnTF { \l_semio_viz_qt_x_fp } < { \l_semio_viz_qt_xm_fp } { 0 } { 1 }
    }
  \int_set:Nn \l_semio_viz_qt_other_int
    { \semio_viz_qt_child:nn {#2} { \l_semio_viz_qt_quad_int } }
  \int_compare:nNnT { \l_semio_viz_qt_other_int } = { 0 }
    {
      \int_set_eq:NN \l_semio_viz_qt_parent_int \l_semio_viz_qt_quad_int
      \semio_viz_qt_node_new:
      \int_gset:cn
        { g_semio_viz_qt_c \int_use:N \l_semio_viz_qt_parent_int _ \int_eval:n {#2} _int }
        { \l_semio_viz_qt_node_int }
      \int_set_eq:NN \l_semio_viz_qt_other_int \l_semio_viz_qt_node_int
      \int_set_eq:NN \l_semio_viz_qt_quad_int \l_semio_viz_qt_parent_int
    }
  \use:x
    {
      \exp_not:N \semio_viz_qt_quadrant:nnnnnnn
        { \int_use:N \l_semio_viz_qt_quad_int } { \int_use:N \l_semio_viz_qt_other_int }
        { \int_eval:n {#1} }
        { \fp_to_decimal:n {#3} } { \fp_to_decimal:n {#4} }
        { \fp_to_decimal:n {#5} } { \fp_to_decimal:n {#6} }
    }
}

% 🧭 Recurses into quadrant #1 (node #2) of the box (#4,#5)-(#6,#7), for point #3.
\cs_new_protected:Npn \semio_viz_qt_quadrant:nnnnnnn #1#2#3#4#5#6#7 {
  \semio_viz_qt_call:Nnnnnnn \semio_viz_qt_descend:nnnnnn {#3} {#2}
    { \int_mod:nn {#1} { 2 } ? ( ( (#4) + (#6) ) / 2 ) : (#4) }
    { \int_div_truncate:nn {#1} { 2 } ? ( ( (#5) + (#7) ) / 2 ) : (#5) }
    { \int_mod:nn {#1} { 2 } ? (#6) : ( ( (#4) + (#6) ) / 2 ) }
    { \int_div_truncate:nn {#1} { 2 } ? (#7) : ( ( (#5) + (#7) ) / 2 ) }
}

% 🍂 Point #1 met the leaf #2: either it is coincident with the leaf's points and joins the chain,
% or the leaf becomes internal and every point of the old chain descends one level further.
\cs_new_protected:Npn \semio_viz_qt_split:nnnnnn #1#2#3#4#5#6 {
  \int_set:Nn \l_semio_viz_qt_other_int { \semio_viz_qt_head:n {#2} }
  \bool_lazy_and:nnTF
    { \fp_compare_p:n { \semio_viz_qt_x:n { \l_semio_viz_qt_other_int } = \semio_viz_qt_x:n {#1} } }
    { \fp_compare_p:n { \semio_viz_qt_y:n { \l_semio_viz_qt_other_int } = \semio_viz_qt_y:n {#1} } }
    {
      \int_gset:cn { g_semio_viz_qt_next_ \int_eval:n {#1} _int } { \l_semio_viz_qt_other_int }
      \int_gset:cn { g_semio_viz_qt_head_ \int_eval:n {#2} _int } {#1}
    }
    {
      \int_gset:cn { g_semio_viz_qt_kind_ \int_eval:n {#2} _int } { 2 }
      \int_gzero:c { g_semio_viz_qt_head_ \int_eval:n {#2} _int }
      \semio_viz_qt_call:Nnnnnnn \semio_viz_qt_reinsert:nnnnnn
        { \l_semio_viz_qt_other_int } {#2} {#3} {#4} {#5} {#6}
      \semio_viz_qt_into_child:nnnnnn {#1} {#2} {#3} {#4} {#5} {#6}
    }
}

% 🍂 Puts the chain that used to sit in the split leaf back under the now internal node. The rest of
% the chain is frozen out of the point's `next` slot before anything else runs, because inserting
% the point is exactly what overwrites the scratch the tail would otherwise be read from.
\cs_new_protected:Npn \semio_viz_qt_reinsert:nnnnnn #1#2#3#4#5#6 {
  \use:x
    {
      \exp_not:N \semio_viz_qt_reinsert_tail:nnnnnnn
        { \int_eval:n { \semio_viz_qt_next:n {#1} } } { \int_eval:n {#1} }
        \exp_not:n { {#2} {#3} {#4} {#5} {#6} }
    }
}

% 🍂 Reinserts point #2 and then the tail #1 of its old chain, under node #3 in the box (#4,#5)-(#6,#7).
\cs_new_protected:Npn \semio_viz_qt_reinsert_tail:nnnnnnn #1#2#3#4#5#6#7 {
  \int_gzero:c { g_semio_viz_qt_next_ \int_eval:n {#2} _int }
  \semio_viz_qt_into_child:nnnnnn {#2} {#3} {#4} {#5} {#6} {#7}
  \int_compare:nNnT {#1} > { 0 }
    { \semio_viz_qt_reinsert:nnnnnn {#1} {#3} {#4} {#5} {#6} {#7} }
}

% 🌳 Builds the tree of the table #1 under the column options #2.
\cs_new_protected:Npn \semio_viz_qt_build:nn #1#2 {
  \tl_set:Nn \l_semio_viz_qt_xcol_tl { x }
  \tl_set:Nn \l_semio_viz_qt_ycol_tl { y }
  \keys_set:nn { semio / viz / quadtree } {#2}
  \int_gzero:N \g_semio_viz_qt_nodes_int
  \bool_gset_false:N \g_semio_viz_qt_covered_bool
  \fp_gzero:N \g_semio_viz_qt_xlo_fp
  \fp_gzero:N \g_semio_viz_qt_ylo_fp
  \fp_gzero:N \g_semio_viz_qt_xhi_fp
  \fp_gzero:N \g_semio_viz_qt_yhi_fp
  \semio_viz_qt_read:n {#1}
  \int_compare:nNnT { \g_semio_viz_qt_n_int } > { 0 }
    {
      \semio_viz_qt_cover:nn { \l_semio_viz_qt_bxlo_fp } { \l_semio_viz_qt_bylo_fp }
      \semio_viz_qt_cover:nn { \l_semio_viz_qt_bxhi_fp } { \l_semio_viz_qt_byhi_fp }
      \semio_viz_qt_node_new:
      \int_step_inline:nn { \g_semio_viz_qt_n_int } { \semio_viz_qt_add:n {##1} }
    }
  \semio_viz_probe_geometry:nx { quadtree/extent }
    {
      \fp_to_decimal:N \g_semio_viz_qt_xlo_fp , \fp_to_decimal:N \g_semio_viz_qt_ylo_fp ,
      \fp_to_decimal:N \g_semio_viz_qt_xhi_fp , \fp_to_decimal:N \g_semio_viz_qt_yhi_fp
    }
  \semio_viz_probe_geometry:nx { quadtree/size }
    { \int_use:N \g_semio_viz_qt_n_int , \int_use:N \g_semio_viz_qt_nodes_int }
}

% 🔎 The nearest point to (#1, #2) within #3, as its 1-based row index; 0 when the tree holds none.
\cs_new_protected:Npn \semio_viz_qt_find:nnn #1#2#3 {
  \int_gzero:N \g_semio_viz_qt_found_int
  \fp_gset:Nn \g_semio_viz_qt_best_fp { (#3) * (#3) }
  \int_compare:nNnT { \g_semio_viz_qt_nodes_int } > { 0 }
    {
      \semio_viz_qt_visit:nnnnnnn { 1 } {#1} {#2}
        { \g_semio_viz_qt_xlo_fp } { \g_semio_viz_qt_ylo_fp }
        { \g_semio_viz_qt_xhi_fp } { \g_semio_viz_qt_yhi_fp }
    }
}

% 🔎 Visits node #1 covering (#4,#5)-(#6,#7) while it can still hold something closer to (#2,#3)
% than the best candidate so far; a leaf offers its chain, an internal node its four quadrants with
% the one holding the query point first.
\cs_new_protected:Npn \semio_viz_qt_visit:nnnnnnn #1#2#3#4#5#6#7 {
  \bool_lazy_any:nF
    {
      { \int_compare_p:n { (#1) = 0 } }
      { \fp_compare_p:n { \semio_viz_qt_gap:nnn {#2} {#4} {#6} ^ 2 + \semio_viz_qt_gap:nnn {#3} {#5} {#7} ^ 2 > \g_semio_viz_qt_best_fp } }
    }
    {
      \int_set:Nn \l_semio_viz_qt_kind_int { \semio_viz_qt_kind:n {#1} }
      \int_compare:nNnTF { \l_semio_viz_qt_kind_int } = { 1 }
        { \semio_viz_qt_offer:nnn { \semio_viz_qt_head:n {#1} } {#2} {#3} }
        { \semio_viz_qt_visit_children:nnnnnnn {#1} {#2} {#3} {#4} {#5} {#6} {#7} }
    }
}

% 📐 How far #1 lies outside the interval (#2, #3); zero when it lies inside.
\cs_new:Npn \semio_viz_qt_gap:nnn #1#2#3
  { max ( 0 , (#2) - (#1) , (#1) - (#3) ) }

% 🔎 Visits the four quadrants of internal node #1, nearest first. The preferred quadrant is frozen
% into a literal before the first descent, because the descent reassigns the scratch it is held in.
\cs_new_protected:Npn \semio_viz_qt_visit_children:nnnnnnn #1#2#3#4#5#6#7 {
  \int_set:Nn \l_semio_viz_qt_quad_int
    {
      \fp_compare:nNnTF {#3} < { ( (#5) + (#7) ) / 2 } { 0 } { 2 }
      + \fp_compare:nNnTF {#2} < { ( (#4) + (#6) ) / 2 } { 0 } { 1 }
    }
  \use:x
    {
      \exp_not:N \semio_viz_qt_visit_order:nnnnnnnn
        { \int_use:N \l_semio_viz_qt_quad_int }
        \exp_not:n { {#1} {#2} {#3} {#4} {#5} {#6} {#7} }
    }
}

% 🔎 Visits the quadrant #1 of node #2 first and the other three after it.
\cs_new_protected:Npn \semio_viz_qt_visit_order:nnnnnnnn #1#2#3#4#5#6#7#8 {
  \semio_viz_qt_visit_quadrant:nnnnnnnn {#1} {#2} {#3} {#4} {#5} {#6} {#7} {#8}
  \int_step_inline:nnn { 0 } { 3 }
    {
      \int_compare:nNnF { ##1 } = {#1}
        { \semio_viz_qt_visit_quadrant:nnnnnnnn { ##1 } {#2} {#3} {#4} {#5} {#6} {#7} {#8} }
    }
}

% 🔎 Visits quadrant #1 of internal node #2 inside the box (#5,#6)-(#7,#8).
\cs_new_protected:Npn \semio_viz_qt_visit_quadrant:nnnnnnnn #1#2#3#4#5#6#7#8 {
  \semio_viz_qt_visit:nnnnnnn { \semio_viz_qt_child:nn {#2} {#1} } {#3} {#4}
    { \int_mod:nn {#1} { 2 } ? ( ( (#5) + (#7) ) / 2 ) : (#5) }
    { \int_div_truncate:nn {#1} { 2 } ? ( ( (#6) + (#8) ) / 2 ) : (#6) }
    { \int_mod:nn {#1} { 2 } ? (#7) : ( ( (#5) + (#7) ) / 2 ) }
    { \int_div_truncate:nn {#1} { 2 } ? (#8) : ( ( (#6) + (#8) ) / 2 ) }
}

% 🔎 Offers the chain starting at point #1 as candidates for the query (#2, #3).
\cs_new_protected:Npn \semio_viz_qt_offer:nnn #1#2#3 {
  \int_compare:nNnT {#1} > { 0 }
    {
      \fp_compare:nNnT
        {
          ( \semio_viz_qt_x:n {#1} - (#2) ) ^ 2 + ( \semio_viz_qt_y:n {#1} - (#3) ) ^ 2
        }
        < { \g_semio_viz_qt_best_fp }
        {
          \fp_gset:Nn \g_semio_viz_qt_best_fp
            { ( \semio_viz_qt_x:n {#1} - (#2) ) ^ 2 + ( \semio_viz_qt_y:n {#1} - (#3) ) ^ 2 }
          \int_gset:Nn \g_semio_viz_qt_found_int {#1}
        }
      \semio_viz_qt_offer:nnn { \semio_viz_qt_next:n {#1} } {#2} {#3}
    }
}
%endregion 🔖️Quadtree

%region 🔖️PublicApi
% 🌳 \SemioVizQuadtree{table}[x=,y=]: builds the spatial index of a table's two coordinate columns.
\NewDocumentCommand \SemioVizQuadtree { m O{} } { \semio_viz_qt_build:nn {#1} {#2} }
% 🔎 \SemioVizQuadtreeFind{x}{y}[radius]: typesets the 1-based row index of the nearest point of the
% active quadtree within the search radius, or 0 when it holds none.
\NewDocumentCommand \SemioVizQuadtreeFind { m m O{inf} }
  {
    \semio_viz_qt_find:nnn {#1} {#2} {#3}
    \int_use:N \g_semio_viz_qt_found_int
  }
% 🔺 \SemioVizDelaunay{pointset}: triangles into \g_semio_viz_spatial_tri_seq as `{i}{j}{k}` (1-based indices).
\NewDocumentCommand \SemioVizDelaunay { m } { \semio_viz_spatial_delaunay:n {#1} }
% 🔷 \SemioVizVoronoi{pointset}{x0}{y0}{x1}{y1}: clipped cells into \g_semio_viz_spatial_cells_seq as `{i}{x,y;…}`.
\NewDocumentCommand \SemioVizVoronoi { m m m m m }
  { \semio_viz_spatial_voronoi:nnnnn {#1}{#2}{#3}{#4}{#5} }
% 🔶 \SemioVizHull{pointset}: convex hull indices into \g_semio_viz_spatial_hull_seq.
\NewDocumentCommand \SemioVizHull { m } { \semio_viz_spatial_hull:n {#1} }
% 🍯 \SemioVizHexbin{pointset}{radius}: bins into \g_semio_viz_spatial_bins_seq as `{id}{cx}{cy}`.
\NewDocumentCommand \SemioVizHexbin { m m } { \semio_viz_spatial_hexbin:nn {#1}{#2} }
% 🐝 \SemioVizBeeswarm{pointset}{radius}: collision-free positions into \g_semio_viz_spatial_swarm_seq.
\NewDocumentCommand \SemioVizBeeswarm { m m } { \semio_viz_spatial_beeswarm:nn {#1}{#2} }
% 🎲 \SemioVizJitter{pointset}{amount}: deterministic jittered positions into \g_semio_viz_spatial_swarm_seq.
\NewDocumentCommand \SemioVizJitter { m m } { \semio_viz_spatial_jitter:nn {#1}{#2} }
% 〰️ \SemioVizContour{grid}{threshold}: isolines into \g_semio_viz_spatial_rings_seq as `x,y;x,y;…`.
\NewDocumentCommand \SemioVizContour { m m } { \semio_viz_spatial_contour:nn {#1}{#2} }
% 🌫️ \SemioVizDensity{pointset}{w}{h}{x0}{y0}{cell}{bandwidth}: writes the grid `<pointset>-density`.
\NewDocumentCommand \SemioVizDensity { m m m m m m m }
  { \semio_viz_spatial_density:nnnnnnn {#1}{#2}{#3}{#4}{#5}{#6}{#7} }
