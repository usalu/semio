%region 🔖️DemoData
% 🧪 Hierarchy demo tables announced to the fleet, on top of GRAMMAR-CORE's shared
% `demo-hierarchy`: `demo-hierarchy-deep` (four levels, thirteen nodes, for treemap
% and pack), `demo-hierarchy-unbalanced` (a deliberately lopsided tree that makes
% the Buchheim contour threading visible), `demo-hierarchy-path` (a delimited path
% column) and `demo-hierarchy-branch` (branch lengths for phylograms).
\cs_new_protected:Npn \semio_viz_hierarchy_demo_data: {
  \seq_if_in:NnF \g_semio_viz_table_names_seq { demo-hierarchy-deep } {
    \semio_viz_table_new:nn { demo-hierarchy-deep } { id, parent, value, label }
    \clist_map_inline:nn {
      { root, {}, 0, Wurzel }, { a, root, 0, Alpha }, { b, root, 0, Beta }, { c, root, 0, Gamma },
      { a1, a, 6, {A~I} }, { a2, a, 3, {A~II} }, { a3, a, 2, {A~III} },
      { b1, b, 8, {B~I} }, { b2, b, 4, {B~II} },
      { c1, c, 5, {C~I} }, { c2, c, 1, {C~II} }, { c3, c, 7, {C~III} }, { c4, c, 2, {C~IV} }
    } { \semio_viz_table_row:nn { demo-hierarchy-deep } {##1} }
    \semio_viz_data_hierarchy:nn { demo-hierarchy-deep }
      { id=id, parent=parent, value=value, label=label }
  }
  \seq_if_in:NnF \g_semio_viz_table_names_seq { demo-hierarchy-unbalanced } {
    \semio_viz_table_new:nn { demo-hierarchy-unbalanced } { id, parent, value, label }
    \clist_map_inline:nn {
      { r, {}, 0, R }, { s, r, 0, S }, { t, r, 9, T },
      { sa, s, 0, {S~1} }, { sb, s, 4, {S~2} },
      { saa, sa, 0, {S~1.1} }, { sab, sa, 3, {S~1.2} },
      { saaa, saa, 2, {S~1.1.1} }, { saab, saa, 5, {S~1.1.2} }, { saac, saa, 1, {S~1.1.3} }
    } { \semio_viz_table_row:nn { demo-hierarchy-unbalanced } {##1} }
    \semio_viz_data_hierarchy:nn { demo-hierarchy-unbalanced }
      { id=id, parent=parent, value=value, label=label }
  }
  \seq_if_in:NnF \g_semio_viz_table_names_seq { demo-hierarchy-path } {
    \semio_viz_table_new:nn { demo-hierarchy-path } { path, value }
    \clist_map_inline:nn {
      { {system/core/data}, 5 }, { {system/core/render}, 8 }, { {system/ui/input}, 3 },
      { {system/ui/theme}, 4 }, { {system/io/read}, 6 }, { {system/io/write}, 2 }
    } { \semio_viz_table_row:nn { demo-hierarchy-path } {##1} }
  }
  \seq_if_in:NnF \g_semio_viz_table_names_seq { demo-hierarchy-branch } {
    \semio_viz_table_new:nn { demo-hierarchy-branch } { id, parent, value, length, label }
    \clist_map_inline:nn {
      { life, {}, 0, 0, Life }, { euk, life, 0, 3, Eukaryota }, { bac, life, 4, 5, Bacteria },
      { plant, euk, 6, 4, Plantae }, { anim, euk, 0, 2, Animalia },
      { vert, anim, 5, 3, Vertebrata }, { inv, anim, 3, 6, Invertebrata }
    } { \semio_viz_table_row:nn { demo-hierarchy-branch } {##1} }
    \semio_viz_data_hierarchy:nn { demo-hierarchy-branch }
      { id=id, parent=parent, value=value, label=label }
  }
}
