% 📤 d3 `node.ancestors()`: the node itself, then every parent up to the root.
\cs_new_protected:Npn \semio_viz_hierarchy_ancestors:nnN #1#2#3 {
  \seq_clear:N #3
  \int_set:Nn \l_semio_viz_hierarchy_i_int {#2}
  \bool_while_do:nn { \int_compare_p:nNn { \l_semio_viz_hierarchy_i_int } > { 0 } } {
    \seq_put_right:Nx #3 { \int_use:N \l_semio_viz_hierarchy_i_int }
    \int_set:Nn \l_semio_viz_hierarchy_i_int
      { \semio_viz_hierarchy_get:nnn {#1} { pi } { \l_semio_viz_hierarchy_i_int } }
  }
}

% 📥 d3 `node.descendants()`: the preorder of the subtree rooted at #2.
\cs_new_protected:Npn \semio_viz_hierarchy_descendants:nnN #1#2#3 {
  \seq_clear:N #3
  \seq_clear:N \l_semio_viz_hierarchy_stack_seq
  \seq_put_right:Nx \l_semio_viz_hierarchy_stack_seq { \int_eval:n {#2} }
  \bool_while_do:nn { ! \seq_if_empty_p:N \l_semio_viz_hierarchy_stack_seq } {
    \seq_pop_right:NN \l_semio_viz_hierarchy_stack_seq \l_semio_viz_hierarchy_cell_tl
    \seq_put_right:NV #3 \l_semio_viz_hierarchy_cell_tl
    \int_set:Nn \l_semio_viz_hierarchy_j_int { \l_semio_viz_hierarchy_cell_tl }
    \int_step_inline:nnnn { \semio_viz_hierarchy_nk:nn {#1} { \l_semio_viz_hierarchy_j_int } } { -1 } { 1 } {
      \seq_put_right:Nx \l_semio_viz_hierarchy_stack_seq
        { \semio_viz_hierarchy_kid:nnn {#1} { \l_semio_viz_hierarchy_j_int } {##1} }
    }
  }
}

% 🍃 d3 `node.leaves()`: every childless descendant, in preorder.
\cs_new_protected:Npn \semio_viz_hierarchy_leaves:nN #1#2 {
  \seq_clear:N #2
  \semio_viz_hierarchy_map_pre:nn {#1} {
    \int_compare:nNnT { \semio_viz_hierarchy_nk:nn {#1} {##1} } = { 0 }
      { \seq_put_right:Nn #2 {##1} }
  }
}

