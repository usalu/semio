%region 🔖️LayoutKeys
% 📋 `semio / viz / hierarchy / layout` -- options of \SemioVizLayout.
%   size             (`{w,h}` extent the layout is normalised into)   default `{1,1}`
%   nodeSize         (`{w,h}` fixed per-node spacing, disables size)  default unset
%   separationSame   (tree/cluster gap between siblings)              default 1
%   separationOther  (tree/cluster gap between cousins)               default 2
%   separationDepth  (divide the gap by the node depth, radial trees) default false
%   tile             (squarify, resquarify, slice, dice, slice-dice,
%                     binary, strip, voronoi)                         default squarify
%   ratio            (target aspect ratio of squarify/strip)          default golden
%   padding          (treemap inner+outer, partition and pack padding) default 0
%   paddingInner     (treemap gap between siblings)                   default 0
%   paddingOuter     (treemap gap inside a parent, all four sides)    default 0
%   paddingTop, paddingRight, paddingBottom, paddingLeft              default 0
%   round            (snap rectangle corners to whole millimetres)    default false
%   radius           (pack leaf radius: `auto` = sqrt(value), `value`,
%                     or a plain number for equal circles)            default auto
%   relaxation       (voronoi tiling iterations)                      default 24
\fp_new:N \l_semio_viz_hierarchy_dx_fp
\fp_new:N \l_semio_viz_hierarchy_dy_fp
\bool_new:N \l_semio_viz_hierarchy_nodesize_bool
\bool_new:N \l_semio_viz_hierarchy_size_given_bool
