}

% 🖌️ Links plus node marks of the scratch hierarchy.
\cs_new_protected:Npn \semio_viz_hierarchy_family_draw_tree: {
  \semio_viz_hierarchy_draw_links:V \c_semio_viz_hierarchy_family_tl
