%region 🔖️Diagnostics
\msg_new:nnn { semio-viz } { unknown-hierarchy }
  { Unknown~viz~hierarchy~'#1'.~Build~it~with~\SemioVizHierarchy~before~use. }
\msg_new:nnn { semio-viz } { hierarchy-no-root }
  { Viz~hierarchy~'#1'~has~no~root~row~(no~row~with~an~empty~parent~cell). }
\msg_new:nnn { semio-viz } { hierarchy-many-roots }
  { Viz~hierarchy~'#1'~has~more~than~one~root~row~('#2'~and~'#3'). }
\msg_new:nnn { semio-viz } { hierarchy-missing-parent }
  { Viz~hierarchy~'#1':~node~'#2'~names~the~unknown~parent~'#3'. }
\msg_new:nnn { semio-viz } { hierarchy-duplicate-id }
  { Viz~hierarchy~'#1':~the~identifier~'#2'~occurs~twice. }
\msg_new:nnn { semio-viz } { unknown-hierarchy-layout }
  { Unknown~hierarchy~layout~'#1'~(tree,~cluster,~treemap,~partition,~pack). }
\msg_new:nnn { semio-viz } { unknown-hierarchy-tile }
  { Unknown~treemap~tiling~'#1'~(squarify,~resquarify,~slice,~dice,~slice-dice,~binary,~strip,~voronoi). }
\msg_new:nnn { semio-viz } { unknown-hierarchy-sort }
  { Unknown~hierarchy~sort~'#1'~(none,~value-ascending,~value-descending,~height-ascending,~height-descending,~name-ascending,~name-descending). }
%endregion 🔖️Diagnostics

%region 🔖️Storage
% 🗄️ Node fields live in one control sequence per (hierarchy, field, index); a
% csname lookup is the cheapest random-access array TeX offers, which is what
% keeps the fp loops of the pack front chain inside seconds for ~200 nodes.
\cs_new_protected:Npn \semio_viz_hierarchy_set:nnnn #1#2#3#4 {
  \cs_gset_nopar:cpx { g_semio_viz_hierarchy_ #1 _ #2 _ \int_eval:n {#3} } {#4}
}

% 🔍 Expands to the stored field, or to 0 when the field was never written. The name is assembled
% once and handed straight to the reader: `\cs_if_exist_use:cF` builds the same string twice, and
% this is the innermost operation of every fp loop in the pack front chain.
\cs_new:Npn \semio_viz_hierarchy_get:nnn #1#2#3 {
  \exp_after:wN \semio_viz_hierarchy_read:N
    \cs:w g_semio_viz_hierarchy_ #1 _ #2 _ \int_eval:n {#3} \cs_end:
}

% 🈳 Reads a field control sequence: an undefined name arrives as \scan_stop: and reads as 0.
\cs_new:Npn \semio_viz_hierarchy_read:N #1 {
  \if_meaning:w #1 \scan_stop: 0 \else: \exp_after:wN #1 \fi:
}

% ♻️ Declares a sequence variable if needed and empties it.
\cs_new_protected:Npn \semio_viz_hierarchy_seq_reset:n #1 {
  \seq_if_exist:cF {#1} { \seq_new:c {#1} }
  \seq_gclear:c {#1}
}

% 👶 Child sequence of node #2 in hierarchy #1.
\cs_new:Npn \semio_viz_hierarchy_kids:nn #1#2 { g_semio_viz_hierarchy_ #1 _kids_ \int_eval:n {#2} _seq }
% 🔢 Number of children of node #2.
\cs_new:Npn \semio_viz_hierarchy_nk:nn #1#2 { \seq_count:c { g_semio_viz_hierarchy_ #1 _kids_ \int_eval:n {#2} _seq } }
% 👉 The #3-th child (1-based) of node #2, or 0.
\cs_new:Npn \semio_viz_hierarchy_kid:nnn #1#2#3 {
  \seq_item:cn { g_semio_viz_hierarchy_ #1 _kids_ \int_eval:n {#2} _seq } {#3}
}

\int_new:N \l_semio_viz_hierarchy_n_int
\int_new:N \l_semio_viz_hierarchy_i_int
\int_new:N \l_semio_viz_hierarchy_j_int
\int_new:N \l_semio_viz_hierarchy_k_int
\tl_new:N \l_semio_viz_hierarchy_cell_tl
\tl_new:N \l_semio_viz_hierarchy_name_tl
\seq_new:N \g_semio_viz_hierarchy_names_seq

% ❓ True when a hierarchy of that name was built.
\prg_new_protected_conditional:Npnn \semio_viz_hierarchy_if_exist:n #1 { T, F, TF } {
  \seq_if_in:NnTF \g_semio_viz_hierarchy_names_seq {#1} { \prg_return_true: } { \prg_return_false: }
}

% 🛡️ Resolves a hierarchy name: a table declared with \SemioVizHierarchy is built
% under its own name on first use, anything else must already be a hierarchy.
\cs_new_protected:Npn \semio_viz_hierarchy_require:n #1 {
  \semio_viz_hierarchy_if_exist:nF {#1} {
    \seq_if_in:NnTF \g_semio_viz_table_names_seq {#1}
      { \semio_viz_hierarchy_build:nn {#1} { data = #1 } }
      { \msg_error:nnn { semio-viz } { unknown-hierarchy } {#1} }
  }
}
%endregion 🔖️Storage

%region 🔖️Constructor
% 🌳 \SemioVizHierarchy: the stratify/path constructor of the hierarchy namespace,
% reading its rows through semio-viz-data's empty-cell-preserving table kernel.
\prg_generate_conditional_variant:Nnn \regex_match:nn { nV } { T, F, TF }
\cs_generate_variant:Nn \seq_set_split:Nnn { NVV }

\int_new:N \l_semio_viz_hierarchy_idcol_int
\int_new:N \l_semio_viz_hierarchy_parentcol_int
\int_new:N \l_semio_viz_hierarchy_valuecol_int
\int_new:N \g_semio_viz_hierarchy_generation_int

% 🗂️ Identifier lookup as one control sequence per (build, identifier): l3prop
% splits its whole list on every read, which turns a two-hundred node table into
% a quadratic token walk, while a csname lookup is flat.
\cs_new_protected:Npn \semio_viz_hierarchy_index_put:nn #1#2 {
  \cs_gset_nopar:cpx { g_semio_viz_hierarchy_index_ \int_use:N \g_semio_viz_hierarchy_generation_int
    _ \tl_to_str:n {#1} } { \int_eval:n {#2} }
}
% 🔎 Node index of the identifier #1 in the build being read, or 0 when the table never declared it.
\cs_new:Npn \semio_viz_hierarchy_index:n #1 {
  \exp_after:wN \semio_viz_hierarchy_read:N
    \cs:w g_semio_viz_hierarchy_index_
      \int_use:N \g_semio_viz_hierarchy_generation_int _ \tl_to_str:n {#1} \cs_end:
}
\cs_generate_variant:Nn \semio_viz_hierarchy_index_put:nn { Vn }
\cs_generate_variant:Nn \semio_viz_hierarchy_index:n { V }

% 🔢 Coerces a cell to a number the way d3 does (`+value || 0`): anything that is
% not a finite decimal literal becomes zero instead of raising.
\cs_new_protected:Npn \semio_viz_hierarchy_number:NN #1#2 {
  \regex_match:nVTF { \A [\ ]* [-+]? ( [0-9]+ (\.[0-9]*)? | \.[0-9]+ ) ([eE][-+]?[0-9]+)? [\ ]* \Z } #1
    { \fp_set:Nn #2 {#1} }
    { \fp_zero:N #2 }
}

\tl_new:N \l_semio_viz_hierarchy_table_tl
\tl_new:N \l_semio_viz_hierarchy_idcol_tl
\tl_new:N \l_semio_viz_hierarchy_parentcol_tl
\tl_new:N \l_semio_viz_hierarchy_valuecol_tl
\tl_new:N \l_semio_viz_hierarchy_pathcol_tl
\tl_new:N \l_semio_viz_hierarchy_delimiter_tl
\tl_new:N \l_semio_viz_hierarchy_sort_tl
\tl_new:N \l_semio_viz_hierarchy_aggregate_tl
\tl_new:N \l_semio_viz_hierarchy_id_tl
\tl_new:N \l_semio_viz_hierarchy_parent_tl
\tl_new:N \l_semio_viz_hierarchy_prefix_tl
\seq_new:N \l_semio_viz_hierarchy_stack_seq
\seq_new:N \l_semio_viz_hierarchy_next_seq
\seq_new:N \l_semio_viz_hierarchy_path_seq
\fp_new:N \l_semio_viz_hierarchy_own_fp
\int_new:N \l_semio_viz_hierarchy_root_int
\int_new:N \l_semio_viz_hierarchy_node_int

%region 🔖️Keys
% 📋 `semio / viz / hierarchy` -- construction keys of \SemioVizHierarchy.
%   data       (table name, required)                              default empty
%   id         (column holding the node identifier)   default: the table's id role
%   parent     (column holding the parent identifier) default: the table's parent role
%   value      (column with the own value, `none` disables) default: the value role
%   path       (column holding a delimited path, replaces id+parent) default empty
%   delimiter  (single token separating path segments)              default `/`
%   aggregate  (`sum`, `count` or `none`)                           default `sum`
%   sort       (see \semio_viz_hierarchy_sort:nn)                   default `none`
\keys_define:nn { semio / viz / hierarchy } {
  data      .tl_set:N = \l_semio_viz_hierarchy_table_tl,
  id        .tl_set:N = \l_semio_viz_hierarchy_idcol_tl,
  parent    .tl_set:N = \l_semio_viz_hierarchy_parentcol_tl,
  value     .tl_set:N = \l_semio_viz_hierarchy_valuecol_tl,
  path      .tl_set:N = \l_semio_viz_hierarchy_pathcol_tl,
  delimiter .tl_set:N = \l_semio_viz_hierarchy_delimiter_tl,
  aggregate .tl_set:N = \l_semio_viz_hierarchy_aggregate_tl,
  sort      .tl_set:N = \l_semio_viz_hierarchy_sort_tl,
}

% ♻️ Puts every construction key back to its documented default before an option list is read.
\cs_new_protected:Npn \semio_viz_hierarchy_keys_reset: {
  \tl_clear:N \l_semio_viz_hierarchy_table_tl
  \tl_clear:N \l_semio_viz_hierarchy_idcol_tl
  \tl_clear:N \l_semio_viz_hierarchy_parentcol_tl
  \tl_clear:N \l_semio_viz_hierarchy_valuecol_tl
  \tl_clear:N \l_semio_viz_hierarchy_pathcol_tl
  \tl_set:Nn \l_semio_viz_hierarchy_delimiter_tl { / }
  \tl_set:Nn \l_semio_viz_hierarchy_aggregate_tl { sum }
  \tl_set:Nn \l_semio_viz_hierarchy_sort_tl { none }
}
%endregion 🔖️Keys

% 🆕 Allocates one node, records its identifier and returns its index in #3.
\cs_new_protected:Npn \semio_viz_hierarchy_node_new:nnN #1#2#3 {
  \int_incr:N \l_semio_viz_hierarchy_n_int
  \int_set_eq:NN #3 \l_semio_viz_hierarchy_n_int
  \semio_viz_hierarchy_index_put:nn {#2} { \int_use:N #3 }
  \semio_viz_hierarchy_set:nnnn {#1} { id } { #3 } { \exp_not:n {#2} }
  \semio_viz_hierarchy_set:nnnn {#1} { own } { #3 } { 0 }
  \semio_viz_hierarchy_set:nnnn {#1} { pi } { #3 } { 0 }
  \semio_viz_hierarchy_set:nnnn {#1} { si } { #3 } { 0 }
  \semio_viz_hierarchy_seq_reset:n { \semio_viz_hierarchy_kids:nn {#1} {#3} }
}

% 🔗 Appends node #3 to the child list of node #2 and records its sibling index.
\cs_new_protected:Npn \semio_viz_hierarchy_link:nnn #1#2#3 {
  \seq_gput_right:cx { \semio_viz_hierarchy_kids:nn {#1} {#2} } { \int_eval:n {#3} }
  \semio_viz_hierarchy_set:nnnn {#1} { pi } {#3} { \int_eval:n {#2} }
  \semio_viz_hierarchy_set:nnnn {#1} { si } {#3} { \int_eval:n { \semio_viz_hierarchy_nk:nn {#1} {#2} - 1 } }
}

% 🧱 Reads the id/parent/value columns of a table into a fresh node set.
\cs_new_protected:Npn \semio_viz_hierarchy_build_table:n #1 {
  \semio_viz_table_col_index_opt:nnN { \l_semio_viz_hierarchy_table_tl }
    { \l_semio_viz_hierarchy_idcol_tl } \l_semio_viz_hierarchy_idcol_int
  \semio_viz_table_col_index_opt:nnN { \l_semio_viz_hierarchy_table_tl }
    { \l_semio_viz_hierarchy_parentcol_tl } \l_semio_viz_hierarchy_parentcol_int
  \semio_viz_table_col_index_opt:nnN { \l_semio_viz_hierarchy_table_tl }
    { \l_semio_viz_hierarchy_valuecol_tl } \l_semio_viz_hierarchy_valuecol_int
  \semio_viz_table_nrows:nN { \l_semio_viz_hierarchy_table_tl } \l_semio_viz_hierarchy_i_int
  \int_step_inline:nn { \l_semio_viz_hierarchy_i_int } {
    \semio_viz_table_row_load:nn { \l_semio_viz_hierarchy_table_tl } {##1}
    \semio_viz_table_row_cell:nN { \l_semio_viz_hierarchy_idcol_int }
      \l_semio_viz_hierarchy_id_tl
    \int_compare:nNnTF { \semio_viz_hierarchy_index:V \l_semio_viz_hierarchy_id_tl } > { 0 }
      { \msg_error:nnxx { semio-viz } { hierarchy-duplicate-id } {#1} { \l_semio_viz_hierarchy_id_tl } }
      {
        \exp_args:NnV \semio_viz_hierarchy_node_new:nnN {#1} \l_semio_viz_hierarchy_id_tl
          \l_semio_viz_hierarchy_node_int
        \int_compare:nNnT { \l_semio_viz_hierarchy_valuecol_int } > { 0 } {
          \semio_viz_table_row_cell:nN { \l_semio_viz_hierarchy_valuecol_int }
            \l_semio_viz_hierarchy_cell_tl
          \semio_viz_hierarchy_number:NN \l_semio_viz_hierarchy_cell_tl \l_semio_viz_hierarchy_own_fp
          \semio_viz_hierarchy_set:nnnn {#1} { own } { \l_semio_viz_hierarchy_node_int }
            { \fp_use:N \l_semio_viz_hierarchy_own_fp }
        }
      }
  }
  \int_zero:N \l_semio_viz_hierarchy_root_int
  \int_step_inline:nn { \l_semio_viz_hierarchy_n_int } {
    \semio_viz_table_row_load:nn { \l_semio_viz_hierarchy_table_tl } {##1}
    \semio_viz_table_row_cell:nN { \l_semio_viz_hierarchy_parentcol_int }
      \l_semio_viz_hierarchy_parent_tl
    \tl_if_blank:VTF \l_semio_viz_hierarchy_parent_tl
      {
        \int_compare:nNnTF \l_semio_viz_hierarchy_root_int > { 0 }
          { \msg_error:nnxxx { semio-viz } { hierarchy-many-roots } {#1}
              { \semio_viz_hierarchy_get:nnn {#1} { id } { \l_semio_viz_hierarchy_root_int } }
              { \semio_viz_hierarchy_get:nnn {#1} { id } {##1} } }
          { \int_set:Nn \l_semio_viz_hierarchy_root_int {##1} }
      }
      {
        \int_compare:nNnTF { \semio_viz_hierarchy_index:V \l_semio_viz_hierarchy_parent_tl } > { 0 }
          { \semio_viz_hierarchy_link:nnn {#1}
              { \semio_viz_hierarchy_index:V \l_semio_viz_hierarchy_parent_tl } {##1} }
          { \msg_error:nnxxx { semio-viz } { hierarchy-missing-parent } {#1}
              { \semio_viz_hierarchy_get:nnn {#1} { id } {##1} } { \l_semio_viz_hierarchy_parent_tl } }
      }
  }
}

% 🧭 Reads a delimited `path` column: every prefix becomes a node, the shared
% first segment becomes the root, and only full paths carry a value.
\cs_new_protected:Npn \semio_viz_hierarchy_build_path:n #1 {
  \semio_viz_table_col_index_opt:nnN { \l_semio_viz_hierarchy_table_tl }
    { \l_semio_viz_hierarchy_pathcol_tl } \l_semio_viz_hierarchy_idcol_int
  \semio_viz_table_col_index_opt:nnN { \l_semio_viz_hierarchy_table_tl }
    { \l_semio_viz_hierarchy_valuecol_tl } \l_semio_viz_hierarchy_valuecol_int
  \semio_viz_table_nrows:nN { \l_semio_viz_hierarchy_table_tl } \l_semio_viz_hierarchy_i_int
  \int_zero:N \l_semio_viz_hierarchy_root_int
  \int_step_inline:nn { \l_semio_viz_hierarchy_i_int } {
    \semio_viz_table_row_load:nn { \l_semio_viz_hierarchy_table_tl } {##1}
    \semio_viz_table_row_cell:nN { \l_semio_viz_hierarchy_idcol_int }
      \l_semio_viz_hierarchy_cell_tl
    \seq_set_split:NVV \l_semio_viz_hierarchy_path_seq \l_semio_viz_hierarchy_delimiter_tl
      \l_semio_viz_hierarchy_cell_tl
    \seq_remove_all:Nn \l_semio_viz_hierarchy_path_seq { }
    \tl_clear:N \l_semio_viz_hierarchy_prefix_tl
    \int_zero:N \l_semio_viz_hierarchy_j_int
    \seq_map_inline:Nn \l_semio_viz_hierarchy_path_seq {
      \tl_if_empty:NTF \l_semio_viz_hierarchy_prefix_tl
        { \tl_set:Nn \l_semio_viz_hierarchy_prefix_tl {####1} }
        { \tl_put_right:Nx \l_semio_viz_hierarchy_prefix_tl
            { \l_semio_viz_hierarchy_delimiter_tl ####1 } }
      \int_compare:nNnTF { \semio_viz_hierarchy_index:V \l_semio_viz_hierarchy_prefix_tl } > { 0 }
        { \int_set:Nn \l_semio_viz_hierarchy_node_int
            { \semio_viz_hierarchy_index:V \l_semio_viz_hierarchy_prefix_tl } }
        {
          \exp_args:NnV \semio_viz_hierarchy_node_new:nnN {#1} \l_semio_viz_hierarchy_prefix_tl
            \l_semio_viz_hierarchy_node_int
          \int_compare:nNnTF \l_semio_viz_hierarchy_j_int = { 0 }
            { \int_set_eq:NN \l_semio_viz_hierarchy_root_int \l_semio_viz_hierarchy_node_int }
            { \semio_viz_hierarchy_link:nnn {#1} { \l_semio_viz_hierarchy_j_int }
                { \l_semio_viz_hierarchy_node_int } }
        }
      \int_set_eq:NN \l_semio_viz_hierarchy_j_int \l_semio_viz_hierarchy_node_int
    }
    \int_compare:nNnT { \l_semio_viz_hierarchy_valuecol_int } > { 0 } {
      \semio_viz_table_row_cell:nN { \l_semio_viz_hierarchy_valuecol_int }
        \l_semio_viz_hierarchy_cell_tl
      \semio_viz_hierarchy_number:NN \l_semio_viz_hierarchy_cell_tl \l_semio_viz_hierarchy_own_fp
      \semio_viz_hierarchy_set:nnnn {#1} { own } { \l_semio_viz_hierarchy_j_int }
        { \fp_use:N \l_semio_viz_hierarchy_own_fp }
    }
  }
}
%endregion 🔖️Constructor

%region 🔖️Structure
% 🧮 Fills the preorder (d3 eachBefore) and postorder (d3 eachAfter) sequences and
% the depth/height fields; both traversals use d3's own explicit stacks so the
% visiting order is identical, which every layout below depends on.
\cs_new_protected:Npn \semio_viz_hierarchy_order:n #1 {
  \semio_viz_hierarchy_seq_reset:n { g_semio_viz_hierarchy_ #1 _pre_seq }
  \semio_viz_hierarchy_seq_reset:n { g_semio_viz_hierarchy_ #1 _post_seq }
  \seq_clear:N \l_semio_viz_hierarchy_stack_seq
  \seq_put_right:Nx \l_semio_viz_hierarchy_stack_seq
    { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } }
  \bool_while_do:nn { ! \seq_if_empty_p:N \l_semio_viz_hierarchy_stack_seq } {
    \seq_pop_right:NN \l_semio_viz_hierarchy_stack_seq \l_semio_viz_hierarchy_cell_tl
    \seq_gput_right:cV { g_semio_viz_hierarchy_ #1 _pre_seq } \l_semio_viz_hierarchy_cell_tl
    \int_set:Nn \l_semio_viz_hierarchy_i_int { \l_semio_viz_hierarchy_cell_tl }
    \int_compare:nNnTF { \semio_viz_hierarchy_get:nnn {#1} { pi } { \l_semio_viz_hierarchy_i_int } } = { 0 }
      { \semio_viz_hierarchy_set:nnnn {#1} { dep } { \l_semio_viz_hierarchy_i_int } { 0 } }
      { \semio_viz_hierarchy_set:nnnn {#1} { dep } { \l_semio_viz_hierarchy_i_int }
          { \int_eval:n { \semio_viz_hierarchy_get:nnn {#1} { dep }
              { \semio_viz_hierarchy_get:nnn {#1} { pi } { \l_semio_viz_hierarchy_i_int } } + 1 } } }
    \int_step_inline:nnnn { \semio_viz_hierarchy_nk:nn {#1} { \l_semio_viz_hierarchy_i_int } } { -1 } { 1 } {
      \seq_put_right:Nx \l_semio_viz_hierarchy_stack_seq
        { \semio_viz_hierarchy_kid:nnn {#1} { \l_semio_viz_hierarchy_i_int } {##1} }
    }
  }
  \seq_clear:N \l_semio_viz_hierarchy_stack_seq
  \seq_clear:N \l_semio_viz_hierarchy_next_seq
  \seq_put_right:Nx \l_semio_viz_hierarchy_stack_seq
    { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } }
  \bool_while_do:nn { ! \seq_if_empty_p:N \l_semio_viz_hierarchy_stack_seq } {
    \seq_pop_right:NN \l_semio_viz_hierarchy_stack_seq \l_semio_viz_hierarchy_cell_tl
    \seq_put_right:NV \l_semio_viz_hierarchy_next_seq \l_semio_viz_hierarchy_cell_tl
    \int_set:Nn \l_semio_viz_hierarchy_i_int { \l_semio_viz_hierarchy_cell_tl }
    \int_step_inline:nn { \semio_viz_hierarchy_nk:nn {#1} { \l_semio_viz_hierarchy_i_int } } {
      \seq_put_right:Nx \l_semio_viz_hierarchy_stack_seq
        { \semio_viz_hierarchy_kid:nnn {#1} { \l_semio_viz_hierarchy_i_int } {##1} }
    }
  }
  \bool_while_do:nn { ! \seq_if_empty_p:N \l_semio_viz_hierarchy_next_seq } {
    \seq_pop_right:NN \l_semio_viz_hierarchy_next_seq \l_semio_viz_hierarchy_cell_tl
    \seq_gput_right:cV { g_semio_viz_hierarchy_ #1 _post_seq } \l_semio_viz_hierarchy_cell_tl
  }
  \seq_map_inline:cn { g_semio_viz_hierarchy_ #1 _post_seq } {
    \int_zero:N \l_semio_viz_hierarchy_k_int
    \int_step_inline:nn { \semio_viz_hierarchy_nk:nn {#1} {##1} } {
      \int_set:Nn \l_semio_viz_hierarchy_k_int { \int_max:nn { \l_semio_viz_hierarchy_k_int }
        { \semio_viz_hierarchy_get:nnn {#1} { hgt } { \semio_viz_hierarchy_kid:nnn {#1} {##1} {####1} } + 1 } }
    }
    \semio_viz_hierarchy_set:nnnn {#1} { hgt } {##1} { \int_use:N \l_semio_viz_hierarchy_k_int }
  }
}

% 🔁 Maps over the preorder of a hierarchy; the body sees the node index as #1.
\cs_new_protected:Npn \semio_viz_hierarchy_map_pre:nn #1#2 {
  \seq_map_inline:cn { g_semio_viz_hierarchy_ #1 _pre_seq } {#2}
}
% 🔁 Maps over the postorder of a hierarchy; the body sees the node index as #1.
\cs_new_protected:Npn \semio_viz_hierarchy_map_post:nn #1#2 {
  \seq_map_inline:cn { g_semio_viz_hierarchy_ #1 _post_seq } {#2}
}

% ➕ d3 `node.sum(value)`, `node.count()` or the raw own values.
\cs_new_protected:Npn \semio_viz_hierarchy_aggregate:nn #1#2 {
  \str_case:nnF {#2} {
    { sum } {
      \semio_viz_hierarchy_map_post:nn {#1} {
        \fp_set:Nn \l_semio_viz_hierarchy_own_fp { \semio_viz_hierarchy_get:nnn {#1} { own } {##1} }
        \int_step_inline:nn { \semio_viz_hierarchy_nk:nn {#1} {##1} } {
          \fp_add:Nn \l_semio_viz_hierarchy_own_fp
            { \semio_viz_hierarchy_get:nnn {#1} { val } { \semio_viz_hierarchy_kid:nnn {#1} {##1} {####1} } }
        }
        \semio_viz_hierarchy_set:nnnn {#1} { val } {##1} { \fp_use:N \l_semio_viz_hierarchy_own_fp }
      }
    }
    { count } {
      \semio_viz_hierarchy_map_post:nn {#1} {
        \int_compare:nNnTF { \semio_viz_hierarchy_nk:nn {#1} {##1} } = { 0 }
          { \semio_viz_hierarchy_set:nnnn {#1} { val } {##1} { 1 } }
          {
            \fp_zero:N \l_semio_viz_hierarchy_own_fp
            \int_step_inline:nn { \semio_viz_hierarchy_nk:nn {#1} {##1} } {
              \fp_add:Nn \l_semio_viz_hierarchy_own_fp
                { \semio_viz_hierarchy_get:nnn {#1} { val } { \semio_viz_hierarchy_kid:nnn {#1} {##1} {####1} } }
            }
            \semio_viz_hierarchy_set:nnnn {#1} { val } {##1} { \fp_use:N \l_semio_viz_hierarchy_own_fp }
          }
      }
    }
    { none } {
      \semio_viz_hierarchy_map_pre:nn {#1} {
        \semio_viz_hierarchy_set:nnnn {#1} { val } {##1} { \semio_viz_hierarchy_get:nnn {#1} { own } {##1} }
      }
    }
  }
  { \msg_error:nnn { semio-viz } { unknown-hierarchy-sort } {#2} }
}

% 🔤 d3 `node.sort(comparator)`: a stable merge sort of every child list, in
% preorder, followed by a rebuild of the sibling indices and traversal orders.
\cs_new_protected:Npn \semio_viz_hierarchy_sort:nn #1#2 {
  \str_if_eq:nnF {#2} { none } {
    \semio_viz_hierarchy_map_pre:nn {#1} {
      \int_compare:nNnT { \semio_viz_hierarchy_nk:nn {#1} {##1} } > { 1 } {
        \semio_viz_hierarchy_sort_children:nnn {#1} {##1} {#2}
      }
    }
    \semio_viz_hierarchy_map_pre:nn {#1} {
      \int_step_inline:nn { \semio_viz_hierarchy_nk:nn {#1} {##1} } {
        \semio_viz_hierarchy_set:nnnn {#1} { si }
          { \semio_viz_hierarchy_kid:nnn {#1} {##1} {####1} } { \int_eval:n { ####1 - 1 } }
      }
    }
    \semio_viz_hierarchy_order:n {#1}
  }
}

% ⚖️ Applies one comparator to the child list of node #2.
\cs_new_protected:Npn \semio_viz_hierarchy_sort_children:nnn #1#2#3 {
  \str_case:nnF {#3} {
    { value-ascending } { \seq_gsort:cn { \semio_viz_hierarchy_kids:nn {#1} {#2} } {
      \fp_compare:nNnTF { \semio_viz_hierarchy_get:nnn {#1} { val } {##1} } >
        { \semio_viz_hierarchy_get:nnn {#1} { val } {##2} }
        { \sort_return_swapped: } { \sort_return_same: } } }
    { value-descending } { \seq_gsort:cn { \semio_viz_hierarchy_kids:nn {#1} {#2} } {
      \fp_compare:nNnTF { \semio_viz_hierarchy_get:nnn {#1} { val } {##1} } <
        { \semio_viz_hierarchy_get:nnn {#1} { val } {##2} }
        { \sort_return_swapped: } { \sort_return_same: } } }
    { height-ascending } { \seq_gsort:cn { \semio_viz_hierarchy_kids:nn {#1} {#2} } {
      \int_compare:nNnTF { \semio_viz_hierarchy_get:nnn {#1} { hgt } {##1} } >
        { \semio_viz_hierarchy_get:nnn {#1} { hgt } {##2} }
        { \sort_return_swapped: } { \sort_return_same: } } }
    { height-descending } { \seq_gsort:cn { \semio_viz_hierarchy_kids:nn {#1} {#2} } {
      \int_compare:nNnTF { \semio_viz_hierarchy_get:nnn {#1} { hgt } {##1} } <
        { \semio_viz_hierarchy_get:nnn {#1} { hgt } {##2} }
        { \sort_return_swapped: } { \sort_return_same: } } }
    { name-ascending } { \seq_gsort:cn { \semio_viz_hierarchy_kids:nn {#1} {#2} } {
      \str_compare:eNeTF { \semio_viz_hierarchy_get:nnn {#1} { id } {##1} } >
        { \semio_viz_hierarchy_get:nnn {#1} { id } {##2} }
        { \sort_return_swapped: } { \sort_return_same: } } }
    { name-descending } { \seq_gsort:cn { \semio_viz_hierarchy_kids:nn {#1} {#2} } {
      \str_compare:eNeTF { \semio_viz_hierarchy_get:nnn {#1} { id } {##1} } <
        { \semio_viz_hierarchy_get:nnn {#1} { id } {##2} }
        { \sort_return_swapped: } { \sort_return_same: } } }
  }
  { \msg_error:nnn { semio-viz } { unknown-hierarchy-sort } {#3} }
}
