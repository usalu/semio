%region 🔖️FamilySupport
% 🧰 One flat option list per family: the keys a family declares itself win, then
% the construction keys of `semio / viz / hierarchy`, then the layout keys, and
% whatever is left must be a renderer key. Every family documents its own subset.
\tl_new:N \l_semio_viz_hierarchy_fam_rest_tl
\tl_new:N \l_semio_viz_hierarchy_fam_more_tl
\cs_generate_variant:Nn \keys_set_known:nnN { nVN }
\cs_generate_variant:Nn \keys_set:nn { nV }

\cs_new_protected:Npn \semio_viz_hierarchy_family_setup:nnn #1#2#3 {
  \semio_viz_hierarchy_keys_reset:
  \semio_viz_hierarchy_layout_keys_reset:
  \semio_viz_hierarchy_render_keys_reset:
  \tl_set:Nn \l_semio_viz_hierarchy_table_tl { demo-hierarchy }
  \semio_viz_hierarchy_family_apply:nn {#1} {#2}
  \semio_viz_hierarchy_family_apply:nn {#1} {#3}
  \semio_viz_hierarchy_column_optional:Nnn \l_semio_viz_hierarchy_rd_labelcol_tl { label } { label }
}

% 🔀 Routes one option list through the four key sets a family understands.
\cs_new_protected:Npn \semio_viz_hierarchy_family_apply:nn #1#2 {
  \keys_set_known:nnN { semio / viz / family / #1 } {#2} \l_semio_viz_hierarchy_fam_rest_tl
  \keys_set_known:nVN { semio / viz / hierarchy } \l_semio_viz_hierarchy_fam_rest_tl
    \l_semio_viz_hierarchy_fam_more_tl
  \keys_set_known:nVN { semio / viz / hierarchy / layout } \l_semio_viz_hierarchy_fam_more_tl
    \l_semio_viz_hierarchy_fam_rest_tl
  \keys_set:nV { semio / viz / hierarchy / render } \l_semio_viz_hierarchy_fam_rest_tl
}

% 📐 Fills the layout extent with the drawable canvas unless the caller asked for
% an explicit `size` or `nodeSize`.
\cs_new_protected:Npn \semio_viz_hierarchy_family_extent: {
  \bool_if:NF \l_semio_viz_hierarchy_size_given_bool {
    \str_if_eq:VnTF \l_semio_viz_hierarchy_rd_orient_tl { radial }
      {
        \fp_set:Nn \l_semio_viz_hierarchy_dx_fp { 2 * pi }
        \fp_set:Nn \l_semio_viz_hierarchy_dy_fp
          { max ( 1 , min ( \l_semio_viz_hierarchy_rd_width_fp ,
            \l_semio_viz_hierarchy_rd_height_fp ) / 2 - \l_semio_viz_hierarchy_rd_inset_fp ) }
        \bool_set_true:N \l_semio_viz_hierarchy_radial_bool
      }
      {
        \str_case:VnTF \l_semio_viz_hierarchy_rd_orient_tl {
          { left-right } { \fp_set:Nn \l_semio_viz_hierarchy_dx_fp { \semio_viz_hierarchy_canvas_y: }
                           \fp_set:Nn \l_semio_viz_hierarchy_dy_fp { \semio_viz_hierarchy_canvas_x: } }
          { right-left } { \fp_set:Nn \l_semio_viz_hierarchy_dx_fp { \semio_viz_hierarchy_canvas_y: }
                           \fp_set:Nn \l_semio_viz_hierarchy_dy_fp { \semio_viz_hierarchy_canvas_x: } }
        } { }
        { \fp_set:Nn \l_semio_viz_hierarchy_dx_fp { \semio_viz_hierarchy_canvas_x: }
          \fp_set:Nn \l_semio_viz_hierarchy_dy_fp { \semio_viz_hierarchy_canvas_y: } }
      }
  }
}

