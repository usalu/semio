% 🔗 d3 `node.links()`: one parent/child pair per non-root node, in the
% breadth-first order of d3's own node iterator; the body sees the child index as
% #1 with source/target bound as integers.
\cs_new_protected:Npn \semio_viz_hierarchy_map_links:nn #1#2 {
  \seq_clear:N \l_semio_viz_hierarchy_queue_seq
  \seq_put_right:Nx \l_semio_viz_hierarchy_queue_seq
    { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } }
  \bool_while_do:nn { ! \seq_if_empty_p:N \l_semio_viz_hierarchy_queue_seq } {
    \seq_pop_left:NN \l_semio_viz_hierarchy_queue_seq \l_semio_viz_hierarchy_cell_tl
    \int_set:Nn \l_semio_viz_hierarchy_source_int { \l_semio_viz_hierarchy_cell_tl }
    \int_step_inline:nn
      { \semio_viz_hierarchy_nk:nn {#1} { \l_semio_viz_hierarchy_source_int } } {
      \seq_put_right:Nx \l_semio_viz_hierarchy_queue_seq
        { \semio_viz_hierarchy_kid:nnn {#1} { \l_semio_viz_hierarchy_source_int } {##1} }
    }
    \int_compare:nNnT { \semio_viz_hierarchy_get:nnn {#1} { pi }
      { \l_semio_viz_hierarchy_source_int } } > { 0 } {
      \int_set:Nn \l_semio_viz_hierarchy_target_int { \l_semio_viz_hierarchy_source_int }
      \int_set:Nn \l_semio_viz_hierarchy_source_int
        { \semio_viz_hierarchy_get:nnn {#1} { pi } { \l_semio_viz_hierarchy_target_int } }
      #2
      \int_set:Nn \l_semio_viz_hierarchy_source_int { \l_semio_viz_hierarchy_target_int }
    }
  }
}

