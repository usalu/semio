% 📄 Duplicates the topology and aggregates of #1 into #2 so a layout can write
% its geometry into a second name without touching the source hierarchy.
\cs_new_protected:Npn \semio_viz_hierarchy_copy:nn #1#2 {
  \str_if_eq:nnF {#1} {#2} {
    \seq_if_in:NnF \g_semio_viz_hierarchy_names_seq {#2}
      { \seq_gput_right:Nn \g_semio_viz_hierarchy_names_seq {#2} }
    \semio_viz_hierarchy_set:nnnn {#2} { n } { 0 } { \semio_viz_hierarchy_get:nnn {#1} { n } { 0 } }
    \semio_viz_hierarchy_set:nnnn {#2} { root } { 0 } { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } }
    \int_step_inline:nn { \semio_viz_hierarchy_get:nnn {#1} { n } { 0 } } {
      \clist_map_inline:nn { id, pi, si, dep, hgt, own, val } {
        \semio_viz_hierarchy_set:nnnn {#2} {####1} {##1} { \semio_viz_hierarchy_get:nnn {#1} {####1} {##1} }
      }
      \semio_viz_hierarchy_seq_reset:n { \semio_viz_hierarchy_kids:nn {#2} {##1} }
      \seq_gset_eq:cc { \semio_viz_hierarchy_kids:nn {#2} {##1} } { \semio_viz_hierarchy_kids:nn {#1} {##1} }
    }
    \semio_viz_hierarchy_seq_reset:n { \semio_viz_hierarchy_kids:nn {#2} { 0 } }
    \seq_gset_eq:cc { \semio_viz_hierarchy_kids:nn {#2} { 0 } } { \semio_viz_hierarchy_kids:nn {#1} { 0 } }
    \semio_viz_hierarchy_seq_reset:n { g_semio_viz_hierarchy_ #2 _pre_seq }
    \semio_viz_hierarchy_seq_reset:n { g_semio_viz_hierarchy_ #2 _post_seq }
    \seq_gset_eq:cc { g_semio_viz_hierarchy_ #2 _pre_seq } { g_semio_viz_hierarchy_ #1 _pre_seq }
    \seq_gset_eq:cc { g_semio_viz_hierarchy_ #2 _post_seq } { g_semio_viz_hierarchy_ #1 _post_seq }
  }
}
