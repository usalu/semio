%region 🔖️RenderKeys
% 📋 `semio / viz / hierarchy / render` -- the shared renderer of every hierarchy
% family. Each family documents which subset it exposes.
%   width, height     (canvas in millimetres)     default: the VizFigure frame
%   inset             (margin kept free)          default 4
%   orientation       (top-down, bottom-up, left-right, right-left, radial) default top-down
%   link              (straight, curved, orthogonal, radial, none) default straight
%   node              (circle, square, box, dot, none)  default circle
%   nodeRadius        (mm)                        default 1.4
%   nodeWidth         (mm, box nodes)             default 16
%   nodeHeight        (mm, box nodes)             default 6
%   labels            (bool)                      default true
%   labelColumn       (column with the caption)   default: the table's label role
%   fill              (depth, value, index, leaf, none) default depth
%   opacity           (0..1 fill opacity)         default 1
%   stroke            (colour name)               default semio-chrome-foreground
%   strokeWidth       (pt)                        default \semio@stroke@hairline
%   innerRadius       (mm, sunburst hole)         default 6
%   leafLabels        (bool, labels on leaves only) default false
\fp_new:N \l_semio_viz_hierarchy_rd_width_fp
\fp_new:N \l_semio_viz_hierarchy_rd_height_fp
\fp_new:N \l_semio_viz_hierarchy_rd_inset_fp
\fp_new:N \l_semio_viz_hierarchy_rd_radius_fp
\fp_new:N \l_semio_viz_hierarchy_rd_boxw_fp
\fp_new:N \l_semio_viz_hierarchy_rd_boxh_fp
\fp_new:N \l_semio_viz_hierarchy_rd_inner_fp
\fp_new:N \l_semio_viz_hierarchy_rd_opacity_fp
\tl_new:N \l_semio_viz_hierarchy_rd_orient_tl
\tl_new:N \l_semio_viz_hierarchy_rd_link_tl
\tl_new:N \l_semio_viz_hierarchy_rd_node_tl
\tl_new:N \l_semio_viz_hierarchy_rd_fill_tl
\tl_new:N \l_semio_viz_hierarchy_rd_stroke_tl
\tl_new:N \l_semio_viz_hierarchy_rd_strokewidth_tl
\tl_new:N \l_semio_viz_hierarchy_rd_labelcol_tl
\tl_new:N \l_semio_viz_hierarchy_rd_color_tl
\bool_new:N \l_semio_viz_hierarchy_rd_labels_bool
\bool_new:N \l_semio_viz_hierarchy_rd_leaflabels_bool
\fp_new:N \l_semio_viz_hierarchy_rd_px_fp
\fp_new:N \l_semio_viz_hierarchy_rd_py_fp
\fp_new:N \l_semio_viz_hierarchy_rd_qx_fp
\fp_new:N \l_semio_viz_hierarchy_rd_qy_fp

\keys_define:nn { semio / viz / hierarchy / render } {
  width       .fp_set:N = \l_semio_viz_hierarchy_rd_width_fp,
  height      .fp_set:N = \l_semio_viz_hierarchy_rd_height_fp,
  inset       .fp_set:N = \l_semio_viz_hierarchy_rd_inset_fp,
  orientation .tl_set:N = \l_semio_viz_hierarchy_rd_orient_tl,
  link        .tl_set:N = \l_semio_viz_hierarchy_rd_link_tl,
  node        .tl_set:N = \l_semio_viz_hierarchy_rd_node_tl,
  nodeRadius  .fp_set:N = \l_semio_viz_hierarchy_rd_radius_fp,
  nodeWidth   .fp_set:N = \l_semio_viz_hierarchy_rd_boxw_fp,
  nodeHeight  .fp_set:N = \l_semio_viz_hierarchy_rd_boxh_fp,
  labels      .bool_set:N = \l_semio_viz_hierarchy_rd_labels_bool,
  leafLabels  .bool_set:N = \l_semio_viz_hierarchy_rd_leaflabels_bool,
  labelColumn .tl_set:N = \l_semio_viz_hierarchy_rd_labelcol_tl,
  fill        .tl_set:N = \l_semio_viz_hierarchy_rd_fill_tl,
  opacity     .fp_set:N = \l_semio_viz_hierarchy_rd_opacity_fp,
  stroke      .tl_set:N = \l_semio_viz_hierarchy_rd_stroke_tl,
  strokeWidth .tl_set:N = \l_semio_viz_hierarchy_rd_strokewidth_tl,
  innerRadius .fp_set:N = \l_semio_viz_hierarchy_rd_inner_fp,
}

% ♻️ Puts every renderer key back to its documented default; the frame's own width and height win
% over the fallbacks whenever the renderer runs inside a figure.
\cs_new_protected:Npn \semio_viz_hierarchy_render_keys_reset: {
  \fp_set:Nn \l_semio_viz_hierarchy_rd_width_fp
    { \fp_compare:nNnTF { \l_semio_viz_width_fp } > { 0 } { \l_semio_viz_width_fp } { 80 } }
  \fp_set:Nn \l_semio_viz_hierarchy_rd_height_fp
    { \fp_compare:nNnTF { \l_semio_viz_height_fp } > { 0 } { \l_semio_viz_height_fp } { 45 } }
  \fp_set:Nn \l_semio_viz_hierarchy_rd_inset_fp { 4 }
  \tl_set:Nn \l_semio_viz_hierarchy_rd_orient_tl { top-down }
  \tl_set:Nn \l_semio_viz_hierarchy_rd_link_tl { straight }
  \tl_set:Nn \l_semio_viz_hierarchy_rd_node_tl { circle }
  \fp_set:Nn \l_semio_viz_hierarchy_rd_radius_fp { 1.4 }
  \fp_set:Nn \l_semio_viz_hierarchy_rd_boxw_fp { 16 }
  \fp_set:Nn \l_semio_viz_hierarchy_rd_boxh_fp { 6 }
  \bool_set_true:N \l_semio_viz_hierarchy_rd_labels_bool
  \bool_set_false:N \l_semio_viz_hierarchy_rd_leaflabels_bool
  \tl_clear:N \l_semio_viz_hierarchy_rd_labelcol_tl
  \tl_set:Nn \l_semio_viz_hierarchy_rd_fill_tl { depth }
  \fp_set:Nn \l_semio_viz_hierarchy_rd_opacity_fp { 1 }
  \tl_set:Nn \l_semio_viz_hierarchy_rd_stroke_tl { semio-chrome-foreground }
  \tl_set:Nn \l_semio_viz_hierarchy_rd_strokewidth_tl { \semio@stroke@hairline }
  \fp_set:Nn \l_semio_viz_hierarchy_rd_inner_fp { 6 }
}
%endregion 🔖️RenderKeys

%region 🔖️Render
% 📏 Canvas the layout is asked to fill, once the inset is taken off both sides.
\cs_new:Npn \semio_viz_hierarchy_canvas_x: {
  \fp_eval:n { max ( 1 , \l_semio_viz_hierarchy_rd_width_fp
    - 2 * \l_semio_viz_hierarchy_rd_inset_fp ) }
}
% 📏 The same in the other direction.
\cs_new:Npn \semio_viz_hierarchy_canvas_y: {
  \fp_eval:n { max ( 1 , \l_semio_viz_hierarchy_rd_height_fp
    - 2 * \l_semio_viz_hierarchy_rd_inset_fp ) }
}

% 🧭 Places one layout point on the TikZ canvas: the layout always works in a
% top-down (x across, y down) box, and the orientation key rotates or mirrors it.
\cs_new_protected:Npn \semio_viz_hierarchy_place:nnNN #1#2#3#4 {
  \str_case:VnF \l_semio_viz_hierarchy_rd_orient_tl {
    { top-down }   { \fp_set:Nn #3 { \l_semio_viz_hierarchy_rd_inset_fp + (#1) }
                     \fp_set:Nn #4 { - \l_semio_viz_hierarchy_rd_inset_fp - (#2) } }
    { bottom-up }  { \fp_set:Nn #3 { \l_semio_viz_hierarchy_rd_inset_fp + (#1) }
                     \fp_set:Nn #4 { - \l_semio_viz_hierarchy_rd_height_fp
                       + \l_semio_viz_hierarchy_rd_inset_fp + (#2) } }
    { left-right } { \fp_set:Nn #3 { \l_semio_viz_hierarchy_rd_inset_fp + (#2) }
                     \fp_set:Nn #4 { - \l_semio_viz_hierarchy_rd_inset_fp - (#1) } }
    { right-left } { \fp_set:Nn #3 { \l_semio_viz_hierarchy_rd_width_fp
                       - \l_semio_viz_hierarchy_rd_inset_fp - (#2) }
                     \fp_set:Nn #4 { - \l_semio_viz_hierarchy_rd_inset_fp - (#1) } }
    { radial }     { \fp_set:Nn #3 { \l_semio_viz_hierarchy_rd_width_fp / 2 + (#1) }
                     \fp_set:Nn #4 { - \l_semio_viz_hierarchy_rd_height_fp / 2 + (#2) } }
  }
  { \fp_set:Nn #3 { \l_semio_viz_hierarchy_rd_inset_fp + (#1) }
    \fp_set:Nn #4 { - \l_semio_viz_hierarchy_rd_inset_fp - (#2) } }
}

% 🎨 Fill colour of one node, following the `fill` key.
\cs_new_protected:Npn \semio_viz_hierarchy_node_color:n #1 {
  \str_case:VnF \l_semio_viz_hierarchy_rd_fill_tl {
    { depth } { \semio_viz_theme_color:nN
      { \semio_viz_hierarchy_get:nnn {#1} { dep } { \l_semio_viz_hierarchy_node_index_int } + 1 }
      \l_semio_viz_hierarchy_rd_color_tl }
    { index } { \semio_viz_theme_color:nN { \l_semio_viz_hierarchy_node_index_int }
      \l_semio_viz_hierarchy_rd_color_tl }
    { branch } { \semio_viz_theme_color:nN
      { \semio_viz_hierarchy_branch:nn {#1} { \l_semio_viz_hierarchy_node_index_int } }
      \l_semio_viz_hierarchy_rd_color_tl }
    { value } { \semio_viz_theme_color:nN
      { \fp_to_int:n { 1 + round ( \l_semio_viz_hierarchy_node_value_fp ) } }
      \l_semio_viz_hierarchy_rd_color_tl }
    { none } { \tl_set:Nn \l_semio_viz_hierarchy_rd_color_tl { semio-chrome-canvas } }
  }
  { \tl_set_eq:NN \l_semio_viz_hierarchy_rd_color_tl \l_semio_viz_hierarchy_rd_fill_tl }
}

% 🌿 Index of the depth-one ancestor of a node, so a whole branch shares a hue.
\cs_new:Npn \semio_viz_hierarchy_branch:nn #1#2 {
  \int_compare:nNnTF { \semio_viz_hierarchy_get:nnn {#1} { dep } {#2} } < { 2 }
    { \semio_viz_hierarchy_get:nnn {#1} { si } {#2} + 1 }
    { \semio_viz_hierarchy_branch:nn {#1} { \semio_viz_hierarchy_get:nnn {#1} { pi } {#2} } }
}

% 🔗 Draws one parent/child link in the style of the `link` key.
\cs_new_protected:Npn \semio_viz_hierarchy_link_draw:nnnnnn #1#2#3#4#5#6 {
  \str_case:VnF \l_semio_viz_hierarchy_rd_link_tl {
    { none } { }
    { straight } { \draw [ semio~viz~hierarchy~link ] (#3,#4) -- (#5,#6) ; }
    { curved } {
      \str_case:VnF \l_semio_viz_hierarchy_rd_orient_tl {
        { left-right } { \draw [ semio~viz~hierarchy~link ] (#3,#4)
          .. controls ( \fp_eval:n { ((#3)+(#5))/2 } , #4 )
          and ( \fp_eval:n { ((#3)+(#5))/2 } , #6 ) .. (#5,#6) ; }
        { right-left } { \draw [ semio~viz~hierarchy~link ] (#3,#4)
          .. controls ( \fp_eval:n { ((#3)+(#5))/2 } , #4 )
          and ( \fp_eval:n { ((#3)+(#5))/2 } , #6 ) .. (#5,#6) ; }
      }
      { \draw [ semio~viz~hierarchy~link ] (#3,#4)
        .. controls ( #3 , \fp_eval:n { ((#4)+(#6))/2 } )
        and ( #5 , \fp_eval:n { ((#4)+(#6))/2 } ) .. (#5,#6) ; }
    }
    { orthogonal } {
      \str_case:VnF \l_semio_viz_hierarchy_rd_orient_tl {
        { left-right } { \draw [ semio~viz~hierarchy~link ] (#3,#4)
          -- ( \fp_eval:n { ((#3)+(#5))/2 } , #4 )
          -- ( \fp_eval:n { ((#3)+(#5))/2 } , #6 ) -- (#5,#6) ; }
        { right-left } { \draw [ semio~viz~hierarchy~link ] (#3,#4)
          -- ( \fp_eval:n { ((#3)+(#5))/2 } , #4 )
          -- ( \fp_eval:n { ((#3)+(#5))/2 } , #6 ) -- (#5,#6) ; }
      }
      { \draw [ semio~viz~hierarchy~link ] (#3,#4)
        -- ( #3 , \fp_eval:n { ((#4)+(#6))/2 } )
        -- ( #5 , \fp_eval:n { ((#4)+(#6))/2 } ) -- (#5,#6) ; }
    }
    { radial } {
      \draw [ semio~viz~hierarchy~link ] (#3,#4)
        .. controls ( \fp_eval:n { ((#3)+(#5))/2 } , \fp_eval:n { ((#4)+(#6))/2 } )
        and ( \fp_eval:n { ((#3)+(#5))/2 } , \fp_eval:n { ((#4)+(#6))/2 } ) .. (#5,#6) ;
    }
  }
  { \draw [ semio~viz~hierarchy~link ] (#3,#4) -- (#5,#6) ; }
  \semio_viz_probe_geometry:nx { link/#2 } { #3 , #4 , #5 , #6 }
}

\tikzset{
  semio~viz~hierarchy~link/.style = {
    draw = semio-chrome-text-normal, line~width = \semio@stroke@hairline, line~cap = round,
  },
}

% 🏷️ Caption of one node: the label column when the table has one, else the id.
\cs_new_protected:Npn \semio_viz_hierarchy_label:nnN #1#2#3 {
  \tl_if_empty:NTF \l_semio_viz_hierarchy_rd_labelcol_tl
    { \tl_set_eq:NN #3 \l_semio_viz_hierarchy_node_id_tl }
    {
      \semio_viz_table_cell:nnnN {#1} {#2}
        { \l_semio_viz_hierarchy_rd_labelcol_tl } #3
      \tl_if_blank:VT #3 { \tl_set_eq:NN #3 \l_semio_viz_hierarchy_node_id_tl }
    }
}
%endregion 🔖️Render

%region 🔖️RenderNodes
\tl_new:N \l_semio_viz_hierarchy_rd_text_tl
\fp_new:N \l_semio_viz_hierarchy_rd_ax_fp
\fp_new:N \l_semio_viz_hierarchy_rd_ay_fp
\fp_new:N \l_semio_viz_hierarchy_rd_bx_fp
\fp_new:N \l_semio_viz_hierarchy_rd_by_fp

% 🔗 Draws every parent/child link of a laid-out hierarchy.
\cs_new_protected:Npn \semio_viz_hierarchy_draw_links:n #1 {
  \str_if_eq:VnF \l_semio_viz_hierarchy_rd_link_tl { none } {
    \semio_viz_hierarchy_map_links:nn {#1} {
      \semio_viz_hierarchy_place:nnNN
        { \semio_viz_hierarchy_get:nnn {#1} { x } { \l_semio_viz_hierarchy_source_int } }
        { \semio_viz_hierarchy_get:nnn {#1} { y } { \l_semio_viz_hierarchy_source_int } }
        \l_semio_viz_hierarchy_rd_ax_fp \l_semio_viz_hierarchy_rd_ay_fp
      \semio_viz_hierarchy_place:nnNN
        { \semio_viz_hierarchy_get:nnn {#1} { x } { \l_semio_viz_hierarchy_target_int } }
        { \semio_viz_hierarchy_get:nnn {#1} { y } { \l_semio_viz_hierarchy_target_int } }
        \l_semio_viz_hierarchy_rd_bx_fp \l_semio_viz_hierarchy_rd_by_fp
      \use:x {
        \exp_not:N \semio_viz_hierarchy_link_draw:nnnnnn {#1}
          { \l_semio_viz_hierarchy_rd_link_tl }
          { \fp_use:N \l_semio_viz_hierarchy_rd_ax_fp }
          { \fp_use:N \l_semio_viz_hierarchy_rd_ay_fp }
          { \fp_use:N \l_semio_viz_hierarchy_rd_bx_fp }
          { \fp_use:N \l_semio_viz_hierarchy_rd_by_fp }
      }
    }
  }
}

% ⚫ Draws the node marks and their captions of a laid-out hierarchy; #2 is the
% source table the label column is read from.
\cs_new_protected:Npn \semio_viz_hierarchy_draw_nodes:nn #1#2 {
  \semio_viz_hierarchy_map_nodes:nn {#1} {
    \semio_viz_hierarchy_node_color:n {#1}
    \semio_viz_hierarchy_place:nnNN { \l_semio_viz_hierarchy_node_x_fp }
      { \l_semio_viz_hierarchy_node_y_fp }
      \l_semio_viz_hierarchy_rd_px_fp \l_semio_viz_hierarchy_rd_py_fp
    \semio_viz_hierarchy_label:nnN {#2} {##1} \l_semio_viz_hierarchy_rd_text_tl
    \str_case:VnF \l_semio_viz_hierarchy_rd_node_tl {
      { none } { }
      { circle } {
        \use:x { \exp_not:N \fill [ \l_semio_viz_hierarchy_rd_color_tl ,
          draw = \l_semio_viz_hierarchy_rd_stroke_tl ,
          line~width = \l_semio_viz_hierarchy_rd_strokewidth_tl ,
          fill~opacity = \fp_use:N \l_semio_viz_hierarchy_rd_opacity_fp ]
          ( \fp_use:N \l_semio_viz_hierarchy_rd_px_fp ,
            \fp_use:N \l_semio_viz_hierarchy_rd_py_fp )
          circle [ radius = \fp_use:N \l_semio_viz_hierarchy_rd_radius_fp ] ; }
      }
      { dot } {
        \use:x { \exp_not:N \fill [ \l_semio_viz_hierarchy_rd_color_tl ]
          ( \fp_use:N \l_semio_viz_hierarchy_rd_px_fp ,
            \fp_use:N \l_semio_viz_hierarchy_rd_py_fp )
          circle [ radius = \fp_eval:n { \l_semio_viz_hierarchy_rd_radius_fp / 2 } ] ; }
      }
      { square } {
        \use:x { \exp_not:N \fill [ \l_semio_viz_hierarchy_rd_color_tl ,
          draw = \l_semio_viz_hierarchy_rd_stroke_tl ,
          line~width = \l_semio_viz_hierarchy_rd_strokewidth_tl ]
          ( \fp_eval:n { \l_semio_viz_hierarchy_rd_px_fp - \l_semio_viz_hierarchy_rd_radius_fp } ,
            \fp_eval:n { \l_semio_viz_hierarchy_rd_py_fp - \l_semio_viz_hierarchy_rd_radius_fp } )
          rectangle
          ( \fp_eval:n { \l_semio_viz_hierarchy_rd_px_fp + \l_semio_viz_hierarchy_rd_radius_fp } ,
            \fp_eval:n { \l_semio_viz_hierarchy_rd_py_fp + \l_semio_viz_hierarchy_rd_radius_fp } ) ; }
      }
      { box } { \semio_viz_hierarchy_draw_box: }
    }
    { \semio_viz_hierarchy_draw_box: }
    \semio_viz_probe_geometry:xx { node/ \l_semio_viz_hierarchy_rd_node_tl }
      { \l_semio_viz_hierarchy_node_id_tl ,
        \fp_use:N \l_semio_viz_hierarchy_rd_px_fp ,
        \fp_use:N \l_semio_viz_hierarchy_rd_py_fp ,
        \str_if_eq:VnTF \l_semio_viz_hierarchy_rd_node_tl { box }
          { \fp_use:N \l_semio_viz_hierarchy_rd_boxw_fp ,
            \fp_use:N \l_semio_viz_hierarchy_rd_boxh_fp }
          { \fp_use:N \l_semio_viz_hierarchy_rd_radius_fp ,
            \fp_use:N \l_semio_viz_hierarchy_rd_radius_fp } }
    \bool_lazy_and:nnT { \l_semio_viz_hierarchy_rd_labels_bool }
      { ! \str_if_eq_p:Vn \l_semio_viz_hierarchy_rd_node_tl { box } } {
      \bool_lazy_or:nnT { ! \l_semio_viz_hierarchy_rd_leaflabels_bool }
        { \l_semio_viz_hierarchy_node_leaf_bool }
        { \semio_viz_hierarchy_draw_caption: }
    }
  }
}

% 🔤 Caption beside a node mark, kept clear of the mark itself.
\cs_new_protected:Npn \semio_viz_hierarchy_draw_caption: {
  \use:x { \exp_not:N \node [ font = \exp_not:N \scriptsize ,
    text = semio-chrome-foreground , inner~sep = 0pt ,
    \str_case:VnF \l_semio_viz_hierarchy_rd_orient_tl {
      { left-right } { anchor = west , xshift = 1.2mm }
      { right-left } { anchor = east , xshift = -1.2mm }
      { bottom-up }  { anchor = south , yshift = 1.2mm }
    } { anchor = north , yshift = -1.2mm } ]
    at ( \fp_use:N \l_semio_viz_hierarchy_rd_px_fp ,
         \fp_use:N \l_semio_viz_hierarchy_rd_py_fp )
    { \exp_not:V \l_semio_viz_hierarchy_rd_text_tl } ; }
}

% 🗃️ A labelled box node, the organisation-chart and family-tree mark.
\cs_new_protected:Npn \semio_viz_hierarchy_draw_box: {
  \use:x { \exp_not:N \node [ draw = \l_semio_viz_hierarchy_rd_stroke_tl ,
    fill = \l_semio_viz_hierarchy_rd_color_tl ,
    fill~opacity = \fp_use:N \l_semio_viz_hierarchy_rd_opacity_fp ,
    line~width = \l_semio_viz_hierarchy_rd_strokewidth_tl ,
    rounded~corners = 0.6mm , inner~sep = 0.6mm ,
    minimum~width = \fp_use:N \l_semio_viz_hierarchy_rd_boxw_fp mm ,
    minimum~height = \fp_use:N \l_semio_viz_hierarchy_rd_boxh_fp mm ,
    font = \exp_not:N \scriptsize , text = semio-chrome-foreground , align = center ]
    at ( \fp_use:N \l_semio_viz_hierarchy_rd_px_fp ,
         \fp_use:N \l_semio_viz_hierarchy_rd_py_fp )
    { \exp_not:V \l_semio_viz_hierarchy_rd_text_tl } ; }
}

% 🟦 Draws the rectangle of every node of a treemap or partition layout, and the
% polygon instead when the voronoi tiling left one on the node.
\cs_new_protected:Npn \semio_viz_hierarchy_draw_rects:nnn #1#2#3 {
  \semio_viz_hierarchy_map_nodes:nn {#1} {
    \int_compare:nNnT { \l_semio_viz_hierarchy_node_depth_int } > { #3 - 1 } {
      \semio_viz_hierarchy_node_color:n {#1}
      \semio_viz_hierarchy_label:nnN {#2} {##1} \l_semio_viz_hierarchy_rd_text_tl
      \clist_set:Nx \l_semio_viz_hierarchy_rd_poly_clist
        { \semio_viz_hierarchy_get:nnn {#1} { poly } {##1} }
      \clist_if_empty:NTF \l_semio_viz_hierarchy_rd_poly_clist
        { \semio_viz_hierarchy_draw_rect:nn {#1} {##1} }
        { \semio_viz_hierarchy_draw_poly:nn {#1} {##1} }
    }
  }
}

% ▭ Node #2 of hierarchy #1 as a rectangle: its two layout corners placed under the orientation.
\cs_new_protected:Npn \semio_viz_hierarchy_draw_rect:nn #1#2 {
  \semio_viz_hierarchy_place:nnNN { \l_semio_viz_hierarchy_node_xa_fp }
    { \l_semio_viz_hierarchy_node_ya_fp }
    \l_semio_viz_hierarchy_rd_ax_fp \l_semio_viz_hierarchy_rd_ay_fp
  \semio_viz_hierarchy_place:nnNN { \l_semio_viz_hierarchy_node_xb_fp }
    { \l_semio_viz_hierarchy_node_yb_fp }
    \l_semio_viz_hierarchy_rd_bx_fp \l_semio_viz_hierarchy_rd_by_fp
  \use:x { \exp_not:N \fill [ \l_semio_viz_hierarchy_rd_color_tl ,
    draw = \l_semio_viz_hierarchy_rd_stroke_tl ,
    line~width = \l_semio_viz_hierarchy_rd_strokewidth_tl ,
    fill~opacity = \fp_use:N \l_semio_viz_hierarchy_rd_opacity_fp ]
    ( \fp_use:N \l_semio_viz_hierarchy_rd_ax_fp ,
      \fp_use:N \l_semio_viz_hierarchy_rd_ay_fp ) rectangle
    ( \fp_use:N \l_semio_viz_hierarchy_rd_bx_fp ,
      \fp_use:N \l_semio_viz_hierarchy_rd_by_fp ) ; }
  \semio_viz_probe_geometry:nx { rect }
    { \l_semio_viz_hierarchy_node_id_tl ,
      \fp_use:N \l_semio_viz_hierarchy_node_xa_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_ya_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_xb_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_yb_fp }
  \bool_if:NT \l_semio_viz_hierarchy_rd_labels_bool {
    \fp_compare:nNnT
      { ( \l_semio_viz_hierarchy_node_xb_fp - \l_semio_viz_hierarchy_node_xa_fp )
      * ( \l_semio_viz_hierarchy_node_yb_fp - \l_semio_viz_hierarchy_node_ya_fp ) } > { 24 } {
      \use:x { \exp_not:N \node [ font = \exp_not:N \scriptsize , inner~sep = 0pt ,
        text = semio-chrome-foreground , anchor = north~west ]
        at ( \fp_eval:n { min ( \l_semio_viz_hierarchy_rd_ax_fp ,
               \l_semio_viz_hierarchy_rd_bx_fp ) + 0.8 } ,
             \fp_eval:n { max ( \l_semio_viz_hierarchy_rd_ay_fp ,
               \l_semio_viz_hierarchy_rd_by_fp ) - 0.8 } )
        { \exp_not:V \l_semio_viz_hierarchy_rd_text_tl } ; }
    }
  }
}

\clist_new:N \l_semio_viz_hierarchy_rd_poly_clist
\int_new:N \l_semio_viz_hierarchy_rd_m_int

\tl_new:N \l_semio_viz_hierarchy_rd_path_tl

% ⬟ Node #2 of hierarchy #1 as a polygon, for the tilings whose cells are not rectangles.
\cs_new_protected:Npn \semio_viz_hierarchy_draw_poly:nn #1#2 {
  \int_set:Nn \l_semio_viz_hierarchy_rd_m_int
    { \clist_count:N \l_semio_viz_hierarchy_rd_poly_clist / 2 }
  \int_compare:nNnT { \l_semio_viz_hierarchy_rd_m_int } > { 2 } {
    \tl_clear:N \l_semio_viz_hierarchy_rd_path_tl
    \int_step_inline:nn { \l_semio_viz_hierarchy_rd_m_int } {
      \semio_viz_hierarchy_place:nnNN
        { \clist_item:Nn \l_semio_viz_hierarchy_rd_poly_clist { \int_eval:n { 2 * ##1 - 1 } } }
        { \clist_item:Nn \l_semio_viz_hierarchy_rd_poly_clist { \int_eval:n { 2 * ##1 } } }
        \l_semio_viz_hierarchy_rd_ax_fp \l_semio_viz_hierarchy_rd_ay_fp
      \tl_put_right:Nx \l_semio_viz_hierarchy_rd_path_tl
        { ( \fp_use:N \l_semio_viz_hierarchy_rd_ax_fp ,
            \fp_use:N \l_semio_viz_hierarchy_rd_ay_fp ) -- }
    }
    \use:x { \exp_not:N \fill [ \l_semio_viz_hierarchy_rd_color_tl ,
      draw = \l_semio_viz_hierarchy_rd_stroke_tl ,
      line~width = \l_semio_viz_hierarchy_rd_strokewidth_tl ,
      fill~opacity = \fp_use:N \l_semio_viz_hierarchy_rd_opacity_fp ]
      \exp_not:V \l_semio_viz_hierarchy_rd_path_tl cycle ; }
    \semio_viz_probe_geometry:nx { polygon }
      { \l_semio_viz_hierarchy_node_id_tl , \l_semio_viz_hierarchy_rd_poly_clist }
  }
}

% 🌈 Draws one annular sector per node of a radial partition (the sunburst mark).
\cs_new_protected:Npn \semio_viz_hierarchy_draw_arcs:nnn #1#2#3 {
  \semio_viz_hierarchy_map_nodes:nn {#1} {
    \int_compare:nNnT { \l_semio_viz_hierarchy_node_depth_int } > { #3 - 1 } {
      \semio_viz_hierarchy_node_color:n {#1}
      \fp_set:Nn \l_semio_viz_hierarchy_rd_ax_fp
        { \l_semio_viz_hierarchy_node_xa_fp * 180 / pi }
      \fp_set:Nn \l_semio_viz_hierarchy_rd_bx_fp
        { \l_semio_viz_hierarchy_node_xb_fp * 180 / pi }
      \fp_set:Nn \l_semio_viz_hierarchy_rd_ay_fp
        { \l_semio_viz_hierarchy_rd_inner_fp + \l_semio_viz_hierarchy_node_ya_fp }
      \fp_set:Nn \l_semio_viz_hierarchy_rd_by_fp
        { \l_semio_viz_hierarchy_rd_inner_fp + \l_semio_viz_hierarchy_node_yb_fp }
      \fp_compare:nNnT { \l_semio_viz_hierarchy_rd_bx_fp - \l_semio_viz_hierarchy_rd_ax_fp }
        > { 0.05 } {
        \use:x { \exp_not:N \fill [ \l_semio_viz_hierarchy_rd_color_tl ,
          draw = \l_semio_viz_hierarchy_rd_stroke_tl ,
          line~width = \l_semio_viz_hierarchy_rd_strokewidth_tl ,
          fill~opacity = \fp_use:N \l_semio_viz_hierarchy_rd_opacity_fp ,
          shift = { ( \fp_eval:n { \l_semio_viz_hierarchy_rd_width_fp / 2 } ,
                      \fp_eval:n { - \l_semio_viz_hierarchy_rd_height_fp / 2 } ) } ]
          ( \fp_eval:n { 90 - \l_semio_viz_hierarchy_rd_ax_fp } \c_colon_str
            \fp_use:N \l_semio_viz_hierarchy_rd_ay_fp )
          arc [ start~angle = \fp_eval:n { 90 - \l_semio_viz_hierarchy_rd_ax_fp } ,
                end~angle = \fp_eval:n { 90 - \l_semio_viz_hierarchy_rd_bx_fp } ,
                radius = \fp_use:N \l_semio_viz_hierarchy_rd_ay_fp ]
          -- ( \fp_eval:n { 90 - \l_semio_viz_hierarchy_rd_bx_fp } \c_colon_str
               \fp_use:N \l_semio_viz_hierarchy_rd_by_fp )
          arc [ start~angle = \fp_eval:n { 90 - \l_semio_viz_hierarchy_rd_bx_fp } ,
                end~angle = \fp_eval:n { 90 - \l_semio_viz_hierarchy_rd_ax_fp } ,
                radius = \fp_use:N \l_semio_viz_hierarchy_rd_by_fp ]
          -- cycle ; }
        \semio_viz_probe_geometry:nx { arc }
          { \l_semio_viz_hierarchy_node_id_tl ,
            \fp_use:N \l_semio_viz_hierarchy_node_xa_fp ,
            \fp_use:N \l_semio_viz_hierarchy_node_xb_fp ,
            \fp_use:N \l_semio_viz_hierarchy_rd_ay_fp ,
            \fp_use:N \l_semio_viz_hierarchy_rd_by_fp }
      }
    }
  }
}

% ⭕ Draws the circle of every node of a pack layout.
\cs_new_protected:Npn \semio_viz_hierarchy_draw_circles:nnn #1#2#3 {
  \semio_viz_hierarchy_map_nodes:nn {#1} {
    \int_compare:nNnT { \l_semio_viz_hierarchy_node_depth_int } > { #3 - 1 } {
      \semio_viz_hierarchy_node_color:n {#1}
      \semio_viz_hierarchy_label:nnN {#2} {##1} \l_semio_viz_hierarchy_rd_text_tl
      \fp_set:Nn \l_semio_viz_hierarchy_rd_px_fp
        { \l_semio_viz_hierarchy_rd_inset_fp + \l_semio_viz_hierarchy_node_x_fp }
      \fp_set:Nn \l_semio_viz_hierarchy_rd_py_fp
        { - \l_semio_viz_hierarchy_rd_inset_fp - \l_semio_viz_hierarchy_node_y_fp }
      \use:x { \exp_not:N \fill [ \l_semio_viz_hierarchy_rd_color_tl ,
        draw = \l_semio_viz_hierarchy_rd_stroke_tl ,
        line~width = \l_semio_viz_hierarchy_rd_strokewidth_tl ,
        fill~opacity = \fp_eval:n { \l_semio_viz_hierarchy_rd_opacity_fp
          * \bool_if:NTF \l_semio_viz_hierarchy_node_leaf_bool { 1 } { 0.35 } } ]
        ( \fp_use:N \l_semio_viz_hierarchy_rd_px_fp ,
          \fp_use:N \l_semio_viz_hierarchy_rd_py_fp )
        circle [ radius = \fp_use:N \l_semio_viz_hierarchy_node_r_fp ] ; }
      \semio_viz_probe_geometry:nx { circle }
        { \l_semio_viz_hierarchy_node_id_tl ,
          \fp_use:N \l_semio_viz_hierarchy_node_x_fp ,
          \fp_use:N \l_semio_viz_hierarchy_node_y_fp ,
          \fp_use:N \l_semio_viz_hierarchy_node_r_fp }
      \bool_lazy_and:nnT { \l_semio_viz_hierarchy_rd_labels_bool }
        { \l_semio_viz_hierarchy_node_leaf_bool } {
        \fp_compare:nNnT { \l_semio_viz_hierarchy_node_r_fp } > { 3 } {
          \use:x { \exp_not:N \node [ font = \exp_not:N \scriptsize , inner~sep = 0pt ,
            text = semio-chrome-foreground ]
            at ( \fp_use:N \l_semio_viz_hierarchy_rd_px_fp ,
                 \fp_use:N \l_semio_viz_hierarchy_rd_py_fp )
            { \exp_not:V \l_semio_viz_hierarchy_rd_text_tl } ; }
        }
      }
    }
  }
}
