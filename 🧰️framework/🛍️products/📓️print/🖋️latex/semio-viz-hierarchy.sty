% 📏 Splits a `{w,h}` pair into the two extent variables.
\cs_new_protected:Npn \semio_viz_hierarchy_pair:nNN #1#2#3 {
  \clist_set:Nn \l_semio_viz_hierarchy_pair_clist {#1}
  \fp_set:Nn #2 { \clist_item:Nn \l_semio_viz_hierarchy_pair_clist { 1 } }
  \fp_set:Nn #3 { \clist_item:Nn \l_semio_viz_hierarchy_pair_clist { 2 } }
}

% 🔑 The layout options every taxonomy 78 hierarchy layout shares, `semio / viz / hierarchy /
% layout`: the box it fills or the node size it repeats, the separation and padding it keeps, the
% tiling and packing rules, and whether it is laid out radially.
\keys_define:nn { semio / viz / hierarchy / layout } {
  size .code:n = {
    \semio_viz_hierarchy_pair:nNN {#1} \l_semio_viz_hierarchy_dx_fp \l_semio_viz_hierarchy_dy_fp
    \bool_set_true:N \l_semio_viz_hierarchy_size_given_bool
    \bool_set_false:N \l_semio_viz_hierarchy_nodesize_bool
  },
  nodeSize .code:n = {
    \semio_viz_hierarchy_pair:nNN {#1} \l_semio_viz_hierarchy_dx_fp \l_semio_viz_hierarchy_dy_fp
    \bool_set_true:N \l_semio_viz_hierarchy_size_given_bool
    \bool_set_true:N \l_semio_viz_hierarchy_nodesize_bool
  },
  separationSame  .fp_set:N = \l_semio_viz_hierarchy_sep_same_fp,
  separationOther .fp_set:N = \l_semio_viz_hierarchy_sep_other_fp,
  separationDepth .bool_set:N = \l_semio_viz_hierarchy_sep_depth_bool,
  tile  .tl_set:N = \l_semio_viz_hierarchy_tile_tl,
  ratio .fp_set:N = \l_semio_viz_hierarchy_ratio_fp,
  padding .code:n = {
    \fp_set:Nn \l_semio_viz_hierarchy_padding_fp {#1}
    \fp_set:Nn \l_semio_viz_hierarchy_pad_inner_fp {#1}
    \fp_set:Nn \l_semio_viz_hierarchy_pad_top_fp {#1}
    \fp_set:Nn \l_semio_viz_hierarchy_pad_right_fp {#1}
    \fp_set:Nn \l_semio_viz_hierarchy_pad_bottom_fp {#1}
    \fp_set:Nn \l_semio_viz_hierarchy_pad_left_fp {#1}
  },
  paddingInner .fp_set:N = \l_semio_viz_hierarchy_pad_inner_fp,
  paddingOuter .code:n = {
    \fp_set:Nn \l_semio_viz_hierarchy_pad_top_fp {#1}
    \fp_set:Nn \l_semio_viz_hierarchy_pad_right_fp {#1}
    \fp_set:Nn \l_semio_viz_hierarchy_pad_bottom_fp {#1}
    \fp_set:Nn \l_semio_viz_hierarchy_pad_left_fp {#1}
  },
  paddingTop    .fp_set:N = \l_semio_viz_hierarchy_pad_top_fp,
  paddingRight  .fp_set:N = \l_semio_viz_hierarchy_pad_right_fp,
  paddingBottom .fp_set:N = \l_semio_viz_hierarchy_pad_bottom_fp,
  paddingLeft   .fp_set:N = \l_semio_viz_hierarchy_pad_left_fp,
  round      .bool_set:N = \l_semio_viz_hierarchy_round_bool,
  radius     .tl_set:N = \l_semio_viz_hierarchy_radius_tl,
  relaxation .int_set:N = \l_semio_viz_hierarchy_relax_int,
  radial       .bool_set:N = \l_semio_viz_hierarchy_radial_bool,
  radialOffset .fp_set:N = \l_semio_viz_hierarchy_radial_offset_fp,
}

% ♻️ Puts every shared layout key back to its documented default before an option list is read.
\cs_new_protected:Npn \semio_viz_hierarchy_layout_keys_reset: {
  \fp_set:Nn \l_semio_viz_hierarchy_dx_fp { 1 }
  \fp_set:Nn \l_semio_viz_hierarchy_dy_fp { 1 }
  \bool_set_false:N \l_semio_viz_hierarchy_nodesize_bool
  \bool_set_false:N \l_semio_viz_hierarchy_size_given_bool
  \bool_set_false:N \l_semio_viz_hierarchy_radial_bool
  \fp_zero:N \l_semio_viz_hierarchy_radial_offset_fp
  \fp_set:Nn \l_semio_viz_hierarchy_sep_same_fp { 1 }
  \fp_set:Nn \l_semio_viz_hierarchy_sep_other_fp { 2 }
  \bool_set_false:N \l_semio_viz_hierarchy_sep_depth_bool
  \tl_set:Nn \l_semio_viz_hierarchy_tile_tl { squarify }
  \fp_set:Nn \l_semio_viz_hierarchy_ratio_fp { (1 + sqrt(5)) / 2 }
  \fp_zero:N \l_semio_viz_hierarchy_padding_fp
  \fp_zero:N \l_semio_viz_hierarchy_pad_inner_fp
  \fp_zero:N \l_semio_viz_hierarchy_pad_top_fp
  \fp_zero:N \l_semio_viz_hierarchy_pad_right_fp
  \fp_zero:N \l_semio_viz_hierarchy_pad_bottom_fp
  \fp_zero:N \l_semio_viz_hierarchy_pad_left_fp
  \bool_set_false:N \l_semio_viz_hierarchy_round_bool
  \tl_set:Nn \l_semio_viz_hierarchy_radius_tl { auto }
  \int_set:Nn \l_semio_viz_hierarchy_relax_int { 24 }
}
%endregion 🔖️LayoutKeys

%region 🔖️LayoutTree
% 📐 d3 `defaultSeparation` (1 between siblings, 2 otherwise), optionally divided
% by the depth the way d3's commented-out `radialSeparation` does.
\cs_new:Npn \semio_viz_hierarchy_sep:nnn #1#2#3 {
  ( \int_compare:nNnTF { \semio_viz_hierarchy_get:nnn {#1} { pi } {#2} } =
      { \semio_viz_hierarchy_get:nnn {#1} { pi } {#3} }
      { \l_semio_viz_hierarchy_sep_same_fp } { \l_semio_viz_hierarchy_sep_other_fp } )
  \bool_if:NT \l_semio_viz_hierarchy_sep_depth_bool
    { / max ( 1 , \semio_viz_hierarchy_get:nnn {#1} { dep } {#2} ) }
}

% ⬅️ d3 `nextLeft`: leftmost child, else the thread.
\cs_new:Npn \semio_viz_hierarchy_next_left:nn #1#2 {
  \int_compare:nNnTF { \semio_viz_hierarchy_nk:nn {#1} {#2} } > { 0 }
    { \semio_viz_hierarchy_kid:nnn {#1} {#2} { 1 } }
    { \semio_viz_hierarchy_get:nnn {#1} { tt } {#2} }
}
% ➡️ d3 `nextRight`: rightmost child, else the thread.
\cs_new:Npn \semio_viz_hierarchy_next_right:nn #1#2 {
  \int_compare:nNnTF { \semio_viz_hierarchy_nk:nn {#1} {#2} } > { 0 }
    { \semio_viz_hierarchy_kid:nnn {#1} {#2} { \semio_viz_hierarchy_nk:nn {#1} {#2} } }
    { \semio_viz_hierarchy_get:nnn {#1} { tt } {#2} }
}

\int_new:N \l_semio_viz_hierarchy_tw_p_int
\int_new:N \l_semio_viz_hierarchy_tw_w_int
\int_new:N \l_semio_viz_hierarchy_tw_anc_int
\int_new:N \l_semio_viz_hierarchy_tw_vip_int
\int_new:N \l_semio_viz_hierarchy_tw_vop_int
\int_new:N \l_semio_viz_hierarchy_tw_vim_int
\int_new:N \l_semio_viz_hierarchy_tw_vom_int
\int_new:N \l_semio_viz_hierarchy_tw_wm_int
\int_new:N \l_semio_viz_hierarchy_tw_left_int
\int_new:N \l_semio_viz_hierarchy_tw_right_int
\int_new:N \l_semio_viz_hierarchy_tw_bottom_int
\fp_new:N \l_semio_viz_hierarchy_tw_mid_fp
\fp_new:N \l_semio_viz_hierarchy_tw_shift_fp
\fp_new:N \l_semio_viz_hierarchy_tw_change_fp
\fp_new:N \l_semio_viz_hierarchy_tw_sip_fp
\fp_new:N \l_semio_viz_hierarchy_tw_sop_fp
\fp_new:N \l_semio_viz_hierarchy_tw_sim_fp
\fp_new:N \l_semio_viz_hierarchy_tw_som_fp
\fp_new:N \l_semio_viz_hierarchy_tw_s_fp
\fp_new:N \l_semio_viz_hierarchy_tw_tx_fp
\fp_new:N \l_semio_viz_hierarchy_tw_kx_fp
\fp_new:N \l_semio_viz_hierarchy_tw_ky_fp
\bool_new:N \l_semio_viz_hierarchy_tw_loop_bool

% ↔️ d3 `executeShifts`: distributes the accumulated shifts over the children.
\cs_new_protected:Npn \semio_viz_hierarchy_tree_shifts:nn #1#2 {
  \fp_zero:N \l_semio_viz_hierarchy_tw_shift_fp
  \fp_zero:N \l_semio_viz_hierarchy_tw_change_fp
  \int_step_inline:nnnn { \semio_viz_hierarchy_nk:nn {#1} {#2} } { -1 } { 1 } {
    \int_set:Nn \l_semio_viz_hierarchy_k_int { \semio_viz_hierarchy_kid:nnn {#1} {#2} {##1} }
    \semio_viz_hierarchy_set:nnnn {#1} { tz } { \l_semio_viz_hierarchy_k_int }
      { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tz } { \l_semio_viz_hierarchy_k_int }
        + \l_semio_viz_hierarchy_tw_shift_fp } }
    \semio_viz_hierarchy_set:nnnn {#1} { tm } { \l_semio_viz_hierarchy_k_int }
      { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_k_int }
        + \l_semio_viz_hierarchy_tw_shift_fp } }
    \fp_add:Nn \l_semio_viz_hierarchy_tw_change_fp
      { \semio_viz_hierarchy_get:nnn {#1} { tc } { \l_semio_viz_hierarchy_k_int } }
    \fp_add:Nn \l_semio_viz_hierarchy_tw_shift_fp
      { \semio_viz_hierarchy_get:nnn {#1} { ts } { \l_semio_viz_hierarchy_k_int }
        + \l_semio_viz_hierarchy_tw_change_fp }
  }
}

% 🚚 d3 `moveSubtree`: shifts the subtree at #3 and prepares the smaller shifts.
\cs_new_protected:Npn \semio_viz_hierarchy_tree_move:nnnn #1#2#3#4 {
  \fp_set:Nn \l_semio_viz_hierarchy_tw_change_fp
    { (#4) / ( \semio_viz_hierarchy_get:nnn {#1} { si } {#3}
             - \semio_viz_hierarchy_get:nnn {#1} { si } {#2} ) }
  \semio_viz_hierarchy_set:nnnn {#1} { tc } {#3}
    { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tc } {#3} - \l_semio_viz_hierarchy_tw_change_fp } }
  \semio_viz_hierarchy_set:nnnn {#1} { ts } {#3}
    { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { ts } {#3} + (#4) } }
  \semio_viz_hierarchy_set:nnnn {#1} { tc } {#2}
    { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tc } {#2} + \l_semio_viz_hierarchy_tw_change_fp } }
  \semio_viz_hierarchy_set:nnnn {#1} { tz } {#3}
    { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tz } {#3} + (#4) } }
  \semio_viz_hierarchy_set:nnnn {#1} { tm } {#3}
    { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tm } {#3} + (#4) } }
}

% 🧵 d3 `apportion`: walks the inside contours of the left and right subtrees,
% threading them and moving whole subtrees apart on conflict.
\cs_new_protected:Npn \semio_viz_hierarchy_tree_apportion:nnn #1#2#3 {
  \int_compare:nNnT {#3} > { 0 } {
    \int_set:Nn \l_semio_viz_hierarchy_tw_vip_int {#2}
    \int_set:Nn \l_semio_viz_hierarchy_tw_vop_int {#2}
    \int_set:Nn \l_semio_viz_hierarchy_tw_vim_int {#3}
    \int_set:Nn \l_semio_viz_hierarchy_tw_vom_int
      { \semio_viz_hierarchy_kid:nnn {#1} { \semio_viz_hierarchy_get:nnn {#1} { pi } {#2} } { 1 } }
    \fp_set:Nn \l_semio_viz_hierarchy_tw_sip_fp
      { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vip_int } }
    \fp_set:Nn \l_semio_viz_hierarchy_tw_sop_fp
      { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vop_int } }
    \fp_set:Nn \l_semio_viz_hierarchy_tw_sim_fp
      { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vim_int } }
    \fp_set:Nn \l_semio_viz_hierarchy_tw_som_fp
      { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vom_int } }
    \bool_set_true:N \l_semio_viz_hierarchy_tw_loop_bool
    \bool_while_do:Nn \l_semio_viz_hierarchy_tw_loop_bool {
      \int_set:Nn \l_semio_viz_hierarchy_tw_vim_int
        { \semio_viz_hierarchy_next_right:nn {#1} { \l_semio_viz_hierarchy_tw_vim_int } }
      \int_set:Nn \l_semio_viz_hierarchy_tw_vip_int
        { \semio_viz_hierarchy_next_left:nn {#1} { \l_semio_viz_hierarchy_tw_vip_int } }
      \bool_set:Nn \l_semio_viz_hierarchy_tw_loop_bool
        { \int_compare_p:nNn { \l_semio_viz_hierarchy_tw_vim_int } > { 0 }
          && \int_compare_p:nNn { \l_semio_viz_hierarchy_tw_vip_int } > { 0 } }
      \bool_if:NT \l_semio_viz_hierarchy_tw_loop_bool {
        \int_set:Nn \l_semio_viz_hierarchy_tw_vom_int
          { \semio_viz_hierarchy_next_left:nn {#1} { \l_semio_viz_hierarchy_tw_vom_int } }
        \int_set:Nn \l_semio_viz_hierarchy_tw_vop_int
          { \semio_viz_hierarchy_next_right:nn {#1} { \l_semio_viz_hierarchy_tw_vop_int } }
        \semio_viz_hierarchy_set:nnnn {#1} { ta } { \l_semio_viz_hierarchy_tw_vop_int } { \int_eval:n {#2} }
        \fp_set:Nn \l_semio_viz_hierarchy_tw_shift_fp {
          \semio_viz_hierarchy_get:nnn {#1} { tz } { \l_semio_viz_hierarchy_tw_vim_int }
          + \l_semio_viz_hierarchy_tw_sim_fp
          - \semio_viz_hierarchy_get:nnn {#1} { tz } { \l_semio_viz_hierarchy_tw_vip_int }
          - \l_semio_viz_hierarchy_tw_sip_fp
          + \semio_viz_hierarchy_sep:nnn {#1} { \l_semio_viz_hierarchy_tw_vim_int }
              { \l_semio_viz_hierarchy_tw_vip_int }
        }
        \fp_compare:nNnT { \l_semio_viz_hierarchy_tw_shift_fp } > { 0 } {
          \int_set:Nn \l_semio_viz_hierarchy_tw_wm_int
            { \int_compare:nNnTF
                { \semio_viz_hierarchy_get:nnn {#1} { pi }
                  { \semio_viz_hierarchy_get:nnn {#1} { ta } { \l_semio_viz_hierarchy_tw_vim_int } } }
                = { \semio_viz_hierarchy_get:nnn {#1} { pi } {#2} }
                { \semio_viz_hierarchy_get:nnn {#1} { ta } { \l_semio_viz_hierarchy_tw_vim_int } }
                { \l_semio_viz_hierarchy_tw_anc_int } }
          \semio_viz_hierarchy_tree_move:nnnn {#1} { \l_semio_viz_hierarchy_tw_wm_int } {#2}
            { \l_semio_viz_hierarchy_tw_shift_fp }
          \fp_add:Nn \l_semio_viz_hierarchy_tw_sip_fp { \l_semio_viz_hierarchy_tw_shift_fp }
          \fp_add:Nn \l_semio_viz_hierarchy_tw_sop_fp { \l_semio_viz_hierarchy_tw_shift_fp }
        }
        \fp_add:Nn \l_semio_viz_hierarchy_tw_sim_fp
          { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vim_int } }
        \fp_add:Nn \l_semio_viz_hierarchy_tw_sip_fp
          { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vip_int } }
        \fp_add:Nn \l_semio_viz_hierarchy_tw_som_fp
          { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vom_int } }
        \fp_add:Nn \l_semio_viz_hierarchy_tw_sop_fp
          { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vop_int } }
      }
    }
    \bool_lazy_and:nnT
      { \int_compare_p:nNn { \l_semio_viz_hierarchy_tw_vim_int } > { 0 } }
      { \int_compare_p:nNn
          { \semio_viz_hierarchy_next_right:nn {#1} { \l_semio_viz_hierarchy_tw_vop_int } } = { 0 } }
      {
        \semio_viz_hierarchy_set:nnnn {#1} { tt } { \l_semio_viz_hierarchy_tw_vop_int }
          { \int_use:N \l_semio_viz_hierarchy_tw_vim_int }
        \semio_viz_hierarchy_set:nnnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vop_int }
          { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vop_int }
            + \l_semio_viz_hierarchy_tw_sim_fp - \l_semio_viz_hierarchy_tw_sop_fp } }
      }
    \bool_lazy_and:nnT
      { \int_compare_p:nNn { \l_semio_viz_hierarchy_tw_vip_int } > { 0 } }
      { \int_compare_p:nNn
          { \semio_viz_hierarchy_next_left:nn {#1} { \l_semio_viz_hierarchy_tw_vom_int } } = { 0 } }
      {
        \semio_viz_hierarchy_set:nnnn {#1} { tt } { \l_semio_viz_hierarchy_tw_vom_int }
          { \int_use:N \l_semio_viz_hierarchy_tw_vip_int }
        \semio_viz_hierarchy_set:nnnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vom_int }
          { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tm } { \l_semio_viz_hierarchy_tw_vom_int }
            + \l_semio_viz_hierarchy_tw_sip_fp - \l_semio_viz_hierarchy_tw_som_fp } }
        \int_set:Nn \l_semio_viz_hierarchy_tw_anc_int {#2}
      }
  }
}

% 🌿 d3 `firstWalk`: preliminary abscissa of one node, in postorder.
\cs_new_protected:Npn \semio_viz_hierarchy_tree_firstwalk:nn #1#2 {
  \int_set:Nn \l_semio_viz_hierarchy_tw_p_int { \semio_viz_hierarchy_get:nnn {#1} { pi } {#2} }
  \int_zero:N \l_semio_viz_hierarchy_tw_w_int
  \int_compare:nNnT { \semio_viz_hierarchy_get:nnn {#1} { si } {#2} } > { 0 } {
    \int_set:Nn \l_semio_viz_hierarchy_tw_w_int
      { \semio_viz_hierarchy_kid:nnn {#1} { \l_semio_viz_hierarchy_tw_p_int }
        { \semio_viz_hierarchy_get:nnn {#1} { si } {#2} } }
  }
  \int_compare:nNnTF { \semio_viz_hierarchy_nk:nn {#1} {#2} } > { 0 } {
    \semio_viz_hierarchy_tree_shifts:nn {#1} {#2}
    \fp_set:Nn \l_semio_viz_hierarchy_tw_mid_fp {
      ( \semio_viz_hierarchy_get:nnn {#1} { tz } { \semio_viz_hierarchy_kid:nnn {#1} {#2} { 1 } }
      + \semio_viz_hierarchy_get:nnn {#1} { tz }
          { \semio_viz_hierarchy_kid:nnn {#1} {#2} { \semio_viz_hierarchy_nk:nn {#1} {#2} } } ) / 2
    }
    \int_compare:nNnTF { \l_semio_viz_hierarchy_tw_w_int } > { 0 } {
      \semio_viz_hierarchy_set:nnnn {#1} { tz } {#2}
        { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tz } { \l_semio_viz_hierarchy_tw_w_int }
          + \semio_viz_hierarchy_sep:nnn {#1} {#2} { \l_semio_viz_hierarchy_tw_w_int } } }
      \semio_viz_hierarchy_set:nnnn {#1} { tm } {#2}
        { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tz } {#2} - \l_semio_viz_hierarchy_tw_mid_fp } }
    } {
      \semio_viz_hierarchy_set:nnnn {#1} { tz } {#2} { \fp_use:N \l_semio_viz_hierarchy_tw_mid_fp }
    }
  } {
    \int_compare:nNnT { \l_semio_viz_hierarchy_tw_w_int } > { 0 } {
      \semio_viz_hierarchy_set:nnnn {#1} { tz } {#2}
        { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tz } { \l_semio_viz_hierarchy_tw_w_int }
          + \semio_viz_hierarchy_sep:nnn {#1} {#2} { \l_semio_viz_hierarchy_tw_w_int } } }
    }
  }
  \int_set:Nn \l_semio_viz_hierarchy_tw_anc_int
    { \semio_viz_hierarchy_get:nnn {#1} { tA } { \l_semio_viz_hierarchy_tw_p_int } }
  \int_compare:nNnT { \l_semio_viz_hierarchy_tw_anc_int } = { 0 } {
    \int_set:Nn \l_semio_viz_hierarchy_tw_anc_int
      { \semio_viz_hierarchy_kid:nnn {#1} { \l_semio_viz_hierarchy_tw_p_int } { 1 } }
  }
  \semio_viz_hierarchy_tree_apportion:nnn {#1} {#2} { \l_semio_viz_hierarchy_tw_w_int }
  \semio_viz_hierarchy_set:nnnn {#1} { tA } { \l_semio_viz_hierarchy_tw_p_int }
    { \int_use:N \l_semio_viz_hierarchy_tw_anc_int }
}

% 🌳 d3-hierarchy `tree()`: Reingold-Tilford with the Buchheim/Walker/Leipert
% linear-time improvements. Complexity O(n) walks plus O(n) contour steps.
\cs_new_protected:Npn \semio_viz_hierarchy_layout_tree:n #1 {
  \int_step_inline:nnn { 0 } { \semio_viz_hierarchy_get:nnn {#1} { n } { 0 } } {
    \clist_map_inline:nn { tz, tm, tc, ts, tt, tA }
      { \semio_viz_hierarchy_set:nnnn {#1} {####1} {##1} { 0 } }
    \semio_viz_hierarchy_set:nnnn {#1} { ta } {##1} {##1}
  }
  \semio_viz_hierarchy_map_post:nn {#1} { \semio_viz_hierarchy_tree_firstwalk:nn {#1} {##1} }
  \semio_viz_hierarchy_set:nnnn {#1} { tm } { 0 }
    { \fp_eval:n { - \semio_viz_hierarchy_get:nnn {#1} { tz }
      { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } } } }
  \semio_viz_hierarchy_map_pre:nn {#1} {
    \semio_viz_hierarchy_set:nnnn {#1} { x } {##1}
      { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tz } {##1}
        + \semio_viz_hierarchy_get:nnn {#1} { tm } { \semio_viz_hierarchy_get:nnn {#1} { pi } {##1} } } }
    \semio_viz_hierarchy_set:nnnn {#1} { tm } {##1}
      { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { tm } {##1}
        + \semio_viz_hierarchy_get:nnn {#1} { tm } { \semio_viz_hierarchy_get:nnn {#1} { pi } {##1} } } }
  }
  \bool_if:NTF \l_semio_viz_hierarchy_nodesize_bool {
    \semio_viz_hierarchy_map_pre:nn {#1} {
      \semio_viz_hierarchy_set:nnnn {#1} { x } {##1}
        { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { x } {##1} * \l_semio_viz_hierarchy_dx_fp } }
      \semio_viz_hierarchy_set:nnnn {#1} { y } {##1}
        { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { dep } {##1} * \l_semio_viz_hierarchy_dy_fp } }
    }
  } {
    \int_set:Nn \l_semio_viz_hierarchy_tw_left_int { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } }
    \int_set_eq:NN \l_semio_viz_hierarchy_tw_right_int \l_semio_viz_hierarchy_tw_left_int
    \int_set_eq:NN \l_semio_viz_hierarchy_tw_bottom_int \l_semio_viz_hierarchy_tw_left_int
    \semio_viz_hierarchy_map_pre:nn {#1} {
      \fp_compare:nNnT { \semio_viz_hierarchy_get:nnn {#1} { x } {##1} } <
        { \semio_viz_hierarchy_get:nnn {#1} { x } { \l_semio_viz_hierarchy_tw_left_int } }
        { \int_set:Nn \l_semio_viz_hierarchy_tw_left_int {##1} }
      \fp_compare:nNnT { \semio_viz_hierarchy_get:nnn {#1} { x } {##1} } >
        { \semio_viz_hierarchy_get:nnn {#1} { x } { \l_semio_viz_hierarchy_tw_right_int } }
        { \int_set:Nn \l_semio_viz_hierarchy_tw_right_int {##1} }
      \int_compare:nNnT { \semio_viz_hierarchy_get:nnn {#1} { dep } {##1} } >
        { \semio_viz_hierarchy_get:nnn {#1} { dep } { \l_semio_viz_hierarchy_tw_bottom_int } }
        { \int_set:Nn \l_semio_viz_hierarchy_tw_bottom_int {##1} }
    }
    \int_compare:nNnTF { \l_semio_viz_hierarchy_tw_left_int } = { \l_semio_viz_hierarchy_tw_right_int }
      { \fp_set:Nn \l_semio_viz_hierarchy_tw_s_fp { 1 } }
      { \fp_set:Nn \l_semio_viz_hierarchy_tw_s_fp
          { \semio_viz_hierarchy_sep:nnn {#1} { \l_semio_viz_hierarchy_tw_left_int }
            { \l_semio_viz_hierarchy_tw_right_int } / 2 } }
    \fp_set:Nn \l_semio_viz_hierarchy_tw_tx_fp { \l_semio_viz_hierarchy_tw_s_fp
      - \semio_viz_hierarchy_get:nnn {#1} { x } { \l_semio_viz_hierarchy_tw_left_int } }
    \fp_set:Nn \l_semio_viz_hierarchy_tw_kx_fp { \l_semio_viz_hierarchy_dx_fp /
      ( \semio_viz_hierarchy_get:nnn {#1} { x } { \l_semio_viz_hierarchy_tw_right_int }
        + \l_semio_viz_hierarchy_tw_s_fp + \l_semio_viz_hierarchy_tw_tx_fp ) }
    \fp_set:Nn \l_semio_viz_hierarchy_tw_ky_fp { \l_semio_viz_hierarchy_dy_fp /
      max ( 1 , \semio_viz_hierarchy_get:nnn {#1} { dep } { \l_semio_viz_hierarchy_tw_bottom_int } ) }
    \semio_viz_hierarchy_map_pre:nn {#1} {
      \semio_viz_hierarchy_set:nnnn {#1} { x } {##1}
        { \fp_eval:n { ( \semio_viz_hierarchy_get:nnn {#1} { x } {##1}
          + \l_semio_viz_hierarchy_tw_tx_fp ) * \l_semio_viz_hierarchy_tw_kx_fp } }
      \semio_viz_hierarchy_set:nnnn {#1} { y } {##1}
        { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { dep } {##1} * \l_semio_viz_hierarchy_tw_ky_fp } }
    }
  }
}
%endregion 🔖️LayoutTree

%region 🔖️LayoutCluster
\int_new:N \l_semio_viz_hierarchy_cl_prev_int
\fp_new:N \l_semio_viz_hierarchy_cl_x_fp
\fp_new:N \l_semio_viz_hierarchy_cl_xa_fp
\fp_new:N \l_semio_viz_hierarchy_cl_xb_fp
\fp_new:N \l_semio_viz_hierarchy_cl_acc_fp
\int_new:N \l_semio_viz_hierarchy_cl_left_int
\int_new:N \l_semio_viz_hierarchy_cl_right_int

% 🍂 d3-hierarchy `cluster()`: every leaf on the deepest row, every parent on the
% mean abscissa of its children. Complexity O(n).
\cs_new_protected:Npn \semio_viz_hierarchy_layout_cluster:n #1 {
  \int_zero:N \l_semio_viz_hierarchy_cl_prev_int
  \fp_zero:N \l_semio_viz_hierarchy_cl_x_fp
  \semio_viz_hierarchy_map_post:nn {#1} {
    \int_compare:nNnTF { \semio_viz_hierarchy_nk:nn {#1} {##1} } > { 0 } {
      \fp_zero:N \l_semio_viz_hierarchy_cl_acc_fp
      \fp_zero:N \l_semio_viz_hierarchy_own_fp
      \int_step_inline:nn { \semio_viz_hierarchy_nk:nn {#1} {##1} } {
        \fp_add:Nn \l_semio_viz_hierarchy_cl_acc_fp
          { \semio_viz_hierarchy_get:nnn {#1} { x } { \semio_viz_hierarchy_kid:nnn {#1} {##1} {####1} } }
        \fp_set:Nn \l_semio_viz_hierarchy_own_fp { max ( \l_semio_viz_hierarchy_own_fp ,
          \semio_viz_hierarchy_get:nnn {#1} { y } { \semio_viz_hierarchy_kid:nnn {#1} {##1} {####1} } ) }
      }
      \semio_viz_hierarchy_set:nnnn {#1} { x } {##1}
        { \fp_eval:n { \l_semio_viz_hierarchy_cl_acc_fp / \semio_viz_hierarchy_nk:nn {#1} {##1} } }
      \semio_viz_hierarchy_set:nnnn {#1} { y } {##1}
        { \fp_eval:n { 1 + \l_semio_viz_hierarchy_own_fp } }
    } {
      \int_compare:nNnT { \l_semio_viz_hierarchy_cl_prev_int } > { 0 } {
        \fp_add:Nn \l_semio_viz_hierarchy_cl_x_fp
          { \semio_viz_hierarchy_sep:nnn {#1} {##1} { \l_semio_viz_hierarchy_cl_prev_int } }
      }
      \semio_viz_hierarchy_set:nnnn {#1} { x } {##1} { \fp_use:N \l_semio_viz_hierarchy_cl_x_fp }
      \semio_viz_hierarchy_set:nnnn {#1} { y } {##1} { 0 }
      \int_set:Nn \l_semio_viz_hierarchy_cl_prev_int {##1}
    }
  }
  \int_set:Nn \l_semio_viz_hierarchy_cl_left_int { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } }
  \bool_while_do:nn
    { \int_compare_p:nNn { \semio_viz_hierarchy_nk:nn {#1} { \l_semio_viz_hierarchy_cl_left_int } } > { 0 } }
    { \int_set:Nn \l_semio_viz_hierarchy_cl_left_int
        { \semio_viz_hierarchy_kid:nnn {#1} { \l_semio_viz_hierarchy_cl_left_int } { 1 } } }
  \int_set:Nn \l_semio_viz_hierarchy_cl_right_int { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } }
  \bool_while_do:nn
    { \int_compare_p:nNn { \semio_viz_hierarchy_nk:nn {#1} { \l_semio_viz_hierarchy_cl_right_int } } > { 0 } }
    { \int_set:Nn \l_semio_viz_hierarchy_cl_right_int
        { \semio_viz_hierarchy_kid:nnn {#1} { \l_semio_viz_hierarchy_cl_right_int }
          { \semio_viz_hierarchy_nk:nn {#1} { \l_semio_viz_hierarchy_cl_right_int } } } }
  \fp_set:Nn \l_semio_viz_hierarchy_cl_xa_fp
    { \semio_viz_hierarchy_get:nnn {#1} { x } { \l_semio_viz_hierarchy_cl_left_int }
      - \semio_viz_hierarchy_sep:nnn {#1} { \l_semio_viz_hierarchy_cl_left_int }
        { \l_semio_viz_hierarchy_cl_right_int } / 2 }
  \fp_set:Nn \l_semio_viz_hierarchy_cl_xb_fp
    { \semio_viz_hierarchy_get:nnn {#1} { x } { \l_semio_viz_hierarchy_cl_right_int }
      + \semio_viz_hierarchy_sep:nnn {#1} { \l_semio_viz_hierarchy_cl_right_int }
        { \l_semio_viz_hierarchy_cl_left_int } / 2 }
  \bool_if:NTF \l_semio_viz_hierarchy_nodesize_bool {
    \semio_viz_hierarchy_map_post:nn {#1} {
      \semio_viz_hierarchy_set:nnnn {#1} { x } {##1}
        { \fp_eval:n { ( \semio_viz_hierarchy_get:nnn {#1} { x } {##1}
          - \semio_viz_hierarchy_get:nnn {#1} { x } { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } } )
          * \l_semio_viz_hierarchy_dx_fp } }
      \semio_viz_hierarchy_set:nnnn {#1} { y } {##1}
        { \fp_eval:n { ( \semio_viz_hierarchy_get:nnn {#1} { y }
            { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } }
          - \semio_viz_hierarchy_get:nnn {#1} { y } {##1} ) * \l_semio_viz_hierarchy_dy_fp } }
    }
  } {
    \semio_viz_hierarchy_map_post:nn {#1} {
      \semio_viz_hierarchy_set:nnnn {#1} { x } {##1}
        { \fp_eval:n { ( \semio_viz_hierarchy_get:nnn {#1} { x } {##1} - \l_semio_viz_hierarchy_cl_xa_fp )
          / ( \l_semio_viz_hierarchy_cl_xb_fp - \l_semio_viz_hierarchy_cl_xa_fp )
          * \l_semio_viz_hierarchy_dx_fp } }
      \semio_viz_hierarchy_set:nnnn {#1} { y } {##1}
        { \fp_eval:n { ( 1 - \fp_compare:nNnTF
            { \semio_viz_hierarchy_get:nnn {#1} { y } { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } } }
            = { 0 } { 1 } { \semio_viz_hierarchy_get:nnn {#1} { y } {##1} /
              \semio_viz_hierarchy_get:nnn {#1} { y } { \semio_viz_hierarchy_get:nnn {#1} { root } { 0 } } } )
          * \l_semio_viz_hierarchy_dy_fp } }
    }
  }
}
%endregion 🔖️LayoutCluster

%region 🔖️Radial

% 🧭 Maps a tree/cluster/partition result from (angle, radius) to millimetres,
% with d3's convention that the angle zero points up.
\cs_new_protected:Npn \semio_viz_hierarchy_radial:n #1 {
  \semio_viz_hierarchy_map_pre:nn {#1} {
    \fp_set:Nn \l_semio_viz_hierarchy_own_fp
      { \semio_viz_hierarchy_get:nnn {#1} { x } {##1} + \l_semio_viz_hierarchy_radial_offset_fp }
    \semio_viz_hierarchy_set:nnnn {#1} { angle } {##1} { \fp_use:N \l_semio_viz_hierarchy_own_fp }
    \semio_viz_hierarchy_set:nnnn {#1} { radius } {##1} { \semio_viz_hierarchy_get:nnn {#1} { y } {##1} }
    \semio_viz_hierarchy_set:nnnn {#1} { x } {##1}
      { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { y } {##1}
        * cos ( \l_semio_viz_hierarchy_own_fp - pi / 2 ) } }
    \semio_viz_hierarchy_set:nnnn {#1} { y } {##1}
      { \fp_eval:n { \semio_viz_hierarchy_get:nnn {#1} { radius } {##1}
        * sin ( \l_semio_viz_hierarchy_own_fp - pi / 2 ) } }
  }
}
%endregion 🔖️Radial

%region 🔖️Dispatch
% 🚦 Runs one hierarchy layout from #1 into #3, reading the source topology from
% #2. `tree`, `cluster`, `treemap`, `partition` and `pack` are the taxonomy 78
% hierarchy transforms; the shared option list is documented above.
\cs_new_protected:Npn \semio_viz_hierarchy_layout:nnnn #1#2#3#4 {
  \semio_viz_hierarchy_layout_keys_reset:
  \keys_set:nn { semio / viz / hierarchy / layout } {#4}
  \semio_viz_hierarchy_layout_now:nnn {#1} {#2} {#3}
}

% 🚦 The same transform on keys that were already set, which is how a family
% shares one flat option list between construction, layout and rendering.
\cs_new_protected:Npn \semio_viz_hierarchy_layout_now:nnn #1#2#3 {
  \semio_viz_hierarchy_require:n {#2}
  \semio_viz_hierarchy_copy:nn {#2} {#3}
  \int_step_inline:nn { \semio_viz_hierarchy_get:nnn {#3} { n } { 0 } }
    { \semio_viz_hierarchy_set:nnnn {#3} { poly } {##1} { } }
  \str_case:nnF {#1} {
    { tree }      { \semio_viz_hierarchy_layout_tree:n {#3} }
    { cluster }   { \semio_viz_hierarchy_layout_cluster:n {#3} }
    { treemap }   { \semio_viz_hierarchy_layout_treemap:n {#3} }
    { partition } { \semio_viz_hierarchy_layout_partition:n {#3} }
    { pack }      { \semio_viz_hierarchy_layout_pack:n {#3} }
  }
  { \msg_error:nnn { semio-viz } { unknown-hierarchy-layout } {#1} }
  \bool_if:NT \l_semio_viz_hierarchy_radial_bool { \semio_viz_hierarchy_radial:n {#3} }
  \semio_viz_hierarchy_probe:nn {#1} {#3}
}

% 🧭 Emits one geometry record per node so the probe harness can compare the
% layout numerically without rasterising anything.
\cs_new_protected:Npn \semio_viz_hierarchy_probe:nn #1#2 {
  \semio_viz_hierarchy_map_nodes:nn {#2} {
    \semio_viz_probe_geometry:nx { hierarchy/#1 } {
      \int_use:N \l_semio_viz_hierarchy_node_index_int ,
      \l_semio_viz_hierarchy_node_id_tl ,
      \int_use:N \l_semio_viz_hierarchy_node_depth_int ,
      \fp_use:N \l_semio_viz_hierarchy_node_value_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_x_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_y_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_r_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_xa_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_ya_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_xb_fp ,
      \fp_use:N \l_semio_viz_hierarchy_node_yb_fp
    }
  }
}
%endregion 🔖️Dispatch

%region 🔖️PublicApi
% 🎭 Leaves #1 alone when the key was given, otherwise takes the table's role #2,
% otherwise the literal fallback #3.
\cs_new_protected:Npn \semio_viz_hierarchy_column:Nnn #1#2#3 {
  \tl_if_empty:NT #1 {
    \tl_set:Nx #1
      { \exp_args:NV \semio_viz_table_role:nn \l_semio_viz_hierarchy_table_tl {#2} }
    \tl_if_empty:NT #1 { \tl_set:Nn #1 {#3} }
  }
}

% 🎭 The same for a column that is allowed to be absent: a fallback naming a
% column the table does not have means the hierarchy simply has no such column.
\cs_new_protected:Npn \semio_viz_hierarchy_column_optional:Nnn #1#2#3 {
  \semio_viz_hierarchy_column:Nnn #1 {#2} {#3}
  \tl_if_empty:NF #1 {
    \clist_if_in:cVF { g_semio_viz_table_ \l_semio_viz_hierarchy_table_tl _cols_clist } #1
      { \tl_clear:N #1 }
  }
}

% 🌳 Builds the node set of hierarchy #1 from the table named by the `data` key;
% the id/parent/value columns default to the roles \SemioVizHierarchy declared on
% that table in semio-viz-data.
\cs_new_protected:Npn \semio_viz_hierarchy_build:nn #1#2 {
  \semio_viz_hierarchy_keys_reset:
  \keys_set:nn { semio / viz / hierarchy } {#2}
  \semio_viz_hierarchy_build_now:n {#1}
}

% 🌳 The same stratification on keys that were already set.
\cs_new_protected:Npn \semio_viz_hierarchy_build_now:n #1 {
  \semio_viz_hierarchy_column:Nnn \l_semio_viz_hierarchy_idcol_tl { id } { id }
  \semio_viz_hierarchy_column:Nnn \l_semio_viz_hierarchy_parentcol_tl { parent } { parent }
  \semio_viz_hierarchy_column_optional:Nnn \l_semio_viz_hierarchy_valuecol_tl { value } { value }
  \str_if_eq:VnT \l_semio_viz_hierarchy_valuecol_tl { none }
    { \tl_clear:N \l_semio_viz_hierarchy_valuecol_tl }
  \int_gincr:N \g_semio_viz_hierarchy_generation_int
  \int_zero:N \l_semio_viz_hierarchy_n_int
  \seq_if_in:NnF \g_semio_viz_hierarchy_names_seq {#1}
    { \seq_gput_right:Nn \g_semio_viz_hierarchy_names_seq {#1} }
  \tl_if_empty:NTF \l_semio_viz_hierarchy_pathcol_tl
    { \semio_viz_hierarchy_build_table:n {#1} }
    { \semio_viz_hierarchy_build_path:n {#1} }
  \semio_viz_hierarchy_set:nnnn {#1} { n } { 0 } { \int_use:N \l_semio_viz_hierarchy_n_int }
  \semio_viz_hierarchy_set:nnnn {#1} { root } { 0 }
    { \int_use:N \l_semio_viz_hierarchy_root_int }
  \semio_viz_hierarchy_seq_reset:n { \semio_viz_hierarchy_kids:nn {#1} { 0 } }
  \seq_gput_right:cx { \semio_viz_hierarchy_kids:nn {#1} { 0 } }
    { \int_use:N \l_semio_viz_hierarchy_root_int }
  \semio_viz_hierarchy_set:nnnn {#1} { pi } { \l_semio_viz_hierarchy_root_int } { 0 }
  \semio_viz_hierarchy_set:nnnn {#1} { si } { \l_semio_viz_hierarchy_root_int } { 0 }
  \int_compare:nNnT { \l_semio_viz_hierarchy_root_int } = { 0 }
    { \msg_error:nnn { semio-viz } { hierarchy-no-root } {#1} }
  \semio_viz_hierarchy_order:n {#1}
  \exp_args:NnV \semio_viz_hierarchy_aggregate:nn {#1} \l_semio_viz_hierarchy_aggregate_tl
  \exp_args:NnV \semio_viz_hierarchy_sort:nn {#1} \l_semio_viz_hierarchy_sort_tl
}

% 🌳 \SemioVizHierarchyBuild{name}[data=,id=,parent=,value=,path=,delimiter=,
% aggregate=,sort=]: stratifies a data table into a named hierarchy. Passing a
% table name straight to \SemioVizLayout builds it with the defaults.
\NewDocumentCommand \SemioVizHierarchyBuild { m O{} }
  { \semio_viz_hierarchy_build:nn {#1} {#2} }

% 📐 The five taxonomy 78 hierarchy layouts, registered with the layout kernel so
% \SemioVizLayout{tree}{in}{out}[opts] reaches them; `out` may repeat `in` to lay
% a hierarchy out in place.
\semio_viz_layout_define:nn { tree }
  { \semio_viz_hierarchy_layout:nnnn { tree } {#1} {#2} {#3} }
% 🌴 `cluster`: the same tidy tree with every leaf on the last rank.
\semio_viz_layout_define:nn { cluster }
  { \semio_viz_hierarchy_layout:nnnn { cluster } {#1} {#2} {#3} }
% 🧱 `treemap`: nested rectangles whose areas are the node values, under the chosen tiling.
\semio_viz_layout_define:nn { treemap }
  { \semio_viz_hierarchy_layout:nnnn { treemap } {#1} {#2} {#3} }
% 🍰 `partition`: rank-aligned slices, the icicle and sunburst geometry.
\semio_viz_layout_define:nn { partition }
  { \semio_viz_hierarchy_layout:nnnn { partition } {#1} {#2} {#3} }
% 🫧 `pack`: enclosing circles whose areas are the node values.
\semio_viz_layout_define:nn { pack }
  { \semio_viz_hierarchy_layout:nnnn { pack } {#1} {#2} {#3} }

% 🔁 \SemioVizHierarchyMapNodes{name}{code}: renderer iterator, #1 is the index.
\NewDocumentCommand \SemioVizHierarchyMapNodes { m +m }
  { \semio_viz_hierarchy_map_nodes:nn {#1} {#2} }
% 🔗 \SemioVizHierarchyMapLinks{name}{code}: parent/child iterator.
\NewDocumentCommand \SemioVizHierarchyMapLinks { m +m }
  { \semio_viz_hierarchy_map_links:nn {#1} {#2} }
% 📤 \SemioVizHierarchyField{name}{field}{index}: expandable field accessor.
\NewExpandableDocumentCommand \SemioVizHierarchyField { m m m }
