\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-scientific-signal}[2026/09/05 v0.2.0 semio viz namespace scientific-signal and music families]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-scientific-field}

\ExplSyntaxOn

%region 🔖️Parsing
\cs_generate_variant:Nn \seq_set_split:Nnn { Nnx }
\prg_generate_conditional_variant:Nnn \clist_if_in:Nn { Nx } { T, F, TF }
\tl_new:N \l_semio_viz_sig_key_tl
\seq_new:N \l_semio_viz_sig_rec_seq
% ✂️ Splits one `/`-delimited record of a family key into the shared field sequence.
\cs_new_protected:Npn \semio_viz_sig_record:n #1
  { \seq_set_split:Nnx \l_semio_viz_sig_rec_seq { / } {#1} }
% 🔢 Expands to the n-th field of the record read last.
\cs_new:Npn \semio_viz_sig_field:n #1
  { \seq_item:Nn \l_semio_viz_sig_rec_seq {#1} }
%endregion 🔖️Parsing

%region 🔖️Sampling
% 〰️ The sample buffer every signal family works on, and the three transforms taken of it.
\seq_new:N \l_semio_viz_sig_samples_seq
\seq_new:N \l_semio_viz_sig_second_seq
\seq_new:N \l_semio_viz_sig_mag_seq
\seq_new:N \l_semio_viz_sig_phase_seq

% 〰️ Fills a sample buffer from an l3fp expression over \SemioT (the sample time) with `#3` samples at rate `#4`.
\cs_new_protected:Npn \semio_viz_sig_sample:Nnnn #1#2#3#4
  {
    \seq_clear:N #1
    \int_step_inline:nnnn { 0 } { 1 } { #3 - 1 }
      {
        \fp_set:Nn \SemioT { ##1 / (#4) }
        \seq_put_right:Nx #1 { \fp_to_decimal:n {#2} }
      }
  }
% 〰️ Autocorrelation (or cross-correlation with the second buffer) at every lag up to half the buffer.
\cs_new_protected:Npn \semio_viz_sig_correlate:NNN #1#2#3
  {
    \seq_clear:N #3
    \int_set:Nn \l_tmpa_int { \seq_count:N #1 }
    \int_step_inline:nnnn { 0 } { 1 } { \l_tmpa_int / 2 }
      {
        \fp_zero:N \l_semio_viz_sci_a_fp
        \int_step_inline:nnnn { 1 } { 1 } { \l_tmpa_int - ##1 }
          {
            \fp_add:Nn \l_semio_viz_sci_a_fp
              { \seq_item:Nn #1 {####1} * \seq_item:Nn #2 { ####1 + ##1 } }
          }
        \semio_viz_points_put:Nnn #3 {##1} { \l_semio_viz_sci_a_fp / \l_tmpa_int }
      }
  }
% 〰️ Real cepstrum: the inverse transform of the log magnitude spectrum, computed with the same DFT kernel.
\cs_new_protected:Npn \semio_viz_sig_cepstrum:NN #1#2
  {
    \semio_viz_sci_dft:NNN #1 \l_semio_viz_sig_mag_seq \l_semio_viz_sig_phase_seq
    \seq_clear:N \l_semio_viz_sig_second_seq
    \seq_map_inline:Nn \l_semio_viz_sig_mag_seq
      {
        \seq_put_right:Nx \l_semio_viz_sig_second_seq
          { \fp_to_decimal:n { ln ( max ( 1e-6 , \semio_viz_points_y:n {##1} ) ) } }
      }
    \semio_viz_sci_dft:NNN \l_semio_viz_sig_second_seq #2 \l_semio_viz_sig_phase_seq
  }
%endregion 🔖️Sampling

%region 🔖️Families

%region 🔖️Keys
% 🔑 Keys of `sci-signal` (§32 one-dimensional signal views):
%    mode (waveform|spectrum|psd|periodogram|magnitude|phase|cepstrum|autocorrelation|
%          cross-correlation|coherence|lag|filter-response, waveform).
%    expr, expr2 (l3fp over \SemioT): the signal and, for the two-signal modes, its partner.
%    samples (int, 64), rate (fp, 32): buffer length and sampling rate.
%    numerator, denominator (clist, descending powers): the filter transfer function of `filter-response`.
%    stems (bool, false): draw a discrete spectrum as stems instead of a curve. decibel (bool, false): log magnitude axis.
\tl_new:N \l_semio_viz_sig_mode_tl
\tl_new:N \l_semio_viz_sig_expr_tl
\tl_new:N \l_semio_viz_sig_exprb_tl
\clist_new:N \l_semio_viz_sig_num_clist
\clist_new:N \l_semio_viz_sig_den_clist
\int_new:N \l_semio_viz_sig_samples_int
\fp_new:N \l_semio_viz_sig_rate_fp
\bool_new:N \l_semio_viz_sig_stems_bool
\bool_new:N \l_semio_viz_sig_db_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-signal }
% 🎛️ Binds the `sci-signal` keys onto the view mode, the two signal expressions, the buffer length and rate, the filter coefficients and the stem and decibel switches.
\keys_define:nn { semio / viz / family / sci-signal }
  {
    mode        .tl_set:N    = \l_semio_viz_sig_mode_tl ,
    expr        .tl_set:N    = \l_semio_viz_sig_expr_tl ,
    expr2       .tl_set:N    = \l_semio_viz_sig_exprb_tl ,
    samples     .int_set:N   = \l_semio_viz_sig_samples_int ,
    rate        .fp_set:N    = \l_semio_viz_sig_rate_fp ,
    numerator   .clist_set:N = \l_semio_viz_sig_num_clist ,
    denominator .clist_set:N = \l_semio_viz_sig_den_clist ,
    stems       .bool_set:N  = \l_semio_viz_sig_stems_bool ,
    decibel     .bool_set:N  = \l_semio_viz_sig_db_bool ,
  }

% 〰️ §32 signal views: the waveform itself and every transform of it — spectrum, power spectral density, cepstrum, correlations, filter response.
\SemioVizFamily { sci-signal }
  {
    \semio_viz_sci_enter:nnn { sci-signal }
      {
        mode=waveform , samples=64 , rate=32 , stems=false , decibel=false ,
        expr={ sin ( 2 * pi * 3 * \SemioT ) + 0.5 * sin ( 2 * pi * 7 * \SemioT ) } ,
        expr2={ sin ( 2 * pi * 3 * \SemioT + 0.8 ) } ,
        numerator={ 1 } , denominator={ 1 , 0.6 , 1 } , domain={} , range={}
      }
      {#1}
    \semio_viz_sig_sample:Nnnn \l_semio_viz_sig_samples_seq { \l_semio_viz_sig_expr_tl }
      { \l_semio_viz_sig_samples_int } { \l_semio_viz_sig_rate_fp }
    \str_case:VnF \l_semio_viz_sig_mode_tl
      {
        { spectrum }          { \semio_viz_sig_spectrum:n { magnitude } }
        { magnitude }         { \semio_viz_sig_spectrum:n { magnitude } }
        { psd }               { \semio_viz_sig_spectrum:n { power } }
        { periodogram }       { \semio_viz_sig_spectrum:n { power } }
        { phase }             { \semio_viz_sig_spectrum:n { phase } }
        { coherence }         { \semio_viz_sig_spectrum:n { coherence } }
        { cepstrum }          { \semio_viz_sig_cepstrum_plot: }
        { autocorrelation }   { \semio_viz_sig_correlation_plot:n { self } }
        { cross-correlation } { \semio_viz_sig_correlation_plot:n { cross } }
        { lag }               { \semio_viz_sig_lag_plot: }
        { filter-response }   { \semio_viz_sig_filter_plot: }
      }
      { \semio_viz_sig_waveform: }
  }
% ⏱️ Pairs every sample of a buffer with its own time, the index divided by the sampling rate, into a point sequence.
\cs_new_protected:Npn \semio_viz_sig_buffer_points:NN #1#2
  {
    \seq_clear:N #2
    \int_zero:N \l_tmpa_int
    \seq_map_inline:Nn #1
      {
        \semio_viz_points_put:Nnn #2 { \l_tmpa_int / \l_semio_viz_sig_rate_fp } {##1}
        \int_incr:N \l_tmpa_int
      }
  }
% 📈 The signal in the time domain: the buffer over an auto-fitted framed window with zero lines, as stems or as a curve.
\cs_new_protected:Npn \semio_viz_sig_waveform:
  {
    \semio_viz_sig_buffer_points:NN \l_semio_viz_sig_samples_seq \l_semio_viz_sci_pts_seq
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.06 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \bool_if:NTF \l_semio_viz_sig_stems_bool
      { \semio_viz_sig_stems: }
      { \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve } }
  }
% 🧵 Discrete rendering: a thin vertical line from the zero level up to every point, then a report of the stems.
\cs_new_protected:Npn \semio_viz_sig_stems:
  {
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      {
        \draw [ semio~sci~thin , draw=semio-primary ]
          ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { 0 } ) --
          ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { \semio_viz_points_y:n {##1} } ) ;
      }
    \semio_viz_sci_report:Nn \l_semio_viz_sci_pts_seq { stem }
  }
% 〰️ Spectrum modes: the DFT bins mapped onto frequency, as magnitude, power, phase or the coherence with the partner signal.
\cs_new_protected:Npn \semio_viz_sig_spectrum:n #1
  {
    \semio_viz_sci_dft:NNN \l_semio_viz_sig_samples_seq \l_semio_viz_sig_mag_seq \l_semio_viz_sig_phase_seq
    \str_if_eq:nnT {#1} { coherence }
      {
        \semio_viz_sig_sample:Nnnn \l_semio_viz_sig_second_seq { \l_semio_viz_sig_exprb_tl }
          { \l_semio_viz_sig_samples_int } { \l_semio_viz_sig_rate_fp }
        \semio_viz_sci_dft:NNN \l_semio_viz_sig_second_seq \l_semio_viz_sci_pts_c_seq \l_semio_viz_sig_phase_seq
      }
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 1 } { 1 } { \seq_count:N \l_semio_viz_sig_mag_seq }
      { \semio_viz_sig_bin:nn {##1} {#1} }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.06 }
    \fp_set:Nn \l_semio_viz_sci_dymin_fp { min ( 0 , \l_semio_viz_sci_dymin_fp ) }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sig_stems:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
  }
% 🗜️ Turns one DFT bin into a plotted point: its frequency from the bin index, its height the magnitude, squared power, phase or coherence, optionally in decibels.
\cs_new_protected:Npn \semio_viz_sig_bin:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sig_mag_seq {#1} } * \l_semio_viz_sig_rate_fp
        / \l_semio_viz_sig_samples_int }
    \str_case:nnF {#2}
      {
        { power }
          {
            \fp_set:Nn \l_semio_viz_sci_b_fp
              { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sig_mag_seq {#1} } ^ 2 }
          }
        { phase }
          {
            \fp_set:Nn \l_semio_viz_sci_b_fp
              { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sig_phase_seq {#1} } }
          }
        { coherence }
          {
            \fp_set:Nn \l_semio_viz_sci_b_fp
              {
                min ( 1 ,
                  \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sig_mag_seq {#1} }
                  * \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_c_seq {#1} }
                  / max ( 1e-6 , \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sig_mag_seq {#1} } ^ 2 ) )
              }
          }
      }
      {
        \fp_set:Nn \l_semio_viz_sci_b_fp
          { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sig_mag_seq {#1} } }
      }
    \bool_if:NT \l_semio_viz_sig_db_bool
      { \fp_set:Nn \l_semio_viz_sci_b_fp { 20 * ln ( max ( 1e-6 , \l_semio_viz_sci_b_fp ) ) / ln (10) } }
    \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
      { \l_semio_viz_sci_a_fp } { \l_semio_viz_sci_b_fp }
  }
% 🫧 Draws the real cepstrum of the buffer as a plain curve over quefrency, in a window fitted to it.
\cs_new_protected:Npn \semio_viz_sig_cepstrum_plot:
  {
    \semio_viz_sig_cepstrum:NN \l_semio_viz_sig_samples_seq \l_semio_viz_sci_pts_seq
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.06 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
  }
% 🔗 Correlation over lag, against the signal itself or against the second expression, drawn as stems under a curve with zero lines.
\cs_new_protected:Npn \semio_viz_sig_correlation_plot:n #1
  {
    \str_if_eq:nnTF {#1} { cross }
      {
        \semio_viz_sig_sample:Nnnn \l_semio_viz_sig_second_seq { \l_semio_viz_sig_exprb_tl }
          { \l_semio_viz_sig_samples_int } { \l_semio_viz_sig_rate_fp }
        \semio_viz_sig_correlate:NNN \l_semio_viz_sig_samples_seq \l_semio_viz_sig_second_seq
          \l_semio_viz_sci_pts_seq
      }
      {
        \semio_viz_sig_correlate:NNN \l_semio_viz_sig_samples_seq \l_semio_viz_sig_samples_seq
          \l_semio_viz_sci_pts_seq
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.06 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_zero_lines:
    \semio_viz_sig_stems:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
  }
% 🌀 Phase-space view: every sample scattered against its successor, so a periodic signal closes into a loop.
\cs_new_protected:Npn \semio_viz_sig_lag_plot:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 1 } { 1 } { \seq_count:N \l_semio_viz_sig_samples_seq - 1 }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \seq_item:Nn \l_semio_viz_sig_samples_seq {##1} }
          { \seq_item:Nn \l_semio_viz_sig_samples_seq { ##1 + 1 } }
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.08 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      { \semio_viz_sci_dot:nnn { \semio_viz_points_x:n {##1} } { \semio_viz_points_y:n {##1} } { semio-primary } }
    \semio_viz_sci_report:Nn \l_semio_viz_sci_pts_seq { lag }
  }
% 〰️ Filter response: |H(jω)| of the transfer function on a logarithmic frequency sweep.
\cs_new_protected:Npn \semio_viz_sig_filter_plot:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { 120 }
      {
        \fp_set:Nn \l_semio_viz_sci_g_fp { 10 ^ ( -1 + 3 * ##1 / 120 ) }
        \semio_viz_sci_tf:VVn \l_semio_viz_sig_num_clist \l_semio_viz_sig_den_clist
          { \l_semio_viz_sci_g_fp }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { ln ( \l_semio_viz_sci_g_fp ) / ln (10) }
          {
            20 * ln ( max ( 1e-9 , sqrt ( \l_semio_viz_sci_re_fp ^ 2 + \l_semio_viz_sci_im_fp ^ 2 ) ) ) / ln (10)
          }
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.05 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-timefreq` (§32 time–frequency maps):
%    mode (spectrogram|scalogram|waterfall|time-frequency, spectrogram).
%    expr (l3fp over \SemioT): the signal. samples (int, 128), rate (fp, 64): buffer and rate.
%    window (int, 16), hop (int, 8): the short-time Fourier window and its advance.
%    scales (int, 12): Morlet scale count of the scalogram. decibel (bool, true): log magnitude colouring.
\int_new:N \l_semio_viz_sig_window_int
\int_new:N \l_semio_viz_sig_hop_int
\int_new:N \l_semio_viz_sig_scales_int
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-timefreq }
% 🎚️ Binds the `sci-timefreq` keys onto the signal, the buffer and rate, the short-time window and hop, the wavelet scale count and the decibel switch.
\keys_define:nn { semio / viz / family / sci-timefreq }
  {
    mode    .tl_set:N  = \l_semio_viz_sig_mode_tl ,
    expr    .tl_set:N  = \l_semio_viz_sig_expr_tl ,
    samples .int_set:N = \l_semio_viz_sig_samples_int ,
    rate    .fp_set:N  = \l_semio_viz_sig_rate_fp ,
    window  .int_set:N = \l_semio_viz_sig_window_int ,
    hop     .int_set:N = \l_semio_viz_sig_hop_int ,
    scales  .int_set:N = \l_semio_viz_sig_scales_int ,
    decibel .bool_set:N = \l_semio_viz_sig_db_bool ,
  }

% 🌈 §32 time–frequency: a real short-time Fourier transform of the sampled signal, drawn as a spectrogram, waterfall or Morlet scalogram.
\SemioVizFamily { sci-timefreq }
  {
    \semio_viz_sci_enter:nnn { sci-timefreq }
      {
        mode=spectrogram , samples=128 , rate=64 , window=16 , hop=8 , scales=12 , decibel=true ,
        expr={ sin ( 2 * pi * ( 3 + 9 * \SemioT ) * \SemioT ) } ,
        domain={0,2} , range={0,32} , grid=false
      }
      {#1}
    \semio_viz_sig_sample:Nnnn \l_semio_viz_sig_samples_seq { \l_semio_viz_sig_expr_tl }
      { \l_semio_viz_sig_samples_int } { \l_semio_viz_sig_rate_fp }
    \semio_viz_sci_window:nnnn { 0 }
      { \fp_eval:n { \l_semio_viz_sig_samples_int / \l_semio_viz_sig_rate_fp } }
      { 0 } { \fp_eval:n { \l_semio_viz_sig_rate_fp / 2 } }
    \semio_viz_sci_window_keys:
    \str_if_eq:VnTF \l_semio_viz_sig_mode_tl { scalogram }
      { \semio_viz_sig_scalogram: }
      { \semio_viz_sig_stft: }
    \semio_viz_sci_frame:
  }
% 🌈 One short-time window: a Hann-tapered slice transformed by the shared DFT kernel.
\cs_new_protected:Npn \semio_viz_sig_stft:
  {
    \int_zero:N \l_tmpa_int
    \int_step_inline:nnnn { 0 } { \l_semio_viz_sig_hop_int }
      { \l_semio_viz_sig_samples_int - \l_semio_viz_sig_window_int }
      { \semio_viz_sig_stft_frame:n {##1} }
  }
% 🪟 Copies the window's worth of samples starting at the offset, tapers them with a Hann window, transforms them and paints one column of bins.
\cs_new_protected:Npn \semio_viz_sig_stft_frame:n #1
  {
    \seq_clear:N \l_semio_viz_sig_second_seq
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_sig_window_int }
      {
        \seq_put_right:Nx \l_semio_viz_sig_second_seq
          {
            \fp_to_decimal:n
              {
                \seq_item:Nn \l_semio_viz_sig_samples_seq { #1 + ##1 }
                * 0.5 * ( 1 - cos ( 2 * pi * ( ##1 - 1 ) / ( \l_semio_viz_sig_window_int - 1 ) ) )
              }
          }
      }
    \semio_viz_sci_dft:NNN \l_semio_viz_sig_second_seq \l_semio_viz_sig_mag_seq \l_semio_viz_sig_phase_seq
    \int_step_inline:nnnn { 1 } { 1 } { \seq_count:N \l_semio_viz_sig_mag_seq }
      { \semio_viz_sig_stft_cell:nn {#1} {##1} }
  }
% 🟦 One time–frequency cell, its magnitude optionally compressed to a forty-decibel scale, painted as a ramp-coloured tile or, in waterfall mode, as a little riser.
\cs_new_protected:Npn \semio_viz_sig_stft_cell:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sig_mag_seq {#2} } }
    \bool_if:NT \l_semio_viz_sig_db_bool
      {
        \fp_set:Nn \l_semio_viz_sci_a_fp
          { max ( 0 , 1 + 20 * ln ( max ( 1e-4 , \l_semio_viz_sci_a_fp ) ) / ln (10) / 40 ) }
      }
    \str_if_eq:VnTF \l_semio_viz_sig_mode_tl { waterfall }
      {
        \draw [ semio~sci~thin , draw=\semio_viz_sci_ramp:n { \l_semio_viz_sci_a_fp } ]
          ( \semio_viz_sci_mx:n { #1 / \l_semio_viz_sig_rate_fp } ,
            \semio_viz_sci_my:n { ( #2 - 1 ) * \l_semio_viz_sig_rate_fp / \l_semio_viz_sig_window_int } ) --
          ++ ( 0 , \fp_eval:n { 3 * \l_semio_viz_sci_a_fp } ) ;
      }
      {
        \fill [ fill=\semio_viz_sci_ramp:n { \l_semio_viz_sci_a_fp } ]
          ( \semio_viz_sci_mx:n { #1 / \l_semio_viz_sig_rate_fp } ,
            \semio_viz_sci_my:n { ( #2 - 1 ) * \l_semio_viz_sig_rate_fp / \l_semio_viz_sig_window_int } )
          rectangle
          ( \semio_viz_sci_mx:n { ( #1 + \l_semio_viz_sig_hop_int ) / \l_semio_viz_sig_rate_fp } ,
            \semio_viz_sci_my:n { #2 * \l_semio_viz_sig_rate_fp / \l_semio_viz_sig_window_int } ) ;
      }
    \semio_viz_sci_report_values:nn { timefreq/cell }
      { #1 , #2 , \fp_to_decimal:N \l_semio_viz_sci_a_fp }
  }
% 🌈 Morlet scalogram: the modulus of the continuous wavelet transform on a dyadic scale ladder.
\cs_new_protected:Npn \semio_viz_sig_scalogram:
  {
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_sig_scales_int }
      {
        \int_step_inline:nnnn { 0 } { 2 } { \l_semio_viz_sig_samples_int - 1 }
          { \semio_viz_sig_scalogram_cell:nn {##1} {####1} }
      }
  }
% 🐚 One scalogram tile: the Morlet wavelet of the given dyadic scale is correlated with the samples within twelve of the centre and its modulus, normalised by the square root of the scale, colours the tile.
\cs_new_protected:Npn \semio_viz_sig_scalogram_cell:nn #1#2
  {
    \fp_set:Nn \l_semio_viz_sci_g_fp { 2 ^ ( #1 / 3 ) }
    \fp_zero:N \l_semio_viz_sci_a_fp
    \fp_zero:N \l_semio_viz_sci_b_fp
    \int_step_inline:nnnn { \int_max:nn { 1 } { #2 - 12 } } { 1 }
      { \int_min:nn { \l_semio_viz_sig_samples_int } { #2 + 12 } }
      {
        \fp_set:Nn \l_semio_viz_sci_c_fp { ( ##1 - 1 - (#2) ) / \l_semio_viz_sci_g_fp }
        \fp_set:Nn \l_semio_viz_sci_d_fp
          { exp ( - \l_semio_viz_sci_c_fp * \l_semio_viz_sci_c_fp / 2 ) }
        \fp_add:Nn \l_semio_viz_sci_a_fp
          { \seq_item:Nn \l_semio_viz_sig_samples_seq {##1} * \l_semio_viz_sci_d_fp * cos ( 5 * \l_semio_viz_sci_c_fp ) }
        \fp_add:Nn \l_semio_viz_sci_b_fp
          { \seq_item:Nn \l_semio_viz_sig_samples_seq {##1} * \l_semio_viz_sci_d_fp * sin ( 5 * \l_semio_viz_sci_c_fp ) }
      }
    \fp_set:Nn \l_semio_viz_sci_f_fp
      {
        sqrt ( \l_semio_viz_sci_a_fp ^ 2 + \l_semio_viz_sci_b_fp ^ 2 )
        / sqrt ( \l_semio_viz_sci_g_fp ) / 6
      }
    \fill [ fill=\semio_viz_sci_ramp:n { \l_semio_viz_sci_f_fp } ]
      ( \semio_viz_sci_mx:n { #2 / \l_semio_viz_sig_rate_fp } ,
        \semio_viz_sci_my:n { \l_semio_viz_sig_rate_fp / ( 2 * \l_semio_viz_sci_g_fp ) } )
      rectangle
      ( \semio_viz_sci_mx:n { ( #2 + 2 ) / \l_semio_viz_sig_rate_fp } ,
        \semio_viz_sci_my:n { \l_semio_viz_sig_rate_fp / ( 2 * \l_semio_viz_sci_g_fp ) + 1.4 } ) ;
  }

%region 🔖️Keys
