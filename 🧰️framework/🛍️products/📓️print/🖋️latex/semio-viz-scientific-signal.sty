          { \semio_viz_sci_text:nn { G } { G } }
      } ;
    \fp_set:Nn \l_semio_viz_sci_g_fp { 6 }
    \clist_map_inline:Nn \l_semio_viz_mus_events_clist
      {
        \semio_viz_sig_record:n {##1}
        \semio_viz_mus_note:
      }
  }
% 🎶 Sets one event: a tilted ellipse head, hollow from a half note on, a stem for anything shorter than a whole note, a sharp or flat to its left, and the cursor advanced by the duration.
\cs_new_protected:Npn \semio_viz_mus_note:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp { \l_semio_viz_sci_g_fp }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \semio_viz_sig_field:n { 1 } * \l_semio_viz_mus_spacing_fp / 2 }
    \tl_set:Nx \l_semio_viz_sig_key_tl
      {
        \fp_compare:nNnTF { \semio_viz_sig_field:n { 2 } } < { 2 }
          { semio-chrome-foreground } { semio-chrome-base }
      }
    \begin{scope}
      [ shift={( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } )} , rotate=-20 ]
      \use:x { \exp_not:N \draw [ semio~sci~thin , fill=\l_semio_viz_sig_key_tl ]
        ( 0 , 0 ) ~ ellipse ~ [ x~radius=1.7 , y~radius=1.2 ] ; }
    \end{scope}
    \fp_compare:nNnT { \semio_viz_sig_field:n { 2 } } < { 4 }
      {
        \draw [ semio~sci~thin ]
          ( \fp_eval:n { \l_semio_viz_sci_a_fp + 1.6 } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
          ( \fp_eval:n { \l_semio_viz_sci_a_fp + 1.6 } , \fp_eval:n { \l_semio_viz_sci_b_fp + 9 } ) ;
      }
    \tl_set:Nx \l_semio_viz_sig_key_tl { \semio_viz_sig_field:n { 3 } }
    \str_case:VnF \l_semio_viz_sig_key_tl
      {
        { s }
          {
            \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=east ]
              at ( \fp_eval:n { \l_semio_viz_sci_a_fp - 2 } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) { \# } ;
          }
        { f }
          {
            \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=east ]
              at ( \fp_eval:n { \l_semio_viz_sci_a_fp - 2 } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) { b } ;
          }
      }
      { }
    \semio_viz_sci_report_values:nn { staff/note }
      { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \semio_viz_sig_field:n { 1 } , \semio_viz_sig_field:n { 2 } }
    \fp_add:Nn \l_semio_viz_sci_g_fp
      { \l_semio_viz_mus_stride_fp * \semio_viz_sig_field:n { 2 } }
  }

