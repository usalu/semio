  }

% 🎵 §44 pitch-space lattices: the Tonnetz triangulation, the circle of fifths, a harmonic network and a guitar chord grid.
\SemioVizFamily { sci-tonnetz }
  {
    \semio_viz_sci_enter:nnn { sci-tonnetz }
      {
        mode=tonnetz , columns=7 , rows=5 , size=9 , highlight={ 0 , 4 , 7 } ,
        frets=5 , strings=6 , fingering={ 2/1 , 3/2 , 4/2 } , axes=false , grid=false
      }
      {#1}
    \str_case:VnF \l_semio_viz_sig_mode_tl
      {
        { circle-of-fifths } { \semio_viz_mus_fifths: }
        { chord-diagram }    { \semio_viz_mus_chord: }
        { harmonic-network } { \semio_viz_mus_tonnetz:n { network } }
      }
      { \semio_viz_mus_tonnetz:n { lattice } }
  }
% 🔷 Sweeps the columns and rows of the pitch lattice, handing each site to the node renderer in either lattice or network flavour.
\cs_new_protected:Npn \semio_viz_mus_tonnetz:n #1
  {
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_mus_cols_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_mus_rows_int - 1 }
          { \semio_viz_mus_tonnetz_node:nnn {##1} {####1} {#1} }
      }
  }
% 🔺 One lattice site: rows offset by half a cell into a triangular grid, the pitch class seven fifths right and four thirds up modulo twelve, the two lattice edges drawn, and the label filled when highlighted.
\cs_new_protected:Npn \semio_viz_mus_tonnetz_node:nnn #1#2#3
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { ( #1 + 0.5 * \int_mod:nn {#2} { 2 } ) * \l_semio_viz_mus_size_fp }
    \fp_set:Nn \l_semio_viz_sci_b_fp { #2 * \l_semio_viz_mus_size_fp * 0.866 }
    \int_set:Nn \l_tmpa_int { \int_mod:nn { 7 * (#1) + 4 * (#2) } { 12 } }
    \str_if_eq:nnT {#3} { lattice }
      {
        \int_compare:nNnT {#1} < { \l_semio_viz_mus_cols_int - 1 }
          {
            \draw [ semio~sci~grid ]
              ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
              ( \fp_eval:n { \l_semio_viz_sci_a_fp + \l_semio_viz_mus_size_fp } ,
                \fp_eval:n { \l_semio_viz_sci_b_fp } ) ;
          }
        \int_compare:nNnT {#2} < { \l_semio_viz_mus_rows_int - 1 }
          {
            \draw [ semio~sci~grid ]
              ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
              ( \fp_eval:n { \l_semio_viz_sci_a_fp + 0.5 * \l_semio_viz_mus_size_fp } ,
                \fp_eval:n { \l_semio_viz_sci_b_fp + 0.866 * \l_semio_viz_mus_size_fp } ) ;
          }
      }
    \clist_if_in:NxTF \l_semio_viz_mus_highlight_clist { \int_use:N \l_tmpa_int }
      {
        \node [ semio~sci~glyph , circle , inner~sep=0.5mm , fill=semio-primary ,
                font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-base ]
          at ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } )
          { \int_use:N \l_tmpa_int } ;
      }
      {
        \node [ semio~sci~glyph , circle , inner~sep=0.5mm ,
                font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal ]
          at ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } )
          { \int_use:N \l_tmpa_int } ;
      }
    \semio_viz_sci_report_values:nn { tonnetz/node }
      { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp ,
        \int_use:N \l_tmpa_int }
  }
% 🕐 The circle of fifths: twelve labelled pitch classes stepping by seven semitones every thirty degrees clockwise from the top, filled where highlighted.
\cs_new_protected:Npn \semio_viz_mus_fifths:
  {
    \draw [ semio~sci~axis ] ( 0 , 0 ) circle [ radius=\fp_eval:n { 2.4 * \l_semio_viz_mus_size_fp } ] ;
    \int_step_inline:nnnn { 0 } { 1 } { 11 }
      {
        \int_set:Nn \l_tmpa_int { \int_mod:nn { 7 * ##1 } { 12 } }
        \clist_if_in:NxTF \l_semio_viz_mus_highlight_clist { \int_use:N \l_tmpa_int }
          {
            \node [ semio~sci~glyph , circle , inner~sep=0.6mm , fill=semio-primary ,
                    font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-base ]
              at ( \fp_eval:n { 2.4 * \l_semio_viz_mus_size_fp * cosd ( 90 - 30 * ##1 ) } ,
                   \fp_eval:n { 2.4 * \l_semio_viz_mus_size_fp * sind ( 90 - 30 * ##1 ) } )
              { \int_use:N \l_tmpa_int } ;
          }
          {
            \node [ semio~sci~glyph , circle , inner~sep=0.6mm ,
                    font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground ]
              at ( \fp_eval:n { 2.4 * \l_semio_viz_mus_size_fp * cosd ( 90 - 30 * ##1 ) } ,
                   \fp_eval:n { 2.4 * \l_semio_viz_mus_size_fp * sind ( 90 - 30 * ##1 ) } )
              { \int_use:N \l_tmpa_int } ;
          }
      }
  }
% 🎸 A chord grid: the strings as verticals and the frets as horizontals, with a filled dot centred in the fret for every fingering.
\cs_new_protected:Npn \semio_viz_mus_chord:
  {
    \int_step_inline:nnnn { 1 } { 1 } { \l_semio_viz_mus_strings_int }
      {
        \draw [ semio~sci~axis ]
          ( \fp_eval:n { ##1 * \l_semio_viz_mus_size_fp / 2 } , 0 ) --
          ( \fp_eval:n { ##1 * \l_semio_viz_mus_size_fp / 2 } ,
            \fp_eval:n { - \l_semio_viz_mus_frets_int * \l_semio_viz_mus_size_fp / 2 } ) ;
      }
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_mus_frets_int }
      {
        \draw [ semio~sci~axis ]
          ( \fp_eval:n { \l_semio_viz_mus_size_fp / 2 } ,
            \fp_eval:n { - ##1 * \l_semio_viz_mus_size_fp / 2 } ) --
          ( \fp_eval:n { \l_semio_viz_mus_strings_int * \l_semio_viz_mus_size_fp / 2 } ,
            \fp_eval:n { - ##1 * \l_semio_viz_mus_size_fp / 2 } ) ;
      }
    \clist_map_inline:Nn \l_semio_viz_mus_fingering_clist
      {
        \semio_viz_sig_record:n {##1}
        \fill [ fill=semio-primary ]
          ( \fp_eval:n { \semio_viz_sig_field:n { 1 } * \l_semio_viz_mus_size_fp / 2 } ,
            \fp_eval:n { - ( \semio_viz_sig_field:n { 2 } - 0.5 ) * \l_semio_viz_mus_size_fp / 2 } )
          circle [ radius=1.3 ] ;
        \semio_viz_sci_report_values:nn { chord/finger }
          { \semio_viz_sig_field:n { 1 } , \semio_viz_sig_field:n { 2 } }
      }
  }
