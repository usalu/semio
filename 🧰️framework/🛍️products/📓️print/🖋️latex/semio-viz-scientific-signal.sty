% 🎼 §44 staff notation: five lines, a clef glyph and note heads with stems, placed from an event table.
\SemioVizFamily { sci-staff }
  {
    \semio_viz_sci_enter:nnn { sci-staff }
      {
        clef=treble , spacing=5.5 , stride=7 , beams=true , axes=false , grid=false ,
        events={ 0/1/n , 2/1/n , 4/0.5/s , 5/0.5/n , 7/2/n , 4/1/f , 2/1/n , 0/2/n }
      }
      {#1}
