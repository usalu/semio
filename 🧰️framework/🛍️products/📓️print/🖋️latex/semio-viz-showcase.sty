%endregion 🔖️Family-encoding

%region 🔖️Keys-scale
% 🔑 semio / viz / family / scale — the fifteen §78 scale kinds as catalogue kinds. Every kind
% draws the same anatomy — a track of samples plus the guide its kind deserves — so what differs
% between two of them is exactly the mapping the scale performs.
%   variant     (choice) linear|logarithmic|power|square-root|symlog|identity|ordinal|band-scale|
%                        point-scale|quantile|quantize|threshold|sequential|diverging|temporal,
%                        default linear
%   data        (table)  table the sample values are read from, default `demo`
%   column      (column) numeric column sampled onto the scale, default `val`
%   category    (column) categorical column feeding the discrete kinds, default `cat`
%   date        (column) ISO date column feeding the temporal kind, default `date`
%   timeData    (table)  table the temporal kind reads, default `demo-time`
%   domain      (clist)  continuous input domain `lo,hi`, default `0,10`
%   logDomain   (clist)  input domain of the logarithmic kind, default `1,10`
%   divergingDomain (clist) three-point domain of the diverging kind, default `-10,0,10`
%   timeDomain  (clist)  input domain of the temporal kind, default `2026-01-01,2026-12-01`
%   thresholds  (clist)  cut points of the threshold kind, default `4,6`
%   range       (clist)  output offsets in millimetres from the plot origin, default `0,60`
%   nice        (bool)   extend the domain to round tick values, default false
%   ticks       (int)    target tick count of the axis and the gradient legend, default 5
%   base        (fp)     base of the logarithmic kind, default 10
%   exponent    (fp)     exponent of the power kind, default 2
%   constant    (fp)     linear-region constant of the symlog kind, default 1
%   bins        (int)    range entries of the binned and ordinal kinds, default 4
%   swatch      (fp)     edge length of one discrete swatch in millimetres, default 4
\tl_new:N \l_semio_viz_scs_variant_tl
\tl_new:N \l_semio_viz_scs_data_tl
\tl_new:N \l_semio_viz_scs_column_tl
\tl_new:N \l_semio_viz_scs_category_tl
\tl_new:N \l_semio_viz_scs_date_tl
\tl_new:N \l_semio_viz_scs_timedata_tl
\clist_new:N \l_semio_viz_scs_domain_clist
\clist_new:N \l_semio_viz_scs_logdomain_clist
\clist_new:N \l_semio_viz_scs_divdomain_clist
\clist_new:N \l_semio_viz_scs_timedomain_clist
\clist_new:N \l_semio_viz_scs_thresholds_clist
\clist_new:N \l_semio_viz_scs_range_clist
\bool_new:N \l_semio_viz_scs_nice_bool
\int_new:N \l_semio_viz_scs_ticks_int
\int_new:N \l_semio_viz_scs_bins_int
\fp_new:N \l_semio_viz_scs_base_fp
\fp_new:N \l_semio_viz_scs_exponent_fp
\fp_new:N \l_semio_viz_scs_constant_fp
\fp_new:N \l_semio_viz_scs_swatch_fp
\tl_new:N \l_semio_viz_scs_kind_tl
\tl_new:N \l_semio_viz_scs_table_tl
\tl_new:N \l_semio_viz_scs_source_tl
\tl_new:N \l_semio_viz_scs_dom_tl
\tl_new:N \l_semio_viz_scs_rng_tl
\fp_new:N \l_semio_viz_scs_pos_fp
\fp_new:N \l_semio_viz_scs_row_fp
\fp_new:N \l_semio_viz_scs_track_fp

\keys_define:nn { semio / viz / family / scale } {
  variant .tl_set:N = \l_semio_viz_scs_variant_tl,
  data .tl_set:N = \l_semio_viz_scs_data_tl,
  column .tl_set:N = \l_semio_viz_scs_column_tl,
  category .tl_set:N = \l_semio_viz_scs_category_tl,
  date .tl_set:N = \l_semio_viz_scs_date_tl,
  timeData .tl_set:N = \l_semio_viz_scs_timedata_tl,
  domain .clist_set:N = \l_semio_viz_scs_domain_clist,
  logDomain .clist_set:N = \l_semio_viz_scs_logdomain_clist,
  divergingDomain .clist_set:N = \l_semio_viz_scs_divdomain_clist,
  timeDomain .clist_set:N = \l_semio_viz_scs_timedomain_clist,
  thresholds .clist_set:N = \l_semio_viz_scs_thresholds_clist,
  range .clist_set:N = \l_semio_viz_scs_range_clist,
  nice .bool_set:N = \l_semio_viz_scs_nice_bool,
  ticks .int_set:N = \l_semio_viz_scs_ticks_int,
  bins .int_set:N = \l_semio_viz_scs_bins_int,
  base .fp_set:N = \l_semio_viz_scs_base_fp,
  exponent .fp_set:N = \l_semio_viz_scs_exponent_fp,
  constant .fp_set:N = \l_semio_viz_scs_constant_fp,
  swatch .fp_set:N = \l_semio_viz_scs_swatch_fp,
}

% 🧹 Restores every scale key to its documented default before a kind reads its options.
\cs_new_protected:Npn \semio_viz_scs_keys_reset: {
  \tl_set:Nn \l_semio_viz_scs_variant_tl { linear }
  \tl_set:Nn \l_semio_viz_scs_data_tl { demo }
  \tl_set:Nn \l_semio_viz_scs_column_tl { val }
  \tl_set:Nn \l_semio_viz_scs_category_tl { cat }
  \tl_set:Nn \l_semio_viz_scs_date_tl { date }
  \tl_set:Nn \l_semio_viz_scs_timedata_tl { demo-time }
  \clist_set:Nn \l_semio_viz_scs_domain_clist { 0 , 10 }
  \clist_set:Nn \l_semio_viz_scs_logdomain_clist { 1 , 10 }
  \clist_set:Nn \l_semio_viz_scs_divdomain_clist { -10 , 0 , 10 }
  \clist_set:Nn \l_semio_viz_scs_timedomain_clist { 2026-01-01 , 2026-12-01 }
  \clist_set:Nn \l_semio_viz_scs_thresholds_clist { 4 , 6 }
  \clist_set:Nn \l_semio_viz_scs_range_clist { 0 , 60 }
  \bool_set_false:N \l_semio_viz_scs_nice_bool
  \int_set:Nn \l_semio_viz_scs_ticks_int { 5 }
  \int_set:Nn \l_semio_viz_scs_bins_int { 4 }
  \fp_set:Nn \l_semio_viz_scs_base_fp { 10 }
  \fp_set:Nn \l_semio_viz_scs_exponent_fp { 2 }
  \fp_set:Nn \l_semio_viz_scs_constant_fp { 1 }
  \fp_set:Nn \l_semio_viz_scs_swatch_fp { 4 }
}
%endregion 🔖️Keys-scale

%region 🔖️Family-scale
% 🏷️ The scale kernel's own kind name behind a §78 catalogue slug.
\cs_new_protected:Npn \semio_viz_scs_kind: {
  \tl_set:Nx \l_semio_viz_scs_kind_tl
    {
      \str_case:VnF \l_semio_viz_scs_variant_tl
        {
          { logarithmic } { log }
          { power } { pow }
          { square-root } { sqrt }
          { band-scale } { band }
          { point-scale } { point }
        }
        { \l_semio_viz_scs_variant_tl }
    }
}

% 📏 The millimetre track the scale's range occupies: the `range` offsets measured from the
% plot origin and clipped to the frame, so one catalogue range works at any figure width.
\cs_new_protected:Npn \semio_viz_scs_range: {
  \fp_set:Nn \l_semio_viz_sc_xb_fp
    {
      min ( \l_semio_viz_sc_xb_fp ,
        \l_semio_viz_sc_xa_fp + \clist_item:Nn \l_semio_viz_scs_range_clist { 2 } )
    }
  \fp_set:Nn \l_semio_viz_sc_xa_fp
    { \l_semio_viz_sc_xa_fp + \clist_item:Nn \l_semio_viz_scs_range_clist { 1 } }
  \tl_set:Nx \l_semio_viz_scs_rng_tl
    { \fp_to_decimal:N \l_semio_viz_sc_xa_fp , \fp_to_decimal:N \l_semio_viz_sc_xb_fp }
}

% 🏷️ The discrete domain: the distinct values of the bound categorical column.
\cs_new_protected:Npn \semio_viz_scs_categories: {
  \semio_viz_table_col_values:VVN \l_semio_viz_scs_data_tl \l_semio_viz_scs_category_tl
    \l_semio_viz_sc_values_seq
  \tl_set:Nx \l_semio_viz_scs_dom_tl { \seq_use:Nn \l_semio_viz_sc_values_seq { , } }
  \tl_set_eq:NN \l_semio_viz_scs_source_tl \l_semio_viz_scs_category_tl
}

% 🔢 The range `0,1,…,bins-1` the binned and ordinal kinds map onto: those kinds carry bin
% indices, not millimetres, and the renderer turns an index into a hue.
\cs_new_protected:Npn \semio_viz_scs_index_range: {
  \seq_clear:N \l_semio_viz_sc_values_seq
  \int_step_inline:nn { \l_semio_viz_scs_bins_int }
    { \seq_put_right:Nn \l_semio_viz_sc_values_seq { \int_eval:n { ##1 - 1 } } }
  \tl_set:Nx \l_semio_viz_scs_rng_tl { \seq_use:Nn \l_semio_viz_sc_values_seq { , } }
}

% 🧊 The range a kind carries when it is not a plain position: bin indices for the four discrete
% kinds, the unit interval for the two ramps, and its own domain for `identity` — a d3 identity
% scale IS range equals domain, which is why its track does not stretch to the frame.
\cs_new_protected:Npn \semio_viz_scs_binned_range: {
  \str_case:Vn \l_semio_viz_scs_kind_tl
    {
      { identity } { \tl_set_eq:NN \l_semio_viz_scs_rng_tl \l_semio_viz_scs_dom_tl }
      { quantize } { \semio_viz_scs_index_range: }
      { quantile } { \semio_viz_scs_index_range: }
      { threshold } { \semio_viz_scs_index_range: }
      { ordinal } { \semio_viz_scs_index_range: }
      { sequential } { \tl_set:Nn \l_semio_viz_scs_rng_tl { 0 , 1 } }
      { diverging } { \tl_set:Nn \l_semio_viz_scs_rng_tl { 0 , 1 } }
    }
}

% 🎚️ Domain, range and options of the scale the variant asks for, registered as `showcase-scale`.
\cs_new_protected:Npn \semio_viz_scs_define: {
  \tl_set_eq:NN \l_semio_viz_scs_table_tl \l_semio_viz_scs_data_tl
  \tl_set_eq:NN \l_semio_viz_scs_source_tl \l_semio_viz_scs_column_tl
  \str_case:VnF \l_semio_viz_scs_kind_tl
    {
      { log }
        { \tl_set:Nx \l_semio_viz_scs_dom_tl
            { \clist_use:Nn \l_semio_viz_scs_logdomain_clist { , } } }
      { diverging }
        { \tl_set:Nx \l_semio_viz_scs_dom_tl
            { \clist_use:Nn \l_semio_viz_scs_divdomain_clist { , } } }
      { threshold }
        { \tl_set:Nx \l_semio_viz_scs_dom_tl
            { \clist_use:Nn \l_semio_viz_scs_thresholds_clist { , } } }
      { temporal }
        {
          \tl_set:Nx \l_semio_viz_scs_dom_tl
            { \clist_use:Nn \l_semio_viz_scs_timedomain_clist { , } }
          \tl_set_eq:NN \l_semio_viz_scs_table_tl \l_semio_viz_scs_timedata_tl
          \tl_set_eq:NN \l_semio_viz_scs_source_tl \l_semio_viz_scs_date_tl
        }
      { quantile }
        {
          \semio_viz_table_col_values:VVN \l_semio_viz_scs_data_tl \l_semio_viz_scs_column_tl
            \l_semio_viz_sc_values_seq
          \tl_set:Nx \l_semio_viz_scs_dom_tl { \seq_use:Nn \l_semio_viz_sc_values_seq { , } }
        }
      { band } { \semio_viz_scs_categories: }
      { point } { \semio_viz_scs_categories: }
      { ordinal } { \semio_viz_scs_categories: }
    }
    { \tl_set:Nx \l_semio_viz_scs_dom_tl { \clist_use:Nn \l_semio_viz_scs_domain_clist { , } } }
  \semio_viz_scs_binned_range:
  \use:x {
    \exp_not:N \semio_viz_scale_define:nnnnn { showcase-scale }
      { \exp_not:V \l_semio_viz_scs_kind_tl }
      { \exp_not:V \l_semio_viz_scs_dom_tl }
      { \exp_not:V \l_semio_viz_scs_rng_tl }
      {
        nice = \bool_if:NTF \l_semio_viz_scs_nice_bool { 10 } { 0 } ,
        ticks = \int_use:N \l_semio_viz_scs_ticks_int ,
        base = \fp_to_decimal:N \l_semio_viz_scs_base_fp ,
        exponent = \fp_to_decimal:N \l_semio_viz_scs_exponent_fp ,
        constant = \fp_to_decimal:N \l_semio_viz_scs_constant_fp
      }
  }
}

% ⚫ The positional sample: a dot at the millimetre the scale mapped the value to.
\cs_new_protected:Npn \semio_viz_scs_position_dot: {
  \semio_viz_sc_hue:n { 0 }
  \tl_set:Nx \l_semio_viz_sc_opts_tl { fill = \exp_not:V \l_semio_viz_sc_hue_tl , size = 4 }
  \semio_viz_sc_mark:nnn { dot } { \l_semio_viz_scs_pos_fp } { \l_semio_viz_scs_row_fp }
}

% ▨ The binned sample: a swatch in the hue of the bin the value fell into.
\cs_new_protected:Npn \semio_viz_scs_swatch: {
  \semio_viz_sc_hue:n { \fp_to_int:n { \l_semio_viz_scs_pos_fp } }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    { fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none }
  \semio_viz_sc_rect:nnnn
    { \l_semio_viz_sc_xa_fp + \l_semio_viz_scs_swatch_fp }
    { \l_semio_viz_scs_row_fp }
    { \l_semio_viz_scs_swatch_fp * 2 } { \l_semio_viz_scs_swatch_fp }
}

% 🌡️ The ramp sample: a dot at the normalized position, filled from the theme's own ramp.
\cs_new_protected:Npn \semio_viz_scs_ramp_dot: {
  \semio_viz_theme_ramp_color:nN { \l_semio_viz_scs_pos_fp } \l_semio_viz_sc_hue_tl
  \tl_set:Nx \l_semio_viz_sc_opts_tl { fill = \exp_not:V \l_semio_viz_sc_hue_tl , size = 6 }
  \semio_viz_sc_mark:nnn { dot }
    {
      \l_semio_viz_sc_xa_fp
        + \l_semio_viz_scs_pos_fp * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
    }
    { \l_semio_viz_scs_row_fp }
}

% 🎨 A positional kind puts a dot where the scale sent the value; a colour-valued kind paints
% a swatch, and a ramp kind a dot on the ramp's own normalized position.
\cs_new_protected:Npn \semio_viz_scs_sample_draw: {
  \str_case:VnF \l_semio_viz_scs_kind_tl
    {
      { quantize } { \semio_viz_scs_swatch: }
      { quantile } { \semio_viz_scs_swatch: }
      { threshold } { \semio_viz_scs_swatch: }
      { ordinal } { \semio_viz_scs_swatch: }
      { sequential } { \semio_viz_scs_ramp_dot: }
      { diverging } { \semio_viz_scs_ramp_dot: }
    }
    { \semio_viz_scs_position_dot: }
}

% 📍 One sample of the track, mapped through the scale onto its own row.
\cs_new_protected:Npn \semio_viz_scs_sample:n #1 {
  \tl_set:Nx \l_semio_viz_sc_cell_tl { \seq_item:Nn \l_semio_viz_sc_values_seq {#1} }
  \semio_viz_scale_map:nVN { showcase-scale } \l_semio_viz_sc_cell_tl \l_semio_viz_scs_pos_fp
  \fp_set:Nn \l_semio_viz_scs_row_fp
    { \l_semio_viz_sc_ya_fp + 4 + ( #1 - 0.5 ) * \l_semio_viz_scs_track_fp }
  \semio_viz_scs_sample_draw:
}

% 📈 The sample track: every value of the bound column mapped through the scale, one row per
% datum, so a reader sees where each one lands.
\cs_new_protected:Npn \semio_viz_scs_track: {
  \semio_viz_table_col_values:VVN \l_semio_viz_scs_table_tl \l_semio_viz_scs_source_tl
    \l_semio_viz_sc_values_seq
  \int_set:Nn \l_semio_viz_sc_rows_int { \seq_count:N \l_semio_viz_sc_values_seq }
  \fp_set:Nn \l_semio_viz_scs_track_fp
    { ( \l_semio_viz_sc_yb_fp - \l_semio_viz_sc_ya_fp - 6 ) / max ( 1 , \l_semio_viz_sc_rows_int ) }
  \int_step_inline:nn { \l_semio_viz_sc_rows_int } { \semio_viz_scs_sample:n {##1} }
}

% 🌈 The gradient legend of a ramp kind, on the frame's own track.
\cs_new_protected:Npn \semio_viz_scs_legend: {
  \use:x {
    \exp_not:N \semio_viz_legend_draw:n
      {
        scale = showcase-scale , kind = gradient ,
        ticks = \int_use:N \l_semio_viz_scs_ticks_int ,
        length = \fp_to_decimal:n { \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp } ,
        at = { \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
               \fp_to_decimal:n { \l_semio_viz_sc_ya_fp + 3 } }
      }
  }
}

% 🧭 The guide the scale kind deserves: an axis for a positional kind, a gradient legend for
% the two ramp kinds; the bin swatches speak for themselves.
\cs_new_protected:Npn \semio_viz_scs_guide: {
  \str_case:VnF \l_semio_viz_scs_kind_tl
    {
      { sequential } { \semio_viz_scs_legend: }
      { diverging } { \semio_viz_scs_legend: }
      { ordinal } { }
      { quantize } { }
      { quantile } { }
      { threshold } { }
    }
    {
      \use:x {
        \exp_not:N \semio_viz_guide_axis_draw:n
          {
            scale = showcase-scale , orient = bottom ,
            ticks = \int_use:N \l_semio_viz_scs_ticks_int
          }
      }
    }
}

% 📐 One §78 scale capability, rendered as a catalogue kind.
\cs_new_protected:Npn \semio_viz_scs_render:n #1 {
  \semio_viz_sc_frame:
  \semio_viz_scs_keys_reset:
  \keys_set:nn { semio / viz / family / scale } {#1}
  \semio_viz_scs_kind:
  \semio_viz_scs_range:
  \semio_viz_scs_define:
  \semio_viz_scs_track:
  \semio_viz_scs_guide:
  \semio_viz_sc_caption:nn
    { Scale~kind~\l_semio_viz_scs_kind_tl }
    { Skalenart~\l_semio_viz_scs_kind_tl }
}

% 📏 §75: one scale kind per figure, drawn as the mapping it performs over a shared domain.
\SemioVizFamily{scale}{ \semio_viz_scs_render:n {#1} }
%endregion 🔖️Family-scale

%region 🔖️Keys-shape
% 🔑 semio / viz / family / shape — the §78 shape generators as catalogue kinds. Each kind runs
% one generator repeatedly with a different parameter per repetition, so the generator's own
% vocabulary is what the reader sees varying.
%   variant  (choice) lines|areas|arcs|links|ribbons, default lines
%   data     (table)  table the generators read, default `demo`
%   y        (column) column mapped onto the vertical axis, default `val`
%   curves   (clist)  interpolators the lines and areas kinds cycle through,
%                     default `linear,cardinal,natural,step`
%   count    (int)    repetitions of the generator, default 4
%   innerRadius (fp)  inner radius of the arcs kind, default 4
%   outerRadius (fp)  outer radius of the arcs and ribbons kinds, default 14
%   padAngle (fp)     pad angle between two arcs or ribbon ends, default 0.04
%   corner   (fp)     corner radius of the arcs kind, default 0.6
\tl_new:N \l_semio_viz_sch_variant_tl
\tl_new:N \l_semio_viz_sch_data_tl
\tl_new:N \l_semio_viz_sch_y_tl
\clist_new:N \l_semio_viz_sch_curves_clist
\int_new:N \l_semio_viz_sch_count_int
\fp_new:N \l_semio_viz_sch_inner_fp
\fp_new:N \l_semio_viz_sch_outer_fp
\fp_new:N \l_semio_viz_sch_pad_fp
\fp_new:N \l_semio_viz_sch_corner_fp
\tl_new:N \l_semio_viz_sch_points_tl
\tl_new:N \l_semio_viz_sch_base_tl
\fp_new:N \l_semio_viz_sch_step_fp
\fp_new:N \l_semio_viz_sch_cx_fp
\fp_new:N \l_semio_viz_sch_cy_fp

\keys_define:nn { semio / viz / family / shape } {
  variant .tl_set:N = \l_semio_viz_sch_variant_tl,
  data .tl_set:N = \l_semio_viz_sch_data_tl,
  y .tl_set:N = \l_semio_viz_sch_y_tl,
  curves .clist_set:N = \l_semio_viz_sch_curves_clist,
  count .int_set:N = \l_semio_viz_sch_count_int,
  innerRadius .fp_set:N = \l_semio_viz_sch_inner_fp,
  outerRadius .fp_set:N = \l_semio_viz_sch_outer_fp,
  padAngle .fp_set:N = \l_semio_viz_sch_pad_fp,
  corner .fp_set:N = \l_semio_viz_sch_corner_fp,
}

% 🧹 Restores every shape key to its documented default before a kind reads its options.
\cs_new_protected:Npn \semio_viz_sch_keys_reset: {
  \tl_set:Nn \l_semio_viz_sch_variant_tl { lines }
  \tl_set:Nn \l_semio_viz_sch_data_tl { demo }
  \tl_set:Nn \l_semio_viz_sch_y_tl { val }
  \clist_set:Nn \l_semio_viz_sch_curves_clist { linear , cardinal , natural , step }
  \int_set:Nn \l_semio_viz_sch_count_int { 4 }
  \fp_set:Nn \l_semio_viz_sch_inner_fp { 4 }
  \fp_set:Nn \l_semio_viz_sch_outer_fp { 14 }
  \fp_set:Nn \l_semio_viz_sch_pad_fp { 0.04 }
  \fp_set:Nn \l_semio_viz_sch_corner_fp { 0.6 }
}
%endregion 🔖️Keys-shape

%region 🔖️Family-shape
% 📈 The bound series as a millimetre point list plus its baseline, lifted by #1 so repeated
% generators stay legible on top of each other.
\cs_new_protected:Npn \semio_viz_sch_points:n #1 {
  \semio_viz_table_col_values:VVN \l_semio_viz_sch_data_tl \l_semio_viz_sch_y_tl
    \l_semio_viz_sc_values_seq
  \int_set:Nn \l_semio_viz_sc_rows_int { \seq_count:N \l_semio_viz_sc_values_seq }
  \semio_viz_table_col_min:VVN \l_semio_viz_sch_data_tl \l_semio_viz_sch_y_tl
    \l_semio_viz_sc_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_sch_data_tl \l_semio_viz_sch_y_tl
    \l_semio_viz_sc_hi_fp
  \fp_set:Nn \l_semio_viz_sc_step_fp
    { ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / max ( 1 , \l_semio_viz_sc_rows_int - 1 ) }
  \tl_clear:N \l_semio_viz_sch_points_tl
  \tl_clear:N \l_semio_viz_sch_base_tl
  \int_step_inline:nn { \l_semio_viz_sc_rows_int }
    {
      \tl_put_right:Nx \l_semio_viz_sch_points_tl
        {
          \tl_if_empty:NF \l_semio_viz_sch_points_tl { ; }
          \fp_to_decimal:n { \l_semio_viz_sc_xa_fp + ( ##1 - 1 ) * \l_semio_viz_sc_step_fp } ,
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_ya_fp + 2 + (#1)
                + ( \seq_item:Nn \l_semio_viz_sc_values_seq {##1} - \l_semio_viz_sc_lo_fp )
                  / max ( 1e-9 , \l_semio_viz_sc_hi_fp - \l_semio_viz_sc_lo_fp )
                  * ( \l_semio_viz_sc_yb_fp - \l_semio_viz_sc_ya_fp - 8 - (#1) )
            }
        }
      \tl_put_right:Nx \l_semio_viz_sch_base_tl
        {
          \tl_if_empty:NF \l_semio_viz_sch_base_tl { ; }
          \fp_to_decimal:n { \l_semio_viz_sc_xa_fp + ( ##1 - 1 ) * \l_semio_viz_sc_step_fp } ,
          \fp_to_decimal:n { \l_semio_viz_sc_ya_fp + 1 }
        }
    }
}

% 📈 d3-line once per interpolator: the same data, the same frame, a different generator.
\cs_new_protected:Npn \semio_viz_sch_lines: {
  \int_step_inline:nn { \l_semio_viz_sch_count_int }
    {
      \semio_viz_sch_points:n { ##1 * 1.5 }
      \semio_viz_sc_hue:n { ##1 - 1 }
      \use:x {
        \exp_not:N \SemioVizLine
          [
            points = { \exp_not:V \l_semio_viz_sch_points_tl } ,
            curve = \clist_item:Nn \l_semio_viz_sch_curves_clist {##1} ,
            fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl
          ]
      }
    }
}

% 🏔️ d3-area once per interpolator, each on its own baseline, so both boundaries of the
% generator are visible.
\cs_new_protected:Npn \semio_viz_sch_areas: {
  \int_step_inline:nn { \l_semio_viz_sch_count_int }
    {
      \semio_viz_sch_points:n { ##1 * 2 }
      \semio_viz_sc_hue:n { ##1 - 1 }
      \use:x {
        \exp_not:N \SemioVizArea
          [
            points = { \exp_not:V \l_semio_viz_sch_points_tl } ,
            points2 = { \exp_not:V \l_semio_viz_sch_base_tl } ,
            curve = \clist_item:Nn \l_semio_viz_sch_curves_clist {##1} ,
            fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none , opacity = 0.35
          ]
      }
    }
}

% 🎯 The centre of the round generators inside the current frame.
\cs_new_protected:Npn \semio_viz_sch_centre: {
  \fp_set:Nn \l_semio_viz_sch_cx_fp { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_sch_cy_fp { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp ) / 2 }
}

% 🥧 d3-arc: one sector per row of the bound column, its outer radius carrying the value and
% its corner radius and pad angle showing what the generator adds beyond a bare wedge.
\cs_new_protected:Npn \semio_viz_sch_arcs: {
  \semio_viz_table_col_values:VVN \l_semio_viz_sch_data_tl \l_semio_viz_sch_y_tl
    \l_semio_viz_sc_values_seq
  \int_set:Nn \l_semio_viz_sc_rows_int { \seq_count:N \l_semio_viz_sc_values_seq }
  \semio_viz_table_col_max:VVN \l_semio_viz_sch_data_tl \l_semio_viz_sch_y_tl
    \l_semio_viz_sc_hi_fp
  \fp_set:Nn \l_semio_viz_sch_step_fp { 2 * pi / max ( 1 , \l_semio_viz_sc_rows_int ) }
  \semio_viz_sch_centre:
  \int_step_inline:nn { \l_semio_viz_sc_rows_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \use:x {
        \exp_not:N \SemioVizArc
          [
            at = { \fp_to_decimal:N \l_semio_viz_sch_cx_fp ,
                   \fp_to_decimal:N \l_semio_viz_sch_cy_fp } ,
            innerRadius = \fp_to_decimal:N \l_semio_viz_sch_inner_fp ,
            outerRadius = \fp_to_decimal:n
              {
                \l_semio_viz_sch_inner_fp + 2
                  + \seq_item:Nn \l_semio_viz_sc_values_seq {##1}
                    / max ( 1e-9 , \l_semio_viz_sc_hi_fp )
                    * ( \l_semio_viz_sch_outer_fp - \l_semio_viz_sch_inner_fp )
              } ,
            startAngle = \fp_to_decimal:n { ( ##1 - 1 ) * \l_semio_viz_sch_step_fp } ,
            endAngle = \fp_to_decimal:n { ##1 * \l_semio_viz_sch_step_fp } ,
            padAngle = \fp_to_decimal:N \l_semio_viz_sch_pad_fp ,
            cornerRadius = \fp_to_decimal:N \l_semio_viz_sch_corner_fp ,
            fill = \exp_not:V \l_semio_viz_sc_hue_tl
          ]
      }
    }
}

% 🔗 d3-link: one bump per repetition, cycling the three link flavours.
\cs_new_protected:Npn \semio_viz_sch_links: {
  \fp_set:Nn \l_semio_viz_sch_step_fp
    {
      ( \l_semio_viz_sc_yb_fp - \l_semio_viz_sc_ya_fp )
        / max ( 1 , \l_semio_viz_sch_count_int + 1 )
    }
  \int_step_inline:nn { \l_semio_viz_sch_count_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \use:x {
        \exp_not:N \SemioVizLink
          [
            kind = \int_case:nnF { \int_mod:nn { ##1 } { 3 } }
              { { 1 } { horizontal } { 2 } { vertical } } { radial } ,
            source = { \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
                       \fp_to_decimal:n
                         { \l_semio_viz_sc_ya_fp + ##1 * \l_semio_viz_sch_step_fp } } ,
            target = { \fp_to_decimal:N \l_semio_viz_sc_xb_fp ,
                       \fp_to_decimal:n
                         { \l_semio_viz_sc_yb_fp - ##1 * \l_semio_viz_sch_step_fp } } ,
            fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl
          ]
      }
    }
}

% 🎀 d3-chord's ribbon: one band per repetition between two arcs of the same circle.
\cs_new_protected:Npn \semio_viz_sch_ribbons: {
  \semio_viz_sch_centre:
  \fp_set:Nn \l_semio_viz_sch_step_fp { 2 * pi / max ( 1 , 2 * \l_semio_viz_sch_count_int ) }
  \int_step_inline:nn { \l_semio_viz_sch_count_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \use:x {
        \exp_not:N \SemioVizRibbon
          [
            at = { \fp_to_decimal:N \l_semio_viz_sch_cx_fp ,
                   \fp_to_decimal:N \l_semio_viz_sch_cy_fp } ,
            radius = \fp_to_decimal:N \l_semio_viz_sch_outer_fp ,
            startAngle = \fp_to_decimal:n { ( ##1 - 1 ) * \l_semio_viz_sch_step_fp } ,
            endAngle = \fp_to_decimal:n { ( ##1 - 0.4 ) * \l_semio_viz_sch_step_fp } ,
            targetStartAngle = \fp_to_decimal:n
              { ( ##1 + \l_semio_viz_sch_count_int - 1 ) * \l_semio_viz_sch_step_fp } ,
            targetEndAngle = \fp_to_decimal:n
              { ( ##1 + \l_semio_viz_sch_count_int - 0.4 ) * \l_semio_viz_sch_step_fp } ,
            padAngle = \fp_to_decimal:N \l_semio_viz_sch_pad_fp ,
            fill = \exp_not:V \l_semio_viz_sc_hue_tl , opacity = 0.5
          ]
      }
    }
}

% 📐 One §78 shape generator, rendered as a catalogue kind.
\cs_new_protected:Npn \semio_viz_sch_render:n #1 {
  \semio_viz_sc_frame:
  \semio_viz_sch_keys_reset:
  \keys_set:nn { semio / viz / family / shape } {#1}
  \str_case:VnF \l_semio_viz_sch_variant_tl
    {
      { areas } { \semio_viz_sch_areas: }
      { arcs } { \semio_viz_sch_arcs: }
      { links } { \semio_viz_sch_links: }
      { ribbons } { \semio_viz_sch_ribbons: }
    }
    { \semio_viz_sch_lines: }
  \semio_viz_sc_caption:nn
    { Shape~generator~\l_semio_viz_sch_variant_tl }
    { Formgenerator~\l_semio_viz_sch_variant_tl }
}

% ➰ §75: one shape generator per kind, over the point set every generator here shares.
\SemioVizFamily{shape}{ \semio_viz_sch_render:n {#1} }
%endregion 🔖️Family-shape

%region 🔖️Keys-layout-algorithm
% 🔑 semio / viz / family / layout-algorithm — the §75 layout algorithms as catalogue kinds.
% Every kind runs the algorithm of its name through the layout dispatcher and paints the result as
% marks, so what the reader sees is the layout's own output and never a drawing of one.
%   variant  (choice) stack|normalized-stack|diverging-stack|streamgraph-stack|
%                     histogram-binning|jitter-layout|pie-layout, default stack
%   data     (table)  the one table this kind reads. Empty means the table the kind's own algorithm
%                     needs — `demo-series` for the stacking kinds, `demo-distribution` for the
%                     binning and jitter kinds, `demo` for the pie kind — and a catalogue entry's
%                     own `data` field always wins, because the entry names the table the kind
%                     is registered against.
%   x        (column) column laid out along the horizontal axis, default `t`
%   series   (column) column whose distinct values become the stacked series, default `series`
%   value    (column) numeric column the stacking kinds consume, default `value`
%   binColumn (column) numeric column of the binning and jitter kinds, default `value`
%   pieColumn (column) numeric column of the pie kind, default `val`
%   order    (choice) auto|none|ascending|descending|inside-out|reverse|appearance; `auto` takes
%                     the order the variant is named after, default auto
%   bins     (int)    bin count of the histogram kind, default 8
%   amount   (fp)     jitter amplitude in millimetres, default 3
%   innerRadius (fp)  inner radius of the pie kind, default 0
% The diverging kind does not stack the bound table directly: §75 separates the diverging offset
% from the plain one by the sign of the value, and a table whose values are all positive stacks
% identically under both. Every series after the first is therefore mirrored below the baseline
% into an intermediate table, and that signed table is what the layout runs on.
\tl_new:N \l_semio_viz_scl_variant_tl
\tl_new:N \l_semio_viz_scl_data_tl
\tl_new:N \l_semio_viz_scl_x_tl
\tl_new:N \l_semio_viz_scl_series_tl
\tl_new:N \l_semio_viz_scl_value_tl
\tl_new:N \l_semio_viz_scl_bincol_tl
\tl_new:N \l_semio_viz_scl_piecol_tl
\tl_new:N \l_semio_viz_scl_order_tl
\tl_new:N \l_semio_viz_scl_offset_tl
\int_new:N \l_semio_viz_scl_bins_int
\fp_new:N \l_semio_viz_scl_amount_fp
\fp_new:N \l_semio_viz_scl_inner_fp
\seq_new:N \l_semio_viz_scl_names_seq
\tl_new:N \l_semio_viz_scl_upper_tl
\tl_new:N \l_semio_viz_scl_lower_tl
\fp_new:N \l_semio_viz_scl_xlo_fp
\fp_new:N \l_semio_viz_scl_xhi_fp
\fp_new:N \l_semio_viz_scl_ylo_fp
\fp_new:N \l_semio_viz_scl_yhi_fp
\fp_new:N \l_semio_viz_scl_cx_fp
\fp_new:N \l_semio_viz_scl_cy_fp
\tl_new:N \l_semio_viz_scl_source_tl
\tl_new:N \l_semio_viz_scl_first_tl
\tl_new:N \l_semio_viz_scl_cellx_tl
\tl_new:N \l_semio_viz_scl_cells_tl
\fp_new:N \l_semio_viz_scl_sign_fp

\keys_define:nn { semio / viz / family / layout-algorithm } {
  variant .tl_set:N = \l_semio_viz_scl_variant_tl,
  data .tl_set:N = \l_semio_viz_scl_data_tl,
  x .tl_set:N = \l_semio_viz_scl_x_tl,
  series .tl_set:N = \l_semio_viz_scl_series_tl,
  value .tl_set:N = \l_semio_viz_scl_value_tl,
  binColumn .tl_set:N = \l_semio_viz_scl_bincol_tl,
  pieColumn .tl_set:N = \l_semio_viz_scl_piecol_tl,
  order .tl_set:N = \l_semio_viz_scl_order_tl,
  bins .int_set:N = \l_semio_viz_scl_bins_int,
  amount .fp_set:N = \l_semio_viz_scl_amount_fp,
  innerRadius .fp_set:N = \l_semio_viz_scl_inner_fp,
}

% 🧹 Restores every layout key to its documented default before a kind reads its options.
\cs_new_protected:Npn \semio_viz_scl_keys_reset: {
  \tl_set:Nn \l_semio_viz_scl_variant_tl { stack }
  \tl_clear:N \l_semio_viz_scl_data_tl
  \tl_set:Nn \l_semio_viz_scl_x_tl { t }
  \tl_set:Nn \l_semio_viz_scl_series_tl { series }
  \tl_set:Nn \l_semio_viz_scl_value_tl { value }
  \tl_set:Nn \l_semio_viz_scl_bincol_tl { value }
  \tl_set:Nn \l_semio_viz_scl_piecol_tl { val }
  \tl_set:Nn \l_semio_viz_scl_order_tl { auto }
  \tl_set:Nn \l_semio_viz_scl_offset_tl { none }
  \int_set:Nn \l_semio_viz_scl_bins_int { 8 }
  \fp_set:Nn \l_semio_viz_scl_amount_fp { 3 }
  \fp_set:Nn \l_semio_viz_scl_inner_fp { 0 }
}
%endregion 🔖️Keys-layout-algorithm

%region 🔖️Family-layout-algorithm
% 🥞 The four stacking kinds differ in the offset and the order the algorithm applies, which is
% exactly the distinction taxonomy §75 draws between them.
\cs_new_protected:Npn \semio_viz_scl_offset: {
  \tl_set:Nx \l_semio_viz_scl_offset_tl
    {
      \str_case:VnF \l_semio_viz_scl_variant_tl
        {
          { normalized-stack } { expand }
          { diverging-stack } { diverging }
          { streamgraph-stack } { wiggle }
        }
        { none }
    }
  \str_if_eq:VnT \l_semio_viz_scl_order_tl { auto }
    {
      \tl_set:Nx \l_semio_viz_scl_order_tl
        {
          \str_case:VnF \l_semio_viz_scl_variant_tl
            {
              { diverging-stack } { descending }
              { streamgraph-stack } { inside-out }
            }
            { none }
        }
    }
}

% 📐 A stacked value in figure millimetres.
\cs_new:Npn \semio_viz_scl_y:n #1
  {
    \l_semio_viz_sc_ya_fp
      + ( (#1) - \l_semio_viz_scl_ylo_fp )
        / max ( 1e-9 , \l_semio_viz_scl_yhi_fp - \l_semio_viz_scl_ylo_fp )
        * ( \l_semio_viz_sc_yb_fp - \l_semio_viz_sc_ya_fp - 4 )
  }

% 📐 A laid-out horizontal value in figure millimetres.
\cs_new:Npn \semio_viz_scl_x:n #1
  {
    \l_semio_viz_sc_xa_fp
      + ( (#1) - \l_semio_viz_scl_xlo_fp )
        / max ( 1e-9 , \l_semio_viz_scl_xhi_fp - \l_semio_viz_scl_xlo_fp )
        * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
  }

% 📍 One row of the stacked table, appended to the two boundary lists when it belongs to the
% series being painted.
\cs_new_protected:Npn \semio_viz_scl_band_row:nn #1#2 {
  \semio_viz_table_cell:nnnN { showcase-stack } {#2} { series } \l_semio_viz_sc_cell_tl
  \str_if_eq:VnT \l_semio_viz_sc_cell_tl {#1}
    {
      \semio_viz_table_cell:nnnN { showcase-stack } {#2} { x } \l_semio_viz_sc_cell_tl
      \fp_set:Nn \l_semio_viz_sc_val_fp { \semio_viz_scl_x:n { \l_semio_viz_sc_cell_tl } }
      \semio_viz_table_cell:nnnN { showcase-stack } {#2} { y1 } \l_semio_viz_sc_cell_tl
      \tl_put_right:Nx \l_semio_viz_scl_upper_tl
        {
          \tl_if_empty:NF \l_semio_viz_scl_upper_tl { ; }
          \fp_to_decimal:N \l_semio_viz_sc_val_fp ,
          \fp_to_decimal:n { \semio_viz_scl_y:n { \l_semio_viz_sc_cell_tl } }
        }
      \semio_viz_table_cell:nnnN { showcase-stack } {#2} { y0 } \l_semio_viz_sc_cell_tl
      \tl_put_right:Nx \l_semio_viz_scl_lower_tl
        {
          \tl_if_empty:NF \l_semio_viz_scl_lower_tl { ; }
          \fp_to_decimal:N \l_semio_viz_sc_val_fp ,
          \fp_to_decimal:n { \semio_viz_scl_y:n { \l_semio_viz_sc_cell_tl } }
        }
    }
}

% 🎗️ One stacked series as the band between its two boundaries, both in figure millimetres.
\cs_new_protected:Npn \semio_viz_scl_band:n #1 {
  \tl_clear:N \l_semio_viz_scl_upper_tl
  \tl_clear:N \l_semio_viz_scl_lower_tl
  \semio_viz_table_nrows:nN { showcase-stack } \l_semio_viz_sc_rows_int
  \int_step_inline:nn { \l_semio_viz_sc_rows_int } { \semio_viz_scl_band_row:nn {#1} {##1} }
  \semio_viz_sc_hue:n { \l_semio_viz_sc_slots_int - 1 }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      points = { \exp_not:V \l_semio_viz_scl_upper_tl } ,
      points2 = { \exp_not:V \l_semio_viz_scl_lower_tl } ,
      fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none , opacity = 0.8
    }
  \semio_viz_sc_path:n { band }
}

% ➖ The signed source the diverging offset needs: every series after the first is mirrored below
% the baseline, so the two halves of the stack really are two halves and not one.
\cs_new_protected:Npn \semio_viz_scl_signed: {
  \semio_viz_table_col_values:VVN \l_semio_viz_scl_data_tl \l_semio_viz_scl_series_tl
    \l_semio_viz_scl_names_seq
  \seq_remove_duplicates:N \l_semio_viz_scl_names_seq
  \tl_set:Nx \l_semio_viz_scl_first_tl { \seq_item:Nn \l_semio_viz_scl_names_seq { 1 } }
  \use:x {
    \exp_not:N \semio_viz_table_new:nn { showcase-signed }
      {
        \exp_not:V \l_semio_viz_scl_x_tl , \exp_not:V \l_semio_viz_scl_series_tl ,
        \exp_not:V \l_semio_viz_scl_value_tl
      }
  }
  \semio_viz_table_nrows:VN \l_semio_viz_scl_data_tl \l_semio_viz_sc_rows_int
  \int_step_inline:nn { \l_semio_viz_sc_rows_int }
    {
      \semio_viz_table_cell:VnVN \l_semio_viz_scl_data_tl {##1} \l_semio_viz_scl_x_tl
        \l_semio_viz_scl_cellx_tl
      \semio_viz_table_cell:VnVN \l_semio_viz_scl_data_tl {##1} \l_semio_viz_scl_series_tl
        \l_semio_viz_scl_cells_tl
      \semio_viz_table_cell:VnVN \l_semio_viz_scl_data_tl {##1} \l_semio_viz_scl_value_tl
        \l_semio_viz_sc_cell_tl
      \fp_set:Nn \l_semio_viz_scl_sign_fp
        {
          \str_if_eq:VVTF \l_semio_viz_scl_cells_tl \l_semio_viz_scl_first_tl { 1 } { -1 }
        }
      \use:x {
        \exp_not:N \semio_viz_table_row:nn { showcase-signed }
          {
            \exp_not:V \l_semio_viz_scl_cellx_tl ,
            \exp_not:V \l_semio_viz_scl_cells_tl ,
            \fp_to_decimal:n { \l_semio_viz_sc_cell_tl * \l_semio_viz_scl_sign_fp }
          }
      }
    }
}

% 🥞 Runs the stack layout and paints one band per series between its own y0 and y1.
\cs_new_protected:Npn \semio_viz_scl_stack: {
  \semio_viz_scl_offset:
  \tl_set_eq:NN \l_semio_viz_scl_source_tl \l_semio_viz_scl_data_tl
  \str_if_eq:VnT \l_semio_viz_scl_variant_tl { diverging-stack }
    {
      \semio_viz_scl_signed:
      \tl_set:Nn \l_semio_viz_scl_source_tl { showcase-signed }
    }
  \use:x {
    \exp_not:N \semio_viz_layout_run:nnnn { stack }
      { \exp_not:V \l_semio_viz_scl_source_tl } { showcase-stack }
      {
        stack = \l_semio_viz_scl_x_tl : \l_semio_viz_scl_series_tl : \l_semio_viz_scl_value_tl ,
        order = \l_semio_viz_scl_order_tl , offset = \l_semio_viz_scl_offset_tl
      }
  }
  \semio_viz_table_col_min:nnN { showcase-stack } { x } \l_semio_viz_scl_xlo_fp
  \semio_viz_table_col_max:nnN { showcase-stack } { x } \l_semio_viz_scl_xhi_fp
  \semio_viz_table_col_min:nnN { showcase-stack } { y0 } \l_semio_viz_scl_ylo_fp
  \semio_viz_table_col_max:nnN { showcase-stack } { y1 } \l_semio_viz_scl_yhi_fp
  \semio_viz_table_col_values:nnN { showcase-stack } { series } \l_semio_viz_sc_values_seq
  \seq_clear:N \l_semio_viz_scl_names_seq
  \seq_map_inline:Nn \l_semio_viz_sc_values_seq
    {
      \seq_if_in:NnF \l_semio_viz_scl_names_seq {##1}
        { \seq_put_right:Nn \l_semio_viz_scl_names_seq {##1} }
    }
  \int_zero:N \l_semio_viz_sc_slots_int
  \seq_map_inline:Nn \l_semio_viz_scl_names_seq
    {
      \int_incr:N \l_semio_viz_sc_slots_int
      \semio_viz_scl_band:n {##1}
    }
}

% 🧱 One histogram bin as a rectangle between its own two edges.
\cs_new_protected:Npn \semio_viz_scl_bin_row:n #1 {
  \semio_viz_table_cell:nnnN { showcase-bin } {#1} { x0 } \l_semio_viz_sc_cell_tl
  \fp_set:Nn \l_semio_viz_sc_lo_fp { \semio_viz_scl_x:n { \l_semio_viz_sc_cell_tl } }
  \semio_viz_table_cell:nnnN { showcase-bin } {#1} { x1 } \l_semio_viz_sc_cell_tl
  \fp_set:Nn \l_semio_viz_sc_hi_fp { \semio_viz_scl_x:n { \l_semio_viz_sc_cell_tl } }
  \semio_viz_table_cell:nnnN { showcase-bin } {#1} { count } \l_semio_viz_sc_cell_tl
  \fp_set:Nn \l_semio_viz_sc_val_fp
    {
      \l_semio_viz_sc_cell_tl / max ( 1e-9 , \l_semio_viz_scl_yhi_fp )
        * ( \l_semio_viz_sc_yb_fp - \l_semio_viz_sc_ya_fp - 4 )
    }
  \semio_viz_sc_hue:n { #1 - 1 }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    { fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none }
  \semio_viz_sc_rect:nnnn
    { ( \l_semio_viz_sc_lo_fp + \l_semio_viz_sc_hi_fp ) / 2 }
    { \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_val_fp / 2 }
    { max ( 0.4 , \l_semio_viz_sc_hi_fp - \l_semio_viz_sc_lo_fp - 0.4 ) }
    { max ( 0.2 , \l_semio_viz_sc_val_fp ) }
}

% 📊 Runs the bin layout and paints one rectangle per bin, standing on the frame's baseline.
\cs_new_protected:Npn \semio_viz_scl_bin: {
  \use:x {
    \exp_not:N \semio_viz_layout_run:nnnn { bin }
      { \exp_not:V \l_semio_viz_scl_data_tl } { showcase-bin }
      {
        bin = \l_semio_viz_scl_bincol_tl ,
        thresholds = count: \int_use:N \l_semio_viz_scl_bins_int
      }
  }
  \semio_viz_table_col_min:nnN { showcase-bin } { x0 } \l_semio_viz_scl_xlo_fp
  \semio_viz_table_col_max:nnN { showcase-bin } { x1 } \l_semio_viz_scl_xhi_fp
  \semio_viz_table_col_max:nnN { showcase-bin } { count } \l_semio_viz_scl_yhi_fp
  \semio_viz_table_nrows:nN { showcase-bin } \l_semio_viz_sc_rows_int
  \int_step_inline:nn { \l_semio_viz_sc_rows_int } { \semio_viz_scl_bin_row:n {##1} }
}

% ⚫ Draws every point of a laid-out point set as a dot, reading the store the layout wrote.
\cs_new_protected:Npn \semio_viz_scl_points_draw:n #1 {
  \seq_set_eq:Nc \l_semio_viz_sc_values_seq { g_semio_viz_points_ \tl_to_str:n {#1} _seq }
  \int_set:Nn \l_semio_viz_sc_rows_int { \seq_count:N \l_semio_viz_sc_values_seq }
  \int_step_inline:nn { \l_semio_viz_sc_rows_int }
    {
      \clist_set:Nx \l_semio_viz_sc_pair_clist
        { \seq_item:Nn \l_semio_viz_sc_values_seq {##1} }
      \semio_viz_sc_hue:n { ##1 - 1 }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        { fill = \exp_not:V \l_semio_viz_sc_hue_tl , size = 3 }
      \semio_viz_sc_mark:nnn { dot }
        { \clist_item:Nn \l_semio_viz_sc_pair_clist { 1 } }
        { \clist_item:Nn \l_semio_viz_sc_pair_clist { 2 } }
    }
}

% 🫧 Runs the jitter layout over a point set built from the bound column, then draws what came
% back: the algorithm decides where the points land, not the renderer.
\cs_new_protected:Npn \semio_viz_scl_jitter: {
  \semio_viz_table_col_values:VVN \l_semio_viz_scl_data_tl \l_semio_viz_scl_bincol_tl
    \l_semio_viz_sc_values_seq
  \semio_viz_table_col_min:VVN \l_semio_viz_scl_data_tl \l_semio_viz_scl_bincol_tl
    \l_semio_viz_scl_xlo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_scl_data_tl \l_semio_viz_scl_bincol_tl
    \l_semio_viz_scl_xhi_fp
  \tl_clear:N \l_semio_viz_scl_upper_tl
  \int_set:Nn \l_semio_viz_sc_rows_int { \seq_count:N \l_semio_viz_sc_values_seq }
  \int_step_inline:nn { \l_semio_viz_sc_rows_int }
    {
      \tl_put_right:Nx \l_semio_viz_scl_upper_tl
        {
          \tl_if_empty:NF \l_semio_viz_scl_upper_tl { ; }
          \fp_to_decimal:n
            { \semio_viz_scl_x:n { \seq_item:Nn \l_semio_viz_sc_values_seq {##1} } } ,
          \fp_to_decimal:n { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp ) / 2 }
        }
    }
  \use:x {
    \exp_not:N \semio_viz_points_new:nn { showcase-points }
      { \exp_not:V \l_semio_viz_scl_upper_tl }
    \exp_not:N \semio_viz_layout_run:nnnn { jitter } { showcase-points } { showcase-jitter }
      { amount = \fp_to_decimal:N \l_semio_viz_scl_amount_fp }
  }
  \semio_viz_scl_points_draw:n { showcase-jitter }
}

% 🥧 Runs the pie layout over the bound column and paints the sectors it computed.
\cs_new_protected:Npn \semio_viz_scl_pie: {
  \semio_viz_table_col_values:VVN \l_semio_viz_scl_data_tl \l_semio_viz_scl_piecol_tl
    \l_semio_viz_sc_values_seq
  \fp_set:Nn \l_semio_viz_scl_cx_fp { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_scl_cy_fp { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp ) / 2 }
  \use:x
    { \exp_not:N \SemioVizPie
        [ value = { \seq_use:Nn \l_semio_viz_sc_values_seq { , } } , sort = none ] }
  \int_step_inline:nn { \SemioVizPieCount }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \use:x {
        \exp_not:N \SemioVizArc
          [
            at = { \fp_to_decimal:N \l_semio_viz_scl_cx_fp ,
                   \fp_to_decimal:N \l_semio_viz_scl_cy_fp } ,
            innerRadius = \fp_to_decimal:N \l_semio_viz_scl_inner_fp ,
            outerRadius = \fp_to_decimal:n
              {
                min ( \l_semio_viz_sc_xb_fp - \l_semio_viz_scl_cx_fp ,
                      \l_semio_viz_sc_yb_fp - \l_semio_viz_scl_cy_fp )
              } ,
            startAngle = \SemioVizPieStart {##1} ,
            endAngle = \SemioVizPieEnd {##1} ,
            fill = \exp_not:V \l_semio_viz_sc_hue_tl
          ]
      }
    }
}

% 🗃️ The table this kind reads when the caller named none: each §75 algorithm needs a shape of
% data its neighbours do not, so the fallback belongs to the variant and not to the family.
\cs_new_protected:Npn \semio_viz_scl_table: {
  \tl_if_empty:NT \l_semio_viz_scl_data_tl
    {
      \tl_set:Nx \l_semio_viz_scl_data_tl
        {
          \str_case:VnF \l_semio_viz_scl_variant_tl
            {
              { histogram-binning } { demo-distribution }
              { jitter-layout } { demo-distribution }
              { pie-layout } { demo }
            }
            { demo-series }
        }
    }
}

% 📐 One §75 layout algorithm, rendered as a catalogue kind.
\cs_new_protected:Npn \semio_viz_scl_render:n #1 {
  \semio_viz_sc_frame:
  \semio_viz_scl_keys_reset:
  \keys_set:nn { semio / viz / family / layout-algorithm } {#1}
  \semio_viz_scl_table:
  \str_case:VnF \l_semio_viz_scl_variant_tl
    {
      { histogram-binning } { \semio_viz_scl_bin: }
      { jitter-layout } { \semio_viz_scl_jitter: }
      { pie-layout } { \semio_viz_scl_pie: }
    }
    { \semio_viz_scl_stack: }
  \semio_viz_sc_caption:nn
    { Layout~algorithm~\l_semio_viz_scl_variant_tl }
    { Layoutverfahren~\l_semio_viz_scl_variant_tl }
}

% 🧭 §75: one layout algorithm per kind, run through the layout registry on its own structure.
\SemioVizFamily{layout-algorithm}{ \semio_viz_scl_render:n {#1} }
%endregion 🔖️Family-layout-algorithm

%region 🔖️Keys-transform-data
% 🔑 semio / viz / family / transform-data — the nine §78 data transforms as catalogue kinds.
% Each kind runs its own operation through the transform kernel and draws the source table beside
% the derived one, so the reader sees what the operation did rather than a picture of it.
%   variant  (choice) filter|sort|group|rollup|nest|pivot|fold|join|window, default filter
%   data     (table)  source table, default `demo`
%   group    (column) grouping column of the grouping kinds, default `grp`
%   value    (column) numeric column the operations reduce, default `val`
%   key      (column) key column of the pivot, fold and join kinds, default `cat`
%   second   (column) second folded column, default `val2`
%   predicate (text)  filter predicate over bare column names, default `val > 4`
%   sortBy   (column) column the sort kind orders by, default `val`
%   descending (bool) reverse the sort order, default true
%   windowSize (int)  window length of the moving average, default 3
%   windowKind (choice) movingAverage|cumulativeSum|rank|lag, the window the kind computes and the
%                     name of the column it appends, default movingAverage
% The join kind joins on the grouping column and not on the key column: a table joined to itself
% on its own key is the identity, which would draw the source twice and say nothing.
% The window kind reads its result through the column the window kernel appends, for the same
% reason — the source's own first numeric column survives the operation untouched.
\tl_new:N \l_semio_viz_sct_variant_tl
\tl_new:N \l_semio_viz_sct_data_tl
\tl_new:N \l_semio_viz_sct_group_tl
\tl_new:N \l_semio_viz_sct_value_tl
\tl_new:N \l_semio_viz_sct_key_tl
\tl_new:N \l_semio_viz_sct_second_tl
\tl_new:N \l_semio_viz_sct_predicate_tl
\tl_new:N \l_semio_viz_sct_sortby_tl
\bool_new:N \l_semio_viz_sct_descending_bool
\int_new:N \l_semio_viz_sct_window_int
\tl_new:N \l_semio_viz_sct_windowkind_tl
\tl_new:N \l_semio_viz_sct_spec_tl
\tl_new:N \l_semio_viz_sct_result_tl

\keys_define:nn { semio / viz / family / transform-data } {
  variant .tl_set:N = \l_semio_viz_sct_variant_tl,
  data .tl_set:N = \l_semio_viz_sct_data_tl,
  group .tl_set:N = \l_semio_viz_sct_group_tl,
  value .tl_set:N = \l_semio_viz_sct_value_tl,
  key .tl_set:N = \l_semio_viz_sct_key_tl,
  second .tl_set:N = \l_semio_viz_sct_second_tl,
  predicate .tl_set:N = \l_semio_viz_sct_predicate_tl,
  sortBy .tl_set:N = \l_semio_viz_sct_sortby_tl,
  descending .bool_set:N = \l_semio_viz_sct_descending_bool,
  windowSize .int_set:N = \l_semio_viz_sct_window_int,
  windowKind .tl_set:N = \l_semio_viz_sct_windowkind_tl,
}

% 🧹 Restores every data-transform key to its documented default before a kind reads its options.
\cs_new_protected:Npn \semio_viz_sct_keys_reset: {
  \tl_set:Nn \l_semio_viz_sct_variant_tl { filter }
  \tl_set:Nn \l_semio_viz_sct_data_tl { demo }
  \tl_set:Nn \l_semio_viz_sct_group_tl { grp }
  \tl_set:Nn \l_semio_viz_sct_value_tl { val }
  \tl_set:Nn \l_semio_viz_sct_key_tl { cat }
  \tl_set:Nn \l_semio_viz_sct_second_tl { val2 }
  \tl_set:Nn \l_semio_viz_sct_predicate_tl { val > 4 }
  \tl_set:Nn \l_semio_viz_sct_sortby_tl { val }
  \bool_set_true:N \l_semio_viz_sct_descending_bool
  \int_set:Nn \l_semio_viz_sct_window_int { 3 }
  \tl_set:Nn \l_semio_viz_sct_windowkind_tl { movingAverage }
  \tl_clear:N \l_semio_viz_sct_result_tl
}
%endregion 🔖️Keys-transform-data

%region 🔖️Family-transform-data
% 🚚 The transform operation each §78 slug names, as an option list for the transform kernel.
\cs_new_protected:Npn \semio_viz_sct_spec: {
  \tl_set:Nx \l_semio_viz_sct_spec_tl
    {
      \str_case:VnF \l_semio_viz_sct_variant_tl
        {
          { sort }
            {
              sort = \l_semio_viz_sct_sortby_tl ,
              descending = \bool_if:NTF \l_semio_viz_sct_descending_bool { true } { false }
            }
          { group }
            { group = \l_semio_viz_sct_group_tl , rollup = count: \l_semio_viz_sct_value_tl }
          { rollup }
            { group = \l_semio_viz_sct_group_tl , rollup = sum: \l_semio_viz_sct_value_tl }
          { nest }
            { group = \l_semio_viz_sct_group_tl , rollup = median: \l_semio_viz_sct_value_tl }
          { pivot }
            {
              group = \l_semio_viz_sct_group_tl ,
              pivot = \l_semio_viz_sct_key_tl : \l_semio_viz_sct_value_tl
            }
          { fold }
            {
              fold = \l_semio_viz_sct_key_tl :
                \l_semio_viz_sct_value_tl ; \l_semio_viz_sct_second_tl
            }
          { join }
            {
              join = \l_semio_viz_sct_data_tl : \l_semio_viz_sct_group_tl
                : \l_semio_viz_sct_group_tl
            }
          { window }
            {
              window = \l_semio_viz_sct_windowkind_tl : \l_semio_viz_sct_value_tl
                : \int_use:N \l_semio_viz_sct_window_int
            }
        }
        { filter = \l_semio_viz_sct_predicate_tl }
    }
}

% 📐 One §78 data transform, rendered as a before/after catalogue kind.
\cs_new_protected:Npn \semio_viz_sct_render:n #1 {
  \semio_viz_sc_frame:
  \semio_viz_sct_keys_reset:
  \keys_set:nn { semio / viz / family / transform-data } {#1}
  \semio_viz_sct_spec:
  \str_if_eq:VnT \l_semio_viz_sct_variant_tl { window }
    { \tl_set_eq:NN \l_semio_viz_sct_result_tl \l_semio_viz_sct_windowkind_tl }
  \use:x {
    \exp_not:N \semio_viz_transform:nnn { showcase-transform }
      { \exp_not:V \l_semio_viz_sct_data_tl } { \exp_not:V \l_semio_viz_sct_spec_tl }
  }
  \use:x {
    \exp_not:N \semio_viz_sc_before_after:nnnnn { \exp_not:V \l_semio_viz_sct_data_tl }
      { showcase-transform }
      { \exp_not:N \semio_viz_sct_caption_en: }
      { \exp_not:N \semio_viz_sct_caption_de: }
      { \exp_not:V \l_semio_viz_sct_result_tl }
  }
}

% 🗣️ The English caption of a §78 data transform kind.
\cs_new:Npn \semio_viz_sct_caption_en:
  { Transform~\l_semio_viz_sct_variant_tl :~source~and~result }
% 🗣️ The German caption of a §78 data transform kind.
\cs_new:Npn \semio_viz_sct_caption_de:
  { Transformation~\l_semio_viz_sct_variant_tl :~Quelle~und~Ergebnis }

% 🚚 §75: one data transform per kind, as the source table beside the table it derives.
\SemioVizFamily{transform-data}{ \semio_viz_sct_render:n {#1} }
%endregion 🔖️Family-transform-data

%region 🔖️Keys-transform-statistical
% 🔑 semio / viz / family / transform-statistical — the six §78 statistical transforms as
% catalogue kinds, each drawn as the source distribution beside what the operation derived.
%   variant   (choice) bin|aggregate|normalize|kde|quantile-transform|regression, default bin
%   data      (table)  source table of the distribution kinds, default `demo-distribution`
%   fitData   (table)  source table of the regression kind, default `demo`
%   value     (column) numeric column the distribution operations consume, default `value`
%   group     (column) grouping column of the aggregate kind, default `grp`
%   x         (column) predictor column of the regression kind, default `t`
%   y         (column) response column of the regression kind, default `val`
%   fit       (choice) regression kind linear|poly|exp|log|pow, default linear
%   probabilities (clist) probabilities of the quantile kind, default `0,0.25,0.5,0.75,1`
%   bins      (int)    bin count of the bin kind, default 8
%   samples   (int)    sample count of the density grid, default 24
%   bandwidth (fp)     kernel bandwidth; 0 selects Silverman's rule, default 0
\tl_new:N \l_semio_viz_scq_variant_tl
\tl_new:N \l_semio_viz_scq_data_tl
\tl_new:N \l_semio_viz_scq_fitdata_tl
\tl_new:N \l_semio_viz_scq_value_tl
\tl_new:N \l_semio_viz_scq_group_tl
\tl_new:N \l_semio_viz_scq_x_tl
\tl_new:N \l_semio_viz_scq_y_tl
