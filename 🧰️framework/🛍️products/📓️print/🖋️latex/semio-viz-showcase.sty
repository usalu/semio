%region 🔖️Keys-encoding
% 🔑 semio / viz / family / encoding — the thirty-two §74 encoding channels as catalogue kinds.
% Every kind draws the same samples of the same column inside the same frame; the only thing that
% differs between two kinds is which visual channel the value is spent on, which is precisely what
% §74 enumerates.
%   variant   (choice) one §74 channel slug, default cartesian-x-y
%   data      (table)  table the samples are read from, default `demo`
%   column    (column) numeric column the channel carries, default `val`
%   column2   (column) second numeric column of the two-dimensional channels, default `val2`
%   text      (column) column supplying the typographic samples, default `cat`
%   samples   (int)    samples drawn, default 0, which means every row of the table
%   low       (fp)     magnitude of the smallest sample in millimetres, default 1.6
%   high      (fp)     magnitude of the largest sample in millimetres, default 7
%   span      (fp)     angular span of the rotational channels in degrees, default 120
%   swatch    (fp)     edge length of a sample that stays constant, in millimetres, default 7
%   strands   (int)    strands a hatched, ramped or repeated sample is built from, default 4
%   symbols   (clist)  mark kinds the symbol channel cycles, default dot,square,triangle,diamond,cross
%   dashes    (clist)  dash patterns the dash channel cycles, default none,dashed,dotted,dash-dot
%   patterns  (clist)  fills the pattern channel cycles, default hatch,crosshatch,dots,grid
%   arrows    (clist)  arrow ends the arrowheads channel cycles, default none,end,start,both
%   fonts     (clist)  size switch names the font-size channel cycles, default scriptsize..large
%   weights   (clist)  series switch names the font-weight channel cycles, default mdseries,bfseries
\tl_new:N \l_semio_viz_sce_variant_tl
\tl_new:N \l_semio_viz_sce_data_tl
\tl_new:N \l_semio_viz_sce_column_tl
\tl_new:N \l_semio_viz_sce_column_two_tl
\tl_new:N \l_semio_viz_sce_text_tl
\int_new:N \l_semio_viz_sce_samples_int
\fp_new:N \l_semio_viz_sce_low_fp
\fp_new:N \l_semio_viz_sce_high_fp
\fp_new:N \l_semio_viz_sce_span_fp
\fp_new:N \l_semio_viz_sce_swatch_fp
\int_new:N \l_semio_viz_sce_strands_int
\clist_new:N \l_semio_viz_sce_symbols_clist
\clist_new:N \l_semio_viz_sce_dashes_clist
\clist_new:N \l_semio_viz_sce_patterns_clist
\clist_new:N \l_semio_viz_sce_arrows_clist
\clist_new:N \l_semio_viz_sce_fonts_clist
\clist_new:N \l_semio_viz_sce_weights_clist
\int_new:N \l_semio_viz_sce_n_int
\int_new:N \l_semio_viz_sce_i_int
\int_new:N \l_semio_viz_sce_k_int
\fp_new:N \l_semio_viz_sce_t_fp
\fp_new:N \l_semio_viz_sce_x_fp
\fp_new:N \l_semio_viz_sce_ry_fp
\fp_new:N \l_semio_viz_sce_cy_fp
\fp_new:N \l_semio_viz_sce_cx_fp
\fp_new:N \l_semio_viz_sce_mag_fp
\fp_new:N \l_semio_viz_sce_lo_fp
\fp_new:N \l_semio_viz_sce_hi_fp
\fp_new:N \l_semio_viz_sce_lo_two_fp
\fp_new:N \l_semio_viz_sce_hi_two_fp
\fp_new:N \l_semio_viz_sce_step_fp
\fp_new:N \l_semio_viz_sce_rows_fp
\fp_new:N \l_semio_viz_sce_px_fp
\fp_new:N \l_semio_viz_sce_py_fp
\tl_new:N \l_semio_viz_sce_pick_tl
\tl_new:N \l_semio_viz_sce_cell_tl
\tl_new:N \l_semio_viz_sce_points_tl

\keys_define:nn { semio / viz / family / encoding } {
  variant .tl_set:N = \l_semio_viz_sce_variant_tl,
  data .tl_set:N = \l_semio_viz_sce_data_tl,
  column .tl_set:N = \l_semio_viz_sce_column_tl,
  column2 .tl_set:N = \l_semio_viz_sce_column_two_tl,
  text .tl_set:N = \l_semio_viz_sce_text_tl,
  samples .int_set:N = \l_semio_viz_sce_samples_int,
  low .fp_set:N = \l_semio_viz_sce_low_fp,
  high .fp_set:N = \l_semio_viz_sce_high_fp,
  span .fp_set:N = \l_semio_viz_sce_span_fp,
  swatch .fp_set:N = \l_semio_viz_sce_swatch_fp,
  strands .int_set:N = \l_semio_viz_sce_strands_int,
  symbols .clist_set:N = \l_semio_viz_sce_symbols_clist,
  dashes .clist_set:N = \l_semio_viz_sce_dashes_clist,
  patterns .clist_set:N = \l_semio_viz_sce_patterns_clist,
  arrows .clist_set:N = \l_semio_viz_sce_arrows_clist,
  fonts .clist_set:N = \l_semio_viz_sce_fonts_clist,
  weights .clist_set:N = \l_semio_viz_sce_weights_clist,
}

% 🧹 Restores every encoding key to its documented default before a kind reads its options.
\cs_new_protected:Npn \semio_viz_sce_keys_reset: {
  \tl_set:Nn \l_semio_viz_sce_variant_tl { cartesian-x-y }
  \tl_set:Nn \l_semio_viz_sce_data_tl { demo }
  \tl_set:Nn \l_semio_viz_sce_column_tl { val }
  \tl_set:Nn \l_semio_viz_sce_column_two_tl { val2 }
  \tl_set:Nn \l_semio_viz_sce_text_tl { cat }
  \int_zero:N \l_semio_viz_sce_samples_int
  \fp_set:Nn \l_semio_viz_sce_low_fp { 1.6 }
  \fp_set:Nn \l_semio_viz_sce_high_fp { 7 }
  \fp_set:Nn \l_semio_viz_sce_span_fp { 120 }
  \fp_set:Nn \l_semio_viz_sce_swatch_fp { 7 }
  \int_set:Nn \l_semio_viz_sce_strands_int { 4 }
  \clist_set:Nn \l_semio_viz_sce_symbols_clist { dot , square , triangle , diamond , cross }
  \clist_set:Nn \l_semio_viz_sce_dashes_clist { none , dashed , dotted , dash-dot }
  \clist_set:Nn \l_semio_viz_sce_patterns_clist { hatch , crosshatch , dots , grid }
  \clist_set:Nn \l_semio_viz_sce_arrows_clist { none , end , start , both }
  \clist_set:Nn \l_semio_viz_sce_fonts_clist
    { scriptsize , footnotesize , small , normalsize , large }
  \clist_set:Nn \l_semio_viz_sce_weights_clist { mdseries , bfseries }
}
%endregion 🔖️Keys-encoding

%region 🔖️Family-encoding
\cs_generate_variant:Nn \semio_viz_sc_text:nnnn { Vnnn }

% 🔢 Reads the bound column, fixes how many samples the strip carries and where they sit.
\cs_new_protected:Npn \semio_viz_sce_load: {
  \semio_viz_table_col_values:VVN \l_semio_viz_sce_data_tl \l_semio_viz_sce_column_tl
    \l_semio_viz_sc_values_seq
  \int_set:Nn \l_semio_viz_sce_n_int
    {
      \int_compare:nNnTF { \l_semio_viz_sce_samples_int } > { 0 }
        {
          \int_min:nn { \l_semio_viz_sce_samples_int }
            { \seq_count:N \l_semio_viz_sc_values_seq }
        }
        { \seq_count:N \l_semio_viz_sc_values_seq }
    }
  \semio_viz_table_col_min:VVN \l_semio_viz_sce_data_tl \l_semio_viz_sce_column_tl
    \l_semio_viz_sce_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_sce_data_tl \l_semio_viz_sce_column_tl
    \l_semio_viz_sce_hi_fp
  \fp_set:Nn \l_semio_viz_sce_step_fp
    { ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / max ( 1 , \l_semio_viz_sce_n_int ) }
  \fp_set:Nn \l_semio_viz_sce_rows_fp
    {
      ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
        / max ( 1 , \l_semio_viz_sce_n_int )
    }
  \fp_set:Nn \l_semio_viz_sce_cy_fp
    { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp ) / 2 - 2 }
  \fp_set:Nn \l_semio_viz_sce_cx_fp
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 }
  \semio_viz_sce_load_two:
}

% 🔢 The second bound column's own extent, for the channels that read two numbers per row.
\cs_new_protected:Npn \semio_viz_sce_load_two: {
  \semio_viz_table_col_min:VVN \l_semio_viz_sce_data_tl \l_semio_viz_sce_column_two_tl
    \l_semio_viz_sce_lo_two_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_sce_data_tl \l_semio_viz_sce_column_two_tl
    \l_semio_viz_sce_hi_two_fp
}

% 🔢 Sample #1 of the strip: its normalized value, its slot, its row and its magnitude.
\cs_new_protected:Npn \semio_viz_sce_sample:n #1 {
  \int_set:Nn \l_semio_viz_sce_i_int {#1}
  \fp_set:Nn \l_semio_viz_sce_t_fp
    {
      ( \seq_item:Nn \l_semio_viz_sc_values_seq { \l_semio_viz_sce_i_int }
          - \l_semio_viz_sce_lo_fp )
        / max ( 1e-9 , \l_semio_viz_sce_hi_fp - \l_semio_viz_sce_lo_fp )
    }
  \fp_set:Nn \l_semio_viz_sce_x_fp
    {
      \l_semio_viz_sc_xa_fp
        + ( \l_semio_viz_sce_i_int - 0.5 ) * \l_semio_viz_sce_step_fp
    }
  \fp_set:Nn \l_semio_viz_sce_ry_fp
    {
      \l_semio_viz_sc_ya_fp
        + ( \l_semio_viz_sce_i_int - 0.5 ) * \l_semio_viz_sce_rows_fp
    }
  \fp_set:Nn \l_semio_viz_sce_mag_fp
    {
      \l_semio_viz_sce_low_fp
        + \l_semio_viz_sce_t_fp * ( \l_semio_viz_sce_high_fp - \l_semio_viz_sce_low_fp )
    }
  \semio_viz_sc_hue:n { \l_semio_viz_sce_i_int - 1 }
}

% ▶️ Runs the channel painter #1 once per sample of the strip.
\cs_new_protected:Npn \semio_viz_sce_strip:N #1 {
  \int_step_inline:nn { \l_semio_viz_sce_n_int }
    { \semio_viz_sce_sample:n {##1} #1 }
}

% 🔁 The entry of the cycled list #1 belonging to the current sample, into #2.
\cs_new_protected:Npn \semio_viz_sce_cycle:NN #1#2 {
  \tl_set:Nx #2
    {
      \clist_item:Nn #1
        { \int_mod:nn { \l_semio_viz_sce_i_int - 1 } { \clist_count:N #1 } + 1 }
    }
}

% 🔤 The typographic sample of the current row, from the bound text column.
\cs_new_protected:Npn \semio_viz_sce_word: {
  \semio_viz_table_cell:VnVN \l_semio_viz_sce_data_tl { \l_semio_viz_sce_i_int }
    \l_semio_viz_sce_text_tl \l_semio_viz_sce_cell_tl
}

% 🧭 Row #1 of the two bound numeric columns, mapped onto the frame.
\cs_new_protected:Npn \semio_viz_sce_pair:n #1 {
  \semio_viz_table_cell:VnVN \l_semio_viz_sce_data_tl {#1} \l_semio_viz_sce_column_tl
    \l_semio_viz_sce_cell_tl
  \fp_set:Nn \l_semio_viz_sce_px_fp
    {
      ( \l_semio_viz_sce_cell_tl - \l_semio_viz_sce_lo_fp )
        / max ( 1e-9 , \l_semio_viz_sce_hi_fp - \l_semio_viz_sce_lo_fp )
    }
  \semio_viz_table_cell:VnVN \l_semio_viz_sce_data_tl {#1} \l_semio_viz_sce_column_two_tl
    \l_semio_viz_sce_cell_tl
  \fp_set:Nn \l_semio_viz_sce_py_fp
    {
      ( \l_semio_viz_sce_cell_tl - \l_semio_viz_sce_lo_two_fp )
        / max ( 1e-9 , \l_semio_viz_sce_hi_two_fp - \l_semio_viz_sce_lo_two_fp )
    }
}

% 🔄 The #4 corners of a regular polygon of radius #3 around (#1,#2), turned by #5 degrees, as a
% point list. The turn is spent on the corner coordinates themselves rather than on the mark
% kernel's `rotate` key, so the record the probe reads is the turned geometry and not a transform.
\cs_new_protected:Npn \semio_viz_sce_rotor:nnnnn #1#2#3#4#5 {
  \tl_clear:N \l_semio_viz_sce_points_tl
  \int_step_inline:nn {#4}
    {
      \tl_put_right:Nx \l_semio_viz_sce_points_tl
        {
          \tl_if_empty:NF \l_semio_viz_sce_points_tl { ; }
          \fp_to_decimal:n { (#1) + (#3) * cosd ( (#5) + 360 * ( ##1 - 1 ) / (#4) ) } ,
          \fp_to_decimal:n { (#2) + (#3) * sind ( (#5) + 360 * ( ##1 - 1 ) / (#4) ) }
        }
    }
}

% 🎨 The paint every constant sample of the strip carries.
\cs_new_protected:Npn \semio_viz_sce_solid:n #1 {
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    { fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none , #1 }
}

% 🖊️ The stroke-only paint, for the samples that spend their ink on an outline.
\cs_new_protected:Npn \semio_viz_sce_outline:n #1 {
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    { fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl , #1 }
}

% 🥧 Angle: one sector per sample, its opening carrying the value.
\cs_new_protected:Npn \semio_viz_sce_angle: {
  \semio_viz_sce_solid:n
    {
      innerRadius = 0 ,
      outerRadius = \fp_to_decimal:n { \l_semio_viz_sce_swatch_fp / 2 } ,
      startAngle = 0 ,
      endAngle = \fp_to_decimal:n
        { max ( 0.15 , \l_semio_viz_sce_t_fp ) * \l_semio_viz_sce_span_fp * pi / 180 }
    }
  \semio_viz_sc_mark:nnn { sector } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% ◼️ Area: a square whose area, not its edge, is proportional to the value.
\cs_new_protected:Npn \semio_viz_sce_area: {
  \semio_viz_sce_solid:n
    { size = \fp_to_decimal:n { \l_semio_viz_sce_mag_fp * \l_semio_viz_sce_mag_fp } }
  \semio_viz_sc_mark:nnn { square } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% ⭕ Radius: a circle whose radius carries the value.
\cs_new_protected:Npn \semio_viz_sce_radius: {
  \semio_viz_sce_solid:n
    { radius = \fp_to_decimal:n { \l_semio_viz_sce_mag_fp / 2 } }
  \semio_viz_sc_mark:nnn { circle } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% ▯ Height: a column of constant width standing on the baseline.
\cs_new_protected:Npn \semio_viz_sce_height: {
  \semio_viz_sce_solid:n { }
  \semio_viz_sc_rect:nnnn { \l_semio_viz_sce_x_fp }
    { \l_semio_viz_sc_ya_fp + \l_semio_viz_sce_mag_fp / 2 }
    { \l_semio_viz_sce_swatch_fp / 2 } { \l_semio_viz_sce_mag_fp }
}

% ▭ Width: a bar of constant height growing to the right of the slot.
\cs_new_protected:Npn \semio_viz_sce_width: {
  \semio_viz_sce_solid:n { }
  \semio_viz_sc_rect:nnnn { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
    { \l_semio_viz_sce_mag_fp } { \l_semio_viz_sce_swatch_fp / 2 }
}

% 🌫️ Opacity: one constant dot per sample, its ink thinned by the value.
\cs_new_protected:Npn \semio_viz_sce_opacity: {
  \semio_viz_sce_solid:n
    {
      size = \fp_to_decimal:n { \l_semio_viz_sce_swatch_fp * \l_semio_viz_sce_swatch_fp / 2 } ,
      opacity = \fp_to_decimal:n { 0.15 + 0.85 * \l_semio_viz_sce_t_fp }
    }
  \semio_viz_sc_mark:nnn { dot } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% 🎨 Fill: one constant swatch per sample, painted from the categorical palette.
\cs_new_protected:Npn \semio_viz_sce_fill: {
  \semio_viz_sce_solid:n
    { size = \fp_to_decimal:n { \l_semio_viz_sce_swatch_fp * \l_semio_viz_sce_swatch_fp } }
  \semio_viz_sc_mark:nnn { square } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% 🖊️ Stroke: the same swatch spending its slot colour on the outline instead.
\cs_new_protected:Npn \semio_viz_sce_stroke: {
  \semio_viz_sce_outline:n
    { size = \fp_to_decimal:n { \l_semio_viz_sce_swatch_fp * \l_semio_viz_sce_swatch_fp } }
  \semio_viz_sc_mark:nnn { square } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% 📏 Stroke width: an upright rule per sample, thickened by the value. The thickness is real
% geometry — a rule as wide as the value — rather than a TikZ line weight, so the width the
% reader measures is the width the probe records.
\cs_new_protected:Npn \semio_viz_sce_stroke_width: {
  \semio_viz_sce_solid:n { }
  \semio_viz_sc_rect:nnnn { \l_semio_viz_sce_x_fp }
    { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp - 6 ) / 2 }
    { \l_semio_viz_sce_mag_fp / 3 }
    { \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp }
}

% 📐 Line width: a level rule per sample, thickened by the value, so the channel reads across
% the row rather than down the column.
\cs_new_protected:Npn \semio_viz_sce_line_width: {
  \semio_viz_sce_solid:n { }
  \semio_viz_sc_rect:nnnn
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 } { \l_semio_viz_sce_ry_fp }
    { \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp }
    { \l_semio_viz_sce_mag_fp / 3 }
}

% 📏 Length: a rule starting at the frame's left edge, its run carrying the value.
\cs_new_protected:Npn \semio_viz_sce_length: {
  \semio_viz_sce_outline:n
    {
      points =
        {
          \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
          \fp_to_decimal:N \l_semio_viz_sce_ry_fp ;
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_xa_fp
                + max ( 0.1 , \l_semio_viz_sce_t_fp )
                  * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
            } ,
          \fp_to_decimal:N \l_semio_viz_sce_ry_fp
        }
    }
  \semio_viz_sc_path:n { straight-line }
}

% ➖ Dash: one upright rule per sample, cycling the dash patterns of the mark kernel.
\cs_new_protected:Npn \semio_viz_sce_dash: {
  \semio_viz_sce_cycle:NN \l_semio_viz_sce_dashes_clist \l_semio_viz_sce_pick_tl
  \semio_viz_sce_outline:n
    {
      dash = \exp_not:V \l_semio_viz_sce_pick_tl ,
      points =
        {
          \fp_to_decimal:N \l_semio_viz_sce_x_fp ,
          \fp_to_decimal:N \l_semio_viz_sc_ya_fp ;
          \fp_to_decimal:N \l_semio_viz_sce_x_fp ,
          \fp_to_decimal:n { \l_semio_viz_sc_yb_fp - 6 }
        }
    }
  \semio_viz_sc_path:n { straight-line }
}

% ➡️ Arrowheads: one level rule per sample, cycling which of its ends carries a head.
\cs_new_protected:Npn \semio_viz_sce_arrowheads: {
  \semio_viz_sce_cycle:NN \l_semio_viz_sce_arrows_clist \l_semio_viz_sce_pick_tl
  \semio_viz_sce_outline:n
    {
      arrow = \exp_not:V \l_semio_viz_sce_pick_tl ,
      points =
        {
          \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
          \fp_to_decimal:N \l_semio_viz_sce_ry_fp ;
          \fp_to_decimal:N \l_semio_viz_sc_xb_fp ,
          \fp_to_decimal:N \l_semio_viz_sce_ry_fp
        }
    }
  \semio_viz_sc_path:n { straight-line }
}

% 🌀 Curvature: the same two endpoints per sample, bowed by the value.
\cs_new_protected:Npn \semio_viz_sce_curvature: {
  \semio_viz_sce_outline:n
    {
      curvature = \fp_to_decimal:n { 0.1 + 0.7 * \l_semio_viz_sce_t_fp } ,
      points =
        {
          \fp_to_decimal:N \l_semio_viz_sce_x_fp ,
          \fp_to_decimal:N \l_semio_viz_sc_ya_fp ;
          \fp_to_decimal:N \l_semio_viz_sce_x_fp ,
          \fp_to_decimal:n { \l_semio_viz_sc_yb_fp - 6 }
        }
    }
  \semio_viz_sc_path:n { curved-connector }
}

% 🧭 Direction: a needle of constant length per sample, its heading carrying the value.
\cs_new_protected:Npn \semio_viz_sce_direction: {
  \semio_viz_sce_outline:n
    {
      arrow = end ,
      points =
        {
          \fp_to_decimal:N \l_semio_viz_sce_x_fp ,
          \fp_to_decimal:N \l_semio_viz_sce_cy_fp ;
          \fp_to_decimal:n
            {
              \l_semio_viz_sce_x_fp
                + \l_semio_viz_sce_swatch_fp
                  * cosd ( \l_semio_viz_sce_t_fp * \l_semio_viz_sce_span_fp )
            } ,
          \fp_to_decimal:n
            {
              \l_semio_viz_sce_cy_fp
                + \l_semio_viz_sce_swatch_fp
                  * sind ( \l_semio_viz_sce_t_fp * \l_semio_viz_sce_span_fp )
            }
        }
    }
  \semio_viz_sc_path:n { straight-line }
}

% 🔄 Rotation: one constant square per sample, turned by the value.
\cs_new_protected:Npn \semio_viz_sce_rotation: {
  \semio_viz_sce_rotor:nnnnn { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
    { \l_semio_viz_sce_swatch_fp / 2 } { 4 }
    { \l_semio_viz_sce_t_fp * \l_semio_viz_sce_span_fp }
  \semio_viz_sce_solid:n
    { points = { \exp_not:V \l_semio_viz_sce_points_tl } }
  \semio_viz_sc_path:n { polygon }
}

% 🔣 Symbol: one constant area per sample, cycling the mark kinds of the shape channel.
\cs_new_protected:Npn \semio_viz_sce_symbol: {
  \semio_viz_sce_cycle:NN \l_semio_viz_sce_symbols_clist \l_semio_viz_sce_pick_tl
  \semio_viz_sce_solid:n
    { size = \fp_to_decimal:n { \l_semio_viz_sce_swatch_fp * \l_semio_viz_sce_swatch_fp } }
  \exp_args:NV \semio_viz_sc_mark:nnn \l_semio_viz_sce_pick_tl
    { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% ▨ Pattern: one constant swatch per sample, cycling the fills of the mark kernel.
\cs_new_protected:Npn \semio_viz_sce_pattern: {
  \semio_viz_sce_cycle:NN \l_semio_viz_sce_patterns_clist \l_semio_viz_sce_pick_tl
  \semio_viz_sce_solid:n
    {
      pattern = \exp_not:V \l_semio_viz_sce_pick_tl ,
      size = \fp_to_decimal:n { \l_semio_viz_sce_swatch_fp * \l_semio_viz_sce_swatch_fp }
    }
  \semio_viz_sc_mark:nnn { square } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% ▩ Hatching: a constant swatch whose hatch density, drawn strand by strand, carries the value.
\cs_new_protected:Npn \semio_viz_sce_hatching: {
  \semio_viz_sce_outline:n
    { size = \fp_to_decimal:n { \l_semio_viz_sce_swatch_fp * \l_semio_viz_sce_swatch_fp } }
  \semio_viz_sc_mark:nnn { square } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
  \int_set:Nn \l_semio_viz_sce_k_int
    { 1 + \fp_to_int:n { round ( \l_semio_viz_sce_t_fp * \l_semio_viz_sce_strands_int ) } }
  \int_step_inline:nn { \l_semio_viz_sce_k_int }
    {
      \semio_viz_sce_outline:n
        {
          points =
            {
              \fp_to_decimal:n
                {
                  \l_semio_viz_sce_x_fp - \l_semio_viz_sce_swatch_fp / 2
                    + ( ##1 - 0.5 ) * \l_semio_viz_sce_swatch_fp
                      / \l_semio_viz_sce_k_int
                } ,
              \fp_to_decimal:n { \l_semio_viz_sce_cy_fp - \l_semio_viz_sce_swatch_fp / 2 } ;
              \fp_to_decimal:n
                {
                  \l_semio_viz_sce_x_fp - \l_semio_viz_sce_swatch_fp / 2
                    + ##1 * \l_semio_viz_sce_swatch_fp / \l_semio_viz_sce_k_int
                } ,
              \fp_to_decimal:n { \l_semio_viz_sce_cy_fp + \l_semio_viz_sce_swatch_fp / 2 }
            }
        }
      \semio_viz_sc_path:n { straight-line }
    }
}

% 🪆 Nested marks: a constant outer frame per sample holding an inner one that carries the value.
\cs_new_protected:Npn \semio_viz_sce_nested: {
  \semio_viz_sce_outline:n
    { size = \fp_to_decimal:n { \l_semio_viz_sce_swatch_fp * \l_semio_viz_sce_swatch_fp } }
  \semio_viz_sc_mark:nnn { square } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
  \semio_viz_sce_solid:n
    { size = \fp_to_decimal:n { \l_semio_viz_sce_mag_fp * \l_semio_viz_sce_mag_fp } }
  \semio_viz_sc_mark:nnn { diamond } { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
}

% 🔯 Glyph: one many-cornered glyph per sample, its own orientation carrying the value.
\cs_new_protected:Npn \semio_viz_sce_glyph: {
  \semio_viz_sce_rotor:nnnnn { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp }
    { \l_semio_viz_sce_swatch_fp / 2 } { \l_semio_viz_sce_strands_int + 2 }
    { \l_semio_viz_sce_t_fp * \l_semio_viz_sce_span_fp }
  \semio_viz_sce_outline:n
    { points = { \exp_not:V \l_semio_viz_sce_points_tl } }
  \semio_viz_sc_path:n { polygon }
}

% 🔢 Icon: a repeated unit mark per sample, the count of units carrying the value.
\cs_new_protected:Npn \semio_viz_sce_icon: {
  \int_set:Nn \l_semio_viz_sce_k_int
    { 1 + \fp_to_int:n { round ( \l_semio_viz_sce_t_fp * \l_semio_viz_sce_strands_int ) } }
  \int_step_inline:nn { \l_semio_viz_sce_k_int }
    {
      \semio_viz_sce_solid:n
        { size = \fp_to_decimal:n { \l_semio_viz_sce_low_fp * \l_semio_viz_sce_low_fp } }
      \semio_viz_sc_mark:nnn { icon-mark } { \l_semio_viz_sce_x_fp }
        {
          \l_semio_viz_sc_ya_fp
            + ( ##1 - 0.5 ) * ( \l_semio_viz_sce_low_fp + 0.8 )
        }
    }
}

% 📊 Mini charts: a whole small chart per sample, so the channel is a figure and not a swatch.
\cs_new_protected:Npn \semio_viz_sce_mini: {
  \semio_viz_sce_pair:n { \l_semio_viz_sce_i_int }
  \int_step_inline:nn { 3 }
    {
      \semio_viz_sce_solid:n { }
      \semio_viz_sc_rect:nnnn
        {
          \l_semio_viz_sce_x_fp - \l_semio_viz_sce_swatch_fp / 2
            + ( ##1 - 0.5 ) * \l_semio_viz_sce_swatch_fp / 3
        }
        {
          \l_semio_viz_sc_ya_fp
            + \l_semio_viz_sce_swatch_fp
              * ( \l_semio_viz_sce_px_fp * ##1 + \l_semio_viz_sce_py_fp ) / 4
        }
        { \l_semio_viz_sce_swatch_fp / 5 }
        {
          max ( 0.4 , \l_semio_viz_sce_swatch_fp * 2
            * ( \l_semio_viz_sce_px_fp * ##1 + \l_semio_viz_sce_py_fp ) / 4 )
        }
    }
}

% 🔠 Font size: the same word per sample, set at a different size switch.
\cs_new_protected:Npn \semio_viz_sce_font_size: {
  \semio_viz_sce_word:
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      anchor = center ,
      font = \exp_not:c
        {
          \clist_item:Nn \l_semio_viz_sce_fonts_clist
            {
              \int_mod:nn { \l_semio_viz_sce_i_int - 1 }
                { \clist_count:N \l_semio_viz_sce_fonts_clist } + 1
            }
        }
    }
  \semio_viz_sc_text:Vnnn \l_semio_viz_sc_opts_tl
    { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_cy_fp } { \l_semio_viz_sce_cell_tl }
}

% 🔠 Font weight: the same word per sample, set in a different series.
\cs_new_protected:Npn \semio_viz_sce_font_weight: {
  \semio_viz_sce_word:
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      anchor = center ,
      font = \exp_not:c
        {
          \clist_item:Nn \l_semio_viz_sce_weights_clist
            {
              \int_mod:nn { \l_semio_viz_sce_i_int - 1 }
                { \clist_count:N \l_semio_viz_sce_weights_clist } + 1
            }
        }
    }
  \semio_viz_sc_text:Vnnn \l_semio_viz_sc_opts_tl
    { \l_semio_viz_sce_x_fp } { \l_semio_viz_sce_ry_fp } { \l_semio_viz_sce_cell_tl }
}

% 🔄 Text rotation: the same word per sample, turned by the value.
\cs_new_protected:Npn \semio_viz_sce_text_rotation: {
  \semio_viz_sce_word:
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      anchor = west ,
      style = { rotate = \fp_to_decimal:n
        { \l_semio_viz_sce_t_fp * \l_semio_viz_sce_span_fp } }
    }
  \semio_viz_sc_text:Vnnn \l_semio_viz_sc_opts_tl
    {
      \l_semio_viz_sce_x_fp
        + \l_semio_viz_sce_swatch_fp
          * cosd ( \l_semio_viz_sce_t_fp * \l_semio_viz_sce_span_fp ) / 2
    }
    {
      \l_semio_viz_sce_cy_fp
        + \l_semio_viz_sce_swatch_fp
          * sind ( \l_semio_viz_sce_t_fp * \l_semio_viz_sce_span_fp ) / 2
    }
    { \l_semio_viz_sce_cell_tl }
}

% 🧭 Cartesian: the pair of bound columns spent on the two positional channels.
\cs_new_protected:Npn \semio_viz_sce_cartesian: {
  \semio_viz_sce_load_two:
  \int_step_inline:nn { \l_semio_viz_sce_n_int }
    {
      \semio_viz_sce_sample:n {##1}
      \semio_viz_sce_pair:n {##1}
      \semio_viz_sce_solid:n
        { size = \fp_to_decimal:n { \l_semio_viz_sce_low_fp * \l_semio_viz_sce_high_fp } }
      \semio_viz_sc_mark:nnn { dot }
        {
          \l_semio_viz_sc_xa_fp
            + \l_semio_viz_sce_px_fp * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
        }
        {
          \l_semio_viz_sc_ya_fp
            + \l_semio_viz_sce_py_fp * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
        }
    }
}

% 🧭 Polar: the same pair of columns spent on an angle and a radius around one centre.
\cs_new_protected:Npn \semio_viz_sce_polar: {
  \semio_viz_sce_load_two:
  \semio_viz_sce_outline:n
    { radius = \fp_to_decimal:n { \l_semio_viz_sce_high_fp } }
  \semio_viz_sc_mark:nnn { circle } { \l_semio_viz_sce_cx_fp } { \l_semio_viz_sce_cy_fp }
  \int_step_inline:nn { \l_semio_viz_sce_n_int }
    {
      \semio_viz_sce_sample:n {##1}
      \semio_viz_sce_pair:n {##1}
      \semio_viz_sce_solid:n
        { size = \fp_to_decimal:n { \l_semio_viz_sce_low_fp * \l_semio_viz_sce_high_fp } }
      \semio_viz_sc_mark:nnn { dot }
        {
          \l_semio_viz_sce_cx_fp
            + \l_semio_viz_sce_high_fp * \l_semio_viz_sce_py_fp
              * cosd ( 360 * \l_semio_viz_sce_px_fp )
        }
        {
          \l_semio_viz_sce_cy_fp
            + \l_semio_viz_sce_high_fp * \l_semio_viz_sce_py_fp
              * sind ( 360 * \l_semio_viz_sce_px_fp )
        }
    }
}

% 🌍 Geographic: the same pair of columns spent on a longitude and a latitude, on a graticule.
\cs_new_protected:Npn \semio_viz_sce_geographic: {
  \semio_viz_sce_load_two:
  \int_step_inline:nn { \l_semio_viz_sce_strands_int }
    {
      \semio_viz_sce_outline:n
        {
          points =
            {
              \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
              \fp_to_decimal:n
                {
                  \l_semio_viz_sc_ya_fp + ##1 * ( \l_semio_viz_sc_yb_fp - 6
                    - \l_semio_viz_sc_ya_fp ) / ( \l_semio_viz_sce_strands_int + 1 )
                } ;
              \fp_to_decimal:N \l_semio_viz_sc_xb_fp ,
              \fp_to_decimal:n
                {
                  \l_semio_viz_sc_ya_fp + ##1 * ( \l_semio_viz_sc_yb_fp - 6
                    - \l_semio_viz_sc_ya_fp ) / ( \l_semio_viz_sce_strands_int + 1 )
                }
            }
        }
      \semio_viz_sc_path:n { straight-line }
      \semio_viz_sce_outline:n
        {
          points =
            {
              \fp_to_decimal:n
                {
                  \l_semio_viz_sc_xa_fp + ##1 * ( \l_semio_viz_sc_xb_fp
                    - \l_semio_viz_sc_xa_fp ) / ( \l_semio_viz_sce_strands_int + 1 )
                } ,
              \fp_to_decimal:N \l_semio_viz_sc_ya_fp ;
              \fp_to_decimal:n
                {
                  \l_semio_viz_sc_xa_fp + ##1 * ( \l_semio_viz_sc_xb_fp
                    - \l_semio_viz_sc_xa_fp ) / ( \l_semio_viz_sce_strands_int + 1 )
                } ,
              \fp_to_decimal:n { \l_semio_viz_sc_yb_fp - 6 }
            }
        }
      \semio_viz_sc_path:n { straight-line }
    }
  \int_step_inline:nn { \l_semio_viz_sce_n_int }
    {
      \semio_viz_sce_sample:n {##1}
      \semio_viz_sce_pair:n {##1}
      \semio_viz_sce_solid:n
        { size = \fp_to_decimal:n { \l_semio_viz_sce_low_fp * \l_semio_viz_sce_high_fp } }
      \semio_viz_sc_mark:nnn { cross }
        {
          \l_semio_viz_sc_xa_fp
            + \l_semio_viz_sce_px_fp * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
        }
        {
          \l_semio_viz_sc_ya_fp
            + \l_semio_viz_sce_py_fp * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
        }
    }
}

% 🔺 Barycentric: three shares per row read as one point inside the reference triangle.
\cs_new_protected:Npn \semio_viz_sce_barycentric: {
  \semio_viz_sce_load_two:
  \semio_viz_sce_outline:n
    {
      closed = true ,
      points =
        {
          \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
          \fp_to_decimal:N \l_semio_viz_sc_ya_fp ;
          \fp_to_decimal:N \l_semio_viz_sc_xb_fp ,
          \fp_to_decimal:N \l_semio_viz_sc_ya_fp ;
          \fp_to_decimal:N \l_semio_viz_sce_cx_fp ,
          \fp_to_decimal:n { \l_semio_viz_sc_yb_fp - 6 }
        }
    }
  \semio_viz_sc_path:n { polygon }
  \int_step_inline:nn { \l_semio_viz_sce_n_int }
    {
      \semio_viz_sce_sample:n {##1}
      \semio_viz_sce_pair:n {##1}
      \semio_viz_sce_solid:n
        { size = \fp_to_decimal:n { \l_semio_viz_sce_low_fp * \l_semio_viz_sce_high_fp } }
      \semio_viz_sc_mark:nnn { triangle }
        {
          ( \l_semio_viz_sc_xa_fp * ( 1 - \l_semio_viz_sce_px_fp )
            + \l_semio_viz_sc_xb_fp * \l_semio_viz_sce_px_fp )
            * ( 1 - \l_semio_viz_sce_py_fp / 2 )
            + \l_semio_viz_sce_cx_fp * \l_semio_viz_sce_py_fp / 2
        }
        {
          \l_semio_viz_sc_ya_fp
            + \l_semio_viz_sce_py_fp / 2
              * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
        }
    }
}

% 🌈 Gradient: the value read as a position on the theme's own continuous ramp.
\cs_new_protected:Npn \semio_viz_sce_gradient: {
  \int_set:Nn \l_semio_viz_sce_k_int
    { \l_semio_viz_sce_n_int * \l_semio_viz_sce_strands_int }
  \int_step_inline:nn { \l_semio_viz_sce_k_int }
    {
      \semio_viz_theme_ramp_color:nN
        { ( ##1 - 0.5 ) / \l_semio_viz_sce_k_int } \l_semio_viz_sc_hue_tl
      \semio_viz_sce_solid:n { }
      \semio_viz_sc_rect:nnnn
        {
          \l_semio_viz_sc_xa_fp
            + ( ##1 - 0.5 ) * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
              / \l_semio_viz_sce_k_int
        }
        { \l_semio_viz_sce_cy_fp }
        { ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / \l_semio_viz_sce_k_int }
        { \l_semio_viz_sce_swatch_fp }
    }
}

% 🔯 Glyphs: a whole field of composite marks, two shares per row deciding shape and turn.
\cs_new_protected:Npn \semio_viz_sce_glyphs: {
  \semio_viz_sce_load_two:
  \int_step_inline:nn { \l_semio_viz_sce_strands_int }
    {
      \int_set:Nn \l_semio_viz_sce_k_int {##1}
      \int_step_inline:nn { \l_semio_viz_sce_n_int }
        {
          \semio_viz_sce_sample:n {####1}
          \semio_viz_sce_rotor:nnnnn { \l_semio_viz_sce_x_fp }
            {
              \l_semio_viz_sc_ya_fp
                + ( \l_semio_viz_sce_k_int - 0.5 )
                  * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
                  / \l_semio_viz_sce_strands_int
            }
            { \l_semio_viz_sce_low_fp } { 3 }
            {
              \l_semio_viz_sce_t_fp * \l_semio_viz_sce_span_fp
                * \l_semio_viz_sce_k_int / \l_semio_viz_sce_strands_int
            }
          \semio_viz_sce_solid:n
            { points = { \exp_not:V \l_semio_viz_sce_points_tl } }
          \semio_viz_sc_path:n { polygon }
        }
    }
}

% 🎚️ One §74 encoding channel, rendered as a catalogue kind.
\cs_new_protected:Npn \semio_viz_sce_render:n #1 {
  \semio_viz_sc_frame:
  \semio_viz_sce_keys_reset:
  \keys_set:nn { semio / viz / family / encoding } {#1}
  \semio_viz_sce_load:
  \str_case:VnF \l_semio_viz_sce_variant_tl
    {
      { angle } { \semio_viz_sce_strip:N \semio_viz_sce_angle: }
      { area-encoding } { \semio_viz_sce_strip:N \semio_viz_sce_area: }
      { arrowheads } { \semio_viz_sce_strip:N \semio_viz_sce_arrowheads: }
      { barycentric-coordinates } { \semio_viz_sce_barycentric: }
      { curvature } { \semio_viz_sce_strip:N \semio_viz_sce_curvature: }
      { dash } { \semio_viz_sce_strip:N \semio_viz_sce_dash: }
      { direction } { \semio_viz_sce_strip:N \semio_viz_sce_direction: }
      { fill } { \semio_viz_sce_strip:N \semio_viz_sce_fill: }
      { font-size } { \semio_viz_sce_strip:N \semio_viz_sce_font_size: }
      { font-weight } { \semio_viz_sce_strip:N \semio_viz_sce_font_weight: }
      { geographic-coordinates } { \semio_viz_sce_geographic: }
      { glyph } { \semio_viz_sce_strip:N \semio_viz_sce_glyph: }
      { glyphs } { \semio_viz_sce_glyphs: }
      { gradient } { \semio_viz_sce_gradient: }
      { hatching } { \semio_viz_sce_strip:N \semio_viz_sce_hatching: }
      { height } { \semio_viz_sce_strip:N \semio_viz_sce_height: }
      { icon } { \semio_viz_sce_strip:N \semio_viz_sce_icon: }
      { length } { \semio_viz_sce_strip:N \semio_viz_sce_length: }
      { line-width } { \semio_viz_sce_strip:N \semio_viz_sce_line_width: }
      { mini-charts } { \semio_viz_sce_strip:N \semio_viz_sce_mini: }
      { nested-marks } { \semio_viz_sce_strip:N \semio_viz_sce_nested: }
      { opacity } { \semio_viz_sce_strip:N \semio_viz_sce_opacity: }
      { pattern } { \semio_viz_sce_strip:N \semio_viz_sce_pattern: }
      { polar-angle-radius } { \semio_viz_sce_polar: }
      { radius } { \semio_viz_sce_strip:N \semio_viz_sce_radius: }
      { rotation-encoding } { \semio_viz_sce_strip:N \semio_viz_sce_rotation: }
