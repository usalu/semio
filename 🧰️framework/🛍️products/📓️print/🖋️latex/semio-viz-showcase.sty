        { ( \l_semio_viz_scg_cx_fp + 2 + \l_semio_viz_sc_xb_fp ) / 2 }
        { \l_semio_viz_scg_cy_fp }
    }
}

% 🧱 The grammar's composition stage: two views of the same table stacked in one frame.
\cs_new_protected:Npn \semio_viz_scg_composition: {
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \semio_viz_scg_cell:nN {##1} \l_semio_viz_scg_y_tl
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        { fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none }
      \semio_viz_sc_rect:nnnn
        { \l_semio_viz_sc_xa_fp + ( ##1 - 0.5 ) * \l_semio_viz_scg_step_fp }
        {
          \l_semio_viz_scg_cy_fp + 1
            + ( \l_semio_viz_scg_cell_tl - \l_semio_viz_scg_lo_fp )
              / max ( 1e-9 , \l_semio_viz_scg_hi_fp - \l_semio_viz_scg_lo_fp )
              * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_scg_cy_fp - 1 ) / 2
        }
        { \l_semio_viz_scg_step_fp * 0.6 }
        {
          max ( 0.3 ,
            ( \l_semio_viz_scg_cell_tl - \l_semio_viz_scg_lo_fp )
              / max ( 1e-9 , \l_semio_viz_scg_hi_fp - \l_semio_viz_scg_lo_fp )
              * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_scg_cy_fp - 1 ) )
        }
      \semio_viz_scg_cell:nN {##1} \l_semio_viz_scg_y_two_tl
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        { fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none , opacity = 0.5 }
      \semio_viz_sc_mark:nnn { diamond }
        { \l_semio_viz_sc_xa_fp + ( ##1 - 0.5 ) * \l_semio_viz_scg_step_fp }
        {
          \l_semio_viz_sc_ya_fp
            + ( \l_semio_viz_scg_cell_tl - \l_semio_viz_scg_lo_fp )
              / max ( 1e-9 , \l_semio_viz_scg_hi_fp - \l_semio_viz_scg_lo_fp )
              * ( \l_semio_viz_scg_cy_fp - 1 - \l_semio_viz_sc_ya_fp )
        }
    }
}

