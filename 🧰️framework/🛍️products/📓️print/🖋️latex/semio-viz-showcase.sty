\ProvidesPackage{semio-viz-showcase}[2026/09/06 v1.0.0 semio viz capability showcase families for taxonomy sections 74-79 (namespace, encoding, grammar, scale, figure, transform-data, transform-statistical, layout-algorithm, shape)]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-plot}
\RequirePackage{semio-viz-layout}

\ExplSyntaxOn

%region 🔖️Canvas
% 📐 The rectangle every showcase renderer draws inside: the figure extent inset by the guide
% package's plot pad, so a showcase mark and a \SemioVizAxis land on the same geometry.
\fp_new:N \l_semio_viz_sc_xa_fp
\fp_new:N \l_semio_viz_sc_ya_fp
\fp_new:N \l_semio_viz_sc_xb_fp
\fp_new:N \l_semio_viz_sc_yb_fp
\tl_new:N \l_semio_viz_sc_ink_tl
\tl_new:N \l_semio_viz_sc_rule_tl
\tl_new:N \l_semio_viz_sc_hue_tl
\tl_new:N \l_semio_viz_sc_opts_tl
\tl_new:N \l_semio_viz_sc_cell_tl
\tl_new:N \l_semio_viz_sc_col_tl
\clist_new:N \l_semio_viz_sc_pair_clist
\int_new:N \l_semio_viz_sc_rows_int
\int_new:N \l_semio_viz_sc_slots_int
\fp_new:N \l_semio_viz_sc_lo_fp
\fp_new:N \l_semio_viz_sc_hi_fp
\fp_new:N \l_semio_viz_sc_step_fp
\fp_new:N \l_semio_viz_sc_val_fp
\seq_new:N \l_semio_viz_sc_values_seq

% 📐 Resolves the drawing rectangle and the two chrome colours every renderer needs.
\cs_new_protected:Npn \semio_viz_sc_frame: {
  \semio_viz_frame_require:n { SemioVizChart }
  \fp_set_eq:NN \l_semio_viz_sc_xa_fp \l_semio_viz_pad_fp
  \fp_set_eq:NN \l_semio_viz_sc_ya_fp \l_semio_viz_pad_fp
  \fp_set:Nn \l_semio_viz_sc_xb_fp { \l_semio_viz_width_fp - 2 }
  \fp_set:Nn \l_semio_viz_sc_yb_fp { \l_semio_viz_height_fp - 2 }
  \semio_viz_theme_chrome:nN { foreground } \l_semio_viz_sc_ink_tl
  \semio_viz_theme_chrome:nN { border-normal } \l_semio_viz_sc_rule_tl
  \tl_clear:N \l_semio_viz_sc_opts_tl
}

% 🎨 Colour of the categorical slot #1 into the shared hue variable.
\cs_new_protected:Npn \semio_viz_sc_hue:n #1 { \semio_viz_theme_color:nN {#1} \l_semio_viz_sc_hue_tl }

% ⚫ Draws mark #1 at the point (#2,#3), styled by the collected option list.
\cs_new_protected:Npn \semio_viz_sc_mark:nnn #1#2#3 {
  \use:x {
    \exp_not:N \semio_viz_mark_draw:nnn {#1} { \exp_not:V \l_semio_viz_sc_opts_tl }
      { \fp_to_decimal:n {#2} , \fp_to_decimal:n {#3} }
  }
}

% 〰️ Draws path primitive #1 from the collected option list.
\cs_new_protected:Npn \semio_viz_sc_path:n #1 {
  \use:x { \exp_not:N \semio_viz_path_draw:nn {#1} { \exp_not:V \l_semio_viz_sc_opts_tl } }
}

% ▭ An axis-aligned rectangle of width #3 and height #4 centred on (#1,#2), expressed in the
% mark kernel's own area-and-aspect vocabulary rather than as a raw TikZ rectangle.
\cs_new_protected:Npn \semio_viz_sc_rect:nnnn #1#2#3#4 {
  \use:x {
    \exp_not:N \semio_viz_mark_draw:nnn { rectangle }
      {
        \exp_not:V \l_semio_viz_sc_opts_tl ,
        size = \fp_to_decimal:n { max ( 0.01 , (#3) * (#4) ) } ,
        aspect = \fp_to_decimal:n { max ( 0.001 , (#3) / max ( 0.01 , (#4) ) ) }
      }
      { \fp_to_decimal:n {#1} , \fp_to_decimal:n {#2} }
  }
}

% 🔠 A caption-weight text node at (#2,#3) carrying #4, with the TikZ options #1.
\cs_new_protected:Npn \semio_viz_sc_text:nnnn #1#2#3#4 {
  \use:x {
    \exp_not:N \semio_viz_text_draw:nnnn { label } { \exp_not:n {#1} }
      { \fp_to_decimal:n {#2} , \fp_to_decimal:n {#3} } { \exp_not:n {#4} }
  }
}

% 🗣️ The showcase caption, English #1 or German #2 by the document language, above the frame.
\cs_new_protected:Npn \semio_viz_sc_caption:nn #1#2 {
  \use:x {
    \exp_not:N \semio_viz_text_draw:nnnn { label } { anchor = north~west }
      {
        \fp_to_decimal:n { \l_semio_viz_sc_xa_fp - 5 } ,
        \fp_to_decimal:n { \l_semio_viz_sc_yb_fp + 3 }
      }
      { \exp_not:N \semio_viz_format_localized:nn { \exp_not:n {#1} } { \exp_not:n {#2} } }
  }
}

% 🔢 First column of table #1 whose every cell is a number; empty when the table has none.
\cs_new_protected:Npn \semio_viz_sc_numeric_col:nN #1#2 {
  \tl_clear:N #2
  \clist_map_inline:cn { g_semio_viz_table_ \tl_to_str:n {#1} _cols_clist }
    {
      \tl_if_empty:NT #2
        { \semio_viz_plot_if_numeric:nnTF {#1} {##1} { \tl_set:Nn #2 {##1} } { } }
    }
}
\cs_generate_variant:Nn \semio_viz_sc_numeric_col:nN { VN }

% 🔢 The series a panel plots: column #2 of table #1 when the table declares one, otherwise the
% row ordinals — a reshaping transform can leave a table with no all-numeric column at all, and
% its row count is then what the operation changed.
\cs_new_protected:Npn \semio_viz_sc_series:nn #1#2 {
  \tl_if_empty:nTF {#2}
    { \semio_viz_sc_ordinals:n {#1} }
    {
      \semio_viz_table_col_values:nnN {#1} {#2} \l_semio_viz_sc_values_seq
      \seq_if_empty:NT \l_semio_viz_sc_values_seq { \semio_viz_sc_ordinals:n {#1} }
    }
}

% 🔢 The row ordinals of table #1, as the fallback series.
\cs_new_protected:Npn \semio_viz_sc_ordinals:n #1 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_sc_rows_int
  \seq_clear:N \l_semio_viz_sc_values_seq
  \int_step_inline:nn { \l_semio_viz_sc_rows_int }
    { \seq_put_right:Nn \l_semio_viz_sc_values_seq {##1} }
}

% 📊 Every row of column #2 of table #1 as a bar standing on #5, inside the box
% (#3,#5)-(#4,#6): the panel both halves of a before/after showcase are drawn with.
\cs_new_protected:Npn \semio_viz_sc_bars:nnnnnn #1#2#3#4#5#6 {
  \semio_viz_sc_series:nn {#1} {#2}
  \int_set:Nn \l_semio_viz_sc_rows_int { \seq_count:N \l_semio_viz_sc_values_seq }
  \fp_set:Nn \l_semio_viz_sc_lo_fp { 0 }
  \fp_set:Nn \l_semio_viz_sc_hi_fp { 0 }
  \seq_map_inline:Nn \l_semio_viz_sc_values_seq
    {
      \fp_set:Nn \l_semio_viz_sc_lo_fp { min ( \l_semio_viz_sc_lo_fp , ##1 ) }
      \fp_set:Nn \l_semio_viz_sc_hi_fp { max ( \l_semio_viz_sc_hi_fp , ##1 ) }
    }
  \fp_compare:nNnT { \l_semio_viz_sc_hi_fp - \l_semio_viz_sc_lo_fp } < { 1e-9 }
    { \fp_add:Nn \l_semio_viz_sc_hi_fp { 1 } }
  \fp_set:Nn \l_semio_viz_sc_step_fp
    { ( (#4) - (#3) ) / max ( 1 , \l_semio_viz_sc_rows_int ) }
  \int_step_inline:nn { \l_semio_viz_sc_rows_int }
    {
      \fp_set:Nn \l_semio_viz_sc_val_fp
        {
          ( \seq_item:Nn \l_semio_viz_sc_values_seq {##1} - \l_semio_viz_sc_lo_fp )
            / ( \l_semio_viz_sc_hi_fp - \l_semio_viz_sc_lo_fp ) * ( (#6) - (#5) )
        }
      \semio_viz_sc_hue:n { ##1 - 1 }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        { fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none }
      \semio_viz_sc_rect:nnnn
        { (#3) + ( ##1 - 0.5 ) * \l_semio_viz_sc_step_fp }
        { (#5) + \l_semio_viz_sc_val_fp / 2 }
        { \l_semio_viz_sc_step_fp * 0.7 }
        { max ( 0.2 , \l_semio_viz_sc_val_fp ) }
    }
}
\cs_generate_variant:Nn \semio_viz_sc_bars:nnnnnn { nVnnnn }

% 🪞 A before/after showcase: table #1 on the left half, table #2 on the right half, each
% through its own first numeric column, captioned #3 in English and #4 in German.
\cs_new_protected:Npn \semio_viz_sc_before_after:nnnn #1#2#3#4
  { \semio_viz_sc_before_after:nnnnn {#1} {#2} {#3} {#4} { } }

% 🪞 The same panel with the result's own column named in #5 instead of discovered: an operation
% that appends a column leaves the source's first numeric column standing, and the panel would
% then draw the source twice and say nothing about the operation.
\cs_new_protected:Npn \semio_viz_sc_before_after:nnnnn #1#2#3#4#5 {
  \semio_viz_sc_numeric_col:nN {#1} \l_semio_viz_sc_col_tl
  \semio_viz_sc_bars:nVnnnn {#1} \l_semio_viz_sc_col_tl
    { \l_semio_viz_sc_xa_fp }
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 - 2 }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 4 }
  \tl_set:Nn \l_semio_viz_sc_col_tl {#5}
  \tl_if_empty:NT \l_semio_viz_sc_col_tl
    { \semio_viz_sc_numeric_col:nN {#2} \l_semio_viz_sc_col_tl }
  \semio_viz_sc_bars:nVnnnn {#2} \l_semio_viz_sc_col_tl
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 + 2 }
    { \l_semio_viz_sc_xb_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 4 }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      stroke = \exp_not:V \l_semio_viz_sc_rule_tl , fill = none , dash = dashed ,
      points =
        {
          \fp_to_decimal:n { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 } ,
          \fp_to_decimal:N \l_semio_viz_sc_ya_fp ;
          \fp_to_decimal:n { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 } ,
          \fp_to_decimal:n { \l_semio_viz_sc_yb_fp - 4 }
        }
    }
  \semio_viz_sc_path:n { straight-line }
  \semio_viz_sc_caption:nn {#3} {#4}
}
%endregion 🔖️Canvas

%region 🔖️Keys-namespace
% 🔑 semio / viz / family / namespace — the fifty-four §76 namespaces as catalogue kinds. A
% namespace is not a picture of its own: what stands for it is a figure only that namespace can
% draw, so every kind runs the canonical family of the namespace it names through the family
% registry. Nothing is redrawn here, and a namespace whose owner changes its renderer changes this
% catalogue entry with it.
%   variant (choice) one §76 namespace slug, default charts
%   data    (table)  the table the catalogue entry is registered against. It is read and not
%                    forwarded: a namespace is not a data set, and its canonical family draws the
%                    demo table its own renderer was written for — handing `arch-plan` the generic
%                    `demo` table would draw an empty plan, not a namespace.
%   options (keyval) extra options appended to the canonical family's own option list, default empty
%   caption (bool)   draw the caption naming the namespace, default true
%   locator (bool)   draw the §76 locator track under the figure, default true
%   order   (clist)  the §76 namespaces in taxonomy order; the locator reads its own position and
%                    its own length from this list, so the track never carries a written count
%   swatch  (fp)     edge length of the locator's own mark in millimetres, default 2.4
\tl_new:N \l_semio_viz_scn_variant_tl
\tl_new:N \l_semio_viz_scn_data_tl
\tl_new:N \l_semio_viz_scn_extra_tl
\bool_new:N \l_semio_viz_scn_caption_bool
\bool_new:N \l_semio_viz_scn_locator_bool
\clist_new:N \l_semio_viz_scn_order_clist
\fp_new:N \l_semio_viz_scn_swatch_fp
\tl_new:N \l_semio_viz_scn_family_tl
\tl_new:N \l_semio_viz_scn_options_tl
\int_new:N \l_semio_viz_scn_index_int
\int_new:N \l_semio_viz_scn_i_int

\keys_define:nn { semio / viz / family / namespace } {
  variant .tl_set:N = \l_semio_viz_scn_variant_tl,
  data .tl_set:N = \l_semio_viz_scn_data_tl,
  options .tl_set:N = \l_semio_viz_scn_extra_tl,
  caption .bool_set:N = \l_semio_viz_scn_caption_bool,
  locator .bool_set:N = \l_semio_viz_scn_locator_bool,
  order .clist_set:N = \l_semio_viz_scn_order_clist,
  swatch .fp_set:N = \l_semio_viz_scn_swatch_fp,
}

% 🧹 Restores every namespace key to its documented default before a kind reads its options.
\cs_new_protected:Npn \semio_viz_scn_keys_reset: {
  \tl_set:Nn \l_semio_viz_scn_variant_tl { charts }
  \tl_set:Nn \l_semio_viz_scn_data_tl { demo }
  \tl_clear:N \l_semio_viz_scn_extra_tl
  \bool_set_true:N \l_semio_viz_scn_caption_bool
  \bool_set_true:N \l_semio_viz_scn_locator_bool
  \fp_set:Nn \l_semio_viz_scn_swatch_fp { 2.4 }
  \clist_set:Nn \l_semio_viz_scn_order_clist
    {
      adjacency , alluvial , annotation , arc , architecture , area , axis , bar , biology ,
      bundling , charts , chemistry , chord , choropleth , concept , contours , correlation ,
      diagram , distribution , engineering , field , financial , flow , geo , graph , hierarchy ,
      infographic , interactionstate , layout , legend , line , map , matrix , network ,
      network-matrix , pack , parallelsets , partition , physics , polar , process , projection ,
      routes , scale , scatter , scientific , signal , statistical , surface , symbols , table ,
      theme , tree , uml
    }
}
%endregion 🔖️Keys-namespace

%region 🔖️Family-namespace
% ▶️ Runs the canonical family #1 of the current namespace with its own option list #2 plus
% whatever the catalogue entry appended.
\cs_new_protected:Npn \semio_viz_scn_run:nn #1#2 {
  \tl_set:Nn \l_semio_viz_scn_family_tl {#1}
  \tl_set:Nx \l_semio_viz_scn_options_tl
    {
      \exp_not:n {#2}
      \tl_if_empty:NF \l_semio_viz_scn_extra_tl
        { \tl_if_empty:nF {#2} { , } \exp_not:V \l_semio_viz_scn_extra_tl }
    }
  \semio_viz_family_run:VV \l_semio_viz_scn_family_tl \l_semio_viz_scn_options_tl
}

% 🧭 The locator track: the §76 namespaces as one rule and this namespace's own place on it, so a
% reader paging through fifty-four figures always knows which namespace is speaking and how far
% through the section it sits.
\cs_new_protected:Npn \semio_viz_scn_locator: {
  \int_zero:N \l_semio_viz_scn_index_int
  \int_zero:N \l_semio_viz_scn_i_int
  \clist_map_inline:Nn \l_semio_viz_scn_order_clist
    {
      \int_incr:N \l_semio_viz_scn_i_int
      \str_if_eq:VnT \l_semio_viz_scn_variant_tl {##1}
        { \int_set_eq:NN \l_semio_viz_scn_index_int \l_semio_viz_scn_i_int }
    }
  \int_compare:nNnT { \l_semio_viz_scn_index_int } > { 0 }
    {
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = none , stroke = \exp_not:V \l_semio_viz_sc_rule_tl ,
          points =
            {
              \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
              \fp_to_decimal:n { \l_semio_viz_sc_ya_fp - \l_semio_viz_scn_swatch_fp } ;
              \fp_to_decimal:N \l_semio_viz_sc_xb_fp ,
              \fp_to_decimal:n { \l_semio_viz_sc_ya_fp - \l_semio_viz_scn_swatch_fp }
            }
        }
      \semio_viz_sc_path:n { straight-line }
      \semio_viz_sc_hue:n { 0 }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none ,
          size = \fp_to_decimal:n
            { \l_semio_viz_scn_swatch_fp * \l_semio_viz_scn_swatch_fp }
        }
      \semio_viz_sc_mark:nnn { dot }
        {
          \l_semio_viz_sc_xa_fp
            + ( \l_semio_viz_scn_index_int - 0.5 )
              * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
              / \clist_count:N \l_semio_viz_scn_order_clist
        }
        { \l_semio_viz_sc_ya_fp - \l_semio_viz_scn_swatch_fp }
    }
}

