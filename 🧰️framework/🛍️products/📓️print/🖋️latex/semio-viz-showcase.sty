            + ( ##1 - 0.5 ) * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
              / \l_semio_viz_scg_n_int
        }
        { \l_semio_viz_scg_cell_tl }
    }
}

% 🧭 The grammar's coordinate stage: one series read cartesian on the left and polar on the right.
\cs_new_protected:Npn \semio_viz_scg_coordinates: {
  \tl_clear:N \l_semio_viz_scg_points_tl
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
      \semio_viz_scg_cell:nN {##1} \l_semio_viz_scg_y_tl
      \tl_put_right:Nx \l_semio_viz_scg_points_tl
        {
          \tl_if_empty:NF \l_semio_viz_scg_points_tl { ; }
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_xa_fp
                + ( ##1 - 0.5 ) * ( \l_semio_viz_scg_cx_fp - 2 - \l_semio_viz_sc_xa_fp )
                  / \l_semio_viz_scg_n_int
            } ,
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_ya_fp
                + ( \l_semio_viz_scg_cell_tl - \l_semio_viz_scg_lo_fp )
                  / max ( 1e-9 , \l_semio_viz_scg_hi_fp - \l_semio_viz_scg_lo_fp )
                  * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
            }
        }
    }
  \semio_viz_sc_hue:n { 0 }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl ,
      points = { \exp_not:V \l_semio_viz_scg_points_tl }
    }
  \semio_viz_sc_path:n { polyline }
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
      \semio_viz_scg_cell:nN {##1} \l_semio_viz_scg_y_tl
      \semio_viz_sc_hue:n { 1 }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none ,
          innerRadius = 0 ,
          outerRadius = \fp_to_decimal:n
            {
              \l_semio_viz_scg_swatch_fp
                + ( \l_semio_viz_scg_cell_tl - \l_semio_viz_scg_lo_fp )
                  / max ( 1e-9 , \l_semio_viz_scg_hi_fp - \l_semio_viz_scg_lo_fp )
                  * \l_semio_viz_scg_swatch_fp
            } ,
          startAngle = \fp_to_decimal:n
            { 2 * pi * ( ##1 - 1 ) / \l_semio_viz_scg_n_int } ,
          endAngle = \fp_to_decimal:n
            { 2 * pi * ( ##1 - 0.2 ) / \l_semio_viz_scg_n_int }
