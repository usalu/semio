      { theme } { \semio_viz_scn_run:nn { figure } { variant = themes } }
      { tree } { \semio_viz_scn_run:nn { tree } { } }
      { uml } { \semio_viz_scn_run:nn { uml-class } { } }
    }
    { \semio_viz_scn_run:nn { pie } { } }
  \bool_if:NT \l_semio_viz_scn_locator_bool { \semio_viz_scn_locator: }
  \bool_if:NT \l_semio_viz_scn_caption_bool
    {
      \semio_viz_sc_caption:nn
        { Namespace~\l_semio_viz_scn_variant_tl }
        { Namensraum~\l_semio_viz_scn_variant_tl }
    }
}

% 🗂️ §76: each of the fifty-four namespaces stands for itself, drawn by its own canonical family.
\SemioVizFamily{namespace}{ \semio_viz_scn_render:n {#1} }
%endregion 🔖️Family-namespace

%region 🔖️Keys-figure
% 🔑 semio / viz / family / figure — the twelve §78 figure-infrastructure kinds as catalogue kinds.
% Infrastructure is only visible as a contrast, so every kind of this family draws the same series
% twice in one frame: once without the facility it names and once with it.
%   variant   (choice) one §78 infrastructure slug, default themes
%   data      (table)  bound table, default `demo`
%   x         (column) categorical column of the series, default `cat`
%   y         (column) quantitative column of the series, default `val`
%   category  (column) column the faceting kind splits on, default `grp`
%   label     (column) column supplying the labels and annotations, default `label`
%   cut       (fp)     value above which the clipping kind drops a record, default 6
%   panels    (int)    panels the responsive and typographic kinds stack, default 3
%   gap       (fp)     gap between the two halves of a contrast in millimetres, default 3
%   swatch    (fp)     edge length of one swatch in millimetres, default 6
%   patterns  (clist)  fills the accessible kind cycles, default hatch,crosshatch,dots,grid
%   textKinds (clist)  text roles the typographic kind cycles, default title,label,value,chip
\tl_new:N \l_semio_viz_scf_variant_tl
\tl_new:N \l_semio_viz_scf_data_tl
\tl_new:N \l_semio_viz_scf_x_tl
\tl_new:N \l_semio_viz_scf_y_tl
\tl_new:N \l_semio_viz_scf_category_tl
\tl_new:N \l_semio_viz_scf_label_tl
\fp_new:N \l_semio_viz_scf_cut_fp
\int_new:N \l_semio_viz_scf_panels_int
\fp_new:N \l_semio_viz_scf_gap_fp
\fp_new:N \l_semio_viz_scf_swatch_fp
\clist_new:N \l_semio_viz_scf_patterns_clist
\clist_new:N \l_semio_viz_scf_textkinds_clist
\tl_new:N \l_semio_viz_scf_mode_tl
\int_new:N \l_semio_viz_scf_n_int
\int_new:N \l_semio_viz_scf_i_int
\fp_new:N \l_semio_viz_scf_lo_fp
\fp_new:N \l_semio_viz_scf_hi_fp
\fp_new:N \l_semio_viz_scf_mid_fp
\tl_new:N \l_semio_viz_scf_cell_tl
\tl_new:N \l_semio_viz_scf_pick_tl
\tl_new:N \l_semio_viz_scf_level_tl

\keys_define:nn { semio / viz / family / figure } {
  variant .tl_set:N = \l_semio_viz_scf_variant_tl,
  data .tl_set:N = \l_semio_viz_scf_data_tl,
  x .tl_set:N = \l_semio_viz_scf_x_tl,
  y .tl_set:N = \l_semio_viz_scf_y_tl,
  category .tl_set:N = \l_semio_viz_scf_category_tl,
  label .tl_set:N = \l_semio_viz_scf_label_tl,
  cut .fp_set:N = \l_semio_viz_scf_cut_fp,
  panels .int_set:N = \l_semio_viz_scf_panels_int,
  gap .fp_set:N = \l_semio_viz_scf_gap_fp,
  swatch .fp_set:N = \l_semio_viz_scf_swatch_fp,
  patterns .clist_set:N = \l_semio_viz_scf_patterns_clist,
  textKinds .clist_set:N = \l_semio_viz_scf_textkinds_clist,
}

% 🧹 Restores every figure key to its documented default before a kind reads its options.
\cs_new_protected:Npn \semio_viz_scf_keys_reset: {
  \tl_set:Nn \l_semio_viz_scf_variant_tl { themes }
  \tl_set:Nn \l_semio_viz_scf_data_tl { demo }
  \tl_set:Nn \l_semio_viz_scf_x_tl { cat }
  \tl_set:Nn \l_semio_viz_scf_y_tl { val }
  \tl_set:Nn \l_semio_viz_scf_category_tl { grp }
  \tl_set:Nn \l_semio_viz_scf_label_tl { label }
  \fp_set:Nn \l_semio_viz_scf_cut_fp { 6 }
  \int_set:Nn \l_semio_viz_scf_panels_int { 3 }
  \fp_set:Nn \l_semio_viz_scf_gap_fp { 3 }
  \fp_set:Nn \l_semio_viz_scf_swatch_fp { 6 }
  \clist_set:Nn \l_semio_viz_scf_patterns_clist { hatch , crosshatch , dots , grid }
  \clist_set:Nn \l_semio_viz_scf_textkinds_clist { title , label , value , chip }
  \tl_set:Nn \l_semio_viz_scf_mode_tl { color }
}
%endregion 🔖️Keys-figure

%region 🔖️Family-figure
% 🔠 A text-carrying mark of role #1 at (#3,#4) with the option list #2, so the typographic kind
% can walk the theme's own roles instead of naming point sizes.
\cs_new_protected:Npn \semio_viz_scf_text:nnnn #1#2#3#4 {
  \use:x {
    \exp_not:N \semio_viz_text_draw:nnnn { \exp_not:V \l_semio_viz_scf_pick_tl }
      { \exp_not:n {#1} }
      { \fp_to_decimal:n {#2} , \fp_to_decimal:n {#3} } { \exp_not:n {#4} }
  }
}
\cs_generate_variant:Nn \semio_viz_scf_text:nnnn { nnnV }

% 🔢 The bound series' extent and row count.
\cs_new_protected:Npn \semio_viz_scf_load: {
  \semio_viz_table_nrows:VN \l_semio_viz_scf_data_tl \l_semio_viz_scf_n_int
  \semio_viz_table_col_min:VVN \l_semio_viz_scf_data_tl \l_semio_viz_scf_y_tl
    \l_semio_viz_scf_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_scf_data_tl \l_semio_viz_scf_y_tl
    \l_semio_viz_scf_hi_fp
  \fp_set:Nn \l_semio_viz_scf_mid_fp
    { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp ) / 2 - 2 }
}

% 🎨 The paint of slot #1 under the family's current mode: a categorical hue, a hatch over that
% hue, a step of the theme's own gray ramp, or an outline only.
\cs_new_protected:Npn \semio_viz_scf_paint:nn #1#2 {
  \semio_viz_sc_hue:n {#1}
  \str_case:VnF \l_semio_viz_scf_mode_tl
    {
      { pattern }
        {
          \tl_set:Nx \l_semio_viz_scf_pick_tl
            {
              \clist_item:Nn \l_semio_viz_scf_patterns_clist
                {
                  \int_mod:nn {#1} { \clist_count:N \l_semio_viz_scf_patterns_clist } + 1
                }
            }
          \tl_set:Nx \l_semio_viz_sc_opts_tl
            {
              fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none ,
              pattern = \exp_not:V \l_semio_viz_scf_pick_tl , #2
            }
        }
      { gray }
        {
          \semio_viz_theme_ramp_color:nN {#1} \l_semio_viz_sc_hue_tl
          \tl_set:Nx \l_semio_viz_sc_opts_tl
            { fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none , #2 }
        }
      { outline }
        {
          \tl_set:Nx \l_semio_viz_sc_opts_tl
            { fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl , #2 }
        }
    }
    {
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        { fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none , #2 }
    }
}

% 📊 The bound series as bars standing on #3 inside the box (#1,#3)-(#2,#4), every bar painted by
% the current mode and every record above the current cut left out.
\cs_new_protected:Npn \semio_viz_scf_bars:nnnnn #1#2#3#4#5 {
  \int_step_inline:nn { \l_semio_viz_scf_n_int }
    {
      \semio_viz_table_cell:VnVN \l_semio_viz_scf_data_tl {##1} \l_semio_viz_scf_y_tl
        \l_semio_viz_scf_cell_tl
      \bool_if:nT
        {
          ! (#5) || \fp_compare_p:nNn { \l_semio_viz_scf_cell_tl } < { \l_semio_viz_scf_cut_fp }
        }
        {
          \semio_viz_scf_paint:nn { ##1 - 1 } { }
          \semio_viz_sc_rect:nnnn
            {
              (#1) + ( ##1 - 0.5 ) * ( (#2) - (#1) ) / max ( 1 , \l_semio_viz_scf_n_int )
            }
            {
              (#3) + ( \l_semio_viz_scf_cell_tl - \l_semio_viz_scf_lo_fp )
                / max ( 1e-9 , \l_semio_viz_scf_hi_fp - \l_semio_viz_scf_lo_fp )
                * ( (#4) - (#3) ) / 2
            }
            { ( (#2) - (#1) ) / max ( 1 , \l_semio_viz_scf_n_int ) * 0.6 }
            {
              max ( 0.3 ,
                ( \l_semio_viz_scf_cell_tl - \l_semio_viz_scf_lo_fp )
                  / max ( 1e-9 , \l_semio_viz_scf_hi_fp - \l_semio_viz_scf_lo_fp )
                  * ( (#4) - (#3) ) )
            }
        }
    }
}

% 🪞 The two halves of a contrast: the same series painted in mode #1 on the left and mode #2 on
% the right, so the facility under demonstration is the only difference in the frame.
\cs_new_protected:Npn \semio_viz_scf_contrast:nn #1#2 {
  \tl_set:Nn \l_semio_viz_scf_mode_tl {#1}
  \semio_viz_scf_bars:nnnnn { \l_semio_viz_sc_xa_fp }
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 - \l_semio_viz_scf_gap_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 6 } { \c_false_bool }
  \tl_set:Nn \l_semio_viz_scf_mode_tl {#2}
  \semio_viz_scf_bars:nnnnn
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 + \l_semio_viz_scf_gap_fp }
    { \l_semio_viz_sc_xb_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 6 } { \c_false_bool }
  \tl_set:Nn \l_semio_viz_scf_mode_tl { color }
}

% 🌗 Themes: the same bars under the default palette and under the grayscale preset.
\cs_new_protected:Npn \semio_viz_scf_themes: {
  \semio_viz_scf_contrast:nn { color } { gray }
}

% ▨ Accessible patterns: colour alone on the left, colour plus a per-slot hatch on the right.
\cs_new_protected:Npn \semio_viz_scf_patterns: {
  \semio_viz_scf_contrast:nn { color } { pattern }
}

% 🩶 Grayscale-safe encodings: the ramp alone carries too little, so the right half repeats the
% value in a redundant channel — a mark per record whose area says the same thing.
\cs_new_protected:Npn \semio_viz_scf_grayscale: {
  \tl_set:Nn \l_semio_viz_scf_mode_tl { gray }
  \semio_viz_scf_bars:nnnnn { \l_semio_viz_sc_xa_fp } { \l_semio_viz_sc_xb_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_scf_mid_fp - \l_semio_viz_scf_gap_fp }
    { \c_false_bool }
  \tl_set:Nn \l_semio_viz_scf_mode_tl { color }
  \int_step_inline:nn { \l_semio_viz_scf_n_int }
    {
      \semio_viz_table_cell:VnVN \l_semio_viz_scf_data_tl {##1} \l_semio_viz_scf_y_tl
        \l_semio_viz_scf_cell_tl
      \semio_viz_theme_ramp_color:nN { ##1 - 1 } \l_semio_viz_sc_hue_tl
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = \exp_not:V \l_semio_viz_sc_hue_tl ,
          stroke = \exp_not:V \l_semio_viz_sc_ink_tl ,
          size = \fp_to_decimal:n
            {
              \l_semio_viz_scf_swatch_fp * \l_semio_viz_scf_swatch_fp
                * \l_semio_viz_scf_cell_tl
                / max ( 1e-9 , \l_semio_viz_scf_hi_fp )
            }
        }
      \semio_viz_sc_mark:nnn { diamond }
        {
          \l_semio_viz_sc_xa_fp
            + ( ##1 - 0.5 ) * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
              / max ( 1 , \l_semio_viz_scf_n_int )
        }
        { ( \l_semio_viz_scf_mid_fp + \l_semio_viz_sc_yb_fp - 6 ) / 2 }
    }
}

% ✂️ Clipping: the whole series on the left, and on the right the same series inside a value
% window, with everything outside it dropped rather than drawn over the frame.
\cs_new_protected:Npn \semio_viz_scf_clipping: {
  \semio_viz_scf_bars:nnnnn { \l_semio_viz_sc_xa_fp }
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 - \l_semio_viz_scf_gap_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 6 } { \c_false_bool }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    { fill = none , stroke = \exp_not:V \l_semio_viz_sc_rule_tl , dash = dashed }
  \semio_viz_sc_rect:nnnn
    {
      ( ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2
        + \l_semio_viz_scf_gap_fp + \l_semio_viz_sc_xb_fp ) / 2
    }
    { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp - 6 ) / 2 }
    {
      \l_semio_viz_sc_xb_fp - ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2
        - \l_semio_viz_scf_gap_fp
    }
    { \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp }
  \semio_viz_scf_bars:nnnnn
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 + \l_semio_viz_scf_gap_fp }
    { \l_semio_viz_sc_xb_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 6 } { \c_true_bool }
}

% 🧭 Coordinate transformations: the same values as upright bars and as radial spokes.
\cs_new_protected:Npn \semio_viz_scf_coordinates: {
  \semio_viz_scf_bars:nnnnn { \l_semio_viz_sc_xa_fp }
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 - \l_semio_viz_scf_gap_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 6 } { \c_false_bool }
  \int_step_inline:nn { \l_semio_viz_scf_n_int }
    {
      \semio_viz_table_cell:VnVN \l_semio_viz_scf_data_tl {##1} \l_semio_viz_scf_y_tl
        \l_semio_viz_scf_cell_tl
      \semio_viz_scf_paint:nn { ##1 - 1 }
        {
          points =
            {
              \fp_to_decimal:n
                {
                  ( ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2
                    + \l_semio_viz_scf_gap_fp + \l_semio_viz_sc_xb_fp ) / 2
                } ,
              \fp_to_decimal:N \l_semio_viz_scf_mid_fp ;
              \fp_to_decimal:n
                {
                  ( ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2
                    + \l_semio_viz_scf_gap_fp + \l_semio_viz_sc_xb_fp ) / 2
                    + \l_semio_viz_scf_swatch_fp * 2
                      * \l_semio_viz_scf_cell_tl / max ( 1e-9 , \l_semio_viz_scf_hi_fp )
                      * cosd ( 360 * ( ##1 - 1 ) / \l_semio_viz_scf_n_int )
                } ,
              \fp_to_decimal:n
                {
                  \l_semio_viz_scf_mid_fp
                    + \l_semio_viz_scf_swatch_fp * 2
                      * \l_semio_viz_scf_cell_tl / max ( 1e-9 , \l_semio_viz_scf_hi_fp )
                      * sind ( 360 * ( ##1 - 1 ) / \l_semio_viz_scf_n_int )
                }
            }
        }
      \semio_viz_sc_path:n { straight-line }
    }
}

% 🪟 Faceting: one panel per level of the bound category column, side by side and sharing a scale.
\cs_new_protected:Npn \semio_viz_scf_faceting: {
  \semio_viz_table_col_values:VVN \l_semio_viz_scf_data_tl \l_semio_viz_scf_category_tl
    \l_semio_viz_sc_values_seq
  \seq_remove_duplicates:N \l_semio_viz_sc_values_seq
  \int_set:Nn \l_semio_viz_scf_i_int { \seq_count:N \l_semio_viz_sc_values_seq }
  \int_step_inline:nn { \l_semio_viz_scf_i_int }
    {
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        { fill = none , stroke = \exp_not:V \l_semio_viz_sc_rule_tl }
      \semio_viz_sc_rect:nnnn
        {
          \l_semio_viz_sc_xa_fp
            + ( ##1 - 0.5 ) * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
              / \l_semio_viz_scf_i_int
        }
        { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp - 6 ) / 2 }
        {
          ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / \l_semio_viz_scf_i_int
            - \l_semio_viz_scf_gap_fp
        }
        { \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp }
      \semio_viz_scf_facet_panel:nn {##1} { \l_semio_viz_scf_i_int }
    }
}

% 🪟 The records of facet #1 of #2, drawn inside that facet's own panel.
\cs_new_protected:Npn \semio_viz_scf_facet_panel:nn #1#2 {
  \int_step_inline:nn { \l_semio_viz_scf_n_int }
    {
      \semio_viz_table_cell:VnVN \l_semio_viz_scf_data_tl {##1} \l_semio_viz_scf_category_tl
        \l_semio_viz_scf_pick_tl
      \tl_set:Nx \l_semio_viz_scf_level_tl { \seq_item:Nn \l_semio_viz_sc_values_seq {#1} }
      \tl_if_eq:NNT \l_semio_viz_scf_pick_tl \l_semio_viz_scf_level_tl
        {
          \semio_viz_table_cell:VnVN \l_semio_viz_scf_data_tl {##1} \l_semio_viz_scf_y_tl
            \l_semio_viz_scf_cell_tl
          \semio_viz_scf_paint:nn { #1 - 1 } { }
          \semio_viz_sc_rect:nnnn
            {
              \l_semio_viz_sc_xa_fp
                + ( #1 - 1 ) * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / (#2)
                + ( ##1 - 0.5 ) * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
                  / (#2) / \l_semio_viz_scf_n_int
            }
            {
              \l_semio_viz_sc_ya_fp
                + \l_semio_viz_scf_cell_tl / max ( 1e-9 , \l_semio_viz_scf_hi_fp )
                  * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp ) / 2
            }
            {
              ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / (#2)
                / \l_semio_viz_scf_n_int * 0.6
            }
            {
              max ( 0.3 , \l_semio_viz_scf_cell_tl / max ( 1e-9 , \l_semio_viz_scf_hi_fp )
                * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp ) )
            }
        }
    }
}

% 📐 Responsive sizing: the same figure laid out at every width the panel count asks for, so what
% changes with the available width is visible in one frame.
\cs_new_protected:Npn \semio_viz_scf_responsive: {
  \int_step_inline:nn { \l_semio_viz_scf_panels_int }
    {
      \semio_viz_scf_bars:nnnnn { \l_semio_viz_sc_xa_fp }
        {
          \l_semio_viz_sc_xa_fp
            + ##1 * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
              / \l_semio_viz_scf_panels_int
        }
        {
          \l_semio_viz_sc_ya_fp
            + ( ##1 - 1 ) * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
              / \l_semio_viz_scf_panels_int
        }
        {
          \l_semio_viz_sc_ya_fp
            + ( ##1 - 0.2 ) * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
              / \l_semio_viz_scf_panels_int
        }
        { \c_false_bool }
    }
}

% 🔠 Export-safe typography: one line per text role of the theme, each set through the role and
% never through a point size, so an exported figure keeps the document's own type.
\cs_new_protected:Npn \semio_viz_scf_typography: {
  \int_zero:N \l_semio_viz_scf_i_int
  \clist_map_inline:Nn \l_semio_viz_scf_textkinds_clist
    {
      \int_incr:N \l_semio_viz_scf_i_int
      \tl_set:Nn \l_semio_viz_scf_pick_tl {##1}
      \semio_viz_table_cell:VnVN \l_semio_viz_scf_data_tl { \l_semio_viz_scf_i_int }
        \l_semio_viz_scf_label_tl \l_semio_viz_scf_cell_tl
      \semio_viz_scf_text:nnnV { anchor = west }
        { \l_semio_viz_sc_xa_fp }
        {
          \l_semio_viz_sc_yb_fp - 6
            - ( \l_semio_viz_scf_i_int - 0.5 )
              * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
              / \clist_count:N \l_semio_viz_scf_textkinds_clist
        }
        \l_semio_viz_scf_cell_tl
    }
}

% 🏷️ Labels: the same bars, and on the right every bar carrying its own value at its own top.
\cs_new_protected:Npn \semio_viz_scf_labels: {
  \semio_viz_scf_bars:nnnnn { \l_semio_viz_sc_xa_fp }
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 - \l_semio_viz_scf_gap_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 6 } { \c_false_bool }
  \semio_viz_scf_bars:nnnnn
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 + \l_semio_viz_scf_gap_fp }
    { \l_semio_viz_sc_xb_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 6 } { \c_false_bool }
  \tl_set:Nn \l_semio_viz_scf_pick_tl { label }
  \int_step_inline:nn { \l_semio_viz_scf_n_int }
    {
      \semio_viz_table_cell:VnVN \l_semio_viz_scf_data_tl {##1} \l_semio_viz_scf_y_tl
        \l_semio_viz_scf_cell_tl
      \semio_viz_scf_text:nnnV { anchor = south }
        {
          ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 + \l_semio_viz_scf_gap_fp
            + ( ##1 - 0.5 )
              * ( \l_semio_viz_sc_xb_fp - ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2
                - \l_semio_viz_scf_gap_fp ) / \l_semio_viz_scf_n_int
        }
        {
          \l_semio_viz_sc_ya_fp
            + ( \l_semio_viz_scf_cell_tl - \l_semio_viz_scf_lo_fp )
              / max ( 1e-9 , \l_semio_viz_scf_hi_fp - \l_semio_viz_scf_lo_fp )
              * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
        }
        \l_semio_viz_scf_cell_tl
    }
}

% 🗯️ Annotations: the same bars, plus the reference line, band and callout that say what the
% reader is meant to notice.
\cs_new_protected:Npn \semio_viz_scf_annotations: {
  \semio_viz_scf_bars:nnnnn { \l_semio_viz_sc_xa_fp } { \l_semio_viz_sc_xb_fp }
    { \l_semio_viz_sc_ya_fp } { \l_semio_viz_sc_yb_fp - 6 } { \c_false_bool }
  \semio_viz_sc_hue:n { 0 }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none , opacity = 0.2 ,
      points =
        {
          \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_ya_fp
                + ( \l_semio_viz_scf_cut_fp - 1 - \l_semio_viz_scf_lo_fp )
                  / max ( 1e-9 , \l_semio_viz_scf_hi_fp - \l_semio_viz_scf_lo_fp )
                  * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
            } ;
          \fp_to_decimal:N \l_semio_viz_sc_xb_fp ,
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_ya_fp
                + ( \l_semio_viz_scf_cut_fp + 1 - \l_semio_viz_scf_lo_fp )
                  / max ( 1e-9 , \l_semio_viz_scf_hi_fp - \l_semio_viz_scf_lo_fp )
                  * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
            }
        }
    }
  \semio_viz_sc_path:n { reference-band }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      fill = none , stroke = \exp_not:V \l_semio_viz_sc_ink_tl , dash = dashed ,
      points =
        {
          \fp_to_decimal:N \l_semio_viz_sc_xa_fp ,
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_ya_fp
                + ( \l_semio_viz_scf_cut_fp - \l_semio_viz_scf_lo_fp )
                  / max ( 1e-9 , \l_semio_viz_scf_hi_fp - \l_semio_viz_scf_lo_fp )
                  * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
            } ;
          \fp_to_decimal:N \l_semio_viz_sc_xb_fp ,
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_ya_fp
                + ( \l_semio_viz_scf_cut_fp - \l_semio_viz_scf_lo_fp )
                  / max ( 1e-9 , \l_semio_viz_scf_hi_fp - \l_semio_viz_scf_lo_fp )
                  * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
            }
        }
    }
  \semio_viz_sc_path:n { reference-line }
  \tl_set:Nn \l_semio_viz_scf_pick_tl { callout }
  \semio_viz_table_cell:VnVN \l_semio_viz_scf_data_tl { 1 } \l_semio_viz_scf_label_tl
    \l_semio_viz_scf_cell_tl
  \semio_viz_scf_text:nnnV { anchor = west }
    { \l_semio_viz_sc_xa_fp + \l_semio_viz_scf_swatch_fp }
    { \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_scf_swatch_fp }
    \l_semio_viz_scf_cell_tl
}

% 📐 One §78 figure facility, rendered as a catalogue kind.
\cs_new_protected:Npn \semio_viz_scf_render:n #1 {
  \semio_viz_sc_frame:
  \semio_viz_scf_keys_reset:
  \keys_set:nn { semio / viz / family / figure } {#1}
  \semio_viz_scf_load:
  \str_case:VnF \l_semio_viz_scf_variant_tl
    {
      { accessibility-friendly-patterns } { \semio_viz_scf_patterns: }
      { annotations } { \semio_viz_scf_annotations: }
      { clipping } { \semio_viz_scf_clipping: }
      { coordinate-transformations } { \semio_viz_scf_coordinates: }
      { export-safe-typography } { \semio_viz_scf_typography: }
      { faceting } { \semio_viz_scf_faceting: }
      { grayscale-safe-encodings } { \semio_viz_scf_grayscale: }
      { guides }
        {
          \use:x
            {
              \exp_not:N \SemioVizPlot
                [
                  data = \exp_not:V \l_semio_viz_scf_data_tl , mark = bar ,
                  x = \exp_not:V \l_semio_viz_scf_x_tl ,
                  y = \exp_not:V \l_semio_viz_scf_y_tl ,
                  guide = { grid , axis=x , axis=y }
                ]
            }
        }
      { labels } { \semio_viz_scf_labels: }
      { legends }
        {
          \use:x
            {
              \exp_not:N \SemioVizPlot
                [
                  data = \exp_not:V \l_semio_viz_scf_data_tl , mark = point ,
                  x = \exp_not:V \l_semio_viz_scf_x_tl ,
                  y = \exp_not:V \l_semio_viz_scf_y_tl ,
                  fill = \exp_not:V \l_semio_viz_scf_category_tl ,
                  guide = { legend }
                ]
            }
        }
      { responsive-sizing } { \semio_viz_scf_responsive: }
    }
    { \semio_viz_scf_themes: }
  \semio_viz_sc_caption:nn
    { Figure~facility~\l_semio_viz_scf_variant_tl }
    { Abbildungsinfrastruktur~\l_semio_viz_scf_variant_tl }
}

% 🖼️ §78: figure infrastructure, shown as the contrast between one series without it and with it.
\SemioVizFamily{figure}{ \semio_viz_scf_render:n {#1} }
%endregion 🔖️Family-figure

%region 🔖️Keys-grammar
% 🔑 semio / viz / family / grammar — the twenty-three §79 grammar elements as catalogue kinds.
% A kind whose element is a key of the plot grammar renders through `\SemioVizPlot` with exactly
% that key set and nothing else, so the figure is the element and not a picture of it; a kind whose
% element is a stage of the pipeline shows the stage's two sides in one frame.
%   variant   (choice) one §79 grammar slug, default point
%   data      (table)  bound table, default `demo`
%   x         (column) column bound to the horizontal channel, default `cat`
%   y         (column) column bound to the vertical channel, default `val`
%   y2        (column) column bound to the second quantitative channel, default `val2`
%   category  (column) column bound to the qualitative channel, default `grp`
%   label     (column) column supplying node and mark text, default `label`
%   bins      (int)    bins the transform kind cuts its column into, default 4
%   samples   (int)    samples the functional kind evaluates, default 24
%   corners   (int)    corners the first shape of the shape kind carries, default 3
%   swatch    (fp)     edge length of one grammar swatch in millimetres, default 6
%   marks     (clist)  primitives the mark kind enumerates, default dot,straight-line,band,sector,
%                      straight-connector,rectangular-region,label
\tl_new:N \l_semio_viz_scg_variant_tl
\tl_new:N \l_semio_viz_scg_data_tl
\tl_new:N \l_semio_viz_scg_x_tl
\tl_new:N \l_semio_viz_scg_y_tl
\tl_new:N \l_semio_viz_scg_y_two_tl
\tl_new:N \l_semio_viz_scg_category_tl
\tl_new:N \l_semio_viz_scg_label_tl
\int_new:N \l_semio_viz_scg_bins_int
\int_new:N \l_semio_viz_scg_samples_int
\int_new:N \l_semio_viz_scg_corners_int
\fp_new:N \l_semio_viz_scg_swatch_fp
\clist_new:N \l_semio_viz_scg_marks_clist
\int_new:N \l_semio_viz_scg_n_int
\int_new:N \l_semio_viz_scg_i_int
\fp_new:N \l_semio_viz_scg_step_fp
\fp_new:N \l_semio_viz_scg_cx_fp
\fp_new:N \l_semio_viz_scg_cy_fp
\fp_new:N \l_semio_viz_scg_lo_fp
\fp_new:N \l_semio_viz_scg_hi_fp
\tl_new:N \l_semio_viz_scg_pick_tl
\tl_new:N \l_semio_viz_scg_cell_tl
\tl_new:N \l_semio_viz_scg_points_tl

\keys_define:nn { semio / viz / family / grammar } {
  variant .tl_set:N = \l_semio_viz_scg_variant_tl,
  data .tl_set:N = \l_semio_viz_scg_data_tl,
  x .tl_set:N = \l_semio_viz_scg_x_tl,
  y .tl_set:N = \l_semio_viz_scg_y_tl,
  y2 .tl_set:N = \l_semio_viz_scg_y_two_tl,
  category .tl_set:N = \l_semio_viz_scg_category_tl,
  label .tl_set:N = \l_semio_viz_scg_label_tl,
  bins .int_set:N = \l_semio_viz_scg_bins_int,
  samples .int_set:N = \l_semio_viz_scg_samples_int,
  corners .int_set:N = \l_semio_viz_scg_corners_int,
  swatch .fp_set:N = \l_semio_viz_scg_swatch_fp,
  marks .clist_set:N = \l_semio_viz_scg_marks_clist,
}

% 🧹 Restores every grammar key to its documented default before a kind reads its options.
\cs_new_protected:Npn \semio_viz_scg_keys_reset: {
  \tl_set:Nn \l_semio_viz_scg_variant_tl { point }
  \tl_set:Nn \l_semio_viz_scg_data_tl { demo }
  \tl_set:Nn \l_semio_viz_scg_x_tl { cat }
  \tl_set:Nn \l_semio_viz_scg_y_tl { val }
  \tl_set:Nn \l_semio_viz_scg_y_two_tl { val2 }
  \tl_set:Nn \l_semio_viz_scg_category_tl { grp }
  \tl_set:Nn \l_semio_viz_scg_label_tl { label }
  \int_set:Nn \l_semio_viz_scg_bins_int { 4 }
  \int_set:Nn \l_semio_viz_scg_samples_int { 24 }
  \int_set:Nn \l_semio_viz_scg_corners_int { 3 }
  \fp_set:Nn \l_semio_viz_scg_swatch_fp { 6 }
  \clist_set:Nn \l_semio_viz_scg_marks_clist
    {
      dot , straight-line , band , sector , straight-connector ,
      rectangular-region , label
    }
}
%endregion 🔖️Keys-grammar

%region 🔖️Family-grammar
% 📈 Runs the plot grammar over the family's own table with the element under demonstration.
\cs_new_protected:Npn \semio_viz_scg_plot:n #1 {
  \use:x
    { \exp_not:N \SemioVizPlot [ data = \exp_not:V \l_semio_viz_scg_data_tl , #1 ] }
}

% 🔢 The bound table's row count and the frame metrics every hand-drawn element reads.
\cs_new_protected:Npn \semio_viz_scg_load: {
  \semio_viz_table_nrows:VN \l_semio_viz_scg_data_tl \l_semio_viz_scg_n_int
  \semio_viz_table_col_min:VVN \l_semio_viz_scg_data_tl \l_semio_viz_scg_y_tl
    \l_semio_viz_scg_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_scg_data_tl \l_semio_viz_scg_y_tl
    \l_semio_viz_scg_hi_fp
  \fp_set:Nn \l_semio_viz_scg_step_fp
    { ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / max ( 1 , \l_semio_viz_scg_n_int ) }
  \fp_set:Nn \l_semio_viz_scg_cx_fp
    { ( \l_semio_viz_sc_xa_fp + \l_semio_viz_sc_xb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_scg_cy_fp
    { ( \l_semio_viz_sc_ya_fp + \l_semio_viz_sc_yb_fp ) / 2 - 2 }
}

% 🧾 Cell (row #1, column #2) of the bound table.
\cs_new_protected:Npn \semio_viz_scg_cell:nN #1#2 {
  \semio_viz_table_cell:VnVN \l_semio_viz_scg_data_tl {#1} #2 \l_semio_viz_scg_cell_tl
}

% 📇 The grammar's data stage: the bound table drawn as the record grid it actually is.
\cs_new_protected:Npn \semio_viz_scg_tabular: {
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \int_step_inline:nn { 3 }
        {
          \tl_set:Nx \l_semio_viz_sc_opts_tl
            {
              fill = none , stroke = \exp_not:V \l_semio_viz_sc_rule_tl
            }
          \semio_viz_sc_rect:nnnn
            {
              \l_semio_viz_sc_xa_fp
                + ( ####1 - 0.5 ) * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / 3
            }
            {
              \l_semio_viz_sc_yb_fp - 6
                - ( ##1 - 0.5 ) * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
                  / \l_semio_viz_scg_n_int
            }
            { ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / 3 * 0.9 }
            {
              ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
                / \l_semio_viz_scg_n_int * 0.8
            }
        }
    }
}

% 📊 The grammar's tabular data kind: every row of the bound table as one plotted record.
\cs_new_protected:Npn \semio_viz_scg_records: {
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \semio_viz_scg_cell:nN {##1} \l_semio_viz_scg_y_tl
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none ,
          size = \fp_to_decimal:n { \l_semio_viz_scg_swatch_fp * \l_semio_viz_scg_swatch_fp / 2 }
        }
      \semio_viz_sc_mark:nnn { dot }
        {
          \l_semio_viz_sc_xa_fp + ( ##1 - 0.5 ) * \l_semio_viz_scg_step_fp
        }
        {
          \l_semio_viz_sc_ya_fp
            + ( \l_semio_viz_scg_cell_tl - \l_semio_viz_scg_lo_fp )
              / max ( 1e-9 , \l_semio_viz_scg_hi_fp - \l_semio_viz_scg_lo_fp )
              * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
        }
    }
}

% 🌳 The grammar's hierarchical data kind: the category column read as the parent of every row.
\cs_new_protected:Npn \semio_viz_scg_hierarchical: {
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl ,
          points =
            {
              \fp_to_decimal:N \l_semio_viz_scg_cx_fp ,
              \fp_to_decimal:n { \l_semio_viz_sc_yb_fp - 6 } ;
              \fp_to_decimal:n
                { \l_semio_viz_sc_xa_fp + ( ##1 - 0.5 ) * \l_semio_viz_scg_step_fp } ,
              \fp_to_decimal:N \l_semio_viz_sc_ya_fp
            }
        }
      \semio_viz_sc_path:n { elbow-connector }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none ,
          size = \fp_to_decimal:n { \l_semio_viz_scg_swatch_fp * \l_semio_viz_scg_swatch_fp / 2 }
        }
      \semio_viz_sc_mark:nnn { square }
        { \l_semio_viz_sc_xa_fp + ( ##1 - 0.5 ) * \l_semio_viz_scg_step_fp }
        { \l_semio_viz_sc_ya_fp }
    }
}

% 🕸️ The grammar's relational data kind: the source and target columns read as edges of a ring.
\cs_new_protected:Npn \semio_viz_scg_network: {
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl ,
          points =
            {
              \fp_to_decimal:n
                {
                  \l_semio_viz_scg_cx_fp
                    + \l_semio_viz_scg_swatch_fp * 2
                      * cosd ( 360 * ( ##1 - 1 ) / \l_semio_viz_scg_n_int )
                } ,
              \fp_to_decimal:n
                {
                  \l_semio_viz_scg_cy_fp
                    + \l_semio_viz_scg_swatch_fp * 2
                      * sind ( 360 * ( ##1 - 1 ) / \l_semio_viz_scg_n_int )
                } ;
              \fp_to_decimal:n
                {
                  \l_semio_viz_scg_cx_fp
                    + \l_semio_viz_scg_swatch_fp * 2
                      * cosd ( 360 * ( ##1 + 1 ) / \l_semio_viz_scg_n_int )
                } ,
              \fp_to_decimal:n
                {
                  \l_semio_viz_scg_cy_fp
                    + \l_semio_viz_scg_swatch_fp * 2
                      * sind ( 360 * ( ##1 + 1 ) / \l_semio_viz_scg_n_int )
                }
            }
        }
      \semio_viz_sc_path:n { curved-connector }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none ,
          size = \fp_to_decimal:n { \l_semio_viz_scg_swatch_fp }
        }
      \semio_viz_sc_mark:nnn { dot }
        {
          \l_semio_viz_scg_cx_fp
            + \l_semio_viz_scg_swatch_fp * 2
              * cosd ( 360 * ( ##1 - 1 ) / \l_semio_viz_scg_n_int )
        }
        {
          \l_semio_viz_scg_cy_fp
            + \l_semio_viz_scg_swatch_fp * 2
              * sind ( 360 * ( ##1 - 1 ) / \l_semio_viz_scg_n_int )
        }
    }
}

% ➰ The grammar's functional data kind: a sampled expression rather than a stored row set.
\cs_new_protected:Npn \semio_viz_scg_functional: {
  \tl_clear:N \l_semio_viz_scg_points_tl
  \int_step_inline:nn { \l_semio_viz_scg_samples_int }
    {
      \tl_put_right:Nx \l_semio_viz_scg_points_tl
        {
          \tl_if_empty:NF \l_semio_viz_scg_points_tl { ; }
          \fp_to_decimal:n
            {
              \l_semio_viz_sc_xa_fp
                + ( ##1 - 1 ) * ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp )
                  / max ( 1 , \l_semio_viz_scg_samples_int - 1 )
            } ,
          \fp_to_decimal:n
            {
              \l_semio_viz_scg_cy_fp
                + ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_scg_cy_fp )
                  * sind ( 360 * ( ##1 - 1 ) / max ( 1 , \l_semio_viz_scg_samples_int - 1 ) )
            }
        }
    }
  \semio_viz_sc_hue:n { 0 }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl ,
      points = { \exp_not:V \l_semio_viz_scg_points_tl }
    }
  \semio_viz_sc_path:n { polyline }
}

% 🖼️ The grammar's image data kind: an extent reserved for raster content the grammar does not draw.
\cs_new_protected:Npn \semio_viz_scg_image: {
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    { fill = none , stroke = \exp_not:V \l_semio_viz_sc_rule_tl , dash = dashed }
  \semio_viz_sc_rect:nnnn { \l_semio_viz_scg_cx_fp } { \l_semio_viz_scg_cy_fp }
    { ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / 2 }
    { ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp ) / 2 }
  \semio_viz_sc_hue:n { 0 }
  \tl_set:Nx \l_semio_viz_sc_opts_tl
    {
      fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl ,
      points =
        {
          \fp_to_decimal:n
            { \l_semio_viz_scg_cx_fp - ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / 4 } ,
          \fp_to_decimal:n
            { \l_semio_viz_scg_cy_fp
              - ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp ) / 4 } ;
          \fp_to_decimal:n
            { \l_semio_viz_scg_cx_fp + ( \l_semio_viz_sc_xb_fp - \l_semio_viz_sc_xa_fp ) / 4 } ,
          \fp_to_decimal:n
            { \l_semio_viz_scg_cy_fp
              + ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp ) / 4 }
        }
    }
  \semio_viz_sc_path:n { straight-line }
}

% ⚫ The grammar's mark stage: one representative of every §0 mark family, side by side.
\cs_new_protected:Npn \semio_viz_scg_marks: {
  \int_zero:N \l_semio_viz_scg_i_int
  \clist_map_inline:Nn \l_semio_viz_scg_marks_clist
    {
      \int_incr:N \l_semio_viz_scg_i_int
      \semio_viz_sc_hue:n { \l_semio_viz_scg_i_int - 1 }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = \exp_not:V \l_semio_viz_sc_hue_tl ,
          stroke = \exp_not:V \l_semio_viz_sc_hue_tl ,
          size = \fp_to_decimal:n { \l_semio_viz_scg_swatch_fp * \l_semio_viz_scg_swatch_fp } ,
          radius = \fp_to_decimal:n { \l_semio_viz_scg_swatch_fp / 2 } ,
          points =
            {
              \fp_to_decimal:n
                {
                  \l_semio_viz_sc_xa_fp
                    + ( \l_semio_viz_scg_i_int - 1 ) * ( \l_semio_viz_sc_xb_fp
                      - \l_semio_viz_sc_xa_fp ) / \clist_count:N \l_semio_viz_scg_marks_clist
                } ,
              \fp_to_decimal:N \l_semio_viz_sc_ya_fp ;
              \fp_to_decimal:n
                {
                  \l_semio_viz_sc_xa_fp
                    + ( \l_semio_viz_scg_i_int - 0.4 ) * ( \l_semio_viz_sc_xb_fp
                      - \l_semio_viz_sc_xa_fp ) / \clist_count:N \l_semio_viz_scg_marks_clist
                } ,
              \fp_to_decimal:n { \l_semio_viz_sc_yb_fp - 6 }
            }
        }
      \semio_viz_sc_mark:nnn {##1}
        {
          \l_semio_viz_sc_xa_fp
            + ( \l_semio_viz_scg_i_int - 0.5 ) * ( \l_semio_viz_sc_xb_fp
              - \l_semio_viz_sc_xa_fp ) / \clist_count:N \l_semio_viz_scg_marks_clist
        }
        { \l_semio_viz_scg_cy_fp }
    }
}

% 🔺 The grammar's shape stage: the same area spent on a growing number of corners.
\cs_new_protected:Npn \semio_viz_scg_shapes: {
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \semio_viz_sce_rotor:nnnnn
        { \l_semio_viz_sc_xa_fp + ( ##1 - 0.5 ) * \l_semio_viz_scg_step_fp }
        { \l_semio_viz_scg_cy_fp }
        { \l_semio_viz_scg_swatch_fp } { \l_semio_viz_scg_corners_int + ##1 - 1 } { 90 }
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = \exp_not:V \l_semio_viz_sc_hue_tl , stroke = none ,
          points = { \exp_not:V \l_semio_viz_sce_points_tl }
        }
      \semio_viz_sc_path:n { polygon }
    }
}

% 🔗 The grammar's link stage: consecutive records joined by the connector the grammar names.
\cs_new_protected:Npn \semio_viz_scg_links: {
  \int_step_inline:nn { \l_semio_viz_scg_n_int - 1 }
    {
      \semio_viz_sc_hue:n { ##1 - 1 }
      \semio_viz_scg_cell:nN {##1} \l_semio_viz_scg_y_tl
      \tl_set:Nx \l_semio_viz_sc_opts_tl
        {
          fill = none , stroke = \exp_not:V \l_semio_viz_sc_hue_tl ,
          points =
            {
              \fp_to_decimal:n
                { \l_semio_viz_sc_xa_fp + ( ##1 - 0.5 ) * \l_semio_viz_scg_step_fp } ,
              \fp_to_decimal:n
                {
                  \l_semio_viz_sc_ya_fp
                    + ( \l_semio_viz_scg_cell_tl - \l_semio_viz_scg_lo_fp )
                      / max ( 1e-9 , \l_semio_viz_scg_hi_fp - \l_semio_viz_scg_lo_fp )
                      * ( \l_semio_viz_sc_yb_fp - 6 - \l_semio_viz_sc_ya_fp )
                } ;
              \fp_to_decimal:n
                { \l_semio_viz_sc_xa_fp + ( ##1 + 0.5 ) * \l_semio_viz_scg_step_fp } ,
              \fp_to_decimal:n { \l_semio_viz_sc_yb_fp - 6 }
            }
        }
      \semio_viz_sc_path:n { bundled-connector }
    }
}

% 🔠 The grammar's text stage: every record carrying its own label at its own place.
\cs_new_protected:Npn \semio_viz_scg_texts: {
  \int_step_inline:nn { \l_semio_viz_scg_n_int }
    {
