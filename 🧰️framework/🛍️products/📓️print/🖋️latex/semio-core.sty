% 🪆 Composed identifiers nest one separator only — "." between every level,
% whether appendix→chapter (BB.M), heading→window slot (H.a), or
% chapter→subsection (SB.B.1) — and every level but the last renders muted.
% \l_tmpa_int is set to the character count of everything up to & including
% the *last* "." (0 if there is none); the muted head and bright tail are
% then sliced out of \l_tmpa_tl by that offset.
\cs_new_protected:Npn \semio_identifier_split_point:n #1 {
  \tl_set:Nn \l_tmpa_tl {#1}
  \seq_set_split:Nnn \l_tmpb_seq { . } {#1}
  \seq_pop_right:NN \l_tmpb_seq \l_tmpb_tl
  \int_set:Nn \l_tmpa_int { \tl_count:N \l_tmpa_tl - \tl_count:N \l_tmpb_tl }
}
% 🔗 Single choke point for every hierarchy key chip (heading pairs, window and
% table headers, nested paragraphs), hence the single place that turns the key
% into a jump to its Inhaltsverzeichnis line — see the TocLineLinks region.
% #1 always arrives fully expanded (\exp_args:Ne at both call sites), so the
% number doubles as the anchor key.
\cs_new_protected:Npn \semio_hierarchy_chip_number:n #1 {
  \semio@tocline@link {#1} {
    \semio_identifier_split_point:n {#1}
    \int_compare:nNnF \l_tmpa_int = \c_zero_int {
      \textcolor { semio-chrome-text-normal } { \tl_range:Nnn \l_tmpa_tl { 1 } { \l_tmpa_int } }
    }
    \textcolor { semio-chrome-foreground } { \tl_range:Nnn \l_tmpa_tl { \l_tmpa_int + 1 } { -1 } }
  }
}
\cs_new_protected:Npn \semio_toc_number:n #1 {
  \semio_identifier_split_point:n {#1}
  \int_compare:nNnF \l_tmpa_int = \c_zero_int {
    \textcolor { semio-chrome-panel } { \tl_range:Nnn \l_tmpa_tl { 1 } { \l_tmpa_int } }
  }
  \textcolor { semio-chrome-text-normal } { \tl_range:Nnn \l_tmpa_tl { \l_tmpa_int + 1 } { -1 } }
}
