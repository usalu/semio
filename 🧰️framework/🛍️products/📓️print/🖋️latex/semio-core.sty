\newcommand{\semio@heading@kind@number}[2]{%
  \semio@kind@number@bare{\csname the#2\endcsname}%
}

\newcommand{\semio@window@kind@number}[1]{%
  \refstepcounter{semio@window@slot}%
  \if\relax\detokenize\expandafter{\semio@hierarchy@path}\relax
    \semio@kind@number{\csname semio@window@#1@kind\endcsname}{\alph{semio@window@slot}}%
  \else
    \semio@kind@number{\csname semio@window@#1@kind\endcsname}{\semio@hierarchy@path.\alph{semio@window@slot}}%
  \fi
}

\newcommand{\semio@hierarchy@path}{}
\newcommand{\semio@hierarchy@path@set}[1]{%
  \def\semio@hierarchy@path@next{#1}%
  \ifx\semio@hierarchy@path\semio@hierarchy@path@next\else
    \xdef\semio@hierarchy@path{#1}%
    \setcounter{semio@window@slot}{0}%
  \fi
}

\newcommand{\semio@hierarchy@hooks@install}{%
  \AddToHook{cmd/maketableofcontents/before}{\semio@heading@chips@disable}%
  \AddToHook{cmd/maketableofcontents/after}{\semio@heading@chips@enable}%
  \AddToHook{cmd/tableofcontents/before}{\semio@heading@chips@disable}%
  \AddToHook{cmd/tableofcontents/after}{\semio@heading@chips@enable}%
}

\newcommand{\semio@register@hooks@install}[1]{%
  \AddToHook{cmd/#1/before}{\semio@heading@chips@disable}%
  \AddToHook{cmd/#1/after}{\semio@heading@chips@enable}%
}

\newskip\semio@block@sep@skip
\setlength{\semio@block@sep@skip}{0.2em}
% 🧱 Single choke point for inter-element gaps: every block emits exactly one
% max-merging \addvspace{unit} before itself and nothing after; \parskip
% (set to the same unit in \AfterEndPreamble) supplies the gap wherever a
% paragraph is the next element, so paragraph<->paragraph, paragraph<->block,
% and block<->block junctions all land on exactly one unit. \addvspace tops
% any residual glue instead of summing, and vanishes on an empty vlist
% (\lastnodetype=-1), so blocks sit flush at the top of a page.
\newcommand{\semio@block@before}{%
  \ifhmode\par\fi
  \ifnum\lastnodetype=-1 \else\addvspace{\semio@block@sep@skip}\fi
}
\newcommand{\semio@block@after}{\ifhmode\par\fi\nobreak}
% \noindent must precede the following material in the same paragraph. A
% grouped \noindent ends before the chip/header row and leaves \parindent in
% effect (measured: title-chip L inset from the table outer L).
\newcommand{\semio@noindent@noparskip}{\parskip\z@\noindent}
\newcommand{\SemioSpacingUnit}{\semio@spacing@single}
\newcommand{\SemioSpacingDouble}{\semio@spacing@double}
\makeatother
