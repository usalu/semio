%region TocLineLinks
% 🔗 Back-link from a hierarchy key chip to its own line in the
% Inhaltsverzeichnis — the mirror image of \semio@toc@link (semio-table.sty),
% which links a TOC line forward to its section anchor.
%
% The two halves are keyed by the hierarchy number itself ("1.2.3", "BB.M") and
% nothing else: a heading chip is typeset long before (or long after) the TOC
% body exists, so it cannot know the TOC's own \label names — but it always
% knows its number. \semio@tocline@anchor drops the destination on the TOC row;
% \semio@tocline@link resolves it from the .aux on the next pass. Both spell the
% `semio-tocline-` prefix literally, exactly like the `semio-toc-` /
% `semio-register-` label prefixes elsewhere.
\newcommand{\semio@tocline@anchor}[1]{%
  \ifcsname semio@tocline@seen@#1\endcsname\else
    \expandafter\gdef\csname semio@tocline@seen@#1\endcsname{}%
    \phantomsection\label{semio-tocline-#1}%
  \fi
}
% 🔗 Wraps chip content #2 in a jump to the TOC line for number #1 when that
% line exists. Numbers with no TOC row at all (window slots like "1.2.a", and
% every number on the first compile pass) fall through to plain content, so the
% chip never emits a dangling destination. Robust on purpose: project cards
% stash their key chip in a macro through \protected@edef and hand it on
% through a further \edef before it is ever typeset.
\NewDocumentCommand \semio@tocline@link { m m } {%
  \ifcsname r@semio-tocline-#1\endcsname
    \hyperref[semio-tocline-#1]{#2}%
  \else
    #2%
  \fi
}
%endregion TocLineLinks

