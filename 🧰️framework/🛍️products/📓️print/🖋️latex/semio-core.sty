%region Hyphenation Safety
% 🪢 TeX only hyphenates a run of letters that is itself preceded by glue;
% a slash-joined compound like "Wand-/Scheibenelement" breaks cleanly at the
% literal hyphen but leaves "/Scheibenelement" with no glue in front of it,
% so pattern hyphenation never resumes and the remainder overflows narrow
% table columns. \SemioSlash inserts the missing zero-width glue right after
% the slash so the following word hyphenates normally again.
\newcommand{\SemioSlash}{/\hspace{0pt}}
% 🪢 Same hazard for a hyphen-joined compound ("Plattenbau-Massenwohnbau"): TeX
% breaks at the literal hyphen but never hyphenates the tail, which then runs out
% of a narrow column. \SemioDash restores the glue after the hyphen.
\newcommand{\SemioDash}{-\hspace{0pt}}
%endregion Hyphenation Safety

