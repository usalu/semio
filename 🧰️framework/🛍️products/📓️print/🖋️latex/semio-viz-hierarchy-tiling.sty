\fp_new:N \l_semio_viz_hierarchy_tm_ya_fp
\fp_new:N \l_semio_viz_hierarchy_tm_xb_fp
\fp_new:N \l_semio_viz_hierarchy_tm_yb_fp
\fp_new:N \l_semio_viz_hierarchy_tm_p_fp
\fp_new:N \l_semio_viz_hierarchy_tm_k_fp
\fp_new:N \l_semio_viz_hierarchy_tm_cursor_fp
\fp_new:N \l_semio_viz_hierarchy_tm_value_fp
\fp_new:N \l_semio_viz_hierarchy_tm_sum_fp
\fp_new:N \l_semio_viz_hierarchy_tm_node_fp
\fp_new:N \l_semio_viz_hierarchy_tm_min_fp
\fp_new:N \l_semio_viz_hierarchy_tm_max_fp
\fp_new:N \l_semio_viz_hierarchy_tm_alpha_fp
\fp_new:N \l_semio_viz_hierarchy_tm_beta_fp
\fp_new:N \l_semio_viz_hierarchy_tm_ratio_fp
\fp_new:N \l_semio_viz_hierarchy_tm_new_fp
\fp_new:N \l_semio_viz_hierarchy_tm_dx_fp
\fp_new:N \l_semio_viz_hierarchy_tm_dy_fp
\fp_new:N \l_semio_viz_hierarchy_tm_edge_fp
\int_new:N \l_semio_viz_hierarchy_tm_ia_int
\int_new:N \l_semio_viz_hierarchy_tm_ib_int
\int_new:N \l_semio_viz_hierarchy_tm_n_int
\int_new:N \l_semio_viz_hierarchy_tm_bk_int
\int_new:N \l_semio_viz_hierarchy_tm_bhi_int
