  \tl_set:Nn \l_semio_viz_dg_col_shape_tl { shape }
  \tl_set:Nn \l_semio_viz_dg_col_row_tl { row }
  \tl_set:Nn \l_semio_viz_dg_col_col_tl { col }
  \tl_set:Nn \l_semio_viz_dg_col_lane_tl { lane }
  \tl_set:Nn \l_semio_viz_dg_col_group_tl { group }
  \tl_set:Nn \l_semio_viz_dg_col_tone_tl { tone }
  \tl_set:Nn \l_semio_viz_dg_col_source_tl { from }
  \tl_set:Nn \l_semio_viz_dg_col_target_tl { to }
  \tl_set:Nn \l_semio_viz_dg_col_edgelabel_tl { label }
  \tl_set:Nn \l_semio_viz_dg_col_edgekind_tl { kind }
  \tl_set:Nn \l_semio_viz_dg_direction_tl { down }
  \tl_set:Nn \l_semio_viz_dg_routing_tl { orthogonal }
  \tl_set:Nn \l_semio_viz_dg_arrow_tl { to }
  \tl_set:Nn \l_semio_viz_dg_shape_tl { process }
  \tl_set:Nn \l_semio_viz_dg_lanemode_tl { none }
  \tl_clear:N \l_semio_viz_dg_lanetitle_tl
  \tl_clear:N \l_semio_viz_dg_legend_tl
  \tl_clear:N \l_semio_viz_dg_title_tl
  \bool_set_false:N \l_semio_viz_dg_frame_bool
  \bool_set_false:N \l_semio_viz_dg_groups_bool
  \bool_set_true:N \l_semio_viz_dg_labels_bool
  \bool_set_true:N \l_semio_viz_dg_autosize_bool
  \fp_set:Nn \l_semio_viz_dg_colgap_fp { 4 }
  \fp_set:Nn \l_semio_viz_dg_rowgap_fp { 4 }
  \fp_set:Nn \l_semio_viz_dg_pad_fp { 3 }
  \fp_set:Nn \l_semio_viz_dg_bend_fp { 22 }
  \fp_set:Nn \l_semio_viz_dg_nw_fp { 22 }
  \fp_set:Nn \l_semio_viz_dg_nh_fp { 9 }
