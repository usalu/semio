%region 🔖️Chrome
% 🎨 Categorical colour of a diagram lane, group or tone column. Lanes and swimlanes are
%    numbered from one in the data, the theme's categorical slots from zero.
\tl_new:N \l_semio_viz_dg_hue_tl
\cs_new_protected:Npn \semio_viz_dg_hue:nN #1#2
  { \semio_viz_theme_color:nN { \int_eval:n { (#1) - 1 } } #2 }
%endregion 🔖️Chrome

%region 🔖️Words
% 🔤 Splits the space-separated words of the token list #2 into the sequence #1.
%    A space is not usable as an l3seq split delimiter (items are space-trimmed), so the words
%    become comma-list items first.
\tl_new:N \l_semio_viz_dg_words_tl
\clist_new:N \l_semio_viz_dg_words_clist
\cs_new_protected:Npn \semio_viz_dg_words:NN #1#2 {
  \tl_set_eq:NN \l_semio_viz_dg_words_tl #2
  \tl_replace_all:Nnn \l_semio_viz_dg_words_tl { ~ } { , }
  \clist_set:NV \l_semio_viz_dg_words_clist \l_semio_viz_dg_words_tl
  \seq_set_from_clist:NN #1 \l_semio_viz_dg_words_clist
}
%endregion 🔖️Words

% 🔑 Node record accessors: a record is `cx,cy,w,h,shape,tone`.
\cs_new_protected:Npn \semio_viz_dg_get:n #1 {
  \tl_set:Nx \l_semio_viz_dg_key_tl {#1}
  \prop_get:NVNTF \l_semio_viz_dg_node_prop \l_semio_viz_dg_key_tl \l_semio_viz_dg_rec_tl
    {
      \fp_set:Nn \l_semio_viz_dg_a_fp { \clist_item:Nn \l_semio_viz_dg_rec_tl { 1 } }
      \fp_set:Nn \l_semio_viz_dg_b_fp { \clist_item:Nn \l_semio_viz_dg_rec_tl { 2 } }
      \fp_set:Nn \l_semio_viz_dg_c_fp { \clist_item:Nn \l_semio_viz_dg_rec_tl { 3 } }
      \fp_set:Nn \l_semio_viz_dg_d_fp { \clist_item:Nn \l_semio_viz_dg_rec_tl { 4 } }
    }
    { \msg_warning:nnx { semio-viz } { diagram-unknown-node } { \l_semio_viz_dg_key_tl } \tl_clear:N \l_semio_viz_dg_rec_tl }
}
