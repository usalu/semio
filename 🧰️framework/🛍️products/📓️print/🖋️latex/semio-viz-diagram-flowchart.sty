% 🚦 Fault-tree logic gate #1: `and` is a flat-based dome, `or` a curved shield, `xor` an `or` with the base chord redrawn.
\cs_new_protected:Npn \semio_viz_dg_gate:n #1 {
  \str_case:nn {#1} {
    { and } {
      \draw [ \l_semio_viz_dg_draw_tl , fill=\l_semio_viz_dg_fill_tl , line~width=\semio@stroke@hairline ]
        ( \fp_eval:n { \l_semio_viz_dg_x_fp - \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } ) --
        ( \fp_eval:n { \l_semio_viz_dg_x_fp - \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp } )
        arc [ start~angle=180, end~angle=0, x~radius=\fp_eval:n { \l_semio_viz_dg_hw_fp } , y~radius=\fp_eval:n { \l_semio_viz_dg_hh_fp } ] --
        ( \fp_eval:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } ) -- cycle ;
    }
    { or } {
      \draw [ \l_semio_viz_dg_draw_tl , fill=\l_semio_viz_dg_fill_tl , line~width=\semio@stroke@hairline ]
        ( \fp_eval:n { \l_semio_viz_dg_x_fp - \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } ) ..
        controls ( \fp_eval:n { \l_semio_viz_dg_x_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp + 1.6 } ) and
                 ( \fp_eval:n { \l_semio_viz_dg_x_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp + 1.6 } ) ..
        ( \fp_eval:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } ) ..
        controls ( \fp_eval:n { \l_semio_viz_dg_x_fp + 0.6 * \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp + \l_semio_viz_dg_hh_fp } ) and
                 ( \fp_eval:n { \l_semio_viz_dg_x_fp - 0.6 * \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp + \l_semio_viz_dg_hh_fp } ) ..
        cycle ;
    }
    { xor } {
      \semio_viz_dg_gate:n { or }
      \draw [ \l_semio_viz_dg_draw_tl , line~width=\semio@stroke@hairline ]
        ( \fp_eval:n { \l_semio_viz_dg_x_fp - \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } ) --
        ( \fp_eval:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } ) ;
    }
  }
}
