%region 🔖️Keys
% 🗝️ Kernel option vocabulary shared by every diagram family.
%   nodes/edges     tl    table names holding the node rows and the edge rows
%   id/label/shape/row/col/lane/group/tone   tl   node table column names
%   source/target/edge-label/edge-kind       tl   edge table column names
%   direction       choice down|right   primary growth axis of the grid (default down)
%   node-width/node-height  tl   millimetres, or `auto` to fill the frame (default auto)
%   col-gap/row-gap fp    millimetres between grid cells (default 6 / 6)
%   pad             fp    millimetre inset of the grid inside the frame (default 3)
%   routing         choice orthogonal|straight|curved  (default orthogonal)
%   bend            fp    degrees of bend used by routing=curved (default 22)
%   arrow           choice to|from|both|none  (default to)
%   default-shape   tl    shape used when a node row carries none (default process)
%   lanes           choice none|row|column   lane bands drawn behind the grid (default none)
%   lane-title      tl    en/de separated by `//`, empty for no header text
%   legend          tl    `label=token` entries, comma separated, empty for no legend
%   frame           bool  draw the diagram bounding frame (default false)
%   groups          bool  dashed frame around each distinct value of the group column (default false)
%   labels          bool  draw node label text (default true)
%   title           tl    optional caption drawn above the diagram
%   width/height    fp    frame size override in millimetres
\keys_define:nn { semio / viz / diagram } {
  % 📊 The catalogue binds every chart kind's table as `data=`; a diagram reads its nodes from it.
  % An explicit `nodes=` later in the same option list still wins, which is how a two-table
  % diagram names its node and edge tables separately.
  data         .tl_set:N = \l_semio_viz_dg_nodes_tl,
  % 🏷️ The catalogue slug of the chart kind, so a family can tell its presets apart.
  variant      .tl_set:N = \l_semio_viz_dg_variant_tl,
  nodes        .tl_set:N = \l_semio_viz_dg_nodes_tl,
  edges        .tl_set:N = \l_semio_viz_dg_edges_tl,
  id           .tl_set:N = \l_semio_viz_dg_col_id_tl,
  label        .tl_set:N = \l_semio_viz_dg_col_label_tl,
  shape        .tl_set:N = \l_semio_viz_dg_col_shape_tl,
  row          .tl_set:N = \l_semio_viz_dg_col_row_tl,
  col          .tl_set:N = \l_semio_viz_dg_col_col_tl,
  lane         .tl_set:N = \l_semio_viz_dg_col_lane_tl,
  group        .tl_set:N = \l_semio_viz_dg_col_group_tl,
  tone         .tl_set:N = \l_semio_viz_dg_col_tone_tl,
  source       .tl_set:N = \l_semio_viz_dg_col_source_tl,
  target       .tl_set:N = \l_semio_viz_dg_col_target_tl,
  edge-label   .tl_set:N = \l_semio_viz_dg_col_edgelabel_tl,
  edge-kind    .tl_set:N = \l_semio_viz_dg_col_edgekind_tl,
  direction    .tl_set:N = \l_semio_viz_dg_direction_tl,
  node-width   .code:n = { \str_if_eq:nnTF {#1} { auto } { \bool_set_true:N \l_semio_viz_dg_autosize_bool } { \bool_set_false:N \l_semio_viz_dg_autosize_bool \fp_set:Nn \l_semio_viz_dg_nw_fp {#1} } },
  node-height  .code:n = { \str_if_eq:nnF {#1} { auto } { \fp_set:Nn \l_semio_viz_dg_nh_fp {#1} } },
  col-gap      .fp_set:N = \l_semio_viz_dg_colgap_fp,
  row-gap      .fp_set:N = \l_semio_viz_dg_rowgap_fp,
  pad          .fp_set:N = \l_semio_viz_dg_pad_fp,
  routing      .tl_set:N = \l_semio_viz_dg_routing_tl,
  bend         .fp_set:N = \l_semio_viz_dg_bend_fp,
  arrow        .tl_set:N = \l_semio_viz_dg_arrow_tl,
  default-shape .tl_set:N = \l_semio_viz_dg_shape_tl,
  lanes        .tl_set:N = \l_semio_viz_dg_lanemode_tl,
  lane-title   .tl_set:N = \l_semio_viz_dg_lanetitle_tl,
  legend       .tl_set:N = \l_semio_viz_dg_legend_tl,
  frame        .bool_set:N = \l_semio_viz_dg_frame_bool,
  groups       .bool_set:N = \l_semio_viz_dg_groups_bool,
  labels       .bool_set:N = \l_semio_viz_dg_labels_bool,
  title        .tl_set:N = \l_semio_viz_dg_title_tl,
  width        .fp_set:N = \l_semio_viz_dg_w_fp,
  height       .fp_set:N = \l_semio_viz_dg_h_fp,
}

