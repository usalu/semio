    { \fp_set_eq:NN \l_semio_viz_dg_h_fp \l_semio_viz_height_fp }
    { \fp_set_eq:NN \l_semio_viz_dg_h_fp \c_semio_viz_theme_frame_height_fp }
}

% 🗝️ Applies a family option list on top of the defaults.
\cs_new_protected:Npn \semio_viz_dg_keys:n #1 { \keys_set:nn { semio / viz / diagram } {#1} }
%endregion 🔖️Keys

%region 🔖️Layout
% 🧮 Reads the node table, assigns grid coordinates and records each node as `cx,cy,w,h,shape,tone`.
\cs_new_protected:Npn \semio_viz_dg_layout: {
  \prop_clear:N \l_semio_viz_dg_node_prop
  \prop_clear:N \l_semio_viz_dg_lane_prop
  \seq_clear:N \l_semio_viz_dg_order_seq
  \seq_clear:N \l_semio_viz_dg_lanes_seq
  \exp_args:NV \semio_viz_dg_layout_run:n \l_semio_viz_dg_nodes_tl
}

% 📏 Counts the rows of node table #1 and either warns that it is empty or hands it to the layout pass.
\cs_new_protected:Npn \semio_viz_dg_layout_run:n #1 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
  \int_compare:nNnTF \l_semio_viz_dg_n_int = { 0 }
    { \msg_warning:nnn { semio-viz } { diagram-empty } {#1} }
    { \semio_viz_dg_layout_pass:n {#1} }
}

% 📐 Sweeps the table for lane names and row/column extents, swaps the axes when `direction=right`, then sizes the cells and places every node.
\cs_new_protected:Npn \semio_viz_dg_layout_pass:n #1 {
  \int_zero:N \l_semio_viz_dg_rows_int
  \int_zero:N \l_semio_viz_dg_cols_int
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_lane_tl } \l_semio_viz_dg_cell_tl
    \tl_if_empty:NF \l_semio_viz_dg_cell_tl {
      \exp_args:NNV \seq_if_in:NnF \l_semio_viz_dg_lanes_seq \l_semio_viz_dg_cell_tl
        { \seq_put_right:NV \l_semio_viz_dg_lanes_seq \l_semio_viz_dg_cell_tl }
    }
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_row_tl } \l_semio_viz_dg_cell_tl
    \tl_if_empty:NTF \l_semio_viz_dg_cell_tl
      { \int_set:Nn \l_semio_viz_dg_i_int { ##1 } }
      { \int_set:Nn \l_semio_viz_dg_i_int { \l_semio_viz_dg_cell_tl } }
    \int_compare:nNnT { \l_semio_viz_dg_i_int } > { \l_semio_viz_dg_rows_int }
      { \int_set_eq:NN \l_semio_viz_dg_rows_int \l_semio_viz_dg_i_int }
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_col_tl } \l_semio_viz_dg_cell_tl
    \tl_if_empty:NTF \l_semio_viz_dg_cell_tl
      { \int_set:Nn \l_semio_viz_dg_j_int { 1 } }
      { \int_set:Nn \l_semio_viz_dg_j_int { \l_semio_viz_dg_cell_tl } }
    \int_compare:nNnT { \l_semio_viz_dg_j_int } > { \l_semio_viz_dg_cols_int }
      { \int_set_eq:NN \l_semio_viz_dg_cols_int \l_semio_viz_dg_j_int }
  }
  \str_if_eq:VnT \l_semio_viz_dg_direction_tl { right } {
    \int_set_eq:NN \l_semio_viz_dg_ia_int \l_semio_viz_dg_rows_int
    \int_set_eq:NN \l_semio_viz_dg_rows_int \l_semio_viz_dg_cols_int
    \int_set_eq:NN \l_semio_viz_dg_cols_int \l_semio_viz_dg_ia_int
  }
  \int_compare:nNnT { \l_semio_viz_dg_rows_int } < { 1 } { \int_set:Nn \l_semio_viz_dg_rows_int { 1 } }
  \int_compare:nNnT { \l_semio_viz_dg_cols_int } < { 1 } { \int_set:Nn \l_semio_viz_dg_cols_int { 1 } }
  \bool_if:NT \l_semio_viz_dg_autosize_bool {
    \fp_set:Nn \l_semio_viz_dg_nw_fp
      { ( \l_semio_viz_dg_w_fp - 2 * \l_semio_viz_dg_pad_fp - ( \l_semio_viz_dg_cols_int - 1 ) * \l_semio_viz_dg_colgap_fp ) / \l_semio_viz_dg_cols_int }
    \fp_set:Nn \l_semio_viz_dg_nh_fp
      { ( \l_semio_viz_dg_h_fp - 2 * \l_semio_viz_dg_pad_fp - ( \l_semio_viz_dg_rows_int - 1 ) * \l_semio_viz_dg_rowgap_fp ) / \l_semio_viz_dg_rows_int }
    \fp_compare:nNnT { \l_semio_viz_dg_nw_fp } < { 4 } { \fp_set:Nn \l_semio_viz_dg_nw_fp { 4 } }
    \fp_compare:nNnT { \l_semio_viz_dg_nh_fp } < { 3 } { \fp_set:Nn \l_semio_viz_dg_nh_fp { 3 } }
  }
  \int_step_inline:nn { \l_semio_viz_dg_n_int } { \semio_viz_dg_layout_node:nn {#1} {##1} }
}

% 📍 Turns row #2 of table #1 into a grid centre, stores its `cx,cy,w,h,shape` record under the node id and probes the geometry.
\cs_new_protected:Npn \semio_viz_dg_layout_node:nn #1#2 {
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_col_id_tl } \l_semio_viz_dg_id_tl
  \tl_if_empty:NT \l_semio_viz_dg_id_tl { \tl_set:Nx \l_semio_viz_dg_id_tl { n#2 } }
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_col_row_tl } \l_semio_viz_dg_cell_tl
  \tl_if_empty:NTF \l_semio_viz_dg_cell_tl
    { \int_set:Nn \l_semio_viz_dg_i_int { #2 } }
    { \int_set:Nn \l_semio_viz_dg_i_int { \l_semio_viz_dg_cell_tl } }
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_col_col_tl } \l_semio_viz_dg_cell_tl
  \tl_if_empty:NTF \l_semio_viz_dg_cell_tl
    { \int_set:Nn \l_semio_viz_dg_j_int { 1 } }
    { \int_set:Nn \l_semio_viz_dg_j_int { \l_semio_viz_dg_cell_tl } }
  \str_if_eq:VnT \l_semio_viz_dg_direction_tl { right } {
    \int_set_eq:NN \l_semio_viz_dg_ia_int \l_semio_viz_dg_i_int
    \int_set_eq:NN \l_semio_viz_dg_i_int \l_semio_viz_dg_j_int
    \int_set_eq:NN \l_semio_viz_dg_j_int \l_semio_viz_dg_ia_int
  }
  \fp_set:Nn \l_semio_viz_dg_a_fp
    { \l_semio_viz_dg_pad_fp + ( \l_semio_viz_dg_j_int - 1 ) * ( \l_semio_viz_dg_nw_fp + \l_semio_viz_dg_colgap_fp ) + \l_semio_viz_dg_nw_fp / 2 }
  \fp_set:Nn \l_semio_viz_dg_b_fp
