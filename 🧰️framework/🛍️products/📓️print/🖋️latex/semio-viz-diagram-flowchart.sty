%region 🔖️Families
%region 🔖️Keys-flow
% 🗝️ `flow` renders a node/edge diagram through the kernel; every kernel key above is a family key.
%endregion 🔖️Keys-flow
% 🌊 Registers `flow`, which passes its option list straight into the diagram kernel.
\SemioVizFamily { flow } { \semio_viz_dg_run:n {#1} }

%region 🔖️Keys-swimlane
% 🗝️ `swimlane` is `flow` with lane bands on by default; `lanes=row|column` picks the banding axis
%    and `lane-title` supplies the header text. All other kernel keys apply unchanged.
%endregion 🔖️Keys-swimlane
% 🥽 Registers `swimlane`, the kernel prefixed with row lane bands and orthogonal routing.
\SemioVizFamily { swimlane } { \semio_viz_dg_run:n { lanes=row, routing=orthogonal, #1 } }

%region 🔖️Keys-fishbone
% 🗝️ `fishbone` draws a spine with paired bones from a table of causes.
%   data     tl   table of causes (default demo-diagram-cause)
%   label    tl   cause label column (default label)
%   group    tl   bone/category column (default grp)
%   effect   tl   text of the head box (default the table name)
%   spine    fp   millimetre vertical position of the spine (default half the frame height)
%   angle    fp   degrees of bone inclination (default 32)
%endregion 🔖️Keys-fishbone
\tl_new:N \l_semio_viz_dg_fb_data_tl
\tl_new:N \l_semio_viz_dg_fb_label_tl
\tl_new:N \l_semio_viz_dg_fb_group_tl
\tl_new:N \l_semio_viz_dg_fb_effect_tl
\fp_new:N \l_semio_viz_dg_fb_angle_fp
\seq_new:N \l_semio_viz_dg_fb_groups_seq

% 🐟 The `fishbone` option list: cause table, its label and group columns, head text, bone angle and frame size.
\keys_define:nn { semio / viz / family / fishbone } {
  data   .tl_set:N = \l_semio_viz_dg_fb_data_tl,
  label  .tl_set:N = \l_semio_viz_dg_fb_label_tl,
  group  .tl_set:N = \l_semio_viz_dg_fb_group_tl,
  effect .tl_set:N = \l_semio_viz_dg_fb_effect_tl,
  angle  .fp_set:N = \l_semio_viz_dg_fb_angle_fp,
  width  .fp_set:N = \l_semio_viz_dg_w_fp,
  height .fp_set:N = \l_semio_viz_dg_h_fp,
}

% 🎣 Entry point of `fishbone`: requires the frame, restores the defaults, applies #1 and renders the chosen cause table.
\cs_new_protected:Npn \semio_viz_dg_fishbone:n #1 {
  \semio_viz_frame_require:n { fishbone }
  \semio_viz_dg_reset:
  \tl_set:Nn \l_semio_viz_dg_fb_data_tl { demo-diagram-cause }
  \tl_set:Nn \l_semio_viz_dg_fb_label_tl { label }
  \tl_set:Nn \l_semio_viz_dg_fb_group_tl { grp }
  \tl_set:Nn \l_semio_viz_dg_fb_effect_tl { }
  \fp_set:Nn \l_semio_viz_dg_fb_angle_fp { 32 }
  \keys_set:nn { semio / viz / family / fishbone } {#1}
  \exp_args:NV \semio_viz_dg_fishbone_run:n \l_semio_viz_dg_fb_data_tl
}

% 🦴 Draws the horizontal spine and the hexagonal effect head, collects the distinct categories of table #1 and emits one bone each.
\cs_new_protected:Npn \semio_viz_dg_fishbone_run:n #1 {
  \fp_set:Nn \l_semio_viz_dg_y_fp { \l_semio_viz_dg_h_fp / 2 }
  \seq_clear:N \l_semio_viz_dg_fb_groups_seq
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_fb_group_tl } \l_semio_viz_dg_cell_tl
    \exp_args:NNV \seq_if_in:NnF \l_semio_viz_dg_fb_groups_seq \l_semio_viz_dg_cell_tl
      { \seq_put_right:NV \l_semio_viz_dg_fb_groups_seq \l_semio_viz_dg_cell_tl }
  }
  \int_set:Nn \l_semio_viz_dg_cols_int { \seq_count:N \l_semio_viz_dg_fb_groups_seq }
  \int_compare:nNnT { \l_semio_viz_dg_cols_int } < { 1 } { \int_set:Nn \l_semio_viz_dg_cols_int { 1 } }
  \draw [ semio-chrome-border-emphasized , line~width=\semio@stroke@default , -{Latex[length=2mm,width=1.6mm]} ]
    ( 2 , \fp_eval:n { \l_semio_viz_dg_y_fp } ) -- ( \fp_eval:n { \l_semio_viz_dg_w_fp - 14 } , \fp_eval:n { \l_semio_viz_dg_y_fp } ) ;
  \semio_viz_dg_tone:n { 0 }
  \semio_viz_dg_shape:nnnnn { hexagon } { \fp_eval:n { \l_semio_viz_dg_w_fp - 7 } } { \l_semio_viz_dg_y_fp } { 13 } { 9 }
  \semio_viz_dg_label:nnnn { \fp_eval:n { \l_semio_viz_dg_w_fp - 7 } } { \l_semio_viz_dg_y_fp } { 13 }
    { \tl_use:N \l_semio_viz_dg_fb_effect_tl }
  \int_zero:N \l_semio_viz_dg_j_int
  \seq_map_inline:Nn \l_semio_viz_dg_fb_groups_seq {
    \int_incr:N \l_semio_viz_dg_j_int
    \semio_viz_dg_fishbone_bone:nnn {#1} { \l_semio_viz_dg_j_int } {##1}
  }
}

% 🌿 Draws bone #2 for category #3 alternating above and below the spine, captions it and lists the matching causes of table #1 along it.
\cs_new_protected:Npn \semio_viz_dg_fishbone_bone:nnn #1#2#3 {
  \int_set:Nn \l_semio_viz_dg_i_int { \int_mod:nn { (#2) - 1 } { 2 } }
  \int_set:Nn \l_semio_viz_dg_ia_int { \int_div_truncate:nn { \l_semio_viz_dg_cols_int + 1 } { 2 } }
  \fp_set:Nn \l_semio_viz_dg_c_fp
    {
      min(
        ( \l_semio_viz_dg_w_fp - 22 ) / max( \l_semio_viz_dg_ia_int , 1 ) * 0.85 ,
        ( \l_semio_viz_dg_h_fp / 2 - 3 ) / tand( \l_semio_viz_dg_fb_angle_fp )
      )
    }
  \fp_set:Nn \l_semio_viz_dg_a_fp
    {
      \l_semio_viz_dg_w_fp - 16 -
      ( \l_semio_viz_dg_ia_int - ( ( (#2) + 1 ) / 2 ) ) * ( \l_semio_viz_dg_w_fp - 22 ) / max( \l_semio_viz_dg_ia_int , 1 )
    }
  \int_compare:nNnTF { \l_semio_viz_dg_i_int } = { 0 }
    { \fp_set:Nn \l_semio_viz_dg_d_fp { 1 } }
    { \fp_set:Nn \l_semio_viz_dg_d_fp { -1 } }
  \fp_set:Nn \l_semio_viz_dg_xa_fp { \l_semio_viz_dg_a_fp }
  \fp_set:Nn \l_semio_viz_dg_ya_fp { \l_semio_viz_dg_y_fp }
  \fp_set:Nn \l_semio_viz_dg_xb_fp { \l_semio_viz_dg_a_fp - \l_semio_viz_dg_c_fp }
  \fp_set:Nn \l_semio_viz_dg_yb_fp
    { \l_semio_viz_dg_y_fp + \l_semio_viz_dg_d_fp * \l_semio_viz_dg_c_fp * tand( \l_semio_viz_dg_fb_angle_fp ) }
  \semio_viz_dg_hue:nN {#2} \l_semio_viz_dg_ta_tl
  \draw [ \l_semio_viz_dg_ta_tl , line~width=\semio@stroke@hairline ]
    ( \fp_eval:n { \l_semio_viz_dg_xa_fp } , \fp_eval:n { \l_semio_viz_dg_ya_fp } ) --
    ( \fp_eval:n { \l_semio_viz_dg_xb_fp } , \fp_eval:n { \l_semio_viz_dg_yb_fp } ) ;
  \node [ font=\c_semio_viz_theme_font_chip_tl , text=\l_semio_viz_dg_ta_tl , anchor=south , inner~sep=0.4mm ]
    at ( \fp_eval:n { \l_semio_viz_dg_xb_fp } , \fp_eval:n { \l_semio_viz_dg_yb_fp + 0.4 } ) {#3} ;
  \semio_viz_probe_geometry:nx { diagram-bone }
    {
      \semio_viz_format_mm:n { \l_semio_viz_dg_xa_fp } , \semio_viz_format_mm:n { \l_semio_viz_dg_ya_fp } ,
      \semio_viz_format_mm:n { \l_semio_viz_dg_xb_fp } , \semio_viz_format_mm:n { \l_semio_viz_dg_yb_fp }
    }
  \int_zero:N \l_semio_viz_dg_ib_int
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_rows_int
  \int_step_inline:nn { \l_semio_viz_dg_rows_int } {
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_fb_group_tl } \l_semio_viz_dg_cell_tl
    \str_if_eq:VnT \l_semio_viz_dg_cell_tl {#3} {
      \int_incr:N \l_semio_viz_dg_ib_int
      \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_fb_label_tl } \l_semio_viz_dg_label_tl
      \fp_set:Nn \l_semio_viz_dg_b_fp { \l_semio_viz_dg_ib_int / ( \l_semio_viz_dg_rows_int + 1 ) }
      \node [ font=\c_semio_viz_theme_font_chip_tl , text=semio-chrome-text-normal ,
              anchor= \fp_compare:nNnTF { \l_semio_viz_dg_d_fp } > { 0 } { south~west } { north~west } , inner~sep=0.3mm ]
        at ( \fp_eval:n { \l_semio_viz_dg_xa_fp + ( \l_semio_viz_dg_xb_fp - \l_semio_viz_dg_xa_fp ) * ( 0.25 + 0.5 * \l_semio_viz_dg_b_fp ) + 0.6 } ,
             \fp_eval:n { \l_semio_viz_dg_ya_fp + ( \l_semio_viz_dg_yb_fp - \l_semio_viz_dg_ya_fp ) * ( 0.25 + 0.5 * \l_semio_viz_dg_b_fp ) } )
        { \tl_use:N \l_semio_viz_dg_label_tl } ;
    }
  }
}
% 🐠 Registers `fishbone` as a family so `\begin{semio-viz}[fishbone]` reaches the cause-and-effect renderer.
\SemioVizFamily { fishbone } { \semio_viz_dg_fishbone:n {#1} }

%region 🔖️Keys-logic-tree
% 🗝️ `logic-tree` lays a parent/child table out as a top-down tree of gated nodes.
%   data     tl   table (default demo-diagram-tree)
%   id/parent/label/shape  tl  column names (default id/parent/label/shape)
%   default-shape tl  shape for rows without one (default process)
%   gate     tl   shape drawn on a node that has more than one child (default none)
%   orientation choice down|right  (default down)
%endregion 🔖️Keys-logic-tree
\tl_new:N \l_semio_viz_dg_tr_data_tl
\tl_new:N \l_semio_viz_dg_tr_id_tl
\tl_new:N \l_semio_viz_dg_tr_parent_tl
\tl_new:N \l_semio_viz_dg_tr_label_tl
\tl_new:N \l_semio_viz_dg_tr_shape_tl
\tl_new:N \l_semio_viz_dg_tr_gate_tl
\tl_new:N \l_semio_viz_dg_tr_orient_tl
\prop_new:N \l_semio_viz_dg_tr_depth_prop
\prop_new:N \l_semio_viz_dg_tr_kids_prop
\int_new:N \l_semio_viz_dg_tr_leaf_int

% 🌳 The `logic-tree` option list: the parent/child table, its column names, the fallback and gate shapes, orientation, routing and frame size.
\keys_define:nn { semio / viz / family / logic-tree } {
  data   .tl_set:N = \l_semio_viz_dg_tr_data_tl,
  id     .tl_set:N = \l_semio_viz_dg_tr_id_tl,
  parent .tl_set:N = \l_semio_viz_dg_tr_parent_tl,
  label  .tl_set:N = \l_semio_viz_dg_tr_label_tl,
  shape  .tl_set:N = \l_semio_viz_dg_tr_shape_tl,
  default-shape .tl_set:N = \l_semio_viz_dg_shape_tl,
  gate   .tl_set:N = \l_semio_viz_dg_tr_gate_tl,
  orientation .tl_set:N = \l_semio_viz_dg_tr_orient_tl,
  routing .tl_set:N = \l_semio_viz_dg_routing_tl,
  width  .fp_set:N = \l_semio_viz_dg_w_fp,
  height .fp_set:N = \l_semio_viz_dg_h_fp,
}

% 🌲 Entry point of `logic-tree`: resets the kernel, restores the column and gate defaults, applies #1 and renders the tree table.
\cs_new_protected:Npn \semio_viz_dg_logic_tree:n #1 {
  \semio_viz_frame_require:n { logic-tree }
  \semio_viz_dg_reset:
  \tl_set:Nn \l_semio_viz_dg_tr_data_tl { demo-diagram-tree }
  \tl_set:Nn \l_semio_viz_dg_tr_id_tl { id }
  \tl_set:Nn \l_semio_viz_dg_tr_parent_tl { parent }
  \tl_set:Nn \l_semio_viz_dg_tr_label_tl { label }
  \tl_set:Nn \l_semio_viz_dg_tr_shape_tl { shape }
  \tl_set:Nn \l_semio_viz_dg_tr_gate_tl { none }
  \tl_set:Nn \l_semio_viz_dg_tr_orient_tl { down }
  \keys_set:nn { semio / viz / family / logic-tree } {#1}
  \exp_args:NV \semio_viz_dg_logic_tree_run:n \l_semio_viz_dg_tr_data_tl
}

% 🪵 Derives depth and child counts from the parent column, sizes the nodes from the leaf count, then places, centres and draws the tree.
\cs_new_protected:Npn \semio_viz_dg_logic_tree_run:n #1 {
  \prop_clear:N \l_semio_viz_dg_tr_depth_prop
  \prop_clear:N \l_semio_viz_dg_tr_kids_prop
  \prop_clear:N \l_semio_viz_dg_node_prop
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
  \int_set:Nn \l_semio_viz_dg_rows_int { 1 }
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_tr_id_tl } \l_semio_viz_dg_id_tl
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_tr_parent_tl } \l_semio_viz_dg_ta_tl
    \tl_if_empty:NTF \l_semio_viz_dg_ta_tl
      { \prop_put:NVn \l_semio_viz_dg_tr_depth_prop \l_semio_viz_dg_id_tl { 1 } }
      {
        \prop_get:NVNTF \l_semio_viz_dg_tr_depth_prop \l_semio_viz_dg_ta_tl \l_semio_viz_dg_tb_tl
          { \prop_put:NVx \l_semio_viz_dg_tr_depth_prop \l_semio_viz_dg_id_tl { \int_eval:n { \l_semio_viz_dg_tb_tl + 1 } } }
          { \prop_put:NVn \l_semio_viz_dg_tr_depth_prop \l_semio_viz_dg_id_tl { 2 } }
        \prop_get:NVNTF \l_semio_viz_dg_tr_kids_prop \l_semio_viz_dg_ta_tl \l_semio_viz_dg_tb_tl
          { \prop_put:NVx \l_semio_viz_dg_tr_kids_prop \l_semio_viz_dg_ta_tl { \int_eval:n { \l_semio_viz_dg_tb_tl + 1 } } }
          { \prop_put:NVn \l_semio_viz_dg_tr_kids_prop \l_semio_viz_dg_ta_tl { 1 } }
      }
    \prop_get:NVN \l_semio_viz_dg_tr_depth_prop \l_semio_viz_dg_id_tl \l_semio_viz_dg_tb_tl
    \int_compare:nNnT { \l_semio_viz_dg_tb_tl } > { \l_semio_viz_dg_rows_int } { \int_set:Nn \l_semio_viz_dg_rows_int { \l_semio_viz_dg_tb_tl } }
  }
  \int_zero:N \l_semio_viz_dg_tr_leaf_int
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_tr_id_tl } \l_semio_viz_dg_id_tl
    \prop_if_in:NVF \l_semio_viz_dg_tr_kids_prop \l_semio_viz_dg_id_tl { \int_incr:N \l_semio_viz_dg_tr_leaf_int }
  }
  \int_compare:nNnT { \l_semio_viz_dg_tr_leaf_int } < { 1 } { \int_set:Nn \l_semio_viz_dg_tr_leaf_int { 1 } }
  \fp_set:Nn \l_semio_viz_dg_nw_fp { ( \l_semio_viz_dg_w_fp - 4 ) / \l_semio_viz_dg_tr_leaf_int - 2 }
  \fp_compare:nNnT { \l_semio_viz_dg_nw_fp } < { 6 } { \fp_set:Nn \l_semio_viz_dg_nw_fp { 6 } }
  \fp_set:Nn \l_semio_viz_dg_nh_fp { ( \l_semio_viz_dg_h_fp - 4 ) / \l_semio_viz_dg_rows_int - 4 }
  \fp_compare:nNnT { \l_semio_viz_dg_nh_fp } < { 4 } { \fp_set:Nn \l_semio_viz_dg_nh_fp { 4 } }
  \int_zero:N \l_semio_viz_dg_j_int
  \int_step_inline:nn { \l_semio_viz_dg_n_int } { \semio_viz_dg_logic_tree_place:nn {#1} {##1} }
  \int_step_inline:nn { \l_semio_viz_dg_n_int } { \semio_viz_dg_logic_tree_link:nn {#1} {##1} }
  \int_step_inline:nn { \l_semio_viz_dg_n_int } { \semio_viz_dg_logic_tree_draw:nn {#1} {##1} }
}

% 🍃 Stores row #2 at its depth row, giving leaves the next free column slot and marking inner nodes with x=-1 for later centring.
\cs_new_protected:Npn \semio_viz_dg_logic_tree_place:nn #1#2 {
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_tr_id_tl } \l_semio_viz_dg_id_tl
  \prop_get:NVN \l_semio_viz_dg_tr_depth_prop \l_semio_viz_dg_id_tl \l_semio_viz_dg_tb_tl
  \prop_if_in:NVTF \l_semio_viz_dg_tr_kids_prop \l_semio_viz_dg_id_tl
    { \fp_set:Nn \l_semio_viz_dg_a_fp { -1 } }
    {
      \int_incr:N \l_semio_viz_dg_j_int
      \fp_set:Nn \l_semio_viz_dg_a_fp
        { 2 + ( \l_semio_viz_dg_j_int - 0.5 ) * ( \l_semio_viz_dg_w_fp - 4 ) / \l_semio_viz_dg_tr_leaf_int }
    }
  \fp_set:Nn \l_semio_viz_dg_b_fp
    { \l_semio_viz_dg_h_fp - 2 - ( \l_semio_viz_dg_tb_tl - 0.5 ) * ( \l_semio_viz_dg_h_fp - 4 ) / \l_semio_viz_dg_rows_int }
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_tr_shape_tl } \l_semio_viz_dg_cell_tl
  \tl_if_empty:NT \l_semio_viz_dg_cell_tl { \tl_set_eq:NN \l_semio_viz_dg_cell_tl \l_semio_viz_dg_shape_tl }
  \tl_set:Nx \l_semio_viz_dg_rec_tl
    {
      \semio_viz_format_mm:n { \l_semio_viz_dg_a_fp } , \semio_viz_format_mm:n { \l_semio_viz_dg_b_fp } ,
      \semio_viz_format_mm:n { \l_semio_viz_dg_nw_fp } , \semio_viz_format_mm:n { \l_semio_viz_dg_nh_fp } ,
      \l_semio_viz_dg_cell_tl
    }
  \prop_put:NVV \l_semio_viz_dg_node_prop \l_semio_viz_dg_id_tl \l_semio_viz_dg_rec_tl
}

% 🪢 Walks the rows bottom-up and rewrites each still unplaced inner node to the mean x of its children.
\cs_new_protected:Npn \semio_viz_dg_logic_tree_link:nn #1#2 {
  \int_set:Nn \l_semio_viz_dg_i_int { \l_semio_viz_dg_n_int + 1 - (#2) }
  \semio_viz_table_cell_opt:nnnN {#1} { \l_semio_viz_dg_i_int } { \l_semio_viz_dg_tr_id_tl } \l_semio_viz_dg_id_tl
  \semio_viz_dg_get:n { \l_semio_viz_dg_id_tl }
  \fp_compare:nNnT { \l_semio_viz_dg_a_fp } < { 0 } {
    \fp_zero:N \l_semio_viz_dg_x_fp
    \int_zero:N \l_semio_viz_dg_ib_int
    \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_rows_int
    \int_step_inline:nn { \l_semio_viz_dg_rows_int } {
      \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_tr_parent_tl } \l_semio_viz_dg_ta_tl
      \str_if_eq:VVT \l_semio_viz_dg_ta_tl \l_semio_viz_dg_id_tl {
        \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_tr_id_tl } \l_semio_viz_dg_tb_tl
        \prop_get:NVNT \l_semio_viz_dg_node_prop \l_semio_viz_dg_tb_tl \l_semio_viz_dg_rec_tl {
          \int_incr:N \l_semio_viz_dg_ib_int
          \fp_add:Nn \l_semio_viz_dg_x_fp { \clist_item:Nn \l_semio_viz_dg_rec_tl { 1 } }
        }
      }
    }
    \int_compare:nNnT { \l_semio_viz_dg_ib_int } > { 0 } {
      \prop_get:NVN \l_semio_viz_dg_node_prop \l_semio_viz_dg_id_tl \l_semio_viz_dg_rec_tl
      \tl_set:Nx \l_semio_viz_dg_ta_tl
        {
          \semio_viz_format_mm:n { \l_semio_viz_dg_x_fp / \l_semio_viz_dg_ib_int } ,
          \clist_item:Nn \l_semio_viz_dg_rec_tl { 2 } , \clist_item:Nn \l_semio_viz_dg_rec_tl { 3 } ,
          \clist_item:Nn \l_semio_viz_dg_rec_tl { 4 } , \clist_item:Nn \l_semio_viz_dg_rec_tl { 5 }
        }
      \prop_put:NVV \l_semio_viz_dg_node_prop \l_semio_viz_dg_id_tl \l_semio_viz_dg_ta_tl
    }
  }
}

% 🖍️ Draws the edge from row #2 up to its parent, then its shape, label and, for branching nodes, the gate marker above the box.
\cs_new_protected:Npn \semio_viz_dg_logic_tree_draw:nn #1#2 {
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_tr_id_tl } \l_semio_viz_dg_id_tl
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_tr_parent_tl } \l_semio_viz_dg_ta_tl
  \tl_if_empty:NF \l_semio_viz_dg_ta_tl {
    \semio_viz_dg_arrow_style:N \l_semio_viz_dg_arrowstyle_tl
    \semio_viz_dg_route:nn { \l_semio_viz_dg_ta_tl } { \l_semio_viz_dg_id_tl }
    \use:x { \exp_not:N \semio_viz_dg_route_draw:nn
      { semio-chrome-border-emphasized , line~width=\semio@stroke@hairline , \exp_not:V \l_semio_viz_dg_arrowstyle_tl } { } }
  }
  \semio_viz_dg_get:n { \l_semio_viz_dg_id_tl }
  \tl_if_empty:NF \l_semio_viz_dg_rec_tl {
    \prop_if_in:NVTF \l_semio_viz_dg_tr_kids_prop \l_semio_viz_dg_id_tl
      { \semio_viz_dg_tone:n { 1 } } { \semio_viz_dg_tone:n { 0 } }
    \tl_set:Nx \l_semio_viz_dg_tb_tl { \clist_item:Nn \l_semio_viz_dg_rec_tl { 5 } }
    \exp_args:NV \semio_viz_dg_shape_named:n \l_semio_viz_dg_tb_tl
    \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_tr_label_tl } \l_semio_viz_dg_label_tl
    \semio_viz_dg_label:nnnn { \l_semio_viz_dg_a_fp } { \l_semio_viz_dg_b_fp } { \l_semio_viz_dg_c_fp }
      { \tl_use:N \l_semio_viz_dg_label_tl }
    \str_if_eq:VnF \l_semio_viz_dg_tr_gate_tl { none } {
      \prop_if_in:NVT \l_semio_viz_dg_tr_kids_prop \l_semio_viz_dg_id_tl {
        \semio_viz_dg_shape:nnnnn { \l_semio_viz_dg_tr_gate_tl }
          { \l_semio_viz_dg_a_fp } { \fp_eval:n { \l_semio_viz_dg_b_fp - \l_semio_viz_dg_d_fp / 2 - 2.6 } } { 6 } { 4 }
      }
    }
  }
}
% 🌴 Registers `logic-tree` as a family so fault trees and issue trees are reachable by name.
\SemioVizFamily { logic-tree } { \semio_viz_dg_logic_tree:n {#1} }

%region 🔖️Keys-cycle
% 🗝️ `cycle` places stage boxes on a circle and links them with arcs.
%   data     tl   table of stages (default demo-diagram-cycle)
%   label    tl   label column (default label)
%   sign     tl   polarity column for causal loops, values `+`/`-` (default empty = no polarity)
%   shape    tl   node shape (default terminator)
%   start    fp   degrees of the first stage (default 90)
%   sweep    fp   total degrees covered, negative for clockwise (default -360)
%   closed   bool close the loop back to the first stage (default true)
%   radius   fp   millimetre radius, `0` fits the frame (default 0)
%   hub      tl   text of a centre hub, empty for none (default empty)
%endregion 🔖️Keys-cycle
\tl_new:N \l_semio_viz_dg_cy_data_tl
\tl_new:N \l_semio_viz_dg_cy_label_tl
\tl_new:N \l_semio_viz_dg_cy_sign_tl
\tl_new:N \l_semio_viz_dg_cy_hub_tl
\fp_new:N \l_semio_viz_dg_cy_start_fp
\fp_new:N \l_semio_viz_dg_cy_sweep_fp
\fp_new:N \l_semio_viz_dg_cy_radius_fp
\bool_new:N \l_semio_viz_dg_cy_closed_bool

% 🔁 The `cycle` option list: stage table, label and polarity columns, node shape, start angle, sweep, closure, radius, hub text and frame size.
\keys_define:nn { semio / viz / family / cycle } {
  data   .tl_set:N = \l_semio_viz_dg_cy_data_tl,
  label  .tl_set:N = \l_semio_viz_dg_cy_label_tl,
  sign   .tl_set:N = \l_semio_viz_dg_cy_sign_tl,
  shape  .tl_set:N = \l_semio_viz_dg_shape_tl,
  start  .fp_set:N = \l_semio_viz_dg_cy_start_fp,
  sweep  .fp_set:N = \l_semio_viz_dg_cy_sweep_fp,
  closed .bool_set:N = \l_semio_viz_dg_cy_closed_bool,
  radius .fp_set:N = \l_semio_viz_dg_cy_radius_fp,
  hub    .tl_set:N = \l_semio_viz_dg_cy_hub_tl,
  width  .fp_set:N = \l_semio_viz_dg_w_fp,
  height .fp_set:N = \l_semio_viz_dg_h_fp,
}

% 🔄 Entry point of `cycle`: resets the kernel, restores the full-turn clockwise defaults, applies #1 and renders the stage table.
\cs_new_protected:Npn \semio_viz_dg_cycle:n #1 {
  \semio_viz_frame_require:n { cycle }
  \semio_viz_dg_reset:
  \tl_set:Nn \l_semio_viz_dg_cy_data_tl { demo-diagram-cycle }
  \tl_set:Nn \l_semio_viz_dg_cy_label_tl { label }
  \tl_clear:N \l_semio_viz_dg_cy_sign_tl
  \tl_clear:N \l_semio_viz_dg_cy_hub_tl
  \tl_set:Nn \l_semio_viz_dg_shape_tl { terminator }
  \fp_set:Nn \l_semio_viz_dg_cy_start_fp { 90 }
  \fp_set:Nn \l_semio_viz_dg_cy_sweep_fp { -360 }
  \fp_zero:N \l_semio_viz_dg_cy_radius_fp
  \bool_set_true:N \l_semio_viz_dg_cy_closed_bool
  \keys_set:nn { semio / viz / family / cycle } {#1}
  \exp_args:NV \semio_viz_dg_cycle_run:n \l_semio_viz_dg_cy_data_tl
}

% 🎡 Spaces the stages of table #1 evenly around the circle, links them, draws box and label per stage and adds the optional centre hub.
\cs_new_protected:Npn \semio_viz_dg_cycle_run:n #1 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
  \int_compare:nNnT { \l_semio_viz_dg_n_int } < { 1 } { \int_set:Nn \l_semio_viz_dg_n_int { 1 } }
  \fp_compare:nT { \l_semio_viz_dg_cy_radius_fp <= 0 }
    { \fp_set:Nn \l_semio_viz_dg_cy_radius_fp { min( \l_semio_viz_dg_w_fp , \l_semio_viz_dg_h_fp ) / 2 - 6 } }
  \fp_set:Nn \l_semio_viz_dg_x_fp { \l_semio_viz_dg_w_fp / 2 }
  \fp_set:Nn \l_semio_viz_dg_y_fp { \l_semio_viz_dg_h_fp / 2 }
  \fp_set:Nn \l_semio_viz_dg_nw_fp { min( 2 * 3.1415926 * \l_semio_viz_dg_cy_radius_fp / \l_semio_viz_dg_n_int * 0.8 , 22 ) }
  \fp_compare:nNnT { \l_semio_viz_dg_nw_fp } < { 8 } { \fp_set:Nn \l_semio_viz_dg_nw_fp { 8 } }
  \fp_set:Nn \l_semio_viz_dg_nh_fp { 7 }
  \prop_clear:N \l_semio_viz_dg_node_prop
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \fp_set:Nn \l_semio_viz_dg_c_fp
      { \l_semio_viz_dg_cy_start_fp + \l_semio_viz_dg_cy_sweep_fp * (##1 - 1) / \l_semio_viz_dg_n_int }
    \tl_set:Nx \l_semio_viz_dg_rec_tl
      {
        \semio_viz_format_mm:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_cy_radius_fp * cosd( \l_semio_viz_dg_c_fp ) } ,
        \semio_viz_format_mm:n { \l_semio_viz_dg_y_fp + \l_semio_viz_dg_cy_radius_fp * sind( \l_semio_viz_dg_c_fp ) } ,
        \semio_viz_format_mm:n { \l_semio_viz_dg_nw_fp } , \semio_viz_format_mm:n { \l_semio_viz_dg_nh_fp } ,
        \l_semio_viz_dg_shape_tl
      }
    \prop_put:NnV \l_semio_viz_dg_node_prop { s##1 } \l_semio_viz_dg_rec_tl
    \semio_viz_probe_geometry:nx { diagram-node }
      { \clist_item:Nn \l_semio_viz_dg_rec_tl { 1 } , \clist_item:Nn \l_semio_viz_dg_rec_tl { 2 } ,
        \clist_item:Nn \l_semio_viz_dg_rec_tl { 3 } , \clist_item:Nn \l_semio_viz_dg_rec_tl { 4 } }
  }
  \int_step_inline:nn { \l_semio_viz_dg_n_int } { \semio_viz_dg_cycle_link:nn {#1} {##1} }
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \semio_viz_dg_tone:n { ##1 }
    \semio_viz_dg_get:n { s##1 }
    \exp_args:NV \semio_viz_dg_shape_named:n \l_semio_viz_dg_shape_tl
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_cy_label_tl } \l_semio_viz_dg_label_tl
    \semio_viz_dg_label:nnnn { \l_semio_viz_dg_a_fp } { \l_semio_viz_dg_b_fp } { \l_semio_viz_dg_c_fp }
      { \tl_use:N \l_semio_viz_dg_label_tl }
  }
  \tl_if_empty:NF \l_semio_viz_dg_cy_hub_tl {
    \semio_viz_dg_tone:n { 0 }
    \semio_viz_dg_shape:nnnnn { circle } { \l_semio_viz_dg_x_fp } { \l_semio_viz_dg_y_fp }
      { \fp_eval:n { \l_semio_viz_dg_cy_radius_fp * 0.7 } } { \fp_eval:n { \l_semio_viz_dg_cy_radius_fp * 0.7 } }
    \semio_viz_dg_label:nnnn { \l_semio_viz_dg_x_fp } { \l_semio_viz_dg_y_fp }
      { \fp_eval:n { \l_semio_viz_dg_cy_radius_fp * 0.7 } } { \tl_use:N \l_semio_viz_dg_cy_hub_tl }
  }
}

% ➰ Draws the curved arrow from stage #2 to its successor, skipping the wrap-around link when the loop is open, and adds the polarity sign.
\cs_new_protected:Npn \semio_viz_dg_cycle_link:nn #1#2 {
  \int_set:Nn \l_semio_viz_dg_i_int { \int_mod:nn { (#2) } { \l_semio_viz_dg_n_int } + 1 }
  \bool_if:nT { \bool_if_p:N \l_semio_viz_dg_cy_closed_bool || \int_compare_p:nNn { \l_semio_viz_dg_i_int } > { #2 } } {
    \tl_set:Nn \l_semio_viz_dg_routing_tl { curved }
    \semio_viz_dg_arrow_style:N \l_semio_viz_dg_arrowstyle_tl
    \semio_viz_dg_route:nn { s#2 } { s \int_use:N \l_semio_viz_dg_i_int }
    \use:x { \exp_not:N \semio_viz_dg_route_draw:nn
      { semio-chrome-border-emphasized , line~width=\semio@stroke@hairline , \exp_not:V \l_semio_viz_dg_arrowstyle_tl } { } }
    \tl_if_empty:NF \l_semio_viz_dg_cy_sign_tl {
      \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_cy_sign_tl } \l_semio_viz_dg_label_tl
      \semio_viz_dg_edge_label:
    }
  }
}
% ♻️ Registers `cycle` as a family for loop diagrams such as PDCA and causal loops.
\SemioVizFamily { cycle } { \semio_viz_dg_cycle:n {#1} }

%region 🔖️Keys-stage
% 🗝️ `stage` draws a linear chain of stage bands (pipeline, stage-gate, funnel handoff, continuum).
%   data     tl   table of stages (default demo-diagram-cycle)
%   label    tl   label column (default label)
%   value    tl   optional numeric column driving band height (default empty = equal bands)
%   shape    tl   band shape: chevron|box|trapezoid|step (default chevron)
%   orientation choice right|down (default right)
%   gate     bool draw a gate marker between stages (default false)
%   taper    fp   fraction the last band narrows to, 1 = no taper (default 1)
%endregion 🔖️Keys-stage
\tl_new:N \l_semio_viz_dg_st_data_tl
\tl_new:N \l_semio_viz_dg_st_label_tl
\tl_new:N \l_semio_viz_dg_st_value_tl
\tl_new:N \l_semio_viz_dg_st_shape_tl
\tl_new:N \l_semio_viz_dg_st_orient_tl
\bool_new:N \l_semio_viz_dg_st_gate_bool
\fp_new:N \l_semio_viz_dg_st_taper_fp

% 🎚️ The `stage` option list: stage table, label and value columns, band shape, orientation, gate markers, taper and frame size.
\keys_define:nn { semio / viz / family / stage } {
  data   .tl_set:N = \l_semio_viz_dg_st_data_tl,
  label  .tl_set:N = \l_semio_viz_dg_st_label_tl,
  value  .tl_set:N = \l_semio_viz_dg_st_value_tl,
  shape  .tl_set:N = \l_semio_viz_dg_st_shape_tl,
  orientation .tl_set:N = \l_semio_viz_dg_st_orient_tl,
  gate   .bool_set:N = \l_semio_viz_dg_st_gate_bool,
  taper  .fp_set:N = \l_semio_viz_dg_st_taper_fp,
  width  .fp_set:N = \l_semio_viz_dg_w_fp,
  height .fp_set:N = \l_semio_viz_dg_h_fp,
}

% 🎬 Entry point of `stage`: resets the kernel, restores the untapered chevron defaults, applies #1 and renders the stage table.
\cs_new_protected:Npn \semio_viz_dg_stage:n #1 {
  \semio_viz_frame_require:n { stage }
  \semio_viz_dg_reset:
  \tl_set:Nn \l_semio_viz_dg_st_data_tl { demo-diagram-cycle }
  \tl_set:Nn \l_semio_viz_dg_st_label_tl { label }
  \tl_clear:N \l_semio_viz_dg_st_value_tl
  \tl_set:Nn \l_semio_viz_dg_st_shape_tl { chevron }
  \tl_set:Nn \l_semio_viz_dg_st_orient_tl { right }
  \bool_set_false:N \l_semio_viz_dg_st_gate_bool
  \fp_set:Nn \l_semio_viz_dg_st_taper_fp { 1 }
  \keys_set:nn { semio / viz / family / stage } {#1}
  \exp_args:NV \semio_viz_dg_stage_run:n \l_semio_viz_dg_st_data_tl
}

% 🎞️ Divides the frame into one band per row of table #1, stacking downwards or marching rightwards, then draws each band.
\cs_new_protected:Npn \semio_viz_dg_stage_run:n #1 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
  \int_compare:nNnT { \l_semio_viz_dg_n_int } < { 1 } { \int_set:Nn \l_semio_viz_dg_n_int { 1 } }
  \str_if_eq:VnTF \l_semio_viz_dg_st_orient_tl { down }
    {
      \fp_set:Nn \l_semio_viz_dg_nh_fp { ( \l_semio_viz_dg_h_fp - 4 ) / \l_semio_viz_dg_n_int - 1.6 }
      \fp_set:Nn \l_semio_viz_dg_nw_fp { \l_semio_viz_dg_w_fp - 6 }
    }
    {
      \fp_set:Nn \l_semio_viz_dg_nw_fp { ( \l_semio_viz_dg_w_fp - 4 ) / \l_semio_viz_dg_n_int - 1.6 }
      \fp_set:Nn \l_semio_viz_dg_nh_fp { \l_semio_viz_dg_h_fp * 0.45 }
    }
  \int_step_inline:nn { \l_semio_viz_dg_n_int } { \semio_viz_dg_stage_band:nn {#1} {##1} }
}

% 📶 Draws band #2 scaled by the taper or by its value column, labels it, adds the optional gate diamond and probes the band box.
\cs_new_protected:Npn \semio_viz_dg_stage_band:nn #1#2 {
  \fp_set:Nn \l_semio_viz_dg_d_fp
    { 1 - ( 1 - \l_semio_viz_dg_st_taper_fp ) * ( (#2) - 1 ) / max( \l_semio_viz_dg_n_int - 1 , 1 ) }
  \tl_if_empty:NF \l_semio_viz_dg_st_value_tl {
    \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_st_value_tl } \l_semio_viz_dg_cell_tl
    \semio_viz_table_col_max:nnN {#1} { \l_semio_viz_dg_st_value_tl } \l_semio_viz_dg_xa_fp
    \tl_if_empty:NF \l_semio_viz_dg_cell_tl
      { \fp_set:Nn \l_semio_viz_dg_d_fp { max( \l_semio_viz_dg_cell_tl / \l_semio_viz_dg_xa_fp , 0.15 ) } }
  }
  \str_if_eq:VnTF \l_semio_viz_dg_st_orient_tl { down }
    {
      \fp_set:Nn \l_semio_viz_dg_x_fp { \l_semio_viz_dg_w_fp / 2 }
      \fp_set:Nn \l_semio_viz_dg_y_fp
        { \l_semio_viz_dg_h_fp - 2 - ( (#2) - 0.5 ) * ( \l_semio_viz_dg_h_fp - 4 ) / \l_semio_viz_dg_n_int }
      \fp_set:Nn \l_semio_viz_dg_hw_fp { \l_semio_viz_dg_nw_fp * \l_semio_viz_dg_d_fp / 2 }
      \fp_set:Nn \l_semio_viz_dg_hh_fp { \l_semio_viz_dg_nh_fp / 2 }
    }
    {
      \fp_set:Nn \l_semio_viz_dg_x_fp
        { 2 + ( (#2) - 0.5 ) * ( \l_semio_viz_dg_w_fp - 4 ) / \l_semio_viz_dg_n_int }
      \fp_set:Nn \l_semio_viz_dg_y_fp { \l_semio_viz_dg_h_fp / 2 }
      \fp_set:Nn \l_semio_viz_dg_hw_fp { \l_semio_viz_dg_nw_fp / 2 }
      \fp_set:Nn \l_semio_viz_dg_hh_fp { \l_semio_viz_dg_nh_fp * \l_semio_viz_dg_d_fp / 2 }
    }
  \semio_viz_dg_tone:n {#2}
  \str_case:VnF \l_semio_viz_dg_st_shape_tl {
    { chevron } { \semio_viz_dg_chevron: }
    { trapezoid } { \semio_viz_dg_trapezoid: }
    { step } { \semio_viz_dg_step_band:n {#2} }
  } { \semio_viz_dg_rect:n { } }
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_st_label_tl } \l_semio_viz_dg_label_tl
  \semio_viz_dg_label:nnnn { \l_semio_viz_dg_x_fp } { \l_semio_viz_dg_y_fp }
    { \fp_eval:n { 2 * \l_semio_viz_dg_hw_fp } } { \tl_use:N \l_semio_viz_dg_label_tl }
  \bool_if:NT \l_semio_viz_dg_st_gate_bool {
    \int_compare:nNnF {#2} = { \l_semio_viz_dg_n_int } {
      \semio_viz_dg_tone:n { 0 }
      \semio_viz_dg_shape:nnnnn { diamond }
        { \fp_eval:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_hw_fp + 0.8 } } { \l_semio_viz_dg_y_fp } { 3 } { 3 }
    }
  }
  \semio_viz_probe_geometry:nx { diagram-band }
    {
      \semio_viz_format_mm:n { \l_semio_viz_dg_x_fp } , \semio_viz_format_mm:n { \l_semio_viz_dg_y_fp } ,
      \semio_viz_format_mm:n { 2 * \l_semio_viz_dg_hw_fp } , \semio_viz_format_mm:n { 2 * \l_semio_viz_dg_hh_fp }
    }
}

% ⏩ Chevron band: a rectangle with a 2mm point on the right and a matching notch on the left.
\cs_new_protected:Npn \semio_viz_dg_chevron: {
  \draw [ \l_semio_viz_dg_draw_tl , fill=\l_semio_viz_dg_fill_tl , line~width=\semio@stroke@hairline ]
    ( \fp_eval:n { \l_semio_viz_dg_x_fp - \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } ) --
    ( \fp_eval:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_hw_fp - 2 } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } ) --
    ( \fp_eval:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp } ) --
    ( \fp_eval:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_hw_fp - 2 } , \fp_eval:n { \l_semio_viz_dg_y_fp + \l_semio_viz_dg_hh_fp } ) --
    ( \fp_eval:n { \l_semio_viz_dg_x_fp - \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp + \l_semio_viz_dg_hh_fp } ) --
    ( \fp_eval:n { \l_semio_viz_dg_x_fp - \l_semio_viz_dg_hw_fp + 2 } , \fp_eval:n { \l_semio_viz_dg_y_fp } ) -- cycle ;
}

% 📈 Staircase band: a rectangle whose top rises one step per stage index #1 across the band height.
\cs_new_protected:Npn \semio_viz_dg_step_band:n #1 {
  \fp_set:Nn \l_semio_viz_dg_ya_fp
    { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp + ( (#1) - 1 ) * 2 * \l_semio_viz_dg_hh_fp / \l_semio_viz_dg_n_int }
  \draw [ \l_semio_viz_dg_draw_tl , fill=\l_semio_viz_dg_fill_tl , line~width=\semio@stroke@hairline ]
    ( \fp_eval:n { \l_semio_viz_dg_x_fp - \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_y_fp - \l_semio_viz_dg_hh_fp } )
    rectangle ( \fp_eval:n { \l_semio_viz_dg_x_fp + \l_semio_viz_dg_hw_fp } , \fp_eval:n { \l_semio_viz_dg_ya_fp + 2 * \l_semio_viz_dg_hh_fp / \l_semio_viz_dg_n_int } ) ;
}
% 🎢 Registers `stage` as a family for pipelines, stage gates, funnels and continua.
\SemioVizFamily { stage } { \semio_viz_dg_stage:n {#1} }

%region 🔖️Keys-decision-table
% 🗝️ `decision-table` renders a condition/action grid.
%   data     tl   table (default demo-diagram-rules)
%   label    tl   rule label column (default label)
%   columns  tl   comma list of value columns rendered as grid columns (default s1,s2,s3)
%   headers  tl   comma list of column captions, empty reuses the column names
%endregion 🔖️Keys-decision-table
\tl_new:N \l_semio_viz_dg_dt_data_tl
\tl_new:N \l_semio_viz_dg_dt_label_tl
\clist_new:N \l_semio_viz_dg_dt_cols_clist
\clist_new:N \l_semio_viz_dg_dt_heads_clist

% 🧾 The `decision-table` option list: rule table, its label column, the value columns to render and their captions, plus the frame size.
\keys_define:nn { semio / viz / family / decision-table } {
  data    .tl_set:N = \l_semio_viz_dg_dt_data_tl,
  label   .tl_set:N = \l_semio_viz_dg_dt_label_tl,
  columns .clist_set:N = \l_semio_viz_dg_dt_cols_clist,
  headers .clist_set:N = \l_semio_viz_dg_dt_heads_clist,
  width   .fp_set:N = \l_semio_viz_dg_w_fp,
  height  .fp_set:N = \l_semio_viz_dg_h_fp,
}

% 🗳️ Entry point of `decision-table`: restores the s1/s2/s3 defaults, applies #1, mirrors the column names into missing headers and renders the grid.
\cs_new_protected:Npn \semio_viz_dg_decision_table:n #1 {
  \semio_viz_frame_require:n { decision-table }
  \semio_viz_dg_reset:
  \tl_set:Nn \l_semio_viz_dg_dt_data_tl { demo-diagram-rules }
  \tl_set:Nn \l_semio_viz_dg_dt_label_tl { label }
  \clist_set:Nn \l_semio_viz_dg_dt_cols_clist { s1, s2, s3 }
  \clist_clear:N \l_semio_viz_dg_dt_heads_clist
  \keys_set:nn { semio / viz / family / decision-table } {#1}
  \clist_if_empty:NT \l_semio_viz_dg_dt_heads_clist
    { \clist_set_eq:NN \l_semio_viz_dg_dt_heads_clist \l_semio_viz_dg_dt_cols_clist }
  \exp_args:NV \semio_viz_dg_decision_table_run:n \l_semio_viz_dg_dt_data_tl
}

% 🧮 Sizes the grid from the rule count and column count, emits the tinted header row and then one label cell plus value cells per rule.
\cs_new_protected:Npn \semio_viz_dg_decision_table_run:n #1 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
  \int_set:Nn \l_semio_viz_dg_cols_int { \clist_count:N \l_semio_viz_dg_dt_cols_clist + 1 }
  \fp_set:Nn \l_semio_viz_dg_nw_fp { ( \l_semio_viz_dg_w_fp - 2 ) / \l_semio_viz_dg_cols_int }
  \fp_set:Nn \l_semio_viz_dg_nh_fp { ( \l_semio_viz_dg_h_fp - 2 ) / ( \l_semio_viz_dg_n_int + 1 ) }
  \int_zero:N \l_semio_viz_dg_j_int
  \clist_map_inline:Nn \l_semio_viz_dg_dt_heads_clist {
    \int_incr:N \l_semio_viz_dg_j_int
    \semio_viz_dg_tone:n { \l_semio_viz_dg_j_int }
    \semio_viz_dg_decision_cell:nnn { \l_semio_viz_dg_j_int + 1 } { 1 } { ##1 }
  }
  \semio_viz_dg_tone:n { 0 }
  \semio_viz_dg_decision_cell:nnn { 1 } { 1 } { }
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \semio_viz_dg_tone:n { 0 }
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_dt_label_tl } \l_semio_viz_dg_label_tl
    \use:x { \exp_not:N \semio_viz_dg_decision_cell:nnn { 1 } { \int_eval:n { ##1 + 1 } } { \exp_not:V \l_semio_viz_dg_label_tl } }
    \int_zero:N \l_semio_viz_dg_j_int
    \clist_map_inline:Nn \l_semio_viz_dg_dt_cols_clist {
      \int_incr:N \l_semio_viz_dg_j_int
      \semio_viz_table_cell_opt:nnnN {#1} {##1} { ####1 } \l_semio_viz_dg_label_tl
      \use:x { \exp_not:N \semio_viz_dg_decision_cell:nnn
        { \int_eval:n { \l_semio_viz_dg_j_int + 1 } } { \int_eval:n { ##1 + 1 } } { \exp_not:V \l_semio_viz_dg_label_tl } }
    }
  }
}

% 🔲 Draws the grid cell at column #1, row #2 as a rectangle carrying the centred text #3.
\cs_new_protected:Npn \semio_viz_dg_decision_cell:nnn #1#2#3 {
  \fp_set:Nn \l_semio_viz_dg_x_fp { 1 + ( (#1) - 0.5 ) * \l_semio_viz_dg_nw_fp }
  \fp_set:Nn \l_semio_viz_dg_y_fp { \l_semio_viz_dg_h_fp - 1 - ( (#2) - 0.5 ) * \l_semio_viz_dg_nh_fp }
  \semio_viz_dg_shape:nnnnn { process } { \l_semio_viz_dg_x_fp } { \l_semio_viz_dg_y_fp }
    { \l_semio_viz_dg_nw_fp } { \l_semio_viz_dg_nh_fp }
  \semio_viz_dg_label:nnnn { \l_semio_viz_dg_x_fp } { \l_semio_viz_dg_y_fp } { \l_semio_viz_dg_nw_fp } {#3}
}
% ✅ Registers `decision-table` as a family for condition/action rule grids.
\SemioVizFamily { decision-table } { \semio_viz_dg_decision_table:n {#1} }
%endregion 🔖️Families

