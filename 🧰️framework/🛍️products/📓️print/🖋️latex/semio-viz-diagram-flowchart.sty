%region 🔖️Routing
\fp_new:N \l_semio_viz_dg_xa_fp
\fp_new:N \l_semio_viz_dg_ya_fp
\fp_new:N \l_semio_viz_dg_xb_fp
\fp_new:N \l_semio_viz_dg_yb_fp
\fp_new:N \l_semio_viz_dg_wa_fp
\fp_new:N \l_semio_viz_dg_ha_fp
\fp_new:N \l_semio_viz_dg_wb_fp
\fp_new:N \l_semio_viz_dg_hb_fp
\tl_new:N \l_semio_viz_dg_path_tl

% ➡️ Boundary port of a rectangle centred at (#1,#2) with half-extent (#3,#4) toward direction (#5,#6); result in \l_semio_viz_dg_a_fp / _b_fp.
\cs_new_protected:Npn \semio_viz_dg_port:nnnnnn #1#2#3#4#5#6 {
  \fp_set:Nn \l_semio_viz_dg_c_fp
    {
      min(
        abs(#5) < 1e-6 ? 1e6 : abs( (#3) / (#5) ) ,
        abs(#6) < 1e-6 ? 1e6 : abs( (#4) / (#6) )
      )
    }
  \fp_set:Nn \l_semio_viz_dg_a_fp { (#1) + \l_semio_viz_dg_c_fp * (#5) }
  \fp_set:Nn \l_semio_viz_dg_b_fp { (#2) + \l_semio_viz_dg_c_fp * (#6) }
}

% 🧭 Computes the waypoint sequence from node #1 to node #2 into \l_semio_viz_dg_route_seq.
\cs_new_protected:Npn \semio_viz_dg_route:nn #1#2 {
  \seq_clear:N \l_semio_viz_dg_route_seq
  \tl_set:Nx \l_semio_viz_dg_key_b_tl {#2}
  \semio_viz_dg_get:n {#1}
  \tl_if_empty:NF \l_semio_viz_dg_rec_tl {
    \fp_set_eq:NN \l_semio_viz_dg_xa_fp \l_semio_viz_dg_a_fp
    \fp_set_eq:NN \l_semio_viz_dg_ya_fp \l_semio_viz_dg_b_fp
    \fp_set:Nn \l_semio_viz_dg_wa_fp { \l_semio_viz_dg_c_fp / 2 }
    \fp_set:Nn \l_semio_viz_dg_ha_fp { \l_semio_viz_dg_d_fp / 2 }
    \semio_viz_dg_get:n { \l_semio_viz_dg_key_b_tl }
    \tl_if_empty:NF \l_semio_viz_dg_rec_tl {
      \fp_set_eq:NN \l_semio_viz_dg_xb_fp \l_semio_viz_dg_a_fp
      \fp_set_eq:NN \l_semio_viz_dg_yb_fp \l_semio_viz_dg_b_fp
      \fp_set:Nn \l_semio_viz_dg_wb_fp { \l_semio_viz_dg_c_fp / 2 }
      \fp_set:Nn \l_semio_viz_dg_hb_fp { \l_semio_viz_dg_d_fp / 2 }
      \str_case:VnF \l_semio_viz_dg_routing_tl {
        { orthogonal } { \semio_viz_dg_route_orthogonal: }
        { curved } { \semio_viz_dg_route_direct: }
      } { \semio_viz_dg_route_direct: }
    }
  }
  \seq_if_empty:NF \l_semio_viz_dg_route_seq { \semio_viz_dg_route_emit: }
}

% 📌 Appends the millimetre-formatted waypoint (#1,#2) to the current route sequence.
\cs_new_protected:Npn \semio_viz_dg_route_put:nn #1#2 {
  \seq_put_right:Nx \l_semio_viz_dg_route_seq { \semio_viz_format_mm:n {#1} , \semio_viz_format_mm:n {#2} }
}

% 🛤️ Two-waypoint route: the boundary port of each node facing the other one.
\cs_new_protected:Npn \semio_viz_dg_route_direct: {
  \semio_viz_dg_port:nnnnnn { \l_semio_viz_dg_xa_fp } { \l_semio_viz_dg_ya_fp } { \l_semio_viz_dg_wa_fp } { \l_semio_viz_dg_ha_fp }
    { \l_semio_viz_dg_xb_fp - \l_semio_viz_dg_xa_fp } { \l_semio_viz_dg_yb_fp - \l_semio_viz_dg_ya_fp }
  \semio_viz_dg_route_put:nn { \l_semio_viz_dg_a_fp } { \l_semio_viz_dg_b_fp }
  \semio_viz_dg_port:nnnnnn { \l_semio_viz_dg_xb_fp } { \l_semio_viz_dg_yb_fp } { \l_semio_viz_dg_wb_fp } { \l_semio_viz_dg_hb_fp }
    { \l_semio_viz_dg_xa_fp - \l_semio_viz_dg_xb_fp } { \l_semio_viz_dg_ya_fp - \l_semio_viz_dg_yb_fp }
  \semio_viz_dg_route_put:nn { \l_semio_viz_dg_a_fp } { \l_semio_viz_dg_b_fp }
}

% 🪜 Right-angled route: leaves through the facing horizontal edges with a dog-leg at the midpoint, or straight sideways when the nodes share a row.
\cs_new_protected:Npn \semio_viz_dg_route_orthogonal: {
  \fp_compare:nNnTF { abs( \l_semio_viz_dg_yb_fp - \l_semio_viz_dg_ya_fp ) } > { 0.001 }
    {
      \fp_compare:nNnTF { \l_semio_viz_dg_yb_fp } < { \l_semio_viz_dg_ya_fp }
        {
          \fp_set:Nn \l_semio_viz_dg_c_fp { \l_semio_viz_dg_ya_fp - \l_semio_viz_dg_ha_fp }
          \fp_set:Nn \l_semio_viz_dg_d_fp { \l_semio_viz_dg_yb_fp + \l_semio_viz_dg_hb_fp }
        }
        {
          \fp_set:Nn \l_semio_viz_dg_c_fp { \l_semio_viz_dg_ya_fp + \l_semio_viz_dg_ha_fp }
          \fp_set:Nn \l_semio_viz_dg_d_fp { \l_semio_viz_dg_yb_fp - \l_semio_viz_dg_hb_fp }
        }
      \semio_viz_dg_route_put:nn { \l_semio_viz_dg_xa_fp } { \l_semio_viz_dg_c_fp }
      \fp_compare:nNnF { abs( \l_semio_viz_dg_xb_fp - \l_semio_viz_dg_xa_fp ) } < { 0.001 }
        {
          \semio_viz_dg_route_put:nn { \l_semio_viz_dg_xa_fp } { ( \l_semio_viz_dg_c_fp + \l_semio_viz_dg_d_fp ) / 2 }
          \semio_viz_dg_route_put:nn { \l_semio_viz_dg_xb_fp } { ( \l_semio_viz_dg_c_fp + \l_semio_viz_dg_d_fp ) / 2 }
        }
      \semio_viz_dg_route_put:nn { \l_semio_viz_dg_xb_fp } { \l_semio_viz_dg_d_fp }
    }
    {
      \fp_compare:nNnTF { \l_semio_viz_dg_xb_fp } > { \l_semio_viz_dg_xa_fp }
        {
          \fp_set:Nn \l_semio_viz_dg_c_fp { \l_semio_viz_dg_xa_fp + \l_semio_viz_dg_wa_fp }
          \fp_set:Nn \l_semio_viz_dg_d_fp { \l_semio_viz_dg_xb_fp - \l_semio_viz_dg_wb_fp }
        }
        {
          \fp_set:Nn \l_semio_viz_dg_c_fp { \l_semio_viz_dg_xa_fp - \l_semio_viz_dg_wa_fp }
          \fp_set:Nn \l_semio_viz_dg_d_fp { \l_semio_viz_dg_xb_fp + \l_semio_viz_dg_wb_fp }
        }
      \semio_viz_dg_route_put:nn { \l_semio_viz_dg_c_fp } { \l_semio_viz_dg_ya_fp }
      \semio_viz_dg_route_put:nn { \l_semio_viz_dg_d_fp } { \l_semio_viz_dg_yb_fp }
    }
}

% 📤 Emits the waypoint count and the flattened waypoints as one geometry record.
\cs_new_protected:Npn \semio_viz_dg_route_emit: {
  \semio_viz_probe_geometry:nx { diagram-route }
    { \seq_count:N \l_semio_viz_dg_route_seq , \seq_use:Nn \l_semio_viz_dg_route_seq { , } }
}

% 🖊️ Draws the current route with the arrow style #1 and the extra TikZ options #2.
\cs_new_protected:Npn \semio_viz_dg_route_draw:nn #1#2 {
  \seq_if_empty:NF \l_semio_viz_dg_route_seq {
    \str_if_eq:VnTF \l_semio_viz_dg_routing_tl { curved }
      { \semio_viz_dg_route_draw_curved:nn {#1} {#2} }
      {
        \tl_clear:N \l_semio_viz_dg_path_tl
        \seq_map_inline:Nn \l_semio_viz_dg_route_seq {
          \tl_if_empty:NTF \l_semio_viz_dg_path_tl
            { \tl_set:Nn \l_semio_viz_dg_path_tl { ( ##1 ) } }
            { \tl_put_right:Nn \l_semio_viz_dg_path_tl { -- ( ##1 ) } }
        }
        \use:x { \exp_not:N \draw [ #1 , #2 ] \exp_not:V \l_semio_viz_dg_path_tl ; }
      }
  }
}

% 🌈 Draws the first and last waypoints as one `to` arc bent by the `bend` key around the node-to-node angle.
\cs_new_protected:Npn \semio_viz_dg_route_draw_curved:nn #1#2 {
  \tl_set:Nx \l_semio_viz_dg_ta_tl { \seq_item:Nn \l_semio_viz_dg_route_seq { 1 } }
  \tl_set:Nx \l_semio_viz_dg_tb_tl { \seq_item:Nn \l_semio_viz_dg_route_seq { \seq_count:N \l_semio_viz_dg_route_seq } }
  \fp_set:Nn \l_semio_viz_dg_c_fp
    { atand( \l_semio_viz_dg_yb_fp - \l_semio_viz_dg_ya_fp , \l_semio_viz_dg_xb_fp - \l_semio_viz_dg_xa_fp ) }
  \tl_set:Nx \l_semio_viz_dg_path_tl
    {
      ( \exp_not:V \l_semio_viz_dg_ta_tl )
      to ~ [ out = \fp_eval:n { \l_semio_viz_dg_c_fp + \l_semio_viz_dg_bend_fp } ,
             in = \fp_eval:n { \l_semio_viz_dg_c_fp + 180 - \l_semio_viz_dg_bend_fp } ]
      ( \exp_not:V \l_semio_viz_dg_tb_tl )
    }
  \draw [ #1 , #2 ] \l_semio_viz_dg_path_tl ;
}

% 🏹 Arrow tip vocabulary for the current `arrow` key.
\cs_new_protected:Npn \semio_viz_dg_arrow_style:N #1 {
  \str_case:VnF \l_semio_viz_dg_arrow_tl {
    { to } { \tl_set:Nn #1 { -{Latex[length=1.6mm,width=1.2mm]} } }
    { from } { \tl_set:Nn #1 { {Latex[length=1.6mm,width=1.2mm]}- } }
    { both } { \tl_set:Nn #1 { {Latex[length=1.6mm,width=1.2mm]}-{Latex[length=1.6mm,width=1.2mm]} } }
    { none } { \tl_clear:N #1 }
  } { \tl_set:Nn #1 { -{Latex[length=1.6mm,width=1.2mm]} } }
}
%endregion 🔖️Routing

%region 🔖️Draw
\tl_new:N \l_semio_viz_dg_label_tl
\tl_new:N \l_semio_viz_dg_arrowstyle_tl

% 🎨 Sets fill/stroke from a tone index; index 0 keeps the neutral chrome pair.
\cs_new_protected:Npn \semio_viz_dg_tone:n #1 {
  \int_compare:nNnTF { #1 } = { 0 }
    {
      \tl_set:Nn \l_semio_viz_dg_fill_tl { semio-chrome-canvas }
      \tl_set:Nn \l_semio_viz_dg_draw_tl { semio-chrome-border-emphasized }
    }
    {
      \semio_viz_dg_hue:nN {#1} \l_semio_viz_dg_hue_tl
      \tl_set:Nx \l_semio_viz_dg_fill_tl { \l_semio_viz_dg_hue_tl !12! semio-chrome-canvas }
      \tl_set:Nx \l_semio_viz_dg_draw_tl { \l_semio_viz_dg_hue_tl }
    }
}

% 🔠 Centred label inside a node box of width #3.
\cs_new_protected:Npn \semio_viz_dg_label:nnnn #1#2#3#4 {
  \bool_if:NT \l_semio_viz_dg_labels_bool {
    \tl_if_empty:nF {#4} {
      \node [ font=\c_semio_viz_theme_font_cell_tl , text=semio-chrome-foreground , anchor=center ,
              align=center , inner~sep=0.4mm , text~width=\fp_eval:n { max( (#3) - 1.6 , 3 ) } mm ]
        at ( \fp_eval:n {#1} , \fp_eval:n {#2} ) {#4} ;
    }
  }
}

% 🖼️ Draws every laid-out node with its shape, tone and label.
\cs_new_protected:Npn \semio_viz_dg_draw_nodes: {
  \exp_args:NV \semio_viz_dg_draw_nodes_run:n \l_semio_viz_dg_nodes_tl
}

% 🖌️ Walks table #1 row by row, setting the tone, looking up the stored record and drawing shape plus label.
\cs_new_protected:Npn \semio_viz_dg_draw_nodes_run:n #1 {
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_id_tl } \l_semio_viz_dg_id_tl
    \tl_if_empty:NT \l_semio_viz_dg_id_tl { \tl_set:Nx \l_semio_viz_dg_id_tl { n##1 } }
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_tone_tl } \l_semio_viz_dg_cell_tl
    \tl_if_empty:NTF \l_semio_viz_dg_cell_tl
      { \semio_viz_dg_tone:n { 0 } }
      { \exp_args:NV \semio_viz_dg_tone:n \l_semio_viz_dg_cell_tl }
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_label_tl } \l_semio_viz_dg_label_tl
    \semio_viz_dg_get:n { \l_semio_viz_dg_id_tl }
    \tl_if_empty:NF \l_semio_viz_dg_rec_tl {
      \tl_set:Nx \l_semio_viz_dg_ta_tl { \clist_item:Nn \l_semio_viz_dg_rec_tl { 5 } }
      \exp_args:NV \semio_viz_dg_shape_named:n \l_semio_viz_dg_ta_tl
      \semio_viz_dg_label:nnnn { \l_semio_viz_dg_a_fp } { \l_semio_viz_dg_b_fp } { \l_semio_viz_dg_c_fp }
        { \tl_use:N \l_semio_viz_dg_label_tl }
    }
  }
}

% 🪄 Shorthand that draws shape #1 at the centre and size just unpacked by \semio_viz_dg_get:n.
\cs_new_protected:Npn \semio_viz_dg_shape_named:n #1 {
  \semio_viz_dg_shape:nnnnn {#1} { \l_semio_viz_dg_a_fp } { \l_semio_viz_dg_b_fp } { \l_semio_viz_dg_c_fp } { \l_semio_viz_dg_d_fp }
}

% 🔗 Routes and draws every edge row, with its optional label at the route midpoint.
\cs_new_protected:Npn \semio_viz_dg_draw_edges: {
  \tl_if_empty:NF \l_semio_viz_dg_edges_tl
    { \exp_args:NV \semio_viz_dg_draw_edges_run:n \l_semio_viz_dg_edges_tl }
}

% 🧶 Resolves the arrow style once, then draws every row of the registered edge table #1.
\cs_new_protected:Npn \semio_viz_dg_draw_edges_run:n #1 {
  \seq_if_in:NnT \g_semio_viz_table_names_seq {#1} {
    \semio_viz_dg_arrow_style:N \l_semio_viz_dg_arrowstyle_tl
    \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
    \int_step_inline:nn { \l_semio_viz_dg_n_int } { \semio_viz_dg_draw_edge:nn {#1} {##1} }
  }
}

% ✒️ Draws edge row #2: picks the stroke style from its kind (dashed, dotted, strong, critical), routes source to target and adds the label.
\cs_new_protected:Npn \semio_viz_dg_draw_edge:nn #1#2 {
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_col_source_tl } \l_semio_viz_dg_ta_tl
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_col_target_tl } \l_semio_viz_dg_tb_tl
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_col_edgekind_tl } \l_semio_viz_dg_cell_tl
  \tl_set:Nn \l_semio_viz_dg_style_tl { semio-chrome-border-emphasized , line~width=\semio@stroke@hairline }
  \str_case:VnF \l_semio_viz_dg_cell_tl {
    { dashed } { \tl_put_right:Nn \l_semio_viz_dg_style_tl { , dash~pattern=on~1.6pt~off~1.2pt } }
    { dotted } { \tl_put_right:Nn \l_semio_viz_dg_style_tl { , dash~pattern=on~0.4pt~off~1.2pt } }
    { strong } { \tl_put_right:Nn \l_semio_viz_dg_style_tl { , line~width=\semio@stroke@default } }
    { critical } { \tl_set:Nn \l_semio_viz_dg_style_tl { semio-danger , line~width=\semio@stroke@default } }
  } { }
  \semio_viz_dg_route:nn { \l_semio_viz_dg_ta_tl } { \l_semio_viz_dg_tb_tl }
  \use:x { \exp_not:N \semio_viz_dg_route_draw:nn { \exp_not:V \l_semio_viz_dg_style_tl , \exp_not:V \l_semio_viz_dg_arrowstyle_tl } { } }
  \semio_viz_table_cell_opt:nnnN {#1} {#2} { \l_semio_viz_dg_col_edgelabel_tl } \l_semio_viz_dg_label_tl
  \tl_if_empty:NF \l_semio_viz_dg_label_tl { \semio_viz_dg_edge_label: }
}

% 💬 Sets the current edge label in a canvas-filled node halfway along the middle segment of the route.
\cs_new_protected:Npn \semio_viz_dg_edge_label: {
  \int_set:Nn \l_semio_viz_dg_i_int { \seq_count:N \l_semio_viz_dg_route_seq }
  \int_compare:nNnT { \l_semio_viz_dg_i_int } > { 1 } {
    \tl_set:Nx \l_semio_viz_dg_ta_tl { \seq_item:Nn \l_semio_viz_dg_route_seq { \int_eval:n { ( \l_semio_viz_dg_i_int + 1 ) / 2 } } }
    \tl_set:Nx \l_semio_viz_dg_tb_tl { \seq_item:Nn \l_semio_viz_dg_route_seq { \int_eval:n { \l_semio_viz_dg_i_int / 2 + 1 } } }
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , fill=semio-chrome-canvas ,
            inner~sep=0.3mm , anchor=center ]
      at ( \fp_eval:n { ( \clist_item:Nn \l_semio_viz_dg_ta_tl { 1 } + \clist_item:Nn \l_semio_viz_dg_tb_tl { 1 } ) / 2 } ,
           \fp_eval:n { ( \clist_item:Nn \l_semio_viz_dg_ta_tl { 2 } + \clist_item:Nn \l_semio_viz_dg_tb_tl { 2 } ) / 2 } )
      { \tl_use:N \l_semio_viz_dg_label_tl } ;
  }
}
%endregion 🔖️Draw

%region 🔖️Lanes
% 🛟 Draws lane bands behind the grid; `lanes=row` bands rows, `lanes=column` bands columns.
\cs_new_protected:Npn \semio_viz_dg_draw_lanes: {
  \str_if_eq:VnF \l_semio_viz_dg_lanemode_tl { none } {
    \int_set:Nn \l_semio_viz_dg_n_int { \seq_count:N \l_semio_viz_dg_lanes_seq }
    \int_compare:nNnT { \l_semio_viz_dg_n_int } = { 0 } {
      \str_if_eq:VnTF \l_semio_viz_dg_lanemode_tl { row }
        { \int_set_eq:NN \l_semio_viz_dg_n_int \l_semio_viz_dg_rows_int }
        { \int_set_eq:NN \l_semio_viz_dg_n_int \l_semio_viz_dg_cols_int }
    }
    \int_step_inline:nn { \l_semio_viz_dg_n_int } { \semio_viz_dg_lane_band:n {##1} }
  }
}

% 🏊 Draws lane #1 in its own hue with the lane name as caption, then probes the band extent.
\cs_new_protected:Npn \semio_viz_dg_lane_band:n #1 {
  \semio_viz_dg_hue:nN {#1} \l_semio_viz_dg_ta_tl
  \tl_set:Nx \l_semio_viz_dg_id_tl { \seq_item:Nn \l_semio_viz_dg_lanes_seq {#1} }
  \semio_viz_dg_lane_band_draw:n {#1}
  \semio_viz_probe_geometry:nx { diagram-lane }
    { \semio_viz_format_mm:n { \l_semio_viz_dg_c_fp } , \semio_viz_format_mm:n { \l_semio_viz_dg_d_fp } }
}

% 🎽 Fills and rules the band of lane #1, spanning the full width for `lanes=row` and the full height otherwise.
\cs_new_protected:Npn \semio_viz_dg_lane_band_draw:n #1 {
  \str_if_eq:VnTF \l_semio_viz_dg_lanemode_tl { row }
    {
      \fp_set:Nn \l_semio_viz_dg_c_fp
        { \l_semio_viz_dg_h_fp - \l_semio_viz_dg_pad_fp - (#1) * ( \l_semio_viz_dg_nh_fp + \l_semio_viz_dg_rowgap_fp ) + \l_semio_viz_dg_rowgap_fp / 2 }
      \fp_set:Nn \l_semio_viz_dg_d_fp { \l_semio_viz_dg_c_fp + \l_semio_viz_dg_nh_fp + \l_semio_viz_dg_rowgap_fp }
      \fill [ \l_semio_viz_dg_ta_tl , fill~opacity=0.06 ]
        ( 0 , \fp_eval:n { \l_semio_viz_dg_c_fp } ) rectangle ( \fp_eval:n { \l_semio_viz_dg_w_fp } , \fp_eval:n { \l_semio_viz_dg_d_fp } ) ;
      \draw [ \l_semio_viz_dg_ta_tl , line~width=\semio@stroke@hairline , draw~opacity=0.45 ]
        ( 0 , \fp_eval:n { \l_semio_viz_dg_c_fp } ) -- ( \fp_eval:n { \l_semio_viz_dg_w_fp } , \fp_eval:n { \l_semio_viz_dg_c_fp } ) ;
      \tl_if_empty:NF \l_semio_viz_dg_id_tl {
        \node [ font=\c_semio_viz_theme_font_chip_tl , text=\l_semio_viz_dg_ta_tl , anchor=north~west , inner~sep=0.4mm ]
          at ( 0.6 , \fp_eval:n { \l_semio_viz_dg_d_fp - 0.4 } ) { \tl_use:N \l_semio_viz_dg_id_tl } ;
      }
    }
    {
      \fp_set:Nn \l_semio_viz_dg_c_fp
        { \l_semio_viz_dg_pad_fp + ( (#1) - 1 ) * ( \l_semio_viz_dg_nw_fp + \l_semio_viz_dg_colgap_fp ) - \l_semio_viz_dg_colgap_fp / 2 }
      \fp_set:Nn \l_semio_viz_dg_d_fp { \l_semio_viz_dg_c_fp + \l_semio_viz_dg_nw_fp + \l_semio_viz_dg_colgap_fp }
      \fill [ \l_semio_viz_dg_ta_tl , fill~opacity=0.06 ]
        ( \fp_eval:n { \l_semio_viz_dg_c_fp } , 0 ) rectangle ( \fp_eval:n { \l_semio_viz_dg_d_fp } , \fp_eval:n { \l_semio_viz_dg_h_fp } ) ;
      \draw [ \l_semio_viz_dg_ta_tl , line~width=\semio@stroke@hairline , draw~opacity=0.45 ]
        ( \fp_eval:n { \l_semio_viz_dg_c_fp } , 0 ) -- ( \fp_eval:n { \l_semio_viz_dg_c_fp } , \fp_eval:n { \l_semio_viz_dg_h_fp } ) ;
      \tl_if_empty:NF \l_semio_viz_dg_id_tl {
        \node [ font=\c_semio_viz_theme_font_chip_tl , text=\l_semio_viz_dg_ta_tl , anchor=north~west , inner~sep=0.4mm , rotate=0 ]
          at ( \fp_eval:n { \l_semio_viz_dg_c_fp + 0.6 } , \fp_eval:n { \l_semio_viz_dg_h_fp - 0.4 } ) { \tl_use:N \l_semio_viz_dg_id_tl } ;
      }
    }
}

% 🧱 Group frame around the bounding box of the nodes whose ids are listed in #1, captioned #2.
\cs_new_protected:Npn \semio_viz_dg_group:nn #1#2 {
  \fp_set:Nn \l_semio_viz_dg_xa_fp { 1e6 }
  \fp_set:Nn \l_semio_viz_dg_ya_fp { 1e6 }
  \fp_set:Nn \l_semio_viz_dg_xb_fp { -1e6 }
  \fp_set:Nn \l_semio_viz_dg_yb_fp { -1e6 }
  \clist_map_inline:nn {#1} {
    \semio_viz_dg_get:n {##1}
    \tl_if_empty:NF \l_semio_viz_dg_rec_tl {
      \fp_set:Nn \l_semio_viz_dg_xa_fp { min( \l_semio_viz_dg_xa_fp , \l_semio_viz_dg_a_fp - \l_semio_viz_dg_c_fp / 2 ) }
      \fp_set:Nn \l_semio_viz_dg_xb_fp { max( \l_semio_viz_dg_xb_fp , \l_semio_viz_dg_a_fp + \l_semio_viz_dg_c_fp / 2 ) }
      \fp_set:Nn \l_semio_viz_dg_ya_fp { min( \l_semio_viz_dg_ya_fp , \l_semio_viz_dg_b_fp - \l_semio_viz_dg_d_fp / 2 ) }
      \fp_set:Nn \l_semio_viz_dg_yb_fp { max( \l_semio_viz_dg_yb_fp , \l_semio_viz_dg_b_fp + \l_semio_viz_dg_d_fp / 2 ) }
    }
  }
  \fp_compare:nNnT { \l_semio_viz_dg_xb_fp } > { \l_semio_viz_dg_xa_fp } {
    \draw [ semio-chrome-border-normal , line~width=\semio@stroke@hairline , dash~pattern=on~1.2pt~off~1.2pt , rounded~corners=1mm ]
      ( \fp_eval:n { \l_semio_viz_dg_xa_fp - 1.6 } , \fp_eval:n { \l_semio_viz_dg_ya_fp - 1.6 } )
      rectangle ( \fp_eval:n { \l_semio_viz_dg_xb_fp + 1.6 } , \fp_eval:n { \l_semio_viz_dg_yb_fp + 2.8 } ) ;
    \tl_if_empty:nF {#2} {
      \node [ font=\c_semio_viz_theme_font_chip_tl , text=semio-chrome-text-normal , anchor=north~west , inner~sep=0.3mm ]
        at ( \fp_eval:n { \l_semio_viz_dg_xa_fp - 1.2 } , \fp_eval:n { \l_semio_viz_dg_yb_fp + 2.6 } ) {#2} ;
    }
  }
}

% 🧱 Draws one dashed frame per distinct value of the node table's group column.
\seq_new:N \l_semio_viz_dg_groups_seq
\cs_new_protected:Npn \semio_viz_dg_draw_groups: {
  \bool_if:NT \l_semio_viz_dg_groups_bool
    { \exp_args:NV \semio_viz_dg_draw_groups_run:n \l_semio_viz_dg_nodes_tl }
}

% 🧺 Collects the distinct non-empty values of the group column of table #1 and frames each one.
\cs_new_protected:Npn \semio_viz_dg_draw_groups_run:n #1 {
  \semio_viz_table_col_exist:nnT {#1} { \l_semio_viz_dg_col_group_tl } {
    \seq_clear:N \l_semio_viz_dg_groups_seq
    \semio_viz_table_nrows:nN {#1} \l_semio_viz_dg_n_int
    \int_step_inline:nn { \l_semio_viz_dg_n_int } {
      \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_group_tl } \l_semio_viz_dg_cell_tl
      \tl_if_empty:NF \l_semio_viz_dg_cell_tl {
        \exp_args:NNV \seq_if_in:NnF \l_semio_viz_dg_groups_seq \l_semio_viz_dg_cell_tl
          { \seq_put_right:NV \l_semio_viz_dg_groups_seq \l_semio_viz_dg_cell_tl }
      }
    }
    \seq_map_inline:Nn \l_semio_viz_dg_groups_seq { \semio_viz_dg_draw_group:nn {#1} {##1} }
  }
}

% 👥 Gathers the node ids of table #1 whose group cell equals #2 and frames them under that caption.
\cs_new_protected:Npn \semio_viz_dg_draw_group:nn #1#2 {
  \clist_clear:N \l_semio_viz_dg_members_clist
  \int_step_inline:nn { \l_semio_viz_dg_n_int } {
    \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_group_tl } \l_semio_viz_dg_cell_tl
    \str_if_eq:VnT \l_semio_viz_dg_cell_tl {#2} {
      \semio_viz_table_cell_opt:nnnN {#1} {##1} { \l_semio_viz_dg_col_id_tl } \l_semio_viz_dg_ta_tl
      \tl_if_empty:NT \l_semio_viz_dg_ta_tl { \tl_set:Nx \l_semio_viz_dg_ta_tl { n##1 } }
      \clist_put_right:NV \l_semio_viz_dg_members_clist \l_semio_viz_dg_ta_tl
    }
  }
  \exp_args:NV \semio_viz_dg_group:nn \l_semio_viz_dg_members_clist {#2}
}

% 🏷️ Legend row of `label=token` entries drawn along the bottom edge.
\cs_new_protected:Npn \semio_viz_dg_legend: {
  \tl_if_empty:NF \l_semio_viz_dg_legend_tl {
    \fp_set:Nn \l_semio_viz_dg_x_fp { \l_semio_viz_dg_pad_fp }
    \int_zero:N \l_semio_viz_dg_i_int
    \exp_args:NV \semio_viz_dg_legend_items:n \l_semio_viz_dg_legend_tl
  }
}

% 🔖 Lays out the legend entries of clist #1 left to right as a hue swatch plus caption, advancing by the caption length.
\cs_new_protected:Npn \semio_viz_dg_legend_items:n #1 {
  \clist_map_inline:nn {#1} {
    \int_incr:N \l_semio_viz_dg_i_int
    \semio_viz_dg_hue:nN { \l_semio_viz_dg_i_int } \l_semio_viz_dg_ta_tl
    \fill [ \l_semio_viz_dg_ta_tl ] ( \fp_eval:n { \l_semio_viz_dg_x_fp } , 0.6 ) rectangle ( \fp_eval:n { \l_semio_viz_dg_x_fp + 2 } , 2.2 ) ;
    \node [ font=\c_semio_viz_theme_font_chip_tl , text=semio-chrome-text-normal , anchor=west , inner~sep=0.3mm ]
      at ( \fp_eval:n { \l_semio_viz_dg_x_fp + 2.6 } , 1.4 ) { ##1 } ;
    \fp_add:Nn \l_semio_viz_dg_x_fp { 3 + 4 * \tl_count:n { ##1 } }
  }
}
%endregion 🔖️Lanes

%region 🔖️Pipeline
% ▶️ The full kernel pipeline: defaults, family options, layout, lanes, edges, nodes, legend.
\cs_new_protected:Npn \semio_viz_dg_run:n #1 {
  \semio_viz_frame_require:n { SemioVizDiagram }
  \semio_viz_dg_reset:
  \semio_viz_dg_keys:n {#1}
  \semio_viz_dg_layout:
  \bool_if:NT \l_semio_viz_dg_frame_bool {
    \draw [ semio-chrome-border-normal , line~width=\semio@stroke@hairline ]
      ( 0 , 0 ) rectangle ( \fp_eval:n { \l_semio_viz_dg_w_fp } , \fp_eval:n { \l_semio_viz_dg_h_fp } ) ;
  }
  \semio_viz_dg_draw_lanes:
  \semio_viz_dg_draw_groups:
  \semio_viz_dg_draw_edges:
  \semio_viz_dg_draw_nodes:
  \semio_viz_dg_legend:
}

% 🧩 \SemioVizDiagram[options]: renders the diagram kernel directly, for probes and composed families.
\NewDocumentCommand \SemioVizDiagram { O{} } { \semio_viz_dg_run:n {#1} }
%endregion 🔖️Pipeline

