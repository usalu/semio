        {
          "runtime": "node -p \"process.platform.concat(process.arch)\""
        },
        {
          "externalDependencies": [
            "@napi-rs/canvas",
            "ajv",
            "markdown-it",
            "pdfjs-dist",
            "sharp"
          ]
        }
