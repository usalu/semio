                "values": [
                  {
                    "id": "guard",
                    "env": {
                      "PRINT_NATIVE_GEO_PLANAR_PHASE": "guard"
                    }
                  },
                  {
                    "id": "admission",
                    "env": {
                      "PRINT_NATIVE_GEO_PLANAR_PHASE": "admission"
                    }
                  }
                ]
              },
              {
                "id": "geo-planar-source",
