{
  "name": "@semio-tech/print-rs",
  "root": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
  "sourceRoot": "🧰️framework/🛍️products/📓️print",
  "projectType": "library",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🛍️products/📓️print/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "lang:rust",
    "role:product",
    "family:print"
  ],
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "build": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "cargoToolchain"
      ],
      "outputs": ["{projectRoot}/.🧾️store/build.json"],
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build"
      }
    },
    "test-snapshot-sqlite": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite",
        "forwardAllArgs": false
      }
    },
    "test-snapshot-sqlite-native": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite native",
        "forwardAllArgs": false
      }
    },
    "test-snapshot-sqlite-source": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite source",
        "forwardAllArgs": false
      }
    },
    "produce-logical-owner": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts logical-owner produce",
        "forwardAllArgs": false
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "side-effecting", "reason": "mutates-workspace" }
        }
      }
    },
    "test-logical-owner": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts logical-owner check",
        "forwardAllArgs": false
      }
    },
    "test-native-emission": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts emit-grammar",
        "forwardAllArgs": false
      },
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  }
}
