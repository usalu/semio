{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrintPinnedHttpsRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "url"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 4096,
      "pattern": "^https://[^\\s]+$"
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumRedirects": 4,
        "maximumUrlUnits": 4096
      }
    }
  }
}
