{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrintWorkerProgress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "page",
    "total"
  ],
  "properties": {
    "type": {
      "const": "progress"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    }
  }
}
