{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrintPipelineEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "bytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9./-]*$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumEvidenceBytes": 134217728,
        "maximumEvidenceFiles": 4096,
        "maximumPdfBytes": 67108864,
        "maximumPages": 512,
        "maximumPageItems": 16384,
        "maximumPageOperators": 262144,
        "maximumTextBytes": 16777216,
        "maximumPagePixels": 16777216,
        "maximumTotalPixels": 67108864,
        "maximumPngBytes": 16777216
      }
    }
  }
}
