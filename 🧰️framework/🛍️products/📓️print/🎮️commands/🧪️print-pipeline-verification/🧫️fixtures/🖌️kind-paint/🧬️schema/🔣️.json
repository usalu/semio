{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/print/kind-paint/schema.json",
  "type": "object",
  "required": ["markerPrefix", "leaves", "kinds", "tolerancePt", "glyphKinds", "cases"],
  "additionalProperties": false,
  "properties": {
    "markerPrefix": { "const": "SemioVizLeaf" },
    "leaves": { "const": 1966 },
    "kinds": { "const": 1738 },
    "tolerancePt": { "type": "number", "minimum": 0, "maximum": 0.1 },
    "glyphKinds": { "type": "array", "items": { "type": "object", "required": ["slug", "family", "source", "definition"], "additionalProperties": false, "properties": { "slug": { "type": "string", "minLength": 1 }, "family": { "type": "string", "minLength": 1 }, "source": { "type": "string", "pattern": "^semio-viz-.*\\.sty$" }, "definition": { "type": "string", "minLength": 1 } } } },
    "cases": { "type": "array", "minItems": 9, "items": { "type": "object", "required": ["id", "class", "body", "valid"], "additionalProperties": false, "properties": { "id": { "type": "string", "pattern": "^[a-z-]+$" }, "class": { "enum": ["graphic", "glyph"] }, "body": { "type": "string" }, "chart": { "type": "boolean" }, "catalogueSlug": { "type": "string", "minLength": 1 }, "expectedData": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } }, "valid": { "type": "boolean" }, "expectedBoundsMm": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } } } } }
  }
}
