{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/print/macro-staging-fixture/schema.json",
  "title": "Print Macro Staging Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "entries", "inputs", "outputs", "sourceKind", "shimGrammar", "collisions"],
  "properties": {
    "$schema": { "const": "./🧬️schema/🔣️.json" },
    "version": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "inputs": { "$ref": "#/$defs/files" },
    "outputs": { "$ref": "#/$defs/files" },
    "sourceKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalPath", "scopedKindId", "hostileBasenames", "neighborPath", "neighborFileKindId"],
      "properties": {
        "canonicalPath": { "$ref": "#/$defs/relativePath" },
        "scopedKindId": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "hostileBasenames": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/]+\\.tex$" }
        },
        "neighborPath": { "$ref": "#/$defs/relativePath" },
        "neighborFileKindId": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
      }
    },
    "shimGrammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "grammarId", "acceptedRole", "rejections"],
      "properties": {
        "contractId": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "grammarId": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "acceptedRole": { "const": "thin-delegation" },
        "rejections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "expectedRole"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
              "suffix": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "expectedRole": { "enum": ["implementation", "unresolved"] }
            },
            "oneOf": [
              { "required": ["suffix"] },
              { "required": ["source"] }
            ]
          }
        }
      }
    },
    "collisions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entries", "inputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
          "entries": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/relativePath" }
          },
          "inputs": { "$ref": "#/$defs/files" }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?($|/))(?!.*\\\\).+$"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/relativePath" },
      "additionalProperties": { "type": "string" }
    }
  }
}
