{
  "name": "@semio-tech/print-viz-inference",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🛍️products/📓️print/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/📓️print/🔨️modules/🎨print-design-token-paints/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/📓️print/🔨️modules/🏠️host/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/📓️print/🔨️modules/📥️source-staging/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/📓️print/🔨️modules/🔤print-font-catalog/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/📓️print/🔨️modules/🖨️tectonic-template-compilation/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/📓️print/🔨️modules/🧪️viz-probe/**/*"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "$schema": "../../../../../🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "targets": {
    "build": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/🧰️framework/🛍️products/📓️print/**/*"
      ],
      "outputs": [],
      "options": { "cwd": "🧰️framework/🛍️products/📓️print/🧬️schema/💡️inferences/📦️packages/🟦️typescript", "command": "bun ./📜️script.ts build" },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "deterministic", "reason": "check-without-outputs" }
        }
      }
    },
    "test": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🛍️products/📓️print/🧬️schema/💡️inferences/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
