{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "available",
      "content",
      "minimum",
      "folded"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "available": {
        "type": "number",
        "minimum": 0
      },
      "content": {
        "type": "number",
        "minimum": 0
      },
      "minimum": {
        "type": "boolean"
      },
      "folded": {
        "type": "boolean"
      }
    }
  }
}
