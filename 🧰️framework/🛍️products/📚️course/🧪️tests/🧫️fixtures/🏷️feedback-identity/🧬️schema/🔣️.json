{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "items",
    "order",
    "dimensions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "$ref": "#/definitions/Text"
          },
          "explanation": {
            "$ref": "#/definitions/Text"
          }
        }
      }
    },
    "order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
