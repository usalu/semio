  "invalid": [
    {
      "case": "missing poster",
      "remove": "/poster"
    },
    {
      "case": "poster is not a PNG",
      "replace": "/poster/file",
      "value": "poster.jpg"
    },
    {
      "case": "poster path traversal",
      "replace": "/poster/file",
      "value": "../poster.png"
    },
    {
      "case": "missing translation",
      "remove": "/title/de"
    },
    {
      "case": "plain HTTP address",
      "replace": "/urls",
      "value": { "en": "http://videos.example.org/clip" }
    },
    {
      "case": "relative address",
      "replace": "/urls",
      "value": { "en": "/clip.mp4" }
    },
    {
      "case": "script address",
      "replace": "/urls",
      "value": { "en": "javascript:alert(1)" }
    },
    {
      "case": "address without host",
      "replace": "/urls",
      "value": { "en": "https:///clip" }
    },
    {
      "case": "address with whitespace",
      "replace": "/urls",
      "value": { "en": "https://videos.example.org/a clip" }
    },
    {
      "case": "empty addresses",
      "replace": "/urls",
      "value": {}
    },
    {
      "case": "unknown language address",
      "replace": "/urls",
      "value": { "fr": "https://videos.example.org/clip" }
    },
    {
      "case": "unknown property",
      "replace": "/answers",
      "value": []
    }
  ]
}
