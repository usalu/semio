{
  "name": "@semio-tech/framework",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🧪️tests/🎚️config/🟦️.ts"
    ]
  },
  "targets": {
    "test-artifact-reference": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🧬️schema/**/*", "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*"],
      "options": { "command": "bun ./📜️script.ts test-artifact-reference", "cwd": "{projectRoot}" }
    },
    "test-script-boundary": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/🧰️framework/📏️script-boundary/**/*", "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*"],
      "options": { "command": "bun ./📜️script.ts test-script-boundary", "cwd": "{projectRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts typecheck",
        "forwardAllArgs": true
      }
    },
    "installation-identity-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts installation-identity-check",
        "cwd": "🧰️framework/📦️packages/🟦️typescript"
      }
    }
  }
}
