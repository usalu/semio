{
  "name": "@semio-tech/framework",
  "$schema": "../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🧪️tests/🎚️config/🟦️.ts"
    ]
  },
  "targets": {
    "test-artifact-reference": {
      "executor": "repo:script",
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🧬️schema/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*"
      ],
      "options": {
        "command": "bun ./📜️script.ts test-artifact-reference",
        "cwd": "{projectRoot}"
      }
    },
    "test-script-boundary": {
      "executor": "repo:script",
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/🧰️framework/📏️script-boundary/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*"
      ],
      "options": {
        "command": "bun ./📜️script.ts test-script-boundary",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts typecheck",
        "forwardAllArgs": true
      }
    },
    "installation-identity-check": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts installation-identity-check",
        "cwd": "🧰️framework/📦️packages/🟦️typescript"
      }
    },
    "test-polygon-mesh": {
      "executor": "repo:script",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "bun ./📜️script.ts test-polygon-mesh",
        "cwd": "{projectRoot}"
      }
    }
  }
}
