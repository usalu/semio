{
  "name": "@semio-tech/imperative-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "imperative/core",
        "command": "bun ./script.ts wasm"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "imperative/core",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
