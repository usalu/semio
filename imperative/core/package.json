{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@semio-tech/imperative-core",
  "version": "0.1.0",
  "description": "imperative · core path host and effect runtime",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./js/index.ts",
    "./worker-client": "./js/worker-client.ts"
  },
  "scripts": {
    "test": "bun nx run @semio-tech/imperative-core:test"
  },
  "dependencies": {
    "@semio-tech/vcs-core": "workspace:*",
    "@semio-tech/framework-os-core": "workspace:*",
    "@semio-tech/framework-platform-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "imperative/core"
  },
  "bundleKind": "library",
  "semio": {
    "app": {
      "kind": "imperative",
      "aliases": [
        "imperative"
      ],
      "packageRoot": "imperative",
      "corePackage": "@semio-tech/imperative-core",
      "definitionExport": "imperativePlayAppDefinition",
      "hostKind": "imperative",
      "port": {
        "dev": 6076,
        "env": "IMPERATIVE_PLAY_PORT"
      },
      "programExport": "imperativeProgramContribution",
      "programId": "imperative",
      "rendererPackage": "@semio-tech/imperative-react",
      "rendererExport": "imperativeAppRenderer"
    }
  }
}
