{
  "name": "@ui/assets",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/assets",
        "command": "bun --watch ./script.ts generate all",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/assets",
        "command": "bun ./script.ts generate all",
        "forwardAllArgs": true
      }
    }
  }
}
