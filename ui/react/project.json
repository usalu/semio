{
  "name": "@ui/react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/react",
        "command": "bun ./script.ts dev",
        "env": {
          "STORYBOOK_PORT": "6006"
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/react",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/react",
        "command": "bun ./script.ts lint",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/react",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/react",
        "command": "bun ./script.ts typecheck",
        "forwardAllArgs": true
      }
    }
  }
}
