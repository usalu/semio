{
  "name": "@semio-tech/ui-styling",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/styling/js",
        "command": "bun ./script.ts generate",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/styling/js",
        "command": "bun ./script.ts test"
      }
    }
  }
}
