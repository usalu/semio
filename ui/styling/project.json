{
	"name": "@ui/styling-tokens",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"targets": {
		"generate": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "ui/styling",
				"command": "bun ./script.ts generate",
				"forwardAllArgs": true
			}
		},
		"fonts": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "ui/styling",
				"command": "bun ./script.ts fonts",
				"forwardAllArgs": true
			}
		}
	}
}
