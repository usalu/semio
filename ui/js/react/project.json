{
  "name": "@semio-tech/ui-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts dev",
        "env": {
          "STORYBOOK_PORT": "6010"
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts lint",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts typecheck",
        "forwardAllArgs": true
      }
    },
    "check-ui-primitives": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "ui/js/react",
        "command": "bun ./script.ts check-ui-primitives"
      }
    }
  }
}
